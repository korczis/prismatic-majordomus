{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://majordomus.dev/schemas/majordomus/issue/issue.v1.schema.json",
  "x-majordomus-schema": "majordomus.issue/v1",
  "title": "Issue",
  "description": "An issue under .ai/repo/project/issues/: an execution contract inside a milestone; status is derived from started_at, verified_at, completed_at and the dependency graph.",
  "x-majordomus-allow": "issue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "milestone",
    "title",
    "slug",
    "priority",
    "profile",
    "objective",
    "scope",
    "acceptance_criteria",
    "validation",
    "evidence_required"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "milestone": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "priority": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "parallel_safe": {
      "type": "boolean"
    },
    "risk": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "cancelled": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "why": {
      "type": "string"
    },
    "current_state": {
      "type": "string"
    },
    "desired_state": {
      "type": "string"
    },
    "completion": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "started_event": {
      "type": "string",
      "description": "The seal of the plan_start event that wrote started_at: sha256 of the event, the issue and the stamp, written only by the transition in the same write as the stamp (ADR 0072). A stamp without its seal moves no status and fails plan validate."
    },
    "verified_at": {
      "type": "string"
    },
    "verified_event": {
      "type": "string",
      "description": "The seal of the plan_verify event that wrote verified_at: sha256 of the event, the issue and the stamp, written only by the transition in the same write as the stamp (ADR 0072). A stamp without its seal moves no status and fails plan validate."
    },
    "completed_at": {
      "type": "string"
    },
    "completed_event": {
      "type": "string",
      "description": "The seal of the plan_done event that wrote completed_at: sha256 of the event, the issue and the stamp, written only by the transition in the same write as the stamp (ADR 0072). A stamp without its seal moves no status and fails plan validate."
    },
    "unsealed_stamps": {
      "type": "array",
      "description": "The stamps of this record written before a transition sealed the stamp it wrote, one \"<field> <stamp>\" per entry (ADR 0072). An entry excuses exactly the stamp it names and only one older than the instant seals began; the list may shrink and is never added to.",
      "items": {
        "type": "string",
        "pattern": "^(started_at|verified_at|completed_at) [^ ]+$"
      }
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "covers": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "artifact": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "recorded_at": {
            "type": "string"
          }
        }
      }
    }
  }
}
