#!/usr/bin/env bash
# release-verify — prove one release artifact is what the distribution model says it is.
#
#   scripts/release-verify --archive FILE --target <rust target> --tag <vX.Y.Z> [--native]
#
# Checks, in order: the file name the naming function derives, that the archive reads, that
# every entry is an ordinary file or directory under the archive's own root (no absolute
# path, no traversal, no link, no device), that the tree holds the shell tool, its
# libraries, the tool's data directory, the executable and the licence, that the executable
# carries the executable bit, and that the archive is neither empty nor implausibly small.
# With --native it also runs the unpacked tool and requires it to report the release's own
# version — the check that catches a release built from the wrong tree.
#
# Exit codes: 0 ok · 2 usage · 10 the artifact is not what the model says · 12 prerequisite.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CRATE="$ROOT/apps/majordomus-cli"
# for mj_cargo_target_dir: cargo does not necessarily build into "$CRATE/target"
# shellcheck source=../lib/rust_bin.sh
. "$ROOT/lib/rust_bin.sh"

# Every failure is counted; the first few of each kind are printed and the rest are
# summarised. A malformed archive fails once per entry, and an archive has thousands of
# them: the run that lost release v0.2.0 printed 931 lines that said one thing, and the one
# sentence a reader needed was above all of them, off the top of the log. A diagnostic
# nobody scrolls to is a diagnostic nobody has.
FAIL_SHOWN_PER_KIND=5
fail() {
  bad=$((bad + 1))
  # the kind is the sentence without its subject: "entry is not a file or a directory: X"
  # and the same for Y are one kind, so the second thousand of them add nothing
  kind="${1%%:*}"
  eval "seen=\${FAIL_SEEN_$(printf '%s' "$kind" | tr -c 'A-Za-z0-9' '_'):-0}"
  seen=$((seen + 1))
  eval "FAIL_SEEN_$(printf '%s' "$kind" | tr -c 'A-Za-z0-9' '_')=$seen"
  if [ "$seen" -le "$FAIL_SHOWN_PER_KIND" ]; then
    printf 'release-verify: FAIL %s\n' "$*" >&2
  elif [ "$seen" = "$((FAIL_SHOWN_PER_KIND + 1))" ]; then
    printf 'release-verify: FAIL ... and more of "%s"; the count is in the summary below\n' "$kind" >&2
  fi
}
die() { printf 'release-verify: %s\n' "$*" >&2; exit "${2:-12}"; }
ok() { printf 'release-verify: OK   %s\n' "$*"; }

archive=""; target=""; tag=""; native=0
# an archive that is smaller than this is not a build of this tool
MIN_BYTES=200000

while [ $# -gt 0 ]; do
  case "$1" in
    --archive) archive="${2:-}"; shift 2 ;;
    --target) target="${2:-}"; shift 2 ;;
    --tag) tag="${2:-}"; shift 2 ;;
    --native) native=1; shift ;;
    -h|--help) sed -n '2,14p' "$0"; exit 0 ;;
    *) die "unknown option: $1" 2 ;;
  esac
done
[ -n "$archive" ] && [ -n "$target" ] && [ -n "$tag" ] || die "--archive, --target and --tag are required" 2
[ -f "$archive" ] || die "no such archive: $archive"

mj="${MAJORDOMUS_DIST_BIN:-$(mj_cargo_target_dir "$CRATE" ask-cargo)/debug/majordomus}"
[ -x "$mj" ] || die "the distribution model needs the executable; build it or set MAJORDOMUS_DIST_BIN"
names="$("$mj" distribution --repo "$ROOT" artifact --target "$target" --tag "$tag" --format text 2>/dev/null)" \
  || die "the distribution model does not publish '$target'" 10
expected_name="$(printf '%s\n' "$names" | sed -n '1p')"
expected_root="$(printf '%s\n' "$names" | sed -n '2p')"

bad=0

[ "$(basename "$archive")" = "$expected_name" ] \
  && ok "name $expected_name" \
  || fail "name is $(basename "$archive"), the model derives $expected_name"

size="$(wc -c < "$archive" | tr -d ' ')"
[ "$size" -ge "$MIN_BYTES" ] \
  && ok "size ${size} bytes" \
  || fail "size ${size} bytes is below the ${MIN_BYTES} a build of this tool cannot be under"

listing="$(mktemp)"; trap 'rm -f "$listing"' EXIT INT TERM HUP
tar -tzvf "$archive" > "$listing" 2>/dev/null || die "the archive does not read as a gzipped tar" 10

entries=0
names="$(mktemp)"; trap 'rm -f "$listing" "$names"' EXIT INT TERM HUP
while IFS= read -r line; do
  [ -n "$line" ] || continue
  entries=$((entries + 1))
  case "$line" in
    -*|d*) ;;
    *) fail "entry is not a file or a directory: $line"; continue ;;
  esac
  name="${line##*[0-9][0-9]:[0-9][0-9] }"
  case "$name" in
    /*) fail "entry is an absolute path: $name" ;;
    *..*) fail "entry traverses upwards: $name" ;;
    "$expected_root"|"$expected_root"/*) ;;
    *) fail "entry is outside $expected_root/: $name" ;;
  esac
  printf '%s\n' "$name" >> "$names"
done < "$listing"
[ "$entries" -gt 0 ] || fail "the archive is empty"
# One entry per path. A packer that lists a directory and its contents to a tar that also
# recurses writes everything twice; where that lands as a hard link the check above catches
# it, and where it lands as a second regular entry nothing did until here.
# awk rather than `head -n 5`: under pipefail, head closing the pipe early makes the whole
# pipeline exit 141 once the writer outstrips a pipe buffer, which is precisely the badly
# malformed archive this line is here to describe. awk reads its input to the end.
dupes="$(LC_ALL=C sort "$names" | uniq -d | awk 'NR <= 5')"
if [ -n "$dupes" ]; then
  fail "the archive carries a path more than once: $(printf '%s' "$dupes" | tr '\n' ' ')"
else
  ok "one entry per path ($entries)"
fi
# only a claim if it is one: entries that failed the checks above are not "all under" anything
[ "$bad" = 0 ] && ok "$entries entries, all under $expected_root/"

for required in \
  "$expected_root/bin/majordomus" \
  "$expected_root/bin/majordomus-mcp" \
  "$expected_root/bin/majordomus-cli" \
  "$expected_root/libexec/majordomus-cli" \
  "$expected_root/lib/common.sh" \
  "$expected_root/share/kinds.yaml" \
  "$expected_root/share/distribution.yaml" \
  "$expected_root/LICENSE" \
  "$expected_root/RELEASE.json"
do
  grep -q " $required\$" "$listing" || { fail "the archive holds no $required"; missing=1; }
done
[ "${missing:-0}" = 0 ] && ok "every required member is present"

for executable in "$expected_root/bin/majordomus" "$expected_root/bin/majordomus-mcp" "$expected_root/bin/majordomus-cli" "$expected_root/libexec/majordomus-cli"; do
  mode="$(grep " $executable\$" "$listing" | sed -n '1s/^\(.\{10\}\).*/\1/p')"
  case "$mode" in
    *x*) ;;
    *) fail "$executable is not executable in the archive (mode $mode)" ;;
  esac
done
ok "every executable carries its executable bit"

work="$(mktemp -d)"
trap 'rm -f "$listing"; rm -rf "$work"' EXIT INT TERM HUP
tar -xzf "$archive" -C "$work"
[ -x "$work/$expected_root/bin/majordomus" ] || fail "the unpacked shell tool is not executable"

recorded="$(sed -n 's/.*"tag": "\([^"]*\)".*/\1/p' "$work/$expected_root/RELEASE.json" | head -n 1)"
[ "$recorded" = "$tag" ] && ok "RELEASE.json records $tag" || fail "RELEASE.json records '$recorded', not $tag"
recorded_target="$(sed -n 's/.*"target": "\([^"]*\)".*/\1/p' "$work/$expected_root/RELEASE.json" | head -n 1)"
[ "$recorded_target" = "$target" ] && ok "RELEASE.json records $target" \
  || fail "RELEASE.json records target '$recorded_target', not $target"

if [ "$native" = 1 ]; then
  reported="$("$work/$expected_root/bin/majordomus" version 2>/dev/null || true)"
  [ "$reported" = "majordomus ${tag#v}" ] \
    && ok "the unpacked tool reports ${tag#v}" \
    || fail "the unpacked tool reports '$reported', not 'majordomus ${tag#v}'"
  reported_bin="$("$work/$expected_root/libexec/majordomus-cli" --version 2>/dev/null || true)"
  [ "$reported_bin" = "majordomus ${tag#v}" ] \
    && ok "the unpacked executable reports ${tag#v}" \
    || fail "the unpacked executable reports '$reported_bin', not 'majordomus ${tag#v}'"
  # The launcher chain, with no toolchain allowed. An installed tree has no crate to build
  # from, so a launcher that was left out of the archive — or one whose executable was —
  # fails here, and nowhere in a check that only reads the archive's list of names.
  reported_launcher="$(MAJORDOMUS_NO_BUILD=1 "$work/$expected_root/bin/majordomus-cli" --version 2>/dev/null || true)"
  [ "$reported_launcher" = "majordomus ${tag#v}" ] \
    && ok "the launcher resolves its executable with no toolchain" \
    || fail "bin/majordomus-cli reports '$reported_launcher' with MAJORDOMUS_NO_BUILD=1; an installed tree cannot build one"
fi

[ "$bad" = 0 ] || { printf 'release-verify: %s check(s) failed for %s\n' "$bad" "$(basename "$archive")" >&2; exit 10; }
printf 'release-verify: %s is what the model says it is\n' "$(basename "$archive")"
