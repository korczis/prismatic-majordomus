#!/usr/bin/env bash
# build-cache-check — a local script may not build around the mesh build cache without saying why
# (project.every-build-path-goes-through-the-cache, ADR 0157, I3953).
#
# The choke points are lib/rust_bin.sh's: mj_cargo_bounded and mj_build_cache_start, which start
# sccache with the store as its second level, and mj_npm_modules_ensure, which installs
# node_modules through `majordomus mesh build-cache ensure`. A script that compiles the crate
# itself (`cargo build|test|run|bench|check|clippy|doc|rustc|llvm-cov|nextest`, with a
# `+toolchain` or leading flags) or installs dependencies itself (`npm ci|install|i|it|add`,
# `npx` that may install, `yarn install|add`, `pnpm install|i|add`, `mix deps.get`) reuses
# nothing the mesh built and adds nothing to it. This gate reads every tracked script and recipe
# and refuses such a line unless it declares why, on the line or on the comment line before it:
#
#     npm ci   # build-cache: <why this build cannot use the cache>
#
# Going through the cache, and so not a finding:
#   - a bare `cargo` in a file that defines `cargo()` as mj_cargo_bounded (that function is
#     the choke point);
#   - a cargo command on a line that runs mj_build_cache_start before it (a `just` recipe,
#     whose every line is a shell of its own);
#   - the command a `mesh build-cache ensure` runs, after its `--`.
# Not read: GitHub workflows (their runners cannot reach the store: a declared exemption),
# prose, comments, `--version` and `--help` questions, and `npx --no` (which never installs).
# Command position only: the words in an echoed message are not commands.
#
#   scripts/ci/build-cache-check [paths...]   default: every tracked script and recipe
#
# Exit: 0 clean, 10 an undeclared bypass, 2 usage.
set -eu
set -o pipefail

ROOT="${MJ_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
cd "$ROOT"

# command position: line start, or after ; & | { ( $( then do else, past VAR=value prefixes
CMD='(^|[;&|{]|\$\(|[[:space:]](then|do|else))[[:space:]]*([A-Za-z_][A-Za-z0-9_]*=('"'"'[^'"'"']*'"'"'|"[^"]*"|[^[:space:]]*)[[:space:]]+)*((command|env)[[:space:]]+)?'
# a compilation of the crate: cargo [+toolchain] [flags] <subcommand>
CARGO="${CMD}cargo([[:space:]]+\\+[^[:space:]]+)?([[:space:]]+--?[A-Za-z][-A-Za-z]*(=[^[:space:]]*)?)*[[:space:]]+(build|test|run|bench|check|clippy|doc|rustc|llvm-cov|nextest)([[:space:]]|\$)"
# an install of dependencies: npm [options] <install>, npx (installs what is missing), yarn
# install|add, pnpm install|i|add, mix deps.get
NPM_OPT='([[:space:]]+(--prefix|-C|--workspace|-w)[[:space:]]+[^[:space:]]+|[[:space:]]+-[^[:space:]]+)*'
END='([[:space:]]|[;&|)]|$)'
DEPS="${CMD}(npm${NPM_OPT}[[:space:]]+(ci|install|i|it|install-clean|install-test|add)${END}|npx[[:space:]]|yarn[[:space:]]+(install|add)${END}|pnpm[[:space:]]+(install|i|add)${END}|mix[[:space:]]+deps\\.get${END})"
BYPASS="${CARGO}|${DEPS}"
# questions that build nothing, removed from a line before it is judged
QUESTION='(cargo|npm|npx|yarn|pnpm)([[:space:]]+[^[:space:];&|]+)*[[:space:]]+(--version|-V|--help)([[:space:]]|$)|npx([[:space:]]+-[^[:space:]]+)*[[:space:]]+--no(-install)?([[:space:]]|$)'

candidates() {
  if [ $# -gt 0 ]; then printf '%s\n' "$@"; return; fi
  git ls-files scripts lib bin share .just justfile .githooks .claude/hooks 2>/dev/null | LC_ALL=C sort | while IFS= read -r f; do
    [ -f "$f" ] || continue
    case "$f" in
      .just/*|justfile) printf '%s\n' "$f" ;;
      *) head -n 1 "$f" 2>/dev/null | grep -q '^#!.*sh' && printf '%s\n' "$f" || true ;;
    esac
  done
}

found=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  chokes=0
  grep -qE '^[[:space:]]*cargo\(\)[[:space:]]*\{[^}]*mj_cargo_bounded' "$f" 2>/dev/null && chokes=1
  while IFS=: read -r n line; do
    case "$line" in *"# build-cache:"*) continue ;; esac
    first="${line#"${line%%[![:space:]]*}"}"
    case "$first" in '#'*) continue ;; esac
    if [ "$n" -gt 1 ] && sed -n "$((n - 1))p" "$f" | grep -qE '^[[:space:]]*#[[:space:]]*build-cache:[[:space:]]*[^[:space:]]'; then continue; fi
    # what the line asks rather than builds is not judged; the rest of it is
    judged="$(printf '%s\n' "$line" | sed -E "s/${QUESTION}/: /g")"
    # the command a `mesh build-cache ensure` runs is the cache's own
    case "$judged" in *"build-cache ensure"*) judged="${judged%%build-cache ensure*}" ;; esac
    printf '%s\n' "$judged" | grep -qE "$BYPASS" || continue
    if ! printf '%s\n' "$judged" | grep -qE "$DEPS"; then
      [ "$chokes" = 1 ] && continue
      case "$judged" in *mj_build_cache_start*cargo*) continue ;; esac
    fi
    printf 'BYPASS %s:%s: %s\n' "$f" "$n" "$first"
    found=$((found + 1))
  done < <(grep -nE "$BYPASS" "$f" 2>/dev/null || true)
done < <(candidates "$@")

if [ "$found" -gt 0 ]; then
  echo "build-cache-check: $found line(s) build around the cache. Go through mj_cargo_bounded (lib/rust_bin.sh) or 'majordomus mesh build-cache ensure', or declare why on the line:  # build-cache: <why>" >&2
  exit 10
fi
echo "build-cache-check: every build line goes through the cache or declares why"
