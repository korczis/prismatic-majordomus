#!/usr/bin/env bash
# shell-lint — the syntax and shellcheck gate, the same command here and in CI: bash -n over
# the tool, the library, the harness and every case; shellcheck -x -s bash -S warning over
# the tool, the scripts and every case. Exit 0 clean, non-zero on the first finding, 12
# when shellcheck is not installed (the gate needs it; a missing linter is not a pass).
#
#   scripts/ci/shell-lint            lint everything
#   scripts/ci/shell-lint --list     print what it would lint, one path per line
set -eu
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT"
# What is linted is discovered, not listed: every tracked file under bin/, lib/, scripts/
# and the harness whose first line says it is a shell script. A list here would be a mirror
# of the directory, and the day it went stale would be the day a new script stopped being
# linted (docs/DYNAMICITY.md).
shell_files() {
  git ls-files -z bin lib test/run.sh test/lib.sh scripts 2>/dev/null \
    | tr '\0' '\n' \
    | while IFS= read -r f; do
        [ -f "$f" ] || continue
        case "$(head -n 1 "$f")" in
          '#!'*sh) printf '%s\n' "$f" ;;
        esac
      done
}
if [ "${1:-}" = --list ]; then shell_files; exit 0; fi
scripts="$(shell_files | tr '\n' ' ')"
[ -n "$scripts" ] || { echo "shell-lint: found no shell scripts to lint" >&2; exit 12; }
echo "==> bash -n"
# shellcheck disable=SC2086
for f in $scripts test/cases/*.sh; do bash -n "$f" || { echo "shell-lint: syntax: $f"; exit 1; }; done
command -v shellcheck >/dev/null || { echo "shell-lint: shellcheck is required (brew install shellcheck / apt-get install shellcheck)" >&2; exit 12; }
echo "==> shellcheck"
# shellcheck disable=SC2086
shellcheck -x -s bash -S warning $scripts
shellcheck -x -s bash -S warning test/cases/*.sh
# A gate that counts its findings in a variable and raises one inside a loop fed by a pipe
# (`... | while read -r l; do fail "$l"; done`) loses every one of them: bash runs that loop in a
# subshell, so the finding is printed and the count, and the exit status, never see it. That is
# how eighteen of site-check's checks printed FAIL and passed. Every script that defines such a
# counting function is read for calls to it inside a pipeline loop. The scanner is run against
# a fixture whose answer is known first, so a scanner that stopped finding them cannot pass for
# a clean tree; and a script it cannot read to the end is a failure, not a pass.
echo "==> no counting call inside a pipeline loop"
pc_awk=scripts/lib/pipeline-counts.awk; pc_fixture=scripts/lib/pipeline-counts.fixture
pc_want="5 8 15 17 25 32"
pc_got="$(LC_ALL=C awk -v FNS=bad -f "$pc_awk" "$pc_fixture" | sed -E 's#^[^:]*:([0-9]+):.*#\1#' | tr '\n' ' ' | sed 's/ $//')"
[ "$pc_got" = "$pc_want" ] || { echo "shell-lint: $pc_awk found lines [$pc_got] in $pc_fixture, whose answer is [$pc_want]; the scanner is not trustworthy"; exit 1; }
pc_hits=0
for f in $scripts; do
  fns="$(LC_ALL=C awk -f scripts/lib/counting-functions.awk "$f" | sort -u | tr '\n' '|' | sed 's/|$//')"
  [ -n "$fns" ] || continue
  rc=0; out="$(LC_ALL=C awk -v FNS="$fns" -f "$pc_awk" "$f")" || rc=$?
  [ "$rc" = 0 ] || { echo "shell-lint: $out"; echo "shell-lint: $pc_awk could not read $f to the end"; exit 1; }
  [ -z "$out" ] || { printf 'shell-lint: %s\n' "$out"; pc_hits=1; }
done
[ "$pc_hits" = 0 ] || { echo "shell-lint: a counting call inside a pipeline loop is lost to a subshell; read the loop's input from a file (\`done < file\`) instead"; exit 1; }
# The installer is POSIX shell, not bash, and is generated: it is linted as what it is, and
# as what is actually published rather than as its template.
if [ -f site/static/install.sh ]; then
  echo "==> shellcheck (posix): site/static/install.sh"
  sh -n site/static/install.sh || { echo "shell-lint: syntax: site/static/install.sh"; exit 1; }
  shellcheck -s sh -S warning site/static/install.sh
fi
# The workflow is YAML GitHub parses on its own terms; a file that does not parse fails
# every job of every run before any of them starts, so it is linted here, where a person
# runs it. actionlint is required in CI (the structure job installs it) and reported when
# absent locally, never silently skipped.
if command -v actionlint >/dev/null 2>&1; then
  echo "==> actionlint"
  actionlint .github/workflows/*.yml
elif [ -n "${CI:-}" ]; then
  echo "shell-lint: actionlint is required in CI and is not installed" >&2; exit 12
else
  echo "==> actionlint: not installed (brew install actionlint); CI runs it"
fi
echo "shell-lint: ok"
