#!/usr/bin/env bash
# pages-check — what GitHub Pages is serving came from master, and is actually serving it.
#
# The one thing no gate asked. Every other gate measures a tree: the projections are current,
# the graph is coherent, the command line matches the registry. None of them can be false
# because of a deployment, and none of them notices when the published site stops being a
# projection of the default branch.
#
# Four failures this exists for, every one of them observed:
#
#   1. An UNMERGED REF WAS PUBLISHED. On 2026-09-09 the public site served a commit from
#      feature/external-workspaces for about half an hour — `scripts/site-deploy --any-ref`
#      pointed at production. Every tree-level gate was green throughout, because the tree
#      was fine; what was wrong was which tree had been published. A person noticed by eye.
#
#   2. PAGES NEVER REBUILT. A push made with GITHUB_TOKEN starts no workflow, so a gh-pages
#      commit can land with the Pages build never running. gh-pages then says one commit and
#      the live site serves an older one, and nothing says so.
#
#   3. THE PUBLICATION IS SIMPLY OWED. On 2026-09-10 twenty pull requests landed in one
#      afternoon and the site sat behind master for hours with every commit-level check
#      green. This gate was already running and said `ok` throughout, because it only asked
#      whether the published commit is ON master — and it printed how far behind the head it
#      was as part of that `ok`. A relation checked in one direction with the converse owned
#      by nobody is this repository's most repeated defect class; the converse is checked
#      here now. A deploy run that was cancelled, failed, or never started leaves master
#      moved and gh-pages still naming the old commit, and that is a refusal once the
#      publication is older than the deploy window rather than merely young.
#
#   4. GITHUB'S OWN BUILD ERRORED. Publishing is two steps and the second is GitHub's:
#      pushing gh-pages is a workflow this repository writes, building and serving it is
#      "pages build and deployment", which this repository does not. On 2026-09-10 at
#      17:35 the workflow published dfd9c989c and GitHub's build of it errored; the site
#      served the previous commit for 27 minutes with nothing red anywhere. The build has
#      its own API and its own status, so it is asked directly rather than inferred.
#
# So: the branch says which commit it was built from, and this asserts that commit is on
# master; that master has not moved past it beyond the deploy window; that the live site is
# serving it; and that GitHub's own build of it did not error.
#
#   scripts/ci/pages-check                 every check; needs network for two of them
#   scripts/ci/pages-check --offline       the two decidable from the clone alone
#   scripts/ci/pages-check --url URL       ask a different origin (a preview, a fork)
#   scripts/ci/pages-check --owed-after N  seconds master may be ahead before it is a refusal
#
# Exit: 0 ok · 2 usage · 10 the published site is not a projection of master · 12 something
# needed could not be read (no gh-pages, no network when one was required).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT"

OFFLINE=0
URL=""
# Publishing is two workflows and neither is instant. Without a wait this fails during every
# deploy window and reports a mismatch that is merely young — and a gate that cries wolf is
# a gate that gets waived. `installer-live` waits 300 for the same reason.
WAIT="${PAGES_CHECK_WAIT:-300}"
# How long master may be ahead of the publication before that is a refusal rather than a
# deploy in flight. Not taste: on 2026-09-10 a pages run sat in the Actions queue from
# 17:09:21 to 17:34:05 — 25 minutes before a runner was allocated — and the whole deploy,
# queue included, then took another five. A window shorter than the queue would turn every
# busy afternoon red, and a gate that cries wolf is a gate that gets waived. Thirty minutes
# is that measurement with a little room; it is a bound on lateness, not a target, and the
# target lives in .ai/repo/ci/pages.yaml as `budget.end_to_end`.
OWED_AFTER="${PAGES_CHECK_OWED_AFTER:-1800}"
while [ $# -gt 0 ]; do
  case "$1" in
    --offline) OFFLINE=1; shift ;;
    --wait) WAIT="${2:?--wait needs seconds}"; shift 2 ;;
    --owed-after) OWED_AFTER="${2:?--owed-after needs seconds}"; shift 2 ;;
    --url) URL="${2:?--url needs a value}"; shift 2 ;;
    -h|--help) sed -n '2,44p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "pages-check: unknown option $1" >&2; exit 2 ;;
  esac
done

REMOTE="${PAGES_CHECK_REMOTE:-origin}"
BRANCH="${PAGES_CHECK_BRANCH:-gh-pages}"
TRUNK="${PAGES_CHECK_TRUNK:-master}"

say()  { printf '%s\n' "$*"; }
ok()   { printf 'ok    %s\n' "$*"; }
bad()  { printf 'FAIL  %s\n' "$*"; fail=1; }
# Something this gate wanted to measure and could not. It is never silent and never an `ok`:
# a check that is absent must not be readable as a check that passed.
note() { printf 'note  %s\n' "$*"; }
fail=0
on_trunk=0

# ---------------------------------------------------------------- 1. what was published
git fetch -q "$REMOTE" "$BRANCH" "$TRUNK" 2>/dev/null || true
if ! git rev-parse --verify -q "$REMOTE/$BRANCH" >/dev/null; then
  say "pages-check: $REMOTE/$BRANCH does not exist; nothing has been published"
  exit 12
fi

subject="$(git log -1 --format=%s "$REMOTE/$BRANCH")"
# The deploy commit names its source: `deploy: site from <sha> (registry <hash>), N routes`.
# scripts/site-deploy writes it, and this is the only reader; a deploy that stopped saying
# where it came from is itself the failure, so an unreadable subject is not tolerated.
source_sha="$(printf '%s' "$subject" | sed -n 's/^deploy: site from \([0-9a-f][0-9a-f]*\).*/\1/p')"
if [ -z "$source_sha" ]; then
  say "pages-check: the head of $BRANCH does not name the commit it was built from:"
  say "             $subject"
  say "             scripts/site-deploy writes that subject; a deploy that does not is unauditable"
  exit 12
fi

if ! git cat-file -e "$source_sha^{commit}" 2>/dev/null; then
  bad "the published commit $source_sha is not in this clone; fetch, or it was never pushed"
elif git merge-base --is-ancestor "$source_sha" "$REMOTE/$TRUNK" 2>/dev/null; then
  on_trunk=1
  behind="$(git rev-list --count "$source_sha..$REMOTE/$TRUNK")"
  # How far behind is stated here and judged in 3: this half answers *which tree*, not *how
  # old*. Printing the distance as part of an `ok` was how an hours-old site read as healthy.
  ok "the published commit $source_sha is on $TRUNK ($behind commit(s) behind its head)"
else
  bad "the published commit $source_sha is NOT on $TRUNK — an unmerged ref is being served"
  say "      $subject"
  say "      whoever deployed it used --any-ref against production; redeploy from $TRUNK"
fi

# ---------------------------------------------------------------- 2. what is being served
if [ "$OFFLINE" = 1 ]; then
  ok "the live site was not asked (--offline)"
else
  if [ -z "$URL" ]; then
    # The site's own base, from the configuration that generated it — never a literal here,
    # because a URL written in a gate is a second declaration of where the site lives.
    URL="$(sed -n 's/^ *base_url *= *"\(.*\)"/\1/p' site/config.toml | head -1)"
  fi
  if [ -z "$URL" ]; then
    say "pages-check: site/config.toml declares no base_url, so there is no site to ask"
    exit 12
  fi
  # The site publishes its own identity at deploy.identity — a document written for exactly
  # this question, carrying the full commit. That is the authority. The footer is asked as
  # well, because the two are produced by different steps: build.json can be published while
  # the pages themselves were not, and them disagreeing is a finding rather than noise.
  # The path is declared once, in the publication model `scripts/pages` reads; naming it
  # here would be a second declaration of where the site states its own identity.
  identity="$(sed -n 's/^ *identity: *\(.*\)/\1/p' .ai/repo/ci/pages.yaml 2>/dev/null | head -1 || true)"
  if [ -z "$identity" ]; then
    say "pages-check: .ai/repo/ci/pages.yaml declares no deploy.identity"
    exit 12
  fi
  # Poll until the site names the published commit, or the wait runs out. The cache is
  # defeated on every attempt: a CDN that answers from cache would make a finished deploy
  # look unfinished for as long as it holds the old copy.
  t0=$(date +%s); served=""
  while :; do
    served="$(curl -fsSL --max-time 30 -H 'Cache-Control: no-cache' "${URL%/}/$identity?t=$(date +%s)" 2>/dev/null | jq -r '.commit // empty' 2>/dev/null || true)"
    case "$served" in "$source_sha"*) break ;; esac
    [ $(( $(date +%s) - t0 )) -lt "$WAIT" ] || break
    sleep 5
  done
  waited=$(( $(date +%s) - t0 ))
  body="$(curl -fsSL --max-time 30 "$URL" 2>/dev/null || true)"

  if [ -z "$served" ] && [ -z "$body" ]; then
    bad "the live site at $URL did not answer; it is published but not reachable"
  elif [ -z "$served" ]; then
    bad "the live site serves no $identity; it cannot say which commit it is"
  elif [ "$served" = "$source_sha" ] || [ "${served#"$source_sha"}" != "$served" ]; then
    ok "the live site's $identity names $source_sha, which is what $BRANCH published (after ${waited}s)"
  else
    bad "after ${waited}s the live site's $identity names ${served:0:12}, not ${source_sha:0:12}"
    say "      Pages did not rebuild. A push made with GITHUB_TOKEN starts no workflow;"
    say "      re-run the pages workflow, or push the branch with a token that does."
  fi

  # The second, independent view. The footer of every page names the same commit; when the
  # two disagree, one of the deploy's two steps ran and the other did not.
  if [ -n "$body" ] && [ -n "$served" ]; then
    footer="$(printf '%s' "$body" | sed -n 's|.*/commit/\([0-9a-f]\{7,40\}\).*|\1|p' | head -1)"
    if [ -z "$footer" ]; then
      bad "the pages name no commit in their footer, though $identity names one"
    elif [ "${served#"$footer"}" = "$served" ]; then
      bad "$identity names ${served:0:12} but the pages' footer names ${footer:0:12}"
      say "      the two halves of one deploy disagree: one step published and the other did not"
    else
      ok "the pages agree with $identity (${footer:0:12})"
    fi
  fi
fi

# ------------------------------------------------------- 3. is the publication still current
#
# The converse of 1, and the half nobody owned. Being a projection of master is two claims —
# the published tree is on master, and master has not moved past it — and only the first was
# ever asked. A deploy that was cancelled, that failed, or that never started leaves the
# second false while the first stays true, which is what an afternoon of merges did.
#
# Not every commit owes a publication: the site can only differ when an input of it differs,
# and that set is declared once, in .ai/repo/ci/pages.yaml, computed by `scripts/pages paths`
# and used verbatim as the workflow's own trigger. Reading it here rather than writing a
# second list is the only way the gate and the trigger can agree about what a deploy is for.
#
# The refusal is by age, not by distance: a publication owed for ninety seconds is a deploy in
# flight and a publication owed for an hour is a deploy that is not coming.
#
# The age is the OLDEST unpublished commit's, not the newest's. `git log -1` over the range
# answers a different question — how long since the last thing landed — and on a trunk that
# moves every few minutes that answer is always young, so the window never closes and the
# gate cannot fire while the repository is busy. That is exactly when a deploy breaks: this
# check reported ok for five hours while the published site stood 34 commits back, because
# each new merge reset the age it was reading.
git fetch -q "$REMOTE" "$TRUNK" 2>/dev/null || true
if [ "$on_trunk" = 1 ]; then
  trigger=""
  if [ -x scripts/pages ]; then trigger="$(scripts/pages paths 2>/dev/null || true)"; fi
  # `foo/**` is this repository's way of writing a subtree; git spells the same thing `foo/`,
  # and every other pattern (`scripts/lib/ui-*.mjs`) is already a pathspec.
  set -f
  # shellcheck disable=SC2046 # deliberate: the list is one pathspec per line, globbing off
  set -- $(printf '%s' "$trigger" | sed 's|/\*\*$|/|')
  set +f
  if [ "$#" = 0 ]; then
    note "the trigger paths could not be read from the publication model; every commit ahead counts"
  fi
  # The oldest commit still unpublished — `| tail -1`, not `log -1`. See the note above.
  owed="$(git log --first-parent --format='%H %ct' "$source_sha..$REMOTE/$TRUNK" -- "$@" 2>/dev/null | tail -1 || true)"
  if [ -z "$owed" ]; then
    ok "no publication is owed: nothing $TRUNK gained since $source_sha changes what the site is built from"
  else
    owed_sha="${owed%% *}"
    owed_at="${owed##* }"
    age=$(( $(date +%s) - owed_at ))
    count="$(git rev-list --count --first-parent "$source_sha..$REMOTE/$TRUNK" -- "$@" 2>/dev/null || echo '?')"
    if [ "$age" -lt "$OWED_AFTER" ]; then
      ok "a publication is owed for ${owed_sha:0:12} and is ${age}s old; inside the ${OWED_AFTER}s deploy window"
    else
      bad "the site owes a publication: ${owed_sha:0:12} changed what it is built from ${age}s ago"
      say "      $count commit(s) on $TRUNK since ${source_sha:0:12} touch the publication's inputs,"
      say "      and $BRANCH still names ${source_sha:0:12}. The deploy did not happen: a run was"
      say "      cancelled by the next push, failed, or was never triggered. Dispatch the pages"
      say "      workflow on $TRUNK, or run scripts/site-deploy, and fix why it did not run."
    fi
  fi
fi

# ------------------------------------------------------- 4. GitHub's own build of the branch
#
# Publishing is two steps owned by two parties: this repository pushes gh-pages, and GitHub's
# "pages build and deployment" turns that branch into the served site. The second can error on
# a branch that was pushed perfectly, and when it does the workflow that pushed is green, the
# branch is right, and the site is a commit behind — which is 2026-09-10 17:35 exactly. Its
# status is a fact with an API, so it is read rather than guessed at from the symptom.
if [ "$OFFLINE" = 1 ]; then
  ok "GitHub's own Pages build was not asked (--offline)"
else
  # Asked in one place, not two. This gate read `repos/:slug/pages/builds` in its own words
  # until 2026-09-11, and .github/workflows/pages.yml — the run that does the publishing, and
  # the only reader in a position to go red at the moment the build fails — could not read it
  # at all. One API, one parser, two callers: `scripts/pages built`. Its exit is the verdict
  # (0 built, 10 errored, 12 not determinable) and its porcelain line is the reading, so the
  # words a person sees stay this gate's and the question stays the tool's.
  head_sha="$(git rev-parse "$REMOTE/$BRANCH" 2>/dev/null || true)"
  reading=""; rc=0
  reading="$(scripts/pages built --commit "$head_sha" --porcelain 2>/dev/null)" || rc=$?
  b_status="$(printf '%s' "$reading" | cut -f1)"
  b_commit="$(printf '%s' "$reading" | cut -f2)"
  b_error="$(printf '%s' "$reading" | cut -f3)"
  case "$rc" in
    0)  ok "GitHub's own Pages build of ${b_commit:0:12} is $b_status" ;;
    10) bad "GitHub's own Pages build of ${b_commit:0:12} — the head of $BRANCH — errored: $b_error"
        say "      the branch is right and the site is not; re-run the build by dispatching the"
        say "      pages workflow, or push $BRANCH again. The pages workflow goes red for this"
        say "      now as well, at the moment it happens; this is what notices afterwards." ;;
    *)  if [ "$b_status" = unreadable ] || [ -z "$b_status" ]; then
          note "GitHub's Pages build could not be read (${b_error:-no gh, no token, or no pages:read}); not measured"
        else
          note "GitHub's newest Pages build is of ${b_commit:0:12} ($b_status), not the head of $BRANCH ${head_sha:0:12}"
        fi ;;
  esac
fi

[ "$fail" = 0 ] || exit 10
say "pages-check: the published site is a projection of $TRUNK, is current, and is being served"
