  breadcrumb "Getting started"
  page_header "Getting started" "From nothing to a supervised repository. Every command below is defined in the CLI specification and exercised by a behavioural test."
  printf '<div class="mx-auto max-w-screen-xl px-4 py-14">\n<div class="grid gap-12 lg:grid-cols-3">\n<div class="lg:col-span-2">\n'
  printf '<div class="format lg:format-lg dark:format-invert max-w-none">\n'
  section README.md "Quick start" 2 | md 1 2
  printf '</div>\n'

  printf '<h2 class="mb-4 mt-12 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">What a supervised task looks like</h2>\n'
