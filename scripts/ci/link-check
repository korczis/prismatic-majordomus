#!/usr/bin/env bash
# link-check: every link the built site publishes resolves, decided offline against the tree being
# published, with no network. Rule: project.every-link-and-control-is-tested.
#
# A link is any href or src the site emits: <a>, <link>, <script>, <img>, <source>, and every <loc>
# in sitemap.xml. Each one is exactly one of these, and each is decided:
#
#   internal     a same-origin URL, absolute (https://majordomus.dev/x/, which is what Zola emits)
#                or root-relative (/x/): a file must exist under site/public for it
#   fragment     #id, or a same-origin URL carrying one: the id must exist on the page it lands on.
#                A bare "#" goes nowhere and is refused. One fragment names more than an id:
#                #diagram-<name>:<node> addresses one node of a diagram (ADR 0152), and resolves
#                when the page carries the diagram and the diagram declares the node, as
#                scripts/lib/diagrams.mjs wrote both into the markup (id, data-nodes)
#   repository   a URL into this repository on its forge, resolved against git rather than fetched:
#                blob/<ref>/<path> is a tracked file, tree/<ref>/<path> a tracked directory (or a
#                file, which the forge redirects), commit/<sha> a commit in the history being
#                published, releases/tag/<tag> and tree/<tag> a tag, compare/<a>...<b> two refs.
#                The ref @source-ref@ is refused by name: it is the placeholder committed content
#                carries (scripts/lib/project-links.awk) until scripts/site-build pins it
#   snapshot     the root of a mount the publication holds a snapshot at and this build does not
#                compose (ADR 0141; /build.json `snapshots`, which scripts/site-build writes
#                from the publication model's deploy.snapshots). The deploy places the snapshot
#                after this check and refuses a site without it, and the public probe asks for
#                it (project.the-published-ui-is-the-trunks), so the root is decided by that
#                declaration. A link deeper into the mount is refused unless the snapshot is in
#                the tree: which pages a snapshot holds is its producer's bound, not this site's
#   refused      javascript:, an empty href, and a host none of the above resolves. A link that
#                cannot be decided without the network is not published: the finding says so,
#                and the way to add one is to teach this check how to decide it
#
# The internal and fragment classes read site/public alone. The repository class reads git, and it
# can only conclude what the clone was given: a shallow clone cannot say whether a commit is in the
# published history, and a clone fetched without tags cannot say whether a tag exists. In both cases
# the check refuses to report clean (exit 12) rather than pass over what it did not see — and,
# equally, it must not report a *finding* over what it did not see: "tag v0.6.0 does not exist" said
# about a tag with a published release is a false verdict, not a strict one.
#
# The pages SCANNED are the site's own. A surface scripts/site-build composes into the build at its
# mount (ADR 0086; the mounts are docs/generated/web.json's, through lib/common.sh's mj_web_composed)
# carries another producer's pages and links, which that surface's own check decides — but a link a
# site page makes INTO such a mount is the site's, and it is resolved against the composed files like
# any other: a site link to a reference page that is not there is a finding here.
#
# Usage: scripts/ci/link-check [--list] [--sources]   --list prints every link and its class
#
# --sources decides the commit links the SOURCES carry rather than the built pages: every
# commit/<sha> and commits/<ref> into this repository written in a tracked file under
# .ai/repo/project, site/data or site/content-src, by the same rules as a built page's (I3007).
# A record or a derived data file that names a commit the history does not hold (a reworded
# commit, a top that was never pushed) is refused before any site is built; a shallow clone
# defers, exactly as it does for a page.
# Exit 0 clean, 10 findings, 12 inputs missing or a clone too shallow to decide.
set -eu
ROOT="${MJ_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
LIST=0; SOURCES=0
for a in "$@"; do case "$a" in --list) LIST=1 ;; --sources) SOURCES=1 ;; *) echo "link-check: unknown option $a" >&2; exit 2 ;; esac; done
# shellcheck source=../../lib/common.sh
. "$(cd "$(dirname "$0")/../.." && pwd)/lib/common.sh"
# the sources are read without a build, so no composed surface is asked for
if [ "$SOURCES" = 1 ]; then MJ_LINK_COMPOSED=""; else MJ_LINK_COMPOSED="$(mj_web_composed "$ROOT" mounts)" || exit 12; fi
export MJ_LINK_ROOT="$ROOT" MJ_LINK_LIST="$LIST" MJ_LINK_SOURCES="$SOURCES" MJ_LINK_COMPOSED
exec python3 - <<'PY'
import collections, html, os, re, subprocess, sys, urllib.parse

ROOT = os.environ['MJ_LINK_ROOT']; LIST = os.environ['MJ_LINK_LIST'] == '1'
SOURCES = os.environ.get('MJ_LINK_SOURCES') == '1'
PUB = os.path.join(ROOT, 'site', 'public')
fails = []
def fail(cls, msg): fails.append((cls, msg)); print(f'FAIL {cls:<12} {msg}')
def ok(cls, msg): print(f'OK   {cls:<12} {msg}')

cfg = os.path.join(ROOT, 'site', 'config.toml')
if not os.path.isfile(cfg) or (not SOURCES and not os.path.isdir(PUB)):
    print('link-check: site/public or site/config.toml missing; run scripts/site-build', file=sys.stderr); sys.exit(12)
m = re.search(r'^base_url\s*=\s*"([^"]+)"', open(cfg).read(), re.M)
if not m: print('link-check: site/config.toml declares no base_url', file=sys.stderr); sys.exit(12)
BASE = urllib.parse.urlsplit(m.group(1)); ORIGIN = f'{BASE.scheme}://{BASE.netloc}'; PREFIX = BASE.path.rstrip('/')

proj = os.path.join(ROOT, 'site', 'data', 'generated', 'project.json')
REPO = None
if os.path.isfile(proj):
    rm = re.search(r'"repository_url"\s*:\s*"([^"]+)"', open(proj).read())
    if rm: REPO = urllib.parse.urlsplit(rm.group(1).rstrip('/'))
if REPO is None: print('link-check: site/data/generated/project.json names no repository_url', file=sys.stderr); sys.exit(12)

# The CI run the publication's own evidence names (scripts/pages evidence). That run produced the
# evidence, so a link to it is decided by provenance: the one Actions link this check accepts.
RUNS = set()
ev = os.path.join(ROOT, 'site', 'data', 'evidence.json')
if os.path.isfile(ev):
    import json
    try:
        run = (json.load(open(ev, encoding='utf-8')) or {}).get('run') or {}
        if str(run.get('id', '')).isdigit(): RUNS.add(str(run['id']))
    except ValueError:
        pass

def git(*args):
    return subprocess.run(['git', '-C', ROOT, *args], capture_output=True, text=True)

# The mounts the publication holds a snapshot at, as this build's own identity file states them.
SNAPSHOT_MOUNTS = set()
bj = os.path.join(PUB, 'build.json')
if os.path.isfile(bj):
    import json
    try:
        for s in (json.load(open(bj, encoding='utf-8')) or {}).get('snapshots') or []:
            if (s.get('mount') or '').strip('/'): SNAPSHOT_MOUNTS.add('/' + s['mount'].strip('/'))
    except ValueError:
        pass

# ------------------------------------------------------------------ the built site
# the composed mounts, relative to the build: "/rustdoc" -> "rustdoc"
COMPOSED = [m.strip('/') for m in os.environ.get('MJ_LINK_COMPOSED', '').split() if m.strip('/')]
def composed_under(rel): return any(rel == m or rel.startswith(m + '/') for m in COMPOSED)

pages = {}          # route -> html, the site's own pages: the ones whose links are scanned
composed_pages = {} # route -> path, a composed surface's pages: read only for the ids a site link names
files = set()       # every file under site/public, composed ones included, as a path relative to it
for dirpath, _, names in os.walk(PUB):
    for n in names:
        rel = os.path.relpath(os.path.join(dirpath, n), PUB).replace(os.sep, '/')
        files.add(rel)
        if n == 'index.html':
            route = '/' + os.path.dirname(rel) + '/' if os.path.dirname(rel) else '/'
            if composed_under(rel): composed_pages[route] = os.path.join(dirpath, n); continue
            pages[route] = open(os.path.join(dirpath, n), encoding='utf-8', errors='replace').read()
if not pages and not SOURCES: print('link-check: site/public holds no page', file=sys.stderr); sys.exit(12)

ID_RX = re.compile(r'\sid="([^"]+)"')
ids = {r: set(ID_RX.findall(t)) for r, t in pages.items()}
def ids_of(route):
    if route not in ids and route in composed_pages:
        ids[route] = set(ID_RX.findall(open(composed_pages[route], encoding='utf-8', errors='replace').read()))
    return ids.get(route, set())
# the nodes each diagram of a page declares: route -> {diagram id -> node ids}, read from what
# scripts/lib/diagrams.mjs wrote on the <pre> (id, then data-nodes). A node fragment is decided
# against this and nothing else: the drawing does not exist until a browser makes it.
DIAGRAM_RX = re.compile(r'<pre\b[^>]*\sid="(diagram-[^"]+)"[^>]*\sdata-nodes="([^"]*)"')
diagram_nodes = {}
def nodes_of(route, diagram):
    if route not in diagram_nodes:
        diagram_nodes[route] = {d: set(html.unescape(n).split()) for d, n in DIAGRAM_RX.findall(pages.get(route, ''))}
    return diagram_nodes[route].get(diagram)
# every attribute that makes the browser go somewhere; srcset is split into its URLs
# quote-aware: an attribute value may hold ">" (an Alpine handler's `() => {...}`), which [^>]* would end the tag on
ATTR_RX = re.compile(r'<(a|link|script|img|source|iframe|area)\b((?:\s+[^\s"\'>/=]+(?:\s*=\s*(?:"[^"]*"|\'[^\']*\'|[^\s"\'>]+))?)*)\s*/?>', re.I)
HREF_RX = re.compile(r'\s(href|src|srcset)\s*=\s*"([^"]*)"', re.I)

def resolve_file(path):
    """A same-origin path to the file the static server would answer with, or None."""
    p = urllib.parse.unquote(path)
    if PREFIX and p.startswith(PREFIX): p = p[len(PREFIX):] or '/'
    p = p.lstrip('/')
    for cand in (p, p.rstrip('/') + '/index.html' if p else 'index.html', p + '/index.html'):
        if cand in files: return cand
    return None

def route_of(file_rel):
    return '/' + file_rel[:-len('index.html')] if file_rel.endswith('index.html') else None

links = []   # (page, raw)
for route, t in pages.items():
    for tag, attrs in ATTR_RX.findall(t):
        if tag.lower() == 'link' and re.search(r'rel="(preconnect|dns-prefetch)"', attrs): continue
        for attr, val in HREF_RX.findall(attrs):
            vals = [v.strip().split(' ')[0] for v in val.split(',')] if attr.lower() == 'srcset' else [val]
            for v in vals: links.append((route, html.unescape(v)))
sm = os.path.join(PUB, 'sitemap.xml')
if os.path.isfile(sm):
    for loc in re.findall(r'<loc>([^<]+)</loc>', open(sm, encoding='utf-8').read()):
        links.append(('/sitemap.xml', html.unescape(loc.strip())))

# ------------------------------------------------------------------ the tree being published
shallow = git('rev-parse', '--is-shallow-repository').stdout.strip() == 'true'
tracked = set(git('ls-files', '-z').stdout.split('\0')) - {''}
dirs = set()
for f in tracked:
    parts = f.split('/')
    for i in range(1, len(parts)): dirs.add('/'.join(parts[:i]))
history = set(git('rev-list', 'HEAD').stdout.split())
tags = set(git('tag', '-l').stdout.split())
branches = {b.strip().removeprefix('origin/') for b in git('branch', '-a', '--format=%(refname:short)').stdout.split()}
# the ref scripts/lib/project-links.awk writes into committed content and scripts/site-build
# replaces with the built commit; one that reaches the built site was never resolved
PLACEHOLDER = '@source-ref@'
def is_ref(x):
    if x in tags or x in branches: return True
    return bool(re.fullmatch(r'[0-9a-f]{7,40}', x)) and any(h.startswith(x) for h in history)

# What the clone was given decides what this check may conclude. `fetch-depth: 1` truncates
# the history *and* fetches no tags, so a tag is absent here for the same reason a commit is:
# nobody fetched it — not because it does not exist. The commit and compare paths below already
# refuse to decide when the history is missing; the tag and ref paths asserted non-existence
# instead, and that is how v0.3.1, v0.5.0 and v0.6.0 — three tags carrying published releases —
# became six blocking findings that skipped `publish` on every deploy after #356.
knows_history = not shallow      # the commits are here to be searched
knows_tags = bool(tags)          # a clone fetched without tags can decide no tag
def undecidable(ref):
    """True when this clone was never given what a verdict about `ref` would need."""
    if ref in tags or ref in branches: return False
    return not knows_history if re.fullmatch(r'[0-9a-f]{7,40}', ref) else not knows_tags
def ref_finding(raw, ref, absent):
    """`absent` only when the ref is certainly not there; deferral when this clone cannot know."""
    if is_ref(ref): return None
    if undecidable(ref): undecided.append(raw); return None
    return absent

counts = collections.Counter(); undecided = []
def decide(page, raw):
    if raw == '' : return ('refused', 'an empty href goes nowhere')
    if raw == '#': return ('refused', 'a bare "#" goes nowhere')
    low = raw.lower()
    if low.startswith(('javascript:', 'data:')): return ('refused', f'{raw[:40]} is not a link')
    if low.startswith(('mailto:', 'tel:')): return ('refused', f'{raw} cannot be decided offline')
    u = urllib.parse.urlsplit(raw)
    if u.scheme in ('http', 'https') and u.netloc == REPO.netloc:
        if not (u.path + '/').startswith(REPO.path + '/'): return ('refused', f'{raw} is on the forge but not this repository')
        rest = u.path[len(REPO.path):].strip('/')
        kind, _, tail = rest.partition('/')
        if kind == '': return ('repository', None)
        if kind == 'blob':
            ref, _, path = tail.partition('/'); path = urllib.parse.unquote(path)
            if urllib.parse.unquote(ref) == PLACEHOLDER: return ('repository', f'{raw}: the placeholder ref {PLACEHOLDER} was never resolved; scripts/site-build pins it to the built commit')
            if not is_ref(ref):
                return ('repository', ref_finding(raw, ref, f'{raw}: {ref} is no ref of this repository'))
            if path in tracked: return ('repository', None)
            if path in dirs: return ('repository', f'{raw}: {path} is a directory; the link is tree/, not blob/')
            return ('repository', f'{raw}: {path} is not a tracked file, so the forge answers 404')
        if kind == 'tree':
            ref, _, path = tail.partition('/'); path = urllib.parse.unquote(path.rstrip('/'))
            if urllib.parse.unquote(ref) == PLACEHOLDER: return ('repository', f'{raw}: the placeholder ref {PLACEHOLDER} was never resolved; scripts/site-build pins it to the built commit')
            if not is_ref(ref):
                return ('repository', ref_finding(raw, ref, f'{raw}: {ref} is no ref of this repository'))
            if path == '' or path in dirs or path in tracked: return ('repository', None)
            return ('repository', f'{raw}: {path} is not tracked, so the forge answers 404')
        if kind in ('commit', 'commits'):
            ref = tail.strip('/')
            if kind == 'commits' and (ref in tags or ref in branches): return ('repository', None)
            if shallow or undecidable(ref): undecided.append(raw); return ('repository', None)
            if re.fullmatch(r'[0-9a-f]{7,40}', ref) and any(h.startswith(ref) for h in history): return ('repository', None)
            return ('repository', f'{raw}: {ref} is not in the history being published')
        if kind == 'releases':
            if tail in ('', 'latest'): return ('repository', None)
            if tail.startswith('tag/'):
                t = urllib.parse.unquote(tail[4:])
                if not knows_tags: undecided.append(raw); return ('repository', None)
                return ('repository', None if t in tags else f'{raw}: tag {t} does not exist')
            if tail.startswith('download/'):
                t = tail.split('/')[1]
                if not knows_tags: undecided.append(raw); return ('repository', None)
                return ('repository', None if t in tags else f'{raw}: tag {t} does not exist')
            return ('repository', f'{raw}: a releases path this check does not know')
        if kind == 'compare':
            a, sep, b = tail.partition('...')
            if not sep: return ('repository', f'{raw}: a compare without "..."')
            refs = [urllib.parse.unquote(x) for x in (a, b)]
            if shallow or any(undecidable(r) for r in refs):
                undecided.append(raw); return ('repository', None)
            bad = [r for r in refs if not is_ref(r)]
            return ('repository', f'{raw}: {", ".join(bad)} is no ref of this repository' if bad else None)
        if kind == 'actions':
            # A run is decided by provenance rather than by the network: the one run the
            # publication's own evidence names produced that evidence, so it exists. Any other
            # run link is as undecidable offline as it ever was.
            rm_ = re.fullmatch(r'runs/(\d+)(?:/attempts/\d+)?/?', tail)
            if rm_ and rm_.group(1) in RUNS: return ('repository', None)
        if kind in ('issues', 'pull', 'actions', 'milestones', 'discussions'):
            return ('refused', f'{raw}: a {kind} link cannot be decided offline')
        return ('refused', f'{raw}: a forge path this check does not know how to decide')
    if u.scheme in ('http', 'https') and u.netloc != BASE.netloc:
        return ('refused', f'{raw}: {u.netloc} cannot be decided offline')
    if u.scheme not in ('', 'http', 'https'):
        return ('refused', f'{raw}: the scheme {u.scheme} cannot be decided')
    # same origin: absolute, root-relative, or relative to the page
    if u.netloc == '' and not u.path.startswith('/') and u.path:
        path = urllib.parse.urljoin(page, u.path)
    else:
        path = u.path or page
    if page == '/sitemap.xml' and not path: path = '/'
    target = resolve_file(path) if path else None
    if target is None:
        rel = urllib.parse.unquote(path)
        if PREFIX and rel.startswith(PREFIX): rel = rel[len(PREFIX):] or '/'
        for mnt in SNAPSHOT_MOUNTS:
            if rel.rstrip('/') == mnt and not u.fragment: return ('snapshot', None)
            if rel.startswith(mnt + '/'):
                return ('snapshot', f'{raw} leads into the snapshot the publication holds at {mnt}/, past its root; only the root is decided before the snapshot is placed')
        return ('internal', f'{raw} resolves to no file under site/public')
    if u.fragment:
        r = route_of(target)
        if r is None: return ('fragment', None)
        frag = urllib.parse.unquote(u.fragment)
        if frag not in ids_of(r):
            diagram, colon, node = frag.partition(':')
            if colon and diagram.startswith('diagram-') and diagram in ids_of(r):
                declared = nodes_of(r, diagram)
                if declared is not None and node in declared: return ('fragment', None)
                return ('fragment', f'{raw} names node {node} of #{diagram}, which that diagram on {r} does not declare')
            return ('fragment', f'{raw} names #{frag}, which {r} does not carry')
        return ('fragment', None)
    return ('internal', None)

if SOURCES:
    # the commit links the sources carry, from tracked files only: an untracked record is never
    # published, and a file the build writes is a page, which the default mode decides (I3007)
    forge = re.escape(f'{REPO.scheme}://{REPO.netloc}{REPO.path}')
    COMMIT_RX = re.compile(forge + r'/commits?/[0-9A-Za-z._-]+')
    tracked_src = git('ls-files', '-z', '--', '.ai/repo/project', 'site/data', 'site/content-src').stdout.split('\0')
    links = []
    for rel in tracked_src:
        if not rel.endswith(('.yaml', '.yml', '.json', '.md', '.toml', '.html', '.txt')): continue
        try:
            body = open(os.path.join(ROOT, rel), encoding='utf-8', errors='replace').read()
        except OSError:
            continue
        for raw in COMMIT_RX.findall(body):
            links.append((rel, raw))
    # and the commits the data hands a template to link: the key names come from the templates
    # themselves (`/commit/{{ x.y.commit }}` -> commit), so a template that links another field
    # brings it under this check with no edit here. `build.commit` is written by the build itself.
    tpl = ''
    for dirpath, _, names in os.walk(os.path.join(ROOT, 'site', 'templates')):
        for n in names:
            if n.endswith('.html'):
                tpl += open(os.path.join(dirpath, n), encoding='utf-8', errors='replace').read()
    LINKED = {k for path, k in re.findall(r'/commits?/\{\{\s*((?:[\w]+\.)*)(\w+)\s*\}\}', tpl) if path != 'build.'}
    HEX = re.compile(r'[0-9a-f]{7,40}')
    def walk(node, where):
        if isinstance(node, dict):
            for k, v in node.items():
                if k in LINKED and isinstance(v, str) and HEX.fullmatch(v):
                    yield where + '.' + k, v
                else:
                    yield from walk(v, where + '.' + k)
        elif isinstance(node, list):
            for i, v in enumerate(node):
                yield from walk(v, f'{where}[{i}]')
    import json
    for rel in tracked_src:
        if not (rel.startswith('site/data/') and rel.endswith('.json')): continue
        try:
            data = json.load(open(os.path.join(ROOT, rel), encoding='utf-8'))
        except (OSError, ValueError):
            continue
        for where, sha in walk(data, ''):
            links.append((f'{rel}:{where.lstrip(".")}', f'{REPO.scheme}://{REPO.netloc}{REPO.path}/commit/{sha}'))
    pages = {rel: '' for rel, _ in links}

by_page = collections.defaultdict(list); seen = set()
for page, raw in links:
    cls, problem = decide(page, raw)
    counts[cls] += 1
    if LIST: print(f'LINK {cls:<12} {page} -> {raw}')
    if problem and (cls, problem) not in seen:
        seen.add((cls, problem)); by_page[(cls, problem)].append(page)
for (cls, problem), where in sorted(by_page.items()):
    extra = f' (and {len(where) - 1} more page(s))' if len(where) > 1 else ''
    fail(cls, f'{where[0]}: {problem}{extra}')

total = sum(counts.values())
summary = ', '.join(f'{counts[c]} {c}' for c in ('internal', 'fragment', 'repository', 'snapshot', 'refused') if counts[c])
if undecided:
    missing = ' and '.join(x for x, ok in (('history', knows_history), ('tags', knows_tags)) if not ok) or 'refs'
    print(f'link-check: {len(undecided)} link(s) to a commit, compare, tag or ref cannot be decided '
          f'by a clone with no {missing}; check out with fetch-depth: 0', file=sys.stderr)
    sys.exit(12)
if fails:
    print(f'link-check: {len(fails)} finding(s) over {total} link(s) on {len(pages)} page(s): {summary}')
    sys.exit(10)
# every page of theirs, not only the index.html routes: rustdoc's item pages are struct.X.html
n_composed = sum(1 for f in files if f.endswith('.html') and composed_under(f))
scope = (f'; the {n_composed} page(s) under {", ".join("/" + m + "/" for m in COMPOSED)} are composed surfaces\' own'
         ' and were not scanned, and every link into them was resolved against their files') if COMPOSED else ''
ok('links', f'{total} link(s) on {len(pages)} page(s) resolve: {summary}{scope}')
PY
