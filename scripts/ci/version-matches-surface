#!/usr/bin/env bash
# version-matches-surface — the version is measured against the public contract, not claimed.
#
# This script holds no domain semantics and must not acquire any. It is an adapter: it runs
# the one canonical analyser and maps its exit code to the gate's. Everything it used to
# decide for itself — which atoms make up the public surface, what a removal costs, what the
# `0.x` floor is, which release is the baseline — now lives in the typed engine, where it is
# one implementation with one set of tests instead of a shell copy nothing could exercise:
#
#   apps/majordomus-cli/src/release/surface.rs   what the public contract is
#   apps/majordomus-cli/src/release/compat.rs    what a movement of it costs, and the policy
#
# The same value answers `majordomus release analyze`, `GET /api/v1/release/analysis`, the
# `majordomus_release_analysis` MCP tool, the Cockpit panel and `release bump`. That is the
# point: a gate that re-derived the verdict would be a fifth authority, and the reason this
# subsystem was rebuilt is that there were two.
#
#   scripts/ci/version-matches-surface              the tree against the last release
#   scripts/ci/version-matches-surface --since REF  against that ref instead
#   scripts/ci/version-matches-surface --explain    every movement, and why each counts
#   scripts/ci/version-matches-surface --json       the canonical VersionPlan
#   MJ_ROOT=DIR ...                                 examine that repository instead of this one
#
# Exit 0 the declared version covers what the contract did · 10 it does not, and the refusal
# names what moved · 12 the analysis could not be made (no release to compare with, a
# baseline that carries no committed registry, a shallow clone) · 2 usage.
set -euo pipefail

# Two roots, and they are not the same one. HERE is the checkout this script belongs to,
# which is where the launcher that builds the executable lives; ROOT is the repository being
# examined, which MJ_ROOT may point elsewhere (the behavioural case does exactly that). The
# old gate conflated them by `cd`-ing into ROOT and running a relative path, which worked
# only while the two were the same directory.
HERE="$(cd "$(dirname "$0")/../.." && pwd)"
ROOT="${MJ_ROOT:-$HERE}"

ARGS=()
FORMAT=text
while [ $# -gt 0 ]; do
  case "$1" in
    --since) [ $# -ge 2 ] || { echo "version-matches-surface: --since needs a ref" >&2; exit 2; }
             ARGS+=(--since "$2"); shift 2 ;;
    --explain) ARGS+=(--explain); shift ;;
    --json) FORMAT=json; shift ;;
    -h|--help) sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "version-matches-surface: unknown option $1" >&2; exit 2 ;;
  esac
done

# `bin/majordomus-cli` builds the executable when it must and runs it; every other gate that
# needs the crate reaches it the same way, so the bootstrap is stated once.
#
# `${ARGS[@]+...}`, not a bare `"${ARGS[@]}"`: under `set -u` bash 3.2 — which is what macOS
# ships and what `project.portable-shell` requires this to run under — an empty array is an
# unbound variable, so the common case, no arguments at all, is the one that would fail.
exec "$HERE/bin/majordomus-cli" release analyze --repo "$ROOT" --format "$FORMAT" ${ARGS[@]+"${ARGS[@]}"}
