#!/usr/bin/env bash
# enforcement-check — a promise names a proof a machine can follow.
#
# Two populations in this repository are promises, and each had a surface reporting a
# number that read like a statement about all of it:
#
#   1. rules declared `class: blocking`. `doctor` reported "41 doctrines — validator,
#      dispatch, propagation, test and CI resolve for every one" while the same run
#      reported 122 rules. "Every one" meant every one of the subset carrying a validator.
#      A blocking rule outside that subset is not in the dispatcher's registry at all, so
#      "missing validators: 0" was true of the registry and said nothing about the 57
#      blocking rules that are not in it.
#   2. claims marked `status: guaranteed` in docs/CLAIMS.yaml. `generate-site-data --check`
#      verifies that the named test *path exists*. A path existing is not a proof
#      executing: the file can be renamed away from what it once asserted, or gutted, and
#      the claim keeps its pointer. The link is written once, in the claim, and nothing
#      reads it back from the test.
#
# So this gate asks one question of both: can a machine follow the promise to something
# that runs? It never asks whether the proof is good — only whether it can be found.
#
# What counts as enforcement for a blocking rule:
#   - an x-majordomus block, so doctrine.sh has a validator to dispatch; or
#   - a path in the rule's `# Verification` section that exists and is evidence that runs:
#     test/cases/, apps/majordomus-cli/tests/, scripts/, .github/workflows/.
#   A rule whose Verification section says only "Review." is held by a person, and this
#   gate says so rather than counting it.
#
# What counts as a followable proof for a guaranteed claim: the test the claim names
# contains the claim's id. That is deliberately weak — a mention is not an assertion — and
# the verdict says "names" rather than "proves", because a check that cannot see the
# difference must not claim it can.
#
# Both halves are ratchets. The debt is real, predates the gate, and is recorded by id in
# .ai/repo/enforcement-baseline.txt: the sets may shrink and may not grow. Nothing here is
# ever satisfied by lowering a bar — a baseline entry is removed by wiring the enforcement,
# and the gate reports an entry that no longer matches so the list cannot rot.
#
# Every verdict below states its denominator. That is the whole point of the gate and it
# would be absurd for the gate itself to print a bare count.
#
#   scripts/ci/enforcement-check                    report, and fail on a new promise with no proof
#   scripts/ci/enforcement-check --write-baseline   record today's debt (a deliberate act)
#   scripts/ci/enforcement-check --strict           fail on any, baseline ignored
#   MJ_ROOT=<dir> scripts/ci/enforcement-check      measure another tree (case 230 does)
#
# Exit: 0 clean or debt unchanged, 10 a promise with no proof that the baseline does not
# carry (or any under --strict), 12 unusable.
set -eu
set -o pipefail

ROOT="${MJ_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
cd "$ROOT"
RULES_DIR=".ai/repo/rules"
CLAIMS="docs/CLAIMS.yaml"
BASELINE=".ai/repo/enforcement-baseline.txt"
MODE="report"
while [ $# -gt 0 ]; do case "$1" in
  --write-baseline) MODE="write"; shift ;;
  --strict) MODE="strict"; shift ;;
  *) echo "enforcement-check: unknown option $1" >&2; exit 2 ;;
esac; done

[ -d "$RULES_DIR" ] || { echo "enforcement-check: no $RULES_DIR to measure" >&2; exit 12; }

# ---------------------------------------------------------------- the rule half
# The front matter only. A rule's body quotes `class: blocking` when it explains the
# classes, and a gate that read the whole file would count the documentation of its own
# subject as its subject — which is exactly how scripts/ci/lease-reader-check came to
# report itself and how pipefail-check came to report a library whose comments mention
# `set -e`. The front matter is the block between the first two `---` lines and nothing else.
front_matter() { awk 'NR == 1 && $0 == "---" { inb = 1; next } inb && $0 == "---" { exit } inb { print }' "$1"; }

# The `# Verification` section, to the next heading. This is prose, and what is extracted
# from it is only the path-shaped tokens, each of which is then required to exist. A path
# that a rule names and the tree does not have is not enforcement; it is a stale pointer,
# and it is the more dangerous kind because it reads as evidence.
verification() { awk '/^# Verification/ { inb = 1; next } inb && /^# / { exit } inb { print }' "$1"; }

# Evidence that runs, by location. A rule pointing at docs/ or at a .md is pointing at more
# prose; the point of this gate is the difference between the two.
runs() {
  case "$1" in
    test/cases/*|apps/majordomus-cli/tests/*|apps/majordomus-cli/benches/*) [ -f "$1" ] ;;
    scripts/*|.github/workflows/*) [ -f "$1" ] ;;
    *) return 1 ;;
  esac
}

rule_files() { find "$RULES_DIR" -name '*.md' ! -name 'README.md' 2>/dev/null | LC_ALL=C sort; }

blocking_total=0
rule_debt=""
for f in $(rule_files); do
  fm="$(front_matter "$f")"
  id="$(printf '%s\n' "$fm" | sed -n 's/^id: *//p' | sed -n '1p')"
  [ -n "$id" ] || continue
  cls="$(printf '%s\n' "$fm" | sed -n 's/^class: *//p' | sed -n '1p')"
  [ "$cls" = blocking ] || continue
  blocking_total=$((blocking_total + 1))
  # a validator the dispatcher runs
  printf '%s\n' "$fm" | grep -q '^x-majordomus:' && continue
  # or a path in the Verification section that exists and runs
  found=0
  for tok in $(verification "$f" | tr -c 'A-Za-z0-9_./-' ' '); do
    tok="${tok%.}"; tok="${tok%,}"
    case "$tok" in
      */*) runs "$tok" && { found=1; break; } ;;
      # A case named the way the runner takes it — `bash test/run.sh 98_why_catalogue` —
      # rather than by path. Writing this gate without it produced its own false positive:
      # project.why-catalogue-is-canonical was reported as naming no proof while naming a
      # case that exists and runs. A detector that cannot tell one spelling of its subject
      # from the absence of the subject is the defect this gate is about, so it may not
      # have that defect itself.
      [0-9][0-9]_*|[0-9][0-9][0-9]_*)
        for c in test/cases/"$tok"*.sh; do [ -f "$c" ] && { found=1; break; }; done
        [ "$found" = 1 ] && break ;;
    esac
  done
  [ "$found" = 1 ] && continue
  rule_debt="$rule_debt$id
"
done
rule_debt="$(printf '%s' "$rule_debt" | grep -v '^$' || true)"
rule_debt_n="$(printf '%s\n' "$rule_debt" | grep -c . || true)"

# ---------------------------------------------------------------- the claim half
claim_total=0
claim_debt=""
if [ -f "$CLAIMS" ]; then
  # id, status and test, one row per claim, from the claims list. The fields are read in
  # the order they appear and the first of each wins, because the `note:` below a claim may
  # contain anything at all.
  rows="$(awk '
    /^  - id: /   { if (id != "") print id "\t" st "\t" tst; id = substr($0, 9); st = ""; tst = ""; next }
    /^    status: / { if (st  == "") st  = substr($0, 13) }
    /^    test: /   { if (tst == "") tst = substr($0, 11) }
    END { if (id != "") print id "\t" st "\t" tst }' "$CLAIMS")"
  while IFS="$(printf '\t')" read -r id st tst; do
    [ "$st" = guaranteed ] || continue
    claim_total=$((claim_total + 1))
    if [ -n "$tst" ] && [ "$tst" != "-" ] && [ -f "$tst" ] && LC_ALL=C grep -qIF "$id" "$tst" 2>/dev/null; then continue; fi
    claim_debt="$claim_debt$id
"
  done <<ROWS
$rows
ROWS
fi
claim_debt="$(printf '%s' "$claim_debt" | grep -v '^$' || true)"
claim_debt_n="$(printf '%s\n' "$claim_debt" | grep -c . || true)"

current="$(printf '%s\n%s\n' "$rule_debt" "$claim_debt" | grep -v '^$' | LC_ALL=C sort -u || true)"

# ---------------------------------------------------------------- the report
if [ "$MODE" = write ]; then
  { echo "# Promises this repository makes that no machine can follow to a proof."
    echo "#"
    echo "# A rule declared \`class: blocking\` with neither an x-majordomus block nor a path in"
    echo "# its \`# Verification\` section that exists and runs; and a claim marked"
    echo "# \`status: guaranteed\` whose named test does not name the claim back."
    echo "#"
    echo "# Written by scripts/ci/enforcement-check --write-baseline; never by hand. The list"
    echo "# may only shrink, and it shrinks by wiring the enforcement — never by softening the"
    echo "# rule's class or the claim's status, which would move the promise instead of keeping it."
    printf '%s\n' "$current" | grep -v '^$' || true
  } > "$BASELINE"
  echo "enforcement-check: baseline written — $rule_debt_n of $blocking_total blocking rule(s), $claim_debt_n of $claim_total guaranteed claim(s)"
  exit 0
fi

printf 'blocking rules:      %s of %s carry neither a validator nor a Verification path that runs\n' "$rule_debt_n" "$blocking_total"
printf 'guaranteed claims:   %s of %s name a test that does not name the claim back\n' "$claim_debt_n" "$claim_total"

if [ "$blocking_total" = 0 ] || [ "$claim_total" = 0 ]; then
  echo "enforcement-check: a population is empty — measuring nothing and passing is how a check stops working without saying so" >&2
  exit 12
fi

if [ "$MODE" = strict ]; then
  if [ -z "$current" ]; then echo "enforcement-check: every blocking rule and every guaranteed claim names a proof"; exit 0; fi
  printf '%s\n' "$current" | sed 's/^/  /' >&2
  echo "enforcement-check: $(printf '%s\n' "$current" | grep -c . || true) promise(s) with no followable proof (--strict)" >&2
  exit 10
fi

[ -f "$BASELINE" ] || { echo "enforcement-check: no baseline at $BASELINE (run --write-baseline)" >&2; exit 12; }
known="$(grep -vE '^[[:space:]]*(#|$)' "$BASELINE" | LC_ALL=C sort -u || true)"

gone="$(comm -13 <(printf '%s\n' "$current" | grep -v '^$') <(printf '%s\n' "$known" | grep -v '^$') || true)"
new="$(comm -23 <(printf '%s\n' "$current" | grep -v '^$') <(printf '%s\n' "$known" | grep -v '^$') || true)"

if [ -n "$gone" ]; then
  echo
  echo "enforcement-check: a promise now has a proof — tighten the baseline (--write-baseline):"
  printf '%s\n' "$gone" | sed 's/^/  FIXED /'
fi

if [ -n "$new" ]; then
  echo >&2
  echo "enforcement-check: a promise with no proof a machine can follow, not in $BASELINE:" >&2
  printf '%s\n' "$new" | sed 's/^/  NEW /' >&2
  echo "  A blocking rule needs an x-majordomus block naming mj_validate_<name>, or a" >&2
  echo "  \`# Verification\` section naming a case under test/cases/ or a gate under scripts/." >&2
  echo "  A guaranteed claim needs its id written into the test it names, so the link can be" >&2
  echo "  read from both ends. Do not answer this by lowering the class or the status." >&2
  exit 10
fi

printf 'enforcement-check: %s known, no new promise without a proof\n' "$(printf '%s\n' "$known" | grep -c . || true)"
