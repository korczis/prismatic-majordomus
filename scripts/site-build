#!/usr/bin/env bash
# site-build — data → derived content → assets → Tailwind/Flowbite CSS → Zola. Deterministic.
#   scripts/site-build            build into site/public/
#   scripts/site-build --no-css   skip the Node steps; the stylesheet is written empty and the
#                                 vendored JS is absent, so the markup is the site's and the styling is not
#   scripts/site-build --no-data  build from site/data/generated as committed, without regenerating
#                                 it. Only for a caller that has already established the data is
#                                 current — scripts/pages does, by fingerprint. Nothing else may.
#   scripts/site-build --base-url URL   build for another origin (local previews); get_url is absolute in Zola
#   scripts/site-build --serve    build the same source for `majordomus serve`: mounted under
#                                 /docs, written into target/web/docs with the surface.json that
#                                 makes it discoverable. One source, one generator, two base URLs;
#                                 there is no second copy of the documentation anywhere.
#   scripts/site-build --output-dir DIR   write the build into DIR instead of site/public
#   scripts/site-build --pin-source-refs DIR BUILD_JSON   only the source-ref pass below, over a
#                                 built DIR with the provenance BUILD_JSON records (for the cases)
#   scripts/site-build --release  only the release this build offers, as JSON on stdout (below)
#     [--release-record FILE]     the record's projection to read instead of
#                                 site/data/registry/distribution.json
#     [--release-published FILE]  a published releases/latest.json to read instead of the ref
#     [--release-ref REF]         the published branch to read it from (default origin/gh-pages,
#                                 or $MJ_SITE_RELEASE_REF); all three apply to a full build too
#
# THE RELEASE THIS SITE OFFERS is derived here, once, and every page reads it from
# data/build.json (`build.release`) — the navbar badge, the homepage's hero and trust strip,
# the Cockpit pictures — and /build.json serves it. It is the newer of two readings of one
# fact: the newest release record on this tree (site/data/registry/distribution.json, the
# projection of .ai/repo/releases/) and the release metadata gh-pages already serves
# (releases/latest.json, which the release's publish job writes minutes after its archives,
# ahead of its record: ADR 0131). Until 2026-10-12 the pages read the record alone, and the
# record reaches master only through a pull request that needs its own full validation, so
# for hours after every release the installer resolved v0.21.0 while the homepage beside the
# install command offered v0.20.0. The published metadata is read from the git ref, never
# fetched over the network here: the build is a function of two commits, and build.json
# names both (`published_from`). When the published release wins, its two files are copied
# into the build, so the bytes this build publishes at /releases/latest.json are the release
# its pages offer. The rule is project.the-site-offers-the-release-it-published.
#
# Every build, published or served, also COMPOSES the other published static surfaces into
# its output at their mounts (ADR 0086): each surface of docs/generated/web.json of kind
# static-directory that the published site carries, other than the app, is copied from its
# artifact directory after Zola and after the accessibility pass, which is the site's and
# never touches another surface's pages. Nothing here names one: the topology does. A
# published surface whose producer has not run refuses the build (exit 12) and names the
# producer, because a site that silently lost a surface is the stale deployment nobody sees.
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"; SITE="$ROOT/site"; NOCSS=0; NODATA=0; BASE=""; OUT=""; SERVE=0
MJ_VERSION="site-build"; MJ_BIN_DIR="$ROOT/bin"; MJ_LIB_DIR="$ROOT/lib"; export MJ_VERSION MJ_BIN_DIR MJ_LIB_DIR
# for mj_web_composed, the one reading of which surfaces are composed into the site
# shellcheck source=../lib/common.sh
. "$ROOT/lib/common.sh"
# where a build for the running server goes and what it is mounted at; the same two values
# the executable reads from web::discover (DOCS_ARTIFACT, DOCS_MOUNT)
SERVE_OUT="target/web/docs"; SERVE_MOUNT="/docs"
while [ $# -gt 0 ]; do case "$1" in
  --no-css) NOCSS=1; shift ;;
  --no-data) NODATA=1; shift ;;
  --base-url) BASE="$2"; shift 2 ;;
  --output-dir) OUT="$2"; shift 2 ;;
  --serve) SERVE=1; shift ;;
  --pin-source-refs) [ $# -ge 3 ] || { echo "site-build: --pin-source-refs DIR BUILD_JSON" >&2; exit 2; }
    PIN_DIR="$2"; PIN_BUILD="$3"; shift 3 ;;
  --release) RELEASE_ONLY=1; shift ;;
  --release-record) REL_RECORD="${2:?--release-record needs a file}"; shift 2 ;;
  --release-records) REL_RECORDS="${2:?--release-records needs a directory}"; shift 2 ;;
  --release-published) REL_PUBLISHED="${2:?--release-published needs a file}"; shift 2 ;;
  --release-ref) REL_REF="${2:?--release-ref needs a ref}"; shift 2 ;;
  *) echo "site-build: unknown option $1" >&2; exit 2 ;;
esac; done
# ---------------------------------------------------------------- the release this site offers
# release_offered <dir>: writes <dir>/release.json — the release object build.json carries, or
# null when neither reading names a release — and, when the published release is the newer,
# <dir>/latest.json with the published bytes. Exit 10 when the published branch serves a
# releases/latest.json that is not a release document, or a tag file that differs from it;
# 12 when the record's projection cannot be read.
REL_RECORD="${REL_RECORD:-$SITE/data/registry/distribution.json}"
REL_RECORDS="${REL_RECORDS:-$ROOT/.ai/repo/releases}"
REL_PUBLISHED="${REL_PUBLISHED:-}"
REL_REF="${REL_REF:-${MJ_SITE_RELEASE_REF:-origin/gh-pages}}"
release_offered() {
  local dir="$1" from="" sha="" tag
  [ -f "$REL_RECORD" ] && jq -e . "$REL_RECORD" >/dev/null 2>&1 \
    || { echo "site-build: $REL_RECORD cannot be read; run majordomus generate" >&2; exit 12; }
  rm -f "$dir/published.json" "$dir/latest.json"
  if [ -n "$REL_PUBLISHED" ]; then
    cp "$REL_PUBLISHED" "$dir/published.json"; from="file:${REL_PUBLISHED##*/}"
  elif sha="$(git -C "$ROOT" rev-parse --verify -q "$REL_REF^{commit}" 2>/dev/null)" \
       && git -C "$ROOT" cat-file -e "$sha:releases/latest.json" 2>/dev/null; then
    git -C "$ROOT" show "$sha:releases/latest.json" > "$dir/published.json"; from="$REL_REF@$sha"
  fi
  if [ -f "$dir/published.json" ]; then
    jq -e '.schema == "release/v1" and (.version | type == "string") and .tag == ("v" + .version)' \
      "$dir/published.json" >/dev/null 2>&1 \
      || { echo "site-build: ${from} serves a releases/latest.json that is not a release/v1 document naming its own tag" >&2; exit 10; }
    tag="$(jq -r .tag "$dir/published.json")"
    if [ -z "$REL_PUBLISHED" ] && git -C "$ROOT" cat-file -e "$sha:releases/$tag.json" 2>/dev/null; then
      git -C "$ROOT" show "$sha:releases/$tag.json" | cmp -s - "$dir/published.json" \
        || { echo "site-build: ${from} serves releases/latest.json and releases/$tag.json that differ; one of them is stale" >&2; exit 10; }
    fi
  else
    printf 'null\n' > "$dir/published.json"
  fi
  # Versions compare numerically per dot-separated field, anything after `-` or `+` ignored, as
  # scripts/site-deploy compares them; the record wins a tie, being the same release.
  jq -n --slurpfile d "$REL_RECORD" --slurpfile p "$dir/published.json" --arg from "$from" '
    def ver: split("-")[0] | split("+")[0] | split(".") | map(tonumber? // 0);
    ($d[0].latest // null) as $r | $p[0] as $q
    | if $q != null and ($r == null or ($q.version | ver) > ($r.version | ver)) then
        {version: $q.version, tag: $q.tag, published_at: $q.published_at, notes_url: $q.notes_url,
         url: (($d[0].latest_url // "") | sub("latest\\.json$"; $q.tag + ".json")), source: "published"}
      elif $r != null then
        {version: $r.version, tag: $r.tag, published_at: $r.published_at, notes_url: $r.notes_url,
         url: $r.url, source: "record"}
      else null end
    | if . == null then null
      else . + {record: ($r.version // null), published: ($q.version // null),
                published_from: (if $from == "" then null else $from end)} end' > "$dir/release.json" \
    || { echo "site-build: the release this site offers could not be derived" >&2; exit 13; }
  if [ "$(jq -r '.source // empty' "$dir/release.json")" = published ]; then
    cp "$dir/published.json" "$dir/latest.json"
  fi
  rm -f "$dir/published.json"
  release_prerelease "$dir"
}
# The newest pre-release beside the stable release (I3449, the release seat's ruling of
# 2026-10-21): the pages a person reads name both channels, each with its own notes and its own
# install line, while /releases/latest.json and the installer's default stay the stable one
# (I2829; cases 3222, 3179, 3225). Read from the release records themselves, never from a ref: the
# highest record of channel prerelease that is not yanked, and only when it is ahead of the
# stable release (an alpha of a version already released stable is behind it). Versions order
# by their numeric fields, then a pre-release's own dot-separated identifiers, numbers as numbers.
release_prerelease() { # dir (holds release.json; rewritten with .prerelease)
  local dir="$1" rows f
  rows="$dir/records.jsonl"
  : > "$rows"
  if [ -d "$REL_RECORDS" ]; then
    for f in "$REL_RECORDS"/v*.yaml; do
      [ -f "$f" ] || continue
      awk '/^(version|tag|channel|published_at|notes_url|yanked):/ {
             k = $1; sub(/:$/, "", k); v = $0; sub(/^[a-z_]+:[ ]*/, "", v); gsub(/^"|"$/, "", v)
             out = out (out == "" ? "" : ",") "\"" k "\":\"" v "\"" }
           END { print "{" out "}" }' "$f" >> "$rows"
    done
  fi
  jq -s --slurpfile r "$dir/release.json" --arg install "$(jq -r '.install_command // empty' "$REL_RECORD")" '
    def base: split("-")[0] | split("+")[0] | split(".") | map(tonumber? // 0);
    def pre: (split("+")[0] | split("-")[1:] | join("-") | split("."))
             | map(if test("^[0-9]+$") then [0, tonumber] else [1, .] end);
    ($r[0]) as $s
    | [.[] | select(.channel == "prerelease" and (.yanked // "false") != "true" and (.version // "") != "")]
    | (if $s == null then . else map(select((.version | base) > ($s.version | base))) end)
    | sort_by([(.version | base), (.version | pre)]) | last
    | (if . == null then null
       else {version, tag, published_at, notes_url,
             install_command: (if $install == "" then null else $install + " -s -- --version " + .tag end)} end) as $p
    | if $s == null then null else $s + {prerelease: $p} end' "$rows" > "$dir/release.next.json" \
    || { echo "site-build: the pre-release beside the offered release could not be derived" >&2; exit 13; }
  mv "$dir/release.next.json" "$dir/release.json"; rm -f "$rows"
}
if [ "${RELEASE_ONLY:-0}" = 1 ]; then
  command -v jq >/dev/null || { echo "site-build: jq is required" >&2; exit 12; }
  RELDIR="$(mktemp -d "${TMPDIR:-/tmp}/mj-site-release.XXXXXX")"
  release_offered "$RELDIR"; cat "$RELDIR/release.json"; rm -rf "$RELDIR"; exit 0
fi
# pin_source_refs <built dir> <build.json>: a committed page's link into its own source names the
# commit the site was built from. scripts/lib/project-links.awk writes those links into committed
# content with the placeholder ref @source-ref@, because a committed file cannot name the commit it
# is in; this replaces it, in every file of the build, with the ref site/templates/source-links.html
# gives the template-made links: the commit data/build.json records, or master when the build is
# dirty (rendered from bytes no commit holds), the commit is unknown, or there is no build.json.
# A placeholder left anywhere afterwards, in whatever spelling, is a link to no ref: refused.
pin_source_refs() {
  local dir="$1" build="$2" ref=master files f left
  if [ -f "$build" ]; then
    ref="$(jq -r 'if (.commit // "") != "" and .commit != "unknown" and (.dirty | not)
                  then .commit else "master" end' "$build")" \
      || { echo "site-build: $build does not parse" >&2; exit 12; }
  fi
  case "$ref" in *[!0-9a-zA-Z._-]*|"") echo "site-build: '$ref' in $build is not a ref" >&2; exit 12 ;; esac
  files="$(grep -rlF '@source-ref@' "$dir" || true)"
  for f in $files; do
    sed "s#/blob/@source-ref@/#/blob/$ref/#g; s#/tree/@source-ref@/#/tree/$ref/#g" "$f" > "$f.pin"
    mv "$f.pin" "$f"
  done
  left="$(grep -rliE '@source-ref@|%40source-ref%40' "$dir" || true)"
  if [ -n "$left" ]; then
    echo "site-build: a source-ref placeholder is left unresolved (not in a blob/ or tree/ link) in:" >&2
    printf '  %s\n' $left >&2
    exit 10
  fi
  printf '  %s file(s) name %s as the ref of their source links\n' \
    "$(printf '%s' "$files" | grep -c . || true)" "$ref"
}
if [ -n "${PIN_DIR:-}" ]; then pin_source_refs "$PIN_DIR" "$PIN_BUILD"; exit 0; fi
if [ "$SERVE" = 1 ]; then
  [ -n "$BASE" ] || BASE="$SERVE_MOUNT"
  [ -n "$OUT" ] || OUT="$SERVE_OUT"
fi
command -v zola >/dev/null || { echo "site-build: zola is required (brew install zola / see docs/GITHUB_PAGES_ARCHITECTURE.md)" >&2; exit 12; }
# The surfaces this build composes, and whether each one's artifact exists — asked before any
# generation or rendering is spent, because a build that cannot carry every published surface
# is refused whatever else it would have produced.
COMPOSED="$(mj_web_composed "$ROOT" rows)" || exit 12
while IFS="$MJ_TAB" read -r c_id c_mount c_artifact c_producer; do
  [ -n "$c_id" ] || continue
  if [ -z "$c_artifact" ] || [ ! -d "$ROOT/$c_artifact" ]; then
    printf 'site-build: surface %s is published at %s and its artifact %s is absent; run its producer: %s\n' \
      "$c_id" "$c_mount" "${c_artifact:-(none declared)}" "$c_producer" >&2
    exit 12
  fi
done <<EOF
$COMPOSED
EOF
if [ "$NODATA" = 0 ]; then echo "== data";    "$ROOT/scripts/generate-site-data"
else echo "== data    (committed, not regenerated)"; fi
echo "== assets"
mkdir -p "$SITE/static/images" "$SITE/static/js"
# the brand: the marks under site/static/images are generated copies of share/design/brand
# (written by `majordomus generate design`, compared by scripts/ci/design-check); the social
# card is a raster the generator does not write, copied from the same canonical directory
cp "$ROOT/share/design/brand/social-card.png" "$SITE/static/images/social-card.png"
if [ "$NOCSS" = 0 ]; then
  # the install goes through the mesh build cache (lib/rust_bin.sh, I3953): restored when the
  # lockfile's key is held, else `npm ci` and saved; a node_modules of a person's own is theirs
  # shellcheck source=../lib/rust_bin.sh
  . "$ROOT/lib/rust_bin.sh"
  mj_npm_modules_ensure "$ROOT" site-build
  [ -d "$ROOT/node_modules/tailwindcss" ] || { echo "site-build: node_modules absent; run: npm ci" >&2; exit 12; }
  cp "$ROOT/node_modules/alpinejs/dist/cdn.min.js" "$SITE/static/js/alpine.min.js"
  cp "$ROOT/node_modules/mermaid/dist/mermaid.min.js" "$SITE/static/js/mermaid.min.js"
  # loaded on demand by graph.js, never by the base layout: it is the largest asset on the site
  cp "$ROOT/node_modules/cytoscape/dist/cytoscape.min.js" "$SITE/static/js/cytoscape.min.js"
  # Apache ECharts, for the charts drawn from the site's own tables (site/charts.js, ADR 0152):
  # the `common` build, which holds the bar and line series the component draws and is two
  # thirds the size of the full one. Fetched by charts.js when a chart nears the viewport.
  cp "$ROOT/node_modules/echarts/dist/echarts.common.min.js" "$SITE/static/js/echarts.min.js"
fi
# the OpenAPI document the executable generated, served raw at /openapi.json: byte for byte the
# committed file, so what the site offers is what `majordomus generate --check` verified
cp "$ROOT/docs/generated/openapi.json" "$SITE/static/openapi.json"
# the build's provenance, a fact of this build and of no committed file: the commit and its
# cleanliness, the site's input hash, the registry and index fingerprints the executable
# stamped into its dataset, and the generators. Read by the templates (data/build.json) and
# served at /build.json (static/build.json) so that a deployment can be verified from outside
# against the commit that was meant to deploy. Both files are ignored, never committed.
#
# `surfaces` is every composed surface with the commit its own producer declared it was built
# from (null when it declared none), read from the surface.json beside its output. It is what
# lets scripts/site-check refuse a stale artifact, and lets a probe of the public site prove
# from outside that a composed surface is this commit's, from the one identity file it serves.
commit="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)"
# and that commit's own time, a fact of the commit and never of the clock that built it: what a
# page names when it says when its data was observed (/roadmap/). Empty when there is no commit.
commit_time="$(git -C "$ROOT" show -s --format=%cI HEAD 2>/dev/null || true)"
dirty=false; [ -z "$(git -C "$ROOT" status --porcelain --untracked-files=no 2>/dev/null)" ] || dirty=true
SURFACES="$(mktemp "${TMPDIR:-/tmp}/mj-site-surfaces.XXXXXX")"
SNAPSHOTS="$(mktemp "${TMPDIR:-/tmp}/mj-site-snapshots.XXXXXX")"
RELDIR="$(mktemp -d "${TMPDIR:-/tmp}/mj-site-release.XXXXXX")"
trap 'rm -f "$SURFACES" "$SNAPSHOTS"; rm -rf "$RELDIR"; mj_cleanup' EXIT
# `snapshots` is what the PUBLICATION holds beside this build and this build does not compose:
# a served surface read once at the published commit and placed at its mount by the deploy
# (ADR 0141), as the publication model declares it (.ai/repo/ci/pages.yaml deploy.snapshots,
# read through `scripts/pages snapshots`, its one reading). It is what lets a page link the
# published copy of a surface a process otherwise serves, without typing a mount: the
# homepage's interfaces and the bar's menu read it. A build for the running server holds none:
# there the process answers at the mount itself. A tree with no publication model has none.
if [ "$SERVE" = 0 ] && [ -x "$ROOT/scripts/pages" ] && [ -f "$ROOT/.ai/repo/ci/pages.yaml" ]; then
  snap_rows="$("$ROOT/scripts/pages" snapshots)" || { echo "site-build: the publication model's snapshots cannot be read (scripts/pages snapshots)" >&2; exit 12; }
  while IFS="$MJ_TAB" read -r sn_id sn_mount _; do
    [ -n "$sn_id" ] || continue
    jq -n --arg id "$sn_id" --arg mount "$sn_mount" '{id: $id, mount: $mount}' >> "$SNAPSHOTS"
  done <<EOF
$snap_rows
EOF
fi
release_offered "$RELDIR"
echo "== release $(jq -r 'if . == null then "none: no record and nothing published" else "v\(.version) (from the \(.source); record \(.record // "none"), published \(.published // "none")\(if .published_from then " at " + .published_from else "" end))" end' "$RELDIR/release.json")"
while IFS="$MJ_TAB" read -r c_id c_mount c_artifact c_producer; do
  [ -n "$c_id" ] || continue
  c_built=""
  [ -f "$ROOT/$c_artifact/surface.json" ] && c_built="$(jq -r '.built_from // empty' "$ROOT/$c_artifact/surface.json" 2>/dev/null || true)"
  jq -n --arg id "$c_id" --arg mount "$c_mount" --arg built "$c_built" \
    '{id: $id, mount: $mount, built_from: (if $built == "" then null else $built end)}' >> "$SURFACES"
done <<EOF
$COMPOSED
EOF
jq -n --arg commit "$commit" --arg commit_time "$commit_time" --argjson dirty "$dirty" \
  --slurpfile src "$SITE/data/generated/source.json" --slurpfile reg "$SITE/data/registry/registry.json" \
  --slurpfile surfaces "$SURFACES" --slurpfile snapshots "$SNAPSHOTS" --slurpfile release "$RELDIR/release.json" \
  '{schema: 1, commit: $commit, commit_time: (if $commit_time == "" then null else $commit_time end), dirty: $dirty,
    source_version: $src[0].source_version, source_hash: $src[0].source_hash, site_generator_version: $src[0].generator_version,
    registry_fingerprint: $reg[0].registry.fingerprint, index_fingerprint: $reg[0].index.fingerprint,
    registry_generator: ($reg[0].generator.id + " " + $reg[0].generator.version), registry_dataset: $reg[0].schema,
    surfaces: $surfaces, snapshots: $snapshots, release: $release[0]}' \
  > "$SITE/data/build.json"
cp "$SITE/data/build.json" "$SITE/static/build.json"
cp "$SITE/theme.js" "$SITE/static/js/theme.js"
cp "$SITE/diagrams.js" "$SITE/static/js/diagrams.js"
cp "$SITE/charts.js" "$SITE/static/js/charts.js"
cp "$SITE/graph.js" "$SITE/static/js/graph.js"
# a published copy of the composed product graph, fetched by graph.js where a page links to the
# list instead of carrying the graph inline (the homepage); byte for byte the committed dataset
mkdir -p "$SITE/static/graphs"
cp "$SITE/data/registry/product-graph.json" "$SITE/static/graphs/product.json"
# every capability and the surfaces it reaches — its command line, its HTTP operation, its MCP
# tool — for the homepage's picker, which fetches this on first use rather than carrying the
# registry. A slice of what the executable wrote (the exposures) joined to the site's own routes
# (executable.json): no fact is added here, and homepage-check holds it to the registry.
jq -c --slurpfile exe "$SITE/data/generated/executable.json" '
  ($exe[0].capabilities | map({key: .id, value: .}) | from_entries) as $x
  | [ .registry.builtin[] | $x[.id] as $e
      | { id, title, route: $e.route,
          cli: (if .exposure.cli then $e.cli else null end),
          http: (if .exposure.http then {method: .exposure.http.method, path: .exposure.http.path, anchor: $e.api_anchor} else null end),
          mcp: (.exposure.mcp.tool // null) } ]' \
  "$SITE/data/registry/registry.json" > "$SITE/static/graphs/surfaces.json"
cp "$SITE/api-anchors.js" "$SITE/static/js/api-anchors.js"
# the navbar's collapse and dropdowns, which Flowbite's 134 KB bundle used to do; loaded by base.html
cp "$SITE/nav.js" "$SITE/static/js/nav.js"
# the kit's behaviour (copy, tabs, the table of contents), loaded by the base layout
cp "$SITE/kit.js" "$SITE/static/js/kit.js"
# the site's one search, the navbar's dialog and the documentation hub's field, over the
# /docs/index.json this build writes last; loaded by the base layout
cp "$SITE/search.js" "$SITE/static/js/search.js"
if [ "$NOCSS" = 0 ]; then
  echo "== css"
  ( cd "$ROOT" && node_modules/.bin/tailwindcss -i "$SITE/tailwind.css" -o "$SITE/static/app.css" --minify )
  # the kit's sheet, loaded only by the pages composed of its components (partials/kit-assets.html)
  ( cd "$ROOT" && node_modules/.bin/tailwindcss -i "$SITE/kit.tailwind.css" -o "$SITE/static/kit.css" --minify )
else
  # The stylesheet is a build product and is ignored, so a clean checkout has none — and
  # base.html asks for it with cachebust=true, which makes zola read the file rather than
  # only name it. Skipping the Node step therefore did not build the site without styling;
  # it did not build the site at all, and `--no-css` could not run anywhere but on a
  # machine that had already run a full build. An empty stylesheet is what this flag
  # promises — "CSS is then absent" — written every time, so the build is the same build
  # wherever it runs.
  echo "== css (skipped: an empty stylesheet, so the pages resolve it)"
  printf '/* --no-css: no Tailwind build. This file exists because every page links it. */\n' \
    > "$SITE/static/app.css"
  # and the kit's sheet, for the same reason: every page composed of the kit links it
  printf '/* --no-css: no Tailwind build. This file exists because every kit page links it. */\n' \
    > "$SITE/static/kit.css"
fi
echo "== zola"
# an absolute output path, because zola resolves --output-dir against the site directory
PUBLIC="$SITE/public"
if [ -n "$OUT" ]; then case "$OUT" in /*) PUBLIC="$OUT" ;; *) PUBLIC="$ROOT/$OUT" ;; esac; fi
(
  cd "$SITE"
  set -- build --force
  [ -z "$BASE" ] || set -- "$@" --base-url "$BASE"
  [ "$PUBLIC" = "$SITE/public" ] || set -- "$@" --output-dir "$PUBLIC"
  zola "$@"
)
echo "== source refs"
pin_source_refs "$PUBLIC" "$SITE/data/build.json"
# The published release, when it is newer than the record, is what this build serves at
# /releases/latest.json and at its tag's own path: the pages above offer it, so the metadata
# beside them names it too (see THE RELEASE THIS SITE OFFERS at the top).
if [ -f "$RELDIR/latest.json" ]; then
  mkdir -p "$PUBLIC/releases"
  cp "$RELDIR/latest.json" "$PUBLIC/releases/latest.json"
  cp "$RELDIR/latest.json" "$PUBLIC/releases/$(jq -r .tag "$RELDIR/latest.json").json"
fi
# Zola wrote the two highlighting themes into static/ and public/; scope the dark one under .dark
# (generated CSS, not hand-written) so class-based dark mode picks the right palette.
if [ -f "$PUBLIC/giallo-dark.css" ]; then
  sed -E 's/(^|,|\})[[:space:]]*(\.[a-z])/\1 .dark \2/g; s/^\.([a-z])/.dark .\1/' "$PUBLIC/giallo-dark.css" > "$PUBLIC/giallo-dark.css.tmp" && mv "$PUBLIC/giallo-dark.css.tmp" "$PUBLIC/giallo-dark.css"
fi
echo "== a11y (palette)"
# Raise every colour of the generated highlighting palettes to the WCAG AA threshold against
# the background the same stylesheet declares. A theme is chosen for how it reads, by somebody
# who was not measuring contrast; this makes the choice safe rather than making it again. Hue
# and saturation are untouched, a palette that already passes is rewritten to itself, and a
# second pass over the result changes nothing.
for f in "$PUBLIC/giallo-light.css" "$PUBLIC/giallo-dark.css"; do
  [ -f "$f" ] || continue
  node --input-type=module -e '
import { readFileSync, writeFileSync } from "node:fs";
import { enforce, MINIMUM } from "'"$ROOT"'/scripts/lib/ui-contrast.mjs";
const path = process.argv[1];
const { css, changed, background } = enforce(readFileSync(path, "utf8"));
if (changed) writeFileSync(path, css);
console.log(`  ${path.split("/").pop()}: ${changed} colour(s) raised to ${MINIMUM}:1 against ${background}`);
' "$f"
done
# Every horizontally scrolling box of the built site is reachable from the keyboard (WCAG
# 2.1.1), and a markdown task list's checkbox carries the name of the text beside it. The
# elements this reaches are the ones a third party emits — the syntax highlighter's <pre>,
# the typography plugin's <table> — which no configuration of ours can give an attribute to;
# markup we write is held to the same invariant at its source, by `scripts/ui check`. Which
# elements scroll is read from the stylesheet the build just compiled, so a theme that stops
# making <pre> scroll stops this pass touching it. The pass refuses to write a page whose
# text it changed: it adds attributes, and nothing else.
if [ "$NOCSS" = 0 ] && [ -d "$PUBLIC" ]; then
  echo "== a11y (markup)"
  node --input-type=module -e '
import { readdirSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { normaliseRendered, scrollingTags } from "'"$ROOT"'/scripts/lib/ui-static.mjs";
const scrollingTagNames = scrollingTags(readFileSync("'"$SITE"'/static/app.css", "utf8"));
const pages = [];
(function walk(dir) {
  for (const entry of readdirSync(dir, { withFileTypes: true })) {
    const path = join(dir, entry.name);
    if (entry.isDirectory()) walk(path);
    else if (entry.name.endsWith(".html")) pages.push(path);
  }
})("'"$PUBLIC"'");
let touched = 0, elements = 0, named = 0, aligned = 0;
for (const page of pages) {
  const before = readFileSync(page, "utf8");
  let result;
  try {
    result = normaliseRendered(before, { scrollingTagNames });
  } catch (error) {
    console.error(`site-build: ${page}: ${error.message}`);
    process.exit(10);
  }
  if (!result.scrolling && !result.named && !result.aligned) continue;
  writeFileSync(page, result.text);
  touched += 1; elements += result.scrolling; named += result.named; aligned += result.aligned;
}
console.log(`  ${elements} scrolling element(s) put in the tab order (${scrollingTagNames.join(", ")}), ${named} task checkbox(es) named, ${aligned} table cell(s) aligned by class instead of inline style, over ${touched} page(s)`);
'
fi
# Every diagram of the built site is named, described and linked (ADR 0152): an id its
# address lands on, the nodes its source declares, and beside it a link for every node that is
# the identity of an object this build wrote a page for. Nothing is typed: the identities and
# routes are site/data/generated's, and a link is ordinary markup that scripts/ci/link-check
# decides with the rest. Before the composition below, because another producer's pages are
# not this site's to edit; needs no node_modules, so it runs under --no-css as well.
if [ -d "$PUBLIC" ]; then
  echo "== diagrams"
  DIAGRAM_BASE="$BASE"
  [ -n "$DIAGRAM_BASE" ] || DIAGRAM_BASE="$(sed -n 's/^base_url = "\(.*\)"/\1/p' "$SITE/config.toml")"
  node "$ROOT/scripts/lib/diagrams.mjs" "$PUBLIC" "$SITE/data/generated" "$DIAGRAM_BASE"
fi
# Every language the site declares, derived from the English pages just written (ADR 0218):
# site/i18n/languages.json names them, site/i18n/<lang>/memory holds what is translated, and
# each page is copied under /<lang>/ with every segment the memory knows replaced and its links
# pointed at that language. Before the composition below, which adds pages that are not the
# site's to translate. What the memory does not know is listed for scripts/site-translate.
if [ -d "$PUBLIC" ] && [ -f "$SITE/i18n/languages.json" ]; then
  echo "== languages"
  I18N_BASE="$BASE"
  [ -n "$I18N_BASE" ] || I18N_BASE="$(sed -n 's/^base_url = "\(.*\)"/\1/p' "$SITE/config.toml")"
  node "$ROOT/scripts/lib/site-i18n.mjs" build "$PUBLIC" "$SITE/i18n" "$I18N_BASE" \
    "$ROOT/target/site-i18n/missing.json" || exit 10
fi
# the site's own routes, counted before another surface's pages join them
routes="$(find "$PUBLIC" -name 'index.html' | wc -l | tr -d ' ')"
# The composition. After Zola, which empties its output directory on every build, and after
# the accessibility pass above, which is the site's own normalisation and has no business in
# another producer's pages. A mount the site already fills is a collision rather than a copy:
# two owners of one path, and which one a reader got would depend on the order of two lines
# here — so it is refused, not overwritten.
composed=""
while IFS="$MJ_TAB" read -r c_id c_mount c_artifact c_producer; do
  [ -n "$c_id" ] || continue
  echo "== compose $c_id at $c_mount (from $c_artifact)"
  if [ -e "$PUBLIC$c_mount" ]; then
    printf 'site-build: the site itself built %s, the mount of surface %s; one path has one owner\n' \
      "${PUBLIC#"$ROOT/"}$c_mount" "$c_id" >&2
    exit 10
  fi
  mkdir -p "$PUBLIC$c_mount"
  cp -R "$ROOT/$c_artifact/." "$PUBLIC$c_mount/"
  composed="$composed $c_id"
done <<EOF
$COMPOSED
EOF
# /docs/index.json: the machine-readable documentation index, read off the pages this build
# just wrote rather than listed anywhere, so it names exactly the routes a visitor can open.
# Written after every pass that edits a page and after the composition above, which adds
# pages, because it records what the pages say.
if [ -d "$PUBLIC" ]; then
  echo "== docs index"
  node "$ROOT/scripts/lib/docs-index.mjs" "$PUBLIC" "$SITE/data/generated/entities.json" \
    "$SITE/data/registry/registry.json"
fi
# the declaration that makes the directory a surface: written by the producer, beside its
# own output, and read back by discovery. Nothing else in the repository is told it exists.
if [ "$SERVE" = 1 ]; then
  commit="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || true)"
  jq -n --arg mount "$SERVE_MOUNT" --arg built "$commit" \
    '{schema: "web-surface/v1", id: "docs", mount: $mount,
      title: "The documentation, as this process serves it",
      index: "index.html", producer: "scripts/site-build --serve",
      availability: "served-only", category: "documentation", visibility: "public"}
     + (if $built == "" then {} else {built_from: $built} end)' > "$PUBLIC/surface.json"
fi
echo "site-build: ok — $routes routes in ${PUBLIC#"$ROOT/"}/${composed:+, composed:$composed}"
