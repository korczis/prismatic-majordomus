#!/usr/bin/env bash
# majordomus — a lightweight supervisory control layer for AI-assisted work.
# Single entry point. Subcommands live in ../lib/<name>.sh and are sourced.
set -eu

MJ_VERSION="0.5.0"
MJ_BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
MJ_LIB_DIR="$MJ_BIN_DIR/../lib"
# The path to write down. An installation puts the tool in a versioned directory and
# reaches it through a launcher whose path does not move when the version does, and the
# launcher says so; a checkout has no launcher and this file's own path is the answer.
MJ_SELF="${MAJORDOMUS_LAUNCHER:-$MJ_BIN_DIR/majordomus}"
export MJ_VERSION MJ_BIN_DIR MJ_LIB_DIR MJ_SELF

# shellcheck source=../lib/common.sh
. "$MJ_LIB_DIR/common.sh"

usage() {
  cat <<USAGE
majordomus $MJ_VERSION — a lightweight supervisory control layer for AI-assisted work

usage: majordomus <command> [options]

TASK
  start <task>         begin a scoped task under a profile
  check                is the current task consistent with policy, scope, state? (read-only)
  finish               evaluate the finish contract; refuse if unmet

CONTEXT
  session              open, inspect and close one execution episode
  context              what the next worker needs to know now, within budget    (read-only)
  checkpoint           record compact progress inside the active task
  evidence             record that one obligation the task declared has been discharged
  handover             write an append-only continuation record (body on stdin)

MEMORY
  history              read the append-only ledger back                          (read-only)
  decision             record or read durable decisions
  question             open, resolve and list questions that block acceptance
  prompt               list, show and render repository-local prompt assets      (read-only)
  skills               the repository's skills: list, show and check them        (read-only)
  capture              record the person's raw prompts from a provider hook, and prove it
  search <text>        find durable records without reading all of them          (read-only)
  knowledge            the compiled index over what this repository states       (read-only)
  adr                  the repository's architecture decisions: list, show, propose, check

RULES
  rules                the effective rule set: vendored baseline plus project rules   (read-only, except vendor update)
  usecase              the executable use cases: list, show, validate, run, coverage, impact, scaffold

PLAN
  plan                 the milestone and issue model: validate, read, and move an issue

SYSTEM
  init                 create the .ai/ layer in this repository (refuses to overwrite)
  migrate              move pre-.ai project data from .majordomus/ into .ai/ (explicit, backed up)
  recover              bring this checkout's record stores back to what the contract describes
  update               regenerate provider projections from policy
  doctor               is Majordomus itself healthy and actually wired here?      (read-only)
  doctrine             what rules are enforced, by what, and whether they are wired (read-only)
  watch                what has drifted: state, policy, projections, retention    (read-only)
  version              print the version
  bench                time every public command, cold and warm, against the baseline

global options:
  --repo <path>        repository to operate on (default: the git toplevel of the cwd)
  --json               machine-readable output (read-only commands)
  --help               this text, or <command> --help

exit codes: 0 ok · 2 usage · 10 contract unmet · 11 drift found · 12 missing artifact
            13 internal error · 15 refused
USAGE
}

# Two programs answer to the name `majordomus` here: this shell tool and the Rust executable
# under apps/majordomus-cli. The repository's own instructions name commands of both —
# `majordomus worktree`, `majordomus generate`, `majordomus mcp`, `majordomus serve` — so a
# command this tool does not know is more often the other program's than a typo, and a worker
# who followed those instructions gets "unknown command" and nowhere to go.
#
# Which commands are the other program's is read, never listed here: docs/generated/cli.yaml
# is the tracked projection of the clap declaration, and project.commands-are-projections
# forbids a surface keeping a catalogue of its own. A release package ships bin/, lib/,
# libexec/ and share/ and no docs/, so an installed tool finds no projection and says only
# that the command is unknown; a checkout — which is where those instructions are read — can
# also name the launcher that runs it. Both files are required before anything is claimed:
# advice that names a launcher which is not there is worse than none.
mj_rust_command() {
  local doc="$MJ_BIN_DIR/../docs/generated/cli.yaml"
  [ -f "$doc" ] && [ -x "$MJ_BIN_DIR/majordomus-cli" ] || return 1
  # The executable's top-level commands are the `path` of each item of the `subcommands:`
  # list directly under `cli:` — two elements, the program and the command. A nested
  # subcommand's path has three and its list is indented further, so indentation is what
  # tells `majordomus web` from `majordomus web list`.
  awk -v want="$1" '
    /^  subcommands:$/ { top = 1; next }
    top && /^    - path:$/ { n = 0; inpath = 1; next }
    inpath && /^        - / {
      n += 1
      if (n == 2) { name = $0; sub(/^ *- */, "", name); if (name == want) { found = 1; exit } }
      next
    }
    { inpath = 0 }
    END { if (found) exit 0; exit 1 }
  ' "$doc"
}

# global options may precede the command
pre=()
while [ $# -gt 0 ]; do
  case "$1" in
    --repo|--repo=*|--json) if [ "$1" = --repo ]; then pre+=("$1" "${2:-}"); shift 2; else pre+=("$1"); shift; fi ;;
    *) break ;;
  esac
done
[ $# -ge 1 ] || { usage; exit "$MJ_EX_USAGE"; }
cmd="$1"; shift
# arguments that followed the command, before the global options are merged back in
nargs=$#
set -- "${pre[@]+"${pre[@]}"}" "$@"
case "$cmd" in
  -h|--help|help) usage; exit 0 ;;
  version|--version)
    # every other command refuses an argument it does not know rather than ignoring it;
    # version is dispatched before the option parser and has to say so for itself
    [ "$nargs" -eq 0 ] || { mj_err "version: unknown option $1"; exit "$MJ_EX_USAGE"; }
    echo "majordomus $MJ_VERSION"; exit 0 ;;
  init|doctor|start|check|watch|update|handover|finish|doctrine|context|checkpoint|history|decision|question|prompt|skills|capture|search|plan|session|knowledge|migrate|recover|rules|bench|usecase|adr|evidence)
    mj_parse_global_opts "$@"
    # shellcheck disable=SC1090
    . "$MJ_LIB_DIR/$cmd.sh"
    "mj_cmd_$cmd" "${MJ_ARGS[@]+"${MJ_ARGS[@]}"}"
    ;;
  *)
    mj_err "unknown command: $cmd"
    if mj_rust_command "$cmd"; then
      # The launcher, spelled the way the caller would type it: relative when it is under the
      # directory they are standing in, which is what `bin/majordomus-cli` is from the root.
      # It builds the executable when it must, so this is one command and not a preparation.
      rust_cli="$MJ_BIN_DIR/majordomus-cli"
      mj_err "$cmd is a command of the Rust executable, not of this tool; run: ${rust_cli#"$PWD/"} $cmd"
      exit "$MJ_EX_USAGE"
    fi
    usage >&2; exit "$MJ_EX_USAGE" ;;
esac
