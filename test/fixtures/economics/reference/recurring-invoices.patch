--- /dev/null
+++ b/ledgerlite/recurring.py
@@ -0,0 +1,41 @@
+"""Recurring invoices (docs/specs/recurring-invoices.md)."""
+
+from __future__ import annotations
+
+import calendar
+import copy
+import datetime
+from dataclasses import dataclass
+
+from .invoice import Invoice
+
+_STEP = {"monthly": 1, "quarterly": 3}
+
+
+@dataclass
+class Schedule:
+    start: datetime.date
+    every: str
+    count: int
+
+    def dates(self) -> list[datetime.date]:
+        if self.every not in _STEP:
+            raise ValueError(f"every must be monthly or quarterly, got {self.every!r}")
+        if self.count < 1:
+            raise ValueError("count must be at least 1")
+        out = []
+        for i in range(self.count):
+            months = self.start.month - 1 + i * _STEP[self.every]
+            year, month = self.start.year + months // 12, months % 12 + 1
+            day = min(self.start.day, calendar.monthrange(year, month)[1])
+            out.append(datetime.date(year, month, day))
+        return out
+
+
+def generate(template: Invoice, schedule: Schedule, first_number: int) -> list[Invoice]:
+    out = []
+    for n, day in enumerate(schedule.dates(), start=first_number):
+        inv = Invoice(f"R-{n}", template.customer, template.country, day, template.currency)
+        inv.lines = copy.deepcopy(template.lines)
+        out.append(inv)
+    return out
