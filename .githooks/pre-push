#!/bin/sh
# A push that moves nothing but refs/majordomus/* carries no source: it is the continuity
# store (`majordomus-cli continuity sync`), whose records are handovers, never work. The
# finish contract asks whether the task's work may be published, which is not this
# question, and asking it would refuse a handover for exactly the task it hands over.
# Any other ref in the same push and the finish contract judges the branches pushed: each by
# the task of the checkout that has it checked out, this checkout's task only of its own
# branch (ADR 0105, amendment of 2026-10-15, I1990). The refs git gave are passed on, since
# the hook has already read them from standard input.
pushed="$(mktemp "${TMPDIR:-/tmp}/mj-pre-push.XXXXXX")" || exit 1
trap 'rm -f "$pushed"' EXIT
only_layer=1 any=0 heads=""
while read -r local_ref local_sha remote_ref remote_sha; do
  any=1
  printf '%s %s %s %s\n' "$local_ref" "$local_sha" "$remote_ref" "$remote_sha" >> "$pushed"
  case "$remote_ref" in refs/majordomus/*) ;; *) only_layer=0; heads="$heads $local_sha" ;; esac
done
[ "$any" = 1 ] && [ "$only_layer" = 1 ] && exit 0
bin/majordomus finish --check --pushed "$pushed" || exit $?
# No two cases share a number. Each branch is clean alone and the pair exists only once both
# are merged, so the trunk is where it was found (2026-10-12, two cases numbered 1096): the
# check reads file names, takes under a second, and is asked of every push.
scripts/case-numbers check >/dev/null || { scripts/case-numbers check >&2; exit 1; }
# The crate's API reference builds with warnings denied, or the push is refused. Clippy, the
# tests and the doctests all pass over a doc comment that links a private item; only rustdoc
# refuses it, and CI's rustdoc job is where the Pages deploy starts. On 2026-10-12 a head that
# had passed every one of the others landed and nothing was published until it was fixed.
# Asked only of a push that changes the crate against the trunk, where it costs about a
# minute on a warm build; a deleted ref and a push with no trunk to compare with are let by.
for head in $heads; do
  case "$head" in *[!0]*) ;; *) continue ;; esac
  base="$(git merge-base "$head" origin/master 2>/dev/null)" || continue
  git diff --quiet "$base" "$head" -- apps/majordomus-cli/src apps/majordomus-cli/Cargo.toml && continue
  scripts/rust-check --doc || { echo "pre-push: the crate's rustdoc does not build with warnings denied (scripts/rust-check --doc); a push that changes the crate is refused until it does" >&2; exit 1; }
  break
done
# what CI would find first, within a bound (project.a-push-runs-what-ci-would-find-first)
scripts/ci/run-plan --before-push || exit $?
