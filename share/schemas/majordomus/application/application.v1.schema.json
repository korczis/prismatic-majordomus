  "description": "The whole application: the front matter, then the narrative.",
  "title": "application",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "header",
    "body"
  ],
  "properties": {
    "header": {
      "$ref": "#/$defs/Header"
    },
