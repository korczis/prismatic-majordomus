#!/bin/sh
# The PreToolUse hook for the tools that write a file (Edit, Write, MultiEdit, NotebookEdit):
# it hands the payload to `majordomus-cli guard hook --provider claude-code`, which judges
# whether a claim covers the path — the active task's scope, or a live mesh claim of this
# session — in the checkout the file belongs to (I2735, session.edits_require_claim).
# For the shell tool (Bash) the same command judges the command instead: a build started
# over ssh on a declared offload host outside `majordomus offload` is refused (I3956).
#
# The executable is asked directly, never built here: a hook is not the place to start a
# compiler, and this one runs before every edit. Exactly one code is passed on — 2, the
# refusal, whose stderr the provider shows the model. Everything else the command can exit
# for, a missing executable included, lets the tool run.
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd) || exit 0
[ -x "$root/bin/majordomus-cli" ] || exit 0
MAJORDOMUS_NO_BUILD=1 "$root/bin/majordomus-cli" guard hook --provider claude-code
[ "$?" -eq 2 ] && exit 2
exit 0
