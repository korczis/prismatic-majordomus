#!/usr/bin/env bash
# land — merge the pull requests that are ready, here, because the forge cannot.
#
# This repository resolves its derived artifacts with a custom git merge driver
# (`merge=derived` in .gitattributes, scripts/merge-derived). A custom driver is an
# executable configured per clone; GitHub cannot run one. So GitHub does a plain three-way
# merge over files that every branch regenerates, finds conflicts in all of them, and marks
# every pull request CONFLICTING. The merge button is not slow here — it is structurally
# unavailable, and waiting for it is what let sixteen pull requests, fifteen of them cleanly
# mergeable, sit open at once (rule project.accumulation-is-measured).
#
# So the ground truth about "can this land" is a merge performed on a machine that has the
# driver, and this is that machine's command for it.
#
#   scripts/land                 report every open pull request and whether it merges here
#   scripts/land --run           merge the clean ones onto an integration branch and derive
#   scripts/land --exclude 216   leave a pull request alone (a peer is landing it themselves)
#   scripts/land --branch NAME   the integration branch (default int/land-<date>)
#
# --run stops before pushing, always. It prints the SHA and the command that would publish
# it: landing is reversible until then, and deploying is a decision, not a side effect.
#
# Exit: 0 clean, 10 something was left behind, 12 unusable.
set -eu
set -o pipefail
ROOT="${MJ_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
cd "$ROOT"

RUN=0
BRANCH="int/land-$(date -u +%Y%m%d)"
EXCLUDE=" "

die() { echo "land: $*" >&2; exit 12; }

while [ $# -gt 0 ]; do case "$1" in
  --run)     RUN=1; shift ;;
  --branch)  [ $# -ge 2 ] || die "--branch needs a value"; BRANCH="$2"; shift 2 ;;
  --exclude) [ $# -ge 2 ] || die "--exclude needs a pull request number"; EXCLUDE="$EXCLUDE$2 "; shift 2 ;;
  -h|--help) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) die "unknown option $1" ;;
esac; done

command -v gh >/dev/null 2>&1 || die "gh is needed to read the open pull requests"
gh auth status >/dev/null 2>&1 || die "gh has no token; run: gh auth login"
git config --get merge.derived.driver >/dev/null 2>&1 || \
  die "this clone has no 'derived' merge driver; run: just derive-merge-driver"

git fetch origin --quiet
BASE="$(git rev-parse origin/master)"
echo "land: base origin/master $(git rev-parse --short "$BASE")"
echo

clean=""; dirty=""; skipped=""
printf '%-6s %-10s %-8s %s\n' PR MERGES AHEAD BRANCH
for pr in $(gh pr list --state open --limit 100 --json number -q '.[].number' 2>/dev/null | sort -n); do
  br="$(gh pr view "$pr" --json headRefName -q .headRefName 2>/dev/null)" || continue
  git fetch origin "$br" --quiet 2>/dev/null || { printf '%-6s %-10s %-8s %s\n' "$pr" "nofetch" "-" "$br"; continue; }
  head="$(git rev-parse FETCH_HEAD)"
  ahead="$(git rev-list --count "$BASE..$head")"
  if case "$EXCLUDE" in *" $pr "*) true ;; *) false ;; esac; then
    printf '%-6s %-10s %-8s %s\n' "$pr" "excluded" "$ahead" "$br"; skipped="$skipped $pr"; continue
  fi
  # The exit code, never a grep: merge-tree's conflict wording is not a contract, and a
  # grep that misses it counts a conflicted merge as clean.
  if ! git merge-tree --write-tree "$BASE" "$head" >/dev/null 2>&1; then
    printf '%-6s %-10s %-8s %s\n' "$pr" "conflicts" "$ahead" "$br"; dirty="$dirty $pr"
  else
    printf '%-6s %-10s %-8s %s\n' "$pr" "clean" "$ahead" "$br"; clean="$clean $pr:$br"
  fi
done

n_clean="$(echo "$clean" | wc -w | tr -d ' ')"
echo
echo "land: $n_clean mergeable here, $(echo "$dirty" | wc -w | tr -d ' ') conflicting, $(echo "$skipped" | wc -w | tr -d ' ') excluded"

if [ "$RUN" -eq 0 ]; then
  [ "$n_clean" -eq 0 ] && exit 0
  echo "land: run with --run to merge them onto $BRANCH"
  exit 0
fi
[ "$n_clean" -gt 0 ] || { echo "land: nothing to do"; exit 0; }

# The merge happens in the branch's own worktree, off origin/master, never in a tree
# somebody is working in (rule project.worktree-topology).
WT="$(git rev-parse --path-format=absolute --git-common-dir)"; WT="$(dirname "$WT")-wt/$BRANCH"
if [ -d "$WT" ]; then
  echo "land: reusing $WT"
else
  git worktree add -b "$BRANCH" "$WT" origin/master >/dev/null 2>&1 || die "could not create the worktree $WT"
  echo "land: created $WT"
fi
cd "$WT"

landed=0; left=""
for spec in $clean; do
  pr="${spec%%:*}"; br="${spec#*:}"
  git fetch origin "$br" --quiet 2>/dev/null
  if git merge --no-ff --no-edit -m "Merge pull request #$pr from $br" FETCH_HEAD >/dev/null 2>&1; then
    echo "  landed  #$pr $br"
    landed=$((landed+1))
  else
    # A conflict here and not above is a real one: the earlier merges moved the base.
    echo "  left    #$pr $br (conflicts against the merges already on $BRANCH)"
    git merge --abort 2>/dev/null || true
    left="$left $pr"
  fi
done

echo
echo "land: $landed merged onto $BRANCH"

# The derived artifacts are stale on a merge result by construction: the driver resolved
# them to ours, and ours was generated from neither parent's tree. Regenerating is not
# optional — the staleness guard refuses the commit, and a push that escaped it would put
# derived data on master that describes a tree that never existed.
echo "land: regenerating the derived artifacts (the driver resolved them to ours)"
if env -u MAJORDOMUS_SHARE ./scripts/derive; then
  if [ -n "$(git status --porcelain)" ]; then
    git add -A
    git commit -q -m "chore(derive): regenerate the derived artifacts for the merge result" || true
    echo "land: derived artifacts committed"
  else
    echo "land: derived artifacts already current"
  fi
else
  echo "land: derive failed; $BRANCH is NOT ready to publish" >&2
  exit 10
fi

SHA="$(git rev-parse HEAD)"
echo
echo "land: $BRANCH is at $(git rev-parse --short "$SHA")"
echo "land: nothing has been pushed. To publish, after the gates pass:"
echo "         git -C $WT push origin $BRANCH:master"
[ -n "$left" ] && { echo "land: left behind:$left"; exit 10; }
exit 0
