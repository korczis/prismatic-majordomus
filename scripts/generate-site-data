#!/usr/bin/env bash
# generate-site-data — normalise canonical repository data into a stable site data schema.
#
#   canonical                              derived (site/data/generated/)
#   bin/majordomus (MJ_VERSION)        ->  project.json
#   share/skeleton/profiles/*.yaml     ->  profiles.json
#   share/skeleton/policy.yaml         ->  policy.json
#   docs/CLAIMS.yaml                   ->  capabilities.json
#   lib/finish.sh + share/skeleton     ->  lifecycle.json (outcome vocabulary, commands)
#   share/skeleton/providers/body.md   ->  principles (the ten rules workers actually read)
#   docs/*.md                          ->  docs index
#   git                                ->  source.json (commit, input hash, generator version)
#
# Deterministic: same inputs, byte-identical outputs (except generated_at, kept in source.json
# only). Zola templates render these files; they contain no business logic. Nothing here is a
# second copy of product truth — every value is read from the file that owns it.
#
#   scripts/generate-site-data            write site/data/generated/*.json
#   scripts/generate-site-data --check    write to a temp dir and diff against the committed files
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# Generation is transactional. Everything is written into a staging directory and only moved
# into place once every step has succeeded, so a failure half way through (a claim without its
# detail document, a renamed README heading) leaves the previous generated artifacts intact
# rather than truncated. --check never publishes; it stages and diffs.
CHECK=0; PUBLISH=1
DEST_DATA="$ROOT/site/data/generated"
[ "${1:-}" = --check ] && { CHECK=1; PUBLISH=0; }
# --out writes the data somewhere else and publishes nothing: no content pages, no
# docs/SITE_CLAIMS.md. It is how a caller gets a fresh generation without touching the tree.
[ "${1:-}" = --out ] && { DEST_DATA="$2"; PUBLISH=0; }
# The staging directory lives beside its destination so that publishing is a same-filesystem
# rename rather than a copy; the trap removes it on every exit path, including failure.
STAGE="$(mktemp -d "$ROOT/.mj-stage.XXXXXX")"
OUT="$STAGE/data"; mkdir -p "$OUT"
MJ_VERSION="site"; MJ_BIN_DIR="$ROOT/bin"; MJ_LIB_DIR="$ROOT/lib"; export MJ_VERSION MJ_BIN_DIR MJ_LIB_DIR
# shellcheck source=../lib/common.sh
. "$ROOT/lib/common.sh"
# common.sh installs its own EXIT trap, so the staging cleanup is chained after sourcing it
# rather than before, or the later trap would silently replace this one and leak the directory.
trap 'rm -rf "$STAGE"; mj_cleanup' EXIT
command -v jq >/dev/null || { echo "generate-site-data: jq is required" >&2; exit 12; }
GEN_VERSION=1

# ---------------------------------------------------------------- inputs
INPUTS="bin/majordomus
share/doctrines.yaml
share/skeleton/policy.yaml
share/skeleton/providers/body.md
docs/CLAIMS.yaml
README.md
LICENSE"
for f in "$ROOT"/share/skeleton/profiles/*.yaml "$ROOT"/docs/*.md "$ROOT"/docs/claims/*.md \
         "$ROOT"/.majordomus/project/project.yaml "$ROOT"/.majordomus/project/milestones/*.yaml \
         "$ROOT"/.majordomus/project/issues/*.yaml; do
  case "$f" in */docs/SITE_CLAIMS.md|*/docs/PLAN_STATUS.md) continue ;; esac   # written by this script; never its own input
  INPUTS="$INPUTS
${f#"$ROOT"/}"; done
for f in $INPUTS; do [ -f "$ROOT/$f" ] || { echo "generate-site-data: canonical input missing: $f" >&2; exit 12; }; done

# link rewriting for derived Markdown (repository paths -> site routes)
LINKSED='s#\](\.\./AGENTS\.md)#](@/docs/contract.md)#g; s#\](AGENTS\.md)#](@/docs/contract.md)#g; s#\](\.\./CONTRIBUTING\.md)#](https://github.com/korczis/prismatic-majordomus/blob/master/CONTRIBUTING.md)#g; s#\](\.\./SECURITY\.md)#](https://github.com/korczis/prismatic-majordomus/blob/master/SECURITY.md)#g; s#\](CLAIMS\.yaml)#](@/guarantees.md)#g; s#\](docs/CLAIMS\.yaml)#](@/guarantees.md)#g; s#\](README\.md)#](@/docs/_index.md)#g; s#\]((\.\./)?test/cases/)#](https://github.com/korczis/prismatic-majordomus/tree/master/test/cases/)#g'

flat() { local t; t="$(mktemp "${TMPDIR:-/tmp}/mj.f.XXXXXX")"; mj_yaml_flatten "$1" > "$t" || { echo "generate-site-data: $1 does not parse" >&2; exit 10; }; printf '%s' "$t"; }
yv() { mj_yget "$1" "$2"; }
jstr() { jq -Rn --arg v "$1" '$v'; }           # JSON string
jbool() { case "$1" in true) echo true ;; false) echo false ;; *) jstr "$1" ;; esac; }
jnum_or_str() { case "$1" in ''|*[!0-9]*) jstr "$1" ;; *) printf '%s' "$1" ;; esac; }
ylist_json() { mj_ylist "$1" "$2" | jq -R . | jq -sc .; }

# ---------------------------------------------------------------- project.json
VERSION="$(sed -n 's/^MJ_VERSION="\(.*\)"/\1/p' "$ROOT/bin/majordomus" | head -1)"
TAGLINE="$(grep -m1 -E '^\*\*A lightweight' "$ROOT/README.md" | sed 's/\*\*//g')"
LICENSE_NAME="$(head -1 "$ROOT/LICENSE" | sed 's/ License$//')"
COMMANDS="$(sed -n '/^usage: majordomus <command>/,/^global options:/p' "$ROOT/bin/majordomus" \
  | grep -E '^  [a-z]' | sed -E 's/^  ([a-z]+)( <[a-z]+>)? +(.*)$/\1|\3/' \
  | jq -Rn '[inputs | split("|") | {name: .[0], summary: (.[1] | gsub("\\s+\\(read-only\\)$"; "") | gsub(" +$";"")), read_only: (.[1] | test("read-only"))}]')"
EXIT_CODES="$(sed -n 's/^exit codes: //p; s/^            //p' "$ROOT/bin/majordomus" | tr '·' '\n' | sed 's/^ *//; s/ *$//' | grep -E '^[0-9]+ ' \
  | jq -Rn '[inputs | capture("^(?<code>[0-9]+) (?<meaning>.+)$") | .code |= tonumber]')"
jq -n --arg name "Prismatic Majordomus" --arg short "Majordomus" --arg version "$VERSION" --arg tagline "$TAGLINE" \
  --arg license "$LICENSE_NAME" --arg repo "https://github.com/korczis/prismatic-majordomus" \
  --argjson commands "$COMMANDS" --argjson exit_codes "$EXIT_CODES" \
  '{schema: 1, name: $name, short_name: $short, version: $version, tagline: $tagline, license: $license,
    repository_url: $repo, requirements: ["bash 3.2 or newer", "git", "sha256sum or shasum"],
    commands: $commands, exit_codes: $exit_codes}' > "$OUT/project.json"

# ---------------------------------------------------------------- profiles.json
{
  first=1; printf '{"schema":1,"profiles":['
  for pf in "$ROOT"/share/skeleton/profiles/*.yaml; do
    F="$(flat "$pf")"; slug="$(basename "$pf" .yaml)"
    [ "$first" = 1 ] || printf ','; first=0
    ctx="$(grep -E '^context\.' "$F" | sed 's/^context\.//' | jq -Rn '[inputs | split("=") | {key: .[0], value: (.[1] | if . == "true" then true elif . == "false" then false elif test("^[0-9]+$") then tonumber else . end)}] | from_entries')"
    ver="$(grep -E '^verification\.' "$F" | sed 's/^verification\.//' | jq -Rn '[inputs | split("=") | {key: .[0], value: (.[1] | if . == "true" then true elif . == "false" then false else . end)}] | from_entries')"
    esc_after="$(yv "$F" effort_escalation.after_blocked_attempts)"; esc_to="$(yv "$F" effort_escalation.to)"
    jq -cn --arg slug "$slug" --arg name "$(yv "$F" name)" --arg description "$(yv "$F" description)" \
      --arg capability "$(yv "$F" capability)" --arg effort "$(yv "$F" effort)" --arg verbosity "$(yv "$F" verbosity)" \
      --arg presentation "$(yv "$F" presentation)" --arg checkpoint "$(yv "$F" checkpoint_interval)" \
      --argjson context "$ctx" --argjson verification "$ver" --argjson contract "$(ylist_json "$F" output_contract)" \
      --arg esc_after "$esc_after" --arg esc_to "$esc_to" \
      '{slug: $slug, name: $name, description: $description, capability: $capability, effort: $effort,
        effort_escalation: (if $esc_to == "" then null else {after_blocked_attempts: ($esc_after|tonumber), to: $esc_to} end),
        verbosity: $verbosity, presentation: $presentation, checkpoint_interval: $checkpoint,
        context: $context, verification: $verification, output_contract: $contract}'
    rm -f "$F"
  done
  printf ']}'
} | jq . > "$OUT/profiles.json"

# ---------------------------------------------------------------- policy.json
P="$(flat "$ROOT/share/skeleton/policy.yaml")"
enf="$(i=0; printf '['; while [ -n "$(yv "$P" "enforcement.$i.name")" ]; do [ $i = 0 ] || printf ','; jq -cn --arg n "$(yv "$P" "enforcement.$i.name")" --arg p "$(yv "$P" "enforcement.$i.path")" --arg w "$(yv "$P" "enforcement.$i.wired_by")" --argjson a "$(ylist_json "$P" "enforcement.$i.args")" '{name:$n,path:$p,args:$a,wired_by:$w}'; i=$((i+1)); done; printf ']')"
prj="$(i=0; printf '['; while [ -n "$(yv "$P" "projections.$i.target")" ]; do [ $i = 0 ] || printf ','; jq -cn --arg p "$(yv "$P" "projections.$i.provider")" --arg t "$(yv "$P" "projections.$i.target")" --arg a "$(yv "$P" "projections.$i.always_loaded")" '{provider:$p,target:$t,always_loaded:($a=="true")}'; i=$((i+1)); done; printf ']')"
jq -n --argjson version "$(yv "$P" version)" \
  --argjson budget "$(yv "$P" context.always_loaded_budget_lines)" --arg strategy "$(yv "$P" context.strategy)" \
  --argjson transcript "$(jbool "$(yv "$P" context.transcript_is_state)")" \
  --arg default_profile "$(yv "$P" profiles.default)" --arg checkpoint "$(yv "$P" profiles.checkpoint_interval_default)" \
  --argjson req_changes "$(jbool "$(yv "$P" verification.required_for_changes)")" --argjson finish "$(ylist_json "$P" verification.finish_requires)" \
  --argjson sections "$(ylist_json "$P" handover.required_sections)" --argjson ho_cap "$(yv "$P" handover.retention_max_files)" \
  --argjson ledger_cap "$(yv "$P" ledger.retention_max_lines)" --argjson enforcement "$enf" --argjson projections "$prj" \
  --rawfile raw "$ROOT/share/skeleton/policy.yaml" \
  '{schema: 1, version: $version,
    context: {always_loaded_budget_lines: $budget, strategy: $strategy, transcript_is_state: $transcript},
    profiles: {default: $default_profile, checkpoint_interval_default: $checkpoint},
    verification: {required_for_changes: $req_changes, finish_requires: $finish},
    handover: {required_sections: $sections, retention_max_files: $ho_cap},
    ledger: {retention_max_lines: $ledger_cap}, enforcement: $enforcement, projections: $projections,
    raw: $raw}' > "$OUT/policy.json"
rm -f "$P"

# ---------------------------------------------------------------- capabilities.json (from docs/CLAIMS.yaml)
Cf="$(flat "$ROOT/docs/CLAIMS.yaml")"
{
  i=0; first=1; printf '{"schema":1,"statuses":{"guaranteed":"Deterministic and blocking. Implemented, and a behavioural test proves it.","advisory":"Projected into the worker'"'"'s instructions. Whether a worker honours it is not observable from outside. Documentation, not enforcement.","planned":"Specified and not implemented. Named so the omission is visible.","rejected":"Considered and deliberately refused, with the reason recorded."},"claims":['
  while [ -n "$(yv "$Cf" "claims.$i.id")" ]; do
    [ "$first" = 1 ] || printf ','; first=0
    jq -cn --arg id "$(yv "$Cf" "claims.$i.id")" --arg claim "$(yv "$Cf" "claims.$i.claim")" --arg source "$(yv "$Cf" "claims.$i.source")" \
      --arg impl "$(yv "$Cf" "claims.$i.implementation")" --arg test "$(yv "$Cf" "claims.$i.test")" --arg status "$(yv "$Cf" "claims.$i.status")" \
      --arg note "$(yv "$Cf" "claims.$i.note")" \
      '{id:$id, claim:$claim, source:$source, implementation:(if $impl=="-" then null else $impl end), test:(if $test=="-" then null else $test end), status:$status, note:(if $note=="" then null else $note end),
        source_route: ($source | if test("^docs/[A-Z_]+\\.md$") then "/docs/" + (ltrimstr("docs/") | rtrimstr(".md") | ascii_downcase | gsub("_";"-")) + "/"
                                elif . == "AGENTS.md" then "/docs/contract/"
                                elif startswith("share/skeleton/profiles/") then "/profiles/" + (ltrimstr("share/skeleton/profiles/") | rtrimstr(".yaml")) + "/"
                                elif startswith("share/skeleton/policy") then "/policy/" else null end),
        command: (if $impl | test("^lib/(init|doctor|start|check|watch|update|handover|finish)\\.sh$") then ($impl | ltrimstr("lib/") | rtrimstr(".sh")) else null end),
        test_case: (if $test == "-" then null else ($test | ltrimstr("test/cases/") | rtrimstr(".sh")) end)}'
    i=$((i+1))
  done; printf ']}'
} | jq . > "$OUT/capabilities.json"
rm -f "$Cf"
# every referenced path must exist; a guaranteed claim must name a test
jq -r '.claims[] | [.id, .status, .source, (.implementation // "-"), (.test // "-")] | @tsv' "$OUT/capabilities.json" | while IFS="$(printf '\t')" read -r id status src impl test; do
  for p in "$src" "$impl" "$test"; do
    if [ "$p" != "-" ] && [ ! -e "$ROOT/$p" ]; then echo "generate-site-data: claim $id names missing path $p" >&2; exit 10; fi
  done
  if [ "$status" = guaranteed ] && [ "$test" = "-" ]; then echo "generate-site-data: guaranteed claim $id has no test" >&2; exit 10; fi
done

# ---------------------------------------------------------------- lifecycle.json
OUTCOMES="$(grep -oE 'completed\|partial\|blocked\|no_match\|failed' "$ROOT/lib/finish.sh" | head -1 | tr '|' '\n' | jq -R . | jq -sc .)"
LABELS='["exact","advanced","diverged","different_context"]'
STEPS='[{"command":"start","what":"declare scope and profile; identity computed from git"},{"command":"check","what":"state, scope, checkpoint age, blockers"},{"command":"handover","what":"append-only continuation record, never staged"},{"command":"finish","what":"the contract, line by line; refused if any line fails"}]'
PRINCIPLES="$(awk '/^### Ten rules/{f=1;next} /^### /{if(f)exit} f && /^[0-9]+\. \*\*/{sub(/^[0-9]+\. \*\*/,""); sub(/\*\*.*$/,""); print}' "$ROOT/share/skeleton/providers/body.md" | jq -R . | jq -sc .)"
[ "$(printf '%s' "$PRINCIPLES" | jq length)" -ge 8 ] || { echo "generate-site-data: expected the ten rules in providers/body.md" >&2; exit 10; }
jq -n --argjson outcomes "$OUTCOMES" --argjson labels "$LABELS" --argjson steps "$STEPS" --argjson principles "$PRINCIPLES" \
  '{schema:1, outcomes:$outcomes, divergence_labels:$labels, steps:$steps, principles:$principles}' > "$OUT/lifecycle.json"

# hand-written site pages (no product claims) get the same projection; the source is site/content-src/
for srcp in $(cd "$ROOT/site/content-src" && find . -name '*.md' | sed 's#^\./##' | sort); do
  srcp="$ROOT/site/content-src/$srcp"; rel="${srcp#"$ROOT"/site/content-src/}"
  dst="$STAGE/content/$rel"
  mkdir -p "$(dirname "$dst")"
  awk 'BEGIN{n=0} /^\+\+\+/{n++; print; next} n<2{print; next} n==2 && !b{print "{% raw %}"; b=1} {print}' "$srcp" \
    | awk -v lib="$ROOT/scripts/lib/project-markdown.awk" 'BEGIN{n=0} /^\+\+\+/{n++; print; next} n<2{print; next} {print | ("awk -f " lib)}' > "$dst"
  printf '{%% endraw %%}\n' >> "$dst"
done

# ---------------------------------------------------------------- readme.json (fragments the homepage renders)
section_of() { # file, heading, next-heading -> body between them; fails if the heading is missing
  grep -qx "## $2" "$1" || { echo "generate-site-data: README.md has no heading '## $2' (the site renders it)" >&2; exit 10; }
  awk -v h="## $2" -v n="## $3" '$0==h{f=1;next} f&&$0==n{exit} f' "$1"
}
FINISH_BLOCK="$(awk '/^```/{c++; if(c==1){f=1;next} if(c==2){exit}} f' "$ROOT/README.md")"
[ -n "$FINISH_BLOCK" ] || { echo "generate-site-data: README.md has no first fenced block (the hero renders it)" >&2; exit 10; }
# the five lines of the finish contract, read out of the transcript itself rather than listed
# again here: the hero animation and the transcript below it are then the same five checks
FINISH_CHECKS="$(printf '%s\n' "$FINISH_BLOCK" | awk '/^(OK|FAIL)[[:space:]]/{print $2}' | awk '!seen[$0]++' | jq -R . | jq -sc .)"
[ "$(printf '%s' "$FINISH_CHECKS" | jq length)" -ge 4 ] || { echo "generate-site-data: the README finish transcript no longer lists its checks" >&2; exit 10; }
DOES_ROWS="$(section_of "$ROOT/README.md" "What it does" "Quick start" | grep -E '^\| \*\*' | sed -E 's/^\| \*\*([^*]+)\*\* \| (.*) \|$/\1|\2/' | jq -Rn '[inputs | split("|") | {title: .[0], text: .[1]}]')"
PROBLEM_MD="$(section_of "$ROOT/README.md" "The problem" "What it does")"
jq -n --arg finish "$FINISH_BLOCK" --arg problem "$PROBLEM_MD" --argjson checks "$FINISH_CHECKS" \
  --arg problem_bullets "$(printf '%s' "$PROBLEM_MD" | awk '/^- /{f=1} f&&/^$/{exit} f')" \
  --arg notwhat "$(section_of "$ROOT/README.md" "What this is not" "Limitations")" --argjson does "$DOES_ROWS" \
  --arg limits "$(section_of "$ROOT/README.md" "Limitations" "Roadmap")" \
  '{schema:1, finish_transcript:$finish, finish_checks:$checks, problem_md:$problem, problem_bullets_md:$problem_bullets, not_md:$notwhat, limitations_md:$limits, does:$does}' > "$OUT/readme.json"

# ---------------------------------------------------------------- commands.json (CLI reference sections per command)
# docs/CLI.md has one `## `majordomus <name>`` section per command; each becomes a page.
{
  printf '{"schema":1,"commands":['
  first=1
  for name in $(jq -r '.commands[].name' "$OUT/project.json"); do
    [ "$name" = version ] && continue
    body="$(awk -v h="## \`majordomus $name" 'index($0,h)==1{f=1;next} f&&/^## /{exit} f' "$ROOT/docs/CLI.md" | sed -E "$LINKSED")"
    [ -n "$body" ] || { echo "generate-site-data: docs/CLI.md has no section for command '$name'" >&2; exit 10; }
    [ "$first" = 1 ] || printf ','; first=0
    jq -cn --arg n "$name" --arg s "$(jq -r --arg n "$name" '.commands[] | select(.name==$n) | .summary' "$OUT/project.json")" \
      --argjson ro "$(jq -r --arg n "$name" '.commands[] | select(.name==$n) | .read_only' "$OUT/project.json")" --arg body "$body" \
      '{name:$n, summary:$s, read_only:$ro, doc_md:$body}'
  done
  printf ']}'
} | jq . > "$OUT/commands.json"

# ---------------------------------------------------------------- responsibilities (README "What it does" rows, cross-linked)
# The cross-links are data: which command owns a responsibility and which claims mention it, by
# a keyword per row. Kept here, not in templates, so the templates only render.
RESP_KEYS='{"Policy":[null,"policy|unknown key"],"Projection":["update","projection|instruction file|hand-edited"],"State":["start","identity|state|divergence"],"Scope":["check","scope|overlap"],"Profiles":["start","profile|capability class|axes|checkpoint|escalat"],"Handover":["handover","handover|transcript"],"Finish":["finish","finish|outcome"],"Doctor":["doctor","wiring|reconciled|enforcement|exit code|budget|resolve|count|retention|refused|reproduce|network|unknown key"],"Watch":["watch","drift"]}'
jq --argjson keys "$RESP_KEYS" --slurpfile caps "$OUT/capabilities.json" '
  .does |= map(. as $row
    | ($keys[$row.title] // [null, "(?!)"]) as $k
    | . + {slug: ($row.title | ascii_downcase),
           command: $k[0],
           claim_ids: [ $caps[0].claims[] | select(.claim | test($k[1]; "i")) | .id ]})' "$OUT/readme.json" > "$OUT/readme.json.tmp" && mv "$OUT/readme.json.tmp" "$OUT/readme.json"

# ---------------------------------------------------------------- doctrines.json
# Every field the site shows about a doctrine is either in the registry or resolved from
# the source here — which file defines the validator, which commands dispatch it, which
# claims it backs. The site never states that something is enforced; it shows the chain.
Df="$(flat "$ROOT/share/doctrines.yaml")"
[ "$(yv "$Df" version)" = 1 ] || { echo "generate-site-data: share/doctrines.yaml must be version 1" >&2; exit 10; }
# Validate the whole registry before emitting anything. A check inside the emitting
# pipeline runs in a subshell and would leave a half-written file behind.
# The three facts every doctrine is checked against are properties of the tree, not of the
# doctrine, so they are read once here rather than re-scanned per doctrine. Scanning lib/ and
# CLAIMS.yaml inside the loop cost more than the rest of the generator put together.
VALIDATOR_FILES="$(grep -rnoE '^mj_validate_[a-z_]+\(\)' "$ROOT/lib" 2>/dev/null | sed "s#^$ROOT/##" | awk -F: '{n=$3; sub(/^mj_validate_/,"",n); sub(/\(\)$/,"",n); if (!(n in seen)) { seen[n]=1; print n "\t" $1 }}')"
DEFINED_VALIDATORS=" $(printf '%s\n' "$VALIDATOR_FILES" | cut -f1 | tr '\n' ' ')"
DISPATCHING=" $(grep -lF 'mj_doctrine_dispatch' "$ROOT"/lib/*.sh 2>/dev/null | sed 's#.*/##; s#\.sh$##' | tr '\n' ' ')"
KNOWN_CLAIM_IDS=" $(sed -n 's/^  - id: //p' "$ROOT/docs/CLAIMS.yaml" | tr '\n' ' ')"
has() { case "$2" in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
i=0
while [ -n "$(yv "$Df" "doctrines.$i.id")" ]; do
  id="$(yv "$Df" "doctrines.$i.id")"; val="$(yv "$Df" "doctrines.$i.validator")"
  cls="$(yv "$Df" "doctrines.$i.class")"; tst="$(yv "$Df" "doctrines.$i.test")"
  has "$val" "$DEFINED_VALIDATORS" \
    || { echo "generate-site-data: doctrine $id names validator '$val' but no lib/ file defines mj_validate_$val" >&2; exit 10; }
  [ -f "$ROOT/$tst" ] || { echo "generate-site-data: doctrine $id names test $tst, which does not exist" >&2; exit 10; }
  case "$cls" in blocking|advisory) ;; *) echo "generate-site-data: doctrine $id has class '$cls' (blocking | advisory)" >&2; exit 10 ;; esac
  j=0; while c="$(yv "$Df" "doctrines.$i.enforced_by.$j")"; [ -n "$c" ]; do
    has "$c" "$DISPATCHING" \
      || { echo "generate-site-data: doctrine $id is declared for '$c', which does not dispatch" >&2; exit 10; }
    j=$((j+1)); done
  j=0; while cid="$(yv "$Df" "doctrines.$i.claims.$j")"; [ -n "$cid" ]; do
    has "$cid" "$KNOWN_CLAIM_IDS" \
      || { echo "generate-site-data: doctrine $id names claim '$cid', which is not in docs/CLAIMS.yaml" >&2; exit 10; }
    j=$((j+1)); done
  i=$((i+1))
done
# Nothing in lib/ may validate outside a declared doctrine — the orphan check doctor runs,
# repeated here so a broken chain cannot reach the published site at all.
DECLARED=" $(i=0; while [ -n "$(yv "$Df" "doctrines.$i.validator")" ]; do printf '%s ' "$(yv "$Df" "doctrines.$i.validator")"; i=$((i+1)); done)"
for fn in $(printf '%s\n' "$VALIDATOR_FILES" | cut -f1); do
  case "$DECLARED" in *" $fn "*) ;; *) echo "generate-site-data: lib/ defines mj_validate_$fn, which no doctrine declares" >&2; exit 10 ;; esac
done
{
  printf '{"schema":1,"doctrines":['
  i=0; first=1
  while [ -n "$(yv "$Df" "doctrines.$i.id")" ]; do
    id="$(yv "$Df" "doctrines.$i.id")"; val="$(yv "$Df" "doctrines.$i.validator")"
    defined_in="$(printf '%s\n' "$VALIDATOR_FILES" | awk -F'\t' -v v="$val" '$1==v {print $2; exit}')"
    cmds=""; j=0
    while [ -n "$(yv "$Df" "doctrines.$i.enforced_by.$j")" ]; do cmds="$cmds$(jstr "$(yv "$Df" "doctrines.$i.enforced_by.$j")")," ; j=$((j+1)); done
    cl=""; j=0
    while [ -n "$(yv "$Df" "doctrines.$i.claims.$j")" ]; do cl="$cl$(jstr "$(yv "$Df" "doctrines.$i.claims.$j")")," ; j=$((j+1)); done
    [ "$first" = 1 ] || printf ','; first=0
    printf '{"id":%s,"slug":%s,"title":%s,"class":%s,"principle":%s,"summary":%s,"validator":%s,"validator_function":%s,"defined_in":%s,"category":%s,"enforced_by":[%s],"exit_code":%s,"policy_key":%s,"claims":[%s],"test":%s}' \
      "$(jstr "$id")" "$(jstr "$(printf '%s' "$id" | tr '_' '-')")" "$(jstr "$(yv "$Df" "doctrines.$i.title")")" \
      "$(jstr "$(yv "$Df" "doctrines.$i.class")")" "$(jnum_or_str "$(yv "$Df" "doctrines.$i.principle")")" \
      "$(jstr "$(yv "$Df" "doctrines.$i.summary")")" "$(jstr "$val")" "$(jstr "mj_validate_$val")" "$(jstr "$defined_in")" \
      "$(jstr "$(yv "$Df" "doctrines.$i.category")")" "${cmds%,}" \
      "$(jnum_or_str "$(yv "$Df" "doctrines.$i.exit_code")")" "$(jstr "$(yv "$Df" "doctrines.$i.policy_key")")" \
      "${cl%,}" "$(jstr "$(yv "$Df" "doctrines.$i.test")")"
    i=$((i+1))
  done
  printf ']}'
} | jq . > "$OUT/doctrines.json"
# The counts the site prints come from the data, so a doctrine cannot be added without them moving.
jq '. + {counts: {declared: (.doctrines|length),
                  blocking: ([.doctrines[]|select(.class=="blocking")]|length),
                  advisory: ([.doctrines[]|select(.class=="advisory")]|length)},
         index: (reduce (.doctrines|to_entries[]) as $e ({}; . + {($e.value.id): $e.key}))}' \
  "$OUT/doctrines.json" > "$OUT/doctrines.json.tmp" && mv "$OUT/doctrines.json.tmp" "$OUT/doctrines.json"

# ---------------------------------------------------------------- why.json (the five moments, as data)
# The moments are hand-written prose in site/content-src/why/, but the links out of them are
# not prose: each page names the commands, responsibilities and claims it rests on. Those are
# read here, checked against the things they name, and published as data so the index, the
# graph and the backlinks on claim and responsibility pages are all the same list. A moment
# that names a claim, command or responsibility that does not exist fails the build; before
# this, a typo produced a 404 nobody would notice.
WHY_JSON="$(
  printf '['
  first=1
  for f in $(cd "$ROOT/site/content-src/why" && ls ./*.md | sed 's#^\./##' | grep -v '^_index\.md$' | sort); do
    p="$ROOT/site/content-src/why/$f"; slug="${f%.md}"
    [ "$first" = 1 ] || printf ','; first=0
    fm="$(awk 'BEGIN{n=0} /^\+\+\+$/{n++; next} n==1' "$p")"
    tget() { printf '%s' "$fm" | sed -n "s/^$1 = \"\(.*\)\"$/\1/p" | head -1; }
    tnum() { printf '%s' "$fm" | sed -n "s/^$1 = \([0-9]*\)$/\1/p" | head -1; }
    tarr() { printf '%s' "$fm" | sed -n "s/^$1 = \[\(.*\)\]$/\1/p" | head -1 \
             | tr ',' '\n' | sed 's/^ *"//; s/" *$//; s/^ *//; s/ *$//' | grep -v '^$' | jq -R . | jq -sc .; }
    jq -cn --arg slug "$slug" --arg title "$(tget title | sed 's/\\"/"/g')" \
      --arg desc "$(tget description | sed 's/\\"/"/g')" --arg hook "$(tget hook | sed 's/\\"/"/g')" \
      --argjson weight "$(tnum weight)" --argjson cmds "$(tarr commands)" \
      --argjson resp "$(tarr responsibilities)" --argjson claims "$(tarr claims)" \
      '{slug:$slug, title:$title, description:$desc, hook:$hook, weight:$weight,
        route:("/why/" + $slug + "/"), commands:$cmds, responsibilities:$resp, claims:$claims}'
  done
  printf ']'
)"
printf '%s' "$WHY_JSON" | jq --slurpfile caps "$OUT/capabilities.json" --slurpfile rd "$OUT/readme.json" \
  --slurpfile pr "$OUT/project.json" '
  ($caps[0].claims | map(.id)) as $claim_ids
  | ($rd[0].does | map(.slug)) as $resp_slugs
  | ($pr[0].commands | map(.name)) as $cmd_names
  | {schema: 1,
     source: "site/content-src/why/",
     moments: [ sort_by(.weight)[] | . + {
       claim_detail: [ .claims[] as $c | $caps[0].claims[] | select(.id == $c) | {id, claim, status} ],
       command_detail: [ .commands[] as $n | $pr[0].commands[] | select(.name == $n) | {name, summary, read_only} ],
       responsibility_detail: [ .responsibilities[] as $s | $rd[0].does[] | select(.slug == $s) | {slug, title} ] } ],
     unknown: { claims: [ .[].claims[] | select(IN($claim_ids[]) | not) ] | unique,
                responsibilities: [ .[].responsibilities[] | select(IN($resp_slugs[]) | not) ] | unique,
                commands: [ .[].commands[] | select(IN($cmd_names[]) | not) ] | unique }}' > "$OUT/why.json"
for k in claims responsibilities commands; do
  bad="$(jq -r --arg k "$k" '.unknown[$k] | join(", ")' "$OUT/why.json")"
  [ -z "$bad" ] || { echo "generate-site-data: a why page names $k that do not exist: $bad" >&2; exit 10; }
done
jq 'del(.unknown)' "$OUT/why.json" > "$OUT/why.json.tmp" && mv "$OUT/why.json.tmp" "$OUT/why.json"
[ "$(jq '.moments | length' "$OUT/why.json")" -ge 3 ] || { echo "generate-site-data: site/content-src/why/ produced almost no moments" >&2; exit 10; }
# the reverse index the claim and responsibility pages need: which moments name this thing
jq '{schema: .schema, source: .source, moments: .moments,
     by_claim: (reduce (.moments[] | . as $m | $m.claims[] | {k:., v:$m.slug}) as $e ({}; .[$e.k] += [$e.v])),
     by_responsibility: (reduce (.moments[] | . as $m | $m.responsibilities[] | {k:., v:$m.slug}) as $e ({}; .[$e.k] += [$e.v])),
     by_command: (reduce (.moments[] | . as $m | $m.commands[] | {k:., v:$m.slug}) as $e ({}; .[$e.k] += [$e.v]))}' \
  "$OUT/why.json" > "$OUT/why.json.tmp" && mv "$OUT/why.json.tmp" "$OUT/why.json"

# the moments and the tool, as a graph: moment -> command -> claim, drawn by the same runtime
# as /map/ and /evidence/ rather than a third picture of the same relationships
jq '{schema: 1,
     source: "site/content-src/why/ front matter",
     edge_kinds: {addressed_by: "the command this moment is answered by",
                  backed_by: "the claim that says what the tool guarantees here",
                  supervises: "the responsibility this moment falls under"},
     nodes: ([.moments[] | {id: ("moment:" + .slug), kind: "moment", label: .hook, route: .route, external: false, summary: .description}]
             + ([.moments[] | .command_detail[] | {id: ("command:" + .name), kind: "command", label: ("majordomus " + .name), route: ("/commands/" + .name + "/"), external: false, summary: .summary}]
                + [.moments[] | .claim_detail[] | {id: ("claim:" + .id), kind: "claim", label: .id, status: .status, route: ("/guarantees/" + .id + "/"), external: false, summary: .claim}]
                + [.moments[] | .responsibility_detail[] | {id: ("responsibility:" + .slug), kind: "responsibility", label: .title, route: ("/supervises/" + .slug + "/"), external: false}]
                | unique_by(.id))),
     edges: ([.moments[] | . as $m | $m.commands[] | {source: ("moment:" + $m.slug), target: ("command:" + .), kind: "addressed_by"}]
             + [.moments[] | . as $m | $m.claims[] | {source: ("moment:" + $m.slug), target: ("claim:" + .), kind: "backed_by"}]
             + [.moments[] | . as $m | $m.responsibilities[] | {source: ("moment:" + $m.slug), target: ("responsibility:" + .), kind: "supervises"}]
             | unique)}' "$OUT/why.json" > "$OUT/why-graph.json"

# ---------------------------------------------------------------- diagrams.json (Mermaid source from data, never hand-drawn)
LIFECYCLE_MMD="$(printf 'stateDiagram-v2\n    [*] --> active: start\n    active --> active: check --checkpoint\n    active --> handed_over: handover --close\n    handed_over --> [*]: next start archives the record\n'; for o in $(printf '%s' "$OUTCOMES" | jq -r '.[]'); do printf '    active --> %s: finish --outcome %s\n    %s --> [*]\n' "$o" "$o" "$o"; done)"
PIPELINE_MMD="$(printf 'flowchart LR\n    subgraph canonical\n        A[share/skeleton]\n        B[docs + README]\n        C[docs/CLAIMS.yaml]\n    end\n    G[scripts/generate-site-data]\n    D[(site/data/generated)]\n    Z[Zola]\n    F[Tailwind + Flowbite + Alpine]\n    P[GitHub Pages]\n    A --> G\n    B --> G\n    C --> G\n    G --> D --> Z --> F --> P\n')"
PROJECTION_MMD="$(printf 'flowchart TD\n    P[.majordomus/policy.yaml]\n    U[majordomus update]\n    P --> U\n'; i=0; while :; do t="$(jq -r ".projections[$i].target // empty" "$OUT/policy.json")"; [ -n "$t" ] || break; pr="$(jq -r ".projections[$i].provider" "$OUT/policy.json")"; printf '    U --> T%s["%s<br/><small>%s</small>"]\n' "$i" "$t" "$pr"; i=$((i+1)); done; printf '    U --> FP[(generated/fingerprints.yaml)]\n    FP -.-> D[majordomus doctor]\n')"
SUPERVISION_MMD="$(printf 'flowchart TD\n    H[Human / Organisation]\n    M[Majordomus<br/><small>policy · state · verification</small>]\n    W1[Claude Code]\n    W2[Codex]\n    W3[Gemini · Cursor · local]\n    V[Verified, accepted outcomes]\n    H --> M\n    M --> W1\n    M --> W2\n    M --> W3\n    W1 --> V\n    W2 --> V\n    W3 --> V\n')"
jq -n --arg l "$LIFECYCLE_MMD" --arg p "$PIPELINE_MMD" --arg j "$PROJECTION_MMD" --arg s "$SUPERVISION_MMD" \
  '{schema:1, diagrams: {lifecycle: {title: "Task lifecycle", source: "lib/finish.sh outcome vocabulary", mermaid: $l},
                          pipeline: {title: "How this site is derived", source: "generate-site-data inputs", mermaid: $p},
                          projection: {title: "Policy to instruction files", source: "share/skeleton/policy.yaml projections", mermaid: $j},
                          supervision: {title: "The core model", source: "README.md mental model", mermaid: $s}}}' > "$OUT/diagrams.json"

# ---------------------------------------------------------------- architecture.json (static scan, never hand-drawn)
# The interactive architecture graph is what scripts/lib/architecture-scan.awk can prove by
# reading the shell sources: module A sources module B, module A names artifact C. Nothing is
# asserted here that the scanner did not find, and a module that stops touching a file loses
# its edge on the next run. Command labels, summaries and routes come from project.json, so
# the graph and the command pages cannot disagree.
SCAN="$ROOT/scripts/lib/architecture-scan.awk"
[ -f "$SCAN" ] || { echo "generate-site-data: missing $SCAN" >&2; exit 12; }
# two collecting passes, so a path accessor defined in a later file still resolves
ARCH_TSV="$(cd "$ROOT" && awk -f "$SCAN" vars=1 bin/majordomus lib/*.sh vars=1 bin/majordomus lib/*.sh vars=0 bin/majordomus lib/*.sh)"
printf '%s\n' "$ARCH_TSV" | jq -Rn --slurpfile proj "$OUT/project.json" '
  [inputs | split("\t")] as $rows
  | ($proj[0].commands | map({key: .name, value: .})) as $cmds
  | ($rows | map(select(.[0]=="node") | {id: .[1], kind: .[2]})) as $raw_nodes
  | ($raw_nodes | map(select(.kind=="artifact") | .id)) as $arts
  # a bare directory whose children are also referenced adds nothing but a hub
  | ($arts | map(select(. as $a | ($arts | any(startswith($a + "/")))))) as $drop
  | ($raw_nodes | map(select((.kind != "artifact") or ((.id | IN($drop[])) | not)))) as $nodes
  | ($nodes | map(.id)) as $keep
  | {schema: 1,
     source: "static reference scan of bin/majordomus and lib/*.sh",
     generator: "scripts/lib/architecture-scan.awk",
     edge_kinds: {sources: "the first module sources the second",
                  reads: "named behind a reading command or a redirection from the file",
                  writes: "named behind a redirection into the file, or a command that creates or replaces it",
                  uses: "named, but handed to a helper — the scan does not claim a direction"},
     nodes: [$nodes[]
       | .id as $id
       | ($id | ltrimstr("lib/") | rtrimstr(".sh")) as $cmd
       | ($cmds | map(select(.key == $cmd)) | first | .value) as $c
       | {id: $id, kind: .kind,
          label: (if .kind == "entry" then "majordomus"
                  elif .kind == "module" then $cmd
                  else ($id | ltrimstr(".majordomus/")) end),
          command: (if .kind == "module" and $c then $cmd else null end),
          summary: ($c.summary // null),
          read_only: ($c.read_only // null),
          route: (if .kind == "module" and $c then "/commands/" + $cmd + "/" else null end),
          external: false}],
     # Parenthesised: a pipe in an object value is a syntax error in jq 1.7, which is what
     # the CI image ships. jq 1.8 accepts it, so this only ever failed away from a laptop.
     edges: ([$rows[] | select(.[0]=="edge") | {source: .[1], target: .[2], kind: .[3]}
       | select((.source | IN($keep[])) and (.target | IN($keep[])))]
     # the dispatcher sources lib/<command>.sh by name; that edge is dynamic in the shell
     | . + [$cmds[] | select(("lib/" + .key) as $m | ($keep | any(. == $m + ".sh")))
            | {source: "bin/majordomus", target: ("lib/" + .key + ".sh"), kind: "sources"}])
     | unique}' > "$OUT/architecture.json"
[ "$(jq '.nodes | length' "$OUT/architecture.json")" -ge 20 ] || { echo "generate-site-data: architecture scan found almost nothing; the scanner or the sources moved" >&2; exit 10; }
# every command that has a module on disk must appear as one in the scan; a command the
# dispatcher answers itself (version) has no module and is not expected to have a node
MODULE_CMDS="$(for f in "$ROOT"/lib/*.sh; do b="$(basename "$f" .sh)"; [ "$b" = common ] || printf '%s\n' "$b"; done | jq -R . | jq -sc .)"
jq -e --argjson mods "$MODULE_CMDS" --slurpfile proj "$OUT/project.json" '
  (($proj[0].commands | map(.name)) - ($proj[0].commands | map(.name) - $mods))
  - ([.nodes[] | select(.kind=="module") | .command] | map(select(. != null))) | length == 0' \
  "$OUT/architecture.json" >/dev/null || { echo "generate-site-data: a command with a lib/ module is missing from the architecture scan" >&2; exit 10; }

# ---------------------------------------------------------------- claims-graph.json (evidence, as a graph)
# The same claims as capabilities.json, projected into the bipartite shape the evidence graph
# draws: a claim on one side, the documents, implementations and tests that back it on the
# other. A claim with no evidence node is visible as an isolated dot, which is the point.
jq '{schema: 1,
     source: "docs/CLAIMS.yaml",
     generator: "scripts/generate-site-data",
     statuses: .statuses,
     edge_kinds: {specified_by: "the document that defines the claim",
                  implemented_by: "the file that implements it",
                  proved_by: "the behavioural test that proves it"},
     nodes: ([.claims[] | {id: ("claim:" + .id), kind: "claim", label: .claim, status: .status,
                           route: ("/guarantees/" + .id + "/"), external: false, note: .note}]
             + ([.claims[] | {id: ("source:" + .source), kind: "source", label: .source, route: .source_route, external: false}]
                + [.claims[] | select(.implementation) | {id: ("impl:" + .implementation), kind: "implementation", label: .implementation, route: null, external: false}]
                + [.claims[] | select(.test) | {id: ("test:" + .test), kind: "test", label: .test, external: true,
                                                route: ("https://github.com/korczis/prismatic-majordomus/blob/master/" + .test)}]
                | unique_by(.id))),
     edges: ([.claims[] | {source: ("claim:" + .id), target: ("source:" + .source), kind: "specified_by"}]
             + [.claims[] | select(.implementation) | {source: ("claim:" + .id), target: ("impl:" + .implementation), kind: "implemented_by"}]
             + [.claims[] | select(.test) | {source: ("claim:" + .id), target: ("test:" + .test), kind: "proved_by"}])}' \
  "$OUT/capabilities.json" > "$OUT/claims-graph.json"
# a guaranteed claim reaches a test; the generator already refuses one that does not, and this
# asserts the projection did not lose the edge on the way into the graph
jq -e '[.nodes[] | select(.kind=="claim" and .status=="guaranteed") | .id] as $g
       | ([.edges[] | select(.kind=="proved_by") | .source] | unique) as $p
       | ($g - $p) | length == 0' "$OUT/claims-graph.json" >/dev/null \
  || { echo "generate-site-data: a guaranteed claim lost its test edge in claims-graph.json" >&2; exit 10; }

# ---------------------------------------------------------------- docs index (from docs/README.md table)
# Only the first table becomes site routes. The "## Reference files" table below it lists
# repository-only files whose content the site presents through other routes, so it is cut
# here; site-check requires a route for every entry in docs.json.
DOCS="$(awk '/^## Reference files/{exit} /^\| \[`/{print}' "$ROOT/docs/README.md" | sed -E 's/^\| \[`([^`]+)`\]\(([^)]+)\) \| ([^|]+) \| ([^|]+) \|$/\2|\3|\4/' | grep -vE '^\|' \
  | jq -Rn '[inputs | split("|") | {path: (.[0] | ltrimstr("../")), audience: (.[1]|gsub("^ +| +$";"")), summary: (.[2]|gsub("^ +| +$";""))}]')"
printf '%s' "$DOCS" | jq '{schema:1, docs:.}' > "$OUT/docs.json"
# Every file in docs/ is indexed in one of the two tables. An unindexed document is how the
# index silently went stale before, so it is an error rather than a warning.
BQ='`'
for f in "$ROOT"/docs/*.md "$ROOT"/docs/*.yaml; do
  [ -e "$f" ] || continue
  b="$(basename "$f")"
  [ "$b" = README.md ] && continue
  grep -qF "[$BQ$b$BQ](" "$ROOT/docs/README.md" || {
    echo "generate-site-data: docs/$b is in no table in docs/README.md (add a row; the site and the index both read it)" >&2; exit 10; }
done

# ---------------------------------------------------------------- derived Zola content (site/content/docs/*.md)
# Long-form pages are the canonical Markdown with a generated front matter; they are written
# here, gitignored, and rebuilt on every run. Nobody edits them. Repository-relative links are
# rewritten to site routes so the same Markdown serves both GitHub and the site.
CONTENT="$STAGE/content/docs"
rm -rf "$CONTENT"; mkdir -p "$CONTENT"
# every document listed in the docs/README.md index becomes a page; adding a row is the only step
# (AGENTS.md is listed in the index but lives at the repository root; it is rendered as "contract" below)
for d in $(jq -r '.docs[].path' "$OUT/docs.json" | grep -E '^[A-Z_]+\.md$' | sed 's/\.md$//' | while read -r n; do [ -f "$ROOT/docs/$n.md" ] && printf '%s\n' "$n"; done); do
  src="$ROOT/docs/$d.md"; slug="$(printf '%s' "$d" | tr 'A-Z_' 'a-z-')"
  title="$(grep -m1 '^# ' "$src" | sed 's/^# //; s/ — .*//')"
  summary="$(jq -r --arg p "$d.md" '.docs[] | select(.path==$p) | .summary' "$OUT/docs.json")"
  { printf -- '+++
title = %s
description = %s
weight = %s
[extra]
source = "docs/%s.md"
+++

' "$(jstr "$title")" "$(jstr "$summary")" "$(grep -n "^| \[\`$d.md\`" "$ROOT/docs/README.md" | cut -d: -f1 | head -1)" "$d"
    printf '{%% raw %%}\n'
    sed '1{/^# /d;}' "$src" | sed -E "$LINKSED" | awk -f "$ROOT/scripts/lib/project-markdown.awk" | awk '{ while (match($0, /\]\([A-Z_]+\.md\)/)) { t=substr($0,RSTART+2,RLENGTH-3); gsub(/_/,"-",t); $0=substr($0,1,RSTART-1) "](@/docs/" tolower(t) ")" substr($0,RSTART+RLENGTH) } print }'
    printf '{%% endraw %%}\n'
  } > "$CONTENT/$slug.md"
done
# the repository's own generated contract, as a page
{ printf -- '+++
title = "Repository contract"
description = "The operating contract for this repository, itself generated by majordomus update."
weight = 90
[extra]
source = "AGENTS.md"
+++

'; printf '{%% raw %%}\n'; sed '1{/^<!--/d;}' "$ROOT/AGENTS.md" | sed '1{/^# /d;}' | sed -E "$LINKSED" | awk -f "$ROOT/scripts/lib/project-markdown.awk"; printf '{%% endraw %%}\n'; } > "$CONTENT/contract.md"
printf -- '+++
title = "Documentation"
description = "Every document in the repository, rendered from the same Markdown GitHub shows."
sort_by = "weight"
template = "docs-section.html"
page_template = "docs-page.html"
+++
' > "$CONTENT/_index.md"

# ---------------------------------------------------------------- plan.json (the execution model)
# The canonical project model, projected for the website. Every value here comes from
# lib/project.awk through lib/project.sh — the same engine `majordomus plan` reads, so the
# roadmap cannot say one thing while the command says another. Nothing is recomputed here.
MJ_ROOT="$ROOT"; MJ_DIR="$ROOT/.majordomus"; export MJ_ROOT MJ_DIR
# shellcheck source=../lib/project.sh
. "$ROOT/lib/project.sh"
# shellcheck source=../lib/plan.sh
. "$ROOT/lib/plan.sh"
pj_list()  { mj_ylist "$MJ_PJ/flat/$1" "$2" | jq -R . | jq -sc .; }
pj_ev()    { # evidence entries of one record as a JSON array
  local id="$1" i=0
  printf '['
  while [ -n "$(mj_pj_get "$id" "evidence.$i.covers")" ]; do
    [ "$i" = 0 ] || printf ','
    jq -cn --arg c "$(mj_pj_get "$id" "evidence.$i.covers")" --arg t "$(mj_pj_get "$id" "evidence.$i.type")" \
      --arg cmd "$(mj_pj_get "$id" "evidence.$i.command")" --arg r "$(mj_pj_get "$id" "evidence.$i.result")" \
      --arg a "$(mj_pj_get "$id" "evidence.$i.artifact")" --arg co "$(mj_pj_get "$id" "evidence.$i.commit")" \
      --arg at "$(mj_pj_get "$id" "evidence.$i.recorded_at")" \
      '{covers:$c,type:$t,command:$cmd,result:$r,artifact:$a,commit:$co,recorded_at:$at}'
    i=$((i+1))
  done
  printf ']'
}
csv_json() { printf '%s' "$1" | tr ',' '\n' | sed '/^$/d' | jq -R . | jq -sc .; }

if mj_project_load; then
  MS="$(first=1; printf '['; for id in $(mj_pj_milestone_ids); do
    [ "$first" = 1 ] || printf ','; first=0
    row="$(mj_pj_row M "$id")"
    jq -cn --arg id "$id" --arg slug "$(printf '%s' "$row" | cut -f7)" --arg status "$(printf '%s' "$row" | cut -f3)" \
      --argjson order "$(printf '%s' "$row" | cut -f4)" --arg priority "$(printf '%s' "$row" | cut -f5)" \
      --arg title "$(printf '%s' "$row" | cut -f6)" \
      --arg problem "$(mj_pj_get "$id" problem)" --arg outcome "$(mj_pj_get "$id" outcome)" \
      --arg current "$(mj_pj_get "$id" current_state)" --arg desired "$(mj_pj_get "$id" desired_state)" \
      --argjson scope "$(pj_list "$id" scope)" --argjson non_scope "$(pj_list "$id" non_scope)" \
      --argjson acceptance "$(pj_list "$id" acceptance_criteria)" --argjson validation "$(pj_list "$id" validation)" \
      --argjson need "$(pj_list "$id" evidence_required)" --argjson risks "$(pj_list "$id" risks)" \
      --argjson evidence "$(pj_ev "$id")" \
      --argjson total "$(printf '%s' "$row" | cut -f8)" --argjson done_n "$(printf '%s' "$row" | cut -f9)" \
      --argjson ready "$(printf '%s' "$row" | cut -f10)" --argjson blocked "$(printf '%s' "$row" | cut -f11)" \
      --argjson active "$(printf '%s' "$row" | cut -f12)" --argjson verify "$(printf '%s' "$row" | cut -f13)" \
      --argjson cancelled "$(printf '%s' "$row" | cut -f14)" \
      --argjson issues "$(mj_pj_of_milestone "$id" | jq -R . | jq -sc .)" \
      --arg mermaid "$(mj_project_mermaid "$id")" \
      '{id:$id,slug:$slug,status:$status,order:$order,priority:$priority,title:$title,
        problem:$problem,outcome:$outcome,current_state:$current,desired_state:$desired,
        scope:$scope,non_scope:$non_scope,acceptance_criteria:$acceptance,validation:$validation,
        evidence_required:$need,risks:$risks,evidence:$evidence,issues:$issues,mermaid:$mermaid,
        counts:{total:$total,done:$done_n,ready:$ready,blocked:$blocked,active:$active,verify:$verify,cancelled:$cancelled}}'
  done; printf ']')"
  IS="$(first=1; printf '['; for id in $(mj_pj_issue_ids); do
    [ "$first" = 1 ] || printf ','; first=0
    row="$(mj_pj_row I "$id")"
    jq -cn --arg id "$id" --arg slug "$(printf '%s' "$row" | cut -f10)" --arg milestone "$(printf '%s' "$row" | cut -f3)" \
      --arg status "$(printf '%s' "$row" | cut -f4)" --argjson wave "$(printf '%s' "$row" | cut -f5)" \
      --arg priority "$(printf '%s' "$row" | cut -f6)" --arg profile "$(printf '%s' "$row" | cut -f7)" \
      --argjson parallel "$(printf '%s' "$row" | cut -f8)" --arg title "$(printf '%s' "$row" | cut -f9)" \
      --argjson deps "$(csv_json "$(printf '%s' "$row" | cut -f11)")" \
      --argjson blocked_by "$(csv_json "$(printf '%s' "$row" | cut -f12)")" \
      --argjson dependents "$(csv_json "$(printf '%s' "$row" | cut -f13)")" \
      --argjson scope "$(pj_list "$id" scope)" --argjson non_scope "$(pj_list "$id" non_scope)" \
      --arg objective "$(mj_pj_get "$id" objective)" --arg why "$(mj_pj_get "$id" why)" \
      --arg current "$(mj_pj_get "$id" current_state)" --arg desired "$(mj_pj_get "$id" desired_state)" \
      --argjson acceptance "$(pj_list "$id" acceptance_criteria)" --argjson validation "$(pj_list "$id" validation)" \
      --argjson need "$(pj_list "$id" evidence_required)" --argjson evidence "$(pj_ev "$id")" \
      --arg risk "$(mj_pj_get "$id" risk)" --arg completion "$(mj_pj_get "$id" completion)" \
      --arg started "$(mj_pj_get "$id" started_at)" --arg verified "$(mj_pj_get "$id" verified_at)" \
      --arg completed "$(mj_pj_get "$id" completed_at)" \
      '{id:$id,slug:$slug,milestone:$milestone,status:$status,wave:$wave,priority:$priority,profile:$profile,
        parallel_safe:$parallel,title:$title,depends_on:$deps,blocked_by:$blocked_by,dependents:$dependents,
        scope:$scope,non_scope:$non_scope,objective:$objective,why:$why,current_state:$current,desired_state:$desired,
        acceptance_criteria:$acceptance,validation:$validation,evidence_required:$need,evidence:$evidence,
        risk:$risk,completion:$completion,started_at:$started,verified_at:$verified,completed_at:$completed}'
  done; printf ']')"
  WV="$(mj_pj_rows W | jq -Rn '[inputs | split("\t") | {wave: (.[1]|tonumber), issues: (.[2]|split(" "))}]')"
  EG="$(mj_pj_rows G | jq -Rn '[inputs | split("\t") | {from: .[1], to: .[2]}]')"
  FD="$(mj_pj_findings | jq -Rn '[inputs | split("\t") | {level: .[1], code: .[2], subject: .[3], message: .[4]}]')"
  jq -n --arg name "$(mj_pj_project_name)" --arg repo "$(mj_pj_repository)" --arg branch "$(mj_pj_default_branch)" \
    --arg active "$(mj_pj_active)" --arg next "$(mj_pj_next_ready)" --arg mermaid "$(mj_project_mermaid)" \
    --argjson milestones "$MS" --argjson issues "$IS" --argjson waves "$WV" --argjson edges "$EG" --argjson findings "$FD" \
    '{schema:1, project:{name:$name, repository:$repo, default_branch:$branch},
      active_milestone:$active, next_ready:$next, mermaid:$mermaid,
      milestones:$milestones, issues:$issues, waves:$waves, edges:$edges, findings:$findings}' > "$OUT/plan.json"
# Refuse an invalid model rather than project it. A cycle makes every milestone BLOCKED with
# no rank, and without this the generator published that roadmap and exited 0 — a page saying
# nothing is reachable, with no reason given. The engine has already said so by this point:
# a FAIL finding is what `plan validate` exits 10 on, so this asks the same question of the
# same data instead of shelling back out to the CLI, which needs an installed .majordomus/
# that a disposable test repository does not have. Reported by the session that owns the
# model; the first version of this guard called the CLI and broke every site case.
  # ------------------------------------------------------------ roadmap.json
  # The roadmap is the milestone graph, and it is not recomputed here: this calls the same
  # projection `majordomus plan roadmap --json` prints, in process, so the page and the
  # command cannot disagree about what is blocked. Calling the CLI instead would need an
  # installed .majordomus/ that a disposable test repository does not have — that mistake
  # cost every site case an hour ago.
  ( MJ_JSON=1; mj_plan_roadmap ) > "$OUT/roadmap.json"
  # The milestone graph in the shape site/graph.js renders, so the roadmap reuses the runtime
  # /map/ and /evidence/ already use rather than adding a third picture of a dependency graph.
  jq '{schema: 1,
       source: ".majordomus/project/milestones/",
       edge_kinds: {requires: "the target cannot begin until the source is accepted"},
       nodes: [.milestones[] | {id: .id, kind: "milestone",
                                label: (if .version == "" then .id else .version + "  " + .id end),
                                status: .status, route: ("/plan/" + (.id | ascii_downcase) + "/"),
                                external: false, summary: .title}],
       edges: [.milestones[] | . as $m | $m.depends_on[] | {source: ., target: $m.id, kind: "requires"}]}' \
    "$OUT/roadmap.json" > "$OUT/roadmap-graph.json"
  [ -s "$OUT/roadmap.json" ] || { echo "generate-site-data: the roadmap projection produced nothing" >&2; exit 13; }
  # The gate the engine enforces: a milestone whose dependencies are not all DONE is BLOCKED,
  # whatever its own issues say. Asserted on the projection rather than reimplemented — this
  # should never fire, and if it does the page and the engine have diverged.
  jq -e '[.milestones[] | select((.blocked_by | length) > 0 and .status != "BLOCKED")] | length == 0' \
    "$OUT/roadmap.json" >/dev/null \
    || { echo "generate-site-data: a milestone has unmet dependencies but is not BLOCKED; the roadmap and the engine disagree" >&2; exit 10; }
  # Each version milestone names the claim it would move from planned to guaranteed. Linking
  # does not promote: a claim reaches guaranteed through implementation, test and CI, and the
  # page says so. But a claim named here that does not exist would be a promise about nothing.
  jq -e --slurpfile caps "$OUT/capabilities.json" \
    '[.milestones[].claims[]] - ($caps[0].claims | map(.id)) | length == 0' "$OUT/roadmap.json" >/dev/null \
    || { echo "generate-site-data: a milestone names a claim that is not in docs/CLAIMS.yaml" >&2; exit 10; }

PLAN_FAILS="$(jq -r '[.findings[] | select(.level == "FAIL")] | length' "$OUT/plan.json")"
if [ "$PLAN_FAILS" != 0 ]; then
  jq -r '.findings[] | select(.level == "FAIL") | "generate-site-data: project model: \(.code) \(.subject) — \(.message)"' "$OUT/plan.json" >&2
  echo "generate-site-data: refusing to publish a roadmap from an invalid model (run: majordomus plan validate)" >&2
  exit 10
fi
else
  echo "generate-site-data: no canonical project model in $ROOT/.majordomus/project" >&2; exit 12
fi

# ---------------------------------------------------------------- source.json
HASH="$( (cd "$ROOT" && for f in $INPUTS; do printf '%s ' "$f"; mj_sha256 "$f"; done) | mj_sha256 /dev/stdin 2>/dev/null || (cd "$ROOT" && for f in $INPUTS; do printf '%s ' "$f"; mj_sha256 "$f"; done) | shasum -a 256 | cut -d' ' -f1)"
COMMIT="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)"
jq -n --arg v "$VERSION" --arg c "$COMMIT" --arg h "$HASH" --argjson g "$GEN_VERSION" --arg inputs "$INPUTS" \
  '{schema:1, source_version:$v, source_commit:$c, source_hash:$h, generator_version:$g, input_files: ($inputs | split("\n"))}' > "$OUT/source.json"

# ---------------------------------------------------------------- derived section pages (every tile is a page)
mk_section() { # dir, title, description, section template, page template, weight
  local d="$CONTENT_ROOT/$1"; mkdir -p "$d"
  printf -- '+++\ntitle = %s\ndescription = %s\nsort_by = "weight"\ntemplate = "%s"\npage_template = "%s"\nweight = %s\n+++\n' "$(jstr "$2")" "$(jstr "$3")" "$4" "$5" "$6" > "$d/_index.md"
}
CONTENT_ROOT="$STAGE/content"
rm -rf "$CONTENT_ROOT/profiles" "$CONTENT_ROOT/guarantees" "$CONTENT_ROOT/supervises" "$CONTENT_ROOT/commands" "$CONTENT_ROOT/doctrines" "$CONTENT_ROOT/plan"
mk_section profiles "Execution profiles" "Capability class, reasoning effort, output verbosity, presentation, context toggles and verification are independent fields. Rendered from the profile files a fresh install writes." profiles.html profile.html 30
i=0; for slug in $(jq -r '.profiles[].slug' "$OUT/profiles.json"); do i=$((i+1))
  printf -- '+++\ntitle = %s\ndescription = %s\nweight = %s\n[extra]\nslug = %s\nsource = "share/skeleton/profiles/%s.yaml"\n+++\n' "$(jstr "$slug profile")" "$(jq -r --arg s "$slug" '.profiles[] | select(.slug==$s) | .description' "$OUT/profiles.json" | jq -Rn 'input')" "$i" "$(jstr "$slug")" "$slug" > "$CONTENT_ROOT/profiles/$slug.md"; done
mk_section guarantees "Guaranteed, advisory, planned" "What Majordomus actually does today, row by row, with the file that implements it and the test that proves it." guarantees.html claim.html 40
i=0; for st in guaranteed advisory planned rejected; do i=$((i+1))
  printf -- '+++\ntitle = %s\ndescription = %s\nweight = %s\ntemplate = "status.html"\n[extra]\nstatus = %s\n+++\n' "$(jstr "$(printf '%s' "$st" | awk '{print toupper(substr($0,1,1)) substr($0,2)}') capabilities")" "$(jq -r --arg s "$st" '.statuses[$s]' "$OUT/capabilities.json" | jq -Rn 'input')" "$i" "$(jstr "$st")" > "$CONTENT_ROOT/guarantees/$st.md"; done
jq -r '.claims[] | [.id, .claim, .status] | @tsv' "$OUT/capabilities.json" | while IFS="$(printf '\t')" read -r id claim st; do i=$((i+1))
  detail="$ROOT/docs/claims/$id.md"
  [ -f "$detail" ] || { echo "generate-site-data: claim $id has no docs/claims/$id.md (every claim needs its detail page)" >&2; exit 10; }
  summary="$(awk '/^## What it means/{f=1;next} f&&/^## /{exit} f&&NF{print; exit}' "$detail" | sed -E 's/`//g; s/\[([^]]+)\]\([^)]+\)/\1/g')"
  { printf -- '+++\ntitle = %s\ndescription = %s\nweight = %s\n[extra]\nclaim_id = %s\nstatus = %s\nsource = "docs/claims/%s.md"\n+++\n{%% raw %%}\n' "$(jstr "$claim")" "$(jstr "${summary:-Status: $st. Source, implementation and test for this claim.}")" "$((i+10))" "$(jstr "$id")" "$(jstr "$st")" "$id"
    sed '1{/^# /d;}' "$detail" | sed -E "$LINKSED" | awk -f "$ROOT/scripts/lib/project-markdown.awk" | awk '{ while (match($0, /\]\([A-Z_]+\.md\)/)) { t=substr($0,RSTART+2,RLENGTH-3); gsub(/_/,"-",t); $0=substr($0,1,RSTART-1) "](@/docs/" tolower(t) ")" substr($0,RSTART+RLENGTH) } print }'
    printf '{%% endraw %%}\n'; } > "$CONTENT_ROOT/guarantees/$id.md"; done
# The count is computed, never written: the repository's own rule is that prose states
# the command that produces a number rather than the number.
mk_section supervises "What Majordomus supervises" "$(jq -r '.does | length' "$OUT/readme.json") responsibilities, one directory. Each is a file in .majordomus/ and a subcommand that reads it." supervises-section.html responsibility.html 20
i=0; jq -r '.does[] | [.slug, .title, .text] | @tsv' "$OUT/readme.json" | while IFS="$(printf '\t')" read -r slug title text; do i=$((i+1))
  printf -- '+++\ntitle = %s\ndescription = %s\nweight = %s\n[extra]\nslug = %s\n+++\n' "$(jstr "$title")" "$(printf '%s' "$text" | sed -E 's/`([^`]*)`/\1/g' | jq -Rn 'input')" "$i" "$(jstr "$slug")" > "$CONTENT_ROOT/supervises/$slug.md"; done
mk_section doctrines "Doctrine" "A rule is enforced when it is declared, implemented, wired, executed, failure-propagating, tested and CI-blocking. Each one below shows its whole chain." doctrines-section.html doctrine.html 22
i=0; jq -r '.doctrines[] | [.id, .slug, .title, .summary] | @tsv' "$OUT/doctrines.json" | while IFS="$(printf '\t')" read -r id slug title summary; do i=$((i+1))
  printf -- '+++\ntitle = %s\ndescription = %s\nweight = %s\n[extra]\nid = %s\nsource = "share/doctrines.yaml"\n+++\n' "$(jstr "$title")" "$(printf '%s' "$summary" | jq -Rn 'input')" "$i" "$(jstr "$id")" > "$CONTENT_ROOT/doctrines/$slug.md"; done
mk_section plan "The plan" "Milestones as executable outcome specifications, issues as execution contracts, and the dependency graph that decides what may be executed next. Every figure is derived from .majordomus/project." plan-section.html issue.html 21
printf -- '+++\ntitle = "Dependency graph"\ndescription = "Every issue, every dependency, and the execution waves the graph implies — drawn from the canonical edges, never by hand."\nweight = 1\ntemplate = "dag.html"\n+++\n' > "$CONTENT_ROOT/plan/dag.md"
i=1; for mid in $(jq -r '.milestones | sort_by(.order) | .[].id' "$OUT/plan.json"); do i=$((i+1))
  printf -- '+++\ntitle = %s\ndescription = %s\nweight = %s\ntemplate = "milestone.html"\n[extra]\nplan_id = %s\nsource = ".majordomus/project/milestones/%s.yaml"\n+++\n' \
    "$(jstr "$mid — $(jq -r --arg m "$mid" '.milestones[] | select(.id==$m) | .title' "$OUT/plan.json")")" \
    "$(jq -r --arg m "$mid" '.milestones[] | select(.id==$m) | .outcome' "$OUT/plan.json" | jq -Rn 'input')" \
    "$i" "$(jstr "$mid")" "$mid" > "$CONTENT_ROOT/plan/$mid.md"; done
for iid in $(jq -r '.issues[].id' "$OUT/plan.json"); do i=$((i+1))
  printf -- '+++\ntitle = %s\ndescription = %s\nweight = %s\n[extra]\nplan_id = %s\nsource = ".majordomus/project/issues/%s.yaml"\n+++\n' \
    "$(jstr "$iid — $(jq -r --arg n "$iid" '.issues[] | select(.id==$n) | .title' "$OUT/plan.json")")" \
    "$(jq -r --arg n "$iid" '.issues[] | select(.id==$n) | .objective' "$OUT/plan.json" | jq -Rn 'input')" \
    "$i" "$(jstr "$iid")" "$iid" > "$CONTENT_ROOT/plan/$iid.md"; done
mk_section commands "Commands" "One executable, $(jq '.commands | length' "$OUT/commands.json") subcommands. Exit codes are a contract." commands-section.html command.html 25
i=0; for name in $(jq -r '.commands[].name' "$OUT/commands.json"); do i=$((i+1))
  printf -- '+++\ntitle = %s\ndescription = %s\nweight = %s\n[extra]\nname = %s\nsource = "docs/CLI.md"\n+++\n' "$(jstr "majordomus $name")" "$(jq -r --arg n "$name" '.commands[] | select(.name==$n) | .summary' "$OUT/commands.json" | jq -Rn 'input')" "$i" "$(jstr "$name")" > "$CONTENT_ROOT/commands/$name.md"; done

# ---------------------------------------------------------------- docs/SITE_CLAIMS.md (derived release artifact)
SC="$STAGE/SITE_CLAIMS.md"
{
  printf '# Site claims\n\nGenerated by `scripts/generate-site-data` from `docs/CLAIMS.yaml`. Do not edit; edit the YAML.\nEvery substantive public claim the website makes, with its status, the file that defines it,\nthe file that implements it, and the test that proves it. The website renders the same data.\n\n'
  for st in guaranteed advisory planned rejected; do
    printf '## %s\n\n%s\n\n| claim | source | implementation | test |\n|---|---|---|---|\n' "$st" "$(jq -r --arg s "$st" '.statuses[$s]' "$OUT/capabilities.json")"
    jq -r --arg s "$st" '.claims[] | select(.status==$s) | "| [\(.claim)](https://korczis.github.io/prismatic-majordomus/guarantees/\(.id)/) | `\(.source)` | \(if .implementation then "`\(.implementation)`" else "—" end) | \(if .test then "`\(.test)`" else "—" end) |"' "$OUT/capabilities.json"
    printf '\n'
  done
} > "$SC"

# ---------------------------------------------------------------- docs/PLAN_STATUS.md (derived)
# The same current state the website's /plan/ route shows, as a Markdown table for a reader
# on GitHub. Generated from plan.json, which is generated from .majordomus/project. This is
# a second rendering, never a second source: docs/PLANNING.md explains the semantics and
# contains no figure, this file contains only figures and explains nothing.
PS="$STAGE/PLAN_STATUS.md"
{
  printf '# Plan status\n\nGenerated by `scripts/generate-site-data` from `.majordomus/project/`. Do not edit; edit the\ncanonical records and regenerate. `majordomus plan status` prints the same thing at a terminal,\nand the website renders it at `/plan/`. Semantics are in [`PLANNING.md`](PLANNING.md).\n\n'
  printf 'Source commit `%s`, inputs `%s`.\n\n' "$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)" "$(printf '%s' "$HASH" | cut -c1-12)"
  printf '## Milestones\n\n| milestone | status | issues done | ready | active | verify | blocked | outcome |\n|---|---|---|---|---|---|---|---|\n'
  jq -r '.milestones[] | "| [\(.id)](https://korczis.github.io/prismatic-majordomus/plan/\(.id | ascii_downcase)/) | \(.status) | \(.counts.done)/\(.counts.total) | \(.counts.ready) | \(.counts.active) | \(.counts.verify) | \(.counts.blocked) | \(.outcome) |"' "$OUT/plan.json"
  printf '\n## Issues\n\n| issue | milestone | status | wave | depends on | title |\n|---|---|---|---|---|---|\n'
  jq -r '.issues[] | "| [\(.id)](https://korczis.github.io/prismatic-majordomus/plan/\(.id | ascii_downcase)/) | \(.milestone) | \(.status) | \(.wave) | \(if (.depends_on | length) == 0 then "—" else (.depends_on | join(", ")) end) | \(.title) |"' "$OUT/plan.json"
  printf '\n## Execution waves\n\n'
  jq -r '.waves[] | "- **wave \(.wave)** — \(.issues | join(", "))"' "$OUT/plan.json"
  printf '\n## Ready now\n\n'
  if [ "$(jq '[.issues[] | select(.status=="READY")] | length' "$OUT/plan.json")" = 0 ]; then
    printf 'Nothing is ready. Run `majordomus plan blocked` to see what each waiting issue waits on.\n'
  else
    jq -r '. as $p | $p.issues[] | select(.status=="READY") | "- `\(.id)` (\(.milestone), wave \(.wave)) — \(.title)\(if .id == $p.next_ready then "  **← `majordomus plan next` returns this one**" else "" end)"' "$OUT/plan.json"
  fi
  printf '\n\n## Findings\n\n'
  if [ "$(jq '.findings | length' "$OUT/plan.json")" = 0 ]; then printf 'None. The model validates with no failure and no warning.\n'
  else printf '| level | code | subject | message |\n|---|---|---|---|\n'
       jq -r '.findings[] | "| \(.level) | `\(.code)` | `\(.subject)` | \(.message) |"' "$OUT/plan.json"; fi
} > "$PS"

# ---------------------------------------------------------------- staged output complete
# Everything above wrote into $STAGE only. Nothing under the repository has changed yet, so a
# failure before this point leaves the previous generation intact.

if [ "$CHECK" = 1 ]; then
  rc=0
  for f in "$OUT"/*.json; do
    n="$(basename "$f")"; [ "$n" = source.json ] && continue
    diff -q "$f" "$DEST_DATA/$n" >/dev/null 2>&1 || { echo "STALE site/data/generated/$n (run: scripts/generate-site-data)"; rc=10; }
  done
  for f in "$DEST_DATA"/*.json; do
    n="$(basename "$f")"; [ -f "$OUT/$n" ] || { echo "ORPHAN site/data/generated/$n is no longer generated (run: scripts/generate-site-data)"; rc=10; }
  done
  diff -q "$STAGE/SITE_CLAIMS.md" "$ROOT/docs/SITE_CLAIMS.md" >/dev/null 2>&1 || { echo "STALE docs/SITE_CLAIMS.md (run: scripts/generate-site-data)"; rc=10; }
  diff -q "$STAGE/PLAN_STATUS.md" "$ROOT/docs/PLAN_STATUS.md" >/dev/null 2>&1 || { echo "STALE docs/PLAN_STATUS.md (run: scripts/generate-site-data)"; rc=10; }
  # source.json carries the commit, which moves every commit; compare the input hash only
  a="$(jq -r .source_hash "$OUT/source.json")"; b="$(jq -r .source_hash "$DEST_DATA/source.json" 2>/dev/null || true)"
  [ "$a" = "$b" ] || { echo "STALE site/data/generated/source.json: input hash ${b:0:12} != ${a:0:12}"; rc=10; }
  [ $rc = 0 ] && echo "site data: in sync ($(printf '%s' "$a" | cut -c1-12))"
  exit $rc
fi

# ---------------------------------------------------------------- publish (atomic per directory)
if [ "$PUBLISH" = 1 ] || [ "$DEST_DATA" != "$ROOT/site/data/generated" ]; then
  mkdir -p "$(dirname "$DEST_DATA")"
  rm -rf "$DEST_DATA.mj-old"
  [ -d "$DEST_DATA" ] && mv "$DEST_DATA" "$DEST_DATA.mj-old"
  if mv "$OUT" "$DEST_DATA"; then rm -rf "$DEST_DATA.mj-old"
  else [ -d "$DEST_DATA.mj-old" ] && mv "$DEST_DATA.mj-old" "$DEST_DATA"; echo "generate-site-data: could not publish site data; previous generation restored" >&2; exit 13; fi
fi

if [ "$PUBLISH" = 1 ]; then
  mkdir -p "$ROOT/site/content"
  mkdir -p "$ROOT/site/content"
  # derived content: replace each generated subtree and each generated file, leaving anything
  # else under site/content/ (there is nothing else today) untouched
  for d in "$STAGE"/content/*/; do
    [ -d "$d" ] || continue
    d="${d%/}"; n="$(basename "$d")"; dest="$ROOT/site/content/$n"
    rm -rf "$dest.mj-old"; [ -d "$dest" ] && mv "$dest" "$dest.mj-old"
    if mv "$d" "$dest"; then rm -rf "$dest.mj-old"
    else [ -d "$dest.mj-old" ] && mv "$dest.mj-old" "$dest"; echo "generate-site-data: could not publish site/content/$n; previous generation restored" >&2; exit 13; fi
  done
  for f in "$STAGE"/content/*.md; do
    [ -f "$f" ] || continue
    cp "$f" "$ROOT/site/content/$(basename "$f").mj-tmp" && mv "$ROOT/site/content/$(basename "$f").mj-tmp" "$ROOT/site/content/$(basename "$f")"
  done
  cp "$STAGE/SITE_CLAIMS.md" "$ROOT/docs/SITE_CLAIMS.md.mj-tmp" && mv "$ROOT/docs/SITE_CLAIMS.md.mj-tmp" "$ROOT/docs/SITE_CLAIMS.md"
  cp "$STAGE/PLAN_STATUS.md" "$ROOT/docs/PLAN_STATUS.md.mj-tmp" && mv "$ROOT/docs/PLAN_STATUS.md.mj-tmp" "$ROOT/docs/PLAN_STATUS.md"
fi

echo "site data: $(ls "$DEST_DATA" | wc -l | tr -d ' ') files in ${DEST_DATA#"$ROOT"/} (inputs $(printf '%s' "$HASH" | cut -c1-12))"
