{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://majordomus.dev/schemas/project.schema.json",
  "title": "Project",
  "description": "The project model header, .ai/repo/project/project.yaml.",
  "x-majordomus-allow": "project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "repository", "default_branch"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string" },
    "repository": { "type": "string" },
    "default_branch": { "type": "string" }
  }
}
