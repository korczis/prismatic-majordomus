# direnv, for whoever works in this repository. `direnv allow` once, and entering the
# directory puts the tool on the path, exports what a shell here needs, and says where
# things are.
#
# This file is an adapter and nothing else. It reads nothing about the repository — no
# git, no grep, no find, no sed, no awk, no jq, no curl — and it builds nothing. Every
# fact it shows comes from `majordomus env`, which is where such facts are decided once
# and where they are typed, tested, benchmarked and served to every other surface. A
# pipeline here would be a second implementation of that, running on every `cd`, with
# nobody testing it. The rule `project.envrc-is-an-adapter` holds this shut.
#
#   MAJORDOMUS_BANNER=off      no banner; `full` and `compact` fix the form
#   MAJORDOMUS_BUILD_PROFILE   which build of the executable to use (debug, release)
#   NO_COLOR, CI               plain output, and under CI no banner at all
#
# `just env` prints the whole snapshot; `just env-explain` says where each value came from.

# The task lifecycle tool. The Rust executable is not put on the path: it shares the name
# `majordomus` with this one, and two different programs under one name on PATH is a trap.
PATH_add bin

# Re-evaluate when this repository's shared server comes up or goes away, so that the
# addresses in the environment and in the banner are true rather than merely recent.
watch_file .ai/local/state/mcp/server.json

# One call, one snapshot: the assignments on stdout for `eval`, the banner on stderr —
# stderr because direnv reads an .envrc's stdout as the environment it is applying. Two
# calls would be two `git status` runs, which is the whole cost of entering a repository.
#
# `--bridge` refreshes the workflow bridge — every command of both programs, as a recipe —
# when one of the declarations behind it has changed, and does a few `stat` calls when
# none has. Deciding that is the tool's work, not this file's.
eval "$(bin/majordomus-env export --shell direnv --banner --bridge)"

# Machine-local secrets and overrides, never committed. Last, so a value here wins
# over the snapshot above. Still within the adapter rule: this reads nothing about
# the repository, only what the person on this machine chose to export.
source_env_if_exists .envrc.local
