#!/usr/bin/env bash
# release-check — the gate of project.release-is-a-projection: the version is one fact with
# one writer, and the changelog is composed rather than kept.
#
# `majordomus generate --check` already proves that docs/generated/changelog.* is what the
# composer would write from this tree today. It cannot prove the two things below, because
# both are about declarations it never reads:
#
#   1. Where the version is stated is itself stated twice. The crate names the two sites in
#      apps/majordomus-cli/src/release/version.rs (MANIFEST, ENTRY) and the release script
#      names them again in scripts/release-version, because an installed tree has no
#      Cargo.toml and the crate is compiled before the shell tool exists. Two readers of one
#      fact is tolerable; two readers that have drifted is a writer raising files the check
#      does not read, and nothing else notices until a tag is cut.
#   2. That the two sites agree is checked only by the release workflow, at the moment of
#      publication — so a half-applied bump lives on the default branch until somebody tries
#      to ship it. The same verdict belongs on every plan. The comparison itself is not made
#      here: scripts/release-version is the one shell reader of the version, this gate runs
#      it, and check 1 above is what proves it reads the sites the crate writes. A third
#      parser here would be the duplication this gate exists to catch.
#   3. Nothing may keep a changelog by hand. A composed changelog and a maintained
#      CHANGELOG.md are two answers to one question, and the maintained one wins by being
#      the file people open. A page that renders the derived document is a projection and is
#      not this: only the two conventional homes of an authored changelog are refused.
#   4. The version the tree declares is never behind the newest release the layer records:
#      a published 1.2.0 with a tree that still says 1.1.0 means the bump was never made.
#   5. Every published tag has a release record. A tag without one is a release that was
#      published to the world and never reached the layer every projection is composed from,
#      which is what a failure in the publish job looks like from the outside: nothing red,
#      and an installer that goes on serving the previous version.
#
#   scripts/ci/release-check                report every finding, exit 10 on any
#   MJ_ROOT=<dir> scripts/ci/release-check  against another tree (the behavioural case does)
#
# Exit: 0 clean, 10 findings, 12 unusable.
set -eu
ROOT="${MJ_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
cd "$ROOT"
findings=0
ok()   { printf 'ok    %s\n' "$*"; }
fail() { printf 'FAIL  %s\n' "$*"; findings=$((findings+1)); }

MODULE=apps/majordomus-cli/src/release/version.rs
SCRIPT=scripts/release-version
[ -f "$MODULE" ] || { echo "release-check: $MODULE is missing" >&2; exit 12; }
[ -f "$SCRIPT" ] || { echo "release-check: $SCRIPT is missing" >&2; exit 12; }

# ------------------------------------------------------ 1. the two sites are named the same
# Both declarations are read; neither is written here, so this gate cannot become a third
# copy of the fact it is holding together.
rust_const() { sed -n "s/^pub const $1: &str = \"\\([^\"]*\\)\";/\\1/p" "$MODULE" | head -n 1; }
sh_path()    { sed -n "s|^$1=\"\\\$ROOT/\\(.*\\)\"\$|\\1|p" "$SCRIPT" | head -n 1; }

for site in MANIFEST ENTRY; do
  from_rust="$(rust_const "$site")"
  from_shell="$(sh_path "$site")"
  if [ -z "$from_rust" ] || [ -z "$from_shell" ]; then
    fail "the $site version site is not declared in both $MODULE and $SCRIPT (rust '$from_rust', shell '$from_shell')"
    continue
  fi
  if [ "$from_rust" = "$from_shell" ]; then
    ok "$site is $from_rust in both the crate and the release script"
  else
    fail "the $site version site has drifted: the crate writes $from_rust and $SCRIPT reads $from_shell"
  fi
done

MANIFEST_PATH="$(rust_const MANIFEST)"
ENTRY_PATH="$(rust_const ENTRY)"

# ------------------------------------------------------------ 2. the two sites state one version
#
# Asked of scripts/release-version, never parsed again here. That script is the one shell
# reader of the version — it exists because a released tree has no toolchain — and check 1
# above has just proved it reads the same two sites the crate writes. Reading them a third
# time in this file would add exactly the drift this gate is for.
if [ -n "$MANIFEST_PATH" ] && [ -n "$ENTRY_PATH" ] && [ -f "$MANIFEST_PATH" ] && [ -f "$ENTRY_PATH" ]; then
  if version_out="$("$SCRIPT" --check 2>&1)"; then
    crate="$("$SCRIPT")"
    ok "both writers state $crate"
  else
    crate=""
    printf '%s\n' "$version_out" | sed -n 's/^release-version: FAIL /      /p' | while IFS= read -r line; do
      printf '%s\n' "$line"
    done
    fail "the two version sites do not state one version (scripts/release-version --check); \`majordomus release bump --exact <version>\` writes both"
  fi
else
  fail "a version site the crate declares does not exist: $MANIFEST_PATH, $ENTRY_PATH"
  crate=""
fi

# ------------------------------------------------- 2b. the lock records the version too
#
# Cargo.lock is not a third declaration — cargo derives it from the manifest and nobody
# chooses the value — but it is tracked and the build runs `--locked`, so a bump that raised
# the manifest and left the lock behind fails the next build with "cannot update the lock
# file", which reads as a toolchain fault rather than as a half-applied bump. The writer owns
# it (release/version.rs, LOCK); this is what notices when something else edited one of them.
LOCK_PATH="$(rust_const LOCK)"
if [ -n "$LOCK_PATH" ] && [ -f "$LOCK_PATH" ] && [ -n "$crate" ]; then
  locked="$(awk '/^name = "majordomus-cli"$/{f=1;next} f && /^version = /{gsub(/[^0-9A-Za-z.+-]/,"",$3); print $3; exit}' "$LOCK_PATH")"
  if [ "$locked" = "$crate" ]; then
    ok "$LOCK_PATH records $locked for this crate"
  else
    fail "$LOCK_PATH records '$locked' for this crate and the manifest states '$crate'; the next --locked build fails — \`majordomus release bump --exact $crate\` writes every site"
  fi
elif [ -n "$LOCK_PATH" ] && [ ! -f "$LOCK_PATH" ]; then
  fail "the crate declares the lock site $LOCK_PATH and it does not exist"
fi

# ------------------------------------------------------------------- 3. no changelog is kept
# The two conventional homes of an authored changelog, and only those: a site page whose body
# renders the derived document is a projection, and the generated tree is the projection.
authored=0
for f in \
  [Cc][Hh][Aa][Nn][Gg][Ee][Ll][Oo][Gg]* \
  docs/[Cc][Hh][Aa][Nn][Gg][Ee][Ll][Oo][Gg]*
do
  [ -f "$f" ] || continue
  case "$f" in docs/generated/*) continue ;; esac
  fail "$f is an authored changelog; the changelog is composed by \`majordomus release changelog\` and written by \`majordomus generate changelog\` into docs/generated/"
  authored=$((authored+1))
done
if [ "$authored" = 0 ]; then ok "no changelog is kept by hand"; fi

# ----------------------------------------------- 4. the tree is not behind what was published
newest=""
for r in .ai/repo/releases/*.yaml; do
  [ -f "$r" ] || continue
  v="$(sed -n 's/^version: *"\{0,1\}\([0-9][0-9.]*\)"\{0,1\} *$/\1/p' "$r" | head -n 1)"
  [ -n "$v" ] || continue
  newest="$(printf '%s\n%s\n' "$newest" "$v" | grep -v '^$' | LC_ALL=C sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)"
done
if [ -z "$newest" ] || [ -z "$crate" ]; then
  ok "no published release to compare the declared version with"
else
  behind="$(printf '%s\n%s\n' "$crate" "$newest" | LC_ALL=C sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)"
  if [ "$behind" = "$crate" ]; then
    ok "the tree declares $crate and the newest release is $newest"
  else
    fail "the tree declares $crate and $newest is already published; the bump that released it was never made"
  fi
fi

# ------------------------------------------ 5. every published tag has a record in the layer
#
# The failure this exists for: v0.7.0 published six archives and a GitHub Release, and the
# step that proposes the record's pull request then failed — run 34965490909, where the
# publish job held no `pull-requests: write`, so `gh pr create` wrote nothing and its
# fallback printed `no pull requests found for branch "release/record-v0.7.0"`. Every place
# a person looks said released: the tag, the release page, the crate's version, the site's
# version. Master held no record, so the published releases/latest.json went on naming the
# previous version and the advertised installer went on installing it. Nothing was red but
# one job in a workflow nobody was watching.
#
# The executable already names this state — as a *warning*, inside the baseline it resolves
# for `release analyze` (apps/majordomus-cli/src/release/compat.rs, diagnostic
# `tag-without-record`). A warning is what four hours of a wrong installer looks like, and
# `release version`, the report a person actually opens, prints nothing about it at all.
# This gate is what turns the same fact into a verdict. It does not ask the executable for
# it: this gate runs in the `structure` job, which has no toolchain, and `release analyze`
# refuses outright in a tree that committed no registry — so what is read here is the two
# things a record is made of, git's tags and the layer's records, and nothing is decided
# that those files do not state.
#
# Debt is recorded, never absorbed: a tag listed in the baseline below, with the reason that
# clears it, is excused and still named as debt; a line the tree has outgrown is reported so
# the list cannot rot.
RECORD_BASELINE=".ai/repo/release-record-baseline.txt"
excused_list=""
if [ -f "$RECORD_BASELINE" ]; then
  excused_list="$(sed -e 's/#.*//' -e 's/[[:space:]]*$//' "$RECORD_BASELINE" | grep -v '^[[:space:]]*$' || true)"
fi

# a record is named after its tag, or names it
recorded_tag() {
  if [ -f ".ai/repo/releases/$1.yaml" ]; then return 0; fi
  grep -l "^tag: *$1 *\$" .ai/repo/releases/*.yaml >/dev/null 2>&1
}

if ! command -v git >/dev/null 2>&1 || ! git rev-parse --git-dir >/dev/null 2>&1; then
  # Never quietly: a measurement that could not be taken is reported, because a gate that
  # skips is indistinguishable from a gate that passed — project.never-reported-is-not-green.
  fail "the published tags could not be read here — this tree is not a git checkout, or git is unavailable — so 'every published tag has a record' was not measured"
else
  # Local tags, after a fetch: the same list the pipeline tags from, read without a token.
  # `git ls-remote --tags origin` would ask the forge for a fact a fetched clone already
  # holds, and would make this gate fail on a machine with no network.
  # v<major>.<minor>.<patch> exactly: that is what the release workflow cuts, and it refuses
  # to publish a tag that does not agree with the crate's version, so a tag with a suffix
  # (v0.2.0-ai-documents) named something else and never published a release.
  tags="$(git tag --list 'v[0-9]*' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | LC_ALL=C sort -u || true)"
  if [ -z "$tags" ]; then
    # No tags is two different states, and only one of them is fine. A repository that has
    # published nothing has no tags and no records; a checkout whose tags were not fetched
    # has records and no tags, and answering "nothing to compare" there would be the quiet
    # pass this check exists to remove. The structure job checks out with fetch-depth 0 for
    # exactly this reason, so the second state means the fetch, not the tree, is what failed.
    if [ -n "$newest" ]; then
      fail "the layer records releases (newest $newest) and this checkout lists no version tag, so 'every published tag has a record' was not measured — fetch the tags (git fetch --tags, or actions/checkout with fetch-depth: 0)"
    else
      ok "this checkout carries no version tag and the layer records no release: nothing has been published"
    fi
  else
    missing=0
    excused=0
    for t in $tags; do
      if recorded_tag "$t"; then continue; fi
      if printf '%s\n' "$excused_list" | grep -qx "$t"; then
        ok "$t has no release record and is recorded debt in $RECORD_BASELINE"
        excused=$((excused+1))
        continue
      fi
      missing=$((missing+1))
      fail "$t is published and the layer holds no release record for it (.ai/repo/releases/$t.yaml is missing); the site's releases/latest.json, the installation guide and every baseline are composed from the records, so this release is invisible to them and the advertised installer still installs the previous one — scripts/release-record writes it"
    done
    # Said as it is: a tree carrying excused tags has not been proved clean, and a summary
    # that read "every published tag has a record" over a baseline would be the quiet pass
    # this check exists to remove.
    if [ "$missing" = 0 ] && [ "$excused" = 0 ]; then
      ok "every published tag this checkout carries has a release record"
    elif [ "$missing" = 0 ]; then
      ok "every published tag has a release record except the $excused recorded as debt in $RECORD_BASELINE"
    fi
    for e in $excused_list; do
      if recorded_tag "$e" || ! printf '%s\n' "$tags" | grep -qx "$e"; then
        printf 'note  %s is excused in %s and no longer needs to be: delete the line\n' "$e" "$RECORD_BASELINE"
      fi
    done
  fi
fi

if [ "$findings" -eq 0 ]; then
  printf 'release-check: the release is a projection — one writer, no kept changelog, every published tag recorded\n'
  exit 0
fi
printf 'release-check: %s finding(s)\n' "$findings" >&2
exit 10
