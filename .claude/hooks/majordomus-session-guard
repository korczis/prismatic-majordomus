#!/bin/sh
# The PreToolUse hook: it runs where the provider fires that event, and hands the payload
# to `majordomus capture guard --provider claude-code`. Written by `majordomus capture install`.
#
# The repository is derived from this file: the provider substitutes its project
# directory into the command string textually, so nothing in the environment names
# the repository here, and the working directory is not contracted.
#
# This is the one hook that may say no, so it is also the one whose every other
# exit must be a yes. It runs the command rather than exec-ing it and passes on
# exactly one code — 2, the refusal the provider blocks the tool on. Anything else
# the command can exit for, and anything it can die of, is exit 0 here: this file
# is tracked, it reaches every worktree of the repository at once, and an exit code
# it invents is a tool call somebody cannot make.
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd) || exit 0
for mj in "$root/bin/majordomus" "$root/.majordomus/bin/majordomus"; do
  [ -x "$mj" ] && break
  mj=
done
[ -n "$mj" ] || mj=$(command -v majordomus) || exit 0
"$mj" --repo "$root" capture guard --provider claude-code
code=$?
[ "$code" = 2 ] && exit 2
exit 0
