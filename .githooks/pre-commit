#!/bin/sh
# install once: git config core.hooksPath .githooks
bin/majordomus doctor || exit $?
# A feature branch is committed from its canonical worktree (<repo>-wt/<branch>) and the
# trunk from the primary checkout; the guard decides, this line only asks. The logic lives
# in the Rust executable's worktree service, and the launcher builds it when it must.
bin/majordomus-cli worktree guard --quiet || exit $?
# The derived data is a projection of the tree it was generated from, and a commit that moves
# a canonical input without regenerating publishes nothing and breaks the deploy for whoever
# lands next. `pages current` compares the recorded input hash with this tree's in a fifth of
# a second, which is why it can run here rather than only in CI.
scripts/pages current || exit $?
