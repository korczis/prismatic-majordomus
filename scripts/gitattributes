#!/usr/bin/env bash
# gitattributes — the merge policy for derived files, written from the generators themselves.
#
# `merge=derived` tells git that a file is not worth merging: the driver (scripts/merge-derived)
# resolves it to one side, the tree carries a stale artifact, and the `derived-current` gate
# refuses the commit until `scripts/derive` writes the real answer. That is correct for a file
# a generator owns, and it is silent data loss for a file a person wrote — the driver discards
# one whole side with no conflict marker and no diagnostic.
#
# The list therefore has to be the generators' own, never a person's. It was a person's until
# 2026-09-12, and it was wrong in both directions at once: `share/schemas/**/*.schema.json`
# claimed forty-five files of which generate writes nine, and `share/allow/**` claimed two
# allow-lists whose own first line reads "AUTHORED FILE — no generator derives it yet". Both
# ate real edits; the second ate the policy schema twice in one evening, after which the tree
# refused to serve with an error that named a missing schema key and nothing about a merge.
#
#   scripts/gitattributes           rewrite the managed block of .gitattributes
#   scripts/gitattributes --check   exit 10 if the block is not what this run would write
#
# The prose outside the markers is a person's and is preserved. Two authorities decide the
# block, and nothing else may:
#
#   docs/generated/artifacts.json     every file `majordomus generate` writes, one by one.
#   scripts/generate-site-data        the trees and files the site generator publishes, read
#                                     out of its own sections and its publish block — the same
#                                     technique scripts/ci/backlog-check uses, for the same
#                                     reason: a hand list falls behind the generator the first
#                                     time a section is added, which is how the omission lived.
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
CHECK=0; [ "${1:-}" = --check ] && CHECK=1
BEGIN='# >>> generated by scripts/gitattributes — do not edit between the markers >>>'
END='# <<< generated by scripts/gitattributes <<<'
GEN='scripts/generate-site-data'
MANIFEST='docs/generated/artifacts.json'
[ -f "$MANIFEST" ] || { echo "gitattributes: $MANIFEST is missing (run: majordomus generate)" >&2; exit 12; }
[ -f "$GEN" ] || { echo "gitattributes: $GEN is missing" >&2; exit 12; }

# Every path the executable's manifest claims. It is the whole answer for that generator: one
# line per file, so a schema it stops writing stops being declared the same day.
manifest_paths() { jq -r '.. | objects | select(has("path")) | .path' "$MANIFEST" | LC_ALL=C sort -u; }

# The site generator's outputs, read out of the generator.
site_paths() {
  # The sections it names literally — the same read scripts/ci/backlog-check performs, so a
  # section added tomorrow is declared the day it is added.
  grep -oE '\$CONTENT_ROOT/[a-z-]+' "$GEN" | sed 's#\$CONTENT_ROOT/#site/content/#; s#$#/**#'
  # And the sections it names through a variable, which no reading of the script can see:
  # `mk_section` takes the directory as "$1" and the documentation pages are written to
  # "$CONTENT_ROOT/$rel", so site/content/docs — the largest tree of the lot, and the one a
  # static read silently drops — appears nowhere as a literal. The publish block moves every
  # staged subtree over site/content/<name>, so after a generation the directories that are
  # there ARE the generator's output set, by definition. Both halves, because the static one
  # still answers on a tree that has never been generated.
  [ -d site/content ] && find site/content -mindepth 1 -maxdepth 1 -type d | sed 's#$#/**#' | LC_ALL=C sort
  # The three documents its publish block copies into docs/, named by that block.
  grep -oE 'cp "\$STAGE/[A-Z_]+\.md" "\$ROOT/docs/[A-Z_]+\.md' "$GEN" | sed 's#.*\$ROOT/##'
  printf 'site/content/*.md\nsite/data/generated/**\n'
}

block() {
  printf '%s\n' "$BEGIN"
  printf '# %s path(s) from %s, plus the sections and documents %s publishes.\n' \
    "$(manifest_paths | wc -l | tr -d ' ')" "$MANIFEST" "$GEN"
  printf '# Regenerate with scripts/gitattributes; scripts/derive does it, --check proves it,\n'
  printf '# and test/cases/241_merge_policy_claims_only_generated.sh proves the converse.\n'
  # This file is itself written by a generator — this one — so it belongs in its own list.
  # Neither authority can claim it: the manifest is the executable's, and the site generator
  # does not write it. A generator is the authority for its own output, and that is the only
  # entry below that is not read from somewhere else.
  { printf '.gitattributes\n'; manifest_paths; site_paths; } | LC_ALL=C sort -u | while IFS= read -r p; do
    [ -n "$p" ] || continue
    printf '%-64s merge=derived\n' "$p"
  done
  printf '%s\n' "$END"
}

[ -f .gitattributes ] || : > .gitattributes
grep -qxF "$BEGIN" .gitattributes || printf '\n%s\n%s\n' "$BEGIN" "$END" >> .gitattributes

SENTINEL="$(printf '\001')"
NEW="$(mktemp "${TMPDIR:-/tmp}/mj.ga.XXXXXX")"
OUTF="$(mktemp "${TMPDIR:-/tmp}/mj.ga2.XXXXXX")"
trap 'rm -f "$NEW" "$OUTF"' EXIT
awk -v b="$BEGIN" -v e="$END" -v s="$SENTINEL" 'BEGIN{skip=0} $0==b{skip=1;print s;next} $0==e{skip=0;next} !skip{print}' .gitattributes > "$NEW"
while IFS= read -r line; do
  if [ "$line" = "$SENTINEL" ]; then block; else printf '%s\n' "$line"; fi
done < "$NEW" > "$OUTF"

if [ "$CHECK" = 1 ]; then
  cmp -s "$OUTF" .gitattributes && { echo "gitattributes: the managed block matches the generators"; exit 0; }
  echo "gitattributes: .gitattributes does not match what the generators write (run: scripts/gitattributes)" >&2
  diff -u .gitattributes "$OUTF" | head -40 >&2 || true
  exit 10
fi
cp "$OUTF" .gitattributes
printf 'gitattributes: wrote %s declaration(s)\n' \
  "$(awk -v b="$BEGIN" -v e="$END" '$0==b{f=1;next} $0==e{f=0} f&&/merge=derived/{n++} END{print n+0}' .gitattributes)"
