      <span class="text-sm text-gray-500 dark:text-gray-400">MIT licensed. Local-first: no server, no database, no telemetry.</span>
      <span class="font-mono text-xs text-gray-500 dark:text-gray-400">majordomus v$VERSION &middot; <a href="/site-manifest.json" class="hover:underline">generated from source</a></span>
    </div>
  </div>
</footer>

<script src="/assets/flowbite.min.js"></script>
<script src="/assets/theme.js"></script>
</body>
</html>
HTML
}

# ---------------------------------------------------------------- reusable blocks
# A monospace diagram taken verbatim from a canonical file. It stays monospace because
# the canonical source is ASCII art; it scrolls rather than reflows.
diagram_from() { # file, block number, caption
  printf '<figure class="my-6 overflow-x-auto rounded-lg border border-gray-200 bg-gray-50 p-5 dark:border-gray-700 dark:bg-gray-800/50">\n'
  printf '<pre class="font-mono text-xs leading-relaxed text-gray-700 dark:text-gray-300"><code>'
  codeblock "$1" "$2" | esc_html
  printf '</code></pre>\n'
  [ -n "${3:-}" ] && printf '<figcaption class="mt-4 text-sm text-gray-500 dark:text-gray-400">%s</figcaption>\n' "$3"
  printf '</figure>\n'
}

code_panel() { # caption, then body on stdin
  printf '<figure class="my-6 overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">\n'
  printf '<figcaption class="border-b border-gray-200 bg-gray-50 px-4 py-2 font-mono text-xs font-medium uppercase tracking-wider text-gray-500 dark:border-gray-700 dark:bg-gray-800/80 dark:text-gray-400">%s</figcaption>\n' "$1"
  printf '<div class="overflow-x-auto"><pre class="p-4 font-mono text-sm leading-relaxed text-gray-800 dark:text-gray-200"><code>'
  esc_html
  printf '</code></pre></div>\n</figure>\n'
}

section_head() { # eyebrow, heading, lead
  printf '<p class="mb-3 font-mono text-xs font-semibold uppercase tracking-widest text-blue-700 dark:text-blue-400">%s</p>\n' "$1"
  printf '<h2 class="mb-4 max-w-3xl text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl dark:text-white">%s</h2>\n' "$2"
  [ -n "${3:-}" ] && printf '<p class="mb-10 max-w-2xl text-gray-600 dark:text-gray-400">%s</p>\n' "$3"
  return 0
}

status_badge() { # guaranteed | advisory | planned
  case "$1" in
    guaranteed) printf '<span class="me-2 rounded-sm bg-green-100 px-2.5 py-0.5 font-mono text-xs font-medium text-green-800 dark:bg-green-900 dark:text-green-300">guaranteed</span>' ;;
    advisory)   printf '<span class="me-2 rounded-sm bg-yellow-100 px-2.5 py-0.5 font-mono text-xs font-medium text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300">advisory</span>' ;;
    planned)    printf '<span class="me-2 rounded-sm bg-gray-100 px-2.5 py-0.5 font-mono text-xs font-medium text-gray-800 dark:bg-gray-700 dark:text-gray-300">planned</span>' ;;
    *)          printf '<span class="me-2 rounded-sm bg-gray-100 px-2.5 py-0.5 font-mono text-xs font-medium text-gray-800 dark:bg-gray-700 dark:text-gray-300">%s</span>' "$1" ;;
  esac
}

# ---------------------------------------------------------------- homepage
build_home() {
  local out="$OUT/index.html"
  { page_open "/" "$SITE_NAME — a supervisory control layer for AI-assisted work" "$SOCIAL_DESC"

  # ---- 1. hero
  cat <<HTML
<section class="mx-auto max-w-screen-xl px-4 pb-14 pt-14 sm:pt-20">
  <div class="grid items-start gap-12 lg:grid-cols-2">
    <div>
      <span class="mb-5 inline-flex items-center rounded-sm bg-blue-100 px-2.5 py-0.5 font-mono text-xs font-medium text-blue-800 dark:bg-blue-900 dark:text-blue-300">v$VERSION &middot; portable shell, no runtime</span>
      <h1 class="mb-5 text-4xl font-extrabold leading-tight tracking-tight text-gray-900 sm:text-5xl dark:text-white">A supervisory control layer for AI-assisted work</h1>
      <p class="mb-6 max-w-xl text-lg text-gray-600 dark:text-gray-400">$HERO_LEAD</p>
      <div class="flex flex-wrap gap-3">
        <a href="$(c cta.primary_href)" class="inline-flex items-center rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
          $(c cta.primary)
          <svg class="ms-2 h-3.5 w-3.5 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/></svg>
        </a>
        <a href="$REPO_URL" class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-100 dark:border-gray-600 dark:bg-gray-800 dark:text-white dark:hover:bg-gray-700 dark:focus:ring-gray-700">$(c cta.secondary)</a>
      </div>
      <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-gray-200 pt-8 sm:grid-cols-4 dark:border-gray-700">
        <div><dt class="font-mono text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">Runtime</dt><dd class="mt-1 text-sm font-medium text-gray-900 dark:text-white">bash 3.2, git</dd></div>
        <div><dt class="font-mono text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">Server</dt><dd class="mt-1 text-sm font-medium text-gray-900 dark:text-white">none</dd></div>
        <div><dt class="font-mono text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">Network calls</dt><dd class="mt-1 text-sm font-medium text-gray-900 dark:text-white">none</dd></div>
        <div><dt class="font-mono text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">Licence</dt><dd class="mt-1 text-sm font-medium text-gray-900 dark:text-white">MIT</dd></div>
      </dl>
    </div>
    <div class="lg:pt-10">
HTML
  # The terminal transcript in the README's first fenced block: real output, not a mockup.
  code_panel "majordomus finish" < <(codeblock README.md 1)
  cat <<HTML
      <p class="text-sm text-gray-500 dark:text-gray-400">Output from the repository's own README. "Done" is a contract evaluated line by line, not a word a worker types.</p>
    </div>
  </div>
</section>
HTML

  # ---- 2. the problem
  printf '<section class="border-t border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-800/40">\n<div class="mx-auto max-w-screen-xl px-4 py-16 sm:py-20">\n'
  section_head "01 / The problem" "Most AI-assisted work fails for boring reasons" "$(c leads.problem)"
  printf '<div class="grid gap-px overflow-hidden rounded-lg border border-gray-200 bg-gray-200 sm:grid-cols-2 lg:grid-cols-3 dark:border-gray-700 dark:bg-gray-700">\n'
  # Failure modes are the sentences from the README's problem section, one card each.
  section README.md "The problem" 2 \
    | awk '/^- /{ if (buf != "") print buf; buf = substr($0, 3); next } /^  [^ ]/ && buf != ""{ sub(/^  /, "", $0); buf = buf " " $0; next } { if (buf != "") { print buf; buf = "" } } END { if (buf != "") print buf }' \
    | while IFS= read -r line; do
        printf '<div class="bg-white p-5 dark:bg-gray-800"><p class="text-sm text-gray-600 dark:text-gray-400">%s</p></div>\n' \
          "$(printf '%s\n' "$line" | md 0 1 | sed -e 's|^<p>$||' -e 's|^</p>$||' | tr '\n' ' ')"
      done
  printf '</div>\n'
  printf '<p class="mt-8 max-w-2xl text-gray-600 dark:text-gray-400">Better prompts do not fix any of this. These are operational-control problems.</p>\n'
  printf '</div>\n</section>\n'

  # ---- 3. core model
  printf '<section class="mx-auto max-w-screen-xl px-4 py-16 sm:py-20">\n'
  section_head "02 / The core model" "Majordomus supervises how work is executed" "$(c leads.model)"
  printf '<div class="grid gap-10 lg:grid-cols-2">\n<div>\n'
  diagram_from README.md 4 "The mental model, verbatim from the repository README."
  printf '</div>\n<div class="format dark:format-invert max-w-none">\n'
  # the diagram is rendered separately above, so the fenced block is dropped here
  section README.md "Mental model" 2 | awk '/^```/ { f = !f; next } !f' | md 0 3
  printf '</div>\n</div>\n</section>\n'

  # ---- 4. what it controls
  printf '<section class="border-t border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-800/40">\n<div class="mx-auto max-w-screen-xl px-4 py-16 sm:py-20">\n'
  section_head "03 / What it controls" "One responsibility per file, one directory in total" "$(c leads.controls)"
  printf '<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">\n'
  # Rows of the README's "What it does" table become Flowbite cards.
  section README.md "What it does" 2 \
    | awk -F'|' '/^\| \*\*/ { k=$2; v=$3; gsub(/^[ \t]+|[ \t]+$/,"",k); gsub(/^[ \t]+|[ \t]+$/,"",v); gsub(/\*\*/,"",k); print k "\t" v }' \
    | while IFS="$(printf '\t')" read -r key val; do
        printf '<div class="rounded-lg border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-gray-800">\n'
        printf '<h3 class="mb-2 text-base font-semibold tracking-tight text-gray-900 dark:text-white">%s</h3>\n' "$key"
        printf '<p class="text-sm text-gray-600 dark:text-gray-400">%s</p>\n</div>\n' \
          "$(printf '%s\n' "$val" | md 0 1 | sed -e 's|^<p>$||' -e 's|^</p>$||' | tr '\n' ' ')"
      done
  printf '</div>\n'
  printf '<p class="mt-8 text-sm text-gray-500 dark:text-gray-400">Every card above is backed by a case in <a href="%s/tree/master/test/cases/" class="font-medium text-blue-700 hover:underline dark:text-blue-400">test/cases/</a>. See <a href="/guarantees/" class="font-medium text-blue-700 hover:underline dark:text-blue-400">what is guaranteed and what is only advisory</a>.</p>\n' "$REPO_URL"
  printf '</div>\n</section>\n'

  # ---- 5. drop-in installation
  printf '<section class="mx-auto max-w-screen-xl px-4 py-16 sm:py-20">\n'
  section_head "04 / Drop-in installation" "Copy one directory, add one pointer" "$(c leads.install)"
  printf '<div class="grid gap-8 lg:grid-cols-2">\n<div>\n'
  code_panel "install into a project" <<'SH'
git clone https://github.com/korczis/prismatic-majordomus ~/majordomus
export PATH="$HOME/majordomus/bin:$PATH"

cd your-project
majordomus init      # writes .majordomus/ — policy, profiles, templates
majordomus update    # generates the instruction file each AI tool reads
majordomus doctor    # names the two hook lines you still need to add
SH
  printf '</div>\n<div>\n'
  code_panel "or copy the layer alone" <<'SH'
cp -R /path/to/.majordomus your-project/

# then point your AI instruction file at it:
#   ## Majordomus
#   Follow `.majordomus/README.md` for all non-trivial
#   AI-assisted work.
SH
  cat <<HTML
  <div class="rounded-lg border-s-4 border-blue-700 bg-blue-50 p-4 text-sm text-blue-900 dark:border-blue-500 dark:bg-blue-900/20 dark:text-blue-200" role="note">
    <strong class="font-semibold">That is enough for the policy layer.</strong> The directory and the pointer give every worker the same rules. The <code class="font-mono">majordomus</code> command adds the deterministic checks on top: without it you have documentation, with it you have enforcement that is verified to be wired.
  </div>
HTML
  printf '</div>\n</div>\n'
  printf '<p class="mt-8 max-w-2xl text-sm text-gray-500 dark:text-gray-400">Requirements: bash 3.2 or newer, git, and <code class="font-mono">sha256sum</code> or <code class="font-mono">shasum</code>. Nothing else is installed into your project.</p>\n'
  printf '</div>\n</section>\n'

  # ---- 6. how it works
  printf '<section class="border-t border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-800/40">\n<div class="mx-auto max-w-screen-xl px-4 py-16 sm:py-20">\n'
  section_head "05 / How it works" "Policy in, instructions out, state on disk" "One canonical policy is projected into whatever instruction file each tool reads. A task moves through a lifecycle that ends in a contract, not an opinion."
  printf '<div class="grid gap-8 lg:grid-cols-2">\n<div>\n'
  printf '<h3 class="mb-3 text-base font-semibold text-gray-900 dark:text-white">Projection</h3>\n'
  code_panel "policy.yaml is the only source" <<'TXT'
.majordomus/policy.yaml
         |
         |  majordomus update
         v
CLAUDE.md   AGENTS.md   GEMINI.md   generic Markdown
TXT
  printf '<p class="text-sm text-gray-600 dark:text-gray-400">Projections are generated, fingerprinted, and headed with the command that regenerates them. Adapters translate; they never add rules. A rule that exists for one provider and not another is a policy bug.</p>\n'
  printf '</div>\n<div>\n'
  printf '<h3 class="mb-3 text-base font-semibold text-gray-900 dark:text-white">Task lifecycle</h3>\n'
  code_panel "start to finish" <<'TXT'
majordomus start "<task>" --scope <paths> --profile <name>
      |
      v  claim normalised; overlap with other workers reported
      v  profile fixes effort, verbosity, context, verification
      |
   worker executes            (Majordomus is not involved)
      |
      v
majordomus check         state, scope, blockers, checkpoint age
      |
      +-- incomplete --> majordomus handover  (append-only record)
      |
      v
majordomus finish        contract evaluated; refuses if unmet
TXT
  printf '</div>\n</div>\n'
  printf '</div>\n</section>\n'

  # ---- 7. execution profiles
  printf '<section class="mx-auto max-w-screen-xl px-4 py-16 sm:py-20">\n'
  section_head "06 / Execution profiles" "Five axes, never collapsed into one quality dial" "$(c leads.profiles)"
  emit_profile_tabs
  printf '<p class="mt-8 max-w-2xl text-sm text-gray-500 dark:text-gray-400">Capability classes are not vendor model names; the projection tells the worker to pick the closest its environment offers. Add a profile by adding a file. Full detail: <a href="/profiles/" class="font-medium text-blue-700 hover:underline dark:text-blue-400">all profiles</a> and <a href="/docs/schemas/" class="font-medium text-blue-700 hover:underline dark:text-blue-400">the schema</a>.</p>\n'
  printf '</section>\n'

  # ---- 8. guaranteed vs advisory vs planned
  printf '<section class="border-t border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-800/40">\n<div class="mx-auto max-w-screen-xl px-4 py-16 sm:py-20">\n'
  section_head "07 / Guaranteed, advisory, planned" "What actually runs, and what is only written down" "$(c leads.claims)"
  emit_status_legend
  printf '<div class="grid gap-4 lg:grid-cols-3">\n'
  emit_status_column guaranteed "Guaranteed now" "Deterministic, implemented, and proven by a behavioural test."
  emit_status_column advisory "Advisory" "Projected into the worker's instructions. Nothing outside the worker can observe compliance."
  emit_status_column planned "Planned" "Specified and not implemented. Listed so omissions are visible rather than assumed."
  printf '</div>\n'
  printf '<p class="mt-8 text-sm text-gray-500 dark:text-gray-400">Full matrix with the source, the implementing file and the test for every row: <a href="/guarantees/" class="font-medium text-blue-700 hover:underline dark:text-blue-400">guarantees</a>.</p>\n'
  printf '</div>\n</section>\n'

  # ---- 9. design principles
  printf '<section class="mx-auto max-w-screen-xl px-4 py-16 sm:py-20">\n'
  section_head "08 / Design principles" "The sentences every worker reads" "These are projected into every generated instruction file, so a worker reading CLAUDE.md and a worker reading AGENTS.md are held to the same rules."
  printf '<ol class="grid gap-px overflow-hidden rounded-lg border border-gray-200 bg-gray-200 sm:grid-cols-2 dark:border-gray-700 dark:bg-gray-700">\n'
  section README.md "Core principles" 2 \
    | awk '/^- /{ print substr($0, 3) }' \
    | while IFS= read -r line; do
        printf '<li class="bg-white p-4 text-sm text-gray-700 dark:bg-gray-800 dark:text-gray-300">%s</li>\n' \
          "$(printf '%s\n' "$line" | md 0 1 | sed -e 's|^<p>$||' -e 's|^</p>$||' | tr '\n' ' ')"
      done
  printf '</ol>\n</section>\n'

  # ---- 10. what it is not
  printf '<section class="border-t border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-800/40">\n<div class="mx-auto max-w-screen-xl px-4 py-16 sm:py-20">\n'
  section_head "09 / What it is not" "The omissions are deliberate" "A supervisory layer that adds nouns becomes the thing it was meant to supervise. This list is maintained in the README so that readers can see what was refused rather than assume it was forgotten."
  printf '<ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">\n'
  section README.md "What this is not" 2 \
    | awk '/^- /{ print substr($0, 3) }' \
    | while IFS= read -r line; do
        printf '<li class="rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm text-gray-600 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400">%s</li>\n' \
          "$(printf '%s\n' "$line" | md 0 1 | sed -e 's|^<p>$||' -e 's|^</p>$||' | tr '\n' ' ')"
      done
  printf '</ul>\n</div>\n</section>\n'

  # ---- 11. quick start
  printf '<section class="mx-auto max-w-screen-xl px-4 py-16 sm:py-20">\n'
  section_head "10 / Quick start" "Three steps to a supervised repository" "$(c leads.quickstart)"
  cat <<HTML
<ol class="grid gap-8 md:grid-cols-3">
  <li>
    <span class="mb-3 inline-flex h-8 w-8 items-center justify-center rounded-full border border-gray-300 font-mono text-sm text-blue-700 dark:border-gray-600 dark:text-blue-400">1</span>
    <h3 class="mb-2 text-base font-semibold text-gray-900 dark:text-white">Install the command</h3>
    <p class="text-sm text-gray-600 dark:text-gray-400">Clone the repository and put <code class="font-mono">bin/</code> on your PATH. There is nothing to compile and no package to install.</p>
  </li>
  <li>
    <span class="mb-3 inline-flex h-8 w-8 items-center justify-center rounded-full border border-gray-300 font-mono text-sm text-blue-700 dark:border-gray-600 dark:text-blue-400">2</span>
    <h3 class="mb-2 text-base font-semibold text-gray-900 dark:text-white">Initialise and project</h3>
    <p class="text-sm text-gray-600 dark:text-gray-400"><code class="font-mono">majordomus init</code> writes <code class="font-mono">.majordomus/</code>; <code class="font-mono">majordomus update</code> generates the instruction file each tool reads from the one policy.</p>
  </li>
  <li>
    <span class="mb-3 inline-flex h-8 w-8 items-center justify-center rounded-full border border-gray-300 font-mono text-sm text-blue-700 dark:border-gray-600 dark:text-blue-400">3</span>
    <h3 class="mb-2 text-base font-semibold text-gray-900 dark:text-white">Wire the two hooks</h3>
    <p class="text-sm text-gray-600 dark:text-gray-400"><code class="font-mono">majordomus doctor</code> prints the exact lines, then proves they run and that neither swallows the exit code.</p>
  </li>
</ol>
<div class="mt-10 flex flex-wrap gap-3">
  <a href="/getting-started/" class="inline-flex items-center rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">Full walkthrough</a>
  <a href="/docs/cli/" class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-100 dark:border-gray-600 dark:bg-gray-800 dark:text-white dark:hover:bg-gray-700 dark:focus:ring-gray-700">CLI reference</a>
</div>
</section>
HTML
  page_close
  } > "$out"
}

# ---------------------------------------------------------------- profiles
# Flowbite tabs, per the canonical tabs markup: data-tabs-toggle on the tablist, explicit
# active and inactive classes, aria-controls and aria-selected on each tab, role=tabpanel
# with aria-labelledby on each panel. Without JavaScript every panel is a heading followed
# by its definition list, so the content is fully readable; the tabs only fold it.
emit_profile_tabs() {
  local p first=1
  printf '<div class="mb-5 border-b border-gray-200 dark:border-gray-700">\n'
  printf '<ul class="-mb-px flex flex-wrap gap-1 text-sm font-medium" id="profile-tabs" data-tabs-toggle="#profile-panels" data-tabs-active-classes="border-blue-700 text-blue-700 dark:border-blue-400 dark:text-blue-400" data-tabs-inactive-classes="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300" role="tablist">\n'
  for p in $PROFILES; do
    printf '<li role="presentation"><button class="inline-block rounded-t-lg border-b-2 px-4 py-2.5 font-mono" id="tab-%s" data-tabs-target="#panel-%s" type="button" role="tab" aria-controls="panel-%s" aria-selected="%s">%s</button></li>\n' \
      "$p" "$p" "$p" "$([ "$first" = 1 ] && echo true || echo false)" "$p"
    first=0
  done
  printf '</ul>\n</div>\n<div id="profile-panels">\n'
  first=1
  for p in $PROFILES; do
    printf '<div class="%s rounded-lg border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-gray-800" id="panel-%s" role="tabpanel" aria-labelledby="tab-%s">\n' \
      "$([ "$first" = 1 ] && echo "" || echo "hidden")" "$p" "$p"
    emit_profile_body "$p"
    printf '</div>\n'
    first=0
  done
  printf '</div>\n'
}

# Every value below is read from share/skeleton/profiles/<name>.yaml. Nothing here is
# hardcoded: change the YAML and this block changes.
emit_profile_body() {
  local p="$1" esc v ctx
  printf '<h3 class="mb-1 font-mono text-lg font-semibold text-gray-900 dark:text-white">%s</h3>\n' "$(pget "$p" name)"
  printf '<p class="mb-6 text-sm text-gray-600 dark:text-gray-400">%s</p>\n' "$(pget "$p" description | esc_html)"
  printf '<dl class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">\n'
  axis() { # label, value
    printf '<div><dt class="font-mono text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">%s</dt><dd class="mt-1 font-mono text-sm text-gray-900 dark:text-white">%s</dd></div>\n' "$1" "$2"
  }
  axis "Capability class" "$(pget "$p" capability)"
  v="$(pget "$p" effort)"
  [ -n "$(pget "$p" effort_escalation.to)" ] && \
    v="$v &rarr; $(pget "$p" effort_escalation.to) <span class=\"text-gray-500 dark:text-gray-400\">after $(pget "$p" effort_escalation.after_blocked_attempts) blocked</span>"
  axis "Reasoning effort" "$v"
  axis "Output verbosity" "$(pget "$p" verbosity)"
  axis "Presentation" "$(pget "$p" presentation)"
  axis "Checkpoint interval" "$(pget "$p" checkpoint_interval)"
  axis "Recent history depth" "$(pget "$p" context.recent_history_depth)"
  printf '</dl>\n'

  printf '<div class="mt-6 grid gap-6 sm:grid-cols-2">\n'
  printf '<div><h4 class="mb-2 font-mono text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">Context loaded</h4>\n<ul class="space-y-1 text-sm">\n'
  for ctx in task current_state decisions relevant_files failing_output architecture_notes; do
    v="$(pget "$p" "context.$ctx")"
    esc="$(printf '%s' "$ctx" | tr '_' ' ')"
    if [ "$v" = true ]; then
      printf '<li class="text-gray-900 dark:text-gray-100"><span class="me-2 font-mono text-green-700 dark:text-green-400" aria-hidden="true">+</span>%s</li>\n' "$esc"
    else
      printf '<li class="text-gray-400 dark:text-gray-500"><span class="me-2 font-mono" aria-hidden="true">&minus;</span>%s</li>\n' "$esc"
    fi
  done
  printf '</ul></div>\n'

  printf '<div><h4 class="mb-2 font-mono text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">Verification required</h4>\n<ul class="space-y-1 text-sm">\n'
  for ctx in verify_command_required regression_test_required decision_record_required; do
    v="$(pget "$p" "verification.$ctx")"
    esc="$(printf '%s' "$ctx" | sed -e 's/_required$//' -e 's/_/ /g')"
    case "$v" in
      true) printf '<li class="text-gray-900 dark:text-gray-100"><span class="me-2 font-mono text-green-700 dark:text-green-400" aria-hidden="true">+</span>%s</li>\n' "$esc" ;;
      false|'') printf '<li class="text-gray-400 dark:text-gray-500"><span class="me-2 font-mono" aria-hidden="true">&minus;</span>%s</li>\n' "$esc" ;;
      *) printf '<li class="text-gray-900 dark:text-gray-100"><span class="me-2 font-mono text-yellow-700 dark:text-yellow-400" aria-hidden="true">~</span>%s <span class="text-gray-500 dark:text-gray-400">(%s)</span></li>\n' "$esc" "$(printf '%s' "$v" | tr '_' ' ')" ;;
    esac
  done
  printf '</ul>\n'
  printf '<h4 class="mb-2 mt-4 font-mono text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">Output contract</h4>\n<p class="font-mono text-sm text-gray-900 dark:text-gray-100">%s</p>\n' \
    "$(mj_ylist "$(pflat "$p")" output_contract | tr '\n' ',' | sed -e 's/,$//' -e 's/,/, /g')"
  printf '</div>\n</div>\n'
}

# ---------------------------------------------------------------- claims
emit_status_legend() {
  cat <<'HTML'
<div class="mb-10 grid gap-px overflow-hidden rounded-lg border border-gray-200 bg-gray-200 sm:grid-cols-3 dark:border-gray-700 dark:bg-gray-700">
  <div class="bg-white p-5 dark:bg-gray-800">
    <span class="rounded-sm bg-green-100 px-2.5 py-0.5 font-mono text-xs font-medium text-green-800 dark:bg-green-900 dark:text-green-300">guaranteed</span>
    <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">Deterministic and blocking. Implemented, and a behavioural test proves it. If the check cannot decide, it fails.</p>
  </div>
  <div class="bg-white p-5 dark:bg-gray-800">
    <span class="rounded-sm bg-yellow-100 px-2.5 py-0.5 font-mono text-xs font-medium text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300">advisory</span>
    <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">Projected into the worker's instructions and validated as configuration. Whether a worker honours it is not observable from outside the worker. Documentation, not enforcement.</p>
  </div>
  <div class="bg-white p-5 dark:bg-gray-800">
    <span class="rounded-sm bg-gray-100 px-2.5 py-0.5 font-mono text-xs font-medium text-gray-800 dark:bg-gray-700 dark:text-gray-300">planned</span>
    <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">Specified and not implemented. Named here so that an omission is visible rather than assumed to be an oversight.</p>
  </div>
</div>
HTML
}

# a compact column of the claims with one status, for the homepage
emit_status_column() {
  local want="$1" title="$2" sub="$3" i=0 st
  printf '<div class="rounded-lg border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-gray-800">\n'
  printf '<div class="mb-1">%s</div>\n' "$(status_badge "$want")"
  printf '<h3 class="mb-1 text-base font-semibold text-gray-900 dark:text-white">%s</h3>\n' "$title"
  printf '<p class="mb-4 text-sm text-gray-500 dark:text-gray-400">%s</p>\n' "$sub"
  printf '<ul class="space-y-2 text-sm text-gray-700 dark:text-gray-300">\n'
  while [ "$i" -lt "$NCLAIMS" ]; do
    st="$(cl "$i" status)"
    [ "$st" = "$want" ] && printf '<li class="border-t border-gray-100 pt-2 first:border-0 first:pt-0 dark:border-gray-700">%s</li>\n' "$(cl "$i" claim | esc_html)"
    i=$((i + 1))
  done
  printf '</ul>\n</div>\n'
}

# ---------------------------------------------------------------- subpages
page_header() { # title, lead
  printf '<section class="border-b border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-800/40">\n'
  printf '<div class="mx-auto max-w-screen-xl px-4 py-12 sm:py-16">\n'
  printf '<h1 class="mb-3 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl dark:text-white">%s</h1>\n' "$1"
  printf '<p class="max-w-2xl text-lg text-gray-600 dark:text-gray-400">%s</p>\n' "$2"
  printf '</div>\n</section>\n'
}

breadcrumb() { # label, optional parent label|href
  printf '<nav class="mx-auto flex max-w-screen-xl px-4 pt-6" aria-label="Breadcrumb">\n<ol class="inline-flex items-center gap-1 text-sm md:gap-2">\n'
  printf '<li><a href="/" class="font-medium text-gray-600 hover:text-blue-700 dark:text-gray-400 dark:hover:text-white">Home</a></li>\n'
  if [ -n "${2:-}" ]; then
    printf '<li aria-hidden="true"><svg class="h-3 w-3 text-gray-400 rtl:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg></li>\n'
    printf '<li><a href="%s" class="font-medium text-gray-600 hover:text-blue-700 dark:text-gray-400 dark:hover:text-white">%s</a></li>\n' "${2#*|}" "${2%%|*}"
  fi
  printf '<li aria-hidden="true"><svg class="h-3 w-3 text-gray-400 rtl:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg></li>\n'
  printf '<li aria-current="page"><span class="font-medium text-gray-500 dark:text-gray-500">%s</span></li>\n' "$1"
  printf '</ol>\n</nav>\n'
}

# ---- /getting-started/
