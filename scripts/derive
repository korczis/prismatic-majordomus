#!/usr/bin/env bash
# derive — every committed derived artifact, regenerated from its canonical sources in
# dependency order. The one place the derivation graph is spelled out; `just derive` runs
# this, `scripts/derive-check` proves the result, and CI refuses a tree the check refuses.
#
#   stage A  majordomus generate       the registry's projections that depend on code alone:
#                                      docs/generated/{openapi,registry,cli}.{json,yaml},
#                                      docs/generated/{capabilities,cli}.md, modules/*.md,
#                                      share/allow/*.txt, and the provider bootstraps
#                                      (policy + templates); then scripts/rules-package
#                                      write: the rule package's manifest, its hashes and
#                                      the release it is stamped with (I1986)
#   stage B  scripts/generate-site-data the site's data and content, docs/SITE_CLAIMS.md and
#                                      docs/PLAN_STATUS.md, from the canonical files and from
#                                      stage A's registry.json and openapi.json
#   stage C  majordomus generate       the projections that read the index — the site's
#                                      registry dataset (site/data/registry/registry.json),
#                                      docs/generated/benchmarks.{md,json,yaml} and the
#                                      manifest docs/generated/artifacts.{json,yaml,md} —
#                                      over the tree stage B left, since the documents it
#                                      wrote are objects of the index
#
# No stage reads its own output; stage C's outputs are read by nothing but the site build.
# Running the whole thing twice changes nothing: the second pass is what derive-check
# compares against. docs/GITHUB_PAGES_ARCHITECTURE.md draws the graph.
#
# To run it on another machine the repository declares, in that machine's turn, and get the
# derived files back staged: `majordomus offload derive .` (docs/OFFLOAD.md).
#
#   MAJORDOMUS_BIN            the Rust executable to use instead of building one
#   MAJORDOMUS_BUILD_PROFILE  debug (default) or release
#   CARGO_TARGET_DIR          where cargo builds, when worktrees share one build directory
#
# One derive at a time per machine (project.one-derive-at-a-time). Every stage runs under the
# machine's derive lock, and a stopped derive takes its whole process tree with it:
#
#   scripts/derive --locked -- <command>...   run <command> under the same lock instead
#                                             (a full suite, a repair's own derive wrapper)
#   scripts/derive --orphans                  the orphans of this checkout's earlier derives
#                                             that a derive would stop; takes nothing
#   scripts/derive --preflight                the check a derive makes first: every file is
#                                             tracked or ignored (project.a-derive-sees-what-
#                                             the-commit-will); MAJORDOMUS_DERIVE_ALLOW_UNTRACKED=1
#                                             lets a derive run past it
#   (lib/machine_lock.sh lists the MAJORDOMUS_DERIVE_* variables that move or bound them)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CRATE="$ROOT/apps/majordomus-cli"
PROFILE="${MAJORDOMUS_BUILD_PROFILE:-debug}"
export MAJORDOMUS_SHARE="${MAJORDOMUS_SHARE:-$ROOT/share}"
# for mj_cargo_target_dir: cargo does not necessarily build into "$CRATE/target"
# shellcheck source=../lib/rust_bin.sh
. "$ROOT/lib/rust_bin.sh"

# Progress, on stderr. Stage B writes the whole site data set and runs the use-case scenarios;
# it says nothing at all while it does, and minutes of silence read as a hang — a session has
# already killed a healthy run for it. So each stage names itself as it begins and reports
# what it cost as it ends, which is also what tells the next person which stage is the slow
# one. stderr, because stdout belongs to whatever a caller redirects.
#
# Whole seconds from `date +%s`, the clock scripts/pages times its own steps with. The phase
# timers in lib/common.sh (mj_phase_begin) are a different instrument and not this one: they
# print nothing as a phase begins and report only at exit, under MJ_TIMING. That is what a
# profiler owes; it cannot break a silence while the silence is happening.
now() { date +%s; }
# Milliseconds as well, for the record below (I2521): a baseline that compares stages needs
# more than whole seconds, and the lock wait is kept apart from the work, since a derive that
# waited forty minutes for the lock did not cost forty minutes. Bash 5's EPOCHREALTIME where
# it exists; whole seconds times a thousand where it does not (bash 3.2), and the record says
# which clock it read.
if [ -n "${EPOCHREALTIME:-}" ]; then
  now_ms() { local t="${EPOCHREALTIME/[^0-9]/}"; printf '%s' "${t:0:${#t}-3}"; }; CLOCK=ms
else
  now_ms() { printf '%s000' "$(date +%s)"; }; CLOCK=s
fi
RUN_T0="$(now)"; RUN_T0_MS="$(now_ms)"; STAGE_T0=0; STAGE_T0_MS=0; STAGE=""; STAGES_JSON=""; LOCK_WAIT_MS=0
step()     { STAGE="$1"; STAGE_T0="$(now)"; STAGE_T0_MS="$(now_ms)"; printf '==> derive: %s ...\n' "$1" >&2; }
step_done() {
  local ms=$(( $(now_ms) - STAGE_T0_MS ))
  printf '==> derive: %s: %ss (%sms)\n' "$STAGE" "$(( $(now) - STAGE_T0 ))" "$ms" >&2
  STAGES_JSON="${STAGES_JSON:+$STAGES_JSON,}$(jq -cn --arg s "$STAGE" --argjson ms "$ms" '{stage: $s, ms: $ms}')"
}
# One JSON line per finished derive, appended to a file of this machine's, not of the
# repository: the measurements I2521 records are read from it, and it is never committed.
# MAJORDOMUS_DERIVE_TIMINGS moves it; an empty value turns the record off.
timings_record() {
  local file="${MAJORDOMUS_DERIVE_TIMINGS-${XDG_STATE_HOME:-$HOME/.local/state}/majordomus/derive-timings.jsonl}"
  [ -n "$file" ] || return 0
  mkdir -p "$(dirname "$file")" 2>/dev/null || return 0
  jq -cn --arg commit "$(git -C "$ROOT" rev-parse HEAD 2>/dev/null)" \
    --arg branch "$(git -C "$ROOT" symbolic-ref --short -q HEAD 2>/dev/null)" \
    --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg clock "$CLOCK" \
    --arg load "$(uptime 2>/dev/null | sed -n 's/.*load average[s]*: *//p')" \
    --arg binary "$([ -n "${BORROWED_BIN:-}" ] && echo borrowed || echo built)" \
    --argjson total "$(( $(now_ms) - RUN_T0_MS ))" --argjson lock_wait "$LOCK_WAIT_MS" \
    --argjson stages "[${STAGES_JSON}]" \
    '{schema: 1, at: $at, commit: $commit, branch: $branch, clock: $clock, load: $load,
      binary: $binary, total_ms: $total, lock_wait_ms: $lock_wait, stages: $stages}' \
    >> "$file" 2>/dev/null || true
}

# ---------------------------------------------------------------- one derive at a time
# The machine's derive lock, its priority marker, and a stop that takes the whole process tree
# down (project.one-derive-at-a-time). lib/machine_lock.sh says what each decides.
# shellcheck source=../lib/machine_lock.sh
. "$ROOT/lib/machine_lock.sh"
mj_lock_init "$ROOT" derive
mj_lock_traps
# The arguments are judged before anything else, so a mistyped flag is a usage error and never
# a refusal of the tree it happened to be typed in.
case "${1:-}" in
  ''|--locked|--orphans|--preflight) ;;
  *) printf 'usage: scripts/derive [--locked -- <command>... | --orphans | --preflight]\n' >&2; exit 2 ;;
esac
if [ "${1:-}" = --orphans ]; then
  [ $# = 1 ] || { printf 'usage: scripts/derive --orphans\n' >&2; exit 2; }
  trap - EXIT; mj_lock_orphans; exit 0
fi

# ---------------------------------------------------------------- what the commit will see
# A derive projects what git tracks: `majordomus generate` enumerates through the index
# (`--discovery vcs`, the layer's contract), and so does the site generator. A file the next
# commit adds is therefore invisible to it. The projections it writes leave that file out,
# and the commit that adds it is refused by the derived-current gate after the minutes the
# derive cost. On 2026-10-09 that cost a release two extra derives on a machine at load 40,
# and a memory note that already said "stage new files before derive" did not prevent it.
# So the derive refuses before it waits for the lock or builds anything
# (project.a-derive-sees-what-the-commit-will).
derive_preflight() {
  local untracked n
  untracked="$(git -C "$ROOT" ls-files --others --exclude-standard 2>/dev/null || true)"
  [ -n "$untracked" ] || return 0
  n="$(printf '%s\n' "$untracked" | wc -l | tr -d ' ')"
  if [ "${MAJORDOMUS_DERIVE_ALLOW_UNTRACKED:-}" = 1 ]; then
    printf '==> derive: %s untracked file(s) are invisible to this derive; going on because MAJORDOMUS_DERIVE_ALLOW_UNTRACKED=1\n' "$n" >&2
    return 0
  fi
  printf '==> derive: refused before anything ran: %s untracked file(s) are invisible to a derive,\n' "$n" >&2
  printf '    which projects only what git tracks, so the commit that adds them would be refused:\n' >&2
  printf '%s\n' "$untracked" | sed 's/^/      /' >&2
  printf '    git add each one (or ignore or remove it) and derive again;\n' >&2
  printf '    MAJORDOMUS_DERIVE_ALLOW_UNTRACKED=1 runs anyway\n' >&2
  exit 10
}
if [ "${1:-}" = --preflight ]; then
  [ $# = 1 ] || { printf 'usage: scripts/derive --preflight\n' >&2; exit 2; }
  derive_preflight; printf '==> derive: preflight clean; every file is tracked or ignored\n' >&2; exit 0
fi
[ "${1:-}" = --locked ] || derive_preflight

LOCK_T0_MS="$(now_ms)"
mj_lock_acquire
LOCK_WAIT_MS=$(( $(now_ms) - LOCK_T0_MS ))
mj_lock_reap_orphans
if [ "${1:-}" = --locked ]; then
  shift; [ "${1:-}" = -- ] && shift
  [ $# -gt 0 ] || { printf 'usage: scripts/derive --locked -- <command>...\n' >&2; exit 2; }
  rc=0; mj_lock_run "$@" || rc=$?
  exit "$rc"
fi
[ $# = 0 ] || { printf 'usage: scripts/derive [--locked -- <command>... | --orphans | --preflight]\n' >&2; exit 2; }

# Which executable is about to rewrite every committed artifact, said out loud. A derivation
# run with a borrowed binary looks exactly like one that built its own, and on 2026-09-10 a
# borrowed one of an older generation removed 16,625 lines from a pristine origin/master
# without a word. The executable refuses that now (`majordomus generate` compares its
# generation against the tree's), but a run that names what it is using is a run whose log
# answers "which binary?" without anyone having to guess.
if [ -n "${MAJORDOMUS_BIN:-}" ]; then RB="$MAJORDOMUS_BIN"; BORROWED_BIN=1
  printf '==> derive: MAJORDOMUS_BIN=%s (not building; it must be of this tree'"'"'s generation)\n' "$RB" >&2
else
  # a machine-wide rustflags profile can make a dev build refuse to link; the crate sets none.
  # Not --locked: after `release bump` the manifest is the one authored change, the bump has
  # kept the lock's own entry in step, and this build is what re-derives anything else cargo
  # records from it. Stage A then projects share/version.txt and every generator stamp.
  mj_rust_space_check "$ROOT" "the build this derivation needs" || exit 12
  step "building the Rust executable ($PROFILE)"
  release=(); [ "$PROFILE" = release ] && release=(--release)
  RUSTFLAGS='' mj_lock_run mj_cargo_bounded "$ROOT" build --quiet --manifest-path "$CRATE/Cargo.toml" "${release[@]}"
  # ask cargo where it put the result rather than compose it: a run that then spends ten
  # minutes can afford the 80ms, and the composed path is what exits 127 under a shared
  # CARGO_TARGET_DIR — the executable is in the shared directory, not under the worktree
  RB="$(mj_cargo_target_dir "$CRATE" ask-cargo)/$PROFILE/majordomus"
  step_done
fi
# Every later stage uses this executable, including the use-case scenarios stage B runs
# through the shell tool: without the export a scenario finds an executable only when the
# caller happened to set MAJORDOMUS_BIN (CI does, a laptop does not), and the evidence it
# publishes would differ between the two.
MAJORDOMUS_BIN="$RB"; export MAJORDOMUS_BIN
step "stage A: majordomus generate (code-only projections)"
# --strict: an error diagnostic must not pass for success. A duplicate identity excludes
# every claimant and the index goes on without them, so without this a derivation writes
# projections from a tree that has silently lost documents, and says nothing.
#
# Exit 15 is the executable refusing the tree: it is not of this tree's generation and
# would have rewritten every artifact from a model the tree does not have. Nothing was
# written. The refusal is repeated here because a `set -e` abort in the middle of a
# multi-stage script reads as a crash, and the remedy is the opposite of the reflex.
# `rc=0; cmd || rc=$?` and not `if ! cmd`: after `!` inverts a pipeline, `$?` inside the
# branch is the inverted status — 0 — and the script would exit 0 on a refusal.
rc=0
mj_lock_run "$RB" generate --repo "$ROOT" --strict >/dev/null || rc=$?
if [ "$rc" != 0 ]; then
  # a full `if` and not `[ ... ] && printf`: under `set -e` the failing test would end the
  # script with status 1 before the `exit` below could carry the real code out
  if [ "$rc" = 15 ]; then
    printf '==> derive: refused before anything was written; the executable, not the tree, is out of date\n' >&2
  fi
  exit "$rc"
fi
# The rule package's manifest: the hash of every rule file and the release the package ships
# in. A bump that left it alone shipped a package labelled with an older release (I1986). It
# reads the crate manifest, so it is current even before the projections above caught up; and
# it runs after the generator accepted the tree, so a refusal still writes nothing.
mj_lock_run "$ROOT/scripts/rules-package" write >/dev/null
step_done
step "stage B: scripts/generate-site-data (site data, content, derived documents)"
mj_lock_run "$ROOT/scripts/generate-site-data"
step_done
step "stage C: majordomus generate (the site dataset and the benchmark matrix over the index)"
mj_lock_run "$RB" generate --repo "$ROOT" --strict >/dev/null
step_done
step "stage D: scripts/gitattributes (the merge policy, from the generators)"
# Last, because it reads stage A's artifact manifest and stage B's published content tree:
# the set of files a merge must not try to merge is exactly the set the stages above write,
# and until this ran it was a hand list that was wrong in both directions.
mj_lock_run "$ROOT/scripts/gitattributes" >/dev/null
step_done
timings_record
printf '==> derive: done in %ss (lock wait %sms apart); scripts/derive-check proves it\n' "$(( $(now) - RUN_T0 ))" "$LOCK_WAIT_MS" >&2
