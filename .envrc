# direnv, for whoever works in this repository. `direnv allow` once, and entering the
# directory puts the tool on the path, exports what a shell here needs, says where things
# are, and brings this repository's runtime up when nothing is serving it yet.
#
# This file is an adapter and nothing else. It reads nothing about the repository — no
# git, no grep, no find, no sed, no awk, no jq, no curl, no pid, no port — it builds
# nothing, and it starts nothing itself. Every fact it shows and every decision it takes
# belongs to `majordomus env enter`, which is where such things are decided once and where
# they are typed, tested, benchmarked and served to every other surface. A pipeline here
# would be a second implementation of that, running on every `cd`, with nobody testing it.
# The rule `project.envrc-is-an-adapter` holds this shut; `project.entry-converges` says
# what entry may start; ADR 0043 is why entry may start anything at all.
#
#   MAJORDOMUS_BANNER=off      no banner; `full` and `compact` fix the form
#   MAJORDOMUS_RUNTIME=off     enter without bringing the runtime up
#   MAJORDOMUS_BUILD_PROFILE   which build of the executable to use (debug, release)
#   NO_COLOR, CI               plain output, and under CI no banner at all
#
# `just env` prints the whole snapshot; `just env-explain` says where each value came from.

# The task lifecycle tool. The Rust executable is not put on the path: it shares the name
# `majordomus` with this one, and two different programs under one name on PATH is a trap.
PATH_add bin

# Re-evaluate when this repository's shared server comes up or goes away, so that the
# addresses in the environment and in the banner are true rather than merely recent. It is
# also the other half of not waiting: an entry that starts a server returns before that
# server has published an address, and this is what brings the address in when it does.
watch_file .ai/local/state/mcp/server.json

# One call, one entry. The assignments go to stdout for `eval`, the banner to stderr —
# stderr because direnv reads an .envrc's stdout as the environment it is applying — the
# workflow bridge is refreshed when a declaration behind it moved, and the runtime is
# ensured when nothing answers for this checkout. Which of those are worth doing, how much
# each costs and when each may be skipped is the executable's to decide, not this file's;
# two calls would be two `git status` runs, which is most of the cost of entering a
# repository, and a decision taken here would be a decision nothing tests.
eval "$(bin/majordomus-env enter --shell direnv)"

# Machine-local secrets and overrides, never committed. Last, so a value here wins
# over the snapshot above. Still within the adapter rule: this reads nothing about
# the repository, only what the person on this machine chose to export.
source_env_if_exists .envrc.local
