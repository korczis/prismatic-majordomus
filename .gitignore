# editor and OS noise
.DS_Store
*.swp
*~

# Temporary artifacts, data, directories, files...
/.local/
/.tmp/
/tmp/

# test scratch
/test/tmp/

# site build dependencies (not part of the CLI)
node_modules

# derived site, rebuilt by scripts/generate-site-data and scripts/site-build
# (site/static/images/ is copied from assets/ at build but committed, so it stays tracked)
#
# site/content/ is NOT here. The derived content is a projection of the same canonical inputs
# as site/data/generated, produced by the same generator in the same run, and it is committed
# for the same reason: the publication path renders what is committed rather than regenerating
# it (docs/GITHUB_PAGES_PERFORMANCE.md — the fast path's build budget is 20 s and a generation
# costs twice that). `scripts/generate-site-data --check` diffs it exactly as it diffs the data,
# so a stale page is refused by the same gate that refuses stale data.
site/public/
site/static/app.css
site/static/openapi.json
site/static/build.json
site/data/build.json
site/static/js/
site/static/syntax-*.css

# transient staging for scripts/generate-site-data (removed on exit)
.mj-stage.*/

# The checkout-local half of the AI layer: the active task, the ledger, checkpoints,
# handovers, sessions, local decisions and open questions, caches and working contexts.
# It belongs to this machine and this checkout; a fresh clone starts without it by design,
# and nothing under it is ever normative. majordomus init adds this line once.
.ai/local/

# personal Claude Code settings; the shared ones, including the capture hook, are tracked
.claude/settings.local.json
