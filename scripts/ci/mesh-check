#!/usr/bin/env bash
# mesh-check — the mesh stays one subsystem: sockets, links and the journal under
# src/mesh/, one registry, surfaces that ask the mesh capabilities, and a declaration whose
# kind, schema and rules exist together.
#
# ADR 0050 gives network discovery boundaries a grep can hold, and ADR 0067 extends them to
# cooperation: the crate opens UDP sockets only inside apps/majordomus-cli/src/mesh/ (a
# socket anywhere else is a second discovery mechanism growing outside the provider
# contract); the one peer store is mesh::registry::MeshRegistry and the one journal is
# mesh::journal::Journal, each constructed only inside the mesh module (a second
# construction site is a second truth about who exists or what was claimed); a link
# transport is implemented and a link message is answered only by the mesh module and the
# mesh capability module (a handler elsewhere is a second admission path that skips the
# handshake's checks); no Cockpit page reads the mesh runtime directly (a page that does
# can show a connection state no capability answers); and the `mesh` declaration's kind,
# schema and rules move together. What a grep cannot hold — that a refused hello links
# nothing, that a claim excludes everywhere — lives in the tests the rules
# project.mesh-is-observation-not-authority and project.mesh-cooperation-is-authenticated
# name, not here.
#
#   scripts/ci/mesh-check                report; exit 10 on a finding
#   MJ_ROOT=<dir> scripts/ci/mesh-check  measure another tree
#
# Exempt by kind: documentation (*.md, docs/, site/, .ai/) describes the mesh and opens
# nothing; the crate's tests (apps/majordomus-cli/tests/) may bind sockets, implement a
# transport or construct a journal to prove behaviour — the subject under test is not a
# second mechanism.

set -euo pipefail

root="${MJ_ROOT:-$(git rev-parse --show-toplevel)}"
crate="apps/majordomus-cli/src"
fail=0

finding() {
  printf 'mesh-check: FAIL %s\n' "$1"
  fail=1
}

# Files of the crate's source (not its tests) that match an extended pattern.
matching() {
  (cd "$root" && grep -rlE "$1" "$crate" --include='*.rs' 2>/dev/null || true)
}

# 1. UDP sockets only under src/mesh/.
while IFS= read -r file; do
  [ -n "$file" ] || continue
  case "$file" in
    "$crate"/mesh/*) ;;
    *) finding "$file opens a UDP socket outside $crate/mesh/ — a discovery transport belongs behind the provider contract" ;;
  esac
done < <(matching 'UdpSocket')

# 2. One registry and one journal, constructed inside the mesh module alone.
while IFS= read -r file; do
  [ -n "$file" ] || continue
  case "$file" in
    "$crate"/mesh/*) ;;
    *) finding "$file constructs MeshRegistry — the one peer store is built inside src/mesh/ and reached through the runtime" ;;
  esac
done < <(matching 'MeshRegistry::new')
while IFS= read -r file; do
  [ -n "$file" ] || continue
  case "$file" in
    "$crate"/mesh/*) ;;
    *) finding "$file opens a mesh Journal — the one journal of a runtime is opened by mesh::cooperation and reached through it" ;;
  esac
done < <(matching 'Journal::open')

# 3. Link transports and link handlers only in the mesh module and its capability module.
while IFS= read -r file; do
  [ -n "$file" ] || continue
  case "$file" in
    "$crate"/mesh/*) ;;
    *) finding "$file implements LinkTransport — a link travels through the transports of src/mesh/, or it skips the handshake's checks" ;;
  esac
done < <(matching 'impl LinkTransport for')
while IFS= read -r file; do
  [ -n "$file" ] || continue
  case "$file" in
    "$crate"/mesh/*|"$crate"/capability/builtin/mesh.rs) ;;
    *) finding "$file answers a link message — admission is mesh::cooperation's, projected by the mesh capability module alone" ;;
  esac
done < <(matching '\.accept_(hello|sync)\(')

# 4. The Cockpit renders mesh state through the mesh capabilities, never the runtime.
while IFS= read -r file; do
  [ -n "$file" ] || continue
  finding "$file reads the mesh runtime directly — a Cockpit page asks mesh.status, mesh.peers, mesh.state or mesh.cooperation, so it cannot show a state no capability answers"
done < <(cd "$root" && grep -rlE 'ctx\.mesh\b|\.cooperation\(\)' "$crate/cockpit" --include='*.rs' 2>/dev/null || true)
for capability in mesh.status mesh.peers mesh.state mesh.cooperation; do
  grep -q "\"$capability\"" "$root/$crate/cockpit/pages.rs" 2>/dev/null \
    || finding "the Cockpit's mesh page does not ask $capability — the page is a projection of the mesh capabilities"
done

# 5. The declaration's kind, schema and rules exist together.
kind_declared=0
grep -q '^  mesh-declaration:' "$root/share/kinds.yaml" 2>/dev/null && kind_declared=1
schema_present=0
[ -f "$root/share/schemas/majordomus/mesh-declaration/mesh-declaration.v1.schema.json" ] && schema_present=1
rules_present=0
[ -f "$root/.ai/repo/rules/project/mesh-is-observation-not-authority.v1.md" ] \
  && compgen -G "$root/.ai/repo/rules/project/mesh-cooperation-is-authenticated.v*.md" >/dev/null \
  && rules_present=1
cooperation_schema=0
grep -q '"cooperation"' "$root/share/schemas/majordomus/mesh-declaration/mesh-declaration.v1.schema.json" 2>/dev/null && cooperation_schema=1
if [ "$kind_declared$schema_present$rules_present$cooperation_schema" != "1111" ]; then
  finding "the mesh declaration is incomplete: kind=$kind_declared schema=$schema_present rules=$rules_present cooperation-schema=$cooperation_schema — the kind in share/kinds.yaml, its schema (with the cooperation section) and both rules move together"
fi

# 6. Every repository `majordomus init` creates can read its mesh declaration: the
#    skeleton's source classes carry the mesh-declaration class. Without it the kind, the
#    schema and the rules exist and no repository but this one ever discovers a declaration.
grep -q 'kind: mesh-declaration' "$root/share/skeleton/ai/repo/knowledge/sources.yaml" 2>/dev/null \
  || finding "share/skeleton/ai/repo/knowledge/sources.yaml has no mesh-declaration class — an initialised repository would never read .ai/repo/mesh/*.yaml"

# 7. No committed declaration trusts on first use (I2135). The runtime honours `tofu` only
#    from the trunk's committed copy, so the trunk is the one place it could still arrive
#    from: a key nobody listed would be trusted by every runtime of the repository. A
#    declaration that needs it for a test writes it in that test's fixture, never here.
while IFS= read -r declared; do
  [ -n "$declared" ] || continue
  if grep -Eq '^[[:space:]]+policy:[[:space:]]*tofu([[:space:]]|$)' "$root/$declared"; then
    finding "$declared sets trust.policy tofu — a committed declaration trusts no key it does not list; use deny_unknown and list each machine's key"
  fi
done <<EOF
$(cd "$root" && git ls-files -- '.ai/repo/mesh/*.yaml' 2>/dev/null)
EOF

# 8. Every field the mesh carries is listed, and the list says whether it is redacted before
#    signing (I2708). An event body is signed into the journal and replicated in clear to every
#    linked runtime, so a field added to EventBody — or to a brace struct of journal.rs that a
#    variant carries, followed transitively — reaches every machine unless .ai/repo/ci/
#    mesh-event-fields.yaml names it as `redacted` or `clear`. The check runs both ways: an
#    entry for a field the source no longer has fails too, or the list drifts into fiction.
#    It reads rustfmt's layout (variants at four spaces, their fields at eight; struct fields
#    at four), and a journal it cannot read is a finding, never a clean tree.
journal="$crate/mesh/journal.rs"
field_list=".ai/repo/ci/mesh-event-fields.yaml"
carried_fields=0
redacted_fields=0

# enum_fields <file> <enum>: "<enum>.<Variant>.<field><TAB><type>" per named variant field,
# "#found" once the enum is seen, "#tuple <Variant>" for a variant whose fields have no names
enum_fields() {
  awk -v name="$2" '
    $0 ~ "^pub enum " name " [{]" { inside = 1; print "#found"; next }
    !inside { next }
    /^}/ { exit }
    /^    [A-Z][A-Za-z0-9]*[(]/ { v = $1; sub(/[(].*/, "", v); print "#tuple " v; next }
    /^    [A-Z][A-Za-z0-9]* [{]/ { variant = $1; next }
    /^    [}]/ { variant = ""; next }
    variant != "" && /^        [a-z_][a-z0-9_]*: / {
      field = $1; sub(/:$/, "", field)
      type = $0; sub(/^[^:]*: /, "", type); sub(/,[[:space:]]*$/, "", type)
      printf "%s.%s.%s\t%s\n", name, variant, field, type
    }
  ' "$1"
}

# struct_fields <file> <struct>: "<struct>.<field><TAB><type>" per field of a brace struct,
# "#found" once the struct is seen; nothing for a type the file does not declare that way
struct_fields() {
  awk -v name="$2" '
    $0 ~ "^pub struct " name " [{]" { inside = 1; print "#found"; next }
    !inside { next }
    /^}/ { exit }
    /^    (pub(\([a-z:]+\))? )?[a-z_][a-z0-9_]*: / {
      line = $0; sub(/^    (pub(\([a-z:]+\))? )?/, "", line)
      field = line; sub(/:.*/, "", field)
      type = line; sub(/^[^:]*: /, "", type); sub(/,[[:space:]]*$/, "", type)
      printf "%s.%s\t%s\n", name, field, type
    }
  ' "$1"
}

carried=""
[ -f "$root/$journal" ] && carried="$(enum_fields "$root/$journal" EventBody)"
if [ "${carried%%$'\n'*}" != "#found" ]; then
  finding "$journal is missing or declares no EventBody — the gate cannot read the fields the mesh carries, so it cannot say they are listed"
elif [ ! -f "$root/$field_list" ]; then
  finding "$field_list is missing — every field an EventBody carries is listed there as redacted or clear before the mesh may sign it"
else
  while IFS= read -r variant; do
    [ -n "$variant" ] || continue
    finding "EventBody::$variant carries unnamed fields — a variant names its fields, so each can be listed in $field_list"
  done < <(printf '%s\n' "$carried" | sed -n 's/^#tuple //p')
  carried="$(printf '%s\n' "$carried" | grep -v '^#' || true)"
  # follow every type a carried field names that journal.rs declares as a brace struct
  seen=" "
  queue="$(printf '%s\n' "$carried" | cut -f2 | grep -oE '[A-Z][A-Za-z0-9]*' | tr '\n' ' ' || true)"
  while [ -n "${queue// /}" ]; do
    next_queue=""
    for type in $queue; do
      case "$seen" in *" $type "*) continue ;; esac
      seen="$seen$type "
      found="$(struct_fields "$root/$journal" "$type")"
      case "$found" in "#found"*) ;; *) continue ;; esac
      found="$(printf '%s\n' "$found" | grep -v '^#' || true)"
      [ -n "$found" ] || continue
      carried="$carried"$'\n'"$found"
      next_queue="$next_queue $(printf '%s\n' "$found" | cut -f2 | grep -oE '[A-Z][A-Za-z0-9]*' \
        | tr '\n' ' ' || true)"
    done
    queue="$next_queue"
  done

  # the list: "  <Type>.<path>: <value>" under `fields:`, comments and blank lines ignored
  listed="$(awk '
    /^fields:/ { inside = 1; next }
    inside && /^[^[:space:]#]/ { inside = 0 }
    !inside || /^[[:space:]]*(#|$)/ { next }
    {
      line = $0; sub(/[[:space:]]+#.*/, "", line); sub(/^[[:space:]]+/, "", line)
      key = line; sub(/:.*/, "", key)
      value = line; sub(/^[^:]*:[[:space:]]*/, "", value); sub(/[[:space:]]+$/, "", value)
      printf "%s\t%s\n", key, value
    }
  ' "$root/$field_list")"

  carried_keys="$(printf '%s\n' "$carried" | cut -f1 | grep . | LC_ALL=C sort -u || true)"
  listed_keys="$(printf '%s\n' "$listed" | cut -f1 | grep . | LC_ALL=C sort || true)"
  carried_fields="$(printf '%s\n' "$carried_keys" | grep -c . || true)"
  while IFS= read -r key; do
    [ -n "$key" ] || continue
    finding "$key is carried by the mesh and not listed in $field_list — list it as redacted or clear: whether its value passes redaction::redact_secrets before the event is signed and replicated to every linked runtime"
  done < <(LC_ALL=C comm -23 <(printf '%s\n' "$carried_keys") <(printf '%s\n' "$listed_keys" | LC_ALL=C sort -u))
  while IFS= read -r key; do
    [ -n "$key" ] || continue
    finding "$field_list lists $key, which the mesh no longer carries — remove the entry, or the list describes a field nobody can find"
  done < <(LC_ALL=C comm -13 <(printf '%s\n' "$carried_keys") <(printf '%s\n' "$listed_keys" | LC_ALL=C sort -u))
  while IFS= read -r key; do
    [ -n "$key" ] || continue
    finding "$field_list lists $key more than once — one field, one decision"
  done < <(printf '%s\n' "$listed_keys" | uniq -d)
  while IFS=$'\t' read -r key value; do
    [ -n "$key" ] || continue
    case "$value" in
      redacted) redacted_fields=$((redacted_fields + 1)) ;;
      clear) ;;
      *) finding "$field_list lists $key as \"$value\" — an entry says redacted or clear, so the field is decided" ;;
    esac
  done <<<"$listed"
fi

if [ "$fail" -ne 0 ]; then
  exit 10
fi
printf 'mesh-check: OK   sockets, links and the journal under src/mesh/, one registry, capability-projected surfaces, declaration complete, no committed tofu, every EventBody field listed (%s carried, %s redacted before signing)\n' \
  "$carried_fields" "$redacted_fields"
