#!/usr/bin/env bash
# development-semantics-check — the rule project.development-semantics-are-canonical,
# as far as tracked data can decide it.
#
# A development semantic — the plan, tasks, sessions, context, executions, peers, evidence,
# obligations, completion — belongs to the capability registry of the Rust executable, and
# every surface consumes it. This gate decides the two halves of that a file read can
# decide, and is deliberately silent about the half it cannot (see WHAT THIS CANNOT DECIDE).
#
#   scripts/development-semantics-check              report; exit 0 clean, 10 with findings
#   scripts/development-semantics-check --json       the findings as JSON
#   scripts/development-semantics-check --baseline   retire the baseline entries that are closed
#   ... --baseline --accept <key>                    and take <key> on as accepted debt
#
# BACKING. A command declared in share/commands.yaml that mutates a development object tree
# is owed a mutating capability in the registry projection docs/generated/registry.json. A
# command with none is unbacked: no machine surface has a typed input schema to execute it
# from, so a surface that wants the semantic must reimplement it. Every unbacked command
# today is recorded in the baseline as "backing:<command>"; one that is not is a regression.
#
# SURFACE PURITY. The Cockpit renders capability output. A path into the AI layer, or the
# name of a majordomus executable, inside apps/majordomus-cli/src/cockpit/** or
# share/cockpit/** is a second implementation starting, and is reported as
# "surface:<path>:<evidence>:<hash>".
#
# A FINDING KEY IS AN IDENTITY, NOT A COORDINATE. The surface key used to end in a line
# number, and a line number is the one property of a finding that unrelated work changes.
# Any edit above a baselined line re-reported already-accepted debt as a new regression:
# one unchanged line of cockpit/pages.rs was simultaneously a regression at :2173 and a
# stale baseline entry at :1787, and a ratchet that cannot survive an edit elsewhere in the
# file teaches everyone to ignore it. The key is now the file that carries the offending
# text, the evidence token a reader needs, and sha256 of the line with its whitespace
# normalised — stable under movement and reindentation, and changed by an edit to the
# offending line itself, which is the event that needs re-review.
#
# WHAT THIS CANNOT DECIDE. Whether a derivation inside a surface is a semantic or a
# presentation choice: a template that pluralises a count is not a second implementation and
# a template that computes readiness is. A gate that guessed would be unauditable, so this
# one does not, and a reviewer decides it — exactly as majordomus.decision-threshold leaves
# its own threshold to a reviewer. Nor does it decide who writes a development object: a
# write in shell has no reliable syntactic shape, and a grep for the object trees would
# report every reader. That check would need the writers declared as data — the `writes`
# field of share/commands.yaml extended to name the writing function — and is left open.
#
# The baseline is .ai/repo/development-semantics-baseline.txt, one finding key per line. A
# finding in it is known debt and does not fail; one that is not is a regression and does;
# a baseline line that matches nothing is reported so the ratchet tightens instead of
# rotting. The baseline may shrink and may not grow, and --baseline enforces that rather
# than asserting it: it writes back what was already accepted and is still found, so
# regenerating retires closed debt and cannot launder a live regression. Taking a new key
# on is --accept, one key at a time, in a commit that says on what grounds ADR 0040 permits
# it to stay.
set -eu
set -o pipefail

# The gate is part of the tool; the tree it measures is the one under test. They are not
# always the same tree — the case that proves this gate can fail drives it over a fixture
# repository — so the gate is located from this script and the model from MJ_ROOT, exactly
# as scripts/ci/github-check already does. A gate that cannot be shown to fail is
# decoration, and this one had no case at all while its key was generating false
# regressions.
SELF="$(cd "$(dirname "$0")" && pwd)"
ROOT="${MJ_ROOT:-$(cd "$SELF/.." && pwd)}"
BASELINE="$ROOT/.ai/repo/development-semantics-baseline.txt"
COMMANDS="$ROOT/share/commands.yaml"
REGISTRY="$ROOT/docs/generated/registry.json"
JSON=0; WRITE=0
ACCEPTED="$(mktemp "${TMPDIR:-/tmp}/mj-devsem-acc.XXXXXX")"
while [ $# -gt 0 ]; do
  case "$1" in
    --json) JSON=1; shift ;;
    --baseline) WRITE=1; shift ;;
    --accept)
      [ $# -ge 2 ] || { echo "development-semantics-check: --accept needs a finding key" >&2; exit 2; }
      printf '%s\n' "$2" >> "$ACCEPTED"; WRITE=1; shift 2 ;;
    --help|-h) sed -n '2,52p' "$0"; exit 0 ;;
    *) echo "development-semantics-check: unknown option $1" >&2; exit 2 ;;
  esac
done

cd "$ROOT"
for f in "$COMMANDS" "$REGISTRY"; do
  [ -f "$f" ] || { echo "development-semantics-check: missing $f" >&2; exit 12; }
done

FOUND="$(mktemp "${TMPDIR:-/tmp}/mj-devsem.XXXXXX")"
trap 'rm -f "$FOUND" "$FOUND.new" "$FOUND.stale" "$FOUND.known" "$FOUND.files" "$FOUND.allowed" "$FOUND.write" "$FOUND.open" "$ACCEPTED"' EXIT

# --- backing ---------------------------------------------------------------------------
# The object trees a development semantic owns. A command that writes one of these is
# moving development state and is owed a capability.
DEV_TREES='.ai/repo/project/ .ai/repo/sessions/ .ai/repo/adrs/ .ai/local/state/'

python3 - "$COMMANDS" "$REGISTRY" "$DEV_TREES" >>"$FOUND" <<'PY'
import json, re, sys

commands_path, registry_path, trees = sys.argv[1], sys.argv[2], sys.argv[3].split()

text = open(commands_path, encoding='utf-8').read()
start = re.search(r'^commands:\s*$', text, re.M)
if not start:
    sys.exit('development-semantics-check: share/commands.yaml has no commands: block')
block = text[start.end():]

# One entry per "  - id: <name>"; fields are the flat two-space keys under it.
entries = []
for m in re.finditer(r'^  - id: (\S+)\n((?:    \S.*\n|    \n)*)', block, re.M):
    fields = {}
    for line in m.group(2).splitlines():
        f = re.match(r'    ([a-z_]+): (.*)$', line)
        if f:
            fields[f.group(1)] = f.group(2).strip()
    entries.append((m.group(1), fields))

registry = json.load(open(registry_path, encoding='utf-8'))
# A mutating capability is one the registry declares as a command rather than a query.
mutating_modules = {
    c.get('module')
    for c in registry.get('capabilities', [])
    if c.get('kind') == 'command'
}

for name, fields in entries:
    if fields.get('visibility') != 'public':
        continue
    if fields.get('class', 'read-only') == 'read-only':
        continue
    writes = fields.get('writes', '')
    if not any(tree in writes for tree in trees):
        continue
    if name in mutating_modules:
        continue
    print(f'backing:{name}')
PY

# --- surface purity --------------------------------------------------------------------
# The Cockpit trees render capability output. A layer path or an executable name in them is
# a semantic about to be implemented in the wrong place.
# The file list goes through a file, not a pipe: `python3 -` takes its program on stdin, so
# a heredoc and a pipe cannot both be stdin, and the pipe loses.
git ls-files -- 'apps/majordomus-cli/src/cockpit' 'share/cockpit' 2>/dev/null > "$FOUND.files" || true

python3 - "$FOUND.files" >>"$FOUND" <<'PY'
import hashlib, os, re, sys

# A layer path or the name of a majordomus executable. The generated banner names the
# generator rather than reading the layer, so it is not a finding.
# The trailing run is reported, not required: the same lines match either way, and a reader
# of a key is told `.ai/repo/sessions` rather than `.ai/repo`.
DETECT = re.compile(r'\.ai/(?:repo|local)[A-Za-z0-9._/-]*|bin/majordomus|majordomus-cli')
BANNER = re.compile(r'Generator:|generated by|GENERATED FILE')

for path in (line.rstrip('\n') for line in open(sys.argv[1], encoding='utf-8')):
    if not path or not os.path.isfile(path):
        continue
    with open(path, encoding='utf-8', errors='replace') as fh:
        for raw in fh:
            if BANNER.search(raw):
                continue
            m = DETECT.search(raw)
            if not m:
                continue
            # The key is the finding's identity, not its coordinates. It used to end in a
            # line number, and a line number is the one property of a finding that unrelated
            # work changes: every edit above a baselined line re-reported already-accepted
            # debt as a new regression, and the same unchanged line of pages.rs was
            # simultaneously a regression at :2173 and a stale baseline entry at :1787. A
            # ratchet that cannot survive an edit elsewhere in the file teaches everyone to
            # ignore it.
            #
            # What identifies this finding is the offending text, in the file that carries
            # it: the evidence token for a reader, and a digest of the line with its
            # whitespace normalised so that reindentation and movement are both invisible.
            # Editing the offending line itself does change the key — correctly, because
            # that is the event that needs re-review. Two identical offending lines in one
            # file are one finding, deliberately: the gate reports the debt, not a census.
            digest = hashlib.sha256(' '.join(raw.split()).encode('utf-8')).hexdigest()[:8]
            print(f'surface:{path}:{m.group(0)}:{digest}')
PY

LC_ALL=C sort -u "$FOUND" -o "$FOUND"

if [ -f "$BASELINE" ]; then
  grep -v '^#' "$BASELINE" | grep -v '^[[:space:]]*$' | LC_ALL=C sort -u > "$FOUND.known" || true
else
  : > "$FOUND.known"
fi

if [ "$WRITE" -eq 1 ]; then
  # "May shrink and may not grow" was a sentence in a comment, and the only command that
  # writes the file wrote everything it had just found — so the one documented way to
  # retire closed debt was also a one-command way to accept every live regression. The
  # writer enforces the sentence instead: it keeps what was already accepted and is still
  # found, drops what is no longer found, and takes a new key only when --accept names it.
  # A regression neither closed nor named stays a regression, and is reported here too.
  LC_ALL=C sort -u "$ACCEPTED" -o "$ACCEPTED"
  LC_ALL=C sort -u "$FOUND.known" "$ACCEPTED" > "$FOUND.allowed"
  LC_ALL=C comm -12 "$FOUND" "$FOUND.allowed" > "$FOUND.write"
  LC_ALL=C comm -23 "$FOUND" "$FOUND.allowed" > "$FOUND.open"
  {
    echo "# development-semantics-check baseline — accepted debt for"
    echo "# project.development-semantics-are-canonical@1 (ADR 0040)."
    echo "#"
    echo "# backing:<command>                 a public mutating command of share/commands.yaml"
    echo "#                                   that writes a development object tree and that the"
    echo "#                                   capability registry declares no mutating capability"
    echo "#                                   for."
    echo "# surface:<path>:<evidence>:<hash>  a layer path or executable name inside a Cockpit"
    echo "#                                   tree, identified by the offending text rather than"
    echo "#                                   by a line number: a key carrying a coordinate"
    echo "#                                   re-reports accepted debt whenever anything above it"
    echo "#                                   is edited. <hash> is sha256 of the line with its"
    echo "#                                   whitespace normalised, first 8 hex."
    echo "#"
    echo "# This list may shrink and may not grow. Regenerating retires what is closed:"
    echo "#   scripts/development-semantics-check --baseline"
    echo "# Accepting a new entry is a separate, deliberate act that names it, and belongs in"
    echo "# a commit that says on what grounds ADR 0040 permits it to stay:"
    echo "#   scripts/development-semantics-check --baseline --accept <key>"
    LC_ALL=C sort -u "$FOUND.write"
  } > "$BASELINE"
  echo "development-semantics-check: baseline rewritten with $(grep -cv '^#' "$BASELINE" || true) entry/entries"
  if [ -s "$FOUND.open" ]; then
    echo
    echo "NOT accepted — still a regression, and not written to the baseline:"
    sed 's/^/  FAIL  /' "$FOUND.open"
    echo
    echo "  Close it, or accept it deliberately with --accept <key> and say in the commit"
    echo "  on what grounds ADR 0040 permits it to stay."
  fi
  exit 0
fi
LC_ALL=C comm -23 "$FOUND" "$FOUND.known" > "$FOUND.new" || true
LC_ALL=C comm -13 "$FOUND" "$FOUND.known" > "$FOUND.stale" || true

n_all=$(wc -l < "$FOUND" | tr -d ' ')
n_new=$(wc -l < "$FOUND.new" | tr -d ' ')
n_stale=$(wc -l < "$FOUND.stale" | tr -d ' ')

if [ "$JSON" -eq 1 ]; then
  printf '{"schema":"development-semantics-check/v1","found":%s,"regressions":[' "$n_all"
  sep=''
  while IFS= read -r l; do [ -n "$l" ] && { printf '%s"%s"' "$sep" "$l"; sep=','; }; done < "$FOUND.new"
  printf '],"stale_baseline":['
  sep=''
  while IFS= read -r l; do [ -n "$l" ] && { printf '%s"%s"' "$sep" "$l"; sep=','; }; done < "$FOUND.stale"
  printf ']}\n'
else
  echo "development-semantics-check: $n_all finding(s); $n_new not in the baseline, $n_stale baseline line(s) matching nothing"
  if [ "$n_new" -gt 0 ]; then
    echo
    echo "REGRESSION — a development semantic outside the canonical runtime:"
    sed 's/^/  FAIL  /' "$FOUND.new"
    echo
    echo "  A mutating development command belongs to the capability registry"
    echo "  (apps/majordomus-cli/src/capability/builtin/), and a Cockpit tree renders"
    echo "  capability output rather than reading the layer. See ADR 0040 and"
    echo "  docs/DEVELOPMENT_RUNTIME.md; the rule is"
    echo "  project.development-semantics-are-canonical@1."
  fi
  if [ "$n_stale" -gt 0 ]; then
    echo
    echo "STALE — baseline entries that match nothing (remove them; the ratchet tightened):"
    sed 's/^/  ----  /' "$FOUND.stale"
  fi
fi

[ "$n_new" -eq 0 ] && [ "$n_stale" -eq 0 ] || exit 10
exit 0
