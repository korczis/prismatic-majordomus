#!/usr/bin/env bash
# The gates the Rust executable must pass, in the order CI runs them: format, lints with
# warnings as errors (a public item without documentation is one), the suites including
# doctests, rustdoc with warnings denied, the benchmarks compiling, the registry's own
# validation, the committed projections in sync, the benchmark coverage complete, the web
# topology valid (one owner per path, every native surface answerable), the crate's own
# public API quality report clean against its baseline, and coverage above two thresholds —
# scripts/rust-coverage-threshold over the crate and scripts/session-coverage-threshold over
# the canonical session/continuity domain — when cargo-llvm-cov is installed, measured over
# the code that is under test rather than over the code plus the tests. One script, so that
# CI and a person run the same gates in the same order.
#
# The rustdoc step is a gate and a producer at once. The pages it proves warning-free are the
# pages the public site serves at /rustdoc (ADR 0086), so wherever it runs its output is
# handed off as the `rustdoc` web surface: copied into target/web/rustdoc beside the
# surface.json that declares it and a landing page. One invocation of rustdoc, never a second
# variant of it for publication — what is published is what the gate proved.
#
#   scripts/rust-check                  every gate (coverage when cargo-llvm-cov is installed)
#   scripts/rust-check --ci             every gate but coverage (its own CI job), plus the
#                                       benchmark check against this platform's baseline
#   scripts/rust-check --doc            the rustdoc step alone, and its handoff into
#                                       target/web/rustdoc: the producer of the rustdoc
#                                       surface, which scripts/site-build composes into the
#                                       site and which pages.yml and every site-building job
#                                       of validate.yml run through .github/actions/rustdoc.
#                                       Exit 12 when cargo's target directory is shared with
#                                       other checkouts: its doc/ cannot be proved fresh
#   scripts/rust-check --integration    the executable built and the registry checks only:
#                                       capabilities validate, generate --check, bench
#                                       coverage --check, web validate, quality report. What a change outside the crate
#                                       can affect: the layer, the schemas, the documents the
#                                       registry dataset is derived from.
#   --artifact DIR                      after building, copy the executable into DIR with a
#                                       majordomus-cli.json beside it (commit, target triple,
#                                       rustc, Cargo.lock digest, profile) for a later job
#   MJ_CI_TIMINGS=FILE                  append "rust-check<TAB>step<TAB>seconds" per step
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CRATE="$ROOT/apps/majordomus-cli"
# for mj_cargo_target_dir: cargo does not necessarily build into "$CRATE/target"
# shellcheck source=../lib/rust_bin.sh
. "$ROOT/lib/rust_bin.sh"
MODE=all; ARTIFACT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --ci) MODE=ci; shift ;;
    --doc) MODE=doc; shift ;;
    --integration) MODE=integration; shift ;;
    --artifact) ARTIFACT="$2"; shift 2 ;;
    *) echo "rust-check: unknown option $1" >&2; exit 2 ;;
  esac
done
# --doc builds the documentation and nothing else, so there is no executable to hand over
if [ "$MODE" = doc ] && [ -n "$ARTIFACT" ]; then
  echo "rust-check: --artifact needs the executable, and --doc builds only the documentation" >&2; exit 2
fi
# the timings file is the caller's, named from the caller's directory: the script is about
# to leave it, and a relative name would then append to a file nobody reads
case "${MJ_CI_TIMINGS:-}" in ''|/*) ;; *) MJ_CI_TIMINGS="$PWD/$MJ_CI_TIMINGS" ;; esac
cd "$CRATE"
# a machine-wide rustflags profile can make a dev build refuse to link; the crate sets none
RUSTFLAGS=''; export RUSTFLAGS
# Every build of this script is handed the commit it is checking, and the rustdoc handoff
# records the same value as built_from, so the crate's own COMMIT constant — which rustdoc
# renders on its page, and which `scripts/pages verify-rustdoc` reads as the second witness of
# the commit — names the one the tree is declared built from. build.rs reads the commit only
# when it reruns, and it reruns on the crate's sources, manifest, lock file and this variable,
# not on HEAD: after a commit that touches none of them a plain build keeps the earlier commit
# compiled in, while a built_from read from HEAD names the new one (measured on a fixture crate
# with rustdoc 1.98.1). For the whole script rather than the doc step alone, because a value
# that changed between two steps reruns build.rs and recompiles the crate for the next one.
MAJORDOMUS_BUILD_COMMIT="${MAJORDOMUS_BUILD_COMMIT:-$(git -C "$ROOT" rev-parse HEAD)}"
export MAJORDOMUS_BUILD_COMMIT
t_step=""; last=""
step() {
  local now; now="$(date +%s)"
  if [ -n "$t_step" ]; then
    printf '    (%ss)\n' "$((now - t_step))"
    [ -n "${MJ_CI_TIMINGS:-}" ] && printf 'rust-check\t%s\t%s\n' "$last" "$((now - t_step))" >> "$MJ_CI_TIMINGS"
  fi
  printf '==> %s\n' "$*"; last="$*"; t_step="$now"
}

# The handoff of the rustdoc step: its output published as the `rustdoc` web surface.
#
# cargo writes the pages into ITS target directory, which is not necessarily under this
# checkout — several worktrees share one through CARGO_TARGET_DIR, and a .cargo/config.toml
# can name another — so the directory is asked of cargo, never composed and never guessed: a
# guess would publish a tree cargo did not write. The pages are copied into this checkout's
# own generated web root, where discovery, `majordomus serve` and scripts/site-build read
# them, after emptying it.
#
# Emptying the copy is not enough, because rustdoc does not empty ITS output either: it
# writes into target/doc over whatever an earlier run left there. A module the crate deleted
# keeps its pages, and the search index is content-addressed shards (search.index/<hash>.js)
# of which every run adds the ones it needs and removes none, so a copy of that directory
# would publish pages nobody can reach from the index and a search that answers with items
# the crate no longer has. rustdoc_fresh therefore removes target/doc before the step — but
# only when the target directory is this checkout's own. A shared one is another worktree's
# too, whose pages may be mid-copy, and one session deleting another's output is the thing
# never to do. In a shared directory the leftovers cannot be told apart from this run's pages,
# so `--doc`, whose one purpose is the published tree, refuses and names the remedy, and the
# full modes, whose purpose is the gates, run them and say that nothing was handed off.
# Building the published pages into a directory of their own instead was rejected: a second
# target directory rebuilds every dependency to document one crate, and a second rustdoc
# invocation would publish pages the gate never proved.
#
# Two files are ours, beside rustdoc's. surface.json is the declaration (web-surface/v1) that
# makes the directory a surface, and built_from is the commit of THIS checkout: what lets
# scripts/site-check refuse a stale tree and `scripts/pages verify-rustdoc` prove the public
# one is this commit's. index.html is the landing page, because rustdoc writes an index per
# crate and none at the root of its output — the mount would otherwise answer with nothing.
# Every link into the tree on it is relative, so the same bytes work at /rustdoc on the
# published site and on the executable's own server, and no path of this machine reaches it;
# the one link out of it is the site's public address.
DOC_TARGET=""; DOC_SHARED=0
rustdoc_fresh() {
  local phys root_phys
  command -v jq >/dev/null 2>&1 || { echo "rust-check: jq is required to declare the rustdoc surface" >&2; exit 12; }
  DOC_TARGET="$(cargo metadata --format-version 1 --no-deps | jq -r .target_directory)"
  [ -n "$DOC_TARGET" ] || { echo "rust-check: cargo metadata names no target directory" >&2; exit 12; }
  # a target directory that does not exist yet holds nothing stale; one that does is judged
  # by where it physically is, so a symlink into a shared directory is a shared directory
  [ -d "$DOC_TARGET" ] || return 0
  phys="$(cd "$DOC_TARGET" && pwd -P)"; root_phys="$(cd "$ROOT" && pwd -P)"
  case "$phys/" in
    "$root_phys"/*) rm -rf "$DOC_TARGET/doc" ;;
    *) DOC_SHARED=1
       # --doc exists for the published tree alone, so it refuses before spending the build
       [ "$MODE" = doc ] && { rustdoc_not_handed_off; exit 12; }
       printf '    %s is outside this checkout (shared with others); its doc/ is left alone\n' "$DOC_TARGET" ;;
  esac
}
# Why a shared target directory hands nothing off, and what to run instead. A previous
# handoff must not outlive the one that could not happen: served or composed, it would be
# another commit's reference presented as this one's, so it is removed as well.
rustdoc_not_handed_off() {
  rm -rf "$ROOT/target/web/rustdoc"
  printf 'rust-check: the rustdoc surface was not handed off. %s is shared with other\n' "$DOC_TARGET" >&2
  printf '            checkouts, so its doc/ may hold pages and search shards the crate no longer has,\n' >&2
  printf '            and it is not ours to empty. Produce the surface with a target directory of this\n' >&2
  # shellcheck disable=SC2016 # the variable is for the reader's shell to expand, not this one
  printf '            checkout: CARGO_TARGET_DIR="$PWD/apps/majordomus-cli/target" scripts/rust-check --doc\n' >&2
}
rustdoc_surface() {
  local out version commit site
  out="$ROOT/target/web/rustdoc"
  if [ "$DOC_SHARED" = 1 ]; then rustdoc_not_handed_off; return 0; fi
  [ -f "$DOC_TARGET/doc/majordomus_cli/index.html" ] || {
    echo "rust-check: rustdoc left no majordomus_cli/index.html under $DOC_TARGET/doc" >&2; exit 12; }
  rm -rf "$out"; mkdir -p "$out"
  cp -R "$DOC_TARGET/doc/." "$out/"
  # cargo's own lock file on the directory it writes, not a page
  rm -f "$out/.lock"
  # the version cargo reads for the crate, not a line of Cargo.toml matched by hand
  version="$(cargo metadata --format-version 1 --no-deps \
    | jq -r '.packages[] | select(.name == "majordomus-cli") | .version')"
  [ -n "$version" ] || { echo "rust-check: cargo metadata names no version for majordomus-cli" >&2; exit 12; }
  # the commit the build was handed (above), so built_from and the COMMIT page agree
  commit="$MAJORDOMUS_BUILD_COMMIT"
  # The way back to the site is its public address, from the file the site is built with: a
  # relative "../" would climb out of the tree, which `majordomus quality rustdoc` refuses in
  # any page of it, and an origin-absolute "/" means another page on every server the tree is
  # mounted in. A site with no base_url gets no such link rather than a guessed one.
  site="$(sed -n 's/^base_url = "\(.*\)"/\1/p' "$ROOT/site/config.toml" 2>/dev/null | head -n 1)"
  [ -z "$site" ] || site="<li><a href=\"${site%/}/\">The site, ${site#*://}</a></li>"
  # the title discovery gives the surface (web::discover::rustdoc), so the two agree
  jq -n --arg built "$commit" --arg title "The Rust crate's documentation, as rustdoc renders it" \
    '{schema: "web-surface/v1", id: "rustdoc", mount: "/rustdoc", title: $title,
      index: "index.html", producer: "scripts/rust-check --doc",
      availability: "both", category: "documentation", visibility: "public",
      built_from: $built}' > "$out/surface.json"
  cat > "$out/index.html" <<HTML
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>majordomus-cli $version — Rust API reference</title>
<meta name="description" content="The rustdoc reference of majordomus-cli $version, built from commit $commit: the public items of the library and of the executable, and the source they were built from.">
<style>body{margin:0;font:16px/1.6 system-ui,sans-serif}main{max-width:44rem;margin:0 auto;padding:1rem}dt{font-weight:600}dd{margin:0 0 .5rem}code{overflow-wrap:anywhere}@media (prefers-color-scheme:dark){body{background:#111;color:#eee}a{color:#8ab4f8}}</style>
</head>
<body>
<main>
<h1>majordomus-cli $version — Rust API reference</h1>
<dl>
<dt>Version</dt><dd>$version</dd>
<dt>Built from commit</dt><dd><code>$commit</code></dd>
</dl>
<p>This is the rustdoc output of the crate that is the majordomus executable: every public item of its library and of the executable, documented and warning-free, with the source each page was built from. It is a reference to the code as it stands at that commit and not a semver contract: the crate is not published (<code>publish = false</code>), and its Rust items may change in any release. The public contract of majordomus is its capability registry.</p>
<ul>
<li><a href="majordomus_cli/index.html">The library, majordomus_cli</a></li>
<li><a href="majordomus_cli/all.html">Every item of the library</a></li>
<li><a href="majordomus/index.html">The executable, majordomus</a></li>
$site
</ul>
</main>
</body>
</html>
HTML
  printf '    %s file(s) in %s, built from %s\n' \
    "$(find "$out" -type f | wc -l | tr -d ' ')" "${out#"$ROOT"/}" "$commit"
}

if [ "$MODE" != integration ]; then
  if [ "$MODE" != doc ]; then
    step "cargo fmt --check";            cargo fmt --check
    step "cargo clippy -D warnings";     cargo clippy --all-targets --all-features -- -D warnings
    step "cargo test";                   cargo test --no-fail-fast
  fi
  # not a step of its own: a question to cargo and one rm, and the step list is the gates
  rustdoc_fresh
  step "cargo doc -D warnings";        RUSTDOCFLAGS='-D warnings' cargo doc --no-deps --quiet
  step "rustdoc surface";              rustdoc_surface
  if [ "$MODE" = doc ]; then
    step "rust-check: the rustdoc surface is in target/web/rustdoc"
    exit 0
  fi
  step "cargo bench --no-run";         cargo bench --no-run --quiet
fi
step "cargo build";                  cargo build --quiet
step "capabilities validate";        cargo run --quiet -- capabilities validate
step "generate --check";             cargo run --quiet -- generate --check
step "bench coverage --check";       cargo run --quiet -- bench coverage --check
# the web topology this repository declares: ids unique, one owner per path in each world,
# every artifact inside the generated root, and every native surface answerable. Without
# --artifacts, so it is a check on the declarations rather than on whether a producer has
# run in this checkout; the serving path requires the artifact at the moment it serves.
step "web validate";                 cargo run --quiet -- web validate
# the crate's own public surface against project.rust-public-api-quality and
# project.operation-transport-parity: documentation that says more than the signature, an
# executable example on everything that carries behaviour, a module boundary something
# exercises, and every command of the command line accounted for against the registry.
# Ratcheted against .ai/repo/rust-quality-baseline.txt while the debt shrinks.
step "quality report";               cargo run --quiet -- quality report --summary
# No benchmark comparison here. It compares a run with the baseline committed for its own
# platform, and the only one under .ai/repo/benchmarks/rust/ is macOS's: on this job's Linux
# runner it measured every target at the ci profile, printed "nothing compared", and could
# not fail — then pushed the job past its thirty minutes, so the gates after it never ran.
# The comparison is the macOS bench job's (rust-bench), where the baseline is. What this
# gate owes about the runner is that it executes, and `cargo test` above already proves it:
# tests/bench.rs times a target through the executor, a socket and a child process;
# tests/properties.rs sends every deterministic capability over MCP and HTTP; and
# tests/http_serve.rs replays every route's benchmark cases against a served process.
if [ "$MODE" = all ]; then
  threshold="$(cat "$ROOT/scripts/rust-coverage-threshold")"
  domain="$(cat "$ROOT/scripts/session-coverage-threshold")"
  if cargo llvm-cov --version >/dev/null 2>&1; then
    # Not `cargo llvm-cov --summary-only --fail-under-lines` directly: that measures the
    # crate *and its tests*, because --all-targets instruments tests/ and benches/ and
    # because this crate keeps its unit tests inline in src/*.rs where no filename regex can
    # reach them. A threshold over that mixture moves whenever a test is added or deleted.
    # scripts/rust-coverage runs the same suite and subtracts the test code from both sides
    # of the fraction, and holds the session/continuity domain to its own threshold beside
    # the crate-wide floor.
    step "scripts/rust-coverage (crate $threshold%, session domain $domain%)"
    "$ROOT/scripts/rust-coverage"
  else
    printf '==> coverage: cargo-llvm-cov not installed (cargo install cargo-llvm-cov; rustup component add llvm-tools-preview); CI enforces %s%% over the crate and %s%% over the session/continuity domain\n' "$threshold" "$domain"
  fi
fi
if [ -n "$ARTIFACT" ]; then
  # The executable as a build output for a later job, with what a consumer needs in order
  # to know it is the one it expects: the commit, the target, the toolchain, the lock file.
  step "artifact $ARTIFACT"
  mkdir -p "$ARTIFACT"
  # every gate above ran through `cargo run`, which needed no path; this one copies the
  # file, so it must ask cargo where the file is — a script that has already spent minutes
  # building can afford the process, and a shared CARGO_TARGET_DIR is not under the crate
  cp "$(mj_cargo_target_dir "$CRATE" ask-cargo)/debug/majordomus" "$ARTIFACT/majordomus"
  host="$(rustc -vV | sed -n 's/^host: //p')"
  if command -v shasum >/dev/null 2>&1; then lock="$(shasum -a 256 "$CRATE/Cargo.lock" | cut -d' ' -f1)"
  else lock="$(sha256sum "$CRATE/Cargo.lock" | cut -d' ' -f1)"; fi
  printf '{"schema":1,"name":"majordomus","profile":"debug","commit":"%s","target":"%s","rustc":"%s","cargo_lock_sha256":"%s","built_at":"%s"}\n' \
    "$(git -C "$ROOT" rev-parse HEAD)" "$host" "$(rustc -V)" "$lock" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$ARTIFACT/majordomus-cli.json"
fi
step "rust-check: every gate passed"
