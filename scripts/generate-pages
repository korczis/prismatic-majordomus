    <div class="rounded-lg border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-gray-800">
      <h2 class="mb-3 font-mono text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Requirements</h2>
      <ul class="space-y-2 text-sm text-gray-700 dark:text-gray-300">
        <li>bash 3.2 or newer</li>
        <li>git</li>
        <li><code class="font-mono">sha256sum</code> or <code class="font-mono">shasum</code></li>
      </ul>
      <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">No package manager, no daemon, no network access.</p>
    </div>
    <div class="rounded-lg border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-gray-800">
      <h2 class="mb-3 font-mono text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Then read</h2>
      <ul class="space-y-2 text-sm">
