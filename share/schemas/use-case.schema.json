{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://majordomus.dev/schemas/use-case.schema.json",
  "title": "Use case",
  "description": "The front matter of a use case under .ai/repo/use-cases/: a task a person performs with the tool, the commands, rules, claims, responsibilities and applications it names, and the scenario that proves it against the real tool. The body carries the narrative (# Situation, # Outcome, and what else the author says).",
  "x-majordomus-allow": "use-case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "title",
    "summary",
    "category",
    "status",
    "commands"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "kind": {
      "const": "use-case"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "status": {
      "enum": [
        "active",
        "draft",
        "deprecated"
      ]
    },
    "target": {
      "description": "The maturity the author aims at; what is observed is computed and never written here.",
      "enum": [
        "guaranteed",
        "advisory"
      ]
    },
    "weight": {
      "type": "integer",
      "minimum": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "enum": [
          "maintainer",
          "contributor",
          "reviewer",
          "agent",
          "operator"
        ]
      }
    },
    "difficulty": {
      "enum": [
        "basic",
        "intermediate",
        "advanced"
      ]
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "mcp_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "doctrines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boost": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suppress": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scenario": {
      "description": "The executable proof: a fresh repository prepared by a setup script, then the steps in order, each a real invocation of the tool with its expected exit code and output.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setup",
        "steps"
      ],
      "properties": {
        "setup": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "given": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "run",
              "expect"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "run": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "stdin": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "expect": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "exit"
                ],
                "properties": {
                  "exit": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "stdout_contains": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "stdout_not_contains": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "files_exist": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "tree_unchanged": {
                    "type": "boolean"
                  },
                  "files_contain": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "pattern"
                      ],
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "pattern": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "then": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget_ms"
      ],
      "properties": {
        "budget_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
