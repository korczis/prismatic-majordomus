{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://majordomus.dev/schemas/generated/benchmark-matrix.schema.json",
  "title": "Benchmark matrix",
  "description": "docs/generated/benchmarks.{json,yaml}: the same projection docs/generated/benchmarks.md renders for a reader — the coverage tallies, every executable capability with its state on each transport and the cases its input type provides, and the transports' own targets.",
  "type": "object",
  "required": ["schema", "generated", "generator", "coverage", "capabilities", "system_targets"],
  "properties": {
    "schema": { "const": "majordomus/benchmark-matrix/v1" },
    "generated": { "type": "string", "pattern": "^GENERATED FILE" },
    "generator": { "type": "string", "pattern": "^majordomus-cli " },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scope", "required", "covered", "missing", "waived"],
        "properties": {
          "scope": { "type": "string", "minLength": 1 },
          "required": { "type": "integer", "minimum": 0 },
          "covered": { "type": "integer", "minimum": 0 },
          "missing": { "type": "integer", "minimum": 0 },
          "waived": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "module", "kind", "cache", "direct", "mcp", "http", "cases"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "module": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "cache": { "type": "string" },
          "direct": { "enum": ["covered", "missing", "waived", "none"] },
          "mcp": { "enum": ["covered", "missing", "waived", "none"] },
          "http": { "enum": ["covered", "missing", "waived", "none"] },
          "cases": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "system_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "transport", "measures"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "transport": { "type": "string", "minLength": 1 },
          "measures": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
