#!/usr/bin/env bash
# generate-site-data — normalise canonical repository data into a stable site data schema.
#
#   canonical                              derived (site/data/generated/)
#   bin/majordomus (MJ_VERSION)        ->  project.json
#   share/skeleton/profiles/*.yaml     ->  profiles.json
#   share/skeleton/policy.yaml         ->  policy.json
#   docs/CLAIMS.yaml                   ->  capabilities.json
#   lib/finish.sh + share/skeleton     ->  lifecycle.json (outcome vocabulary, commands)
#   share/standard/majordomus/         ->  principles (the rules tagged principle, in package order)
#   share/skeleton/ai/repo/workflows/  ->  lifecycle steps and the worker sequence
#   docs/*.md                          ->  docs index
#   git                                ->  source.json (commit, input hash, generator version)
#
# Deterministic: same inputs, byte-identical outputs (except generated_at, kept in source.json
# only). Zola templates render these files; they contain no business logic. Nothing here is a
# second copy of product truth — every value is read from the file that owns it.
#
#   scripts/generate-site-data            write site/data/generated/*.json
#   scripts/generate-site-data --check    write to a temp dir and diff against the committed files
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# Generation is transactional. Everything is written into a staging directory and only moved
# into place once every step has succeeded, so a failure half way through (a claim without its
# detail document, a renamed README heading) leaves the previous generated artifacts intact
# rather than truncated. --check never publishes; it stages and diffs.
CHECK=0; PUBLISH=1
DEST_DATA="$ROOT/site/data/generated"
[ "${1:-}" = --check ] && { CHECK=1; PUBLISH=0; }
# --out writes the data somewhere else and publishes nothing: no content pages, no
# docs/SITE_CLAIMS.md. It is how a caller gets a fresh generation without touching the tree.
[ "${1:-}" = --out ] && { DEST_DATA="$2"; PUBLISH=0; }
# The staging directory lives beside its destination so that publishing is a same-filesystem
# rename rather than a copy; the trap removes it on every exit path, including failure.
STAGE="$(mktemp -d "$ROOT/.mj-stage.XXXXXX")"
OUT="$STAGE/data"; mkdir -p "$OUT"
MJ_VERSION="site"; MJ_BIN_DIR="$ROOT/bin"; MJ_LIB_DIR="$ROOT/lib"; export MJ_VERSION MJ_BIN_DIR MJ_LIB_DIR
# shellcheck source=../lib/common.sh
. "$ROOT/lib/common.sh"
# The repository layout, resolved once by the tool itself: which directory holds the plan and
# which holds the AI layer are facts of the checkout, never spelled out here.
MJ_ROOT="$ROOT"; export MJ_ROOT; mj_resolve_layout
PJ="$(mj_rel "$MJ_PROJECT_DIR")"; AI="$(mj_rel "$MJ_AI_DIR")"; LOCAL="$(mj_rel "$MJ_AI_LOCAL_DIR")"
# common.sh installs its own EXIT trap, so the staging cleanup is chained after sourcing it
# rather than before, or the later trap would silently replace this one and leak the directory.
trap 'rm -rf "$STAGE" "${RULES_TMP:-}"; mj_cleanup' EXIT
command -v jq >/dev/null || { echo "generate-site-data: jq is required" >&2; exit 12; }
GEN_VERSION=1

# ---------------------------------------------------------------- inputs
GEN_T0="$(mj_phase_begin "gen:inputs")"
INPUTS="bin/majordomus
share/commands.yaml
share/use-cases.yaml
share/applications.yaml
share/skeleton/policy.yaml
share/skeleton/ai/repo/workflows/task-lifecycle.md
share/skeleton/ai/repo/workflows/plan.md
share/standard/majordomus/manifest.yaml
docs/CLAIMS.yaml
docs/RESPONSIBILITIES.yaml
README.md
LICENSE"
# LC_ALL=C so the globs below expand in byte order rather than in the collation order of
# whoever is running this. The milestones directory holds both M000.yaml and
# slug-named files: byte order puts uppercase M before every lowercase name, a
# case-insensitive locale files it between "foundation" and "routing-". The input list then
# differs by machine, and so does the hash computed from it — a portability failure in a
# tool that declares byte-identical output for identical input. Any directory mixing
# uppercase and lowercase names has the same effect; this one merely reached that state
# first.
LC_ALL=C; export LC_ALL

# test cases are inputs because each one declares which commands it covers, and that
# metadata is the evidence the command pages render
for f in "$ROOT"/share/skeleton/profiles/*.yaml "$ROOT"/share/standard/majordomus/rules/*.md "$ROOT"/docs/*.md "$ROOT"/docs/claims/*.md \
         "$ROOT"/test/cases/*.sh \
         "$ROOT"/test/fixtures/commands/*.json "$ROOT"/test/fixtures/commands/setup/*.sh \
         "$ROOT"/test/fixtures/commands/stdin/* \
         "$ROOT/$PJ"/project.yaml "$ROOT/$PJ"/milestones/*.yaml \
         "$ROOT/$PJ"/issues/*.yaml; do
  case "$f" in */docs/SITE_CLAIMS.md|*/docs/PLAN_STATUS.md) continue ;; esac   # written by this script; never its own input
  INPUTS="$INPUTS
${f#"$ROOT"/}"; done
# --inputs prints this same list and exits. A test fixture that has to reproduce the
# generator's inputs derives them from here rather than keeping a second list that goes
# stale the moment a new canonical input is added — which is how it went stale before.
if [ "${1:-}" = --inputs ]; then printf '%s\n' $INPUTS | sed '/^$/d'; exit 0; fi
for f in $INPUTS; do [ -f "$ROOT/$f" ] || { echo "generate-site-data: canonical input missing: $f" >&2; exit 12; }; done

# link rewriting for derived Markdown (repository paths -> site routes)
LINKSED='s#\](\.\./AGENTS\.md)#](@/docs/contract.md)#g; s#\](AGENTS\.md)#](@/docs/contract.md)#g; s#\](\.\./CONTRIBUTING\.md)#](https://github.com/korczis/prismatic-majordomus/blob/master/CONTRIBUTING.md)#g; s#\](\.\./SECURITY\.md)#](https://github.com/korczis/prismatic-majordomus/blob/master/SECURITY.md)#g; s#\](CLAIMS\.yaml)#](@/guarantees.md)#g; s#\](docs/CLAIMS\.yaml)#](@/guarantees.md)#g; s#\](README\.md)#](@/docs/_index.md)#g; s#\]((\.\./)?test/cases/)#](https://github.com/korczis/prismatic-majordomus/tree/master/test/cases/)#g'

flat() { local t; t="$(mktemp "${TMPDIR:-/tmp}/mj.f.XXXXXX")"; mj_yaml_flatten "$1" > "$t" || { echo "generate-site-data: $1 does not parse" >&2; exit 10; }; printf '%s' "$t"; }
# yload turns a flat file into variables once (mj_yload); yv and ylist read a loaded file
# by expansion and fall back to one awk per key for a file nobody loaded. A loaded
# section pays one process for its whole file instead of one per field read.
yload() { mj_yload "$1" "Y_${1//[!A-Za-z0-9]/_}"; printf -v "Y_${1//[!A-Za-z0-9]/_}__LOADED" 1; }
yv() { local p="Y_${1//[!A-Za-z0-9]/_}" n; n="${p}__LOADED"; if [ -n "${!n:-}" ]; then mj_yv "$p" "$2"; else mj_yget "$1" "$2"; fi; }
ylist() { local p="Y_${1//[!A-Za-z0-9]/_}" n; n="${p}__LOADED"; if [ -n "${!n:-}" ]; then mj_yvlist "$p" "$2"; else mj_ylist "$1" "$2"; fi; }
# jstr <string>: the string as a JSON string literal, without a process. What jq -Rn --arg
# prints: backslash and quote escaped, the named control characters as \n \r \t \b \f,
# every other control byte as \u00XX; anything else, UTF-8 included, verbatim.
jstr() {
  local s="$1" out="" c i n
  case "$s" in *[\\\"$'\x01'-$'\x1f']*) ;; *) printf '"%s"' "$s"; return 0 ;; esac
  n=${#s}
  for ((i = 0; i < n; i++)); do
    c="${s:i:1}"
    case "$c" in
      \\) out="$out\\\\" ;;
      \") out="$out\\\"" ;;
      $'\n') out="$out\\n" ;;
      $'\r') out="$out\\r" ;;
      $'\t') out="$out\\t" ;;
      $'\b') out="$out\\b" ;;
      $'\f') out="$out\\f" ;;
      [$'\x01'-$'\x1f']) out="$out$(printf '\\u%04x' "'$c")" ;;
      *) out="$out$c" ;;
    esac
  done
  printf '"%s"' "$out"
}
# jarr: the lines on stdin as a JSON array of strings; jline: the first line as a JSON
# string. What `jq -R . | jq -sc .` and `jq -Rn input` printed, without a process each.
jarr() { local l out="" first=1; while IFS= read -r l; do out="$out$([ "$first" = 1 ] || printf ',')$(jstr "$l")"; first=0; done; printf '[%s]' "$out"; }
jline() { local l=""; IFS= read -r l || true; jstr "$l"; }
jbool() { case "$1" in true) echo true ;; false) echo false ;; *) jstr "$1" ;; esac; }
jnum_or_str() { case "$1" in ''|*[!0-9]*) jstr "$1" ;; *) printf '%s' "$1" ;; esac; }
ylist_json() { mj_ylist "$1" "$2" | jarr; }
# Rewrite a generated file in place. The scratch file lives outside the staging directory,
# which is published wholesale, and a failure aborts rather than publishing a half-written
# artifact: `jq ... > "$OUT/x.tmp" && mv` leaks the temp into the site and, because `&&`
# suppresses errexit, does it silently.
jq_inplace() {
  local target="$1"; shift
  local t; t="$(mktemp "${TMPDIR:-/tmp}/mj.jqi.XXXXXX")"
  jq "$@" "$target" > "$t" || { rm -f "$t"; echo "generate-site-data: rewriting ${target##*/} failed" >&2; exit 13; }
  mv "$t" "$target"
}

mj_phase_end "gen:inputs" "$GEN_T0"
# ---------------------------------------------------------------- project.json
GEN_T0="$(mj_phase_begin "gen:project.json")"
VERSION="$(sed -n 's/^MJ_VERSION="\(.*\)"/\1/p' "$ROOT/bin/majordomus" | head -1)"
TAGLINE="$(grep -m1 -E '^\*\*A lightweight' "$ROOT/README.md" | sed 's/\*\*//g')"
LICENSE_NAME="$(head -1 "$ROOT/LICENSE" | sed 's/ License$//')"
COMMANDS="$(sed -n '/^usage: majordomus <command>/,/^global options:/p' "$ROOT/bin/majordomus" \
  | grep -E '^  [a-z]' | sed -E 's/^  ([a-z]+)( <[a-z]+>)? +(.*)$/\1|\3/' \
  | jq -Rn '[inputs | split("|") | {name: .[0], summary: (.[1] | gsub("\\s+\\(read-only\\)$"; "") | gsub(" +$";"")), read_only: (.[1] | test("read-only"))}]')"
EXIT_CODES="$(sed -n 's/^exit codes: //p; s/^            //p' "$ROOT/bin/majordomus" | tr '·' '\n' | sed 's/^ *//; s/ *$//' | grep -E '^[0-9]+ ' \
  | jq -Rn '[inputs | capture("^(?<code>[0-9]+) (?<meaning>.+)$") | .code |= tonumber]')"
jq -n --arg name "Prismatic Majordomus" --arg short "Majordomus" --arg version "$VERSION" --arg tagline "$TAGLINE" \
  --arg license "$LICENSE_NAME" --arg repo "https://github.com/korczis/prismatic-majordomus" \
  --argjson commands "$COMMANDS" --argjson exit_codes "$EXIT_CODES" \
  '{schema: 1, name: $name, short_name: $short, version: $version, tagline: $tagline, license: $license,
    repository_url: $repo, requirements: ["bash 3.2 or newer", "git", "sha256sum or shasum"],
    commands: $commands, exit_codes: $exit_codes}' > "$OUT/project.json"

mj_phase_end "gen:project.json" "$GEN_T0"
# ---------------------------------------------------------------- profiles.json
GEN_T0="$(mj_phase_begin "gen:profiles.json")"
{
  first=1; printf '{"schema":1,"profiles":['
  for pf in "$ROOT"/share/skeleton/profiles/*.yaml; do
    F="$(flat "$pf")"; yload "$F"; slug="$(basename "$pf" .yaml)"
    [ "$first" = 1 ] || printf ','; first=0
    ctx="$(grep -E '^context\.' "$F" | sed 's/^context\.//' | jq -Rn '[inputs | split("=") | {key: .[0], value: (.[1] | if . == "true" then true elif . == "false" then false elif test("^[0-9]+$") then tonumber else . end)}] | from_entries')"
    ver="$(grep -E '^verification\.' "$F" | sed 's/^verification\.//' | jq -Rn '[inputs | split("=") | {key: .[0], value: (.[1] | if . == "true" then true elif . == "false" then false else . end)}] | from_entries')"
    esc_after="$(yv "$F" effort_escalation.after_blocked_attempts)"; esc_to="$(yv "$F" effort_escalation.to)"
    jq -cn --arg slug "$slug" --arg name "$(yv "$F" name)" --arg description "$(yv "$F" description)" \
      --arg capability "$(yv "$F" capability)" --arg effort "$(yv "$F" effort)" --arg verbosity "$(yv "$F" verbosity)" \
      --arg presentation "$(yv "$F" presentation)" --arg checkpoint "$(yv "$F" checkpoint_interval)" \
      --argjson context "$ctx" --argjson verification "$ver" --argjson contract "$(ylist_json "$F" output_contract)" \
      --arg esc_after "$esc_after" --arg esc_to "$esc_to" \
      '{slug: $slug, name: $name, description: $description, capability: $capability, effort: $effort,
        effort_escalation: (if $esc_to == "" then null else {after_blocked_attempts: ($esc_after|tonumber), to: $esc_to} end),
        verbosity: $verbosity, presentation: $presentation, checkpoint_interval: $checkpoint,
        context: $context, verification: $verification, output_contract: $contract}'
    rm -f "$F"
  done
  printf ']}'
} | jq . > "$OUT/profiles.json"

mj_phase_end "gen:profiles.json" "$GEN_T0"
# ---------------------------------------------------------------- policy.json
GEN_T0="$(mj_phase_begin "gen:policy.json")"
P="$(flat "$ROOT/share/skeleton/policy.yaml")"; yload "$P"
enf="$(i=0; printf '['; while [ -n "$(yv "$P" "enforcement.$i.name")" ]; do [ $i = 0 ] || printf ','; jq -cn --arg n "$(yv "$P" "enforcement.$i.name")" --arg p "$(yv "$P" "enforcement.$i.path")" --arg w "$(yv "$P" "enforcement.$i.wired_by")" --argjson a "$(ylist_json "$P" "enforcement.$i.args")" '{name:$n,path:$p,args:$a,wired_by:$w}'; i=$((i+1)); done; printf ']')"
prj="$(i=0; printf '['; while [ -n "$(yv "$P" "projections.$i.target")" ]; do [ $i = 0 ] || printf ','; jq -cn --arg p "$(yv "$P" "projections.$i.provider")" --arg t "$(yv "$P" "projections.$i.target")" --arg a "$(yv "$P" "projections.$i.always_loaded")" '{provider:$p,target:$t,always_loaded:($a=="true")}'; i=$((i+1)); done; printf ']')"
jq -n --argjson version "$(yv "$P" version)" \
  --argjson budget "$(yv "$P" context.always_loaded_budget_lines)" --arg strategy "$(yv "$P" context.strategy)" \
  --argjson transcript "$(jbool "$(yv "$P" context.transcript_is_state)")" \
  --arg default_profile "$(yv "$P" profiles.default)" --arg checkpoint "$(yv "$P" profiles.checkpoint_interval_default)" \
  --argjson req_changes "$(jbool "$(yv "$P" verification.required_for_changes)")" --argjson finish "$(ylist_json "$P" verification.finish_requires)" \
  --argjson sections "$(ylist_json "$P" handover.required_sections)" --argjson ho_cap "$(yv "$P" handover.retention_max_files)" \
  --argjson ledger_cap "$(yv "$P" ledger.retention_max_lines)" --argjson enforcement "$enf" --argjson projections "$prj" \
  --rawfile raw "$ROOT/share/skeleton/policy.yaml" \
  '{schema: 1, version: $version,
    context: {always_loaded_budget_lines: $budget, strategy: $strategy, transcript_is_state: $transcript},
    profiles: {default: $default_profile, checkpoint_interval_default: $checkpoint},
    verification: {required_for_changes: $req_changes, finish_requires: $finish},
    handover: {required_sections: $sections, retention_max_files: $ho_cap},
    ledger: {retention_max_lines: $ledger_cap}, enforcement: $enforcement, projections: $projections,
    raw: $raw}' > "$OUT/policy.json"
rm -f "$P"

mj_phase_end "gen:policy.json" "$GEN_T0"
# ---------------------------------------------------------------- capabilities.json (from docs/CLAIMS.yaml)
GEN_T0="$(mj_phase_begin "gen:capabilities.json_from_docs")"
Cf="$(flat "$ROOT/docs/CLAIMS.yaml")"; yload "$Cf"
# A claim's owning command is its implementation file, matched against the commands the
# binary actually dispatches. The literal list this replaced predated every continuity
# command, so their claims published with nothing to link to. An empty join would silently
# produce `^lib/()\.sh$`, which matches nothing and would set every command to null, so the
# emptiness is a refusal rather than a quiet no-op.
COMMAND_NAMES="$(printf '%s' "$COMMANDS" | jq -r '[.[].name] | join("|")')"
[ -n "$COMMAND_NAMES" ] || { echo "generate-site-data: the dispatch table in bin/majordomus yielded no commands" >&2; exit 10; }
COMMAND_RE="^lib/($COMMAND_NAMES)\\.sh$"
{
  i=0; first=1; printf '{"schema":1,"statuses":{'; k=0; sfirst=1
  while [ -n "$(yv "$Cf" "statuses.$k.id")" ]; do
    [ "$sfirst" = 1 ] || printf ','; sfirst=0
    printf '%s:%s' "$(jstr "$(yv "$Cf" "statuses.$k.id")")" "$(jstr "$(yv "$Cf" "statuses.$k.meaning")")"
    k=$((k+1))
  done
  [ "$k" -gt 0 ] || { echo "generate-site-data: docs/CLAIMS.yaml declares no statuses" >&2; exit 10; }
  printf '},"claims":['
  while [ -n "$(yv "$Cf" "claims.$i.id")" ]; do
    [ "$first" = 1 ] || printf ','; first=0
    jq -cn --arg id "$(yv "$Cf" "claims.$i.id")" --arg claim "$(yv "$Cf" "claims.$i.claim")" --arg source "$(yv "$Cf" "claims.$i.source")" \
      --arg impl "$(yv "$Cf" "claims.$i.implementation")" --arg test "$(yv "$Cf" "claims.$i.test")" --arg status "$(yv "$Cf" "claims.$i.status")" \
      --arg note "$(yv "$Cf" "claims.$i.note")" \
      --arg resp "$(yv "$Cf" "claims.$i.responsibility")" \
      --arg cmdre "$COMMAND_RE" \
      '{id:$id, claim:$claim, source:$source, implementation:(if $impl=="-" then null else $impl end), test:(if $test=="-" then null else $test end), status:$status, note:(if $note=="" then null else $note end),
        responsibility:(if $resp=="" then null else $resp end),
        source_route: ($source | if test("^docs/[A-Z_]+\\.md$") then "/docs/" + (ltrimstr("docs/") | rtrimstr(".md") | ascii_downcase | gsub("_";"-")) + "/"
                                elif . == "AGENTS.md" then "/docs/contract/"
                                elif startswith("share/skeleton/profiles/") then "/profiles/" + (ltrimstr("share/skeleton/profiles/") | rtrimstr(".yaml")) + "/"
                                elif startswith("share/skeleton/policy") then "/policy/" else null end),
        command: (if $impl | test($cmdre) then ($impl | ltrimstr("lib/") | rtrimstr(".sh")) else null end),
        test_case: (if $test == "-" then null else ($test | ltrimstr("test/cases/") | rtrimstr(".sh")) end)}'
    i=$((i+1))
  done; printf ']}'
} | jq . > "$OUT/capabilities.json"
rm -f "$Cf"
# every referenced path must exist; a guaranteed claim must name a test
jq -r '.claims[] | [.id, .status, .source, (.implementation // "-"), (.test // "-")] | @tsv' "$OUT/capabilities.json" | while IFS="$MJ_TAB" read -r id status src impl test; do
  for p in "$src" "$impl" "$test"; do
    if [ "$p" != "-" ] && [ ! -e "$ROOT/$p" ]; then echo "generate-site-data: claim $id names missing path $p" >&2; exit 10; fi
  done
  if [ "$status" = guaranteed ] && [ "$test" = "-" ]; then echo "generate-site-data: guaranteed claim $id has no test" >&2; exit 10; fi
done

mj_phase_end "gen:capabilities.json_from_docs" "$GEN_T0"
# ---------------------------------------------------------------- lifecycle.json
GEN_T0="$(mj_phase_begin "gen:lifecycle.json")"
OUTCOMES="$(grep -oE 'completed\|partial\|blocked\|no_match\|failed' "$ROOT/lib/finish.sh" | head -1 | tr '|' '\n' | jarr)"
# The labels are the ones mj_git_label can actually print, read out of the function that
# prints them. A label listed here that the function cannot produce would be a vocabulary
# the site teaches and the tool never uses.
LABELS="$(awk '/^mj_git_label\(\)/ { f = 1 } f && /printf/ { if (match($0, /printf '"'"'[a-z_]+'"'"'/)) {
             lbl = substr($0, RSTART + 8, RLENGTH - 9); if (!(lbl in seen)) { seen[lbl] = 1; print lbl } } }
           f && /^}/ { exit }' "$ROOT/lib/common.sh" | jarr)"
[ "$(printf '%s' "$LABELS" | jq length)" -ge 2 ] \
  || { echo "generate-site-data: no divergence labels in lib/common.sh mj_git_label" >&2; exit 10; }
# The lifecycle is the block the seeded task-lifecycle workflow carries, in the order it
# carries it; what each command does is the CLI's own one-line summary. Neither is written here.
STEPS="$(awk '/^```$/ { n++; next } n == 1 && /^majordomus [a-z]+/ { print $2 }' \
             "$ROOT/share/skeleton/ai/repo/workflows/task-lifecycle.md" \
  | while read -r c; do
      printf '%s\t%s\n' "$c" "$(awk -v c="$c" '$1 == c && NF > 1 { $1 = ""; sub(/^ +/, ""); sub(/ +\(read-only\)$/, ""); sub(/ +$/, ""); print; exit }' \
        <(sed -n '/^usage()/,/^USAGE$/p' "$ROOT/bin/majordomus" | sed -E 's/^  ([a-z]+)( <[^>]*>)?  +/\1 /'))"
    done | jq -Rn '[inputs | split("\t") | {command: .[0], what: .[1]}]')"
[ "$(printf '%s' "$STEPS" | jq length)" -ge 4 ] \
  || { echo "generate-site-data: no lifecycle block in share/skeleton/ai/repo/workflows/task-lifecycle.md" >&2; exit 10; }
# The principles are the rules of the standard package tagged principle, in the order the
# package manifest lists them; the title of each is the sentence a worker reads.
PRINCIPLES="$(
  Mf="$(flat "$ROOT/share/standard/majordomus/manifest.yaml")"; yload "$Mf"; k=0
  while [ -n "$(yv "$Mf" "rules.$k.file")" ]; do
    rf="$ROOT/share/standard/majordomus/$(yv "$Mf" "rules.$k.file")"
    fm="$(mktemp "${TMPDIR:-/tmp}/mj.pf.XXXXXX")"; mj_record_front "$rf" > "$fm"; Ff="$(flat "$fm")"; yload "$Ff"
    if ylist "$Ff" tags | grep -qx principle; then yv "$Ff" title; fi
    rm -f "$fm" "$Ff"; k=$((k+1))
  done; rm -f "$Mf"
)"
PRINCIPLES="$(printf '%s\n' "$PRINCIPLES" | jarr)"
[ "$(printf '%s' "$PRINCIPLES" | jq length)" -ge 8 ] || { echo "generate-site-data: expected the principle rules in share/standard/majordomus" >&2; exit 10; }
jq -n --argjson outcomes "$OUTCOMES" --argjson labels "$LABELS" --argjson steps "$STEPS" --argjson principles "$PRINCIPLES" \
  '{schema:1, outcomes:$outcomes, divergence_labels:$labels, steps:$steps, principles:$principles}' > "$OUT/lifecycle.json"

# hand-written site pages (no product claims) get the same projection; the source is site/content-src/
for srcp in $(cd "$ROOT/site/content-src" && find . -name '*.md' | sed 's#^\./##' | sort); do
  srcp="$ROOT/site/content-src/$srcp"; rel="${srcp#"$ROOT"/site/content-src/}"
  dst="$STAGE/content/$rel"
  mkdir -p "$(dirname "$dst")"
  awk 'BEGIN{n=0} /^\+\+\+/{n++; print; next} n<2{print; next} n==2 && !b{print "{% raw %}"; b=1} {print}' "$srcp" \
    | awk -v lib="$ROOT/scripts/lib/project-markdown.awk" 'BEGIN{n=0} /^\+\+\+/{n++; print; next} n<2{print; next} {print | ("awk -f " lib)}' > "$dst"
  printf '{%% endraw %%}\n' >> "$dst"
done

mj_phase_end "gen:lifecycle.json" "$GEN_T0"
# ---------------------------------------------------------------- readme.json (fragments the homepage renders)
GEN_T0="$(mj_phase_begin "gen:readme.json_fragments_the_ho")"
section_of() { # file, heading, next-heading -> body between them; fails if the heading is missing
  grep -qx "## $2" "$1" || { echo "generate-site-data: README.md has no heading '## $2' (the site renders it)" >&2; exit 10; }
  awk -v h="## $2" -v n="## $3" '$0==h{f=1;next} f&&$0==n{exit} f' "$1"
}
FINISH_BLOCK="$(awk '/^```/{c++; if(c==1){f=1;next} if(c==2){exit}} f' "$ROOT/README.md")"
[ -n "$FINISH_BLOCK" ] || { echo "generate-site-data: README.md has no first fenced block (the hero renders it)" >&2; exit 10; }
# the five lines of the finish contract, read out of the transcript itself rather than listed
# again here: the hero animation and the transcript below it are then the same five checks
FINISH_CHECKS="$(printf '%s\n' "$FINISH_BLOCK" | awk '/^(OK|FAIL)[[:space:]]/{print $2}' | awk '!seen[$0]++' | jarr)"
[ "$(printf '%s' "$FINISH_CHECKS" | jq length)" -ge 4 ] || { echo "generate-site-data: the README finish transcript no longer lists its checks" >&2; exit 10; }
DOES_ROWS="$(section_of "$ROOT/README.md" "What it does" "Quick start" | grep -E '^\| \*\*' | sed -E 's/^\| \*\*([^*]+)\*\* \| (.*) \|$/\1|\2/' | jq -Rn '[inputs | split("|") | {title: .[0], text: .[1]}]')"
PROBLEM_MD="$(section_of "$ROOT/README.md" "The problem" "What it does")"
jq -n --arg finish "$FINISH_BLOCK" --arg problem "$PROBLEM_MD" --argjson checks "$FINISH_CHECKS" \
  --arg problem_bullets "$(printf '%s' "$PROBLEM_MD" | awk '/^- /{f=1} f&&/^$/{exit} f')" \
  --arg notwhat "$(section_of "$ROOT/README.md" "What this is not" "Limitations")" --argjson does "$DOES_ROWS" \
  --arg limits "$(section_of "$ROOT/README.md" "Limitations" "Roadmap")" \
  '{schema:1, finish_transcript:$finish, finish_checks:$checks, problem_md:$problem, problem_bullets_md:$problem_bullets, not_md:$notwhat, limitations_md:$limits, does:$does}' > "$OUT/readme.json"

mj_phase_end "gen:readme.json_fragments_the_ho" "$GEN_T0"
# ---------------------------------------------------------------- commands.json (from share/commands.yaml)
GEN_T0="$(mj_phase_begin "gen:commands.json_from_share_com")"
# The registry owns what a command is; docs/CLI.md supplies the narrative; the coverage
# metadata each test case declares about itself supplies the evidence. Nothing here restates
# a fact that one of those three already holds.
Kf="$(flat "$ROOT/share/commands.yaml")"; yload "$Kf"
COVER="$(mktemp "${TMPDIR:-/tmp}/mj.cov.XXXXXX")"
for f in "$ROOT"/test/cases/*.sh; do
  n="$(basename "$f" .sh)"
  for c in $(sed -n 's/^# majordomus-covers: *//p' "$f" | head -1); do
    [ "$c" = none ] && continue
    printf '%s\tbehaviour\t%s\n' "$c" "$n" >> "$COVER"
  done
  for c in $(sed -n 's/^# majordomus-negative: *//p' "$f" | head -1); do
    printf '%s\tnegative\t%s\n' "$c" "$n" >> "$COVER"
  done
done
cover_json() { awk -F'\t' -v c="$1" -v l="$2" '$1==c && $2==l {print $3}' "$COVER" | sort -u | jarr; }
# The demonstration is the fixture test/cases/34_command_fixtures.sh executes, with each
# scenario's setup script inlined so the page can show the preparation it ran against. A
# page that rendered a different scenario from the one the tests run would be a second
# implementation, which is the thing this whole arrangement exists to prevent.
FIXDIR="$ROOT/test/fixtures/commands"
demo_json() {
  local fx="$FIXDIR/$1.json"
  [ -f "$fx" ] || { echo "generate-site-data: command $1 has no fixture at test/fixtures/commands/$1.json" >&2; exit 10; }
  local tmp; tmp="$(mktemp "${TMPDIR:-/tmp}/mj.demo.XXXXXX")"
  cp "$fx" "$tmp"
  local sid setup body stdin
  for sid in $(jq -r '.scenarios[].id' "$fx"); do
    setup="$(jq -r --arg s "$sid" '.scenarios[] | select(.id==$s) | .setup' "$fx")"
    body="$(cat "$FIXDIR/setup/$setup.sh")"
    stdin="$(jq -r --arg s "$sid" '.scenarios[] | select(.id==$s) | .stdin // ""' "$fx")"
    if [ -n "$stdin" ]; then stdin="$(cat "$FIXDIR/stdin/$stdin")"; fi
    jq --arg s "$sid" --arg b "$body" --arg i "$stdin" \
      '.scenarios |= map(if .id == $s then . + {setup_sh: $b, stdin_body: (if $i == "" then null else $i end)} else . end)' \
      "$tmp" > "$tmp.n" && mv "$tmp.n" "$tmp"
  done
  jq -c . "$tmp"; rm -f "$tmp" "$tmp.n"
}
# Everything that can refuse runs before a byte is written. An `exit` inside a
# `{ ... } | jq . > file` group kills the group while the redirect has already truncated the
# target, so the refusal would be reported as jq's parse error and leave a ruined file.
i=0
while [ -n "$(yv "$Kf" "commands.$i.id")" ]; do
  cid="$(yv "$Kf" "commands.$i.id")"
  if [ "$(yv "$Kf" "commands.$i.visibility")" = public ]; then
    awk -v h="## \`majordomus $cid" 'index($0,h)==1{f=1;found=1;next} f&&/^## /{exit} f' "$ROOT/docs/CLI.md" | grep -q . \
      || { echo "generate-site-data: docs/CLI.md has no section for command '$cid'" >&2; exit 10; }
    [ -f "$FIXDIR/$cid.json" ] \
      || { echo "generate-site-data: command $cid has no fixture at test/fixtures/commands/$cid.json" >&2; exit 10; }
    d="$(yv "$Kf" "commands.$i.demo")"
    [ -n "$d" ] && [ "$d" != none ] \
      || { echo "generate-site-data: command $cid declares no demo" >&2; exit 10; }
    [ -n "$(cover_json "$cid" behaviour | jq -r '.[0] // empty')" ] \
      || { echo "generate-site-data: command $cid has no behavioural test; add one and declare it in that case's header" >&2; exit 10; }
    [ -n "$(cover_json "$cid" negative | jq -r '.[0] // empty')" ] \
      || { echo "generate-site-data: command $cid has no negative test; add one and declare it in that case's header" >&2; exit 10; }
  fi
  i=$((i+1))
done

{
  printf '{"schema":1,"stages":['
  i=0; first=1
  while [ -n "$(yv "$Kf" "stages.$i.id")" ]; do
    [ "$first" = 1 ] || printf ','; first=0
    jq -cn --arg id "$(yv "$Kf" "stages.$i.id")" --arg title "$(yv "$Kf" "stages.$i.title")" '{id:$id, title:$title}'
    i=$((i+1))
  done
  printf '],"commands":['
  i=0; first=1
  while [ -n "$(yv "$Kf" "commands.$i.id")" ]; do
    cid="$(yv "$Kf" "commands.$i.id")"
    if [ "$(yv "$Kf" "commands.$i.visibility")" != public ]; then i=$((i+1)); continue; fi
    body="$(awk -v h="## \`majordomus $cid" 'index($0,h)==1{f=1;next} f&&/^## /{exit} f' "$ROOT/docs/CLI.md" | sed -E "$LINKSED")"

    cls="$(yv "$Kf" "commands.$i.class")"
    if [ "$cls" = read-only ]; then ro=true; else ro=false; fi
    [ "$first" = 1 ] || printf ','; first=0
    jq -cn --arg n "$cid" --arg summary "$(yv "$Kf" "commands.$i.summary")" \
      --arg category "$(yv "$Kf" "commands.$i.category")" --arg stage "$(yv "$Kf" "commands.$i.stage")" \
      --arg class "$cls" --argjson read_only "$ro" \
      --arg requires_task "$(yv "$Kf" "commands.$i.requires_task")" \
      --argjson requires_repository "$(jbool "$(yv "$Kf" "commands.$i.requires_repository")")" \
      --argjson requires_installed "$(jbool "$(yv "$Kf" "commands.$i.requires_installed")")" \
      --argjson json_output "$(jbool "$(yv "$Kf" "commands.$i.json")")" \
      --arg syntax "$(yv "$Kf" "commands.$i.syntax")" --arg demo "$(yv "$Kf" "commands.$i.demo")" \
      --arg note "$(yv "$Kf" "commands.$i.note")" --arg body "$body" \
      --argjson reads "$(ylist_json "$Kf" "commands.$i.reads")" \
      --argjson writes "$(ylist_json "$Kf" "commands.$i.writes")" \
      --argjson exit_codes "$(ylist "$Kf" "commands.$i.exit_codes" | jq -sc 'map(tonumber)')" \
      --argjson behaviour "$(cover_json "$cid" behaviour)" \
      --argjson negative "$(cover_json "$cid" negative)" \
      --argjson demo_data "$(demo_json "$cid")" \
      '{name:$n, summary:$summary, category:$category, stage:$stage, class:$class, read_only:$read_only,
        requires_task:$requires_task, requires_repository:$requires_repository, requires_installed:$requires_installed,
        json_output:$json_output, syntax:$syntax, demo:$demo, note:(if $note=="" then null else $note end),
        reads:$reads, writes:$writes, exit_codes:$exit_codes,
        tests:{behaviour:$behaviour, negative:$negative}, demo_data:$demo_data, doc_md:$body}'
    i=$((i+1))
  done
  printf ']}'
} | jq . > "$OUT/commands.json"
rm -f "$Kf" "$COVER"

mj_phase_end "gen:commands.json_from_share_com" "$GEN_T0"
# ---------------------------------------------------------------- responsibilities (README "What it does" rows, cross-linked)
GEN_T0="$(mj_phase_begin "gen:responsibilities_README_What")"
# The cross-links are data: which command owns a responsibility and which claims mention it,
# derived from canonical docs/RESPONSIBILITIES.yaml and docs/CLAIMS.yaml.
Rf="$(flat "$ROOT/docs/RESPONSIBILITIES.yaml")"; yload "$Rf"
[ "$(yv "$Rf" version)" = 1 ] || { echo "generate-site-data: docs/RESPONSIBILITIES.yaml must be version 1" >&2; exit 10; }
# The join below is by README row title, and a join is silent when it misses: an entry whose
# readme_key no longer matches a row is never visited, and a row with no entry falls through
# to a page with a null command and an empty claim list. Both look like a responsibility that
# simply has nothing to say. So the correspondence is checked in both directions here, along
# with the paths and headings each entry points at, before anything is rendered from it.
README_TITLES="$(jq -r '.does[].title' "$OUT/readme.json")"
[ -n "$README_TITLES" ] || { echo "generate-site-data: the README 'What it does' table produced no rows" >&2; exit 10; }
heading_in() { # anchor, file -> the anchor is a level-two heading, bare or backticked
  grep -qxF "## $1" "$2" || grep -qxF "## \`$1\`" "$2"
}
# Zola's heading anchors: lowercase, every run of non-alphanumerics becomes one dash.
anchor_slug() { printf '%s' "$1" | tr 'A-Z' 'a-z' | sed -e 's/[^a-z0-9][^a-z0-9]*/-/g' -e 's/^-//' -e 's/-$//'; }
RESP_KEYS=""
i=0
while [ -n "$(yv "$Rf" "responsibilities.$i.id")" ]; do
  rid="$(yv "$Rf" "responsibilities.$i.id")"
  rk="$(yv "$Rf" "responsibilities.$i.readme_key")"
  printf '%s\n' "$README_TITLES" | grep -qxF "$rk" \
    || { echo "generate-site-data: responsibility $rid names README row '$rk', which the 'What it does' table does not have" >&2; exit 10; }
  # Paths under the AI layer are runtime state that `init` creates in a consuming repository, not
  # source files: a source-only checkout legitimately has none, and requiring them would make
  # the generator refuse to run there. They are checked whenever the directory exists at all,
  # which is every initialised repository including this one, so a moved or renamed runtime
  # path is still caught rather than excused.
  for p in $(ylist "$Rf" "responsibilities.$i.files") "$(yv "$Rf" "responsibilities.$i.implementation")"; do
    [ -n "$p" ] || { echo "generate-site-data: responsibility $rid declares an empty path" >&2; exit 10; }
    # policy.yaml is what `init` writes, so it marks an initialised repository. Testing for
    # the directory instead would be wrong: the project directory is a canonical generator
    # input, so the directory exists wherever those files were copied, initialised or not.
    # the local half is this checkout's own and absent on a fresh clone by design: a path
    # under it is named, never required
    case "$p" in "$LOCAL"/*) continue ;; "$AI"/*) [ -f "$MJ_POLICY_FILE" ] || continue ;; esac
    [ -e "$ROOT/$p" ] || { echo "generate-site-data: responsibility $rid names missing path $p" >&2; exit 10; }
  done
  for a in cli_anchor:docs/CLI.md schema_anchor:docs/SCHEMAS.md; do
    fld="${a%%:*}"; doc="${a#*:}"; val="$(yv "$Rf" "responsibilities.$i.$fld")"
    [ -n "$val" ] || { echo "generate-site-data: responsibility $rid declares an empty $fld" >&2; exit 10; }
    heading_in "$val" "$ROOT/$doc" \
      || { echo "generate-site-data: responsibility $rid names $fld '$val', which is not a heading in $doc" >&2; exit 10; }
  done
  RESP_KEYS="$RESP_KEYS$rk
"
  i=$((i+1))
done
[ "$i" -gt 0 ] || { echo "generate-site-data: docs/RESPONSIBILITIES.yaml declares no responsibilities" >&2; exit 10; }
# and the other direction, fed by a here-document rather than a pipe so that the refusal
# exits the generator instead of a subshell of it
while IFS= read -r t; do
  [ -n "$t" ] || continue
  printf '%s\n' "$RESP_KEYS" | grep -qxF "$t" \
    || { echo "generate-site-data: README row '$t' has no entry in docs/RESPONSIBILITIES.yaml" >&2; exit 10; }
done <<EOF
$README_TITLES
EOF
# Every fact a responsibility page shows comes from the canonical index or the README row,
# joined here so that the templates only render: the owning command, the files that hold
# the state, the implementation, and the two deep links into the specification.
RESP_JSON="$(
  i=0; printf '['
  first=1
  while [ -n "$(yv "$Rf" "responsibilities.$i.id")" ]; do
    [ "$first" = 1 ] || printf ','; first=0
    rid="$(yv "$Rf" "responsibilities.$i.id")"
    rcli="$(yv "$Rf" "responsibilities.$i.cli_anchor")"
    rsch="$(yv "$Rf" "responsibilities.$i.schema_anchor")"
    jq -cn --arg id "$rid" --arg title "$(yv "$Rf" "responsibilities.$i.title")" --arg key "$(yv "$Rf" "responsibilities.$i.readme_key")" \
      --arg command "$(yv "$Rf" "responsibilities.$i.command")" --arg impl "$(yv "$Rf" "responsibilities.$i.implementation")" \
      --arg cli "$rcli" --arg cli_route "/docs/cli/#$(anchor_slug "$rcli")" \
      --arg schema "$rsch" --arg schema_route "/docs/schemas/#$(anchor_slug "$rsch")" \
      --argjson order "$(jnum_or_str "$(yv "$Rf" "responsibilities.$i.order")")" \
      --argjson files "$(ylist_json "$Rf" "responsibilities.$i.files")" \
      '{id:$id, title:$title, readme_key:$key, command:(if $command=="" then null else $command end),
        implementation:$impl, files:$files, order:$order,
        cli_anchor:$cli, cli_route:$cli_route, schema_anchor:$schema, schema_route:$schema_route}'
    i=$((i+1))
  done
  printf ']'
)"
rm -f "$Rf"
# Every claim declares which responsibility it belongs to, or declares `none` and says why.
# An absent field would put the claim on no page and report nothing — the same silence the
# keyword matching this join replaced, one level down.
claim_resp_bad="$(jq -r --argjson r "$RESP_JSON" '
  ([$r[].id] + ["none"]) as $known
  | [ .claims[] | select(.responsibility == null) | .id ] as $absent
  | [ .claims[] | select(.responsibility != null and ((.responsibility | IN($known[])) | not)) | .id ] as $unknown
  | (if ($absent | length) > 0 then
       "claims with no responsibility field: " + ($absent | join(", ")) + " — declare one, or `responsibility: none` with the reason"
     else "" end)
  + (if ($unknown | length) > 0 then
       (if ($absent | length) > 0 then "; " else "" end)
       + "claims naming a responsibility that does not exist: " + ($unknown | join(", "))
     else "" end)' "$OUT/capabilities.json")"
[ -z "$claim_resp_bad" ] || { echo "generate-site-data: $claim_resp_bad" >&2; exit 10; }
# No fallback for a missing row: the loop above has already refused that case, and a default
# here would quietly restore the silence it exists to remove.
jq_inplace "$OUT/readme.json" --argjson r "$RESP_JSON" --slurpfile caps "$OUT/capabilities.json" '
  .does |= ([ .[] as $row
    | ($r[] | select(.readme_key == $row.title)) as $e
    | [ $caps[0].claims[] | select(.responsibility == $e.id) | .id ] as $cids
    | $row + $e + {slug: $e.id, claim_ids: $cids} ]
    | sort_by(.order))'

mj_phase_end "gen:responsibilities_README_What" "$GEN_T0"
# ---------------------------------------------------------------- doctrines.json
GEN_T0="$(mj_phase_begin "gen:doctrines.json")"
# Every field the site shows about a doctrine is either in the rule object or resolved from
# the source here — which file defines the validator, which commands dispatch it, which
# claims it backs. The site never states that something is enforced; it shows the chain.
# The registry is the standard rule package the distribution ships, loaded through the
# tool's own loader as the one vendored package of an otherwise empty rules section, so
# the site and `majordomus doctrine list` in a fresh repository describe the same set.
# shellcheck source=../lib/doctrine.sh
. "$ROOT/lib/doctrine.sh"
RULES_TMP="$(mktemp -d "${TMPDIR:-/tmp}/mj.gr.XXXXXX")"
mkdir -p "$RULES_TMP/vendor"; cp -R "$ROOT/share/standard/majordomus" "$RULES_TMP/vendor/majordomus"
# the loader reads MJ_RULES_DIR; it is pointed at the temporary section for the load only
# and restored afterwards, because the layout table the architecture scan takes must
# describe the repository, not a temporary directory
SAVED_RULES_DIR="$MJ_RULES_DIR"
MJ_RULES_DIR="$RULES_TMP"; MJ_RULES_LOADED=0; MJ_DOC_FLAT=""; export MJ_RULES_DIR MJ_RULES_LOADED MJ_DOC_FLAT
mj_rules_load || { echo "generate-site-data: the standard rule package does not resolve: $MJ_RULES_ERROR" >&2; exit 10; }
mj_doctrine_load
MJ_RULES_DIR="$SAVED_RULES_DIR"
Df="$MJ_DOC_FLAT"; yload "$Df"
# the principle a doctrine rests on: the rule tagged principle among its dependencies
principle_of() { # doctrine index -> title of the principle rule it depends on
  local d k
  for d in $(ylist "$Df" "doctrines.$1.depends_on"); do
    k="$(mj_rule_index "${d%@*}")" || continue
    if mj_rule_list "$k" tags | grep -qx principle; then mj_rule "$k" title; return 0; fi
  done
  return 0
}
# Validate the whole registry before emitting anything. A check inside the emitting
# pipeline runs in a subshell and would leave a half-written file behind.
# The three facts every doctrine is checked against are properties of the tree, not of the
# doctrine, so they are read once here rather than re-scanned per doctrine. Scanning lib/ and
# CLAIMS.yaml inside the loop cost more than the rest of the generator put together.
VALIDATOR_FILES="$(grep -rnoE '^mj_validate_[a-z_]+\(\)' "$ROOT/lib" 2>/dev/null | sed "s#^$ROOT/##" | awk -F: '{n=$3; sub(/^mj_validate_/,"",n); sub(/\(\)$/,"",n); if (!(n in seen)) { seen[n]=1; print n "\t" $1 }}')"
DEFINED_VALIDATORS=" $(printf '%s\n' "$VALIDATOR_FILES" | cut -f1 | tr '\n' ' ')"
DISPATCHING=" $(grep -lF 'mj_doctrine_dispatch' "$ROOT"/lib/*.sh 2>/dev/null | sed 's#.*/##; s#\.sh$##' | tr '\n' ' ')"
KNOWN_CLAIM_IDS=" $(sed -n 's/^  - id: //p' "$ROOT/docs/CLAIMS.yaml" | tr '\n' ' ')"
has() { case "$2" in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
i=0
while [ -n "$(yv "$Df" "doctrines.$i.id")" ]; do
  id="$(yv "$Df" "doctrines.$i.id")"; val="$(yv "$Df" "doctrines.$i.validator")"
  cls="$(yv "$Df" "doctrines.$i.class")"
  has "$val" "$DEFINED_VALIDATORS" \
    || { echo "generate-site-data: doctrine $id names validator '$val' but no lib/ file defines mj_validate_$val" >&2; exit 10; }
  for tst in $(ylist "$Df" "doctrines.$i.tests"); do
    [ -f "$ROOT/$tst" ] || { echo "generate-site-data: doctrine $id names test $tst, which does not exist" >&2; exit 10; }
  done
  case "$cls" in blocking|advisory) ;; *) echo "generate-site-data: doctrine $id has class '$cls' (blocking | advisory)" >&2; exit 10 ;; esac
  j=0; while c="$(yv "$Df" "doctrines.$i.enforced_by.$j")"; [ -n "$c" ]; do
    has "$c" "$DISPATCHING" \
      || { echo "generate-site-data: doctrine $id is declared for '$c', which does not dispatch" >&2; exit 10; }
    j=$((j+1)); done
  j=0; while cid="$(yv "$Df" "doctrines.$i.claims.$j")"; [ -n "$cid" ]; do
    has "$cid" "$KNOWN_CLAIM_IDS" \
      || { echo "generate-site-data: doctrine $id names claim '$cid', which is not in docs/CLAIMS.yaml" >&2; exit 10; }
    j=$((j+1)); done
  i=$((i+1))
done
# Nothing in lib/ may validate outside a declared doctrine — the orphan check doctor runs,
# repeated here so a broken chain cannot reach the published site at all.
DECLARED=" $(i=0; while [ -n "$(yv "$Df" "doctrines.$i.validator")" ]; do printf '%s ' "$(yv "$Df" "doctrines.$i.validator")"; i=$((i+1)); done)"
for fn in $(printf '%s\n' "$VALIDATOR_FILES" | cut -f1); do
  case "$DECLARED" in *" $fn "*) ;; *) echo "generate-site-data: lib/ defines mj_validate_$fn, which no doctrine declares" >&2; exit 10 ;; esac
done
{
  printf '{"schema":1,"doctrines":['
  i=0; first=1
  while [ -n "$(yv "$Df" "doctrines.$i.id")" ]; do
    id="$(yv "$Df" "doctrines.$i.id")"; val="$(yv "$Df" "doctrines.$i.validator")"
    defined_in="$(printf '%s\n' "$VALIDATOR_FILES" | awk -F'\t' -v v="$val" '$1==v {print $2; exit}')"
    cmds=""; j=0
    while [ -n "$(yv "$Df" "doctrines.$i.enforced_by.$j")" ]; do cmds="$cmds$(jstr "$(yv "$Df" "doctrines.$i.enforced_by.$j")")," ; j=$((j+1)); done
    cl=""; j=0
    while [ -n "$(yv "$Df" "doctrines.$i.claims.$j")" ]; do cl="$cl$(jstr "$(yv "$Df" "doctrines.$i.claims.$j")")," ; j=$((j+1)); done
    [ "$first" = 1 ] || printf ','; first=0
    dep=""; j=0
    while [ -n "$(yv "$Df" "doctrines.$i.depends_on.$j")" ]; do dep="$dep$(jstr "$(yv "$Df" "doctrines.$i.depends_on.$j")")," ; j=$((j+1)); done
    rulefile="share/standard/majordomus/$(printf '%s' "$(yv "$Df" "doctrines.$i.file")" | sed 's#^.*/vendor/majordomus/##')"
    printf '{"id":%s,"slug":%s,"title":%s,"class":%s,"principle":%s,"statement":%s,"summary":%s,"validator":%s,"validator_function":%s,"defined_in":%s,"category":%s,"enforced_by":[%s],"exit_code":%s,"policy_key":%s,"claims":[%s],"test":%s,"depends_on":[%s],"source":%s}' \
      "$(jstr "$id")" "$(jstr "${id#majordomus.}")" "$(jstr "$(yv "$Df" "doctrines.$i.title")")" \
      "$(jstr "$(yv "$Df" "doctrines.$i.class")")" "$(jstr "$(principle_of "$i")")" "$(jstr "$(yv "$Df" "doctrines.$i.statement")")" \
      "$(jstr "$(yv "$Df" "doctrines.$i.summary")")" "$(jstr "$val")" "$(jstr "mj_validate_$val")" "$(jstr "$defined_in")" \
      "$(jstr "$(yv "$Df" "doctrines.$i.category")")" "${cmds%,}" \
      "$(jnum_or_str "$(yv "$Df" "doctrines.$i.exit_code")")" "$(jstr "$(yv "$Df" "doctrines.$i.policy_key")")" \
      "${cl%,}" "$(jstr "$(yv "$Df" "doctrines.$i.test")")" "${dep%,}" "$(jstr "$rulefile")"
    i=$((i+1))
  done
  printf ']}'
} | jq . > "$OUT/doctrines.json"
# The counts the site prints come from the data, so a doctrine cannot be added without them moving.
jq_inplace "$OUT/doctrines.json" '. + {counts: {declared: (.doctrines|length),
                  blocking: ([.doctrines[]|select(.class=="blocking")]|length),
                  advisory: ([.doctrines[]|select(.class=="advisory")]|length)},
         index: (reduce (.doctrines|to_entries[]) as $e ({}; . + {($e.value.id): $e.key}))}'

# Which doctrines enforce a responsibility is a join, not an opinion: a doctrine enforces a
# responsibility when it backs one of that responsibility's claims. Computed here so the
# template only renders, and so a doctrine added tomorrow appears on the page it belongs to.
jq_inplace "$OUT/readme.json" --slurpfile docs "$OUT/doctrines.json" '
  .does |= map(. as $row
    | . + {doctrine_ids: [ $docs[0].doctrines[]
        | select((.claims // []) | any(IN($row.claim_ids[]))) | .id ]})'

mj_phase_end "gen:doctrines.json" "$GEN_T0"
# ---------------------------------------------------------------- why.json (the five moments, as data)
GEN_T0="$(mj_phase_begin "gen:why.json_the_five_moments_as")"
# The moments are hand-written prose in site/content-src/why/, but the links out of them are
# not prose: each page names the commands, responsibilities and claims it rests on. Those are
# read here, checked against the things they name, and published as data so the index, the
# graph and the backlinks on claim and responsibility pages are all the same list. A moment
# that names a claim, command or responsibility that does not exist fails the build; before
# this, a typo produced a 404 nobody would notice.
WHY_JSON="$(
  printf '['
  first=1
  for f in $(cd "$ROOT/site/content-src/why" && ls ./*.md | sed 's#^\./##' | grep -v '^_index\.md$' | sort); do
    p="$ROOT/site/content-src/why/$f"; slug="${f%.md}"
    [ "$first" = 1 ] || printf ','; first=0
    fm="$(awk 'BEGIN{n=0} /^\+\+\+$/{n++; next} n==1' "$p")"
    tget() { printf '%s' "$fm" | sed -n "s/^$1 = \"\(.*\)\"$/\1/p" | head -1; }
    tnum() { printf '%s' "$fm" | sed -n "s/^$1 = \([0-9]*\)$/\1/p" | head -1; }
    tarr() { printf '%s' "$fm" | sed -n "s/^$1 = \[\(.*\)\]$/\1/p" | head -1 \
             | tr ',' '\n' | sed 's/^ *"//; s/" *$//; s/^ *//; s/ *$//' | grep -v '^$' | jarr; }
    jq -cn --arg slug "$slug" --arg title "$(tget title | sed 's/\\"/"/g')" \
      --arg desc "$(tget description | sed 's/\\"/"/g')" --arg hook "$(tget hook | sed 's/\\"/"/g')" \
      --argjson weight "$(tnum weight)" --argjson cmds "$(tarr commands)" \
      --argjson resp "$(tarr responsibilities)" --argjson claims "$(tarr claims)" \
      '{slug:$slug, title:$title, description:$desc, hook:$hook, weight:$weight,
        route:("/why/" + $slug + "/"), commands:$cmds, responsibilities:$resp, claims:$claims}'
  done
  printf ']'
)"
printf '%s' "$WHY_JSON" | jq --slurpfile caps "$OUT/capabilities.json" --slurpfile rd "$OUT/readme.json" \
  --slurpfile pr "$OUT/project.json" '
  ($caps[0].claims | map(.id)) as $claim_ids
  | ($rd[0].does | map(.slug)) as $resp_slugs
  | ($pr[0].commands | map(.name)) as $cmd_names
  | {schema: 1,
     source: "site/content-src/why/",
     moments: [ sort_by(.weight)[] | . + {
       claim_detail: [ .claims[] as $c | $caps[0].claims[] | select(.id == $c) | {id, claim, status} ],
       command_detail: [ .commands[] as $n | $pr[0].commands[] | select(.name == $n) | {name, summary, read_only} ],
       responsibility_detail: [ .responsibilities[] as $s | $rd[0].does[] | select(.slug == $s) | {slug, title} ] } ],
     unknown: { claims: [ .[].claims[] | select(IN($claim_ids[]) | not) ] | unique,
                responsibilities: [ .[].responsibilities[] | select(IN($resp_slugs[]) | not) ] | unique,
                commands: [ .[].commands[] | select(IN($cmd_names[]) | not) ] | unique }}' > "$OUT/why.json"
for k in claims responsibilities commands; do
  bad="$(jq -r --arg k "$k" '.unknown[$k] | join(", ")' "$OUT/why.json")"
  [ -z "$bad" ] || { echo "generate-site-data: a why page names $k that do not exist: $bad" >&2; exit 10; }
done
jq 'del(.unknown)' "$OUT/why.json" > "$OUT/why.json.tmp" && mv "$OUT/why.json.tmp" "$OUT/why.json"
[ "$(jq '.moments | length' "$OUT/why.json")" -ge 3 ] || { echo "generate-site-data: site/content-src/why/ produced almost no moments" >&2; exit 10; }
# the reverse index the claim and responsibility pages need: which moments name this thing
jq '{schema: .schema, source: .source, moments: .moments,
     by_claim: (reduce (.moments[] | . as $m | $m.claims[] | {k:., v:$m.slug}) as $e ({}; .[$e.k] += [$e.v])),
     by_responsibility: (reduce (.moments[] | . as $m | $m.responsibilities[] | {k:., v:$m.slug}) as $e ({}; .[$e.k] += [$e.v])),
     by_command: (reduce (.moments[] | . as $m | $m.commands[] | {k:., v:$m.slug}) as $e ({}; .[$e.k] += [$e.v]))}' \
  "$OUT/why.json" > "$OUT/why.json.tmp" && mv "$OUT/why.json.tmp" "$OUT/why.json"

# the moments and the tool, as a graph: moment -> command -> claim, drawn by the same runtime
# as /map/ and /evidence/ rather than a third picture of the same relationships
jq '{schema: 1,
     source: "site/content-src/why/ front matter",
     edge_kinds: {addressed_by: "the command this moment is answered by",
                  backed_by: "the claim that says what the tool guarantees here",
                  supervises: "the responsibility this moment falls under"},
     nodes: ([.moments[] | {id: ("moment:" + .slug), kind: "moment", label: .hook, route: .route, external: false, summary: .description}]
             + ([.moments[] | .command_detail[] | {id: ("command:" + .name), kind: "command", label: ("majordomus " + .name), route: ("/commands/" + .name + "/"), external: false, summary: .summary}]
                + [.moments[] | .claim_detail[] | {id: ("claim:" + .id), kind: "claim", label: .id, status: .status, route: ("/guarantees/" + .id + "/"), external: false, summary: .claim}]
                + [.moments[] | .responsibility_detail[] | {id: ("responsibility:" + .slug), kind: "responsibility", label: .title, route: ("/supervises/" + .slug + "/"), external: false}]
                | unique_by(.id))),
     edges: ([.moments[] | . as $m | $m.commands[] | {source: ("moment:" + $m.slug), target: ("command:" + .), kind: "addressed_by"}]
             + [.moments[] | . as $m | $m.claims[] | {source: ("moment:" + $m.slug), target: ("claim:" + .), kind: "backed_by"}]
             + [.moments[] | . as $m | $m.responsibilities[] | {source: ("moment:" + $m.slug), target: ("responsibility:" + .), kind: "supervises"}]
             | unique)}' "$OUT/why.json" > "$OUT/why-graph.json"


mj_phase_end "gen:why.json_the_five_moments_as" "$GEN_T0"
# ---------------------------------------------------------------- catalogue.json
GEN_T0="$(mj_phase_begin "gen:catalogue.json")"
# Use cases and applications, with every reference resolved here rather than in a
# template. A dangling reference refuses the build, so a page cannot describe a command,
# rule or promise the tool does not have — the same rule doctor applies, applied again
# where the pages are made.
UCf="$(flat "$ROOT/share/use-cases.yaml")"; APf="$(flat "$ROOT/share/applications.yaml")"; yload "$UCf"; yload "$APf"
[ "$(yv "$UCf" version)" = 1 ] || { echo "generate-site-data: share/use-cases.yaml must be version 1" >&2; exit 10; }
[ "$(yv "$APf" version)" = 1 ] || { echo "generate-site-data: share/applications.yaml must be version 1" >&2; exit 10; }
cat_list() { # flat, prefix -> JSON array of strings
  local f="$1" pre="$2" k=0 out=""
  while [ -n "$(yv "$f" "$pre.$k")" ]; do out="$out$(jstr "$(yv "$f" "$pre.$k")")," ; k=$((k+1)); done
  printf '[%s]' "${out%,}"
}
cat_ids() { local f="$1" kind="$2" k=0; while [ -n "$(yv "$f" "$kind.$k.id")" ]; do printf '%s\n' "$(yv "$f" "$kind.$k.id")"; k=$((k+1)); done; }
cat_resolve() { # id must exist in the other catalogue
  printf '%s\n' "$2" | grep -qx "$1"
}
UC_IDS="$(cat_ids "$UCf" use_cases)"; AP_IDS="$(cat_ids "$APf" applications)"
DOC_IDS="$(jq -r '.doctrines[].id' "$OUT/doctrines.json")"
CLAIM_IDS="$(jq -r '.claims[].id' "$OUT/capabilities.json")"
CMD_IDS="$(jq -r '.commands[].name' "$OUT/commands.json")"
RESP_IDS="$(jq -r '.does[].slug' "$OUT/readme.json")"
i=0
while [ -n "$(yv "$UCf" "use_cases.$i.id")" ]; do
  id="$(yv "$UCf" "use_cases.$i.id")"
  for r in $(ylist "$UCf" "use_cases.$i.commands"); do cat_resolve "$r" "$CMD_IDS" || { echo "generate-site-data: use case $id names command '$r', which does not exist" >&2; exit 10; }; done
  for r in $(ylist "$UCf" "use_cases.$i.doctrines"); do cat_resolve "$r" "$DOC_IDS" || { echo "generate-site-data: use case $id names doctrine '$r', which does not exist" >&2; exit 10; }; done
  for r in $(ylist "$UCf" "use_cases.$i.claims"); do cat_resolve "$r" "$CLAIM_IDS" || { echo "generate-site-data: use case $id names claim '$r', which does not exist" >&2; exit 10; }; done
  for r in $(ylist "$UCf" "use_cases.$i.responsibilities"); do cat_resolve "$r" "$RESP_IDS" || { echo "generate-site-data: use case $id names responsibility '$r', which does not exist" >&2; exit 10; }; done
  for r in $(ylist "$UCf" "use_cases.$i.applications"); do cat_resolve "$r" "$AP_IDS" || { echo "generate-site-data: use case $id names application '$r', which does not exist" >&2; exit 10; }; done
  [ -n "$(yv "$UCf" "use_cases.$i.steps.0.command")" ] || { echo "generate-site-data: use case $id has no steps" >&2; exit 10; }
  i=$((i+1))
done
j=0
while [ -n "$(yv "$APf" "applications.$j.id")" ]; do
  id="$(yv "$APf" "applications.$j.id")"
  for r in $(ylist "$APf" "applications.$j.use_cases"); do cat_resolve "$r" "$UC_IDS" || { echo "generate-site-data: application $id names use case '$r', which does not exist" >&2; exit 10; }; done
  for r in $(ylist "$APf" "applications.$j.doctrines"); do cat_resolve "$r" "$DOC_IDS" || { echo "generate-site-data: application $id names doctrine '$r', which does not exist" >&2; exit 10; }; done
  [ -n "$(yv "$APf" "applications.$j.does_not_fit_when.0")" ] || { echo "generate-site-data: application $id declares no does_not_fit_when" >&2; exit 10; }
  j=$((j+1))
done
{
  printf '{"schema":1,"use_cases":['
  i=0; first=1
  while [ -n "$(yv "$UCf" "use_cases.$i.id")" ]; do
    [ "$first" = 1 ] || printf ','; first=0
    steps=""; k=0
    while [ -n "$(yv "$UCf" "use_cases.$i.steps.$k.command")" ]; do
      steps="$steps{\"command\":$(jstr "$(yv "$UCf" "use_cases.$i.steps.$k.command")"),\"note\":$(jstr "$(yv "$UCf" "use_cases.$i.steps.$k.note")")}," ; k=$((k+1)); done
    printf '{"id":%s,"title":%s,"weight":%s,"summary":%s,"situation":%s,"outcome":%s,"steps":[%s],"commands":%s,"doctrines":%s,"claims":%s,"responsibilities":%s,"applications":%s}' \
      "$(jstr "$(yv "$UCf" "use_cases.$i.id")")" "$(jstr "$(yv "$UCf" "use_cases.$i.title")")" \
      "$(jnum_or_str "$(yv "$UCf" "use_cases.$i.weight")")" "$(jstr "$(yv "$UCf" "use_cases.$i.summary")")" \
      "$(jstr "$(yv "$UCf" "use_cases.$i.situation")")" "$(jstr "$(yv "$UCf" "use_cases.$i.outcome")")" \
      "${steps%,}" "$(cat_list "$UCf" "use_cases.$i.commands")" "$(cat_list "$UCf" "use_cases.$i.doctrines")" \
      "$(cat_list "$UCf" "use_cases.$i.claims")" "$(cat_list "$UCf" "use_cases.$i.responsibilities")" \
      "$(cat_list "$UCf" "use_cases.$i.applications")"
    i=$((i+1))
  done
  printf '],"applications":['
  j=0; first=1
  while [ -n "$(yv "$APf" "applications.$j.id")" ]; do
    [ "$first" = 1 ] || printf ','; first=0
    printf '{"id":%s,"title":%s,"weight":%s,"summary":%s,"context":%s,"fits_when":%s,"does_not_fit_when":%s,"use_cases":%s,"doctrines":%s,"responsibilities":%s}' \
      "$(jstr "$(yv "$APf" "applications.$j.id")")" "$(jstr "$(yv "$APf" "applications.$j.title")")" \
      "$(jnum_or_str "$(yv "$APf" "applications.$j.weight")")" "$(jstr "$(yv "$APf" "applications.$j.summary")")" \
      "$(jstr "$(yv "$APf" "applications.$j.context")")" "$(cat_list "$APf" "applications.$j.fits_when")" \
      "$(cat_list "$APf" "applications.$j.does_not_fit_when")" "$(cat_list "$APf" "applications.$j.use_cases")" \
      "$(cat_list "$APf" "applications.$j.doctrines")" "$(cat_list "$APf" "applications.$j.responsibilities")"
    j=$((j+1))
  done
  printf ']}'
} | jq '. + {counts:{use_cases:(.use_cases|length), applications:(.applications|length)},
             uc_index:(reduce (.use_cases|to_entries[]) as $e ({}; . + {($e.value.id): $e.key})),
             ap_index:(reduce (.applications|to_entries[]) as $e ({}; . + {($e.value.id): $e.key}))}' > "$OUT/catalogue.json"

mj_phase_end "gen:catalogue.json" "$GEN_T0"
# ---------------------------------------------------------------- diagrams.json (Mermaid source from data, never hand-drawn)
GEN_T0="$(mj_phase_begin "gen:diagrams.json_Mermaid_source")"
LIFECYCLE_MMD="$(printf 'stateDiagram-v2\n    [*] --> active: start\n    active --> active: check --checkpoint\n    active --> handed_over: handover --close\n    handed_over --> [*]: next start archives the record\n'; for o in $(printf '%s' "$OUTCOMES" | jq -r '.[]'); do printf '    active --> %s: finish --outcome %s\n    %s --> [*]\n' "$o" "$o" "$o"; done)"
PIPELINE_MMD="$(printf 'flowchart LR\n    subgraph canonical\n        A[share/skeleton]\n        B[docs + README]\n        C[docs/CLAIMS.yaml]\n    end\n    G[scripts/generate-site-data]\n    D[(site/data/generated)]\n    Z[Zola]\n    F[Tailwind + Flowbite + Alpine]\n    P[GitHub Pages]\n    A --> G\n    B --> G\n    C --> G\n    G --> D --> Z --> F --> P\n')"
PROJECTION_MMD="$(printf 'flowchart TD\n    P[.ai/repo/policy.yaml]\n    U[majordomus update]\n    P --> U\n'; i=0; while :; do t="$(jq -r ".projections[$i].target // empty" "$OUT/policy.json")"; [ -n "$t" ] || break; pr="$(jq -r ".projections[$i].provider" "$OUT/policy.json")"; printf '    U --> T%s["%s<br/><small>%s</small>"]\n' "$i" "$t" "$pr"; i=$((i+1)); done; printf '    T0 -.->|stamp| D[majordomus doctor]\n')"
SUPERVISION_MMD="$(printf 'flowchart TD\n    H[Human / Organisation]\n    M[Majordomus<br/><small>policy · state · verification</small>]\n    W1[Claude Code]\n    W2[Codex]\n    W3[Gemini · Cursor · local]\n    V[Verified, accepted outcomes]\n    H --> M\n    M --> W1\n    M --> W2\n    M --> W3\n    W1 --> V\n    W2 --> V\n    W3 --> V\n')"
jq -n --arg l "$LIFECYCLE_MMD" --arg p "$PIPELINE_MMD" --arg j "$PROJECTION_MMD" --arg s "$SUPERVISION_MMD" \
  '{schema:1, diagrams: {lifecycle: {title: "Task lifecycle", source: "lib/finish.sh outcome vocabulary", mermaid: $l},
                          pipeline: {title: "How this site is derived", source: "generate-site-data inputs", mermaid: $p},
                          projection: {title: "Policy to instruction files", source: "share/skeleton/policy.yaml projections", mermaid: $j},
                          supervision: {title: "The core model", source: "README.md mental model", mermaid: $s}}}' > "$OUT/diagrams.json"

mj_phase_end "gen:diagrams.json_Mermaid_source" "$GEN_T0"
# ---------------------------------------------------------------- architecture.json (static scan, never hand-drawn)
GEN_T0="$(mj_phase_begin "gen:architecture.json_static_sca")"
# The interactive architecture graph is what scripts/lib/architecture-scan.awk can prove by
# reading the shell sources: module A sources module B, module A names artifact C. Nothing is
# asserted here that the scanner did not find, and a module that stops touching a file loses
# its edge on the next run. Command labels, summaries and routes come from project.json, so
# the graph and the command pages cannot disagree.
SCAN="$ROOT/scripts/lib/architecture-scan.awk"
[ -f "$SCAN" ] || { echo "generate-site-data: missing $SCAN" >&2; exit 12; }
# two collecting passes, so a path accessor defined in a later file still resolves
ARCH_TSV="$(cd "$ROOT" && awk -f "$SCAN" -v table="$(mj_layout_table | tr "\t" = | tr "\n" " ")" vars=1 bin/majordomus lib/*.sh vars=1 bin/majordomus lib/*.sh vars=0 bin/majordomus lib/*.sh)"
printf '%s\n' "$ARCH_TSV" | jq -Rn --arg ai "$AI/" --slurpfile proj "$OUT/project.json" '
  [inputs | split("\t")] as $rows
  | ($proj[0].commands | map({key: .name, value: .})) as $cmds
  | ($rows | map(select(.[0]=="node") | {id: .[1], kind: .[2]})) as $raw_nodes
  | ($raw_nodes | map(select(.kind=="artifact") | .id)) as $arts
  # a bare directory whose children are also referenced adds nothing but a hub
  | ($arts | map(select(. as $a | ($arts | any(startswith($a + "/")))))) as $drop
  | ($raw_nodes | map(select((.kind != "artifact") or ((.id | IN($drop[])) | not)))) as $nodes
  | ($nodes | map(.id)) as $keep
  | {schema: 1,
     source: "static reference scan of bin/majordomus and lib/*.sh",
     generator: "scripts/lib/architecture-scan.awk",
     edge_kinds: {sources: "the first module sources the second",
                  reads: "named behind a reading command or a redirection from the file",
                  writes: "named behind a redirection into the file, or a command that creates or replaces it",
                  uses: "named, but handed to a helper — the scan does not claim a direction"},
     nodes: [$nodes[]
       | .id as $id
       | ($id | ltrimstr("lib/") | rtrimstr(".sh")) as $cmd
       | ($cmds | map(select(.key == $cmd)) | first | .value) as $c
       | {id: $id, kind: .kind,
          label: (if .kind == "entry" then "majordomus"
                  elif .kind == "module" then $cmd
                  else ($id | ltrimstr($ai)) end),
          command: (if .kind == "module" and $c then $cmd else null end),
          summary: ($c.summary // null),
          read_only: ($c.read_only // null),
          route: (if .kind == "module" and $c then "/commands/" + $cmd + "/" else null end),
          external: false}],
     # Parenthesised: a pipe in an object value is a syntax error in jq 1.7, which is what
     # the CI image ships. jq 1.8 accepts it, so this only ever failed away from a laptop.
     edges: ([$rows[] | select(.[0]=="edge") | {source: .[1], target: .[2], kind: .[3]}
       | select((.source | IN($keep[])) and (.target | IN($keep[])))]
     # the dispatcher sources lib/<command>.sh by name; that edge is dynamic in the shell
     | . + [$cmds[] | select(("lib/" + .key) as $m | ($keep | any(. == $m + ".sh")))
            | {source: "bin/majordomus", target: ("lib/" + .key + ".sh"), kind: "sources"}])
     | unique}' > "$OUT/architecture.json"
[ "$(jq '.nodes | length' "$OUT/architecture.json")" -ge 20 ] || { echo "generate-site-data: architecture scan found almost nothing; the scanner or the sources moved" >&2; exit 10; }
# every command that has a module on disk must appear as one in the scan; a command the
# dispatcher answers itself (version) has no module and is not expected to have a node
MODULE_CMDS="$(for f in "$ROOT"/lib/*.sh; do b="$(basename "$f" .sh)"; [ "$b" = common ] || printf '%s\n' "$b"; done | jarr)"
jq -e --argjson mods "$MODULE_CMDS" --slurpfile proj "$OUT/project.json" '
  (($proj[0].commands | map(.name)) - ($proj[0].commands | map(.name) - $mods))
  - ([.nodes[] | select(.kind=="module") | .command] | map(select(. != null))) | length == 0' \
  "$OUT/architecture.json" >/dev/null || { echo "generate-site-data: a command with a lib/ module is missing from the architecture scan" >&2; exit 10; }

mj_phase_end "gen:architecture.json_static_sca" "$GEN_T0"
# ---------------------------------------------------------------- claims-graph.json (evidence, as a graph)
GEN_T0="$(mj_phase_begin "gen:claims-graph.json_evidence_a")"
# The same claims as capabilities.json, projected into the bipartite shape the evidence graph
# draws: a claim on one side, the documents, implementations and tests that back it on the
# other. A claim with no evidence node is visible as an isolated dot, which is the point.
jq '{schema: 1,
     source: "docs/CLAIMS.yaml",
     generator: "scripts/generate-site-data",
     statuses: .statuses,
     edge_kinds: {specified_by: "the document that defines the claim",
                  implemented_by: "the file that implements it",
                  proved_by: "the behavioural test that proves it"},
     nodes: ([.claims[] | {id: ("claim:" + .id), kind: "claim", label: .claim, status: .status,
                           route: ("/guarantees/" + .id + "/"), external: false, note: .note}]
             + ([.claims[] | {id: ("source:" + .source), kind: "source", label: .source, route: .source_route, external: false}]
                + [.claims[] | select(.implementation) | {id: ("impl:" + .implementation), kind: "implementation", label: .implementation, route: null, external: false}]
                + [.claims[] | select(.test) | {id: ("test:" + .test), kind: "test", label: .test, external: true,
                                                route: ("https://github.com/korczis/prismatic-majordomus/blob/master/" + .test)}]
                | unique_by(.id))),
     edges: ([.claims[] | {source: ("claim:" + .id), target: ("source:" + .source), kind: "specified_by"}]
             + [.claims[] | select(.implementation) | {source: ("claim:" + .id), target: ("impl:" + .implementation), kind: "implemented_by"}]
             + [.claims[] | select(.test) | {source: ("claim:" + .id), target: ("test:" + .test), kind: "proved_by"}])}' \
  "$OUT/capabilities.json" > "$OUT/claims-graph.json"
# a guaranteed claim reaches a test; the generator already refuses one that does not, and this
# asserts the projection did not lose the edge on the way into the graph
jq -e '[.nodes[] | select(.kind=="claim" and .status=="guaranteed") | .id] as $g
       | ([.edges[] | select(.kind=="proved_by") | .source] | unique) as $p
       | ($g - $p) | length == 0' "$OUT/claims-graph.json" >/dev/null \
  || { echo "generate-site-data: a guaranteed claim lost its test edge in claims-graph.json" >&2; exit 10; }

mj_phase_end "gen:claims-graph.json_evidence_a" "$GEN_T0"
# ---------------------------------------------------------------- docs index (from docs/README.md table)
GEN_T0="$(mj_phase_begin "gen:docs_index_from_docs_README.")"
# Only the first table becomes site routes. The "## Reference files" table below it lists
# repository-only files whose content the site presents through other routes, so it is cut
# here; site-check requires a route for every entry in docs.json.
DOCS="$(awk '/^## Reference files/{exit} /^\| \[`/{print}' "$ROOT/docs/README.md" | sed -E 's/^\| \[`([^`]+)`\]\(([^)]+)\) \| ([^|]+) \| ([^|]+) \|$/\2|\3|\4/' | grep -vE '^\|' \
  | jq -Rn '[inputs | split("|") | {path: (.[0] | ltrimstr("../")), audience: (.[1]|gsub("^ +| +$";"")), summary: (.[2]|gsub("^ +| +$";""))}]')"
printf '%s' "$DOCS" | jq '{schema:1, docs:.}' > "$OUT/docs.json"
# Every file in docs/ is indexed in one of the two tables. An unindexed document is how the
# index silently went stale before, so it is an error rather than a warning.
BQ='`'
for f in "$ROOT"/docs/*.md "$ROOT"/docs/*.yaml; do
  [ -e "$f" ] || continue
  b="$(basename "$f")"
  [ "$b" = README.md ] && continue
  grep -qF "[$BQ$b$BQ](" "$ROOT/docs/README.md" || {
    echo "generate-site-data: docs/$b is in no table in docs/README.md (add a row; the site and the index both read it)" >&2; exit 10; }
done

mj_phase_end "gen:docs_index_from_docs_README." "$GEN_T0"
# ---------------------------------------------------------------- derived Zola content (site/content/docs/*.md)
GEN_T0="$(mj_phase_begin "gen:derived_Zola_content_site_co")"
# Long-form pages are the canonical Markdown with a generated front matter; they are written
# here, gitignored, and rebuilt on every run. Nobody edits them. Repository-relative links are
# rewritten to site routes so the same Markdown serves both GitHub and the site.
CONTENT="$STAGE/content/docs"
rm -rf "$CONTENT"; mkdir -p "$CONTENT"
# every document listed in the docs/README.md index becomes a page; adding a row is the only step
# (AGENTS.md is listed in the index but lives at the repository root; it is rendered as "contract" below)
for d in $(jq -r '.docs[].path' "$OUT/docs.json" | grep -E '^[A-Z_]+\.md$' | sed 's/\.md$//' | while read -r n; do [ -f "$ROOT/docs/$n.md" ] && printf '%s\n' "$n"; done); do
  src="$ROOT/docs/$d.md"; slug="$(printf '%s' "$d" | tr 'A-Z_' 'a-z-')"
  title="$(grep -m1 '^# ' "$src" | sed 's/^# //; s/ — .*//')"
  summary="$(jq -r --arg p "$d.md" '.docs[] | select(.path==$p) | .summary' "$OUT/docs.json")"
  { printf -- '+++
title = %s
description = %s
weight = %s
[extra]
source = "docs/%s.md"
+++

' "$(jstr "$title")" "$(jstr "$summary")" "$(grep -n "^| \[\`$d.md\`" "$ROOT/docs/README.md" | cut -d: -f1 | head -1)" "$d"
    printf '{%% raw %%}\n'
    sed '1{/^# /d;}' "$src" | sed -E "$LINKSED" | awk -f "$ROOT/scripts/lib/project-markdown.awk" | awk '{ while (match($0, /\]\([A-Z_]+\.md\)/)) { t=substr($0,RSTART+2,RLENGTH-3); gsub(/_/,"-",t); $0=substr($0,1,RSTART-1) "](@/docs/" tolower(t) ")" substr($0,RSTART+RLENGTH) } print }'
    printf '{%% endraw %%}\n'
  } > "$CONTENT/$slug.md"
done
# the repository's own generated contract, as a page
{ printf -- '+++
title = "Repository contract"
description = "The operating contract for this repository, itself generated by majordomus update."
weight = 90
[extra]
source = "AGENTS.md"
+++

'; printf '{%% raw %%}\n'; sed '1{/^<!--/d;}' "$ROOT/AGENTS.md" | sed '1{/^# /d;}' | sed -E "$LINKSED" | awk -f "$ROOT/scripts/lib/project-markdown.awk"; printf '{%% endraw %%}\n'; } > "$CONTENT/contract.md"
printf -- '+++
title = "Documentation"
description = "Every document in the repository, rendered from the same Markdown GitHub shows."
sort_by = "weight"
template = "docs-section.html"
page_template = "docs-page.html"
+++
' > "$CONTENT/_index.md"

mj_phase_end "gen:derived_Zola_content_site_co" "$GEN_T0"
# ---------------------------------------------------------------- plan.json (the execution model)
GEN_T0="$(mj_phase_begin "gen:plan.json_the_execution_mode")"
# The canonical project model, projected for the website. Every value here comes from
# lib/project.awk through lib/project.sh — the same engine `majordomus plan` reads, so the
# roadmap cannot say one thing while the command says another. Nothing is recomputed here.
# shellcheck source=../lib/project.sh
. "$ROOT/lib/project.sh"
# shellcheck source=../lib/plan.sh
. "$ROOT/lib/plan.sh"

if mj_project_load; then
  # every milestone and every issue as JSON by one awk each, the milestone graphs by one
  # awk each into a directory the milestone pass reads; jq only assembles and pretty-prints
  MMD="$(mktemp -d "${TMPDIR:-/tmp}/mj.mmd.XXXXXX")"
  for id in $(mj_pj_milestone_ids); do mj_project_mermaid "$id" > "$MMD/$id"; done
  MS="$(awk -F'\t' -v kind=M -v flat="$MJ_PJ/flat" -v mermaid="$MMD" -f "$ROOT/lib/plan_json.awk" "$MJ_PJ/model.tsv")"
  IS="$(awk -F'\t' -v kind=I -v flat="$MJ_PJ/flat" -f "$ROOT/lib/plan_json.awk" "$MJ_PJ/model.tsv")"
  rm -rf "$MMD"
  WV="$(mj_pj_rows W | jq -Rn '[inputs | split("\t") | {wave: (.[1]|tonumber), issues: (.[2]|split(" "))}]')"
  EG="$(mj_pj_rows G | jq -Rn '[inputs | split("\t") | {from: .[1], to: .[2]}]')"
  FD="$(mj_pj_findings | jq -Rn '[inputs | split("\t") | {level: .[1], code: .[2], subject: .[3], message: .[4]}]')"
  # The sequence a worker runs is not typed into a template: it is the table the seeded
  # plan workflow carries, parsed into data. One source, so the page and the file every
  # worker loads cannot describe different work.
  WS="$(awk '
      /^\| / && $0 !~ /^\| *When *\|/ && $0 !~ /^\|-/ {
        line = $0
        sub(/^\| */, "", line)
        i = index(line, "|"); when = substr(line, 1, i - 1); run = substr(line, i + 1)
        sub(/ *$/, "", when)
        # the command is the first backticked span; anything after it is the note
        if (match(run, /`[^`]+`/)) {
          cmd = substr(run, RSTART + 1, RLENGTH - 2)
          note = substr(run, RSTART + RLENGTH)
          sub(/^ *(—|--) */, "", note); sub(/ *\|? *$/, "", note); sub(/ *\| *$/, "", note)
          printf "%s\t%s\t%s\n", when, cmd, note
        }
      }' "$ROOT/share/skeleton/ai/repo/workflows/plan.md" \
    | jq -Rn '[inputs | split("\t") | {when: .[0], command: .[1], note: .[2]}]')"
  [ "$(printf '%s' "$WS" | jq length)" -gt 0 ] \
    || { echo "generate-site-data: no worker sequence in share/skeleton/ai/repo/workflows/plan.md" >&2; exit 10; }

  # The status vocabulary travels with the data. Every page that shows a status or a count
  # loops over this rather than naming done, ready, active, verify and blocked itself, so
  # the engine adding a status changes the pages and the documentation without an edit.
  ST="$(jq -n --argjson i "$(mj_pj_statuses issue | tr ' ' '\n' | jarr)" \
             --argjson m "$(mj_pj_statuses milestone | tr ' ' '\n' | jarr)" \
             '{issue:$i, milestone:$m}')"
  # The model's collections reach jq through files, never through argv. Linux caps a SINGLE
  # argv entry at MAX_ARG_STRLEN (131072 bytes) regardless of the much larger total ARG_MAX;
  # execve then fails with E2BIG and the shell reports exit 126. macOS has no per-argument cap
  # of that shape, so the whole class of failure is invisible on the machine this is developed
  # on and appears only on a Linux runner, as a red deploy rather than a red test. The issues
  # array crossed the limit as the plan grew and milestones was next. --slurpfile has no
  # ceiling at all rather than a larger one, so growth cannot bring this back.
  for pair in "milestones:$MS" "issues:$IS" "waves:$WV" "edges:$EG" "findings:$FD"; do
    printf '%s' "${pair#*:}" > "$STAGE/plan-${pair%%:*}.json"
  done
  jq -n --arg name "$(mj_pj_project_name)" --arg repo "$(mj_pj_repository)" --arg branch "$(mj_pj_default_branch)" \
    --arg active "$(mj_pj_active)" --arg next "$(mj_pj_next_ready)" --arg mermaid "$(mj_project_mermaid)" \
    --argjson statuses "$ST" --argjson worker_sequence "$WS" \
    --slurpfile milestones "$STAGE/plan-milestones.json" --slurpfile issues "$STAGE/plan-issues.json" \
    --slurpfile waves "$STAGE/plan-waves.json" --slurpfile edges "$STAGE/plan-edges.json" \
    --slurpfile findings "$STAGE/plan-findings.json" \
    '{schema:1, project:{name:$name, repository:$repo, default_branch:$branch},
      active_milestone:$active, next_ready:$next, mermaid:$mermaid, statuses:$statuses,
      worker_sequence:$worker_sequence,
      milestones:$milestones[0], issues:$issues[0], waves:$waves[0], edges:$edges[0],
      findings:$findings[0]}' > "$OUT/plan.json"
# Refuse an invalid model rather than project it. A cycle makes every milestone BLOCKED with
# no rank, and without this the generator published that roadmap and exited 0 — a page saying
# nothing is reachable, with no reason given. The engine has already said so by this point:
# a FAIL finding is what `plan validate` exits 10 on, so this asks the same question of the
# same data instead of shelling back out to the CLI, which needs an installed .ai/
# that a disposable test repository does not have. Reported by the session that owns the
# model; the first version of this guard called the CLI and broke every site case.
  # ------------------------------------------------------------ roadmap.json
  # The roadmap is the milestone graph, and it is not recomputed here: this calls the same
  # projection `majordomus plan roadmap --json` prints, in process, so the page and the
  # command cannot disagree about what is blocked. Calling the CLI instead would need an
  # installed .ai/ that a disposable test repository does not have — that mistake
  # cost every site case an hour ago.
  ( export MJ_JSON=1; mj_plan_roadmap ) > "$OUT/roadmap.json"
  # The milestone graph in the shape site/graph.js renders, so the roadmap reuses the runtime
  # /map/ and /evidence/ already use rather than adding a third picture of a dependency graph.
  jq '{schema: 1,
       source: ".ai/repo/project/milestones/",
       edge_kinds: {requires: "the target cannot begin until the source is accepted"},
       nodes: [.milestones[] | {id: .id, kind: "milestone",
                                label: (if .version == "" then .id else .version + "  " + .id end),
                                status: .status, route: ("/plan/" + (.id | ascii_downcase) + "/"),
                                external: false, summary: .title}],
       edges: [.milestones[] | . as $m | $m.depends_on[] | {source: ., target: $m.id, kind: "requires"}]}' \
    "$OUT/roadmap.json" > "$OUT/roadmap-graph.json"
  [ -s "$OUT/roadmap.json" ] || { echo "generate-site-data: the roadmap projection produced nothing" >&2; exit 13; }
  # The gate the engine enforces: a milestone whose dependencies are not all DONE is BLOCKED,
  # whatever its own issues say. Asserted on the projection rather than reimplemented — this
  # should never fire, and if it does the page and the engine have diverged.
  jq -e '[.milestones[] | select((.blocked_by | length) > 0 and .status != "BLOCKED")] | length == 0' \
    "$OUT/roadmap.json" >/dev/null \
    || { echo "generate-site-data: a milestone has unmet dependencies but is not BLOCKED; the roadmap and the engine disagree" >&2; exit 10; }
  # Each version milestone names the claim it would move from planned to guaranteed. Linking
  # does not promote: a claim reaches guaranteed through implementation, test and CI, and the
  # page says so. But a claim named here that does not exist would be a promise about nothing.
  jq -e --slurpfile caps "$OUT/capabilities.json" \
    '[.milestones[].claims[]] - ($caps[0].claims | map(.id)) | length == 0' "$OUT/roadmap.json" >/dev/null \
    || { echo "generate-site-data: a milestone names a claim that is not in docs/CLAIMS.yaml" >&2; exit 10; }

PLAN_FAILS="$(jq -r '[.findings[] | select(.level == "FAIL")] | length' "$OUT/plan.json")"
if [ "$PLAN_FAILS" != 0 ]; then
  jq -r '.findings[] | select(.level == "FAIL") | "generate-site-data: project model: \(.code) \(.subject) — \(.message)"' "$OUT/plan.json" >&2
  echo "generate-site-data: refusing to publish a roadmap from an invalid model (run: majordomus plan validate)" >&2
  exit 10
fi
else
  echo "generate-site-data: no canonical project model in $ROOT/$PJ" >&2; exit 12
fi

mj_phase_end "gen:plan.json_the_execution_mode" "$GEN_T0"
# ---------------------------------------------------------------- source.json
GEN_T0="$(mj_phase_begin "gen:source.json")"
HASH="$( (cd "$ROOT" && for f in $INPUTS; do printf '%s ' "$f"; mj_sha256 "$f"; done) | mj_sha256 /dev/stdin 2>/dev/null || (cd "$ROOT" && for f in $INPUTS; do printf '%s ' "$f"; mj_sha256 "$f"; done) | shasum -a 256 | cut -d' ' -f1)"
COMMIT="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)"
jq -n --arg v "$VERSION" --arg c "$COMMIT" --arg h "$HASH" --argjson g "$GEN_VERSION" --arg inputs "$INPUTS" \
  '{schema:1, source_version:$v, source_commit:$c, source_hash:$h, generator_version:$g, input_files: ($inputs | split("\n"))}' > "$OUT/source.json"

mj_phase_end "gen:source.json" "$GEN_T0"
# ---------------------------------------------------------------- derived section pages (every tile is a page)
GEN_T0="$(mj_phase_begin "gen:derived_section_pages_every")"
mk_section() { # dir, title, description, section template, page template, weight
  local d="$CONTENT_ROOT/$1"; mkdir -p "$d"
  printf -- '+++\ntitle = %s\ndescription = %s\nsort_by = "weight"\ntemplate = "%s"\npage_template = "%s"\nweight = %s\n+++\n' "$(jstr "$2")" "$(jstr "$3")" "$4" "$5" "$6" > "$d/_index.md"
}
CONTENT_ROOT="$STAGE/content"
rm -rf "$CONTENT_ROOT/profiles" "$CONTENT_ROOT/guarantees" "$CONTENT_ROOT/supervises" "$CONTENT_ROOT/commands" "$CONTENT_ROOT/doctrines" "$CONTENT_ROOT/use-cases" "$CONTENT_ROOT/applications" "$CONTENT_ROOT/plan"
mk_section profiles "Execution profiles" "Capability class, reasoning effort, output verbosity, presentation, context toggles and verification are independent fields. Rendered from the profile files a fresh install writes." profiles.html profile.html 30
i=0; for slug in $(jq -r '.profiles[].slug' "$OUT/profiles.json"); do i=$((i+1))
  printf -- '+++\ntitle = %s\ndescription = %s\nweight = %s\n[extra]\nslug = %s\nsource = "share/skeleton/profiles/%s.yaml"\n+++\n' "$(jstr "$slug profile")" "$(jq -r --arg s "$slug" '.profiles[] | select(.slug==$s) | .description' "$OUT/profiles.json" | jline)" "$i" "$(jstr "$slug")" "$slug" > "$CONTENT_ROOT/profiles/$slug.md"; done
mk_section guarantees "Guaranteed, advisory, planned" "What Majordomus actually does today, row by row, with the file that implements it and the test that proves it." guarantees.html claim.html 40
i=0; for st in $(jq -r '.statuses | keys_unsorted[]' "$OUT/capabilities.json"); do i=$((i+1))
  printf -- '+++\ntitle = %s\ndescription = %s\nweight = %s\ntemplate = "status.html"\n[extra]\nstatus = %s\n+++\n' "$(jstr "$(printf '%s' "$st" | awk '{print toupper(substr($0,1,1)) substr($0,2)}') capabilities")" "$(jq -r --arg s "$st" '.statuses[$s]' "$OUT/capabilities.json" | jline)" "$i" "$(jstr "$st")" > "$CONTENT_ROOT/guarantees/$st.md"; done
jq -r '.claims[] | [.id, .claim, .status] | @tsv' "$OUT/capabilities.json" | while IFS="$MJ_TAB" read -r id claim st; do i=$((i+1))
  detail="$ROOT/docs/claims/$id.md"
  [ -f "$detail" ] || { echo "generate-site-data: claim $id has no docs/claims/$id.md (every claim needs its detail page)" >&2; exit 10; }
  summary="$(awk '/^## What it means/{f=1;next} f&&/^## /{exit} f&&NF{print; exit}' "$detail" | sed -E 's/`//g; s/\[([^]]+)\]\([^)]+\)/\1/g')"
  { printf -- '+++\ntitle = %s\ndescription = %s\nweight = %s\n[extra]\nclaim_id = %s\nstatus = %s\nsource = "docs/claims/%s.md"\n+++\n{%% raw %%}\n' "$(jstr "$claim")" "$(jstr "${summary:-Status: $st. Source, implementation and test for this claim.}")" "$((i+10))" "$(jstr "$id")" "$(jstr "$st")" "$id"
    sed '1{/^# /d;}' "$detail" | sed -E "$LINKSED" | awk -f "$ROOT/scripts/lib/project-markdown.awk" | awk '{ while (match($0, /\]\([A-Z_]+\.md\)/)) { t=substr($0,RSTART+2,RLENGTH-3); gsub(/_/,"-",t); $0=substr($0,1,RSTART-1) "](@/docs/" tolower(t) ")" substr($0,RSTART+RLENGTH) } print }'
    printf '{%% endraw %%}\n'; } > "$CONTENT_ROOT/guarantees/$id.md"; done
# The count is computed, never written: the repository's own rule is that prose states
# the command that produces a number rather than the number.
mk_section supervises "What Majordomus supervises" "$(jq -r '.does | length' "$OUT/readme.json") responsibilities, one layer. Each is a file under .ai/ and a subcommand that reads it." supervises-section.html responsibility.html 20
i=0; jq -r '.does[] | [.slug, .title, .text] | @tsv' "$OUT/readme.json" | while IFS="$MJ_TAB" read -r slug title text; do i=$((i+1))
  printf -- '+++\ntitle = %s\ndescription = %s\nweight = %s\n[extra]\nslug = %s\n+++\n' "$(jstr "$title")" "$(printf '%s' "$text" | sed -E 's/`([^`]*)`/\1/g' | jline)" "$i" "$(jstr "$slug")" > "$CONTENT_ROOT/supervises/$slug.md"; done
mk_section doctrines "Doctrine" "A rule is enforced when it is declared, implemented, wired, executed, failure-propagating, tested and CI-blocking. Each one below shows its whole chain." doctrines-section.html doctrine.html 22
i=0; jq -r '.doctrines[] | [.id, .slug, .title, .summary] | @tsv' "$OUT/doctrines.json" | while IFS="$MJ_TAB" read -r id slug title summary; do i=$((i+1))
  printf -- '+++\ntitle = %s\ndescription = %s\nweight = %s\n[extra]\nid = %s\nsource = %s\n+++\n' "$(jstr "$title")" "$(printf '%s' "$summary" | jline)" "$i" "$(jstr "$id")" "$(jq -r --arg id "$id" '.doctrines[] | select(.id==$id) | .source' "$OUT/doctrines.json" | jline)" > "$CONTENT_ROOT/doctrines/$slug.md"; done
mk_section plan "The plan" "Milestones as executable outcome specifications, issues as execution contracts, and the dependency graph that decides what may be executed next. Every figure is derived from .ai/repo/project." plan-section.html issue.html 21
printf -- '+++\ntitle = "Dependency graph"\ndescription = "Every issue, every dependency, and the execution waves the graph implies — drawn from the canonical edges, never by hand."\nweight = 1\ntemplate = "dag.html"\n+++\n' > "$CONTENT_ROOT/plan/dag.md"
i=1; for mid in $(jq -r '.milestones | sort_by(.order) | .[].id' "$OUT/plan.json"); do i=$((i+1))
  printf -- '+++\ntitle = %s\ndescription = %s\nweight = %s\ntemplate = "milestone.html"\n[extra]\nplan_id = %s\nsource = ".ai/repo/project/milestones/%s.yaml"\n+++\n' \
    "$(jstr "$mid — $(jq -r --arg m "$mid" '.milestones[] | select(.id==$m) | .title' "$OUT/plan.json")")" \
    "$(jq -r --arg m "$mid" '.milestones[] | select(.id==$m) | .outcome' "$OUT/plan.json" | jline)" \
    "$i" "$(jstr "$mid")" "$mid" > "$CONTENT_ROOT/plan/$mid.md"; done
for iid in $(jq -r '.issues[].id' "$OUT/plan.json"); do i=$((i+1))
  printf -- '+++\ntitle = %s\ndescription = %s\nweight = %s\n[extra]\nplan_id = %s\nsource = ".ai/repo/project/issues/%s.yaml"\n+++\n' \
    "$(jstr "$iid — $(jq -r --arg n "$iid" '.issues[] | select(.id==$n) | .title' "$OUT/plan.json")")" \
    "$(jq -r --arg n "$iid" '.issues[] | select(.id==$n) | .objective' "$OUT/plan.json" | jline)" \
    "$i" "$(jstr "$iid")" "$iid" > "$CONTENT_ROOT/plan/$iid.md"; done
mk_section use-cases "Use cases" "What people do with it: a situation, the commands that answer it, and what you are left holding. Every step names a real command and every promise a real claim." use-cases-section.html use-case.html 12
i=0; jq -r '.use_cases[] | [.id, .title, .summary] | @tsv' "$OUT/catalogue.json" | while IFS="$MJ_TAB" read -r id title summary; do i=$((i+1))
  printf -- '+++\ntitle = %s\ndescription = %s\nweight = %s\n[extra]\nid = %s\nsource = "share/use-cases.yaml"\n+++\n' "$(jstr "$title")" "$(printf '%s' "$summary" | jline)" "$i" "$(jstr "$id")" > "$CONTENT_ROOT/use-cases/$id.md"; done
mk_section applications "Applications" "Where it fits, and where it does not. Every entry declares both, because a catalogue that only lists fits is not a description." applications-section.html application.html 14
i=0; jq -r '.applications[] | [.id, .title, .summary] | @tsv' "$OUT/catalogue.json" | while IFS="$MJ_TAB" read -r id title summary; do i=$((i+1))
  printf -- '+++\ntitle = %s\ndescription = %s\nweight = %s\n[extra]\nid = %s\nsource = "share/applications.yaml"\n+++\n' "$(jstr "$title")" "$(printf '%s' "$summary" | jline)" "$i" "$(jstr "$id")" > "$CONTENT_ROOT/applications/$id.md"; done
mk_section commands "Commands" "One executable, $(jq '.commands | length' "$OUT/commands.json") subcommands. Exit codes are a contract." commands-section.html command.html 25
i=0; for name in $(jq -r '.commands[].name' "$OUT/commands.json"); do i=$((i+1))
  printf -- '+++\ntitle = %s\ndescription = %s\nweight = %s\n[extra]\nname = %s\nsource = "docs/CLI.md"\n+++\n' "$(jstr "majordomus $name")" "$(jq -r --arg n "$name" '.commands[] | select(.name==$n) | .summary' "$OUT/commands.json" | jline)" "$i" "$(jstr "$name")" > "$CONTENT_ROOT/commands/$name.md"; done

mj_phase_end "gen:derived_section_pages_every" "$GEN_T0"
# ---------------------------------------------------------------- docs/SITE_CLAIMS.md (derived release artifact)
GEN_T0="$(mj_phase_begin "gen:docs_SITE_CLAIMS.md_derived")"
SC="$STAGE/SITE_CLAIMS.md"
{
  printf '# Site claims\n\nGenerated by `scripts/generate-site-data` from `docs/CLAIMS.yaml`. Do not edit; edit the YAML.\nEvery substantive public claim the website makes, with its status, the file that defines it,\nthe file that implements it, and the test that proves it. The website renders the same data.\n\n'
  for st in $(jq -r '.statuses | keys_unsorted[]' "$OUT/capabilities.json"); do
