#!/usr/bin/env bash
# diagram-check — an architectural relationship is drawn, not typed.
#
# A diagram made of `─│┌└┼` and `-->` is a picture a person drew by hand and nothing can
# read. It cannot be rendered, cannot be linked, cannot be checked against the thing it
# claims to describe, and it goes stale the way every hand-maintained projection in this
# repository goes stale — silently, while still looking authoritative. On a published page
# it is also the one element that cannot wrap: box art has no space to break at, so a
# diagram wide enough to be useful on a desktop is a horizontal scrollbar on a phone.
#
# So the rule is: an architectural relationship in a document this repository publishes is a
# ```mermaid block. `project.a-diagram-is-a-projection` states it; this gate decides it.
#
# # What is NOT a diagram
#
# Three things are made of the same characters and are not diagrams, and getting these wrong
# is how a gate like this becomes something people route around:
#
#   1. Literal terminal output. `console`, `bash`, `sh`, `shell-session` — what a command
#      actually printed. Redrawing that as a graph would be a lie about what the terminal
#      showed. This is the exemption the rule names explicitly.
#   2. A file tree. `├── a/` is a listing, not an architecture: it says where files are, and
#      a reader compares it against their own `ls`. Detected by the tree glyphs appearing
#      without any flow arrow — and a tree's `# …` annotations are prose, so an arrow inside
#      one ("a repo walked through start → finish") is a sentence, not an edge.
#   3. Literal file content. docs/SCHEMAS.md shows what a generated header looks like —
#      `<!-- generated by ... -->` — and an HTML comment contains `-->`. A block whose
#      arrows are all inside comment markers is quoting a file, not drawing one.
#
# # The baseline
#
# The debt is real and predates the rule, so the count is ratcheted: the gate fails when the
# number of hand-drawn diagrams rises above `.ai/repo/diagram-baseline.txt`, and refuses to
# let it fall silently either — a baseline above the truth is a gate that has stopped
# looking. Drive it to zero by converting; `--update` rewrites it and never runs in CI.
#
#   scripts/ci/diagram-check              every finding, and the verdict
#   scripts/ci/diagram-check --list       one line per hand-drawn diagram, for converting
#   scripts/ci/diagram-check --update     rewrite the baseline from this tree (never in CI)
#   MJ_ROOT=<dir> ...                     examine that tree instead of this one
#
# Exit: 0 at or below the baseline · 10 above it, or the baseline is stale · 12 unusable.
set -euo pipefail

ROOT="${MJ_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
cd "$ROOT"
BASELINE=".ai/repo/diagram-baseline.txt"

LIST=0; UPDATE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --list) LIST=1; shift ;;
    --update) UPDATE=1; shift ;;
    -h|--help) sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "diagram-check: unknown option $1" >&2; exit 2 ;;
  esac
done

command -v python3 >/dev/null 2>&1 || { echo "diagram-check: python3 is not installed" >&2; exit 12; }

findings="$(python3 - <<'PY'
import re, os, sys

# Where a reader meets these: the documents the site publishes. A diagram in a shell script's
# comments is read in a terminal, which is the one place box art is the right answer.
ROOTS = ["docs"]

FENCE = re.compile(r'^([ \t]*)```([A-Za-z0-9_-]*)[ \t]*$')
BOX   = re.compile(r'[─│└┌┐┘├┤┬┴┼━┃╭╮╰╯]')
FLOW  = re.compile(r'(-->|──>|──►|─►|→|▶|<--|<─)')
PLUS  = re.compile(r'^\s*\+[-=]{2,}', re.M)
TREE  = re.compile(r'[├└][─━]{2}')
# An arrow that is only ever inside an HTML comment is quoted file content, not a flow.
COMMENT = re.compile(r'<!--.*?-->', re.S)
# A trailing `# …` on a tree line is an annotation a person wrote, and an arrow inside it is
# prose. Stripped only when deciding whether a tree is a tree, so a diagram that genuinely
# uses `#` is unaffected.
ANNOTATION = re.compile(r'#.*$', re.M)

# Fences whose content is, by declaration, something other than a drawing.
LITERAL = {"console", "bash", "sh", "shell", "shell-session", "zsh", "json", "yaml", "yml",
           "toml", "rust", "python", "diff", "sql", "html", "css", "js", "javascript"}

def blocks(text):
    """Every fenced block, with its language, body and 1-based start line."""
    lines = text.split("\n")
    i = 0
    while i < len(lines):
        m = FENCE.match(lines[i])
        if not m:
            i += 1; continue
        indent, lang = m.group(1), (m.group(2) or "").lower()
        body, j = [], i + 1
        while j < len(lines):
            c = FENCE.match(lines[j])
            if c and c.group(1) == indent and not c.group(2):
                break
            body.append(lines[j]); j += 1
        yield lang, "\n".join(body), i + 1
        i = j + 1

def is_drawn(lang, body):
    if lang in LITERAL or lang == "mermaid":
        return False
    stripped = COMMENT.sub("", body)          # quoted file content contributes no arrows
    has_box, has_flow = bool(BOX.search(stripped)), bool(FLOW.search(stripped))
    if PLUS.search(stripped):
        return True                            # +---+ boxes are never anything else
    if TREE.search(stripped) and not FLOW.search(ANNOTATION.sub("", stripped)):
        return False                           # a listing, not an architecture
    return has_box or has_flow

found = []
for root in ROOTS:
    for dirpath, _, names in os.walk(root):
        for n in sorted(names):
            if not n.endswith(".md"):
                continue
            p = os.path.join(dirpath, n)
            try:
                text = open(p, encoding="utf-8").read()
            except OSError:
                continue
            for lang, body, line in blocks(text):
                if is_drawn(lang, body):
                    first = next((l.strip() for l in body.split("\n") if l.strip()), "")
                    found.append(f"{p}:{line}\t{lang or 'text'}\t{first[:70]}")

for f in sorted(found):
    print(f)
PY
)"

count="$(printf '%s' "$findings" | grep -c . || true)"

if [ "$LIST" = 1 ]; then
  [ -n "$findings" ] && printf '%s\n' "$findings"
  printf '# %s hand-drawn diagram(s)\n' "$count"
  exit 0
fi

if [ "$UPDATE" = 1 ]; then
  {
    printf '# Hand-drawn diagrams still in the published documents, as a count. Written by\n'
    printf '# `scripts/ci/diagram-check --update`; the gate refuses a rise, and refuses a\n'
    printf '# baseline above the truth. Drive it to zero by converting them to ```mermaid.\n'
    printf 'diagrams=%s\n' "$count"
  } > "$BASELINE"
  printf 'diagram-check: baseline written — %s hand-drawn diagram(s)\n' "$count"
  exit 0
fi

[ -f "$BASELINE" ] || { echo "diagram-check: $BASELINE is missing; run scripts/ci/diagram-check --update" >&2; exit 12; }
base="$(sed -n 's/^diagrams=\([0-9][0-9]*\)$/\1/p' "$BASELINE" | head -n 1)"
[ -n "$base" ] || { echo "diagram-check: $BASELINE carries no count" >&2; exit 12; }

if [ "$count" -gt "$base" ]; then
  printf '%s\n' "$findings"
  printf '\nFAIL  hand-drawn diagrams rose from %s to %s.\n' "$base" "$count"
  printf '      An architectural relationship in a published document is a ```mermaid block:\n'
  printf '      it renders as a picture on the site, stays readable as source in a terminal,\n'
  printf '      and is the one form of it this repository keeps. Literal terminal output is\n'
  printf '      exempt — fence it as `console` and it is not a diagram.\n'
  printf '      See: scripts/ci/diagram-check --list\n'
  exit 10
fi

if [ "$count" -lt "$base" ]; then
  printf 'FAIL  hand-drawn diagrams fell from %s to %s — lower the baseline so the gate keeps\n' "$base" "$count"
  printf '      looking (scripts/ci/diagram-check --update).\n'
  exit 10
fi

if [ "$count" = 0 ]; then
  printf 'diagram-check: no hand-drawn diagram in the published documents\n'
else
  printf 'diagram-check: %s hand-drawn diagram(s), at the baseline\n' "$count"
fi
