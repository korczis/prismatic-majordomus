#!/usr/bin/env bash
# core-check — the structural gates of the shell tool over this checkout, the same command
# here and in CI. Cheap, deterministic, and blocking: self-supervision (doctor, watch), the
# scoped context documents in sync, the continuity subsystem reachable through the real
# CLI, the canonical project model validating, the GitHub projection producible offline,
# and the derived site data current. Every step names what it proves; nothing here swallows
# an exit code.
#
#   MJ_CI_TIMINGS=FILE   append "core-check<TAB>step<TAB>seconds" per step
set -eu
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT"
t_step=""; last=""
step() {
  local now; now="$(date +%s)"
  if [ -n "$t_step" ]; then
    printf '    (%ss)\n' "$((now - t_step))"
    [ -n "${MJ_CI_TIMINGS:-}" ] && printf 'core-check\t%s\t%s\n' "$last" "$((now - t_step))" >> "$MJ_CI_TIMINGS"
  fi
  printf '==> %s\n' "$*"; last="$*"; t_step="$now"
}
step "self-supervision: doctor and watch"
git config core.hooksPath .githooks
# The other half of this clone's wiring, and for the same reason the line above exists: both
# are declared per clone rather than in a tracked file, so a fresh checkout — a runner's
# included — has neither until something sets them. The merge driver never runs here (CI
# merges nothing), but the policy declares it and doctor checks what the policy declares;
# wiring it is how this checkout answers that check truthfully rather than by exemption.
git config merge.derived.name "derived artifacts: resolve to ours, regenerate before committing"
git config merge.derived.driver "$ROOT/scripts/merge-derived %O %A %B %P"
bin/majordomus doctor
bin/majordomus watch
# The scoped context documents: the tree validates, every projection matches its stamp, and
# this repository resolves its own context from the root down.
step "context documents in sync"
bin/majordomus context check-sync
bin/majordomus context resolve lib | grep -q '^01  ai.layer'
# The continuity subsystem reached through the real CLI, in this checkout rather than in a
# disposable one: the commands a worker actually runs must work where the tool supervises
# itself, not only in a fixture.
step "continuity subsystem is reachable"
bin/majordomus context --budget-lines 400 > /dev/null
bin/majordomus context --json | head -c 1 | grep -q '{'
bin/majordomus history --validate
bin/majordomus handover --resolve > /dev/null
bin/majordomus checkpoint --list > /dev/null
bin/majordomus decision list > /dev/null
bin/majordomus question list --all > /dev/null
bin/majordomus prompt list | grep -q .
for p in .ai/repo/prompts/*.md; do
  p="$(basename "$p" .md)"
  if bin/majordomus prompt render "$p" | grep -q '{{'; then echo "unrendered token in $p"; exit 1; fi
done
# The canonical project model: schemas, references, the dependency graph, and status
# consistency. Blocking, with no advisory pass: a model that cannot be executed is not a
# warning. `plan validate` exits 10 on any failing finding and 0 on warnings only.
step "the project model validates"
bin/majordomus plan validate
# The GitHub projection, computed offline. This needs no token and makes no request: it
# renders what would be posted from the canonical model, so a projection that cannot be
# produced fails here rather than at the moment somebody runs --apply.
step "the GitHub projection is producible offline"
scripts/github-sync --plan
for id in $(bin/majordomus plan list | awk 'NR>1{print $1}'); do
  scripts/github-sync --render "$id" | grep -q '^<!-- majordomus:begin' || { echo "no generated region for $id"; exit 1; }
done
# No authored document names somebody's home directory. `scripts/site-check` already refuses
# a *built site* that carries one, but it runs at the moment of deployment: by then the text
# is on master, the deploy is red, and the person who has to fix it is whoever tried to
# publish rather than whoever wrote it. The same pattern applied to the sources the site is
# projected from fails here instead, where the text was written.
#
# This is not hypothetical. The reasoning of I0908 — an issue whose stated purpose is that
# "no absolute developer path exists anywhere in the image" — named a home directory, reached
# plan.json, reached the site, and broke the deploy gate on master (fixed by #67).
step "no authored document names a home directory"
hits="$(git grep -n -I -E '/Users/[a-z]+/|/home/[a-z]+/dev/' -- \
          '.ai/repo/**' 'docs/**' 'site/content-src/**' 'README.md' 2>/dev/null || true)"
if [ -n "$hits" ]; then
  printf 'a home directory is named in an authored document; write what the path means instead:\n%s\n' "$hits" >&2
  exit 1
fi
# The committed derived site data must match the canonical files it is generated from.
step "derived site data in sync"
scripts/generate-site-data --check
step "core-check: every gate passed"
