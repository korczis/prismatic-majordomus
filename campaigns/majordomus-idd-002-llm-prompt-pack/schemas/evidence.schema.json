{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://majordomus.dev/schemas/mj-idd-002/evidence.schema.json",
  "required": [
    "pack_id",
    "repository",
    "baseline_sha",
    "mission",
    "status",
    "changed_contracts",
    "checks",
    "risks",
    "next_action"
  ],
  "properties": {
    "pack_id": {
      "type": "string",
      "const": "mj-idd-002"
    },
    "repository": {
      "type": "string"
    },
    "baseline_sha": {
      "type": "string",
      "minLength": 7
    },
    "mission": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "partial",
        "blocked",
        "failed"
      ]
    },
    "changed_contracts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "skip",
              "blocked"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    },
    "commit_sha": {
      "type": "string"
    },
    "pr_url": {
      "type": "string"
    },
    "deploy_url": {
      "type": "string"
    },
    "deployment_verified": {
      "type": "boolean"
    },
    "observed_metrics": {
      "type": "object",
      "additionalProperties": true
    },
    "governance_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
