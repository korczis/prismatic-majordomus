#!/usr/bin/env bash
# order-check — the gate of project.canonical-order: a collection has one order, that order
# is owned by one place, and it does not depend on who ran the command.
#
# Four things are held here. The first three are absolute, because the tree already
# satisfies them and a new violation is always a mistake:
#
#   1. no comparator outside apps/majordomus-cli/src/order.rs folds case by hand. A
#      case-folded comparison with a tiebreak is exactly what `order::natural_cmp` is; a
#      second one in another module is the duplication this rule exists to prevent.
#   2. no sort key renders. `sort_by_key(|r| r.render())` made every CSS class name part of
#      the ordering of a table, so a rename nobody thought was visible reordered it.
#   3. no `localeCompare` in a surface this repository generates or serves. It orders by
#      the machine's locale, and every Rust and shell comparator here orders by code unit.
#
# The fourth is a ratchet, because the debt is real and predates the rule:
#
#   4. the number of sort sites in the crate outside order.rs, and the number of shell
#      sorts not pinned with LC_ALL=C, may fall and may not rise. The counts live in
#      .ai/repo/order-baseline.txt; lowering one is a commit that adopts the canonical
#      order or pins a locale, and the gate then asks for the baseline to be lowered too.
#      The crate count is production code only: a sort in a `#[cfg(test)]` module, in a
#      file a `#[cfg(test)] mod` declaration gates, or in a doc comment orders a fixture,
#      not a collection a surface shows, and is not debt.
#
#   scripts/ci/order-check              report every finding, exit 10 on any
#   scripts/ci/order-check --sites      list the crate sort sites the ratchet counts
#   scripts/ci/order-check --update     rewrite the baseline from this tree (never in CI)
#   MJ_ROOT=<dir> scripts/ci/order-check
#
# Exit: 0 clean, 10 findings, 12 unusable.
set -eu
ROOT="${MJ_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
cd "$ROOT"
BASELINE=.ai/repo/order-baseline.txt
UPDATE=0
[ "${1:-}" = "--update" ] && UPDATE=1
SITES=0
[ "${1:-}" = "--sites" ] && SITES=1

findings=0
ok()   { printf 'ok    %s\n' "$*"; }
fail() { printf 'FAIL  %s\n' "$*"; findings=$((findings+1)); }

# ---------------------------------------------------------------- 1. one case-folded comparator
folded="$(grep -rn 'to_lowercase()\.cmp(\|to_ascii_lowercase()\.cmp(' \
  apps/majordomus-cli/src --include='*.rs' 2>/dev/null | grep -v 'src/order\.rs:' || true)"
if [ -n "$folded" ]; then
  printf '%s\n' "$folded" | while IFS= read -r line; do
    printf 'FAIL  a case-folded comparator outside order.rs: %s\n' "$line"
  done
  fail "$(printf '%s\n' "$folded" | wc -l | tr -d ' ') case-folded comparator(s) outside order.rs — call crate::order::natural_cmp"
else
  ok "no comparator outside order.rs folds case by hand"
fi

# ---------------------------------------------------------------- 2. no sort key renders
rendered="$(grep -rn 'sort_by_key(.*\.render())\|sort_by(.*\.render()' \
  apps/majordomus-cli/src --include='*.rs' 2>/dev/null || true)"
if [ -n "$rendered" ]; then
  printf '%s\n' "$rendered" | while IFS= read -r line; do
    printf 'FAIL  a sort key that renders markup: %s\n' "$line"
  done
  fail "a collection is ordered by its own markup — order the values, then render them"
else
  ok "no sort key renders markup"
fi

# ---------------------------------------------------------------- 3. no locale-collated comparator
# The call, not the word; in code, not in prose. Markdown is excluded because the
# documentation of this very rule quotes the pattern, and the site carries a copy of it.
# The call, in code we write: `site/public` is the build's output, and the documentation of
# this rule is rendered into it. A generated file is not a place to fix anything.
locale_cmp="$(grep -rn '\.localeCompare(' scripts share site \
  --include='*.js' --include='*.mjs' --include='*.ts' --include='*.html' \
  --exclude-dir=public --exclude-dir=node_modules 2>/dev/null \
  | grep -v '^scripts/ci/order-check:' || true)"
if [ -n "$locale_cmp" ]; then
  printf '%s\n' "$locale_cmp" | while IFS= read -r line; do
    printf 'FAIL  localeCompare in a generated or served surface: %s\n' "$line"
  done
  fail "a comparator orders by the reader's locale — compare code units"
else
  ok "no localeCompare in scripts/, share/ or site/"
fi

# ---------------------------------------------------------------- 4. the ratchets
# Every sort site of the crate that orders something a person could be shown. A sort inside
# a `#[cfg(test)]` module, inside a file that a `#[cfg(test)] mod` declaration gates, or
# inside a doc comment orders a fixture or an example: it is compiled out of the shipped
# binary, no surface renders it, and two of them cannot disagree with each other in front of
# a reader. Counting those as debt made the ratchet ask for canonical order in a test that
# asserts an order — a gate that cries wolf is a gate somebody switches off.
crate_files() {
  find apps/majordomus-cli/src -name '*.rs' | grep -v '/order\.rs$'
}

# The files a `#[cfg(test)] mod <name>;` declaration compiles only for tests, as paths.
test_gated_files() {
  crate_files | xargs awk '
    /#\[cfg\(test\)\]/ { pend = 1; next }
    pend && /^[[:space:]]*(pub[[:space:]]+)?mod[[:space:]]+[A-Za-z0-9_]+[[:space:]]*;/ {
      name = $0
      sub(/^[^m]*mod[[:space:]]+/, "", name)
      sub(/[[:space:]]*;.*$/, "", name)
      dir = FILENAME
      sub(/\/[^\/]*$/, "", dir)
      print dir "/" name ".rs"
      print dir "/" name "/mod.rs"
    }
    { pend = 0 }
  '
}

crate_sort_sites() {
  gated=":$(test_gated_files | tr '\n' ':')"
  crate_files | xargs awk -v gated="$gated" '
    FNR == 1 { depth = 0; testdepth = 0; pend = 0; skip = index(gated, ":" FILENAME ":") > 0 }
    skip { next }
    {
      line = $0
      doc = (line ~ /^[[:space:]]*(\/\/\/|\/\/!)/)
      if (line ~ /#\[cfg\(test\)\]/) pend = 1
      if (pend && line ~ /^[[:space:]]*(pub[[:space:]]+)?mod[[:space:]]+[A-Za-z0-9_]+[[:space:]]*;/) pend = 0
      opened = gsub(/\{/, "{", line)
      closed = gsub(/\}/, "}", line)
      if (pend && opened > 0 && testdepth == 0) { testdepth = depth + 1; pend = 0 }
      depth += opened - closed
      if (testdepth > 0 && depth < testdepth) testdepth = 0
      if (!doc && testdepth == 0 && $0 ~ /\.sort_by\(|\.sort_by_key\(|\.sort\(\)|\.sort_unstable/)
        print FILENAME ":" FNR ":" $0
    }
  '
}

crate_sorts="$(crate_sort_sites | wc -l | tr -d ' ')"

if [ "$SITES" = 1 ]; then
  crate_sort_sites
  printf '# %s site(s)\n' "$crate_sorts"
  exit 0
fi
# `sort` wherever a command begins — after a pipe, a semicolon, a brace, a `&&`, or at the
# start of a line — because an unpinned sort collates by the locale whatever precedes it.
shell_sorts="$(grep -rnE '(\|[[:space:]]*sort\b)|((^|[;&{(]|&&|\|\|)[[:space:]]*sort([[:space:]]|$))' \
  lib scripts bin test 2>/dev/null | grep -vc 'LC_ALL=C' || true)"

if [ "$UPDATE" = 1 ]; then
  {
    printf '# The two ordering debts of this tree, as counts. Written by\n'
    printf '# `scripts/ci/order-check --update`; the gate refuses a rise.\n'
    printf '#\n'
    printf '# crate_sorts   sort sites under apps/majordomus-cli/src outside order.rs, in code\n'
    printf '#               that ships. Each is a comparator that could be the canonical order\n'
    printf '#               and is not yet. Test-only code — a `#[cfg(test)]` module, a file a\n'
    printf '#               `#[cfg(test)] mod` declaration gates, a doc comment — is not counted:\n'
    printf '#               it orders a fixture, and no surface renders it.\n'
    printf '# shell_sorts   `sort` invocations under lib/, scripts/, bin/ and test/ that are not\n'
    printf '#               pinned with LC_ALL=C. A glob or a sort collates by the locale, so an\n'
    printf '#               unpinned one orders by whose machine ran it.\n'
    printf 'crate_sorts=%s\n' "$crate_sorts"
    printf 'shell_sorts=%s\n' "$shell_sorts"
  } > "$BASELINE"
  printf 'order-check: baseline written — crate_sorts=%s shell_sorts=%s\n' "$crate_sorts" "$shell_sorts"
  exit 0
fi

[ -f "$BASELINE" ] || { echo "order-check: $BASELINE is missing; run scripts/ci/order-check --update" >&2; exit 12; }
base_crate="$(sed -n 's/^crate_sorts=//p' "$BASELINE")"
base_shell="$(sed -n 's/^shell_sorts=//p' "$BASELINE")"
[ -n "$base_crate" ] && [ -n "$base_shell" ] \
  || { echo "order-check: $BASELINE does not carry both counts" >&2; exit 12; }

if [ "$crate_sorts" -gt "$base_crate" ]; then
  fail "sort sites in the crate rose from $base_crate to $crate_sorts — a new collection was ordered beside its renderer; implement crate::order::Ordered and call canonical()"
elif [ "$crate_sorts" -lt "$base_crate" ]; then
  fail "sort sites in the crate fell from $base_crate to $crate_sorts — lower the baseline in $BASELINE (scripts/ci/order-check --update)"
else
  ok "sort sites in the crate outside order.rs: $crate_sorts, at the baseline"
fi

if [ "$shell_sorts" -gt "$base_shell" ]; then
  fail "unpinned shell sorts rose from $base_shell to $shell_sorts — write LC_ALL=C sort, so the order does not depend on the machine"
elif [ "$shell_sorts" -lt "$base_shell" ]; then
  fail "unpinned shell sorts fell from $base_shell to $shell_sorts — lower the baseline in $BASELINE (scripts/ci/order-check --update)"
else
  ok "shell sorts not pinned with LC_ALL=C: $shell_sorts, at the baseline"
fi

if [ "$findings" -gt 0 ]; then
  printf 'order-check: %s finding(s)\n' "$findings"
  exit 10
fi
printf 'order-check: clean\n'
