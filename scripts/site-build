#!/usr/bin/env bash
# site-build — build the derived site into public/.
#
#   generate-site-data  ->  zola  ->  vendor assets  ->  tailwind  ->  syntax theme fix
#
# The order is load-bearing. Zola must write the HTML before Tailwind scans it, and the
# vendored JavaScript must be in place before the check step looks for it.
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 1
OUT="$ROOT/public"

step() { printf '\n== %s\n' "$1"; }

step "canonical data"
scripts/generate-site-data

step "zola"
command -v zola >/dev/null 2>&1 || { printf 'site-build: zola is not installed (https://www.getzola.org/documentation/getting-started/installation/)\n' >&2; exit 1; }
rm -rf "$OUT"
zola --root site build --output-dir "$OUT" --force

step "vendor javascript"
[ -d node_modules/flowbite ] || { printf 'site-build: run npm ci first\n' >&2; exit 1; }
mkdir -p "$OUT/js"
# Pinned local copies. Nothing on the site is fetched from a CDN at runtime.
cp node_modules/flowbite/dist/flowbite.min.js "$OUT/js/flowbite.min.js"
cp node_modules/alpinejs/dist/cdn.min.js      "$OUT/js/alpine.min.js"
cp node_modules/mermaid/dist/mermaid.min.js   "$OUT/js/mermaid.min.js"

step "tailwind + flowbite"
node_modules/.bin/tailwindcss -i site/tailwind.css -o "$OUT/css/app.css" --minify 2>&1 | sed 's/^/  /'

step "syntax theme"
# Zola emits two static highlighting themes. The dark one is scoped under .dark so the
# manual theme toggle drives code blocks as well as the page chrome; without this the
# two disagree the moment a reader overrides their system preference.
# Zola names these after the highlighter, at the output root. Both sheets are loaded on
# every page; the token classes are disjoint (z-l-* and z-d-*), so without this scoping
# the dark palette would win in light mode too.
if [ -f "$OUT/giallo-dark.css" ]; then
  awk '
    /^[^ \t{}][^{}]*\{/ && !/^@/ { sub(/^/, ".dark "); gsub(/,[ \t]*/, ", .dark ") }
    { print }' "$OUT/giallo-dark.css" > "$OUT/giallo-dark.css.tmp"
  mv "$OUT/giallo-dark.css.tmp" "$OUT/giallo-dark.css"
  printf '  scoped %s selectors under .dark\n' "$(grep -c '^\.dark ' "$OUT/giallo-dark.css")"
else
  printf '  giallo-dark.css not emitted — check [markdown.highlighting] in site/config.toml\n' >&2
  exit 1
fi

printf '\nsite-build: ok — %s pages, %s bytes of CSS\n' \
  "$(find "$OUT" -name 'index.html' | wc -l | tr -d ' ')" \
  "$(wc -c < "$OUT/css/app.css" | tr -d ' ')"
