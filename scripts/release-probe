#!/usr/bin/env bash
# release-probe: what the LIVE site says about the release, read in a real browser and held to
# what was published. Rule: project.the-site-offers-the-release-it-published (I4530).
#
#   scripts/release-probe                       https://<base_url>/ of site/config.toml, GitHub asked for the releases
#   scripts/release-probe --url URL             another origin (a preview, a fixture served over http)
#   scripts/release-probe --public DIR          serve DIR at the site's origin instead of the network (a case)
#   scripts/release-probe --github FILE         the releases as a file in GitHub's own JSON shape (a case)
#   scripts/release-probe --expect TAG          the release just published must be GitHub's newest and the page must name it
#   scripts/release-probe --wait SECONDS        retry until the readings agree or the seconds are up (a CDN lags)
#   scripts/release-probe --out DIR             home.png and result.json land here (default target/release-probe)
#   scripts/release-probe --repo OWNER/NAME     where the releases are published (default: the distribution model's)
#
# What it holds, on the homepage as a browser renders it with its cache bypassed:
#   - the trust strip's data-release, /releases/latest.json and GitHub's newest non-pre-release release name
#     one version, and the navbar badge names it;
#   - the hero's data-prerelease (and the trust strip's) is the newest published pre-release ahead of that
#     version, or absent when none is ahead; the hero names no other pre-release;
#   - the footer's data-blackboard-commit is /build.json's commit;
#   - with --expect, that tag is GitHub's newest release and the page names its version.
# Until 2026-11-06 the only live reading was scripts/pages release-live: curl and sed over the stable channel.
# The hero named a superseded pre-release for hours after every release and every check stayed green, which
# is the owner's screenshot this exists for.
#
# Without a browser: SKIP and exit 0 locally, exit 12 under CI=true (the convention of the other probes).
# Exit 0 agree, 10 a disagreement (named, both sides), 12 a surface that could not be read, 2 usage.
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LIB="$ROOT/scripts/lib"
# shellcheck source=../lib/runnable.sh
. "$ROOT/lib/runnable.sh" 2>/dev/null || { mj_runs() { command -v "$1" >/dev/null 2>&1; }; mj_runs_why() { printf '%s is not available' "$1"; }; }

URL="" PUBLIC="" GITHUB="" EXPECT="" WAIT=0 OUT="$ROOT/target/release-probe" REPO=""
while [ $# -gt 0 ]; do case "$1" in
  --url) URL="${2:?--url needs a value}"; shift 2 ;;
  --public) PUBLIC="${2:?--public needs a directory}"; shift 2 ;;
  --github) GITHUB="${2:?--github needs a file}"; shift 2 ;;
  --expect) EXPECT="${2:?--expect needs a tag}"; shift 2 ;;
  --wait) WAIT="${2:?--wait needs seconds}"; shift 2 ;;
  --out) OUT="${2:?--out needs a directory}"; shift 2 ;;
  --repo) REPO="${2:?--repo needs owner/name}"; shift 2 ;;
  -h|--help) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) echo "release-probe: unknown option $1" >&2; exit 2 ;;
esac; done
case "$WAIT" in *[!0-9]*) echo "release-probe: --wait takes seconds" >&2; exit 2 ;; esac
[ -n "$URL" ] || URL="$(sed -n 's/^base_url = "\(.*\)"/\1/p' "$ROOT/site/config.toml")"
[ -n "$URL" ] || { echo "release-probe: site/config.toml declares no base_url and no --url was given" >&2; exit 12; }
if [ -n "$PUBLIC" ]; then
  [ -d "$PUBLIC" ] || { echo "release-probe: --public $PUBLIC is not a directory" >&2; exit 12; }
  PUBLIC="$(cd "$PUBLIC" && pwd)"
fi
if [ -n "$GITHUB" ]; then
  [ -f "$GITHUB" ] || { echo "release-probe: --github $GITHUB is not a file" >&2; exit 12; }
fi
# Where the releases are published: the distribution model's `repository`, as pages release-live reads it.
[ -n "$REPO" ] || REPO="$(jq -r '.repository // empty' "$ROOT/site/data/registry/distribution.json" 2>/dev/null || true)"
[ -n "$REPO" ] || REPO="${GITHUB_REPOSITORY:-}"
[ -n "$REPO" ] || REPO="$(git -C "$ROOT" remote get-url origin 2>/dev/null | sed -n 's|.*[:/]\([^/][^/]*/[^/][^/]*\)$|\1|p' | sed 's|\.git$||')"
mj_runs node || { echo "release-probe: node is required: $(mj_runs_why node)" >&2; exit 12; }
[ -d "$ROOT/node_modules/playwright" ] || { echo "release-probe: playwright is not installed in $ROOT (npm ci)" >&2; [ "${CI:-}" = true ] && exit 12; echo "SKIP release-probe: no playwright"; exit 0; }
mkdir -p "$OUT"
export MJ_RP_URL="${URL%/}" MJ_RP_PUBLIC="$PUBLIC" MJ_RP_GITHUB="$GITHUB" MJ_RP_EXPECT="$EXPECT" MJ_RP_WAIT="$WAIT" \
  MJ_RP_OUT="$OUT" MJ_RP_REPO="$REPO" MJ_PROBE_LIB="$LIB" MJ_RP_ROOT="$ROOT"
cd "$ROOT" && exec node --input-type=module - <<'JS'
import { readFileSync, writeFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { execFileSync } from 'node:child_process';
const env = process.env;
const { launch, serveSite } = await import(`${env.MJ_PROBE_LIB}/browser.mjs`);
const url = env.MJ_RP_URL;
const origin = new URL(url).origin;
const pub = env.MJ_RP_PUBLIC;
const out = env.MJ_RP_OUT;
const expect = env.MJ_RP_EXPECT;
const waitSec = Number(env.MJ_RP_WAIT || 0);

// ---- versions. A pre-release sorts before the release it precedes; anything that does not parse is kept
// as text and never equal to a version, so a page that names "unknown" is a disagreement, not a match.
const parse = (v) => {
  const m = String(v || '').match(/^v?(\d+)\.(\d+)\.(\d+)(?:-([a-z]+)\.(\d+))?$/);
  return m ? { n: [Number(m[1]), Number(m[2]), Number(m[3])], pre: m[4] ? [m[4], Number(m[5])] : null, text: m[0].replace(/^v/, '') } : null;
};
const cmp = (a, b) => {
  for (let i = 0; i < 3; i++) if (a.n[i] !== b.n[i]) return a.n[i] - b.n[i];
  if (!a.pre && !b.pre) return 0;
  if (!a.pre) return 1;
  if (!b.pre) return -1;
  if (a.pre[0] !== b.pre[0]) return a.pre[0] < b.pre[0] ? -1 : 1;
  return a.pre[1] - b.pre[1];
};

// ---- what was published: GitHub's releases, from a file (a case) or from the forge
const releases = () => {
  if (env.MJ_RP_GITHUB) { try { return JSON.parse(readFileSync(env.MJ_RP_GITHUB, 'utf8')); } catch { return null; } }
  const repo = env.MJ_RP_REPO;
  if (!repo) return null;
  try { return JSON.parse(execFileSync('gh', ['api', `repos/${repo}/releases?per_page=50`], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] })); } catch { /* no gh, no token */ }
  try {
    const headers = { accept: 'application/vnd.github+json', 'user-agent': 'majordomus-release-probe' };
    if (env.GH_TOKEN) headers.authorization = `Bearer ${env.GH_TOKEN}`;
    const r = execFileSync('curl', ['-fsSL', '--max-time', '30', '-H', `accept: ${headers.accept}`, '-H', `user-agent: ${headers['user-agent']}`,
      ...(env.GH_TOKEN ? ['-H', `authorization: ${headers.authorization}`] : []), `https://api.github.com/repos/${repo}/releases?per_page=50`], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
    return JSON.parse(r);
  } catch { return null; }
};
const published = (list) => {
  const live = (list || []).filter((r) => !r.draft && parse(r.tag_name));
  const byTime = (a, b) => String(b.published_at || b.created_at || '').localeCompare(String(a.published_at || a.created_at || ''));
  live.sort(byTime);
  const stable = live.find((r) => !r.prerelease) || null;
  const pres = live.filter((r) => r.prerelease);
  const newestPre = pres.length ? pres.reduce((a, b) => (cmp(parse(a.tag_name), parse(b.tag_name)) >= 0 ? a : b)) : null;
  const ahead = newestPre && (!stable || cmp(parse(newestPre.tag_name), parse(stable.tag_name)) > 0) ? newestPre : null;
  const newest = live.length ? live.reduce((a, b) => (cmp(parse(a.tag_name), parse(b.tag_name)) >= 0 ? a : b)) : null;
  return { stable, ahead, newest };
};

// ---- the site's own JSON, read beside the page: /releases/latest.json and /build.json
const readJson = async (path) => {
  if (pub) {
    const f = join(pub, path);
    try { return JSON.parse(readFileSync(f, 'utf8')); } catch { return null; }
  }
  try {
    const r = await fetch(`${url}/${path}?nocache=${Date.now()}`, { cache: 'no-store', headers: { 'cache-control': 'no-cache', pragma: 'no-cache' } });
    if (!r.ok) return null;
    return await r.json();
  } catch { return null; }
};

const browser = await launch();
if (!browser) {
  if (env.CI === 'true') { console.log('release-probe: no browser could be started under CI; a page nobody rendered was not checked'); process.exit(12); }
  console.log('SKIP release-probe: no browser could be started (install Chrome, set CHROME_BIN, or: npx playwright install chromium)');
  process.exit(0);
}
const context = await browser.newContext({ viewport: { width: 1440, height: 1100 } });
const foreign = [];
if (pub) await serveSite(context, pub, origin, (href) => foreign.push(href));
else await context.route('**/*', (route) => route.continue({ headers: { ...route.request().headers(), 'cache-control': 'no-cache', pragma: 'no-cache' } }));
const page = await context.newPage();

const read = async () => {
  const r = { url: null, status: null, findings: [], unread: [] };
  let resp = null;
  try { resp = await page.goto(`${url}/?nocache=${Date.now()}`, { waitUntil: 'networkidle', timeout: 60000 }); } catch (e) { r.unread.push(`the homepage did not load: ${String(e.message || e).split('\n')[0]}`); return r; }
  r.url = resp.url(); r.status = resp.status();
  if (resp.status() >= 400) { r.unread.push(`the homepage answered HTTP ${resp.status()}`); return r; }
  const dom = await page.evaluate(() => {
    const attr = (sel, a) => { const el = document.querySelector(sel); return el ? el.getAttribute(a) : null; };
    const text = (sel) => { const el = document.querySelector(sel); return el ? el.innerText.replace(/\s+/g, ' ') : ''; };
    return {
      release: attr('[data-trust-key="release"]', 'data-release'),
      trustPrerelease: attr('[data-trust-key="release"] [data-prerelease]', 'data-prerelease'),
      heroPrerelease: attr('#hero [data-prerelease]', 'data-prerelease'),
      heroText: text('#hero'),
      navText: text('nav'),
      footerCommit: attr('[data-blackboard-commit]', 'data-blackboard-commit'),
      trustCommit: text('[data-trust-key="commit"]'),
      title: document.title,
    };
  });
  Object.assign(r, dom);
  r.navBadge = (dom.navText.match(/\bv\d+\.\d+\.\d+(?:-[a-z]+\.\d+)?\b/) || [null])[0];
  r.heroPrereleasesNamed = [...new Set((dom.heroText.match(/\b\d+\.\d+\.\d+-(?:alpha|beta|rc)\.\d+\b/g) || []))];
  r.latest = await readJson('releases/latest.json');
  r.build = await readJson('build.json');
  const gh = releases();
  r.github = gh ? published(gh) : null;
  // ---- the verdict
  const f = r.findings, u = r.unread;
  if (!r.release) u.push('the homepage carries no data-release on its trust strip, so the offered release could not be read');
  if (!r.latest || !r.latest.version) u.push('/releases/latest.json could not be read, or names no version');
  if (!r.build || !r.build.commit) u.push('/build.json could not be read, or names no commit');
  if (!r.github) u.push(`GitHub's releases of ${env.MJ_RP_REPO || '(no repository)'} could not be read (no gh, no token, no network)`);
  if (u.length) return r;
  const stable = r.github.stable ? parse(r.github.stable.tag_name).text : null;
  const ahead = r.github.ahead ? parse(r.github.ahead.tag_name).text : null;
  if (r.release !== r.latest.version) f.push(`the homepage offers ${r.release} and /releases/latest.json names ${r.latest.version}`);
  if (stable && r.release !== stable) f.push(`the homepage offers ${r.release} and GitHub's newest release is ${r.github.stable.tag_name}`);
  if (r.navBadge && r.navBadge !== `v${r.release}`) f.push(`the navbar badge says ${r.navBadge} and the trust strip offers ${r.release}`);
  if (ahead && r.heroPrerelease !== ahead) f.push(`the hero names the pre-release ${r.heroPrerelease || 'nothing'}, and the newest published pre-release ahead of ${stable} is ${r.github.ahead.tag_name}`);
  if (!ahead && r.heroPrerelease) f.push(`the hero names the pre-release ${r.heroPrerelease}, and no published pre-release is ahead of ${stable}`);
  if (r.trustPrerelease && r.trustPrerelease !== (ahead || r.trustPrerelease) ) f.push(`the trust strip names the pre-release ${r.trustPrerelease}, and the newest published pre-release ahead of ${stable} is ${ahead}`);
  const superseded = r.heroPrereleasesNamed.filter((v) => v !== ahead);
  if (superseded.length) f.push(`the hero names the superseded pre-release(s) ${superseded.join(', ')}${ahead ? `; the newest published is ${ahead}` : ''}`);
  if (r.footerCommit && r.footerCommit !== r.build.commit) f.push(`the footer says the page was built from ${r.footerCommit.slice(0, 11)} and /build.json names ${String(r.build.commit).slice(0, 11)}`);
  if (!r.footerCommit) f.push('the footer names no commit (data-blackboard-commit), so the build this page came from cannot be checked');
  if (expect) {
    const e = parse(expect);
    if (!e) f.push(`--expect ${expect} is not a version tag`);
    else {
      const newest = r.github.newest ? r.github.newest.tag_name : null;
      if (newest !== expect) f.push(`GitHub's newest release is ${newest || 'nothing'}, not ${expect}`);
      const named = e.pre ? r.heroPrerelease : r.release;
      if (named !== e.text) f.push(`the page names ${named || 'nothing'} where ${expect} was published`);
    }
  }
  return r;
};

const t0 = Date.now();
process.on('unhandledRejection', (e) => { console.log(`release-probe: NOT DETERMINED ${String(e && e.message || e).split('\n')[0]}`); process.exit(12); });
let r = await read();
while ((r.findings.length || r.unread.length) && (Date.now() - t0) / 1000 < waitSec) {
  await new Promise((res) => setTimeout(res, 15000));
  r = await read();
}
try { await page.screenshot({ path: join(out, 'home.png'), fullPage: false }); } catch { /* an unloaded page has no picture */ }
const result = { probed_at: new Date().toISOString(), url: r.url, status: r.status, title: r.title,
  readings: { release: r.release, nav_badge: r.navBadge, hero_prerelease: r.heroPrerelease, trust_prerelease: r.trustPrerelease,
    hero_prereleases_named: r.heroPrereleasesNamed, footer_commit: r.footerCommit, latest_json: r.latest ? { version: r.latest.version, tag: r.latest.tag } : null,
    build_json: r.build ? { commit: r.build.commit, release: r.build.release ? r.build.release.version : null } : null,
    github: r.github ? { stable: r.github.stable ? r.github.stable.tag_name : null, prerelease_ahead: r.github.ahead ? r.github.ahead.tag_name : null, newest: r.github.newest ? r.github.newest.tag_name : null } : null },
  expect: expect || null, foreign_requests: foreign.slice(0, 20), findings: r.findings, unread: r.unread,
  verdict: r.unread.length ? 'not determined' : r.findings.length ? 'disagree' : 'ok' };
writeFileSync(join(out, 'result.json'), JSON.stringify(result, null, 2) + '\n');
await browser.close();
console.log(`release-probe: ${url}/ (${result.verdict}; ${out}/home.png, ${out}/result.json)`);
console.log(`  trust strip offers      ${r.release ?? '(unread)'}${r.navBadge ? `, navbar badge ${r.navBadge}` : ''}`);
console.log(`  hero pre-release        ${r.heroPrerelease ?? '(none)'}${r.heroPrereleasesNamed.length ? ` (named: ${r.heroPrereleasesNamed.join(', ')})` : ''}`);
console.log(`  /releases/latest.json   ${r.latest ? r.latest.version : '(unreadable)'}`);
console.log(`  /build.json commit      ${r.build ? String(r.build.commit).slice(0, 11) : '(unreadable)'}; footer ${r.footerCommit ? r.footerCommit.slice(0, 11) : '(none)'}`);
console.log(`  GitHub newest release   ${r.github && r.github.stable ? r.github.stable.tag_name : '(unreadable)'}${r.github && r.github.ahead ? `, pre-release ahead ${r.github.ahead.tag_name}` : ''}`);
for (const m of r.unread) console.log(`  NOT DETERMINED ${m}`);
for (const m of r.findings) console.log(`  FAIL ${m}`);
if (r.unread.length) process.exit(12);
if (r.findings.length) process.exit(10);
console.log('  ok — the homepage, its JSON and GitHub name the same releases and commit');
JS
