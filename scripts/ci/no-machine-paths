#!/usr/bin/env bash
# no-machine-paths — refuses a tree that names the machine it was written on.
#
# One definition, three callers: scripts/ci/core-check runs it as a gate,
# test/cases/58_home_path_gate.sh runs it against fixtures to prove it can fail, and a
# person runs it directly. The pattern lived in three places before this script existed,
# which is the shape project.no-machine-paths itself argues against.
#
# Usage: no-machine-paths [<repository>]     (default: this repository)
# Exit:  0 clean, 1 with every match printed as <file>:<line>:<text>, 2 when the
#        definition of the patterns cannot be read.
set -eu
here="$(cd "$(dirname "$0")/../.." && pwd)"
root="${1:-$here}"

# The patterns are the machine-path class of the repository's one definition of what a
# committed or published file must never carry, apps/majordomus-cli/src/quality/
# leak-patterns.tsv — `/Users/<name>/` and `/home/<name>/dev/`, the two shapes a developer
# checkout takes, and deliberately not every `/home/<name>/` (the file says why).
# scripts/site-check applies the same file to the built site and `majordomus quality
# rustdoc` to the crate's documentation tree, so no reader keeps a copy of a pattern.
#
# Read from this script's own repository, never from the one being judged: the fixtures
# test/cases/58_home_path_gate.sh judges carry no definition, and a gate whose subject
# supplied its own patterns could be emptied by it. A definition that yields no pattern is
# a refusal and never a pass — a gate with nothing to look for reports clean.
DEFINITION="$here/apps/majordomus-cli/src/quality/leak-patterns.tsv"
patterns=()
while IFS= read -r p; do
  [ -n "$p" ] && patterns+=(-e "$p")
done < <(LC_ALL=C awk -F'\t' '$1 == "machine-path" { print $3 }' "$DEFINITION" 2>/dev/null || true)
[ "${#patterns[@]}" -gt 0 ] || {
  echo "no-machine-paths: no machine-path pattern could be read from ${DEFINITION#"$here"/}; refusing to report a tree clean without looking" >&2
  exit 2
}

# Everything tracked, except the two places the pattern is legitimately written down:
# the fixtures that prove this gate fails, and the gates that quote the pattern.
hits="$(git -C "$root" grep -n -I -E "${patterns[@]}" -- \
          . ':!test/**' ':!scripts/ci/no-machine-paths' ':!scripts/ci/core-check' \
          ':!scripts/site-check' 2>/dev/null || true)"

[ -z "$hits" ] || {
  cat >&2 <<'WHY'
a committed file names a home directory, so this repository does not read the same
anywhere else. Two different faults share this message:

  - an authored document (.ai/, docs/, site/content-src/, README.md): write what the
    path means — "a developer's working directory" — rather than an example of one;
  - a generated artifact (share/, docs/generated/, site/data/, site/content/): the
    generator wrote its own location into its output. Do not edit the file; find the
    path helper that fell back to an absolute path. `derive-check` cannot see this,
    because it regenerates in the same checkout and gets the same answer back.

WHY
  printf '%s\n' "$hits" >&2
  exit 1
}
