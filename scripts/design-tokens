#!/usr/bin/env bash
# design-tokens — the design tokens, projected into the stylesheets that consume them.
#
# One file chooses a value: share/design/tokens.yaml. Two files are written from it, and
# neither is edited by hand:
#
#   share/design/theme.css                    the Tailwind `@theme`. Imported by the site's
#                                             entry point (site/tailwind.css) and by the
#                                             Cockpit's (share/cockpit/src/cockpit.css),
#                                             after Flowbite's default theme, so the two
#                                             Tailwind builds resolve the same type and the
#                                             same accent from the same declaration.
#
#   share/design/surface.css                  the semantic surface in the layer and under
#                                             the selector the Cockpit's stylesheet is
#                                             written against, with its own `--mj-*` names
#                                             declared as aliases of the canonical ones.
#
#   apps/majordomus-cli/src/web/tokens.css    the same tokens as plain custom properties,
#                                             for the pages the executable renders itself —
#                                             a generated report, the home page, the Swagger
#                                             shell. Those have no Tailwind and fetch no
#                                             asset, so the block is compiled in with
#                                             include_str! and written inline. It lives
#                                             inside the crate rather than under share/ so
#                                             that the crate still builds when packaged
#                                             alone.
#
#   scripts/design-tokens            write both
#   scripts/design-tokens --check    write both into temporary files and fail if the
#                                    committed ones differ
#
# Exit: 0 written or current, 10 drift found, 12 the canonical file is missing.
#
# The rule is project.design-tokens-declared-once; ADR 0029 records the decision. The
# `design` gate runs --check, so a value changed here and not regenerated cannot land.
set -eu
# `--root DIR` runs against another tree. It exists so the case in test/cases can drive
# the real script over a fixture instead of asserting about a copy of it.
if [ "${1:-}" = "--root" ]; then ROOT="${2:?--root needs a directory}"; shift 2; else
  ROOT="$(cd "$(dirname "$0")/.." && pwd)"
fi
SRC="$ROOT/share/design/tokens.yaml"
THEME="$ROOT/share/design/theme.css"
SURFACE="$ROOT/share/design/surface.css"
INLINE="$ROOT/apps/majordomus-cli/src/web/tokens.css"
CHECK=0
[ "${1:-}" = "--check" ] && CHECK=1

[ -f "$SRC" ] || { echo "design-tokens: no canonical declaration at ${SRC#$ROOT/}" >&2; exit 12; }

# Both projections, written by one process from one read of one file. The parser accepts
# the subset the canonical file is written in — a two-level map whose values run to the end
# of the line — so nothing here depends on a YAML library being installed.
render() { # theme-destination surface-destination inline-destination
  python3 - "$SRC" "$1" "$2" "$3" <<'PY'
import re, sys

source, theme_out, surface_out, inline_out = sys.argv[1:5]

# A trailing comment is a `#` with whitespace in front of it. A `#` that opens a value is
# a colour: `bg: "#fff"` is a value and not a comment, and a parser that cannot tell the
# two apart silently writes an empty custom property.
TRAILING = re.compile(r"\s+#.*$")

def unquote(value):
    """Strip the quotes of a wholly quoted scalar, and nothing else.

    `bg: "#fff"` is one quoted value and the quotes are syntax. A font stack ends with
    `"Noto Color Emoji"` and its quotes are content: taking them off produces a
    declaration CSS cannot parse, which Tailwind drops in silence, which is a surface
    losing its type stack with every check still green. The difference is whether the
    closing quote is the one the opening quote matches."""
    if len(value) >= 2 and value[0] == '"' and value[-1] == '"' and '"' not in value[1:-1]:
        return value[1:-1]
    return value


groups, group = {}, None
for raw in open(source, encoding="utf-8"):
    line = "" if raw.lstrip().startswith("#") else TRAILING.sub("", raw.rstrip())
    if not line.strip():
        continue
    key, _, value = line.partition(":")
    value = value.strip()
    if not raw.startswith((" ", "\t")):          # a top-level key opens a group
        group = key.strip()
        groups[group] = {}
        if value and value != "":
            groups[group] = value                # a scalar at the top level (schema: 1)
    elif isinstance(groups.get(group), dict):
        groups[group][key.strip()] = unquote(value)

font, accent = groups["font"], groups["accent"]
light, dark = groups["surface-light"], groups["surface-dark"]
alias = groups["alias"]
assert set(light) == set(dark), "the light and dark surfaces must name the same tokens"
def alias_target(target):
    """What an alias points at: a surface token, or a step of the accent ramp."""
    if target in light:
        return "var(--%s)" % target
    if target.startswith("accent-") and target[len("accent-"):] in accent:
        return "var(--color-%s)" % target
    sys.exit("design-tokens: alias points at %s, which is neither a surface token nor an "
             "accent step" % target)

BANNER = ("/* GENERATED FILE - DO NOT EDIT DIRECTLY\n"
          "   Source: share/design/tokens.yaml, the one place a design value is chosen\n"
          "   Generator: scripts/design-tokens */\n")

# The Tailwind theme: type and the accent ramp. The semantic surface is not repeated here.
# Tailwind's own palette already answers those questions for a utility class, and a second
# name for gray-900 would be exactly the duplication this file exists to remove.
theme = [BANNER, "@theme {\n",
         "  --font-sans: %s;\n" % font["sans"],
         "  --font-mono: %s;\n" % font["mono"], "\n"]
for step in sorted(accent, key=int):
    theme.append("  --color-accent-%s: %s;\n" % (step, accent[step]))
theme.append("}\n")

# The custom properties, for a page with no Tailwind. Dark is answered twice on purpose:
# by the media query, for a report opened from the filesystem where no script has run, and
# by the `dark` class, which is the switch the site and the Cockpit already use.
def block(values, indent):
    return "".join("%s--%s: %s;\n" % (indent, name, values[name]) for name in sorted(values))

inline = [BANNER,
          ":root {\n",
          "  color-scheme: light dark;\n",
          "  --font-sans: %s;\n" % font["sans"],
          "  --font-mono: %s;\n" % font["mono"],
          "  --accent: %s;\n" % accent["600"],
          block(light, "  "),
          "}\n",
          "@media (prefers-color-scheme: dark) {\n",
          "  :root:not(.light) {\n",
          block(dark, "    "),
          "  }\n",
          "}\n",
          ":root.dark {\n",
          block(dark, "  "),
          "}\n"]

# Written CSS is checked before it is written. A projection that is stale fails the gate
# loudly; a projection that is malformed is dropped by the CSS parser in silence and every
# check downstream still passes, so the generator refuses to emit one.
# The Cockpit's block: the same values, in the layer and under the selector its stylesheet
# is written against. Its dark is the `dark` class alone, with no media query, because the
# Cockpit sets the class itself before first paint and a media query underneath it would
# make an untoggled Cockpit follow the operating system instead of its own switch.
surface = [BANNER, "@layer base {\n", "  :root {\n", "    color-scheme: light;\n",
           block(light, "    ")]
for name in sorted(alias):
    surface.append("    %s: %s;\n" % (name, alias_target(alias[name])))
surface += ["  }\n", "  :where(.dark) {\n", "    color-scheme: dark;\n",
            block(dark, "    "), "  }\n", "}\n"]

for name, text in (("theme.css", "".join(theme)), ("surface.css", "".join(surface)),
                   ("tokens.css", "".join(inline))):
    for number, line in enumerate(text.splitlines(), 1):
        if line.count('"') % 2:
            sys.exit("design-tokens: %s:%d has an unbalanced quote: %s" % (name, number, line.strip()))
        if line.strip().startswith("--") and not line.rstrip().endswith(";"):
            sys.exit("design-tokens: %s:%d is a declaration with no value: %s" % (name, number, line.strip()))

open(theme_out, "w", encoding="utf-8").write("".join(theme))
open(surface_out, "w", encoding="utf-8").write("".join(surface))
open(inline_out, "w", encoding="utf-8").write("".join(inline))
PY
}

if [ "$CHECK" = 1 ]; then
  a="$(mktemp -t design-theme.XXXXXX)"; b="$(mktemp -t design-surface.XXXXXX)"
  c="$(mktemp -t design-inline.XXXXXX)"
  trap 'rm -f "$a" "$b" "$c"' EXIT
  render "$a" "$b" "$c"
  stale=""
  cmp -s "$a" "$THEME"   || stale="$stale ${THEME#$ROOT/}"
  cmp -s "$b" "$SURFACE" || stale="$stale ${SURFACE#$ROOT/}"
  cmp -s "$c" "$INLINE"  || stale="$stale ${INLINE#$ROOT/}"
  if [ -n "$stale" ]; then
    echo "design-tokens: stale against share/design/tokens.yaml:$stale" >&2
    echo "design-tokens: run: scripts/design-tokens" >&2
    exit 10
  fi
  echo "==> design-tokens: both projections match share/design/tokens.yaml"
  exit 0
fi

render "$THEME" "$SURFACE" "$INLINE"
echo "==> design-tokens: wrote ${THEME#$ROOT/}, ${SURFACE#$ROOT/} and ${INLINE#$ROOT/}"
