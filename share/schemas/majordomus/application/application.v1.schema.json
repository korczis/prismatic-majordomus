        "summary": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "description": "Orders the listing. Lower comes first.",
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "active",
            "draft",
            "deprecated"
          ]
        },
        "fits_when": {
          "description": "The conditions under which the tool suits this context. Naming none would make the record an advertisement.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "does_not_fit_when": {
          "description": "The conditions under which it does not. A record that cannot say when it does not fit has not been thought through.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "use_cases": {
          "description": "The use cases this application composes; every one must exist.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "doctrines": {
          "description": "The rules it leans on; every one must exist.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Section": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "heading": {
          "type": "string"
        },
        "level": {
          "type": "integer"
        },
        "empty": {
          "type": "boolean"
        }
      }
    },
    "Body": {
      "description": "The body carries the narrative: the situation this application is written for, in the words of someone who has been in it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sections"
      ],
      "properties": {
        "sections": {
