#!/usr/bin/env bash
# projection-check — every command of the command line is accounted for against the registry.
#
# Every interface of the executable but one is built by walking the capability registry, so
# it cannot carry an entry the registry does not have. The command line is declared a second
# time, in clap, and `capabilities validate` already refuses a capability that claims a
# command the clap declaration does not answer. That is the half that can be decided
# outright.
#
# The other half is the one this gate asks. A runnable command that no capability claims is
# not wrong: `serve` and `mcp` start processes, `generate` writes files, and the worktree
# verbs call a service directly. Some of those will never be capabilities. But each of them
# has to *say so*, once, beside the command line it is about —
# `apps/majordomus-cli/src/cli/local.rs` — with one of four structural reasons and a note.
# A command that says nothing is an operation that left the API by accident rather than by
# decision, and that is what fails here.
#
# There is no baseline file. There was one, `.ai/repo/projection-baseline.txt`, holding the
# names of the commands no capability claimed; it was a third copy of a set two enforced
# declarations already pin (`CliExposure` and `cli::LOCAL`, checked against each other in
# both directions by `quality::parity`), it carried no reason for any entry, and it went
# stale twice — each time admitting a landing's new commands as findings rather than as the
# classified commands they already were. A repeated semantic definition across projections
# is the defect ADR 4 names, so the inventory is read from the executable, which is where
# the reasons live.
#
#   scripts/ci/projection-check          report, and fail on a command that explains nothing
#   scripts/ci/projection-check --strict fail on any command no capability claims at all
#
# Exit: 0 clean, 10 an unclassified command (or any hand-written command under --strict),
# 12 unusable.
set -euo pipefail

ROOT="${MJ_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
cd "$ROOT"
MODE="report"
while [ $# -gt 0 ]; do case "$1" in
  --strict) MODE="strict"; shift ;;
  *) echo "projection-check: unknown option $1" >&2; exit 2 ;;
esac; done

command -v jq >/dev/null 2>&1 || { echo "projection-check: jq is required" >&2; exit 12; }

# The one launcher every caller shares; it builds the executable when it must.
RB="$ROOT/bin/majordomus-cli"
[ -x "$RB" ] || { echo "projection-check: $RB is not executable" >&2; exit 12; }

tmp="$(mktemp "${TMPDIR:-/tmp}/mj.proj.XXXXXX")"
trap 'rm -f "$tmp" "$tmp.now" "$tmp.open"' EXIT

if ! "$RB" capabilities projections --format json 2>/dev/null > "$tmp"; then
  echo "projection-check: the executable could not answer capabilities projections" >&2
  exit 12
fi
jq -e '(.rows | type) == "array" and (.unbacked | type) == "array" and (.unclassified | type) == "array"' "$tmp" >/dev/null 2>&1 \
  || { echo "projection-check: capabilities projections did not answer the expected shape" >&2; exit 12; }

# A capability claiming a command the clap declaration does not answer is decided by
# `capabilities validate`, not here; if one slipped through, say so rather than measuring
# the debt of a tree that is already broken.
unmet="$(jq -r '[.rows[] | select(.closed == false) | .id] | join(" ")' "$tmp")"
if [ -n "$unmet" ]; then
  echo "projection-check: a capability claims a command line that does not exist: $unmet" >&2
  echo "                  reproduce: majordomus capabilities projections --unmet" >&2
  exit 10
fi

jq -r '.unbacked[]' "$tmp" | LC_ALL=C sort > "$tmp.now"
jq -r '.unclassified[]' "$tmp" | LC_ALL=C sort > "$tmp.open"
total="$(wc -l < "$tmp.now" | tr -d ' ')"
open_count="$(wc -l < "$tmp.open" | tr -d ' ')"

if [ "$MODE" = strict ] && [ "$total" -gt 0 ]; then
  echo "projection-check: $total command(s) are claimed by no capability (--strict)"
  sed 's/^/  /' "$tmp.now"
  exit 10
fi

if [ "$open_count" -gt 0 ]; then
  echo "projection-check: $open_count command(s) are claimed by no capability and say why nowhere" >&2
  sed 's/^/  + /' "$tmp.open" >&2
  echo "  a command of the executable is declared once, as a capability, and the command line" >&2
  echo "  is a projection of that declaration (rule project.interfaces-are-projections@1)." >&2
  echo "  remedy: give the capability a CliExposure, or declare the command in" >&2
  echo "          apps/majordomus-cli/src/cli/local.rs with the reason it is local." >&2
  echo "  reproduce: scripts/ci/projection-check" >&2
  exit 10
fi

echo "projection-check: $total command(s) claimed by no capability, every one classified in cli::LOCAL"
exit 0
