#!/usr/bin/env bash
# ci-baseline — what GitHub observed of recent workflow runs, recorded as data: per run the
# commit, the event, the branch, the conclusion and the wall time; per job the runner, the
# queue time and the duration; per step the seconds. Written to .ai/repo/ci/baseline.json
# (or --out), the file a later measurement is compared with when the question is "why did
# CI become slow". Nothing here is typed by hand: rerun it and commit the diff.
#
#   scripts/ci-baseline [--runs N] [--workflow NAME]... [--out FILE] [--note TEXT]
#   scripts/ci-baseline --table [FILE]        render a recorded baseline as a table
#   scripts/ci-baseline --structure-durations [--runs N] [--out FILE]
#                                             the seconds each structure gate took, the
#                                             longest of the last N successful validate
#                                             runs on master, from the ci-metrics-structure
#                                             and ci-metrics-structure-b artifacts those runs
#                                             uploaded (I4381); written to
#                                             .ai/repo/ci/structure-durations.tsv, which
#                                             scripts/ci/run-plan --before-push budgets by;
#                                             and, beside it, the wall seconds of every
#                                             structure job of the runs that ran all of the
#                                             model's structure jobs, written to
#                                             .ai/repo/ci/structure-job-durations.tsv (or
#                                             --window FILE): the window `majordomus gates
#                                             headroom` judges against half of each bound
#
# Needs the GitHub CLI, authenticated. Exit 0, 2 on usage, 12 when gh cannot answer.
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT=""; RUNS=""; WORKFLOWS=""; NOTE=""; TABLE=0; DURATIONS=0; WINDOW=""
while [ $# -gt 0 ]; do
  case "$1" in
    --runs) RUNS="$2"; shift 2 ;;
    --workflow) WORKFLOWS="$WORKFLOWS $2"; shift 2 ;;
    --out) OUT="$2"; shift 2 ;;
    --note) NOTE="$2"; shift 2 ;;
    --table) TABLE=1; shift; if [ $# -gt 0 ]; then OUT="$1"; shift; fi ;;
    --structure-durations) DURATIONS=1; shift ;;
    --window) WINDOW="$2"; shift 2 ;;
    *) echo "ci-baseline: unknown option $1" >&2; exit 2 ;;
  esac
done
command -v jq >/dev/null || { echo "ci-baseline: jq is required" >&2; exit 12; }

# ---------------------------------------------------------------- structure durations
# What each structure gate costs, as CI measured it, so that what may run before a push is
# chosen from recorded seconds and never from a list somebody typed. The longest of the last
# runs, not their median: a budget built on the typical run is exceeded on every slow one.
if [ "$DURATIONS" = 1 ]; then
  command -v gh >/dev/null || { echo "ci-baseline: the GitHub CLI (gh) is required" >&2; exit 12; }
  [ -n "$OUT" ] || OUT="$ROOT/.ai/repo/ci/structure-durations.tsv"; [ -n "$RUNS" ] || RUNS=5
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/mj-ci-durations.XXXXXX")"; trap 'rm -rf "$tmp"' EXIT
  ids="$(gh run list --workflow validate --branch master --status success --limit "$RUNS" \
    --json databaseId -q '.[].databaseId' 2>/dev/null)" || { echo "ci-baseline: gh cannot list the validate runs" >&2; exit 12; }
  got=""
  # both structure jobs (I4381): a pattern puts each artifact in a directory of its own, and a
  # run from before structure-b existed carries only the first
  for id in $ids; do
    gh run download "$id" -p 'ci-metrics-structure*' -D "$tmp/$id" >/dev/null 2>&1 && got="$got $id"
  done
  [ -n "$got" ] || { echo "ci-baseline: no ci-metrics-structure artifact in the last $RUNS successful validate runs on master" >&2; exit 12; }
  mkdir -p "$(dirname "$OUT")"
  # a gate line is "<job><TAB><gate id><TAB><seconds>"; the dispatcher's other lines name a
  # step in words and are not gates
  { printf '# Generated by scripts/ci-baseline --structure-durations from validate runs%s on\n' "$got"
    printf '# master: the longest seconds each structure gate took. Never typed; rerun and commit.\n'
    find "$tmp" -type f -name timings.tsv -exec cat {} + | awk -F'\t' 'NF == 3 && $2 !~ / / && $3 ~ /^[0-9]+$/ {
        if (!($2 in s) || $3 > s[$2]) s[$2] = $3 } END { for (g in s) print g "\t" s[g] }' | LC_ALL=C sort
  } > "$OUT"
  printf 'ci-baseline: %s structure gate duration(s) from run(s)%s recorded in %s\n' \
    "$(grep -vc '^#' "$OUT")" "$got" "${OUT#"$ROOT"/}"

  # The window of job wall times (I4381, criterion 9). One cohort only: a run is kept when it
  # ran every structure job the model assigns gates to, because a run from before a split
  # measured a different job under the same name. A job's wall time is its completed_at minus
  # started_at as GitHub reports them; queue time is not the job's.
  [ -n "$WINDOW" ] || WINDOW="$ROOT/.ai/repo/ci/structure-job-durations.tsv"
  jobs="$(sed -n 's/^    job: \(structure\(-[a-z0-9]*\)\{0,1\}\)[[:space:]]*$/\1/p' "$ROOT/.ai/repo/ci/gates.yaml" | LC_ALL=C sort -u)"
  [ -n "$jobs" ] || { echo "ci-baseline: .ai/repo/ci/gates.yaml assigns no gate to a structure job" >&2; exit 12; }
  jobs_line="$(printf '%s\n' "$jobs" | tr '\n' ' ' | sed 's/ $//')"
  slug="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null)" || { echo "ci-baseline: gh cannot name the repository" >&2; exit 12; }
  kept=""; : > "$tmp/window"
  for id in $ids; do
    gh api "repos/$slug/actions/runs/$id/jobs?filter=latest&per_page=100" > "$tmp/jobs-$id.json" 2>/dev/null \
      || { echo "ci-baseline: gh cannot read the jobs of run $id" >&2; exit 12; }
    rows="$(jq -r --arg id "$id" '.jobs[] | select(.started_at and .completed_at and .conclusion == "success")
              | "\($id)\t\(.name)\t\(((.completed_at | fromdateiso8601) - (.started_at | fromdateiso8601)))"' "$tmp/jobs-$id.json")"
    all=1
    for j in $jobs; do printf '%s\n' "$rows" | awk -F'\t' -v j="$j" '$2 == j {f=1} END {exit !f}' || all=0; done
    [ "$all" = 1 ] || continue
    printf '%s\n' "$rows" | awk -F'\t' -v js=" $jobs_line " 'index(js, " " $2 " ")' >> "$tmp/window"
    kept="$kept $id"
  done
  { printf '# Generated by scripts/ci-baseline --structure-durations from validate runs%s on\n' "${kept:- (none)}"
    printf '# master that ran every structure job (%s): each job'"'"'s wall seconds. Never typed; rerun and commit.\n' "$jobs_line"
    LC_ALL=C sort -t "$(printf '\t')" -k2,2 -k1,1n "$tmp/window"
  } > "$WINDOW"
  printf 'ci-baseline: %s structure job wall time(s) from run(s)%s recorded in %s\n' \
    "$(grep -vc '^#' "$WINDOW")" "${kept:- (none)}" "${WINDOW#"$ROOT"/}"
  exit 0
fi
[ -n "$OUT" ] || OUT="$ROOT/.ai/repo/ci/baseline.json"; [ -n "$RUNS" ] || RUNS=8
if [ "$TABLE" = 1 ]; then
  [ -f "$OUT" ] || { echo "ci-baseline: no baseline at $OUT" >&2; exit 2; }
  jq -r '"recorded \(.recorded_at) from \(.repository)\(if .note != "" then " — " + .note else "" end)",
    (.runs[] | "\n\(.workflow) #\(.id) \(.event) \(.branch) \(.head_sha[0:7]) \(.conclusion) wall=\(.wall_seconds)s created=\(.created_at)",
      (.jobs[] | "  \(.name) [\(.runner)] \(.conclusion) queue=\(.queue_seconds)s run=\(.seconds)s",
        (.steps[] | "      \(.seconds)s  \(.name)")))' "$OUT"
  exit 0
fi
command -v gh >/dev/null || { echo "ci-baseline: the GitHub CLI (gh) is required" >&2; exit 12; }
[ -n "$WORKFLOWS" ] || WORKFLOWS="validate pages"
repo="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null)" || { echo "ci-baseline: gh cannot see the repository (gh auth login)" >&2; exit 12; }
tmp="$(mktemp "${TMPDIR:-/tmp}/mj-ci-baseline.XXXXXX")"; trap 'rm -f "$tmp"' EXIT
: > "$tmp"
for wf in $WORKFLOWS; do
  # completed runs only: a run in flight has no duration yet
  ids="$(gh run list --workflow "$wf" --status completed --limit "$RUNS" --json databaseId -q '.[].databaseId' 2>/dev/null || true)"
  for id in $ids; do
    gh api "repos/$repo/actions/runs/$id" > "$tmp.run" || { echo "ci-baseline: run $id is not readable" >&2; exit 12; }
    gh api --paginate "repos/$repo/actions/runs/$id/jobs?per_page=100" > "$tmp.jobs" || { echo "ci-baseline: the jobs of run $id are not readable" >&2; exit 12; }
    jq -n --slurpfile run "$tmp.run" --slurpfile jobs "$tmp.jobs" --arg wf "$wf" '
      def secs(a; b): if a == null or b == null then null else ((b | fromdateiso8601) - (a | fromdateiso8601)) end;
      ($run[0]) as $r | ([$jobs[] | .jobs[]] ) as $js
      | { workflow: $wf, id: $r.id, event: $r.event, branch: $r.head_branch, head_sha: $r.head_sha,
          conclusion: $r.conclusion, created_at: $r.created_at, run_started_at: $r.run_started_at, updated_at: $r.updated_at,
          wall_seconds: secs($r.created_at; $r.updated_at),
          jobs: [ $js[] | { name: .name, runner: (.labels | join(",")), conclusion: .conclusion,
                            queue_seconds: secs(.created_at; .started_at), seconds: secs(.started_at; .completed_at),
                            steps: [ .steps[] | select(.conclusion != "skipped") | select(.name | test("^(Set up job|Complete job|Post Run|Run actions/checkout)") | not)
                                     | { name: .name, conclusion: .conclusion, seconds: secs(.started_at; .completed_at) } ] } ] }' >> "$tmp"
  done
done
rm -f "$tmp.run" "$tmp.jobs"
[ -s "$tmp" ] || { echo "ci-baseline: no completed run found for:$WORKFLOWS" >&2; exit 12; }
mkdir -p "$(dirname "$OUT")"
jq -s --arg repo "$repo" --arg note "$NOTE" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  '{ schema: 1, repository: $repo, recorded_at: $at, note: $note, runs: (sort_by(.created_at) | reverse) }' "$tmp" > "$OUT"
printf 'ci-baseline: %s run(s) of%s recorded in %s\n' "$(jq '.runs | length' "$OUT")" "$WORKFLOWS" "${OUT#"$ROOT"/}"
