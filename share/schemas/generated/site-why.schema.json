{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://majordomus.dev/schemas/generated/site-why.schema.json",
  "title": "Site Why catalogue dataset",
  "description": "site/data/registry/why.json: the dataset the website's /why/ pages are rendered from — every moment the catalogue records, the audiences and areas it is faceted by, the signals that name a moment, and the counts and facets the listing pages are built from. Written by `majordomus generate site` from the catalogue alone, never from the index's fingerprint, so two generation passes agree byte for byte.",
  "type": "object",
  "required": ["schema", "generated", "generator", "fingerprint", "route", "counts", "facets", "audiences", "areas", "signals", "moments", "valid"],
  "properties": {
    "schema": { "const": "majordomus-site-why/v1" },
    "generated": { "type": "string", "pattern": "^GENERATED FILE" },
    "generator": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "majordomus-cli" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "route": { "type": "string", "pattern": "^/" },
    "counts": {
      "type": "object",
      "required": ["areas", "audiences", "examples", "moments", "moments_all", "signals"],
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "facets": {
      "description": "One list per dimension the listing pages filter by.",
      "type": "object",
      "required": ["areas", "audiences", "capabilities", "commands", "frequencies", "lifecycle", "severities", "tags"]
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "route", "count", "moments", "source", "status", "weight"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "pattern": "^/" },
          "count": { "type": "integer", "minimum": 0 },
          "moments": { "type": "array", "items": { "type": "string" } },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "route", "count", "moments", "source", "status", "weight"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "pattern": "^/" },
          "count": { "type": "integer", "minimum": 0 },
          "moments": { "type": "array", "items": { "type": "string" } },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    },
    "signals": {
      "description": "The sentences a reader recognises their own situation in; each names the moment it leads to.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "moment", "text"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "moment": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "moments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "route", "summary", "areas", "audiences", "signals", "source", "status", "weight"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "pattern": "^/" },
          "summary": { "type": "string", "minLength": 1 },
          "areas": { "type": "array", "items": { "type": "string" } },
          "audiences": { "type": "array", "items": { "type": "string" } },
          "signals": { "type": "array" },
          "source": { "type": "string", "minLength": 1 },
          "featured": { "type": "boolean" }
        }
      }
    },
    "valid": {
      "description": "Whether the catalogue held every invariant `majordomus why validate` checks when this was written.",
      "type": "boolean"
    }
  }
}
