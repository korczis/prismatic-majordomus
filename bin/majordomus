#!/usr/bin/env bash
# majordomus — a lightweight supervisory control layer for AI-assisted work.
# Single entry point. Subcommands live in ../lib/<name>.sh and are sourced.
set -eu

# The caller's own MJ_* environment, read before this program sets a variable of its own. A
# command majordomus runs on its caller's behalf (finish's --verify-command) runs in it, and
# not with the forty-odd MJ_* variables exported below and in lib/common.sh (I4520). Here,
# every MJ_* variable came from the environment, so their names say which were inherited.
mj_caller_env=()
for mj_name in "${!MJ_@}"; do mj_caller_env+=("$mj_name=${!mj_name}"); done
unset mj_name

MJ_BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
MJ_LIB_DIR="$MJ_BIN_DIR/../lib"
# The version is authored once, in apps/majordomus-cli/Cargo.toml. share/version.txt is its
# projection: written by `majordomus generate`, refused by `generate --check` when stale, and
# shipped beside this file in every archive, because an installed tree has no Cargo.toml.
# Read from this program's own distribution with builtins alone, and never from
# MAJORDOMUS_SHARE, which names data to read and not the identity of the program reading it.
MJ_VERSION=""
if [ -r "$MJ_BIN_DIR/../share/version.txt" ]; then
  while IFS= read -r mj_line || [ -n "$mj_line" ]; do
    case "$mj_line" in version=*) MJ_VERSION="${mj_line#version=}"; break ;; esac
  done < "$MJ_BIN_DIR/../share/version.txt"
  unset mj_line
fi
[ -n "$MJ_VERSION" ] || {
  printf 'majordomus: %s states no version; this distribution is incomplete (in a checkout: scripts/derive)\n' \
    "$MJ_BIN_DIR/../share/version.txt" >&2
  exit 12
}
# The path to write down. An installation puts the tool in a versioned directory and
# reaches it through a launcher whose path does not move when the version does, and the
# launcher says so; a checkout has no launcher and this file's own path is the answer.
MJ_SELF="${MAJORDOMUS_LAUNCHER:-$MJ_BIN_DIR/majordomus}"
export MJ_VERSION MJ_BIN_DIR MJ_LIB_DIR MJ_SELF

# The temporary root is made after the dispatch below, not as the library is sourced: a
# command handed to the other program is an exec, and an exec runs no exit trap.
# shellcheck disable=SC2034  # read by lib/common.sh as it is sourced below
MJ_TMP_ROOT_DEFER=1
# shellcheck source=../lib/common.sh
. "$MJ_LIB_DIR/common.sh"

usage() {
  cat <<USAGE
majordomus $MJ_VERSION — a lightweight supervisory control layer for AI-assisted work

usage: majordomus <command> [options]

TASK
  start <task>         begin a scoped task under a profile
  check                is the current task consistent with policy, scope, state? (read-only)
  finish               evaluate the finish contract; refuse if unmet

CONTEXT
  session              open, inspect and close one execution episode
  context              what the next worker needs to know now, within budget    (read-only)
  checkpoint           record compact progress inside the active task
  evidence             record that one obligation the task declared has been discharged
  handover             write an append-only continuation record (body on stdin)

MEMORY
  history              read the append-only ledger back                          (read-only)
  decision             record or read durable decisions
  question             open, resolve and list questions that block acceptance
  prompt               list, show and render repository-local prompt assets      (read-only)
  skills               the repository's skills: list, show and check them        (read-only)
  capture              record the person's raw prompts from a provider hook, and prove it
  search <text>        find durable records without reading all of them          (read-only)
  knowledge            the compiled index over what this repository states, and the records it derives
  adr                  the repository's architecture decisions: list, show, propose, check

RULES
  rules                the effective rule set: vendored baseline plus project rules   (read-only, except vendor update)
  usecase              the executable use cases: list, show, validate, run, coverage, impact, scaffold

PLAN
  plan                 the milestone and issue model: validate, read, and move an issue

SYSTEM
  init                 create the .ai/ layer in this repository (refuses to overwrite)
  migrate              move pre-.ai project data from .majordomus/ into .ai/ (explicit, backed up)
  recover              bring this checkout's record stores back to what the contract describes
  update               regenerate provider projections from policy
  doctor               governance only: is every declared enforcement wired here? (read-only)
  doctrine             what rules are enforced, by what, and whether they are wired (read-only)
  watch                what has drifted: state, policy, projections, retention    (read-only)
  version              print the version
  bench                time every public command, cold and warm, against the baseline
  archive              a snapshot of the tracked tree, for reading or checking elsewhere

global options:
  --repo <path>        repository to operate on (default: the git toplevel of the cwd)
  --json               machine-readable output (read-only commands)
  --help               this text, or <command> --help

exit codes: 0 ok · 2 usage · 10 contract unmet · 11 drift found · 12 missing artifact
            13 internal error · 15 refused
USAGE
}

# Two programs answer to the name `majordomus` here: this shell tool and the Rust executable
# under apps/majordomus-cli. The repository's own instructions name commands of both —
# `majordomus worktree`, `majordomus generate`, `majordomus mcp`, `majordomus serve` — so a
# command this tool does not know is more often the other program's than a typo, and a worker
# who followed those instructions gets "unknown command" and nowhere to go.
#
# Which commands are the other program's is read, never listed here: project.commands-are-
# projections forbids a surface keeping a catalogue of its own. A checkout reads
# docs/generated/cli.yaml, the tracked projection of the clap declaration, because asking the
# executable there could mean building it to answer a typo. An installed tree ships no docs/
# but ships the executable prebuilt as libexec/majordomus-cli, and asks it: `help <command>`
# exits 0 for a command it has and 2 for one it has not, and builds nothing. Both a source
# and the launcher are required before anything is claimed.
#
# A command that is the other program's is run, not described. The provider bootstraps every
# adopting repository is generated from name `majordomus worktree create <branch>`; an
# installed tool used to answer "unknown command: worktree" — with no docs/ beside it, it could
# not even say where the command was — so an instruction the tool itself wrote could not be
# followed. Arguments, global options included, are passed through unchanged, and the
# executable's own usage errors and exit codes are its answer.
mj_rust_command() {
  local doc="$MJ_BIN_DIR/../docs/generated/cli.yaml" shipped="$MJ_BIN_DIR/../libexec/majordomus-cli"
  [ -x "$MJ_BIN_DIR/majordomus-cli" ] || return 1
  case "$1" in ''|-*|help) return 1 ;; esac
  # asked about a subcommand: `mj_rust_command evidence record`
  if [ $# -ge 2 ]; then
    case "$2" in ''|-*|help) return 1 ;; esac
    if [ ! -f "$doc" ]; then
      [ -x "$shipped" ] || return 1
      "$shipped" help "$1" "$2" >/dev/null 2>&1
      return
    fi
    # a here-string and one awk, never `| grep -q`: a reader that leaves at the first match
    # closes the pipe on the writer behind it
    awk -F '\t' -v want="$2" '$1 == want { found = 1 } END { if (found) exit 0; exit 1 }' \
      <<<"$(mj_rust_subcommands "$1")"
    return
  fi
  if [ ! -f "$doc" ]; then
    [ -x "$shipped" ] || return 1
    "$shipped" help "$1" >/dev/null 2>&1
    return
  fi
  # The executable's top-level commands are the `path` of each item of the `subcommands:`
  # list directly under `cli:` — two elements, the program and the command. A nested
  # subcommand's path has three and its list is indented further, so indentation is what
  # tells `majordomus web` from `majordomus web list`.
  awk -v want="$1" '
    /^  subcommands:$/ { top = 1; next }
    top && /^    - path:$/ { n = 0; inpath = 1; next }
    inpath && /^        - / {
      n += 1
      if (n == 2) { name = $0; sub(/^ *- */, "", name); if (name == want) { found = 1; exit } }
      next
    }
    { inpath = 0 }
    END { if (found) exit 0; exit 1 }
  ' "$doc"
}

# mj_rust_subcommands <command>
#
# The subcommands the executable has under one of its commands, as "<word><TAB><what it
# does>", one per line and in the executable's own order. Read from the same two sources as
# above and for the same reasons: the tracked projection of the clap declaration in a
# checkout, the shipped executable's own `help <command>` in an installed tree. Nothing when
# neither is there. `help` is clap's and is never listed.
#
# Two readers share it, so that neither keeps a list: the dispatch below asks whether a word
# is one of them, and `majordomus evidence --help` prints them beside its own options.
mj_rust_subcommands() {
  local doc="$MJ_BIN_DIR/../docs/generated/cli.yaml" shipped="$MJ_BIN_DIR/../libexec/majordomus-cli"
  if [ -f "$doc" ]; then
    # A top-level item opens with `    - path:` and its elements sit eight columns in; the
    # subcommands directly under it open with `        - path:`, their elements twelve
    # columns in and their `about:` ten. A subcommand of a subcommand is indented further
    # again and matches none of these.
    awk -v want="$1" '
      /^    - path:$/ { intop = 1; n = 0; mine = 0; insub = 0; next }
      intop && /^        - / {
        n += 1
        if (n == 2) { v = $0; sub(/^ *- */, "", v); mine = (v == want) }
        next
      }
      { intop = 0 }
      !mine { next }
      /^        - path:$/ { insub = 1; m = 0; name = ""; next }
      insub && /^            - / {
        m += 1
        if (m == 3) { name = $0; sub(/^ *- */, "", name) }
        next
      }
      { insub = 0 }
      /^          about: / && name != "" {
        about = $0; sub(/^ *about: */, "", about)
        if (about ~ /^".*"$/) { about = substr(about, 2, length(about) - 2); gsub(/\\"/, "\"", about) }
        printf "%s\t%s\n", name, about
        name = ""
      }
    ' "$doc"
    return 0
  fi
  [ -x "$shipped" ] || return 0
  # clap prints them as a block: `Commands:`, one indented line each, a blank line after.
  # Read from a process substitution, not a pipe: the launcher runs under set -e without
  # pipefail (setting it here would change every library it sources), and pipefail-check
  # refuses a pipe that could hide its producer's failure.
  awk '
    /^Commands:$/ { on = 1; next }
    on && !/^  [a-z]/ { on = 0 }
    on {
      name = $1; if (name == "help") next
      about = $0; sub(/^ *[^ ]+ */, "", about)
      printf "%s\t%s\n", name, about
    }
  ' < <("$shipped" help "$1" 2>/dev/null) || true
  return 0
}

# mj_words_are_the_executables <shell-command>
#
# Is this one of the shell commands that takes no word of its own? Every argument such a
# command understands is an option, so a word in the first position cannot be meant for it:
# it is a subcommand the other program has under the same name, or it is a mistake. For a
# command that takes words (`plan start`, `adr next`) both programs may answer the same
# word, and which one a person means is not a question a launcher can settle, so those are
# never handed over.
#
# `evidence` is the one. The shell tool records what a task owes (`--covers`, `--gate`);
# the executable holds the ledger of what ran (`show`, `record`, `stamp`, ...). The pages
# name `majordomus evidence record`, and a person with an installed tool has only
# `majordomus` on PATH: the launcher used to hand the word to the option parser, which
# answered `evidence: unknown option record`. Which words are the executable's is still
# read, never listed (mj_rust_subcommands).
mj_words_are_the_executables() {
  case "$1" in evidence) return 0 ;; esac
  return 1
}

# mj_first_word <arguments after the command>
#
# The first argument that is not one of this tool's global options, into MJ_FIRST_WORD:
# `majordomus evidence --repo <path> show` names the same subcommand as
# `majordomus --repo <path> evidence show`. Set, not printed, so that the launcher spends no
# subshell on it.
MJ_FIRST_WORD=""
mj_first_word() {
  MJ_FIRST_WORD=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) shift; if [ $# -gt 0 ]; then shift; fi ;;
      --repo=*|--json) shift ;;
      *) MJ_FIRST_WORD="$1"; return 0 ;;
    esac
  done
  return 0
}

# global options may precede the command
pre=()
while [ $# -gt 0 ]; do
  case "$1" in
    --repo|--repo=*|--json) if [ "$1" = --repo ]; then pre+=("$1" "${2:-}"); shift 2; else pre+=("$1"); shift; fi ;;
    *) break ;;
  esac
done
[ $# -ge 1 ] || { usage; exit "$MJ_EX_USAGE"; }
cmd="$1"; shift
# arguments that followed the command, before the global options are merged back in
nargs=$#
mj_first_word "$@"
set -- "${pre[@]+"${pre[@]}"}" "$@"
case "$cmd" in
  -h|--help|help) usage; exit 0 ;;
  version|--version)
    # every other command refuses an argument it does not know rather than ignoring it;
    # version is dispatched before the option parser and has to say so for itself
    [ "$nargs" -eq 0 ] || { mj_err "version: unknown option $1"; exit "$MJ_EX_USAGE"; }
    echo "majordomus $MJ_VERSION"; exit 0 ;;
  init|doctor|start|check|watch|update|handover|finish|doctrine|context|checkpoint|history|decision|question|prompt|skills|capture|search|plan|session|knowledge|migrate|recover|rules|bench|usecase|adr|evidence|archive)
    # a word this command does not take, which the other program has under the same name:
    # that program's, arguments unchanged, as for a command that is wholly its own
    if mj_words_are_the_executables "$cmd" && [ -n "$MJ_FIRST_WORD" ] \
      && mj_rust_command "$cmd" "$MJ_FIRST_WORD"; then
      exec "$MJ_BIN_DIR/majordomus-cli" "$cmd" "$@"
    fi
    mj_parse_global_opts "$@"
    # after the dispatch and not before it: a command handed to the other program is an
    # exec, and an exec runs no exit trap to remove the root
    mj_tmp_root_init
    # shellcheck disable=SC1090
    . "$MJ_LIB_DIR/$cmd.sh"
    "mj_cmd_$cmd" "${MJ_ARGS[@]+"${MJ_ARGS[@]}"}"
    ;;
  *)
    # the other program's command: run it through the launcher, which finds the shipped
    # executable in an installed tree and builds it in a checkout when it must
    if mj_rust_command "$cmd"; then exec "$MJ_BIN_DIR/majordomus-cli" "$cmd" "$@"; fi
    mj_err "unknown command: $cmd"
    usage >&2; exit "$MJ_EX_USAGE" ;;
esac
