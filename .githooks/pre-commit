#!/bin/sh
# install once: git config core.hooksPath .githooks
# A hook never starts a build of the executable (I3831, ADR 0224): when it is missing or stale,
# bin/majordomus-cli answers through the installed release of this tree's generation, or
# refuses with exit 12 naming `just build`, and so does this hook.
# majordomus-on-stale-executable: fallback, else refuse
MAJORDOMUS_HOOK=1; export MAJORDOMUS_HOOK
# A local gate reports and CI decides (I3830, rule project.a-push-runs-what-ci-would-find-first
# v2): a check CI runs again prints its finding and lets the commit through, because CI holds
# the verdict and a loaded machine must not refuse a commit for the load. What CI cannot see
# again, or sees only after the deploy it breaks, still refuses with `|| exit $?`.
report() {
  mj_what="$1"; shift
  "$@" && return 0
  mj_rc=$?
  printf 'pre-commit: %s failed (exit %s); reported, not refused: CI holds the verdict\n' \
    "$mj_what" "$mj_rc" >&2
}
# Doctor is told it runs in the commit hook, and leaves out the one reading that costs a
# `git status` per linked worktree (`majordomus worktree uncommitted`), saying so in a line.
# Reported: CI's core-check runs doctor again and refuses there.
report doctor env MAJORDOMUS_DOCTOR_CONTEXT=commit bin/majordomus doctor
# A feature branch is committed from its canonical worktree (<repo>-wt/<branch>) and the
# trunk from the primary checkout; the guard decides, this line only asks. The logic lives
# in the Rust executable's worktree service, which the launcher finds and never builds.
# Refused: CI checks out a fresh clone and never sees which worktree a commit came from.
bin/majordomus-cli worktree guard --quiet || exit $?
# The derived data is a projection of the tree it was generated from, and a commit that moves
# a canonical input without regenerating publishes nothing and breaks the deploy for whoever
# lands next. `pages current` compares the recorded input hash with this tree's in a fifth of
# a second, which is why it can run here rather than only in CI.
scripts/pages current || exit $?

# Keep the owner-authorized SSH permissions in every native client configuration.
scripts/ci/providers-check --permissions-only || exit $?
