#!/usr/bin/env bash
# backlog-check — the gate of project.accumulation-is-measured: the things that grow on
# their own are measured by committed commands, and nothing tells a contributor to wait on
# a merge button this repository cannot reach.
#
# A CI runner has no worktrees, no abandoned servers and no backlog of its own, so the
# quantities themselves are not what this gate measures. What it can hold together is that
# every accumulating quantity still has its command, that the reaper is safe by
# construction, that the merge policy's two halves agree, and that no document advertises
# the one path that provably cannot work here.
#
#   - `scripts/reap-orphans` exists, is executable, and matches processes by predicate —
#     a `pkill`/`killall` by name would kill the servers live peers are attached to
#   - the same reaper still deletes only build directories, still holds all three conditions
#     for reclaiming one, and still refuses when liveness cannot be measured
#   - every path that starts a build asks the one shared free-space check before it does
#   - `.gitattributes` declares `merge=derived` and the driver it names is committed and
#     executable, and a recipe installs it (the declaration and its installer are one
#     relation; checking only one side is how this class of defect survives)
#   - the rule exists and names the forge constraint, so the reason is written down once
#   - no document instructs a reader to merge a pull request on GitHub
#   - the behavioural case exists
#   - the ratchet in .ai/repo/backlog-baseline.txt has never been raised
#
# The rule's eighth clause — "growth is loud before it is a cliff" — is the quantity itself,
# and until 2026-09-16 nothing ever measured it: this gate could, under `--remote`, and
# .ai/repo/ci/gates.yaml wired it without that flag, so every CI run reported only that the
# instruments existed. The day it was wired there were 67 open pull requests, 59 of them
# landable, against a declared threshold of 10. Failing on the threshold that day would have
# turned master red for every session in this repository over a backlog none of them
# created, so the number is held by a ratchet — the shape .ai/repo/order-baseline.txt
# already uses for the ordering debt: a recorded count that may fall and may never rise.
# The threshold stays the target; the ratchet is recorded debt above it, written down with
# its date and the sentence that says it is debt.
#
#   scripts/ci/backlog-check                   the structural findings and the ratchet's history
#   scripts/ci/backlog-check --remote          also measure the landable backlog (needs gh + a token)
#   scripts/ci/backlog-check --write-baseline  record today's measurement as the ratchet (implies --remote)
#   MJ_BACKLOG_MAX=8 ... --remote              the threshold (default 10)
#
# Exit: 0 clean, 10 findings, 12 unusable.
set -eu
set -o pipefail
ROOT="${MJ_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
cd "$ROOT"

REMOTE=0
WRITE=0
MAX="${MJ_BACKLOG_MAX:-10}"
while [ $# -gt 0 ]; do case "$1" in
  --remote) REMOTE=1; shift ;;
  --write-baseline) WRITE=1; REMOTE=1; shift ;;
  *) echo "backlog-check: unknown option $1" >&2; exit 2 ;;
esac; done

findings=0
fail() { printf 'FAIL backlog-check  %s\n' "$*"; findings=$((findings+1)); }
ok()   { printf 'OK   backlog-check  %s\n' "$*"; }

RULE=".ai/repo/rules/project/accumulation-is-measured.v2.md"
BASELINE=".ai/repo/backlog-baseline.txt"
REAPER="scripts/reap-orphans"
CASE="test/cases/131_backlog_hygiene.sh"
DISK_CASE="test/cases/276_disk_is_bounded.sh"
SPACE_LIB="lib/rust_bin.sh"

# 1. the reaper exists and is safe by construction
if [ ! -f "$REAPER" ]; then
  fail "$REAPER is missing: abandoned servers have no measuring command"
elif [ ! -x "$REAPER" ]; then
  fail "$REAPER is not executable"
else
  ok "the reaper is committed and executable"
  if grep -nE '^[^#]*\b(pkill|killall)\b' "$REAPER" >/dev/null 2>&1; then
    fail "$REAPER matches processes by name (pkill/killall): it would end the servers live peers are attached to"
  else
    ok "the reaper matches by predicate, not by name"
  fi
  for predicate in 'ESTABLISHED' 'ppid' 'MIN_AGE'; do
    grep -q "$predicate" "$REAPER" || fail "$REAPER no longer tests '$predicate': its safety rests on all three"
  done
fi

# 1b. the fifth quantity: the reaper reclaims build output, and only build output.
# The conditions are read out of the script rather than exercised here — a CI runner has no
# worktrees to classify — but their absence is exactly what would turn this reaper into a
# worktree reaper, which is the one thing it must never become (ADR 0055).
if [ -x "$REAPER" ]; then
  # it removes target directories and nothing else. Every `rm -rf` in it must be over the
  # build directory it resolved; a removal of "$wt" would be a worktree reaper.
  removals="$(grep -nE '^[^#]*rm -rf' "$REAPER" | grep -vE 'rm -rf "\$target"|rm -f ' || true)"
  if [ -n "$removals" ]; then
    fail "$REAPER removes something other than a resolved build directory:"
    echo "$removals" | head -5 | sed 's/^/       /'
  else
    ok "the reaper removes build directories and never a worktree"
  fi
  for predicate in 'merge-base --is-ancestor' 'ps -Ao command=' '\-d cwd' 'status --porcelain'; do
    grep -qE "$predicate" "$REAPER" \
      || fail "$REAPER no longer tests '$predicate': merged, not live and idle are all three required"
  done
  grep -q 'no-optional-locks' "$REAPER" \
    || fail "$REAPER reads a worktree's status without --no-optional-locks: a status sweep that refreshes an index fakes liveness for every tree it touches"
  grep -q 'nothing is reclaimed' "$REAPER" \
    || fail "$REAPER no longer refuses when its inputs cannot be read: a sweep that cannot tell the living from the dead must reclaim nothing (project.destructive-sweeps-fail-closed)"
  grep -q 'CACHEDIR_SIG\|is_cargo_target' "$REAPER" \
    || fail "$REAPER no longer proves that what it removes is a cargo build directory"
  [ -f "$DISK_CASE" ] && ok "the disk behavioural case is present" || fail "$DISK_CASE is missing"
fi

# 1c. the bound: every path that starts a build asks the one shared check first.
# Discovered, not listed: a hand-kept list of build sites falls behind the first time one is
# added, which is how a one-sided relation survives here (docs/DYNAMICITY.md).
if [ ! -f "$SPACE_LIB" ]; then
  fail "$SPACE_LIB is missing: the free-space floor has no home"
elif ! grep -q 'mj_rust_space_check' "$SPACE_LIB"; then
  fail "$SPACE_LIB no longer defines mj_rust_space_check: a build has no bound on the disk it may consume"
else
  ok "the free-space floor is defined once, in $SPACE_LIB"
  # the number carries its measurement, not just a value (the doctor_ms defect)
  grep -qE 'MJ_MIN_FREE_MB_DEFAULT=[0-9]+' "$SPACE_LIB" \
    || fail "$SPACE_LIB states no floor"
  grep -qiE 'measured|KiB|GiB' "$SPACE_LIB" \
    || fail "$SPACE_LIB states a floor with no measurement written beside it"
  unbounded=""
  for f in bin/majordomus-cli scripts/derive; do
    [ -f "$f" ] || continue
    grep -qE '^[^#]*cargo build' "$f" || continue
    grep -q 'mj_rust_space_check' "$f" || unbounded="$unbounded $f"
  done
  if [ -f .just/build.just ] && ! grep -q 'mj_rust_space_check' .just/build.just; then
    unbounded="$unbounded .just/build.just"
  fi
  if [ -n "$unbounded" ]; then
    fail "these start a build without asking whether there is room for it:$unbounded"
  else
    ok "every path that starts a build is bounded on free space first"
  fi
fi

# 2. the merge policy's two halves agree — the declaration and its installer
drivers="$(sed -n 's/.*merge=\([A-Za-z0-9_-]*\).*/\1/p' .gitattributes 2>/dev/null | sort -u)"
if [ -z "$drivers" ]; then
  ok "no custom merge driver is declared"
else
  for d in $drivers; do
    script="scripts/merge-$d"
    if [ ! -x "$script" ]; then
      fail ".gitattributes declares merge=$d but $script is missing or not executable"
    else
      ok "merge=$d resolves to $script"
    fi
    if grep -rq "merge\.$d\.driver" .just/ justfile 2>/dev/null; then
      ok "a recipe installs merge.$d.driver (it cannot be committed; every clone must declare it)"
    else
      fail "nothing installs merge.$d.driver: .gitattributes names a driver no clone is told to configure"
    fi
  done
fi

# 2b. every section the site generator rewrites is resolved on merge.
# The generator deletes and regenerates whole trees under site/content; a tree it rewrites
# but .gitattributes does not declare conflicts on every integration, over content no branch
# owns. Thirteen of fourteen were undeclared when this was first measured. The list is read
# out of the generator, never kept by hand here — a hand list falls behind the first time a
# section is added, which is exactly how the omission survived.
GEN='scripts/generate-site-data'
if [ -f "$GEN" ]; then
  missing=""
  for d in $(grep -oE '\$CONTENT_ROOT/[a-z-]+' "$GEN" | sed 's#\$CONTENT_ROOT/##' | LC_ALL=C sort -u); do
    [ -d "site/content/$d" ] || continue
    attr="$(git check-attr merge -- "site/content/$d/probe.md" 2>/dev/null | sed 's/.*merge: //')"
    [ "$attr" = "derived" ] || missing="$missing $d"
  done
  if [ -n "$missing" ]; then
    fail "$GEN rewrites these site/content trees but .gitattributes does not resolve them on merge:$missing"
  else
    ok "every site/content tree the generator rewrites is declared merge=derived"
  fi
fi

# 3. the reason is written down once
if [ ! -f "$RULE" ]; then
  fail "$RULE is missing: the constraint that makes landing local is not stated anywhere"
else
  ok "the rule is present"
  grep -qi 'merge button' "$RULE" || fail "$RULE does not name the forge constraint it exists to explain"
fi

# 4. no document advertises the path that cannot work
advertises="$(grep -rniE '(click|press|use|hit)[^.]{0,40}merge (button|pull request)' \
  --include='*.md' docs .ai README.md AGENTS.md CLAUDE.md 2>/dev/null \
  | grep -v "$RULE" | grep -vi 'never\|cannot\|not available\|structurally' || true)"
if [ -n "$advertises" ]; then
  fail "a document instructs a reader to merge on the forge, which this repository's merge policy cannot reach:"
  echo "$advertises" | head -5 | sed 's/^/       /'
else
  ok "no document advertises the forge merge button"
fi

# 5b. the suite's own servers have a bounded life.
# `scripts/ci/entry-converges` already holds this for the server `ensure` starts, and that
# is the path a person takes. It is not the path that leaked: every server this repository
# abandoned was spawned by a case, in the background, with the raw `serve` whose --idle
# defaults to 0 — run until stopped. A case that is interrupted before its trap fires leaves
# that server holding its port until the machine restarts. So the same contract is held here
# for the half that gate cannot see.
unbounded=""
while IFS=: read -r f l rest; do
  [ -n "$f" ] || continue
  case "$rest" in *--idle*) continue ;; esac
  unbounded="$unbounded$f:$l "
done <<EOF
$(grep -rnE '(serve|mcp)([[:space:]]|$)' test/cases/ --include='*.sh' 2>/dev/null | grep -E '&[[:space:]]*$|nohup' | grep -vE '^[^:]*:[0-9]*:[[:space:]]*#' || true)
EOF
if [ -n "$unbounded" ]; then
  fail "a case backgrounds a server without --idle; interrupted, it outlives the run and holds its port:"
  for site in $unbounded; do echo "       $site"; done
else
  ok "every server the suite backgrounds is given a bounded idle life"
fi

# 5. the behavioural case exists
[ -f "$CASE" ] && ok "the behavioural case is present" || fail "$CASE is missing"

# 5c. the ratchet is paid, never moved.
# Read with no network and no token, so the one half of clause 8 that can always be held is
# always held: whatever the forge says today, the recorded debt may not have grown. The file
# is its own history — every entry is `<date> <count> <sentence>` — so a raise is visible in
# the file itself rather than in a diff nobody reads.
RATCHET=""
if [ ! -f "$BASELINE" ]; then
  fail "$BASELINE is missing: the landable backlog has no recorded ratchet (scripts/ci/backlog-check --write-baseline)"
else
  malformed="$(grep -vE '^[[:space:]]*(#|$)' "$BASELINE" | grep -vE '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]+ .+$' || true)"
  if [ -n "$malformed" ]; then
    fail "$BASELINE carries entries that are not '<date> <count> <sentence>':"
    echo "$malformed" | head -3 | sed 's/^/       /'
  else
    read -r RATCHET floor entries <<EOF
$(grep -E '^[0-9]{4}-' "$BASELINE" | awk '
  NR > 1 { if (prevmin == "" || prev < prevmin) prevmin = prev }
  { prev = $2; last = $2 }
  END { if (NR == 0) exit
        if (prevmin == "") prevmin = last
        print last, prevmin, NR }')
EOF
    if [ -z "$RATCHET" ]; then
      fail "$BASELINE records no measurement: the ratchet is a number, a date and the sentence that says it is debt"
    elif [ "$RATCHET" -gt "$floor" ]; then
      fail "the ratchet in $BASELINE was raised from $floor to $RATCHET: debt is paid, not moved — land pull requests, do not record more of them"
    else
      ok "the landable backlog ratchet is $RATCHET over $entries recorded measurement(s), never raised"
      if [ "$RATCHET" -gt "$MAX" ]; then
        ok "the ratchet is $((RATCHET - MAX)) above the declared threshold of $MAX: that difference is debt, and the threshold is still the target"
      fi
    fi
  fi
fi

# 6. the quantity itself, when asked and able
if [ "$REMOTE" -eq 1 ]; then
  if ! command -v gh >/dev/null 2>&1; then
    fail "--remote was asked for but gh is not installed: the backlog cannot be measured, and a gate that skips quietly is the disease"
  elif ! gh auth status >/dev/null 2>&1; then
    fail "--remote was asked for but gh has no token: the backlog cannot be measured"
  elif ! git rev-parse --verify --quiet origin/master >/dev/null \
    && ! git rev-parse --verify --quiet HEAD >/dev/null; then
    fail "--remote was asked for but neither origin/master nor HEAD resolves here: the backlog has no base to be measured against"
  else
    # --verify, because a bare `git rev-parse origin/master` echoes its own argument when
    # the ref is unknown and still writes a line: the base then held two lines, every
    # merge-tree failed against it, and the gate reported a landable backlog of zero — a
    # false green built out of an unreadable input.
    base="$(git rev-parse --verify --quiet origin/master || git rev-parse --verify --quiet HEAD || true)"
    # One listing and one fetch. Every open pull request used to cost a `gh pr view` and a
    # fetch of its own, which at this repository's backlog is minutes of a CI job;
    # `refs/pull/<n>/head` is the head GitHub itself would merge and needs no branch name.
    prs="$(gh pr list --state open --limit 100 --json number -q '.[].number' 2>/dev/null || true)"
    total=0; landable=0; refspecs=""
    for pr in $prs; do
      total=$((total+1))
      refspecs="$refspecs +refs/pull/$pr/head:refs/mj-backlog/$pr"
    done
    # shellcheck disable=SC2086
    [ -n "$refspecs" ] && git fetch --quiet --prune origin $refspecs 2>/dev/null || true
    for pr in $prs; do
      head="$(git rev-parse --verify --quiet "refs/mj-backlog/$pr" || true)"
      [ -n "$head" ] || continue
      # The exit code, never a grep (see scripts/land).
      if git merge-tree --write-tree "$base" "$head" >/dev/null 2>&1; then
        landable=$((landable+1))
      fi
    done
    # A gate for the things that accumulate does not leave a ref per pull request behind it.
    git for-each-ref --format='%(refname)' refs/mj-backlog 2>/dev/null \
      | while IFS= read -r r; do git update-ref -d "$r" 2>/dev/null || true; done
    if [ "$WRITE" -eq 1 ]; then
      if [ -n "$RATCHET" ] && [ "$landable" -gt "$RATCHET" ]; then
        echo "backlog-check: refusing to record $landable above the ratchet of $RATCHET — land pull requests instead" >&2
        exit 12
      fi
      if [ ! -f "$BASELINE" ]; then
        {
          echo "# The landable backlog of this repository, as a ratchet: the recorded debt of"
          echo "# project.accumulation-is-measured@2 clause 8. Written by"
          echo "# \`scripts/ci/backlog-check --write-baseline\`; the gate refuses a backlog above the"
          echo "# newest entry, and refuses an entry above any number already recorded here."
          echo "#"
          echo "# The threshold is MJ_BACKLOG_MAX (10) and it does not move. Everything above it in"
          echo "# this file is debt that was already there when the quantity was first measured in"
          echo "# CI, carried so that paying it down is a series of commits rather than a red trunk."
          echo "#"
          echo "# One entry per measurement: <date> <landable count> <one sentence>."
        } > "$BASELINE"
      fi
      printf '%s %s debt: %s of %s open pull requests merge cleanly here and are unlanded, against a declared threshold of %s.\n' \
        "$(date -u +%Y-%m-%d)" "$landable" "$landable" "$total" "$MAX" >> "$BASELINE"
      echo "backlog-check: ratchet recorded — landable=$landable of $total open, threshold $MAX"
      exit 0
    fi
    # The ratchet is the bound that is enforced; the threshold is the bound that is meant.
    bound="$MAX"
    if [ -n "$RATCHET" ] && [ "$RATCHET" -gt "$MAX" ]; then bound="$RATCHET"; fi
    if [ "$landable" -gt "$bound" ]; then
      fail "$landable of $total open pull requests merge cleanly here and are still open, above the ratchet of $bound (threshold $MAX): run scripts/land"
    elif [ "$landable" -gt "$MAX" ]; then
      ok "$landable of $total open pull requests are landable — above the threshold of $MAX, within the recorded ratchet of $bound"
    else
      ok "$landable of $total open pull requests are landable, within the threshold of $MAX"
    fi
  fi
fi

echo
if [ "$findings" -eq 0 ]; then
  echo "backlog-check: clean"
  exit 0
fi
echo "backlog-check: $findings finding(s)"
exit 10
