#!/usr/bin/env bash
# collision-check — is anybody else already building this?
#
# Eight sessions worked in this repository on 2026-09-09 and two of them built a release
# subsystem, independently, for several hours. Both had done the right thing by the
# protocol that existed: both called `majordomus_announce`, and neither announcement was
# there when the other started. That protocol cannot work, because a peer board is a
# process's memory — it says who is working *now*, and says nothing about the branch
# somebody pushed an hour before this process started.
#
# The signal was there the whole time and nothing looked at it. `origin/int/land-all`
# carried `apps/majordomus-cli/src/release/` before either session began. A branch is
# durable, it survives every session, and `git` already knows the answer.
#
# So: before implementing, ask this what else touches the paths you are about to touch.
#
#   scripts/collision-check apps/majordomus-cli/src/release
#   scripts/collision-check --new apps/majordomus-cli/src/release docs/RELEASE.md
#   scripts/collision-check --since origin/master src/foo
#
#   --new     report only paths that do not exist on the merge base: a *new* module two
#             branches are both inventing is the expensive collision, and the one this
#             exists for. An edit to a shared file is ordinary and is resolved by merging.
#   --since   the ref branches are compared against; origin/master by default.
#
# Exit: 0 nothing else claims these paths · 11 something does (drift, the repository's own
# code for "what you believe and what is true differ") · 2 usage.
set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

base="origin/master"
only_new=0
paths=()
while [ $# -gt 0 ]; do
  case "$1" in
    --new) only_new=1; shift ;;
    --since) base="${2:-}"; shift 2 ;;
    -h|--help) sed -n '2,26p' "$0"; exit 0 ;;
    -*) printf 'collision-check: unknown option: %s\n' "$1" >&2; exit 2 ;;
    *) paths+=("$1"); shift ;;
  esac
done
[ "${#paths[@]}" -gt 0 ] || { printf 'collision-check: name at least one path\n' >&2; exit 2; }

git rev-parse --verify -q "$base" >/dev/null 2>&1 || {
  printf 'collision-check: `%s` does not resolve; fetch first\n' "$base" >&2
  exit 2
}

here="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)"

# Every branch that is not this one and is not the base, local and remote. A branch merged
# long ago still lists here and that is correct: its files are on the base, so the loop
# below finds no unique claim and says nothing.
branches="$(git for-each-ref --format='%(refname:short)' refs/heads refs/remotes/origin \
  | grep -v -x -e "$here" -e "$base" -e 'origin/HEAD' | LC_ALL=C sort -u)"

found=0
for path in "${paths[@]}"; do
  # `--new` narrows to what the base does not have. A module two branches are both
  # inventing has no merge resolution: one of them is thrown away, and that is the loss
  # worth an interruption.
  if [ "$only_new" = 1 ] && git cat-file -e "$base:$path" 2>/dev/null; then
    continue
  fi
  claimants=""
  for ref in $branches; do
    # does the branch carry this path at all, and does it carry it differently from the base?
    git cat-file -e "$ref:$path" 2>/dev/null || continue
    if [ "$(git rev-parse "$ref:$path" 2>/dev/null)" = "$(git rev-parse "$base:$path" 2>/dev/null)" ]; then
      continue
    fi
    claimants="$claimants $ref"
  done
  [ -n "$claimants" ] || continue
  found=1
  printf 'collision-check: %s is claimed by:\n' "$path"
  for ref in $claimants; do
    when="$(git log -1 --format='%cr' "$ref" -- "$path" 2>/dev/null || echo 'unknown')"
    subject="$(git log -1 --format='%s' "$ref" -- "$path" 2>/dev/null || true)"
    printf '  %-52s %-14s %s\n' "$ref" "$when" "${subject:0:60}"
  done
done

if [ "$found" = 0 ]; then
  printf 'collision-check: OK   nothing else claims '
  printf '%s ' "${paths[@]}"
  printf '\n'
  exit 0
fi

cat >&2 <<'WHY'

Another branch is already there. Before implementing, read what it does: two designs
arriving at one path is not a merge conflict, it is a choice somebody has to make between
two pieces of finished work, and the one that loses was written for nothing.

`majordomus_announce` says who is working now; this says what was already pushed. Ask both.
WHY
exit 11
