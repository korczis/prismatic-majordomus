<script>
(function () {
  document.querySelectorAll('.code button').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var pre = btn.parentElement.querySelector('pre');
      var text = pre ? pre.innerText : '';
      var done = function () { btn.textContent = 'Zkopírováno'; setTimeout(function () { btn.textContent = 'Kopírovat'; }, 1600); };
      var fallback = function () {
        var r = document.createRange(); r.selectNodeContents(pre);
        var s = window.getSelection(); s.removeAllRanges(); s.addRange(r);
        btn.textContent = 'Označeno';
      };
      try { navigator.clipboard.writeText(text).then(done, fallback); } catch (e) { fallback(); }
    });
  });

  var toc = document.getElementById('toc');
  var wide = window.matchMedia('(min-width: 1000px)');
  function syncToc() { if (toc) toc.open = wide.matches; }
  syncToc();
  if (wide.addEventListener) wide.addEventListener('change', syncToc);
  if (toc) toc.addEventListener('click', function (e) {
    var a = e.target.closest('a');
    if (a && !wide.matches) toc.open = false;
  });

  var input = document.getElementById('gloss-filter');
  var rows = Array.prototype.slice.call(document.querySelectorAll('#gloss > div'));
  var empty = document.getElementById('gloss-empty');
  if (input) input.addEventListener('input', function () {
    var q = input.value.trim().toLowerCase();
    var shown = 0;
    rows.forEach(function (row) {
      var hit = !q || row.textContent.toLowerCase().indexOf(q) !== -1;
      row.hidden = !hit;
      if (hit) shown++;
    });
    if (empty) empty.hidden = shown !== 0;
  });

  if ('IntersectionObserver' in window) {
    var links = {};
    document.querySelectorAll('nav.rail ol a').forEach(function (a) { links[a.getAttribute('href').split('#').pop()] = a; });
    var current = null;
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        var link = links[entry.target.id];
        if (!link) return;
        if (current) current.removeAttribute('aria-current');
        link.setAttribute('aria-current', 'true');
        current = link;
        if (wide.matches && link.scrollIntoView) {
          var rail = document.querySelector('nav.rail');
          var r = link.getBoundingClientRect(), b = rail.getBoundingClientRect();
          if (r.top < b.top + 40 || r.bottom > b.bottom - 40) rail.scrollTop += r.top - b.top - b.height / 3;
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    document.querySelectorAll('main section[id]').forEach(function (s) { observer.observe(s); });
  }
})();
</script>
