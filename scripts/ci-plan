#!/usr/bin/env bash
# ci-plan — which gates a change must run, from the CI model in .ai/repo/ci/gates.yaml.
#
#   scripts/ci-plan                         the working tree against the default branch:
#                                           the commits since the merge base plus the
#                                           uncommitted changes
#   scripts/ci-plan --base A --head B       the paths that differ between two revisions
#   scripts/ci-plan --files LIST            the paths listed in LIST (`-` for stdin), one per
#                                           line; this is how the tests drive it
#   scripts/ci-plan --full [why]            every gate but the on-demand ones, with the reason
#                                           recorded
#   --on-demand                             also plan the gates the model marks `on-demand`:
#                                           the ones whose runner this repository cannot get
#                                           on demand (the macOS jobs). The schedule, a
#                                           dispatch and a pull request labelled ci:full pass
#                                           it; a routine push does not, because three macOS
#                                           jobs per push is demand no runner pool answers and
#                                           the verdict that needs them then never arrives
#   --format json|text|github               json (default): the plan; text: one line per gate;
#                                           github: name=value lines for $GITHUB_OUTPUT
#   --model FILE                            another model (the tests mutate a copy)
#   --attr-root DIR                         the checkout whose .gitattributes says which paths
#                                           are derived, for the model's shapes (default: this
#                                           one); the tests point it at a fixture
#   --check                                 validate the model and exit: 0 sound, 10 not
#   --inventory                             find a second list of gates: a tracked file outside the
#                                           model that runs the `runs:` commands of two or more
#                                           gates, or names three or more gate ids on one line.
#                                           One line per finding (file:line and the gates); a
#                                           finding the baseline does not hold, or a baseline
#                                           entry that matches nothing (STALE), exits 10
#   --baseline FILE                         the findings an inventory accepts, one file:what per
#                                           line (default .ai/repo/ci/gate-list-baseline.txt)
#   --tree DIR                              the checkout an inventory reads (default: this one);
#                                           the tests point it at a fixture
#
# The plan is deterministic for a given model and path list, and the same command runs
# here and in the workflow. Exit 0 with a plan, 2 on usage, 10 on a model that does not
# resolve, 12 when git cannot answer. An inventory exits 0 clean, 10 on a finding or a
# stale baseline entry, 12 when it cannot read the tree or the baseline.
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MJ_VERSION="ci-plan"; MJ_BIN_DIR="$ROOT/bin"; MJ_LIB_DIR="$ROOT/lib"; export MJ_VERSION MJ_BIN_DIR MJ_LIB_DIR
# shellcheck source=../lib/common.sh
. "$ROOT/lib/common.sh"
command -v jq >/dev/null || { echo "ci-plan: jq is required" >&2; exit 12; }

MODEL="$ROOT/.ai/repo/ci/gates.yaml"; BASE=""; HEAD=""; FILES=""; FULL=0; WHY=""; FORMAT=json; CHECK=0; ONDEMAND=0
ATTR_ROOT="$ROOT"; INVENTORY=0; BASELINE=""; TREE="$ROOT"
while [ $# -gt 0 ]; do
  case "$1" in
    --base) BASE="$2"; shift 2 ;;
    --head) HEAD="$2"; shift 2 ;;
    --files) FILES="$2"; shift 2 ;;
    --full) FULL=1; shift; if [ $# -gt 0 ] && [ "${1#--}" = "$1" ]; then WHY="$1"; shift; fi ;;
    --on-demand) ONDEMAND=1; shift ;;
    --format) FORMAT="$2"; shift 2 ;;
    --model) MODEL="$2"; shift 2 ;;
    --attr-root) ATTR_ROOT="$2"; shift 2 ;;
    --check) CHECK=1; shift ;;
    --inventory) INVENTORY=1; shift ;;
    --baseline) BASELINE="$2"; shift 2 ;;
    --tree) TREE="$2"; shift 2 ;;
    # A bare path list — `ci-plan a.sh b.sh` — is the obvious guess, and it is the one thing
    # the parser cannot take: the paths a plan is computed over come from one of three named
    # sources, so that a plan always records what it was computed from. An argument that does
    # not start with a dash is that guess rather than a misspelt option, and naming the
    # spelling it wanted costs one branch.
    -*) echo "ci-plan: unknown option $1" >&2; exit 2 ;;
    *) echo "ci-plan: paths are not given as arguments; --files takes a file of them, one per line, and --files - reads stdin" >&2
       echo "ci-plan:   printf '%s\\n' $1 ... | scripts/ci-plan --files -" >&2
       exit 2 ;;
  esac
done
case "$FORMAT" in json|text|github) ;; *) echo "ci-plan: --format is json, text or github" >&2; exit 2 ;; esac
[ -f "$MODEL" ] || { echo "ci-plan: no CI model at $MODEL" >&2; exit 10; }

# ---------------------------------------------------------------- the model
FLAT="$(mktemp "${TMPDIR:-/tmp}/mj-ci-plan.XXXXXX")"; trap 'rm -f "$FLAT" "$FLAT".block "$FLAT".attr "$FLAT".derived "$FLAT".kinds "$FLAT".needles "$FLAT".needles.pat "$FLAT".hits "${LIST:-}"' EXIT
mj_yaml_flatten "$MODEL" > "$FLAT" || { echo "ci-plan: $MODEL does not parse" >&2; exit 10; }
[ "$(mj_yget "$FLAT" version)" = 1 ] || { echo "ci-plan: $MODEL: version must be 1" >&2; exit 10; }
gate_ids="$(awk -F= '$1 ~ /^gates\.[0-9]+\.id$/ { print $2 }' "$FLAT")"
[ -n "$gate_ids" ] || { echo "ci-plan: $MODEL declares no gates" >&2; exit 10; }
bad=0
for g in $gate_ids; do
  i="$(awk -F= -v g="$g" '$1 ~ /^gates\.[0-9]+\.id$/ && $2 == g { split($1, a, "."); print a[2]; exit }' "$FLAT")"
  [ -n "$(mj_yget "$FLAT" "gates.$i.job")" ] || { echo "ci-plan: gate $g names no job" >&2; bad=1; }
  [ -n "$(mj_yget "$FLAT" "gates.$i.runs")" ] || { echo "ci-plan: gate $g names no command (runs)" >&2; bad=1; }
  # `on-demand: false` would be a gate that says it is on demand and is not; the field is
  # present and true, or absent. A gate cannot be both always and on demand.
  od="$(mj_yget "$FLAT" "gates.$i.on-demand")"
  [ -z "$od" ] || [ "$od" = true ] || { echo "ci-plan: gate $g: on-demand is true or absent, not $od" >&2; bad=1; }
  [ "$od" != true ] || [ "$(mj_yget "$FLAT" "gates.$i.always")" != true ] \
    || { echo "ci-plan: gate $g is both always and on-demand" >&2; bad=1; }
  # `network` says the gate reaches beyond this machine; like on-demand, true or absent
  net="$(mj_yget "$FLAT" "gates.$i.network")"
  [ -z "$net" ] || [ "$net" = true ] || { echo "ci-plan: gate $g: network is true or absent, not $net" >&2; bad=1; }
  # `subsumed-by` names one other gate that exists: a gate is not subsumed by itself, and the
  # gate that subsumes it is not itself subsumed (a chain would drop a gate for a gate the plan
  # then drops, and nothing would run the cases)
  sub="$(mj_yget "$FLAT" "gates.$i.subsumed-by")"
  if [ -n "$sub" ]; then
    [ "$sub" != "$g" ] || { echo "ci-plan: gate $g is subsumed by itself" >&2; bad=1; }
    printf '%s\n' "$gate_ids" | grep -x "$sub" >/dev/null || { echo "ci-plan: gate $g is subsumed by a gate that does not exist: $sub" >&2; bad=1; }
    j="$(awk -F= -v g="$sub" '$1 ~ /^gates\.[0-9]+\.id$/ && $2 == g { split($1, a, "."); print a[2]; exit }' "$FLAT")"
    [ -z "$j" ] || [ -z "$(mj_yget "$FLAT" "gates.$j.subsumed-by")" ] || { echo "ci-plan: gate $g is subsumed by $sub, which is itself subsumed; a chain is not a relation the planner applies" >&2; bad=1; }
  fi
  for ref in $(mj_ylist "$FLAT" "gates.$i.implies") $(mj_ylist "$FLAT" "gates.$i.requires"); do
    printf '%s\n' "$gate_ids" | grep -x "$ref" >/dev/null || { echo "ci-plan: gate $g refers to a gate that does not exist: $ref" >&2; bad=1; }
  done
done
[ "$(printf '%s\n' "$gate_ids" | LC_ALL=C sort | uniq -d | wc -l | tr -d ' ')" = 0 ] || { echo "ci-plan: a gate id is declared twice" >&2; bad=1; }
class_ids="$(awk -F= '$1 ~ /^classes\.[0-9]+\.id$/ { print $2 }' "$FLAT")"
[ -n "$class_ids" ] || { echo "ci-plan: $MODEL declares no classes" >&2; exit 10; }
n_classes="$(printf '%s\n' "$class_ids" | wc -l | tr -d ' ')"
i=0; while [ "$i" -lt "$n_classes" ]; do
  c="$(mj_yget "$FLAT" "classes.$i.id")"
  [ -n "$(mj_ylist "$FLAT" "classes.$i.paths")" ] || { echo "ci-plan: class $c names no paths" >&2; bad=1; }
  # an exception names one path the class's patterns would otherwise take, never a pattern:
  # a wildcard here would carve an open-ended hole in an escalating class, and a new file
  # under it would leave the full plan on the day it appeared
  for ex in $(mj_ylist "$FLAT" "classes.$i.except"); do
    case "$ex" in *'*'*) echo "ci-plan: class $c excepts a pattern ($ex); an exception names one path" >&2; bad=1 ;; esac
  done
  if [ "$(mj_yget "$FLAT" "classes.$i.gates")" != full ]; then
    for ref in $(mj_ylist "$FLAT" "classes.$i.gates"); do
      printf '%s\n' "$gate_ids" | grep -x "$ref" >/dev/null || { echo "ci-plan: class $c names a gate that does not exist: $ref" >&2; bad=1; }
    done
  fi
  i=$((i+1))
done
# A shape narrows a plan, so a shape that does not resolve is refused rather than ignored:
# one that named a gate the model lacks would plan less than it says, and one with no record
# pattern would claim every change made only of derived files.
shape_ids="$(awk -F= '$1 ~ /^shapes\.[0-9]+\.id$/ { print $2 }' "$FLAT")"
n_shapes="$(printf '%s' "$shape_ids" | grep -c . || true)"
i=0; while [ "$i" -lt "$n_shapes" ]; do
  s_id="$(mj_yget "$FLAT" "shapes.$i.id")"
  [ -n "$(mj_ylist "$FLAT" "shapes.$i.records")" ] || { echo "ci-plan: shape $s_id names no record pattern (records)" >&2; bad=1; }
  [ "$(mj_yget "$FLAT" "shapes.$i.others")" = derived ] \
    || { echo "ci-plan: shape $s_id: others must be derived, the one kind of path a shape admits beside its records" >&2; bad=1; }
  [ -n "$(mj_ylist "$FLAT" "shapes.$i.gates")" ] || { echo "ci-plan: shape $s_id names no gate" >&2; bad=1; }
  for ref in $(mj_ylist "$FLAT" "shapes.$i.gates"); do
    printf '%s\n' "$gate_ids" | grep -x "$ref" >/dev/null || { echo "ci-plan: shape $s_id names a gate that does not exist: $ref" >&2; bad=1; }
  done
  i=$((i+1))
done
[ "$(printf '%s' "$shape_ids" | LC_ALL=C sort | uniq -d | grep -c . || true)" = 0 ] || { echo "ci-plan: a shape id is declared twice" >&2; bad=1; }
[ "$bad" = 0 ] || exit 10
gate_jobs="$(awk -F= '$1 ~ /^gates\.[0-9]+\.id$/ { split($1, a, "."); id[a[2]] = $2 } $1 ~ /^gates\.[0-9]+\.job$/ { split($1, a, "."); job[a[2]] = $2 } END { for (i in id) print id[i] "\t" job[i] }' "$FLAT")"
gate_runs="$(awk -F= '$1 ~ /^gates\.[0-9]+\.id$/ { split($1, a, "."); id[a[2]] = $2 } $1 ~ /^gates\.[0-9]+\.runs$/ { split($1, a, "."); r[a[2]] = substr($0, length($1) + 2) } END { for (i in id) print id[i] "\t" r[i] }' "$FLAT")"
network_ids="$(awk -F= '
  $1 ~ /^gates\.[0-9]+\.id$/ { split($1, a, "."); id[a[2]] = $2 }
  $1 ~ /^gates\.[0-9]+\.network$/ && $2 == "true" { split($1, a, "."); n[a[2]] = 1 }
  END { for (i in id) if (i in n) print id[i] }' "$FLAT" | LC_ALL=C sort | tr '\n' ' ')"
ondemand_ids="$(awk -F= '
  $1 ~ /^gates\.[0-9]+\.id$/ { split($1, a, "."); id[a[2]] = $2 }
  $1 ~ /^gates\.[0-9]+\.on-demand$/ && $2 == "true" { split($1, a, "."); od[a[2]] = 1 }
  END { for (i in id) if (i in od) print id[i] }' "$FLAT" | LC_ALL=C sort | tr '\n' ' ')"
on_demand() { case " $ondemand_ids " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
[ "$CHECK" = 1 ] && { echo "ci-plan: $MODEL: $(printf '%s\n' "$gate_ids" | wc -l | tr -d ' ') gates ($(printf '%s' "$ondemand_ids" | wc -w | tr -d ' ') on demand), $n_classes classes, $n_shapes shape(s), every reference resolves"; exit 0; }

# ---------------------------------------------------------------- the inventory
# No script outside the model carries a list of gates (I2350). A gate added to the model and
# not to a second list is a gate that list never runs, so the second list is looked for: the
# tracked files, outside the model and what is generated from or recorded about it, that run
# the commands of two gates, or name three gates on a line. The gate ids and commands are the
# ones parsed above; this adds no second reading of the model. A command that is not one
# plain line (a chain, a command substitution, a "then") cannot be found by text and is not
# looked for; where one command contains another (cockpit-projection-check and its
# --ui-integrity form) the longer match is the only one counted.
#
# What is left is a ratchet: .ai/repo/ci/gate-list-baseline.txt holds the findings that
# remain, each with the reason, and a finding it does not hold fails, as does an entry that no
# longer matches anything, so the baseline can only shrink.
if [ "$INVENTORY" = 1 ]; then
  [ -n "$BASELINE" ] || BASELINE="$TREE/.ai/repo/ci/gate-list-baseline.txt"
  [ -r "$BASELINE" ] || { echo "ci-plan: no baseline at $BASELINE" >&2; exit 12; }
  git -C "$TREE" rev-parse --git-dir >/dev/null 2>&1 || { echo "ci-plan: $TREE is not a git checkout; the inventory reads its tracked files" >&2; exit 12; }
  # kind, gate, text: one needle per gate id and one per plain command, in the model's order.
  # A command chained with && is looked for step by step, and a step that two gates share
  # (scripts/rust-check --doc) names neither and is left out.
  printf '%s\n' "$gate_runs" | LC_ALL=C sort | awk -F'\t' '
    NF >= 2 {
      print "id\t" $1 "\t" $1
      r = substr($0, length($1) + 2)
      if (index(r, "$(") || index(r, ", ")) next
      m = split(r, seg, " && ")
      for (k = 1; k <= m; k++) if (length(seg[k]) >= 8) { owners[seg[k]] = owners[seg[k]] "\t" $1; steps[++ns] = seg[k]; stepgate[ns] = $1 }
    }
    END {
      for (k = 1; k <= ns; k++) {
        n = split(owners[steps[k]], o, "\t") - 1
        if (n == 1 || (n == 2 && o[2] == o[3])) print "run\t" stepgate[k] "\t" steps[k]
      }
    }' > "$FLAT.needles"
  cut -f3 "$FLAT.needles" | LC_ALL=C sort -u > "$FLAT.needles.pat"
  rc=0
  git -C "$TREE" grep -I -n --no-color -F -f "$FLAT.needles.pat" -- . \
    ':!.ai/repo/ci/gates.yaml' ':!.ai/repo/ci/gate-list-baseline.txt' ':!docs/generated' \
    ':!site/data/generated' ':!site/data/registry' ':!site/content' ':!site/i18n' ':!handbook/shape' \
    ':!.ai/repo/project' ':(exclude,glob).ai/repo/*baseline*.txt' ':!test/cases' ':!test/fixtures' \
    > "$FLAT.hits" || rc=$?
  rm -f "$FLAT.needles.pat"
  [ "$rc" = 0 ] || [ "$rc" = 1 ] || { echo "ci-plan: git grep failed in $TREE (exit $rc)" >&2; exit 12; }
  rc=0
  LC_ALL=C awk -v needles="$FLAT.needles" -v baseline="$BASELINE" '
    # an identifier character: a match inside a longer word, or a file name, is not a mention
    function word(c) { return c != "" && c ~ /[A-Za-z0-9_-]/ }
    function bounded(t, s, e,   b, a, a2) {
      b = (s > 1) ? substr(t, s - 1, 1) : ""; a = substr(t, e + 1, 1); a2 = substr(t, e + 2, 1)
      if (word(b) || b == ".") return 0
      if (word(a)) return 0
      if (a == "." && a2 ~ /[A-Za-z0-9_]/) return 0
      return 1
    }
    # the text before a command, back to the last separator, is only what introduces a command
    # (a prompt, a list dash, "if", "bash", "run:", a path prefix, an assignment): the command
    # is then run on this line, and not discussed in a sentence or a comment
    function invoked(t, s,   pre, n, w, i, tok, k, ok) {
      pre = substr(t, 1, s - 1)
      if (index(pre, "#")) return 0
      for (k = length(pre); k >= 1; k--) {
        c2 = substr(pre, k - 1, 2)
        if (c2 == "&&" || c2 == "||" || c2 == "$(") { pre = substr(pre, k + 1); break }
        if (substr(pre, k, 1) == ";" || substr(pre, k, 1) == "|") { pre = substr(pre, k + 1); break }
      }
      n = split(pre, w, /[ \t]+/)
      for (i = 1; i <= n; i++) {
        tok = w[i]
        if (tok == "-" && w[i + 1] == "run:") continue
        if (tok == "" || tok ~ /^(@|\$|!|"|if|then|do|else|elif|while|until|run:|bash|sh|exec|time|sudo|env)$/) continue
        if (tok ~ /^[A-Za-z_][A-Za-z0-9_]*=[^ ]*$/) continue
        if (tok ~ /^"?(\.\/|\$ROOT\/|\$\{ROOT\}\/)$/ || tok ~ /^"?\$ROOT"?\/?$/) continue
        return 0
      }
      return 1
    }
    # two gate ids are one enumeration when only list punctuation, quotes and "and"/"or" lie between
    function listed(g) {
      gsub(/[`"*()]/, "", g); gsub(/\047/, "", g); gsub(/\[|\]/, "", g)
      gsub(/(^|[ \t])(and|or)([ \t]|$)/, " ", g); gsub(/[,|+\/&]/, " ", g)
      return g ~ /^[ \t]*$/
    }
    # the run of commands just ended names two or more gates: one finding for its file
    function flush(   g, list) {
      if (ncl >= 2 && !((curfile ":runs") in found)) {
        for (g = 1; g <= ng; g++) if (gname[g] in cl) list = list (list == "" ? "" : ", ") gname[g]
        found[curfile ":runs"] = curfile ":" clstart ": runs the commands of " ncl " gates: " list; order[++nf] = curfile ":runs"
      }
    }
    BEGIN {
      gap = 10
      while ((getline l < needles) > 0) {
        split(l, f, "\t"); n++; kind[n] = f[1]; gate[n] = f[2]; text[n] = substr(l, length(f[1]) + length(f[2]) + 3)
        if (f[1] == "id" && !(f[2] in seen)) { seen[f[2]] = 1; ng++; gname[ng] = f[2] }
      }
      while ((getline l < baseline) > 0) {
        sub(/[ \t]+$/, "", l)
        if (l == "" || l ~ /^#/) continue
        want[l] = 1; wantorder[++nw] = l
      }
    }
    {
      p = index($0, ":"); file = substr($0, 1, p - 1); rest = substr($0, p + 1)
      q = index(rest, ":"); num = substr(rest, 1, q - 1); line = substr(rest, q + 1)
      # the workflow reads the plan'"'"'s outputs on lines of its own (case 26_ci_wiring holds them)
      if (file == ".github/workflows/validate.yml" && index(line, "needs.plan.outputs.")) next
      nm = 0; ni = 0
      for (i = 1; i <= n; i++) {
        off = 0; rem = line
        while ((p = index(rem, text[i])) > 0) {
          s = off + p; e = s + length(text[i]) - 1
          if (bounded(line, s, e)) {
            if (kind[i] == "id") { ni++; is[ni] = s; ie[ni] = e; ig[ni] = gate[i] }
            else if (invoked(line, s)) { nm++; ms[nm] = s; me[nm] = e; mg[nm] = gate[i] }
          }
          off = s; rem = substr(line, off + 1)
        }
      }
      for (a = 1; a <= nm; a++) {
        inner = 0
        for (b = 1; b <= nm; b++) if (b != a && ms[b] <= ms[a] && me[b] >= me[a] && (me[b] - ms[b]) > (me[a] - ms[a])) inner = 1
        if (inner) continue
        # a list is commands near each other: a gap of more than gap lines starts another
        if (file != curfile || num - lastnum > gap) { flush(); curfile = file; delete cl; ncl = 0; clstart = num }
        if (!(mg[a] in cl)) { cl[mg[a]] = 1; ncl++ }
        lastnum = num
      }
      # the ids, in the order they stand on the line; a run of them is counted by distinct gate
      for (a = 2; a <= ni; a++) { s = is[a]; e = ie[a]; g = ig[a]; for (b = a - 1; b >= 1 && is[b] > s; b--) { is[b+1] = is[b]; ie[b+1] = ie[b]; ig[b+1] = ig[b] } is[b+1] = s; ie[b+1] = e; ig[b+1] = g }
      delete grp; best = 0; c = 0
      for (a = 1; a <= ni; a++) {
        if (a > 1 && !listed(substr(line, ie[a-1] + 1, is[a] - ie[a-1] - 1))) { delete grp; c = 0 }
        if (!(ig[a] in grp)) { grp[ig[a]] = 1; c++ }
        if (c > best) { best = c; bestgrp = ""; for (g in grp) bestgrp = bestgrp "\t" g }
      }
      if (best >= 3) {
        k = file ":names"
        if (!(k in found)) {
          list = ""; for (g = 1; g <= ng; g++) if (index(bestgrp "\t", "\t" gname[g] "\t")) list = list (list == "" ? "" : ", ") gname[g]
          found[k] = file ":" num ": lists " best " gates: " list; order[++nf] = k
        }
      }
    }
    END {
      flush()
      bad = 0; held = 0
      for (i = 1; i <= nf; i++) {
        k = order[i]
        if (k in want) { held++; continue }
        print found[k] " (not in the baseline)"; bad++
      }
      for (i = 1; i <= nw; i++) if (!(wantorder[i] in found)) { print "STALE " wantorder[i] ": the baseline holds an entry that matches nothing; delete the line"; bad++ }
      printf "ci-plan: inventory: %d finding(s), %d in the baseline, %d to fix\n", nf, held, bad
      exit (bad > 0 ? 10 : 0)
    }' "$FLAT.hits" || rc=$?
  exit "$rc"
fi

# ---------------------------------------------------------------- the change
LIST="$(mktemp "${TMPDIR:-/tmp}/mj-ci-plan-files.XXXXXX")"
if [ "$FULL" = 1 ]; then
  : > "$LIST"; [ -n "$WHY" ] || WHY="full validation requested"
elif [ -n "$FILES" ]; then
  if [ "$FILES" = - ]; then cat > "$LIST"; else cat "$FILES" > "$LIST"; fi
  BASE="(listed)"; HEAD="(listed)"
else
  if [ -z "$BASE" ]; then
    for ref in origin/master master origin/main main; do
      git -C "$ROOT" rev-parse -q --verify "$ref" >/dev/null 2>&1 && { BASE="$(git -C "$ROOT" merge-base "$ref" "${HEAD:-HEAD}")"; break; }
    done
    [ -n "$BASE" ] || { echo "ci-plan: no default branch to compare with; pass --base" >&2; exit 12; }
  fi
  # a base or head that names no commit is refused here: the worktree branch below pipes git
  # into sort, whose status is the pipe's, so an unknown base used to yield a plan of whatever
  # `git status` listed and exit 0, a plan computed from nothing that read as a pass
  for ref in "$BASE" ${HEAD:+"$HEAD"}; do
    git -C "$ROOT" rev-parse -q --verify "$ref^{commit}" >/dev/null 2>&1 \
      || { echo "ci-plan: $ref names no commit here; nothing can be compared with it" >&2; exit 12; }
  done
  if [ -n "$HEAD" ]; then
    git -C "$ROOT" diff --name-only "$BASE" "$HEAD" > "$LIST" || { echo "ci-plan: git diff $BASE $HEAD failed" >&2; exit 12; }
  else
    HEAD="worktree"
    { git -C "$ROOT" diff --name-only "$BASE" HEAD && git -C "$ROOT" status --porcelain | sed 's/^...//; s/.* -> //'; } | LC_ALL=C sort -u > "$LIST" \
      || { echo "ci-plan: git diff $BASE failed" >&2; exit 12; }
  fi
fi
sed -i.bak '/^$/d' "$LIST" 2>/dev/null && rm -f "$LIST.bak"

# ---------------------------------------------------------------- the match
# One awk pass: every changed path against every class pattern; the union of the classes'
# gates, `full` when a class says so or a path matches nothing.
MATCH="$(awk -F= -v files="$LIST" '
  function pat2re(p,   r, i, c, out) {
    out = "^"
    for (i = 1; i <= length(p); i++) {
      c = substr(p, i, 1)
      if (c == "*") { if (substr(p, i + 1, 1) == "*") { out = out ".*"; i++ } else { out = out "[^/]*" } }
      else if (index(".\\+?()[]{}|^$", c)) { out = out "\\" c }
      else out = out c
    }
    return out "$"
  }
  $1 ~ /^classes\.[0-9]+\.id$/ { split($1, a, "."); cid[a[2]] = $2; if (a[2] + 0 > nc) nc = a[2] + 0 }
  $1 ~ /^classes\.[0-9]+\.paths\.[0-9]+$/ { split($1, a, "."); pat[a[2] "." a[4]] = pat2re($2); np[a[2]] = (a[4] + 0 > np[a[2]] ? a[4] + 0 : np[a[2]]) }
  $1 ~ /^classes\.[0-9]+\.except\.[0-9]+$/ { split($1, a, "."); exc[a[2] "." a[4]] = pat2re($2); ne[a[2]] = (a[4] + 0 > ne[a[2]] ? a[4] + 0 : ne[a[2]]) }
  $1 ~ /^classes\.[0-9]+\.gates$/ { split($1, a, "."); full[a[2]] = ($2 == "full") }
  $1 ~ /^classes\.[0-9]+\.gates\.[0-9]+$/ { split($1, a, "."); cg[a[2]] = cg[a[2]] " " $2 }
  END {
    while ((getline path < files) > 0) {
      hit = 0
      for (c = 0; c <= nc; c++) {
        # a path a class excepts is not in that class, whatever its patterns say; it still
        # falls in every other class that matches it, and in none it is unclassified
        out = 0; for (i = 0; i <= ne[c]; i++) if ((c "." i) in exc && match(path, exc[c "." i])) { out = 1; break }
        if (out) continue
        for (i = 0; i <= np[c]; i++) if ((c "." i) in pat && match(path, pat[c "." i])) {
        hit = 1; print "class\t" cid[c] "\t" path
        if (full[c]) print "full\t" cid[c] "\t" path
        n = split(cg[c], gs, " "); for (k = 1; k <= n; k++) if (gs[k] != "") print "gate\t" gs[k] "\t" cid[c]
        break
        }
      }
      if (!hit) print "unclassified\t-\t" path
    }
  }' "$FLAT")"

mode=affected; reason="the gates of the classes the changed paths fall in"
if [ "$FULL" = 1 ]; then mode=full; reason="$WHY"
elif printf '%s\n' "$MATCH" | grep -q '^full'; then
  mode=full; reason="a changed path is in a class that escalates: $(printf '%s\n' "$MATCH" | awk -F'\t' '$1=="full"{print $3}' | head -3 | tr '\n' ' ')"
elif printf '%s\n' "$MATCH" | grep -q '^unclassified'; then
  mode=full; reason="a changed path is in no class of the model: $(printf '%s\n' "$MATCH" | awk -F'\t' '$1=="unclassified"{print $3}' | head -3 | tr '\n' ' ')"
elif [ ! -s "$LIST" ]; then
  reason="no changed path; only the gates that always run"
fi
if [ "$mode" = full ]; then
  # the escalation reasons end in a space (`tr '\n' ' '` above); strip it whether or not the
  # note follows, so the reason is one sentence either way and is the executable's word for
  # word (src/gates/model.rs; test/cases/131_completion_gates.sh compares them)
  reason="${reason% }"
  [ "$ONDEMAND" = 1 ] || [ -z "$ondemand_ids" ] || reason="$reason (without the on-demand gates: ${ondemand_ids% })"
fi

# ---------------------------------------------------------------- the shapes
# The one rule that narrows (the model's header states it). Only an affected plan is ever
# narrowed: an escalation and an unclassified path stay full, so a shape can take nothing out
# of a plan the model says must run everything.
#
# A path is derived when git marks it merge=derived AND a pattern of the block
# scripts/gitattributes generates matches it from the root. Both, because git's answer alone
# would admit what that block does not say: an attribute line outside the block, a nested
# .gitattributes (one the change itself could add), a user-level attributes file, or a block
# pattern without a slash, which git matches at any depth. The block is the generators' own
# claim, and the merge-policy gate proves it is; requiring it can only make fewer paths
# derived, never more.
#
# The attributes are read from a working tree (--attr-root, default this checkout), so a plan
# of --base/--head whose head is not the commit checked out there is not narrowed.
shape=""; shape_records=""; shape_derived=0; shape_note=""
if [ "$mode" = affected ] && [ -s "$LIST" ] && [ "$n_shapes" -gt 0 ]; then
  attr_ok=1
  if [ -n "$HEAD" ] && [ "$HEAD" != worktree ] && [ "$HEAD" != "(listed)" ]; then
    want="$(git -C "$ROOT" rev-parse -q --verify "$HEAD^{commit}" 2>/dev/null || true)"
    have="$(git -C "$ATTR_ROOT" rev-parse -q --verify "HEAD^{commit}" 2>/dev/null || true)"
    [ -n "$want" ] && [ "$want" = "$have" ] || { attr_ok=0; shape_note="the head $HEAD is not the commit checked out, so its attributes cannot be read"; }
  fi
  if [ "$attr_ok" = 1 ]; then
    if [ -f "$ATTR_ROOT/.gitattributes" ]; then
      awk '/^# >>> generated by scripts\/gitattributes/ { f = 1; next } /^# <<< generated by scripts\/gitattributes/ { f = 0 }
           f && $2 == "merge=derived" { print $1 }' "$ATTR_ROOT/.gitattributes" > "$FLAT.block"
    else
      : > "$FLAT.block"
    fi
    if git -C "$ATTR_ROOT" -c core.attributesFile=/dev/null check-attr --stdin merge < "$LIST" > "$FLAT.attr" 2>/dev/null; then
      awk -F': merge: ' '$2 == "derived" { print $1 }' "$FLAT.attr" > "$FLAT.derived"
    else
      attr_ok=0; shape_note="git could not read the attributes in $ATTR_ROOT"
    fi
  fi
  i=0; while [ "$attr_ok" = 1 ] && [ "$i" -lt "$n_shapes" ] && [ -z "$shape" ]; do
    s_id="$(mj_yget "$FLAT" "shapes.$i.id")"
    # one line per changed path: record, derived, or other
    awk -v recs="$(mj_ylist "$FLAT" "shapes.$i.records" | tr '\n' ' ')" -v block="$FLAT.block" -v attrs="$FLAT.derived" '
      function pat2re(p,   r, i, c, out) {
        out = "^"
        for (i = 1; i <= length(p); i++) {
          c = substr(p, i, 1)
          if (c == "*") { if (substr(p, i + 1, 1) == "*") { out = out ".*"; i++ } else { out = out "[^/]*" } }
          else if (index(".\\+?()[]{}|^$", c)) { out = out "\\" c }
          else out = out c
        }
        return out "$"
      }
      BEGIN {
        nr = split(recs, rp, " "); for (k = 1; k <= nr; k++) rre[k] = pat2re(rp[k])
        nb = 0; while ((getline b < block) > 0) bre[++nb] = pat2re(b)
        while ((getline a < attrs) > 0) git[a] = 1
      }
      NF {
        kind = "other"
        for (k = 1; k <= nr; k++) if (match($0, rre[k])) { kind = "record"; break }
        if (kind == "other" && ($0 in git)) for (k = 1; k <= nb; k++) if (match($0, bre[k])) { kind = "derived"; break }
        print kind "\t" $0
      }' "$LIST" > "$FLAT.kinds"
    n_rec="$(grep -c '^record' "$FLAT.kinds" || true)"
    n_oth="$(grep -c '^other' "$FLAT.kinds" || true)"
    if [ "$n_rec" -gt 0 ] && [ "$n_oth" = 0 ]; then
      shape="$s_id"
      shape_records="$(awk -F'\t' '$1 == "record" { print $2 }' "$FLAT.kinds")"
      shape_derived="$(grep -c '^derived' "$FLAT.kinds" || true)"
      shape_gates=" $(mj_ylist "$FLAT" "shapes.$i.gates" | tr '\n' ' ')"
    elif [ "$n_rec" -gt 0 ]; then
      shape_note="not the shape $s_id: $(awk -F'\t' '$1 == "other" { print $2 }' "$FLAT.kinds" | head -3 | tr '\n' ' ')is neither a record nor a derived file"
    fi
    i=$((i+1))
  done
  rm -f "$FLAT.block" "$FLAT.attr" "$FLAT.derived" "$FLAT.kinds"
fi
if [ -n "$shape" ]; then
  reason="the change is of the shape $shape: $(printf '%s\n' "$shape_records" | grep -c .) record(s) ($(printf '%s' "$shape_records" | tr '\n' ' ' | sed 's/ $//')) and $shape_derived derived file(s), each proven equal to its regeneration by the shape's gates; the always gates and the shape's own run, not the union of the classes"
elif [ -n "$shape_note" ]; then
  reason="${reason% } (${shape_note% })"
fi

# ---------------------------------------------------------------- the selection
selected=""; why_of=""
add() { case " $selected " in *" $1 "*) ;; *) selected="$selected $1" ;; esac; why_of="$why_of
$1	$2"; }
for g in $gate_ids; do
  i="$(awk -F= -v g="$g" '$1 ~ /^gates\.[0-9]+\.id$/ && $2 == g { split($1, a, "."); print a[2]; exit }' "$FLAT")"
  # An on-demand gate is left out of every plan that did not ask for it — including the full
  # one — and says so, so that a reader of the plan sees a gate that was not planned rather
  # than a job that will be pending for ever.
  if [ "$ONDEMAND" = 0 ] && on_demand "$g"; then
    why_of="$why_of
$g	on demand only: its runner is not available on demand; the schedule, a dispatch and a pull request labelled ci:full plan it"
    continue
  fi
  if [ "$mode" = full ]; then add "$g" "full"
  elif [ "$(mj_yget "$FLAT" "gates.$i.always")" = true ]; then add "$g" "always"
  elif [ -n "$shape" ]; then
    case "$shape_gates " in *" $g "*) add "$g" "shape $shape" ;; esac
  else
    by="$(printf '%s\n' "$MATCH" | awk -F'\t' -v g="$g" '$1=="gate" && $2==g {print $3}' | LC_ALL=C sort -u | tr '\n' ' ')"
    [ -n "$by" ] && add "$g" "class ${by% }"
  fi
done
# a selected gate brings what it implies and what it requires
changed=1; while [ "$changed" = 1 ]; do
  changed=0
  for g in $selected; do
    i="$(awk -F= -v g="$g" '$1 ~ /^gates\.[0-9]+\.id$/ && $2 == g { split($1, a, "."); print a[2]; exit }' "$FLAT")"
    for ref in $(mj_ylist "$FLAT" "gates.$i.implies"); do case " $selected " in *" $ref "*) ;; *) add "$ref" "implied by $g"; changed=1 ;; esac; done
    for ref in $(mj_ylist "$FLAT" "gates.$i.requires"); do case " $selected " in *" $ref "*) ;; *) add "$ref" "required by $g"; changed=1 ;; esac; done
  done
done
# ... but nothing implies or requires its way past the plan the caller asked for: an
# on-demand gate stays out, whoever named it.
if [ "$ONDEMAND" = 0 ] && [ -n "$ondemand_ids" ]; then
  kept=""; for g in $selected; do on_demand "$g" || kept="$kept $g"; done; selected="$kept"
fi
# ... and a gate whose subsuming gate is in the plan is not planned beside it. This is the last
# step of the selection, after the closure above, so a subsuming gate that was only implied or
# required still counts; the reason replaces the one that selected the gate, because the plan
# must say why a gate is absent, not why it once was present.
kept=""
for g in $selected; do
  i="$(awk -F= -v g="$g" '$1 ~ /^gates\.[0-9]+\.id$/ && $2 == g { split($1, a, "."); print a[2]; exit }' "$FLAT")"
  sub="$(mj_yget "$FLAT" "gates.$i.subsumed-by")"
  if [ -n "$sub" ]; then
    case " $selected " in
      *" $sub "*)
        why_of="$(printf '%s\n' "$why_of" | awk -F'\t' -v g="$g" '$1 != g')
$g	subsumed by $sub: the planned $sub runs every case this gate runs, so planning it too would run them twice"
        continue ;;
    esac
  fi
  kept="$kept $g"
done
selected="${kept# }"

# ---------------------------------------------------------------- the output
# what a gate the plan left out is told: under a shape it was the shape that left it out, and
# the reader of the run must see that rather than a class map that was never consulted
skip_why="no changed path in a class that needs it"
[ -z "$shape" ] || skip_why="left out by the shape $shape, which plans the always gates and its own gates only"
case "$FORMAT" in
  text)
    printf 'mode: %s (%s)\nbase: %s\nhead: %s\nchanged: %s path(s)\n' "$mode" "$reason" "$BASE" "$HEAD" "$(wc -l < "$LIST" | tr -d ' ')"
    [ -z "$shape" ] || printf 'shape: %s (records: %s; derived: %s)\n' "$shape" "$(printf '%s' "$shape_records" | tr '\n' ' ' | sed 's/ $//')" "$shape_derived"
    for g in $gate_ids; do
      w="$(printf '%s\n' "$why_of" | awk -F'\t' -v g="$g" '$1==g {print $2; exit}')"
      # run or skip is read from the selection, never from the presence of a reason: an
      # on-demand gate carries a reason and is not selected, and printing it as `run` is how
      # a reader is told a gate ran that never did.
      case " $selected " in
        *" $g "*) printf '  run   %-17s %s\n' "$g" "$w" ;;
        *) printf '  skip  %-17s %s\n' "$g" "${w:-$skip_why}" ;;
      esac
    done ;;
  github)
    printf 'mode=%s\n' "$mode"
    printf 'shape=%s\n' "$shape"
    printf 'selected=%s\n' "$selected"
    for g in $gate_ids; do
      case " $selected " in *" $g "*) v=true ;; *) v=false ;; esac
      printf '%s=%s\n' "$(printf '%s' "$g" | tr '-' '_')" "$v"
    done ;;
  json)
    {
      printf '%s\n' "$MATCH" | awk -F'\t' '$1=="class" {print $2 "\t" $3}' | LC_ALL=C sort -u
    } > "$FLAT.classes"
    jq -n --arg mode "$mode" --arg reason "$reason" --arg base "$BASE" --arg head "$HEAD" --arg model "${MODEL#"$ROOT"/}" \
      --rawfile changed "$LIST" --rawfile classes "$FLAT.classes" \
      --arg selected "$selected" --arg gates "$gate_ids" --arg why "$why_of" --arg jobs "$gate_jobs" --arg runs "$gate_runs" \
      --arg network "$network_ids" \
      --arg unclassified "$(printf '%s\n' "$MATCH" | awk -F'\t' '$1=="unclassified"{print $3}')" \
      --arg skip_why "$skip_why" --arg shape "$shape" --arg shape_records "$shape_records" --arg shape_derived "$shape_derived" '
      def lines: split("\n") | map(select(length > 0));
      ($why | lines | map(split("\t") | {key: .[0], value: .[1]}) | from_entries) as $w
      | ($jobs | lines | map(split("\t") | {key: .[0], value: .[1]}) | from_entries) as $jobs
      | ($runs | lines | map(split("\t") | {key: .[0], value: .[1]}) | from_entries) as $runs
      | ($selected | split(" ") | map(select(length > 0))) as $sel
      | ($network | split(" ") | map(select(length > 0))) as $net
      | { schema: 1, model: $model, mode: $mode, reason: $reason, base: $base, head: $head,
          changed: ($changed | lines),
          classes: ($classes | lines | map(split("\t")) | group_by(.[0]) | map({id: .[0][0], paths: map(.[1])})),
          unclassified: ($unclassified | lines),
          shape: (if $shape == "" then null else {id: $shape, records: ($shape_records | lines), derived: ($shape_derived | tonumber)} end),
          gates: ($gates | lines | map({id: ., job: ($jobs[.] // ""), runs: ($runs[.] // ""), selected: (. as $g | $sel | index($g) != null), network: (. as $g | $net | index($g) != null), reason: ($w[.] // $skip_why)})),
          selected: $sel }'
    rm -f "$FLAT.classes" ;;
esac
