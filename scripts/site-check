#!/usr/bin/env bash
# site-check — validates the derived site after scripts/site-build. Exit 0 clean, 10 findings, 12 missing.
# Every check names what it proves. Nothing here needs Node or a browser.
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"; SITE="$ROOT/site"; PUB="$SITE/public"
MJ_VERSION="site"; MJ_BIN_DIR="$ROOT/bin"; MJ_LIB_DIR="$ROOT/lib"; export MJ_VERSION MJ_BIN_DIR MJ_LIB_DIR
# shellcheck source=../lib/common.sh
. "$ROOT/lib/common.sh"
# the layout, resolved by the tool itself: the local half of the AI layer is this checkout's
# own and absent on a fresh clone, so a responsibility page may name a path under it
# without the file existing here
MJ_ROOT="$ROOT"; export MJ_ROOT; mj_resolve_layout
LOCAL="$(mj_rel "$MJ_AI_LOCAL_DIR")"
fails=0; ok() { printf 'OK   %-12s %s\n' "$1" "$2"; }; bad() { printf 'FAIL %-12s %s\n' "$1" "$2"; fails=$((fails+1)); }
[ -d "$PUB" ] || { echo "site-check: site/public/ missing; run scripts/site-build" >&2; exit 12; }
PREFIX="$(sed -n 's/^base_url = "\(.*\)"/\1/p' "$SITE/config.toml" | sed -E 's#^[a-z]+://[^/]+##; s#/$##')"
pages="$(find "$PUB" -name '*.html')"

# 1. data in sync with canonical sources
if "$ROOT/scripts/generate-site-data" --check >/dev/null 2>&1; then ok sync "site/data/generated matches canonical inputs"; else bad sync "site/data/generated is stale; run scripts/generate-site-data"; fi
# 2. generated data schema: every file parses and carries schema 1
# derived from the directory, not listed here: a new generated file is checked the day it appears
gen_files="$(find "$SITE/data/generated" -name '*.json' | sed 's#.*/##; s#\.json$##' | sort)"
for f in $gen_files; do
  [ "$(jq -r '.schema' "$SITE/data/generated/$f.json" 2>/dev/null)" = 1 ] || bad schema "$f.json missing or schema != 1"
done; ok schema "every generated file ($(printf '%s\n' $gen_files | wc -l | tr -d ' ')) carries schema 1"
# 3. marketing copy: line budget, no numbers, no claim words
ml="$(mj_lines "$SITE/data/marketing.toml")"; [ "$ml" -le 60 ] && ok promo "marketing.toml is $ml lines, budget 60" || bad promo "marketing.toml is $ml lines, budget 60"
if grep -vE '^\s*#' "$SITE/data/marketing.toml" | grep -qE '\b[0-9]+ ?%|\b[0-9]{2,}\b'; then bad promo "marketing.toml contains a number; numbers are computed, never written"; fi
# 3b. the hero: every proposition in marketing.toml is on the homepage in full, the first one is
# the page's h1 and the checked default, and the primary action lands on a section of the page
HL="$(grep -oE 'headline = "[^"]*"' "$SITE/data/marketing.toml" | sed 's/^headline = "//; s/"$//')"
hero_bad=0
printf '%s\n' "$HL" | while read -r h; do grep -qF ">$h<" "$PUB/index.html" || echo "$h"; done | head -1 | grep -q . && { bad hero "a proposition's headline is not on the homepage"; hero_bad=1; }
grep -qF ">$(printf '%s\n' "$HL" | head -1)</h1>" "$PUB/index.html" || { bad hero "the h1 is not the first proposition's headline"; hero_bad=1; }
grep -qE 'id="hero-p-1"[^>]* checked' "$PUB/index.html" || { bad hero "the first proposition is not the checked default"; hero_bad=1; }
# every proposition has its page under /outcomes/, and every outcome page is a proposition
for slug in $(grep -oE 'slug = "[^"]*"' "$SITE/data/marketing.toml" | sed 's/^slug = "//; s/"$//'); do
  [ -f "$PUB/outcomes/$slug/index.html" ] || { bad hero "proposition $slug has no page under /outcomes/"; hero_bad=1; }
  grep -qF "/outcomes/$slug/" "$PUB/index.html" || { bad hero "the homepage does not link /outcomes/$slug/"; hero_bad=1; }
done
for f in "$SITE"/content-src/outcomes/*.md; do slug="$(basename "$f" .md)"; [ "$slug" = _index ] && continue; grep -qF "slug = \"$slug\"" "$SITE/data/marketing.toml" || { bad hero "outcomes/$slug is not a proposition in marketing.toml"; hero_bad=1; }; done
grep -oE 'href="#[a-z-]+"' "$PUB/index.html" | sed 's/href="#//; s/"$//' | sort -u | while read -r a; do grep -q "id=\"$a\"" "$PUB/index.html" || echo "$a"; done | head -1 | grep -q . && { bad hero "an in-page link has no target section"; hero_bad=1; }
[ "$hero_bad" = 0 ] && ok hero "$(printf '%s\n' "$HL" | wc -l | tr -d ' ') propositions on the homepage, each with its page under /outcomes/; the first is the h1 and the default; in-page links resolve"
# 4. routes: metadata, landmarks, no unresolved placeholders, one h1, viewport
for f in $pages; do
  rel="${f#"$PUB"/}"
  grep -q '<meta name="viewport"' "$f" || bad route "$rel: no viewport meta"
  grep -q '<meta name="description"' "$f" || bad route "$rel: no description"
  grep -q '<main' "$f" || bad route "$rel: no <main> landmark"
  [ "$(grep -o '<h1' "$f" | wc -l | tr -d ' ')" = 1 ] || bad route "$rel: expected exactly one <h1>"
  # a {{...}} inside a code span or a code block is rendered output (docs/SCHEMAS.md and
  # docs/CLI.md document the prompt renderer's own {{TOKEN}} syntax), not an unrendered
  # template: Zola produced it, so it cannot be a template Zola failed to expand
  awk '/<pre/{p=1} !p{print} /<\/pre>/{p=0}' "$f" | sed -e 's|<code[^>]*>[^<]*</code>||g' \
    | grep -qE '\{\{|\{%|\[\[[A-Z_]+\]\]' && bad route "$rel: unresolved template placeholder"
  grep -qE ' style="' "$f" && bad route "$rel: inline style attribute (forbidden by the custom CSS policy)"
done; ok route "$(printf '%s\n' "$pages" | wc -l | tr -d ' ') pages: viewport, description, main, one h1, no placeholders, no inline styles"
# 5. prefix: every root-absolute href/src carries the deployment path
if [ -n "$PREFIX" ]; then
  if grep -rhoE '(href|src|content)="/[^"]*"' $pages | grep -vE "=\"$PREFIX(/|\")" | grep -vE '="/\)' | head -1 | grep -q .; then
    bad prefix "root-absolute path without $PREFIX: $(grep -rhoE '(href|src|content)="/[^"]*"' $pages | grep -vE "=\"$PREFIX(/|\")" | head -1)"
  else ok prefix "every root-absolute path carries $PREFIX"; fi
fi
# 6. internal links resolve to a generated file
missing=0
for l in $(grep -rhoE 'href="'"$PREFIX"'/[^"#?]*' $pages | sed -E "s#^href=\"$PREFIX##" | sort -u); do
  t="$PUB$l"; [ -f "$t" ] || [ -f "$t/index.html" ] || [ -f "${t%/}/index.html" ] || { bad link "$l does not resolve"; missing=1; }
done; [ "$missing" = 0 ] && ok link "every internal link resolves"
# 7. assets present
for a in app.css js/flowbite.min.js js/alpine.min.js js/theme.js js/mermaid.min.js js/diagrams.js js/graph.js js/hero.js js/cytoscape.min.js images/logo-mark.svg images/social-card.png giallo-light.css giallo-dark.css; do
  [ -f "$PUB/$a" ] || bad asset "$a missing from site/public"
done; ok asset "css, flowbite, alpine, mermaid, cytoscape, theme, diagrams, graph, images, highlighting present"
grep -qE '^[[:space:]]*\.dark ' "$PUB/giallo-dark.css" && ok darkcss "giallo-dark.css scoped under .dark" || bad darkcss "giallo-dark.css not scoped under .dark (site-build post-step)"
# 8. no external runtime dependency: every script/stylesheet is served from this site's own origin
BASE_URL="$(sed -n 's/^base_url = "\(.*\)"/\1/p' "$SITE/config.toml" | sed 's#/$##')"
remote="$(grep -rhoE '<(script|link)[^>]+(src|href)="https?://[^"]+"' $pages | grep -v 'rel="canonical"' | grep -vF "\"$BASE_URL/" | head -1 || true)"
if [ -n "$remote" ]; then bad offline "remote script or stylesheet: $remote"; else ok offline "every script and stylesheet is same-origin; the site works offline after build"; fi
# 9. flowbite + alpine hooks are used, and initFlowbite is called once per page
for f in $pages; do
  [ "$(grep -o 'initFlowbite()' "$f" | wc -l | tr -d ' ')" = 1 ] || bad js "${f#"$PUB"/}: initFlowbite() must appear exactly once"
done; grep -q 'data-collapse-toggle="navbar-main"' "$PUB/index.html" && grep -q 'x-data=' "$PUB/index.html" && ok js "flowbite collapse and alpine x-data present; initFlowbite called once per page" || bad js "flowbite/alpine hooks missing on the homepage"
# 10. mermaid: every diagram page has the runtime and at least one source block
for f in $pages; do
  if grep -q 'class="mermaid' "$f"; then grep -q 'js/mermaid.min.js' "$f" || bad mermaid "${f#"$PUB"/}: has diagrams but no mermaid runtime"; fi
done; ok mermaid "every page with <pre class=\"mermaid\"> loads the runtime"
# 11. responsive lint (structural causes of horizontal overflow)
for f in $pages; do
  rel="${f#"$PUB"/}"; flat="$(tr -d '\n' < "$f")"
  npre="$(printf '%s' "$flat" | grep -o '<pre' | wc -l | tr -d ' ')"
  nwrap="$(printf '%s' "$flat" | grep -oE '(overflow-x-auto[^>]*>[[:space:]]*<pre|class="format[^"]*"[^>]*>.*<pre)' | wc -l | tr -d ' ')"
  # pres inside a Typography container scroll by the plugin's own rule; others need the wrapper
  if [ "$npre" -gt 0 ] && [ "$nwrap" = 0 ]; then bad mobile "$rel: <pre> without overflow container"; fi
  grep -oE 'class="[^"]*"' "$f" | grep -qE '(class="|[[:space:]])grid-cols-([3-9]|1[0-2])([[:space:]]|")' && bad mobile "$rel: grid-cols-3+ without a breakpoint prefix"
  grep -oE '\b(min-)?w-\[[0-9]{3,}px\]' "$f" | awk -F'[][]' '{gsub(/px/,"",$2); if ($2+0 > 360) found=1} END{exit !found}' && bad mobile "$rel: fixed width over 360px"
done; ok mobile "no unwrapped <pre>, no unprefixed grid-cols-3+, no fixed width over 360px"
# 12. secrets and private paths in output
grep -rhoaE '/Users/[a-z]+/|/home/[a-z]+/dev/|\.internal\b|\.corp\b' "$PUB" | head -1 | grep -q . && bad private "local path in output" || ok private "no local paths or internal hosts"
grep -rhoaE '(api[_-]?key|secret|token|password)[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9_\-]{12,}' "$PUB" | grep -viE 'id-token|GITHUB_TOKEN' | head -1 | grep -q . && bad secrets "credential pattern in output" || ok secrets "no credential pattern"
# 13. docs coverage: every rendered docs page has a source, every docs.json entry is rendered
for d in $(jq -r '.docs[].path' "$SITE/data/generated/docs.json" | sed 's/\.md$//' | tr 'A-Z_' 'a-z-' | grep -v '^agents$'); do [ -f "$PUB/docs/$d/index.html" ] || bad docs "docs.json lists $d but no route was generated"; done; ok docs "every document in docs.json has a route"
# 13h. the HTTP API reference: the page renders every operation, tag and schema the data holds,
# the raw document is served byte for byte as the committed one, and the URL the executable
# prints as externalDocs lands on the page that was built
OAD="$SITE/data/generated/openapi.json"; OAP="$PUB/docs/api/index.html"; apibad=0
if [ -f "$OAP" ]; then
  for id in $(jq -r '.tags[].operations[].id' "$OAD"); do grep -qF "id=\"op-$(printf '%s' "$id" | tr '.' '-')\"" "$OAP" || { bad api "operation $id is not on /docs/api/"; apibad=1; }; done
  for t in $(jq -r '.tags[].name' "$OAD"); do grep -qF "id=\"tag-$t\"" "$OAP" || { bad api "tag $t is not on /docs/api/"; apibad=1; }; done
  for n in $(jq -r '.schemas[].name' "$OAD"); do grep -qF "id=\"schema-$n\"" "$OAP" || { bad api "schema $n is not on /docs/api/"; apibad=1; }; done
  grep -qF '/openapi.json' "$OAP" || { bad api "/docs/api/ does not link the raw document"; apibad=1; }
  jq -r '.tags[].operations[].curl' "$OAD" | while read -r c; do grep -qF "$(printf '%s' "$c" | sed 's/&/\&amp;/g; s/"/\&quot;/g' | cut -c1-40)" "$OAP" || echo "$c"; done | head -1 | grep -q . && { bad api "an operation's curl example is not on /docs/api/"; apibad=1; }
else bad api "no page at /docs/api/"; apibad=1; fi
if [ -f "$PUB/openapi.json" ]; then
  cmp -s "$PUB/openapi.json" "$ROOT/docs/generated/openapi.json" || { bad api "site/public/openapi.json differs from docs/generated/openapi.json"; apibad=1; }
  [ "$(jq -S '.paths | keys' "$PUB/openapi.json")" = "$(jq -S '[.tags[].operations[].path] | unique' "$OAD")" ] || { bad api "the operations on /docs/api/ are not the paths in /openapi.json"; apibad=1; }
  ext="$(jq -r '.externalDocs.url // ""' "$PUB/openapi.json")"; extrel="${ext#"$BASE_URL"}"
  [ -n "$ext" ] && [ "$extrel" != "$ext" ] && [ -f "$PUB${extrel%/}/index.html" ] || { bad api "externalDocs.url '$ext' does not land on a built route"; apibad=1; }
else bad api "site/public/openapi.json missing"; apibad=1; fi
[ "$apibad" = 0 ] && ok api "/docs/api/ renders every operation, tag and schema; /openapi.json is the committed document; externalDocs lands on the page"
# 13i. the Rust executable's reference: every module and every capability of the registry
# dataset (site/data/registry/registry.json, written by the executable) has its page, no page
# exists without its entry (an orphan route is a capability that was removed and whose page
# was not), the routes the site generator derived (executable.json) name the same ids the
# dataset holds (the two projections come from one `generate` run), every capability page
# links its module and its operation on the API reference, the MCP page lists every tool,
# the command-line page renders every command, the benchmarks page every target, and no
# template, generator or navigation file names a capability by hand.
RDS="$SITE/data/registry/registry.json"; EXJ="$SITE/data/generated/executable.json"; regbad=0
if [ -f "$RDS" ] && [ -f "$EXJ" ]; then
  [ "$(jq -r '.source' "$EXJ")" = "docs/generated/registry.json" ] || { bad registry "executable.json does not name docs/generated/registry.json as its source"; regbad=1; }
  [ "$(jq -S '[.registry.builtin[].id] | sort' "$RDS")" = "$(jq -S '[.capabilities[].id] | sort' "$EXJ")" ] \
    || { bad registry "the capability ids of site/data/registry/registry.json and executable.json differ (one generate pass wrote them?)"; regbad=1; }
  [ "$(jq -S '[.registry.modules[] | select(.source=="builtin") | .id] | sort' "$RDS")" = "$(jq -S '[.modules[].id] | sort' "$EXJ")" ] \
    || { bad registry "the module ids of site/data/registry/registry.json and executable.json differ"; regbad=1; }
  for r in "" executable/ modules/ capabilities/ cli/ mcp/ benchmarks/; do [ -f "$PUB/registry/${r}index.html" ] || { bad registry "no page at /registry/$r"; regbad=1; }; done
  jq -r '.modules[] | [.slug, .route] | @tsv' "$EXJ" | while IFS="$(printf '\t')" read -r slug route; do
    [ -f "$PUB/registry/modules/$slug/index.html" ] || { echo "no page for module $slug"; continue; }
  done | while read -r l; do bad registry "$l"; done
  jq -r '.capabilities[] | [.id, .slug, .module_route, .api_anchor // "", .tool // ""] | @tsv' "$EXJ" | while IFS="$(printf '\t')" read -r id slug mroute anchor tool; do
    pg="$PUB/registry/capabilities/$slug/index.html"
    [ -f "$pg" ] || { echo "no page for capability $id"; continue; }
    grep -q "$PREFIX$mroute\"" "$pg" || echo "capability page $id does not link its module $mroute"
    if [ -n "$anchor" ]; then
      grep -qF "$PREFIX$anchor\"" "$pg" || echo "capability page $id does not link its operation $anchor"
      grep -qF "id=\"${anchor#/docs/api/#}\"" "$PUB/docs/api/index.html" || echo "operation anchor ${anchor#/docs/api/#} of $id is not on /docs/api/"
    fi
    [ -z "$tool" ] || grep -qF ">$tool<" "$pg" || echo "capability page $id does not show its MCP tool $tool"
    grep -qF "$PREFIX/registry/benchmarks/" "$pg" || echo "capability page $id does not link the benchmarks page"
  done | while read -r l; do bad registry "$l"; done
  # no orphan route: every page under modules/ and capabilities/ is an entry of the dataset
  for d in "$PUB"/registry/modules/*/; do slug="$(basename "$d")"; jq -e --arg s "$slug" '.modules[] | select(.slug==$s)' "$EXJ" >/dev/null || { bad registry "orphan route /registry/modules/$slug/ names no module of the registry"; regbad=1; }; done
  for d in "$PUB"/registry/capabilities/*/; do slug="$(basename "$d")"; jq -e --arg s "$slug" '.capabilities[] | select(.slug==$s)' "$EXJ" >/dev/null || { bad registry "orphan route /registry/capabilities/$slug/ names no capability of the registry"; regbad=1; }; done
  # the surfaces render what the dataset holds
  for t in $(jq -r '.mcp.tools[].name' "$RDS"); do grep -qF ">$t<" "$PUB/registry/mcp/index.html" || { bad registry "MCP tool $t is not on /registry/mcp/"; regbad=1; }; done
  for u in $(jq -r '.mcp.resources[].uri' "$RDS"); do grep -qF ">$u<" "$PUB/registry/mcp/index.html" || { bad registry "MCP resource $u is not on /registry/mcp/"; regbad=1; }; done
  jq -r '[.cli | .. | objects | select(has("path")) | .path | join("-")] | .[]' "$RDS" | while read -r cmd; do
    grep -qF "id=\"cmd-$cmd\"" "$PUB/registry/cli/index.html" || echo "command $cmd is not on /registry/cli/"
  done | while read -r l; do bad registry "$l"; done
  nt="$(jq '.benchmarks.targets | length' "$RDS")"; np="$(grep -o 'id="target-' "$PUB/registry/benchmarks/index.html" | wc -l | tr -d ' ')"
  [ "$nt" = "$np" ] || { bad registry "/registry/benchmarks/ renders $np targets, the dataset holds $nt"; regbad=1; }
  for k in $(jq -r '.benchmarks.coverage.lines[].subject' "$RDS" | sort -u); do grep -qF ">$k<" "$PUB/registry/benchmarks/index.html" || { bad registry "coverage subject $k is not on /registry/benchmarks/"; regbad=1; }; done
  for pl in $(jq -r '.benchmarks.baselines[].platform' "$RDS"); do grep -qF ">$pl<" "$PUB/registry/benchmarks/index.html" || { bad registry "baseline $pl is not on /registry/benchmarks/"; regbad=1; }; done
  # nothing enumerates the registry by hand: a capability id or a module route typed into a
  # template, the site generator, its jq programs or the navigation would be a second list
  for id in $(jq -r '.registry.builtin[].id' "$RDS"); do
    hit="$(grep -l -F -- "$id" "$SITE"/templates/*.html "$SITE"/templates/partials/*.html "$ROOT"/scripts/generate-site-data "$ROOT"/scripts/lib/*.jq "$SITE"/data/nav.toml 2>/dev/null || true)"
    [ -z "$hit" ] || { bad registry "capability $id is named by hand in: $(printf '%s' "$hit" | tr '\n' ' ')"; regbad=1; }
  done
  grep -qE '/registry/(modules|capabilities)/[a-z]' "$SITE/data/nav.toml" && { bad registry "nav.toml enumerates a module or capability route by hand"; regbad=1; }
  [ "$regbad" = 0 ] && ok registry "$(jq '.counts.modules' "$EXJ") modules and $(jq '.counts.capabilities' "$EXJ") capabilities: every one has its page and no page is an orphan; the CLI, MCP and benchmark pages render the dataset; nothing names a capability by hand"
else bad registry "site/data/registry/registry.json or site/data/generated/executable.json missing"; fi
# 13j. the build's provenance is served at /build.json and is this build's: the commit is
# HEAD, the input hash is the one the data carries, the fingerprints are the dataset's. A page
# that names another commit than the one deployed is how a stale deploy hides.
if [ -f "$PUB/build.json" ]; then
  bj="$PUB/build.json"; bbad=0
  head_commit="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)"
  [ "$(jq -r .commit "$bj")" = "$head_commit" ] || { bad build "/build.json names commit $(jq -r .commit "$bj" | cut -c1-12), HEAD is ${head_commit:0:12}"; bbad=1; }
  [ "$(jq -r .source_hash "$bj")" = "$(jq -r .source_hash "$SITE/data/generated/source.json")" ] || { bad build "/build.json input hash differs from source.json"; bbad=1; }
  [ "$(jq -r .registry_fingerprint "$bj")" = "$(jq -r .registry.fingerprint "$SITE/data/registry/registry.json")" ] || { bad build "/build.json registry fingerprint differs from the dataset"; bbad=1; }
  grep -qF "$(jq -r .commit "$bj" | cut -c1-12)" "$PUB/index.html" || { bad build "the homepage footer does not carry the built commit"; bbad=1; }
  [ "$bbad" = 0 ] && ok build "/build.json: commit ${head_commit:0:12}$([ "$(jq -r .dirty "$bj")" = true ] && printf ' (dirty tree)'), input hash $(jq -r .source_hash "$bj" | cut -c1-12), registry fingerprint $(jq -r .registry_fingerprint "$bj" | cut -c1-12)"
else bad build "site/public/build.json missing (site-build writes it)"; fi
# 13b. every tile has a page: profiles, claims, statuses, responsibilities, commands
for slug in $(jq -r '.profiles[].slug' "$SITE/data/generated/profiles.json"); do [ -f "$PUB/profiles/$slug/index.html" ] || bad tiles "no page for profile $slug"; done
for id in $(jq -r '.claims[].id' "$SITE/data/generated/capabilities.json"); do [ -f "$PUB/guarantees/$id/index.html" ] || bad tiles "no page for claim $id"; done
for st in $(jq -r '.statuses | keys_unsorted[]' "$SITE/data/generated/capabilities.json"); do [ -f "$PUB/guarantees/$st/index.html" ] || bad tiles "no page for status $st"; done
for slug in $(jq -r '.does[].slug' "$SITE/data/generated/readme.json"); do [ -f "$PUB/supervises/$slug/index.html" ] || bad tiles "no page for responsibility $slug"; done
for n in $(jq -r '.commands[].name' "$SITE/data/generated/commands.json"); do [ -f "$PUB/commands/$n/index.html" ] || bad tiles "no page for command $n"; done
for id in $(jq -r '.doctrines[].slug' "$SITE/data/generated/doctrines.json"); do [ -f "$PUB/doctrines/$id/index.html" ] || bad tiles "no page for doctrine $id"; done
for id in $(jq -r '.use_cases[].id' "$SITE/data/generated/catalogue.json"); do [ -f "$PUB/use-cases/$id/index.html" ] || bad tiles "no page for use case $id"; done
for id in $(jq -r '.applications[].id' "$SITE/data/generated/catalogue.json"); do [ -f "$PUB/applications/$id/index.html" ] || bad tiles "no page for application $id"; done
# the catalogue's cross-references must survive into the rendered pages, both ways
jq -r '.use_cases[] | .id as $u | .applications[] | "\($u) \(.)"' "$SITE/data/generated/catalogue.json" | while read -r u a; do
  grep -q "/applications/$a/" "$PUB/use-cases/$u/index.html" || bad catalogue "use case $u does not link to application $a"
  grep -q "/use-cases/$u/" "$PUB/applications/$a/index.html" || bad catalogue "application $a does not link back to use case $u"
done
jq -r '.use_cases[] | .id as $u | .steps[] | "\($u) \(.command)"' "$SITE/data/generated/catalogue.json" | while read -r u c; do
  grep -q "/commands/$c/" "$PUB/use-cases/$u/index.html" || bad catalogue "use case $u does not link to the command page for $c"
done
ok catalogue "$(jq -r '.counts.use_cases' "$SITE/data/generated/catalogue.json") use case(s) and $(jq -r '.counts.applications' "$SITE/data/generated/catalogue.json") application(s): every step, rule and cross-reference is a link that resolves"
for f in "$SITE"/content-src/why/*.md; do slug="$(basename "$f" .md)"; [ "$slug" = _index ] && continue; [ -f "$PUB/why/$slug/index.html" ] || bad tiles "no page for why/$slug"; done
for r in limitations roadmap why supervises commands plan plan/dag; do [ -f "$PUB/$r/index.html" ] || bad tiles "no page for /$r/"; done
# the plan: every milestone and every issue is a page, and the DAG the page draws is the DAG
# the data holds. A diagram that has drifted from its own edge list is the failure this catches.
PJ="$SITE/data/generated/plan.json"
for id in $(jq -r '.milestones[].id, .issues[].id' "$PJ"); do
  [ -f "$PUB/plan/$(printf '%s' "$id" | tr 'A-Z' 'a-z')/index.html" ] || bad tiles "no page for plan record $id"
done
# the diagram is HTML, so its arrows are escaped; compare against what the browser receives
jq -r '.edges[] | .from + " --&gt; " + .to' "$PJ" | while read -r e; do
  grep -qF -- "$e" "$PUB/plan/dag/index.html" || bad tiles "edge ${e/--&gt;/-->} is in plan.json but not in the rendered graph"
done
for id in $(jq -r '.issues[] | select(.status=="READY") | .id' "$PJ"); do
  grep -qF "plan/$(printf '%s' "$id" | tr 'A-Z' 'a-z')/" "$PUB/plan/index.html" || bad tiles "READY issue $id is not linked from /plan/"
done
ok tiles "every profile, claim, status, responsibility, command, doctrine, use case, application and why-moment has its own page"
# 13d. every navigation target resolves
for href in $(grep -oE 'href="[^"]*"' "$PUB/index.html" | sed -n '1,80p' | sed -E "s#href=\"$(sed -n 's/^base_url = "\(.*\)"/\1/p' "$SITE/config.toml" | sed 's#/$##')##; s#\"##g" | grep -E '^/' | sort -u); do t="$PUB$href"; [ -f "$t/index.html" ] || [ -f "$t" ] || bad nav "navigation/hero link $href does not resolve"; done
ok nav "every navigation link on the homepage resolves"
# 13c. every claim mention on the homepage is a link to its page
for id in $(jq -r '.claims[].id' "$SITE/data/generated/capabilities.json"); do
  claim="$(jq -r --arg i "$id" '.claims[] | select(.id==$i) | .claim' "$SITE/data/generated/capabilities.json")"
  if grep -qF "$claim" "$PUB/index.html" && ! grep -F "$claim" "$PUB/index.html" | grep -qF "guarantees/$id/"; then bad claims "homepage mentions claim $id without linking its page"; fi
done
# 13e. every directory the generator writes under site/content/ must be ignored. The fact
# lives in generate-site-data, which writes each section fresh and deletes it first, so a new
# section nobody added to .gitignore shows up as untracked files that the next `git add -A`
# commits and the following generate deletes again. Derived by scanning for $CONTENT_ROOT
# uses rather than by listing the sections, so the next one is covered the day it is written.
for d in $(grep -oE '\$CONTENT_ROOT/[a-z-]+' "$ROOT/scripts/generate-site-data" | sed 's#.*/##' | sort -u); do
  # a tracked file is never "ignored", so check both: a generated section that is committed
  # is a different fault from one .gitignore forgot, and saying which saves the reader a
  # detour through `git check-ignore` on a path that is in .gitignore already
  if [ -n "$(git -C "$ROOT" ls-files "site/content/$d" 2>/dev/null)" ]; then
    bad ignored "generate-site-data writes site/content/$d/ but $(git -C "$ROOT" ls-files "site/content/$d" | wc -l | tr -d ' ') file(s) there are committed"
  elif ! git -C "$ROOT" check-ignore -q "site/content/$d/" 2>/dev/null; then
    bad ignored "generate-site-data writes site/content/$d/ but .gitignore does not cover it"
  fi
done

# 13a. derived content is ignored: site/content-src/*.md is projected into site/content/, and
# .gitignore names those projections one by one. A new page whose projection is not ignored
# would be committed as if someone had written it by hand, and would then rot.
for f in "$SITE"/content-src/*.md; do
  [ -e "$f" ] || continue
  rel="site/content/$(basename "$f")"
  git -C "$ROOT" check-ignore -q "$rel" 2>/dev/null || bad ignored "$rel is projected from content-src but not in .gitignore"
done; ok ignored "every projection of site/content-src/ is ignored, not committed"

# 13g. every claim a milestone names carries the link back. The edge is declared once, in
# milestone.claims, and the claim page derives the reverse — so this asserts the direction
# nobody writes, which is the one that goes missing. A link check that only walks forward can
# find links that are wrong and never links that are absent.
for mid in $(jq -r '.milestones[] | select((.claims | length) > 0) | .id' "$SITE/data/generated/roadmap.json"); do
  for cid in $(jq -r --arg m "$mid" '.milestones[] | select(.id==$m) | .claims[]' "$SITE/data/generated/roadmap.json"); do
    p="$PUB/guarantees/$cid/index.html"
    [ -f "$p" ] || { bad roadmap "milestone $mid names claim $cid, which has no page"; continue; }
    grep -qF "roadmap/" "$p" || bad roadmap "claim $cid is named by milestone $mid but does not link back to the roadmap"
  done
done
ok roadmap "every claim a milestone names links back to it"

# 13f. the contract demonstration is the policy's own list. The page pairs each key in
# policy.verification.finish_requires with the check name the transcript prints, by position,
# and a positional pairing that nobody checks is a pairing that will silently rotate. Asserted
# by containment: scope_respected must contain scope, note_present must contain note.
RQ="$(jq -r '.verification.finish_requires[]' "$SITE/data/generated/policy.json")"
CK="$(jq -r '.finish_checks[]' "$SITE/data/generated/readme.json")"
if [ "$(printf '%s\n' "$RQ" | wc -l)" != "$(printf '%s\n' "$CK" | wc -l)" ]; then
  bad contract "policy.finish_requires and readme.finish_checks are different lengths; the contract page pairs them by position"
else
  n=1; bad_pair=0
  for k in $RQ; do
    c="$(printf '%s\n' "$CK" | sed -n "${n}p")"
    case "$k" in *"$c"*) ;; *) bad contract "finish_requires[$((n-1))] is '$k' but the transcript's line $n is '$c' — the pairing has rotated"; bad_pair=1 ;; esac
    n=$((n+1))
  done
  [ "$bad_pair" = 1 ] || ok contract "$(printf '%s\n' "$RQ" | wc -l | tr -d ' ') contract lines: the policy key and the printed line agree, in order"
fi

# 13d. progressive enhancement, as the property rather than a proxy for it: no content may be
# unreachable without a runtime. An x-show element is inert with JavaScript off and renders,
# which is correct — unless it is *also* hidden by something static. x-cloak is exactly that
# (base.html hides it by CSS until Alpine removes the attribute), and so is the `hidden` class.
# Either one turns "collapsed" into "gone" for a reader without JavaScript. Stated this way the
# rule passes a tab set, which legitimately shows one panel at a time once Alpine runs, and
# fails the disclosure that hid the canonical policy file behind a runtime.
bad_ne=0
for f in $pages; do
  rel="${f#"$PUB"/}"
  # one element per line first, so the two attributes are only seen together when they are
  hits="$(tr '<' '\n' < "$f" | grep 'x-show' | grep -cE 'x-cloak|class="[^"]*(^| )hidden( |")' || true)"
  [ "$hits" = 0 ] || { bad nojs "$rel: $hits element(s) carry x-show and are also hidden statically — unreachable without JavaScript"; bad_ne=1; }
done
[ "$bad_ne" = 1 ] || ok nojs "no element is hidden by both a runtime and a static rule; every x-show renders without JavaScript"

# 13c. the why section links both ways: every moment reaches its commands, responsibilities and
# claims, and every one of those pages carries a link back. A one-way link is how the section
# drifted out of the rest of the site before — the pages knew about the tool, the tool did not
# know about the pages.
WJ="$SITE/data/generated/why.json"
for slug in $(jq -r '.moments[].slug' "$WJ"); do
  page="$PUB/why/$slug/index.html"
  [ -f "$page" ] || { bad why "no page for moment $slug"; continue; }
  grep -qF "why/$slug/" "$PUB/why/index.html" || bad why "the index does not link moment $slug"
  for id in $(jq -r --arg s "$slug" '.moments[] | select(.slug==$s) | .claims[]' "$WJ"); do
    grep -qF "guarantees/$id/" "$page" || bad why "moment $slug names claim $id but does not link it"
    grep -qF "why/$slug/" "$PUB/guarantees/$id/index.html" || bad why "claim $id is named by moment $slug but does not link back"
  done
  for r in $(jq -r --arg s "$slug" '.moments[] | select(.slug==$s) | .responsibilities[]' "$WJ"); do
    grep -qF "why/$slug/" "$PUB/supervises/$r/index.html" || bad why "responsibility $r is named by moment $slug but does not link back"
  done
  for n in $(jq -r --arg s "$slug" '.moments[] | select(.slug==$s) | .commands[]' "$WJ"); do
    grep -qF "commands/$n/" "$page" || bad why "moment $slug names command $n but does not link it"
  done
done
ok why "$(jq '.moments | length' "$WJ") moments: every command, responsibility and claim is linked, and links back"

# 13b. graphs: every edge endpoint resolves to a node, and no graph is empty
for g in architecture claims-graph; do
  gf="$SITE/data/generated/$g.json"
  dangling="$(jq -r '[.nodes[].id] as $n | [.edges[] | select((.source | IN($n[]) | not) or (.target | IN($n[]) | not)) | .source + " -> " + .target] | .[]' "$gf")"
  [ -z "$dangling" ] || bad graphs "$g.json has an edge to a node that does not exist: $(printf '%s' "$dangling" | head -1)"
  [ "$(jq '.nodes | length' "$gf")" -gt 0 ] || bad graphs "$g.json has no nodes"
done
# every claim node's route is a page that exists; the graph links into the site, not into space
for r in $(jq -r '.nodes[] | select(.kind=="claim") | .route' "$SITE/data/generated/claims-graph.json"); do
  [ -f "$PUB${r}index.html" ] || bad graphs "claims-graph node route $r has no page"
done
ok graphs "architecture and claims graphs are connected and their routes resolve"

# 14. claims: the guarantees page carries every claim id count
n="$(jq '.claims | length' "$SITE/data/generated/capabilities.json")"; m="$(grep -o '<tr class="align-top">' "$PUB/guarantees/index.html" | wc -l | tr -d ' ')"
[ "$n" = "$m" ] && ok claims "$n claims rendered on /guarantees/" || bad claims "capabilities.json has $n claims, /guarantees/ renders $m"

# 15. command pages: a route that compiles is not a documented command. Each public command
#     must show its syntax, what it reads and writes, its exit codes, a demonstration whose
#     scenarios come from the fixtures the tests execute, and evidence that resolves. The
#     command list is read from the generated data, so a command added later is checked here
#     without this file being edited.
cmdbad=0
for n in $(jq -r '.commands[].name' "$SITE/data/generated/commands.json"); do
  page="$PUB/commands/$n/index.html"
  [ -f "$page" ] || { bad command "no page for $n"; cmdbad=1; continue; }
  for heading in Syntax Lifecycle Reads Writes "Exit codes" Reference Evidence; do
    grep -qF ">$heading<" "$page" || { bad command "$n: no $heading section"; cmdbad=1; }
  done
  # the syntax shown is the syntax the registry declares
  syn="$(jq -r --arg n "$n" '.commands[] | select(.name==$n) | .syntax' "$SITE/data/generated/commands.json")"
  grep -qF "$(printf '%s' "$syn" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g')" "$page" \
    || { bad command "$n: the page does not show its declared syntax"; cmdbad=1; }
  # every scenario in the fixture is on the page, and the demonstration is operable
  for sid in $(jq -r --arg n "$n" '.commands[] | select(.name==$n) | .demo_data.scenarios[].id' "$SITE/data/generated/commands.json"); do
    grep -qF "s === '$sid'" "$page" || { bad command "$n: scenario $sid is not rendered"; cmdbad=1; }
  done
  grep -q 'role="tablist"' "$page" || { bad command "$n: the demonstration has no tablist"; cmdbad=1; }
  # evidence links resolve to files that exist in this repository
  for t in $(jq -r --arg n "$n" '.commands[] | select(.name==$n) | .tests.behaviour[], .tests.negative[]' "$SITE/data/generated/commands.json" | sort -u); do
    [ -f "$ROOT/test/cases/$t.sh" ] || { bad command "$n: evidence names test/cases/$t.sh, which does not exist"; cmdbad=1; }
    grep -qF "test/cases/$t.sh" "$page" || { bad command "$n: $t is not linked on the page"; cmdbad=1; }
  done
done
[ "$cmdbad" = 0 ] && ok command "every command page carries syntax, reads, writes, exit codes, a demonstration and resolving evidence"

# 16. responsibility pages: a tile is owed the same treatment as a command. Each must say
#     where its state lives, which command acts on it, show that command refusing and
#     accepting, name what enforces it and what it guarantees — and its two deep links into
#     the specification must land on headings that exist, not merely on pages that do.
respbad=0
for slug in $(jq -r '.does[].slug' "$SITE/data/generated/readme.json"); do
  page="$PUB/supervises/$slug/index.html"
  [ -f "$page" ] || { bad supervises "no page for $slug"; respbad=1; continue; }
  for heading in "Where it lives" "What is guaranteed"; do
    grep -qF ">$heading<" "$page" || { bad supervises "$slug: no '$heading' section"; respbad=1; }
  done
  # the files and the implementation it names are linked, and they exist in this repository
  for f in $(jq -r --arg s "$slug" '.does[] | select(.slug==$s) | .files[], .implementation' "$SITE/data/generated/readme.json"); do
    # a path under the local half is described, never required: the generator applies the
    # same rule, and a fresh clone has none of them
    case "$f" in "$LOCAL"/*) ;; *) [ -e "$ROOT/$f" ] || { bad supervises "$slug: names $f, which does not exist"; respbad=1; } ;; esac
    grep -qF "blob/master/$f" "$page" || { bad supervises "$slug: does not link $f"; respbad=1; }
  done
  # each deep link resolves to a heading id on the page it points at, not just to the page
  for pair in cli schema; do
    route="$(jq -r --arg s "$slug" --arg k "${pair}_route" '.does[] | select(.slug==$s) | .[$k]' "$SITE/data/generated/readme.json")"
    target="${route%%#*}"; frag="${route#*#}"
    [ -f "$PUB$target/index.html" ] || { bad supervises "$slug: $route names a page that does not exist"; respbad=1; continue; }
    grep -qF "id=\"$frag\"" "$PUB$target/index.html" || { bad supervises "$slug: $route names no heading on that page"; respbad=1; }
  done
  # a responsibility with an owning command shows that command's demonstration
  cmd="$(jq -r --arg s "$slug" '.does[] | select(.slug==$s) | .command // ""' "$SITE/data/generated/readme.json")"
  if [ -n "$cmd" ]; then
    grep -qF "/commands/$cmd/" "$page" || { bad supervises "$slug: does not link its command $cmd"; respbad=1; }
    grep -q 'role="tablist"' "$page" || { bad supervises "$slug: no demonstration"; respbad=1; }
  fi
  # every claim and doctrine the data associates with it is on the page
  for id in $(jq -r --arg s "$slug" '.does[] | select(.slug==$s) | .claim_ids[]' "$SITE/data/generated/readme.json"); do
    grep -qF "/guarantees/$id/" "$page" || { bad supervises "$slug: claim $id is not linked"; respbad=1; }
  done
done
[ "$respbad" = 0 ] && ok supervises "every responsibility names its state, its command, its guarantees, and two deep links that land on real headings"

printf 'site-check: %s failure(s)\n' "$fails"; [ "$fails" = 0 ] && exit 0 || exit 10
