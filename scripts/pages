#!/usr/bin/env bash
# pages — the GitHub Pages fast path: the smallest sequence that turns this commit into
# publishable bytes, and the measurement of it. One command, run the same way by a person and
# by .github/workflows/pages.yml, so there is no GitHub-only build semantics to drift from.
#
#   scripts/pages build [--base-url URL]  the site, without regenerating what is committed
#   scripts/pages check                   every static check over the output, without a second generation
#   scripts/pages fingerprint             the canonical input hash of this tree
#   scripts/pages current                 is site/data/generated current for this tree? (exit 0/10)
#   scripts/pages paths                   the paths a push must touch for the site to be able to change
#   scripts/pages budget [--json]         the controlled budgets, from the model
#   scripts/pages benchmark [-n N] [--write-baseline]
#                                         build and check N times; JSON (milliseconds) on stdout,
#                                         and with --write-baseline into the tracked baseline of
#                                         this platform under .ai/repo/benchmarks/pages/
#   scripts/pages report --timings FILE [--queue N] [--pages-build N] [--end-to-end N]
#                       [--cold] [--advisory]
#                                         the SLO verdict for a run: a Markdown fragment on
#                                         $GITHUB_STEP_SUMMARY (stdout without it), one
#                                         machine-readable `pages-slo` line always, and exit
#                                         10 when the controlled path is over budget.
#                                         --advisory reports a breach as a ::warning and
#                                         exits 0: for the caller that measures a deployment
#                                         which has already happened.
#   scripts/pages built [--branch B] [--commit SHA] [--wait N] [--porcelain]
#                                         GitHub's own "pages build and deployment" of that commit:
#                                         0 built, 10 errored, 12 not determinable (no gh, no token,
#                                         or GitHub has not built it yet)
#   scripts/pages verify --url URL --commit SHA [--timeout N] [--quiet]
#                                         poll the public site until it serves that commit;
#                                         --timeout 0 is a single probe. 0 it serves it,
#                                         10 it serves something else, 12 it never answered
#
# The model is .ai/repo/ci/pages.yaml. Nothing here carries a path list, a budget or a gate
# name of its own. Exit 0 ok, 2 usage, 10 a refusal or a budget exceeded, 12 something missing.
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MJ_VERSION="pages"; MJ_BIN_DIR="$ROOT/bin"; MJ_LIB_DIR="$ROOT/lib"; export MJ_VERSION MJ_BIN_DIR MJ_LIB_DIR
# shellcheck source=../lib/common.sh
. "$ROOT/lib/common.sh"
MJ_ROOT="$ROOT"; export MJ_ROOT; mj_resolve_layout
command -v jq >/dev/null || { echo "pages: jq is required" >&2; exit 12; }

MODEL="$ROOT/.ai/repo/ci/pages.yaml"
GATES="$ROOT/.ai/repo/ci/gates.yaml"
[ -f "$MODEL" ] || { echo "pages: no publication model at ${MODEL#"$ROOT"/}" >&2; exit 12; }

FLAT="$(mktemp "${TMPDIR:-/tmp}/mj-pages.XXXXXX")"
trap 'rm -f "$FLAT" "${GFLAT:-}"' EXIT
mj_yaml_flatten "$MODEL" > "$FLAT" || { echo "pages: ${MODEL#"$ROOT"/} does not parse" >&2; exit 10; }
[ "$(mj_yget "$FLAT" version)" = 1 ] || { echo "pages: ${MODEL#"$ROOT"/}: version must be 1" >&2; exit 10; }
m() { mj_yget "$FLAT" "$1"; }
ml() { mj_ylist "$FLAT" "$1"; }

OUTPUT="$(m deploy.output)"
IDENTITY="$(m deploy.identity)"

# ---------------------------------------------------------------- timing
# Rows in the shape scripts/ci/summary already renders: "<gate><TAB><step><TAB><seconds>".
# MJ_PAGES_TIMINGS names the file; without it the rows go nowhere and nothing is measured.
row() { [ -n "${MJ_PAGES_TIMINGS:-}" ] && printf 'pages\t%s\t%s\n' "$1" "$2" >> "$MJ_PAGES_TIMINGS"; return 0; }
now() { date +%s; }
# milliseconds, from the tool's own clock: a phase that takes under a second is still a phase,
# and a benchmark that can only see whole seconds cannot tell 40 ms from 900
now_ms() { MJ_TIMING=1 mj_ms; }
timed() { local step="$1" t0; shift; t0="$(now)"; "$@"; local rc=$?; row "$step" "$(( $(now) - t0 ))"; return "$rc"; }

# ---------------------------------------------------------------- fingerprint
# The canonical input hash: what generate-site-data writes into source.json as source_hash,
# computed over the same list in one hashing process. `current` compares it with the committed
# value, which answers "must this tree be regenerated?" in a fifth of a second rather than in
# the forty-odd seconds a generation costs. The generator remains the only thing that writes
# the data; this only decides whether it has to run.
cmd_fingerprint() { "$ROOT/scripts/generate-site-data" --fingerprint; }

cmd_current() {
  local want have src="$ROOT/$OUTPUT/../data/generated/source.json"
  src="$ROOT/site/data/generated/source.json"
  [ -f "$src" ] || { echo "pages: $src is absent; run scripts/generate-site-data" >&2; return 12; }
  want="$(cmd_fingerprint)"
  have="$(jq -r '.source_hash' "$src")"
  if [ "$want" = "$have" ]; then
    [ -n "${MJ_PAGES_QUIET:-}" ] || printf 'pages: site/data/generated is current for this tree (input hash %s)\n' "${want:0:12}"
    return 0
  fi
  printf 'pages: site/data/generated is stale — it carries input hash %s, this tree hashes to %s\n' "${have:0:12}" "${want:0:12}" >&2
  printf '       the committed derived data is a projection of the tree it was generated from; run\n       scripts/derive and commit the result.\n' >&2
  return 10
}

# The second half of the same question. `scripts/derive` runs two generators over different
# artifacts: stage B, `scripts/generate-site-data`, owns site/data/generated, which is what
# cmd_current above compares; stages A and C, `majordomus generate`, own
# site/data/registry/registry.json and docs/generated/artifacts.*, which it does not. A commit
# that moves a source file and regenerates only the first half satisfied this gate and then
# failed CI on the second, for somebody else to read as staleness they did not cause.
#
# The check is the executable's own `generate --check` rather than a comparison written here:
# the staleness of a generated artifact is defined by the generator, and a second definition
# in shell would be a second answer to the same question — and a weaker one, since it would
# have to guess at what the generator hashes. It costs about 12 s against a hook that already
# spends far longer in `doctor`.
#
# A repository without the built executable — an adopter's, or a clone before the first build
# — skips it and says so. Skipping loudly is the point: silence here is what this gate is for.
cmd_derived() {
  local cli="$ROOT/bin/majordomus-cli" out rc=0
  if [ ! -x "$cli" ]; then
    printf 'pages: no %s; the registry half of the derived data was not checked\n' "bin/majordomus-cli" >&2
    return 0
  fi
  out="$(MAJORDOMUS_NO_BUILD=1 "$cli" generate --check 2>&1)" || rc=$?
  case "$rc" in
    0) [ -n "${MJ_PAGES_QUIET:-}" ] || printf 'pages: the registry projections are in sync with this tree\n'
       return 0 ;;
    12) printf 'pages: the executable is not built, so the registry half of the derived data was not checked\n' >&2
        return 0 ;;
  esac
  printf '%s\n' "$out" | grep -v '^20[0-9][0-9]-' >&2
  printf '       the registry records every source file it indexed; a source change moves it, and\n       only `majordomus generate` writes it. Run scripts/derive and commit the result.\n' >&2
  return 10
}

# ---------------------------------------------------------------- build
# No generation. The committed site/data/generated is the canonical projection — the pre-commit
# hook and the `site-build` gate of validate.yml both refuse a tree where it is stale — so the
# fast path establishes that it is current by hash and then renders it. Deleting every cache
# and regenerating from the canonical sources must produce these same bytes; that is what
# `scripts/generate-site-data --check` proves in the full gate.
cmd_build() {
  local base=""
  while [ $# -gt 0 ]; do case "$1" in
    --base-url) base="$2"; shift 2 ;;
    *) echo "pages build: unknown option $1" >&2; exit 2 ;;
  esac; done
  MJ_PAGES_QUIET=1 timed fingerprint cmd_current || return 10
  if [ -n "$base" ]; then timed build "$ROOT/scripts/site-build" --no-data --base-url "$base"
  else timed build "$ROOT/scripts/site-build" --no-data; fi
}

# The static checks over the output, and then the one question none of them asks: is any of
# this the local half of the AI layer? `.ai/local/` holds the prompts a person typed, the
# ledger and the session contexts, and it becomes public the moment the generator reads it.
# The gate is cheap and it is on the publication path deliberately — the fast path is what
# turns a commit into public bytes, so the check that those bytes are not somebody's prompts
# belongs where the bytes are made, not only in a suite that runs beside it.
cmd_check() {
  timed check "$ROOT/scripts/site-check" --no-sync
  # --no-probe: the gate's first question — does planting a file under the local root move the
  # generator's input fingerprint — is a property of the tree, not of this build, and it costs
  # two generations of the fingerprint. It belongs where tree properties are held
  # (test/cases/181_local_is_never_published.sh, which runs it against this checkout) and not
  # on a publication path whose whole budget is 120 seconds. What runs here are the two
  # questions that are about these bytes: no published path under the local root, and no
  # published file that is one of its records. Both are a find away, and on a runner — where
  # the local half is empty, as it is on every fresh clone — the second says so rather than
  # passing silently.
  timed local-check "$ROOT/scripts/ci/local-never-published" --no-probe
}

# ---------------------------------------------------------------- the trigger paths
# Derived, never written twice: the classes of the gate model that name the gate this model
# names are the classes whose paths can change the site. Their pathspecs, plus the extras this
# model declares, are exactly the `paths:` of the Pages workflow.
#
# A class that escalates the whole plan (`gates: full`) is deliberately not one of them. That
# escalation is about how much validation a change to the pipeline deserves, not about what the
# published bytes are derived from: changing scripts/ci-plan or the justfile makes every gate
# run and cannot move a pixel. Publication follows the inputs, and the inputs are named.
cmd_paths() {
  [ -f "$GATES" ] || { echo "pages: no gate model at ${GATES#"$ROOT"/}" >&2; return 12; }
  GFLAT="$(mktemp "${TMPDIR:-/tmp}/mj-pages-gates.XXXXXX")"
  mj_yaml_flatten "$GATES" > "$GFLAT" || { echo "pages: ${GATES#"$ROOT"/} does not parse" >&2; return 10; }
  local gate; gate="$(m trigger.gate)"
  awk -F= -v gate="$gate" '
    $1 ~ /^classes\.[0-9]+\.id$/            { split($1, a, "."); id[a[2]] = $2 }
    $1 ~ /^classes\.[0-9]+\.gates\.[0-9]+$/ { split($1, a, "."); if ($2 == gate) want[a[2]] = 1 }
    $1 ~ /^classes\.[0-9]+\.paths\.[0-9]+$/ { split($1, a, "."); p[a[2] "." a[4]] = $2; c[a[2]] = 1 }
    END { for (k in p) { split(k, a, "."); if (a[1] in want) print p[k] } }
  ' "$GFLAT" > "$GFLAT.paths"
  ml trigger.extra >> "$GFLAT.paths"
  LC_ALL=C sort -u "$GFLAT.paths"
  rm -f "$GFLAT.paths"
}

# ---------------------------------------------------------------- budgets
# The warm phases are whatever the model declares, in the order it declares them. A list
# repeated here is a list that drifts from the one the verdict is taken against, which is how
# `fingerprint` and `local-check` came to be summed into `controlled` while no budget named
# them and every job summary printed them with an empty budget cell.
cmd_budget() {
  local rows
  rows="$(awk -F= '$1 ~ /^budget\.warm\./ { k = $1; sub(/^budget\.warm\./, "", k); print k "=" $2 }' "$FLAT")"
  if [ "${1:-}" = --json ]; then
    jq -n --arg w "$rows" --arg c "$(m budget.cold.controlled)" --arg e "$(m budget.end_to_end)" '
      { schema: 1,
        warm: ($w | split("\n") | map(select(length > 0)) | map(split("=") | {key: .[0], value: (.[1] | tonumber)}) | from_entries),
        cold: { controlled: ($c | tonumber) },
        end_to_end: ($e | tonumber) }'
  else
    printf '%s\n' "$rows" | while IFS='=' read -r k v; do printf 'warm  %-14s %s s\n' "$k" "$v"; done
    printf 'cold  %-14s %s s\n' controlled "$(m budget.cold.controlled)"
    printf 'slo   %-14s %s s (push to publicly observable; reported, not enforced)\n' end_to_end "$(m budget.end_to_end)"
  fi
}

# ---------------------------------------------------------------- benchmark
# The controlled build path, repeated. Measured values only: nothing here prints a number it
# did not time, and the JSON is what docs and the site read rather than a figure in prose.
cmd_benchmark() {
  local n=3 write=0
  while [ $# -gt 0 ]; do case "$1" in
    -n|--iterations) n="$2"; shift 2 ;;
    --json) shift ;;
    --write-baseline) write=1; shift ;;
    *) echo "pages benchmark: unknown option $1" >&2; exit 2 ;;
  esac; done
  case "$n" in ''|*[!0-9]*|0) echo "pages benchmark: --iterations must be a positive integer" >&2; exit 2 ;; esac
  local t tmp i b c f
  tmp="$(mktemp "${TMPDIR:-/tmp}/mj-pages-bench.XXXXXX")"
  i=1; while [ "$i" -le "$n" ]; do
    t="$(now_ms)"; MJ_PAGES_QUIET=1 cmd_current >/dev/null 2>&1 || { echo "pages benchmark: the derived data is stale; nothing measured" >&2; rm -f "$tmp"; exit 10; }
    f=$(( $(now_ms) - t ))
    t="$(now_ms)"; "$ROOT/scripts/site-build" --no-data >/dev/null 2>&1 || { echo "pages benchmark: the build failed" >&2; rm -f "$tmp"; exit 10; }
    b=$(( $(now_ms) - t ))
    t="$(now_ms)"; "$ROOT/scripts/site-check" --no-sync >/dev/null 2>&1 || { echo "pages benchmark: the check failed" >&2; rm -f "$tmp"; exit 10; }
    c=$(( $(now_ms) - t ))
    printf '%s\t%s\t%s\n' "$f" "$b" "$c" >> "$tmp"
    printf 'pages benchmark: sample %s/%s — fingerprint %s ms, build %s ms, check %s ms\n' "$i" "$n" "$f" "$b" "$c" >&2
    i=$((i+1))
  done
  # min, median and p90 of each phase and of their sum, over the samples actually taken
  local out
  out="$(jq -Rn --arg samples "$n" --arg routes "$(find "$ROOT/$OUTPUT" -name index.html | wc -l | tr -d ' ')" \
    --arg platform "$(mj_pages_platform)" --rawfile rows "$tmp" '
    def stats(a): (a | sort_by(.)) as $s | { min: $s[0], median: $s[(($s | length) / 2 | floor)],
                                        p90: $s[((($s | length) * 0.9) - 1 | floor | if . < 0 then 0 else . end)],
                                        max: $s[-1] };
    ($rows | split("\n") | map(select(length > 0)) | map(split("\t") | map(tonumber))) as $r
    | { schema: 1, platform: $platform, samples: ($samples | tonumber), routes: ($routes | tonumber),
        unit: "milliseconds",
        fingerprint: stats([$r[][0]]), build: stats([$r[][1]]), check: stats([$r[][2]]),
        controlled: stats([$r[] | add]) }')"
  rm -f "$tmp"
  printf '%s\n' "$out"
  if [ "$write" = 1 ]; then
    mkdir -p "$ROOT/.ai/repo/benchmarks/pages"
    printf '%s\n' "$out" > "$ROOT/.ai/repo/benchmarks/pages/baseline.$(mj_pages_platform).json"
    printf 'pages benchmark: wrote .ai/repo/benchmarks/pages/baseline.%s.json\n' "$(mj_pages_platform)" >&2
  fi
}

# the platform a measurement belongs to: a baseline of one machine says nothing about another,
# so each is a file of its own, named the way the crate's baselines are
mj_pages_platform() {
  case "$(uname -s)" in Darwin) printf 'macos' ;; Linux) printf 'linux' ;; *) printf 'other' ;; esac
  printf -- '-%s' "$(uname -m)"
}

# ---------------------------------------------------------------- the run's verdict
# The timing rows of one deployment against the budgets, as the fragment the workflow appends
# to its job summary. Controlled latency is what can fail; external latency is reported beside
# it and never conflated with it.
#
# Two things this command learned on 2026-09-12, both from the same defect. Between
# 2026-09-11T22:36Z and 2026-09-12T06:38Z the Pages workflow reported `failure` on run after
# run while every one of them pushed gh-pages correctly and the public site served the commit
# each had built. What was red was this command: the controlled path was over budget, this
# exits 10 when it is, and the workflow ran it as an ordinary step AFTER the publish. So a
# measurement of a deployment that had already succeeded became the verdict on the deployment.
#
#   1. A BREACH MUST NAME ITS CAUSE, NOT ONLY ITS SIZE. `controlled` is the sum of the
#      per-phase budgets, so a total over budget has at least one row over its own. `blame`
#      below is that row, and it goes into the annotation and the summary line. Before this,
#      the whole Markdown fragment went to $GITHUB_STEP_SUMMARY and nothing went to the log,
#      so the log of those eleven runs read `Process completed with exit code 10` with no number
#      above it anywhere a reader would look.
#
#   2. A REPORT IS NOT ALWAYS A GATE. `--advisory` keeps every number and makes the breach a
#      ::warning annotation instead of this command's exit status. It is for the one caller
#      that measures work already done; the default is unchanged, so a person running this and
#      any gate that calls it still gets exit 10 on a breach.
cmd_report() {
  local timings="" ext_queue="" ext_pages="" e2e="" cold=0 advisory=0 out
  while [ $# -gt 0 ]; do case "$1" in
    --timings) timings="$2"; shift 2 ;;
    --queue) ext_queue="$2"; shift 2 ;;
    --pages-build) ext_pages="$2"; shift 2 ;;
    --end-to-end) e2e="$2"; shift 2 ;;
    --cold) cold=1; shift ;;
    --advisory) advisory=1; shift ;;
    *) echo "pages report: unknown option $1" >&2; exit 2 ;;
  esac; done
  [ -n "$timings" ] && [ -s "$timings" ] || { echo "pages report: --timings names no rows" >&2; exit 2; }
  local controlled budget verdict rc=0 blame=""
  controlled="$(awk -F'\t' '{ s += $3 } END { print s + 0 }' "$timings")"
  if [ "$cold" = 1 ]; then budget="$(m budget.cold.controlled)"; else budget="$(m budget.warm.controlled)"; fi
  if [ "$controlled" -le "$budget" ]; then verdict="PASS"; else verdict="OVER BUDGET"; rc=10; fi
  # which phases are over their own budget: the place to look, rather than a number to argue
  # with. A row the model declares no budget for is skipped rather than guessed at.
  blame="$(awk -F'\t' '{ print $2 "\t" $3 }' "$timings" | while IFS="$(printf '\t')" read -r step secs; do
    b="$(m "budget.warm.$step")"
    case "$b" in ''|*[!0-9]*) continue ;; esac
    case "$secs" in ''|*[!0-9]*) continue ;; esac
    [ "$secs" -gt "$b" ] && printf '%s %ss/%ss; ' "$step" "$secs" "$b"
    :
  done)"
  blame="${blame%; }"
  out="${GITHUB_STEP_SUMMARY:-/dev/stdout}"
  {
    printf '### Pages fast path\n\n'
    printf '| phase | seconds | budget |\n|---|---:|---:|\n'
    awk -F'\t' -v mm="$FLAT" '{ print $2 "\t" $3 }' "$timings" | while IFS="$(printf '\t')" read -r step secs; do
      printf '| %s | %s | %s |\n' "$step" "$secs" "$(m "budget.warm.$step" || true)"
    done
    printf '| **controlled** | **%s** | **%s** |\n\n' "$controlled" "$budget"
    printf '| external (not budgeted) | seconds |\n|---|---:|\n'
    printf '| Actions queue and runner start | %s |\n' "${ext_queue:-not measured}"
    printf '| GitHub pages build and deployment | %s |\n\n' "${ext_pages:-not measured}"
    printf 'Pages SLO: **%s** — controlled path %s s / %s s' "$verdict" "$controlled" "$budget"
    [ -n "$e2e" ] && printf ', push to public %s s / %s s' "$e2e" "$(m budget.end_to_end)"
    printf '\n'
    [ -n "$blame" ] && printf '\nOver its own budget: %s\n' "$blame"
    if [ "$rc" != 0 ] && [ "$advisory" = 1 ]; then
      printf '\nThis is the latency of the publication path, not whether the site published:\nthe run states that separately, and a breach here is a warning rather than this\nrun'"'"'s verdict. `scripts/pages report` without `--advisory` still exits 10.\n'
    fi
    if [ -n "$e2e" ] && [ "$e2e" -gt "$(m budget.end_to_end)" ] && [ "$rc" = 0 ]; then
      printf '\nThe end-to-end target was not met while the controlled path was inside its budget: the\nremainder is the Actions queue and GitHub'"'"'s own Pages build, which this repository does not\nspend. That is an external limit, not a regression here.\n'
    fi
  } >> "$out"
  # One line for a reader that is not a person, always, and on the log rather than in the job
  # summary: the Markdown above is invisible to `gh run view --log`, which is where the four
  # red runs of 2026-09-12 were read from.
  printf 'pages-slo verdict=%s controlled=%s budget=%s over=%s\n' \
    "$verdict" "$controlled" "$budget" "${blame:-none}"
  if [ -n "${GITHUB_OUTPUT:-}" ]; then
    { printf 'verdict=%s\n' "$verdict"
      printf 'controlled=%s\n' "$controlled"
      printf 'budget=%s\n' "$budget"
      printf 'over=%s\n' "$blame"
    } >> "$GITHUB_OUTPUT"
  fi
  if [ "$rc" != 0 ] && [ "$advisory" = 1 ]; then
    printf '::warning title=Pages controlled path over budget::controlled path %s s against a budget of %s s (%s). This is the latency of the publication path, not whether the site published — see the publication state annotation for that.\n' \
      "$controlled" "$budget" "${blame:-no single phase over its own budget}"
    rc=0
  fi
  return "$rc"
}

# ---------------------------------------------------------------- public verification
# Workflow success is not publication. The site serves its own identity at deploy.identity —
# the commit it was built from — so the moment that file names this commit is the moment the
# deployment is publicly observable, measured from outside with the cache defeated.
#
# Two failures, told apart deliberately. A site that answers and names another commit has not
# published this one — a refusal, exit 10. A site that never answered at all was not measured,
# and saying "it still serves nothing" about a laptop with no network is a verdict the run did
# not earn — exit 12, the code this script already reserves for something missing. The
# obligation validator, which is the second caller this command has ever had, depends on that
# distinction: one is work that is not published, the other is a check that could not be made.
#
# `--timeout 0` is a single probe, because the loop reads the site before it looks at the
# clock — that is what makes this affordable inside a validator. Each probe is bounded by
# --max-time, so an unreachable host costs a known number of seconds instead of curl's
# default of waiting for a connection that will never open.
cmd_verify() {
  local url="" commit="" timeout=180 quiet=0 t0 waited served body reached=0
  while [ $# -gt 0 ]; do case "$1" in
    --url) url="$2"; shift 2 ;;
    --commit) commit="$2"; shift 2 ;;
    --timeout) timeout="$2"; shift 2 ;;
    --quiet) quiet=1; shift ;;
    *) echo "pages verify: unknown option $1" >&2; exit 2 ;;
  esac; done
  [ -n "$url" ] || url="$(sed -n 's/^base_url = "\(.*\)"/\1/p' "$ROOT/site/config.toml")"
  [ -n "$commit" ] || commit="$(git -C "$ROOT" rev-parse HEAD)"
  # A prefix names a commit only when it is long enough to name one: `b` is an abbreviation
  # of nothing and must not pass for everything. Seven is git's own default abbreviation and
  # the floor it will resolve, so it is the floor here, and anything shorter or not a sha at
  # all is a usage error rather than a verdict nobody meant.
  case "$commit" in
    *[!0-9a-fA-F]*) echo "pages verify: --commit takes a commit sha, not '$commit'" >&2; exit 2 ;;
  esac
  [ "${#commit}" -ge 7 ] || {
    echo "pages verify: --commit $commit is too short to name a commit; use seven characters or more" >&2
    exit 2; }
  command -v curl >/dev/null || { echo "pages verify: curl is required" >&2; return 12; }
  t0="$(now)"
  while :; do
    body="$(curl -fsSL --max-time "${MJ_PAGES_PROBE_SECONDS:-10}" -H 'Cache-Control: no-cache' "${url%/}/$IDENTITY?t=$(now)" 2>/dev/null || true)"
    if [ -n "$body" ]; then
      reached=1
      served="$(printf '%s' "$body" | jq -r '.commit // empty' 2>/dev/null || true)"
    else
      served=""
    fi
    # The site states the full forty characters; a caller states the commit however it has
    # it, and the shortest way to have it is to read it off a gh-pages subject. So the
    # served value is matched as beginning with the one asked for, which is what
    # `scripts/ci/pages-check` already does with this same pair. An exact compare answers
    # "still serves beaee8654..., not beaee8654" — the two strings it prints agree — and
    # spends the whole timeout before saying it.
    if [ -n "$served" ] && [ "${served#"$commit"}" != "$served" ]; then
      waited=$(( $(now) - t0 ))
      [ "$quiet" = 1 ] || printf 'pages verify: %s serves %s after %s s\n' "${url%/}/$IDENTITY" "${commit:0:12}" "$waited"
      printf '%s\n' "$waited" > "${MJ_PAGES_WAITED:-/dev/null}"
      return 0
    fi
    [ $(( $(now) - t0 )) -lt "$timeout" ] || {
      if [ "$reached" = 0 ]; then
        printf 'pages verify: %s could not be reached within %s s; publication was not measured\n' "${url%/}/$IDENTITY" "$timeout" >&2
        return 12
      fi
      printf 'pages verify: after %s s %s still serves %s, not %s\n' "$timeout" "${url%/}/$IDENTITY" "${served:-no commit}" "${commit:0:12}" >&2
      return 10; }
    sleep 2
  done
}

# ---------------------------------------------------------------- dispatch
# ---------------------------------------------------------------- GitHub's own build
# Publishing is two steps owned by two parties. This repository pushes gh-pages; GitHub's own
# "pages build and deployment" turns that branch into the bytes a reader gets. The second can
# fail on a branch that was pushed perfectly, and when it does every signal this repository
# owns is green: the workflow succeeded, the branch carries the right tree, `git log` on
# gh-pages is exactly what it should be, and the public site is a commit behind.
#
# That is not hypothetical. On 2026-09-10 at 17:35:10Z GitHub's build of gh-pages commit
# dfd9c989c errored with "Page build failed."; the site served the previous commit for 27
# minutes and nothing anywhere went red. It is still readable from the API today:
#
#   gh api repos/korczis/prismatic-majordomus/pages/builds --jq '.[0]'
#
# So the status is read rather than inferred from the symptom, and it is read in exactly one
# place: here. `scripts/ci/pages-check` asked the same API in its own words until this command
# existed, and .github/workflows/pages.yml could not ask at all — which is why the one silent
# mode of the three was the one that leaves a green tick. Two readers, one definition.
#
# Exit is the judgement, not the reading: 0 the build of that commit succeeded, 10 it errored,
# 12 it could not be determined — no gh, no `pages: read`, or GitHub has not built that commit
# yet when the wait ran out. 12 is never an `ok`: a build still in flight is weather and a
# caller must be free to treat it as such, but it must not be able to mistake it for success.
cmd_built() {
  local branch="gh-pages" commit="" wait=0 porcelain=0 slug="" build="" all="" newest="" t0 status bcommit berror
  while [ $# -gt 0 ]; do case "$1" in
    --branch) branch="$2"; shift 2 ;;
    --commit) commit="$2"; shift 2 ;;
    --wait) wait="$2"; shift 2 ;;
    --porcelain) porcelain=1; shift ;;
    *) echo "pages built: unknown option $1" >&2; exit 2 ;;
  esac; done
  command -v gh >/dev/null 2>&1 || {
    [ "$porcelain" = 1 ] && printf 'unreadable\t\tgh is not installed\n'
    [ "$porcelain" = 1 ] || echo "pages built: gh is not installed, so GitHub's own build was not read" >&2
    return 12; }
  slug="${GITHUB_REPOSITORY:-}"
  [ -n "$slug" ] || slug="$(git -C "$ROOT" remote get-url origin 2>/dev/null | sed -n 's|.*[:/]\([^/][^/]*/[^/][^/]*\)$|\1|p' | sed 's|\.git$||')"
  [ -n "$slug" ] || { echo "pages built: no repository slug (no GITHUB_REPOSITORY, no origin)" >&2; return 12; }
  if [ -z "$commit" ]; then
    git -C "$ROOT" fetch -q origin "$branch" 2>/dev/null || true
    commit="$(git -C "$ROOT" rev-parse "origin/$branch" 2>/dev/null || git -C "$ROOT" rev-parse "$branch" 2>/dev/null || true)"
  fi
  [ -n "$commit" ] || { echo "pages built: no commit to ask about (branch $branch is not here)" >&2; return 12; }
  t0="$(now)"
  while :; do
    # The newest build OF THAT COMMIT, not merely the newest build. A commit can be built
    # more than once (a re-run, a dispatch), and asking only for `.[0]` makes every question
    # about anything but the very last push unanswerable — including the one a person asks
    # when they come back to an incident: was the build of dfd9c989c the thing that broke?
    # The list is newest-first, so the first match is the newest build of it; `newest` is
    # kept beside it so that "GitHub has not built this at all yet" can say what it HAS built.
    all="$(gh api "repos/$slug/pages/builds" --jq '.[] | "\(.status)\t\(.commit)\t\(.error.message // "no message")"' 2>/dev/null || true)"
    newest="$(printf '%s\n' "$all" | head -1)"
    build="$(printf '%s\n' "$all" | awk -F'\t' -v c="$commit" '$2 == c { print; exit }')"
    [ -n "$build" ] || build="$newest"
    status="$(printf '%s' "$build" | cut -f1)"
    bcommit="$(printf '%s' "$build" | cut -f2)"
    berror="$(printf '%s' "$build" | cut -f3)"
    if [ -n "$build" ] && [ "$bcommit" = "$commit" ] && [ "$status" != building ] && [ "$status" != queued ]; then
      break
    fi
    [ $(( $(now) - t0 )) -lt "$wait" ] || break
    sleep 10
  done
  if [ -z "$build" ]; then
    [ "$porcelain" = 1 ] && printf 'unreadable\t\tno token, or no pages:read\n'
    [ "$porcelain" = 1 ] || echo "pages built: GitHub's Pages build for $slug could not be read (no token, or no pages:read)" >&2
    return 12
  fi
  if [ "$porcelain" = 1 ]; then printf '%s\t%s\t%s\n' "$status" "$bcommit" "$berror"; fi
  if [ "$bcommit" != "$commit" ]; then
    [ "$porcelain" = 1 ] || printf "pages built: GitHub's newest build is of %s (%s), not %s of %s\n" "${bcommit:0:12}" "$status" "${commit:0:12}" "$branch" >&2
    return 12
  fi
  case "$status" in
    built)
      [ "$porcelain" = 1 ] || printf "pages built: GitHub's own build of %s is built\n" "${commit:0:12}"
      return 0 ;;
    errored)
      [ "$porcelain" = 1 ] || {
        printf "pages built: GitHub's own build of %s ERRORED: %s\n" "${commit:0:12}" "$berror" >&2
        printf "             the branch is right and the site is not. Re-run the build by dispatching the\n             pages workflow, or push %s again.\n" "$branch" >&2; }
      return 10 ;;
    *)
      [ "$porcelain" = 1 ] || printf "pages built: GitHub's build of %s is %s; not a verdict\n" "${commit:0:12}" "$status" >&2
      return 12 ;;
  esac
}

case "${1:-}" in
  build)       shift; cmd_build "$@" ;;
  check)       shift; cmd_check "$@" ;;
  fingerprint) shift; cmd_fingerprint "$@" ;;
  current)     shift; cmd_current "$@" && cmd_derived "$@" ;;
  derived)     shift; cmd_derived "$@" ;;
  paths)       shift; cmd_paths "$@" ;;
  budget)      shift; cmd_budget "$@" ;;
  benchmark)   shift; cmd_benchmark "$@" ;;
  report)      shift; cmd_report "$@" ;;
  built)       shift; cmd_built "$@" ;;
  verify)      shift; cmd_verify "$@" ;;
  -h|--help|"") sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "pages: unknown command $1 (scripts/pages --help)" >&2; exit 2 ;;
esac
