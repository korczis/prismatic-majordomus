{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://majordomus.dev/schemas/generated/site-why.schema.json",
  "title": "Site why dataset",
  "description": "site/data/registry/why.json: the dataset the website's /why/ pages are rendered from — the operational moments, the audiences and areas they are read by, the facets they are filtered on and the signals that name them — written by `majordomus generate site` from the Why catalogue.",
  "type": "object",
  "required": ["schema", "generated", "generator", "fingerprint", "route", "counts", "facets", "audiences", "areas", "signals", "moments", "valid"],
  "properties": {
    "schema": { "const": "majordomus-site-why/v1" },
    "generated": { "type": "string", "pattern": "^GENERATED FILE" },
    "generator": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "majordomus-cli" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "route": { "type": "string", "pattern": "^/" },
    "counts": {
      "type": "object",
      "required": ["areas", "audiences", "examples", "moments", "moments_all", "signals"],
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "facets": {
      "type": "object",
      "description": "What the catalogue can be filtered by; each facet is derived from the moments, never listed.",
      "required": ["areas", "audiences", "capabilities", "commands", "frequencies", "lifecycle", "severities", "tags"]
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "route", "status", "moments", "count"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "pattern": "^/" },
          "count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "route", "status", "moments", "count"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "pattern": "^/" },
          "count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "signals": {
      "type": "array",
      "description": "What a reader notices, each naming the moment it belongs to.",
      "items": {
        "type": "object",
        "required": ["id", "moment", "text"],
        "properties": { "moment": { "type": "string", "minLength": 1 } }
      }
    },
    "moments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "route", "status", "areas", "audiences"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "pattern": "^/" }
        }
      }
    },
    "valid": {
      "type": "boolean",
      "description": "Whether the catalogue validated when it was written; a false here is a rendered warning, not a hidden one."
    }
  }
}
