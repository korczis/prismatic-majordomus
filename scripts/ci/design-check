#!/usr/bin/env bash
# design-check — the design is one declaration, and no surface carries a second one.
#
# Two questions, both machine-answerable:
#
#   1. Are the projections current? `scripts/design-tokens --check` regenerates
#      share/design/theme.css, share/design/surface.css and
#      apps/majordomus-cli/src/web/tokens.css from share/design/tokens.yaml and fails when
#      a committed one differs. A value changed in the canonical file and not projected is
#      a value that reaches one surface and not the others.
#
#   2. Does anything choose a colour outside the canonical file? A stylesheet, a template,
#      a script that supplies CSS values, or Rust that writes a <style> block may name a
#      token; it may not invent one. Every hexadecimal, rgb(), hsl() or oklch() literal
#      outside share/design/tokens.yaml is a second decision, and a second decision is how
#      four surfaces came to have four palettes.
#
# What is exempt, and why — an exemption is a reason, never a path somebody added:
#
#   share/design/*.css, apps/majordomus-cli/src/web/tokens.css
#       the generated projections themselves. They are made of literals; that is their job.
#   */vendor/*, share/cockpit/cockpit.css
#       third-party bytes and a compiled artifact. Neither is written here.
#   *.svg
#       an icon is an image. A favicon cannot reach a custom property — a browser renders
#       it outside any document — so its colours are in the file by necessity.
#   share/cockpit/graph.js
#       computes a hue per node kind from the number of kinds. That is a categorical scale
#       over data, generated at run time; there is no literal palette to share.
#   scripts/lib/ui-contrast.mjs, scripts/lib/ui.test.mjs, scripts/lib/cockpit-probe.mjs
#       colour arithmetic and colour measurement, not colour choice. The contrast library
#       searches between pure black and pure white and documents itself with examples; the
#       probe compares a computed background against the fully transparent sentinel. None
#       of them paints anything, and none of them would go stale if a token changed.
#
# `color-mix()` is deliberately not a literal: it composes values that are already tokens
# or CSS-wide keywords. `color-mix(in oklch, var(--color-accent-500) 22%, transparent)`
# names no colour of its own. A raw literal *inside* one is still caught, because the
# literal itself is what this looks for.
#
#   scripts/ci/design-check
#
# Exit: 0 clean, 10 a projection is stale or a surface carries its own colour.
#
# The rule is project.design-tokens-declared-once; ADR 0031 records the decision.
set -eu
# Where the scripts are is not where the tree under test is. `--root DIR` moves the second
# and never the first, so the case in test/cases drives the real gate over a fixture.
HERE="$(cd "$(dirname "$0")/../.." && pwd)"
if [ "${1:-}" = "--root" ]; then ROOT="${2:?--root needs a directory}"; shift 2; else
  ROOT="$HERE"
fi
cd "$ROOT"
status=0

echo "== the projections are current"
"$HERE/scripts/design-tokens" --root "$ROOT" --check || status=10

echo "== no surface carries a colour of its own"
# What counts as a literal, and what deliberately does not:
#
#   #rrggbb, #rrggbbaa   always. Six hexadecimal digits in a row are a colour and nothing
#                        else anybody writes.
#   #rgb                 only in a value position — after `:`, `(` or `,`. Three hexadecimal
#                        digits are also a pull request (`#117`), an issue, an anchor
#                        (`#features` is `#fea` followed by more letters, which the word
#                        boundary already excludes) and a C preprocessor line. A gate that
#                        cannot tell `--bg: #fff` from `Merge pull request #117` is a gate
#                        somebody switches off, and then it protects nothing.
#   rgb() hsl() oklch()  always. A colour function is only ever a colour.
#
# The set of files asked is every tracked source that can put a colour on a screen.
LITERAL='#([0-9a-fA-F]{8}|[0-9a-fA-F]{6})\b|[:(,][[:space:]]*#[0-9a-fA-F]{3}\b|\b(rgba?|hsla?|oklch|oklab|lch)\('
found=0
for file in $(git ls-files -- '*.css' '*.html' '*.rs' '*.js' '*.mjs' '*.tera' 2>/dev/null); do
  case "$file" in
    share/design/*.css|apps/majordomus-cli/src/web/tokens.css) continue ;;
    */vendor/*|share/cockpit/cockpit.css|node_modules/*) continue ;;
    *.svg|share/cockpit/graph.js) continue ;;
    scripts/lib/ui-contrast.mjs|scripts/lib/ui.test.mjs|scripts/lib/cockpit-probe.mjs) continue ;;
    scripts/ci/design-check|scripts/design-tokens) continue ;;
  esac
  hits="$(grep -nE "$LITERAL" "$file" 2>/dev/null || true)"
  [ -n "$hits" ] || continue
  found=1
  printf '%s\n' "$hits" | while IFS= read -r line; do
    echo "FAIL $file:${line%%:*}  a colour chosen outside share/design/tokens.yaml"
    echo "     ${line#*:}" | sed 's/^[0-9]*://' | sed 's/^[[:space:]]*/     /'
  done
done
if [ "$found" = 1 ]; then
  echo "design-check: a surface declares a colour of its own." >&2
  echo "design-check: name it in share/design/tokens.yaml and use var(--<token>), or, if it" >&2
  echo "design-check: genuinely cannot reach a custom property, say why in this script's" >&2
  echo "design-check: exemptions — with the reason, not the path." >&2
  status=10
fi

echo "== every token a surface reads is a token something declares"
# The bug this exists for: site/graph.js read seven `--mj-graph-*` properties, no stylesheet
# had ever declared one of them, so every lookup returned the empty string and every drawing
# was painted from the fallback table in its own source — under a comment saying the palette
# came from the page. Nothing failed. Nothing could fail: an undeclared custom property is
# the empty string, not an error, and the fallback is right there to make the result look
# deliberate.
#
# Only the `--mj-` namespace is asked. `--tw-`, `--color-`, `--spacing-` and the rest belong
# to Tailwind and are declared by a build, not by this repository; asking about them would
# make this check noisy, and a noisy check is a check nobody reads.
declared="$(git ls-files -- '*.css' | xargs grep -ho -- '--mj-[a-z0-9][a-z0-9-]*[[:space:]]*:' 2>/dev/null \
  | sed 's/[[:space:]]*:$//' | LC_ALL=C sort -u)"
undeclared=0
for file in $(git ls-files -- '*.js' '*.mjs' '*.css' '*.rs' '*.html' '*.tera' 2>/dev/null); do
  case "$file" in */vendor/*|node_modules/*) continue ;; esac
  for token in $(grep -ho -- '--mj-[a-z0-9][a-z0-9-]*' "$file" 2>/dev/null | LC_ALL=C sort -u); do
    printf '%s\n' "$declared" | grep -qx -- "$token" && continue
    echo "FAIL $file  reads $token, which no stylesheet declares"
    undeclared=1
  done
done
if [ "$undeclared" = 1 ]; then
  echo "design-check: a surface reads a token nothing declares. It will read the empty" >&2
  echo "design-check: string for ever, silently, and use whatever fallback stands beside" >&2
  echo "design-check: it. Declare it in share/design/tokens.yaml, or stop reading it." >&2
  status=10
fi

[ "$status" = 0 ] && echo "==> design-check: one declaration, and every surface projects it"
exit "$status"
