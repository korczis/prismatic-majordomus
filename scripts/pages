#!/usr/bin/env bash
# pages — the GitHub Pages fast path: the smallest sequence that turns this commit into
# publishable bytes, and the measurement of it. One command, run the same way by a person and
# by .github/workflows/pages.yml, so there is no GitHub-only build semantics to drift from.
#
#   scripts/pages build [--base-url URL]  the site, without regenerating what is committed
#   scripts/pages check                   every static check over the output, without a second generation
#   scripts/pages fingerprint             the canonical input hash of this tree
#   scripts/pages current                 is site/data/generated current for this tree? (exit 0/10)
#   scripts/pages paths                   the paths a push must touch for the site to be able to change
#   scripts/pages budget [--json]         the controlled budgets, from the model
#   scripts/pages benchmark [-n N] [--write-baseline]
#                                         build and check N times; JSON (milliseconds) on stdout,
#                                         and with --write-baseline into the tracked baseline of
#                                         this platform under .ai/repo/benchmarks/pages/
#   scripts/pages report --timings FILE [--queue N] [--pages-build N] [--end-to-end N]
#                       [--cold] [--advisory]
#                                         the SLO verdict for a run: a Markdown fragment on
#                                         $GITHUB_STEP_SUMMARY (stdout without it), one
#                                         machine-readable `pages-slo` line always, and exit
#                                         10 when the controlled path is over budget.
#                                         --advisory reports a breach as a ::warning and
#                                         exits 0: for the caller that measures a deployment
#                                         which has already happened.
#   scripts/pages built [--branch B] [--commit SHA] [--wait N] [--porcelain]
#                                         GitHub's own "pages build and deployment" of that commit:
#                                         0 built, 10 errored, 12 not determinable (no gh, no token,
#                                         or GitHub has not built it yet)
#   scripts/pages rebuild [--branch B] [--commit SHA]
#                                         ask GitHub to build that commit of the branch again,
#                                         only when its build errored and nothing is building:
#                                         0 requested or none needed, 12 the state unreadable,
#                                         a build in flight, or the request refused
#   scripts/pages evidence [--commit SHA] [--from DIR] [--out FILE] [--ledger-out FILE]
#   scripts/pages published-evidence --bin EXE [--baseline FILE]
#                                         refuse to publish a UI whose evidence report holds more
#                                         `not run` claims than the declared baseline (I2786):
#                                         0 within it, 10 over it, 12 when it cannot be read
#                                         site/data/evidence.json: the CI evidence of that commit
#                                         or its nearest ancestor (the `evidence` artifact, or DIR),
#                                         current, stale with the distance, or unavailable with
#                                         the reason; 0 in all three, 12 when it cannot write
#   scripts/pages checkout [--verify]     the fetch-depth deploy.checkout implies; --verify
#                                         measures this clone instead and exits 10 when it
#                                         cannot decide a ref (shallow, or no tags)
#   scripts/pages verify --url URL --commit SHA [--timeout N] [--quiet] [--smoke]
#                                         poll the public site until it serves that commit;
#                                         --timeout 0 is a single probe. 0 it serves it,
#                                         10 it serves something else, 12 it never answered.
#                                         --smoke then fetches every deploy.smoke route of the
#                                         model and exits 10 naming each one whose marker is
#                                         missing or which does not answer
#   scripts/pages publication --commit SHA --published OUTCOME --served OUTCOME [--url URL]
#                       [--timings FILE]
#                                         state a deployment that has already happened: the summary
#                                         line, the annotation and, when the public site did not
#                                         serve the commit, a `not served` timing row naming what
#                                         it does serve and whether GitHub's build is still
#                                         waiting and since when. Exit 0: a statement, not a gate
#   scripts/pages verify-docs --url URL --commit SHA [--quiet]
#                                         the documentation that commit publishes, as served:
#                                         /docs/index.json names the commit, and every route it
#                                         publishes a kind at answers 200. 0 ok, 10 not,
#                                         12 the index could not be fetched
#   scripts/pages verify-rustdoc [--url URL] --commit SHA [--timeout N]
#                                         poll the public site until the crate's reference it
#                                         composes at the rustdoc surface's mount is that
#                                         commit's and whole: its build.json entry, its
#                                         surface.json, the landing page, the crate index, the
#                                         index's stylesheets and scripts, a module page, the
#                                         search index and the crate's COMMIT constant page.
#                                         One ASCII line per URL probed.
#                                         0 verified, 10 it serves something else, 12 it never
#                                         answered or the probe cannot judge
#   scripts/pages snapshots               what a publication holds that the site build does not
#                                         compose (deploy.snapshots), one tab-separated row
#                                         each: surface, mount, artifact, producer, marker.
#                                         The mount is the topology's. 12 when a declared
#                                         surface has no mount there or the entry is not whole
#   scripts/pages verify-ui [--surface ID] [--url URL] [--commit SHA] [--timeout N] [--max-pages N]
#                                         poll the public site until the UI's snapshot it holds
#                                         at the UI's mount is that commit's and whole: its
#                                         surface.json, the landing page and its banner,
#                                         snapshot.json, and every page snapshot.json lists (at
#                                         most --max-pages of them, spread evenly; how many were
#                                         probed and how many were not is stated, as are the
#                                         pages the snapshot itself left out and what stopped
#                                         it). Without --commit, the commit /build.json names:
#                                         the UI beside the site is the site's. One line per
#                                         document probed, one per page that did not answer.
#                                         A page that answered 503 is asked again first, at
#                                         most MJ_PAGES_RETRIES times (4) with a doubling pause
#                                         from MJ_PAGES_RETRY_SECONDS (1), each retry said.
#                                         0 verified, 10 it is absent, another commit's or not
#                                         whole, 12 it never answered or the probe cannot judge
#   scripts/pages release-live [--url URL] [--window N] [--wait N] [--expect TAG] [--repo SLUG]
#                                         the release the public site offers is the release that
#                                         was published: the homepage's offer (and /build.json),
#                                         /releases/latest.json and GitHub's newest release name
#                                         one version. A disagreement younger than the window
#                                         (deploy.release_window) after GitHub's release is a
#                                         publication in flight; older, or a site offering what
#                                         GitHub has not published, is refused. --wait polls
#                                         until they agree; --expect TAG also requires GitHub's
#                                         newest release to be TAG. 0 one release, or in flight;
#                                         10 they disagree; 12 a reading could not be taken
#
# The model is .ai/repo/ci/pages.yaml. Nothing here carries a path list, a budget or a gate
# name of its own. Exit 0 ok, 2 usage, 10 a refusal or a budget exceeded, 12 something missing.
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MJ_VERSION="pages"; MJ_BIN_DIR="$ROOT/bin"; MJ_LIB_DIR="$ROOT/lib"; export MJ_VERSION MJ_BIN_DIR MJ_LIB_DIR
# shellcheck source=../lib/common.sh
. "$ROOT/lib/common.sh"
MJ_ROOT="$ROOT"; export MJ_ROOT; mj_resolve_layout
command -v jq >/dev/null || { echo "pages: jq is required" >&2; exit 12; }

MODEL="$ROOT/.ai/repo/ci/pages.yaml"
GATES="$ROOT/.ai/repo/ci/gates.yaml"
[ -f "$MODEL" ] || { echo "pages: no publication model at ${MODEL#"$ROOT"/}" >&2; exit 12; }

FLAT="$(mktemp "${TMPDIR:-/tmp}/mj-pages.XXXXXX")"
trap 'rm -f "$FLAT" "${GFLAT:-}"' EXIT
mj_yaml_flatten "$MODEL" > "$FLAT" || { echo "pages: ${MODEL#"$ROOT"/} does not parse" >&2; exit 10; }
[ "$(mj_yget "$FLAT" version)" = 1 ] || { echo "pages: ${MODEL#"$ROOT"/}: version must be 1" >&2; exit 10; }
m() { mj_yget "$FLAT" "$1"; }
ml() { mj_ylist "$FLAT" "$1"; }

OUTPUT="$(m deploy.output)"
IDENTITY="$(m deploy.identity)"

# ---------------------------------------------------------------- timing
# Rows in the shape scripts/ci/summary already renders: "<gate><TAB><step><TAB><seconds>".
# MJ_PAGES_TIMINGS names the file; without it the rows go nowhere and nothing is measured.
row() { [ -n "${MJ_PAGES_TIMINGS:-}" ] && printf 'pages\t%s\t%s\n' "$1" "$2" >> "$MJ_PAGES_TIMINGS"; return 0; }
now() { date +%s; }
# milliseconds, from the tool's own clock: a phase that takes under a second is still a phase,
# and a benchmark that can only see whole seconds cannot tell 40 ms from 900
now_ms() { MJ_TIMING=1 mj_ms; }
timed() { local step="$1" t0; shift; t0="$(now)"; "$@"; local rc=$?; row "$step" "$(( $(now) - t0 ))"; return "$rc"; }

# ---------------------------------------------------------------- fingerprint
# The canonical input hash: what generate-site-data writes into source.json as source_hash,
# computed over the same list in one hashing process. `current` compares it with the committed
# value, which answers "must this tree be regenerated?" in a fifth of a second rather than in
# the forty-odd seconds a generation costs. The generator remains the only thing that writes
# the data; this only decides whether it has to run.
cmd_fingerprint() { "$ROOT/scripts/generate-site-data" --fingerprint; }

cmd_current() {
  local want have src="$ROOT/$OUTPUT/../data/generated/source.json"
  src="$ROOT/site/data/generated/source.json"
  [ -f "$src" ] || { echo "pages: $src is absent; run scripts/generate-site-data" >&2; return 12; }
  want="$(cmd_fingerprint)"
  have="$(jq -r '.source_hash' "$src")"
  if [ "$want" = "$have" ]; then
    [ -n "${MJ_PAGES_QUIET:-}" ] || printf 'pages: site/data/generated is current for this tree (input hash %s)\n' "${want:0:12}"
    return 0
  fi
  printf 'pages: site/data/generated is stale — it carries input hash %s, this tree hashes to %s\n' "${have:0:12}" "${want:0:12}" >&2
  printf '       the committed derived data is a projection of the tree it was generated from; run\n       scripts/derive and commit the result.\n' >&2
  return 10
}

# The second half of the same question. `scripts/derive` runs two generators over different
# artifacts: stage B, `scripts/generate-site-data`, owns site/data/generated, which is what
# cmd_current above compares; stages A and C, `majordomus generate`, own
# site/data/registry/registry.json and docs/generated/artifacts.*, which it does not. A commit
# that moves a source file and regenerates only the first half satisfied this gate and then
# failed CI on the second, for somebody else to read as staleness they did not cause.
#
# The check is the executable's own `generate --check` rather than a comparison written here:
# the staleness of a generated artifact is defined by the generator, and a second definition
# in shell would be a second answer to the same question — and a weaker one, since it would
# have to guess at what the generator hashes. With the unoptimised build CI uses it costs about
# 5 s (14 s until the changelog stopped asking git once per decision and release), against a
# hook that already spends far longer in `doctor`; test/cases/56 bounds the whole gate.
#
# A repository without the built executable — an adopter's, or a clone before the first build
# — skips it and says so. Skipping loudly is the point: silence here is what this gate is for.
DERIVED_SKIPPED=""
cmd_derived() {
  local cli="$ROOT/bin/majordomus-cli" out rc=0
  if [ ! -x "$cli" ]; then
    printf 'pages: no %s; the registry half of the derived data was not checked\n' "bin/majordomus-cli" >&2
    DERIVED_SKIPPED=1
    return 0
  fi
  out="$(MAJORDOMUS_NO_BUILD=1 "$cli" generate --check 2>&1)" || rc=$?
  case "$rc" in
    0) [ -n "${MJ_PAGES_QUIET:-}" ] || printf 'pages: the registry projections are in sync with this tree\n'
       # What the check kept rather than judged is said even when it passes — a changelog
       # whose release history this object database lacks (I1409): silence would read as a
       # verdict the check never reached.
       printf '%s\n' "$out" | grep -F 'not judged' | sed -E 's/^.*(WARN|INFO) +/pages: /' >&2
       return 0 ;;
    12) printf 'pages: the executable is not built, so the registry half of the derived data was not checked\n' >&2
        DERIVED_SKIPPED=1
        return 0 ;;
  esac
  printf '%s\n' "$out" | grep -v '^20[0-9][0-9]-' >&2
  printf '       the registry records every source file it indexed; a source change moves it, and\n       only `majordomus generate` writes it. Run scripts/derive and commit the result.\n' >&2
  return 10
}

# THE RECORD. `pages current` is the generation check the pre-commit hook runs on every commit,
# and its verdict is recorded at .ai/local/state/generation/check.json, which the preflight's
# `verification.docs` check reads (apps/majordomus-cli/src/environment/preflight.rs,
# GENERATION_RECORD). The record names the *tree* it checked rather than a commit: the hook
# runs before the commit exists, and the index it checks is exactly the tree that commit will
# have, so the preflight compares it with HEAD^{tree}. A working tree that differs from the
# index is not the tree the index names, so it is recorded with no tree, which that check
# calls stale. Recording never changes the gate's verdict: a failure to record is silent.
record_generation() {   # <exit status of the check>
  local rc="$1" outcome tree="" head at record="$ROOT/.ai/local/state/generation/check.json"
  if [ "$rc" != 0 ]; then outcome=fail
  elif [ -n "$DERIVED_SKIPPED" ]; then outcome=partial
  else outcome=pass; fi
  head="$(git -C "$ROOT" rev-parse --verify --quiet HEAD 2>/dev/null)" || head=""
  # --no-optional-locks: a read must not refresh the index under another session's feet.
  if git -C "$ROOT" --no-optional-locks diff --quiet 2>/dev/null; then
    tree="$(git -C "$ROOT" write-tree 2>/dev/null)" || tree=""
  fi
  at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  {
    mkdir -p "$(dirname "$record")" &&
    printf '{"schema":1,"check":"scripts/pages current","commit":"%s","tree":"%s","at":"%s","outcome":"%s"}\n' \
      "$head" "$tree" "$at" "$outcome" > "$record.tmp.$$" &&
    mv "$record.tmp.$$" "$record"
  } 2>/dev/null || rm -f "$record.tmp.$$"
  return 0
}

cmd_current_recorded() {
  local rc=0
  cmd_current "$@" && cmd_derived "$@" || rc=$?
  record_generation "$rc"
  return "$rc"
}

# ---------------------------------------------------------------- build
# No generation. The committed site/data/generated is the canonical projection — the pre-commit
# hook and the `site-build` gate of validate.yml both refuse a tree where it is stale — so the
# fast path establishes that it is current by hash and then renders it. Deleting every cache
# and regenerating from the canonical sources must produce these same bytes; that is what
# `scripts/generate-site-data --check` proves in the full gate.
cmd_build() {
  local base=""
  while [ $# -gt 0 ]; do case "$1" in
    --base-url) base="$2"; shift 2 ;;
    *) echo "pages build: unknown option $1" >&2; exit 2 ;;
  esac; done
  MJ_PAGES_QUIET=1 timed fingerprint cmd_current || return 10
  if [ -n "$base" ]; then timed build "$ROOT/scripts/site-build" --no-data --base-url "$base"
  else timed build "$ROOT/scripts/site-build" --no-data; fi
}

# The static checks over the output, and then the one question none of them asks: is any of
# this the local half of the AI layer? `.ai/local/` holds the prompts a person typed, the
# ledger and the session contexts, and it becomes public the moment the generator reads it.
# The gate is cheap and it is on the publication path deliberately — the fast path is what
# turns a commit into public bytes, so the check that those bytes are not somebody's prompts
# belongs where the bytes are made, not only in a suite that runs beside it.
cmd_check() {
  timed check "$ROOT/scripts/site-check" --no-sync
  # --no-probe: the gate's first question — does planting a file under the local root move the
  # generator's input fingerprint — is a property of the tree, not of this build, and it costs
  # two generations of the fingerprint. It belongs where tree properties are held
  # (test/cases/181_local_is_never_published.sh, which runs it against this checkout) and not
  # on a publication path whose whole budget is 120 seconds. What runs here are the two
  # questions that are about these bytes: no published path under the local root, and no
  # published file that is one of its records. Both are a find away, and on a runner — where
  # the local half is empty, as it is on every fresh clone — the second says so rather than
  # passing silently.
  timed local-check "$ROOT/scripts/ci/local-never-published" --no-probe
}

# ---------------------------------------------------------------- the trigger paths
# Derived, never written twice: the classes of the gate model that name the gate this model
# names are the classes whose paths can change the site. Their pathspecs, plus the extras this
# model declares, are exactly the `paths:` of the Pages workflow.
#
# A class that escalates the whole plan (`gates: full`) is deliberately not one of them. That
# escalation is about how much validation a change to the pipeline deserves, not about what the
# published bytes are derived from: changing scripts/ci-plan or the justfile makes every gate
# run and cannot move a pixel. Publication follows the inputs, and the inputs are named.
cmd_checkout() {
  # The publishing clone's requirement, from deploy.checkout and nowhere else. Without
  # --verify it renders the requirement as the `fetch-depth` actions/checkout must be given,
  # which is what test/cases/97_pages_fast_path.sh holds the workflow to. With --verify it
  # measures the clone this process is running in and refuses one that cannot decide a ref —
  # the declaration proved on every run, rather than trusted because it is written down.
  local history tags
  history="$(m deploy.checkout.history)"
  tags="$(m deploy.checkout.tags)"
  case "$history" in
    full) ;;
    "") echo "pages: ${MODEL#"$ROOT"/} declares no deploy.checkout.history" >&2; return 10 ;;
    *)  echo "pages: deploy.checkout.history: '$history' is not a depth this can render;" \
             "link-check resolves commit links, for which a truncated history is never" \
             "partially sufficient. The only meaningful value is 'full'." >&2; return 10 ;;
  esac
  case "$tags" in
    required|optional) ;;
    *) echo "pages: deploy.checkout.tags: '$tags' is neither required nor optional" >&2; return 10 ;;
  esac

  if [ "${1:-}" != --verify ]; then
    printf '%s\n' 0            # fetch-depth for a full history
    return 0
  fi

  local shallow count bad=0
  shallow="$(git -C "$ROOT" rev-parse --is-shallow-repository 2>/dev/null || echo unknown)"
  count="$(git -C "$ROOT" tag 2>/dev/null | wc -l | tr -d " ")"
  [ "$shallow" = false ] || { echo "pages: the checkout is shallow (is-shallow-repository=$shallow), and deploy.checkout.history is '$history'" >&2; bad=1; }
  if [ "$tags" = required ] && [ "${count:-0}" -eq 0 ]; then
    echo "pages: the checkout carries no tags, and deploy.checkout.tags is 'required'" >&2; bad=1
  fi
  if [ "$bad" = 1 ]; then
    echo "pages: this clone cannot decide a ref, so scripts/site-check must refuse the links" \
         "that resolve against git, and the publication stops. Check out with fetch-depth:" \
         "$(cmd_checkout)." >&2
    return 10
  fi
  echo "pages: checkout ok — full history, $count tag(s); every link that resolves against git is decidable"
}

cmd_paths() {
  [ -f "$GATES" ] || { echo "pages: no gate model at ${GATES#"$ROOT"/}" >&2; return 12; }
  GFLAT="$(mktemp "${TMPDIR:-/tmp}/mj-pages-gates.XXXXXX")"
  mj_yaml_flatten "$GATES" > "$GFLAT" || { echo "pages: ${GATES#"$ROOT"/} does not parse" >&2; return 10; }
  local gate; gate="$(m trigger.gate)"
  awk -F= -v gate="$gate" '
    $1 ~ /^classes\.[0-9]+\.id$/            { split($1, a, "."); id[a[2]] = $2 }
    $1 ~ /^classes\.[0-9]+\.gates\.[0-9]+$/ { split($1, a, "."); if ($2 == gate) want[a[2]] = 1 }
    $1 ~ /^classes\.[0-9]+\.paths\.[0-9]+$/ { split($1, a, "."); p[a[2] "." a[4]] = $2; c[a[2]] = 1 }
    END { for (k in p) { split(k, a, "."); if (a[1] in want) print p[k] } }
  ' "$GFLAT" > "$GFLAT.paths"
  ml trigger.extra >> "$GFLAT.paths"
  LC_ALL=C sort -u "$GFLAT.paths"
  rm -f "$GFLAT.paths"
}

# ---------------------------------------------------------------- budgets
# The warm phases are whatever the model declares, in the order it declares them. A list
# repeated here is a list that drifts from the one the verdict is taken against, which is how
# `fingerprint` and `local-check` came to be summed into `controlled` while no budget named
# them and every job summary printed them with an empty budget cell.
cmd_budget() {
  local rows
  rows="$(awk -F= '$1 ~ /^budget\.warm\./ { k = $1; sub(/^budget\.warm\./, "", k); print k "=" $2 }' "$FLAT")"
  if [ "${1:-}" = --json ]; then
    jq -n --arg w "$rows" --arg c "$(m budget.cold.controlled)" --arg e "$(m budget.end_to_end)" '
      { schema: 1,
        warm: ($w | split("\n") | map(select(length > 0)) | map(split("=") | {key: .[0], value: (.[1] | tonumber)}) | from_entries),
        cold: { controlled: ($c | tonumber) },
        end_to_end: ($e | tonumber) }'
  else
    printf '%s\n' "$rows" | while IFS='=' read -r k v; do printf 'warm  %-14s %s s\n' "$k" "$v"; done
    printf 'cold  %-14s %s s\n' controlled "$(m budget.cold.controlled)"
    printf 'slo   %-14s %s s (push to publicly observable; reported, not enforced)\n' end_to_end "$(m budget.end_to_end)"
  fi
}

# ---------------------------------------------------------------- benchmark
# The controlled build path, repeated. Measured values only: nothing here prints a number it
# did not time, and the JSON is what docs and the site read rather than a figure in prose.
cmd_benchmark() {
  local n=3 write=0
  while [ $# -gt 0 ]; do case "$1" in
    -n|--iterations) n="$2"; shift 2 ;;
    --json) shift ;;
    --write-baseline) write=1; shift ;;
    *) echo "pages benchmark: unknown option $1" >&2; exit 2 ;;
  esac; done
  case "$n" in ''|*[!0-9]*|0) echo "pages benchmark: --iterations must be a positive integer" >&2; exit 2 ;; esac
  local t tmp i b c f
  tmp="$(mktemp "${TMPDIR:-/tmp}/mj-pages-bench.XXXXXX")"
  i=1; while [ "$i" -le "$n" ]; do
    t="$(now_ms)"; MJ_PAGES_QUIET=1 cmd_current >/dev/null 2>&1 || { echo "pages benchmark: the derived data is stale; nothing measured" >&2; rm -f "$tmp"; exit 10; }
    f=$(( $(now_ms) - t ))
    t="$(now_ms)"; "$ROOT/scripts/site-build" --no-data >/dev/null 2>&1 || { echo "pages benchmark: the build failed" >&2; rm -f "$tmp"; exit 10; }
    b=$(( $(now_ms) - t ))
    t="$(now_ms)"; "$ROOT/scripts/site-check" --no-sync >/dev/null 2>&1 || { echo "pages benchmark: the check failed" >&2; rm -f "$tmp"; exit 10; }
    c=$(( $(now_ms) - t ))
    printf '%s\t%s\t%s\n' "$f" "$b" "$c" >> "$tmp"
    printf 'pages benchmark: sample %s/%s — fingerprint %s ms, build %s ms, check %s ms\n' "$i" "$n" "$f" "$b" "$c" >&2
    i=$((i+1))
  done
  # min, median and p90 of each phase and of their sum, over the samples actually taken
  local out
  out="$(jq -Rn --arg samples "$n" --arg routes "$(find "$ROOT/$OUTPUT" -name index.html | wc -l | tr -d ' ')" \
    --arg platform "$(mj_pages_platform)" --rawfile rows "$tmp" '
    def stats(a): (a | sort_by(.)) as $s | { min: $s[0], median: $s[(($s | length) / 2 | floor)],
                                        p90: $s[((($s | length) * 0.9) - 1 | floor | if . < 0 then 0 else . end)],
                                        max: $s[-1] };
    ($rows | split("\n") | map(select(length > 0)) | map(split("\t") | map(tonumber))) as $r
    | { schema: 1, platform: $platform, samples: ($samples | tonumber), routes: ($routes | tonumber),
        unit: "milliseconds",
        fingerprint: stats([$r[][0]]), build: stats([$r[][1]]), check: stats([$r[][2]]),
        controlled: stats([$r[] | add]) }')"
  rm -f "$tmp"
  printf '%s\n' "$out"
  if [ "$write" = 1 ]; then
    mkdir -p "$ROOT/.ai/repo/benchmarks/pages"
    printf '%s\n' "$out" > "$ROOT/.ai/repo/benchmarks/pages/baseline.$(mj_pages_platform).json"
    printf 'pages benchmark: wrote .ai/repo/benchmarks/pages/baseline.%s.json\n' "$(mj_pages_platform)" >&2
  fi
}

# the platform a measurement belongs to: a baseline of one machine says nothing about another,
# so each is a file of its own, named the way the crate's baselines are
mj_pages_platform() {
  case "$(uname -s)" in Darwin) printf 'macos' ;; Linux) printf 'linux' ;; *) printf 'other' ;; esac
  printf -- '-%s' "$(uname -m)"
}

# ---------------------------------------------------------------- the run's verdict
# The timing rows of one deployment against the budgets, as the fragment the workflow appends
# to its job summary. Controlled latency is what can fail; external latency is reported beside
# it and never conflated with it.
#
# Two things this command learned on 2026-09-12, both from the same defect. Between
# 2026-09-11T22:36Z and 2026-09-12T06:38Z the Pages workflow reported `failure` on run after
# run while every one of them pushed gh-pages correctly and the public site served the commit
# each had built. What was red was this command: the controlled path was over budget, this
# exits 10 when it is, and the workflow ran it as an ordinary step AFTER the publish. So a
# measurement of a deployment that had already succeeded became the verdict on the deployment.
#
#   1. A BREACH MUST NAME ITS CAUSE, NOT ONLY ITS SIZE. `controlled` is the sum of the
#      per-phase budgets, so a total over budget has at least one row over its own. `blame`
#      below is that row, and it goes into the annotation and the summary line. Before this,
#      the whole Markdown fragment went to $GITHUB_STEP_SUMMARY and nothing went to the log,
#      so the log of those eleven runs read `Process completed with exit code 10` with no number
#      above it anywhere a reader would look.
#
#   2. A REPORT IS NOT ALWAYS A GATE. `--advisory` keeps every number and makes the breach a
#      ::warning annotation instead of this command's exit status. It is for the one caller
#      that measures work already done; the default is unchanged, so a person running this and
#      any gate that calls it still gets exit 10 on a breach.
cmd_report() {
  local timings="" ext_queue="" ext_pages="" e2e="" cold=0 advisory=0 out
  while [ $# -gt 0 ]; do case "$1" in
    --timings) timings="$2"; shift 2 ;;
    --queue) ext_queue="$2"; shift 2 ;;
    --pages-build) ext_pages="$2"; shift 2 ;;
    --end-to-end) e2e="$2"; shift 2 ;;
    --cold) cold=1; shift ;;
    --advisory) advisory=1; shift ;;
    *) echo "pages report: unknown option $1" >&2; exit 2 ;;
  esac; done
  [ -n "$timings" ] && [ -s "$timings" ] || { echo "pages report: --timings names no rows" >&2; exit 2; }
  local controlled budget verdict rc=0 blame=""
  controlled="$(awk -F'\t' '{ s += $3 } END { print s + 0 }' "$timings")"
  if [ "$cold" = 1 ]; then budget="$(m budget.cold.controlled)"; else budget="$(m budget.warm.controlled)"; fi
  if [ "$controlled" -le "$budget" ]; then verdict="PASS"; else verdict="OVER BUDGET"; rc=10; fi
  # which phases are over their own budget: the place to look, rather than a number to argue
  # with. A row the model declares no budget for is skipped rather than guessed at.
  blame="$(awk -F'\t' '{ print $2 "\t" $3 }' "$timings" | while IFS="$(printf '\t')" read -r step secs; do
    b="$(m "budget.warm.$step")"
    case "$b" in ''|*[!0-9]*) continue ;; esac
    case "$secs" in ''|*[!0-9]*) continue ;; esac
    [ "$secs" -gt "$b" ] && printf '%s %ss/%ss; ' "$step" "$secs" "$b"
    :
  done)"
  blame="${blame%; }"
  out="${GITHUB_STEP_SUMMARY:-/dev/stdout}"
  {
    printf '### Pages fast path\n\n'
    printf '| phase | seconds | budget |\n|---|---:|---:|\n'
    awk -F'\t' -v mm="$FLAT" '{ print $2 "\t" $3 }' "$timings" | while IFS="$(printf '\t')" read -r step secs; do
      printf '| %s | %s | %s |\n' "$step" "$secs" "$(m "budget.warm.$step" || true)"
    done
    printf '| **controlled** | **%s** | **%s** |\n\n' "$controlled" "$budget"
    printf '| external (not budgeted) | seconds |\n|---|---:|\n'
    printf '| Actions queue and runner start | %s |\n' "${ext_queue:-not measured}"
    printf '| GitHub pages build and deployment | %s |\n\n' "${ext_pages:-not measured}"
    printf 'Pages SLO: **%s** — controlled path %s s / %s s' "$verdict" "$controlled" "$budget"
    [ -n "$e2e" ] && printf ', push to public %s s / %s s' "$e2e" "$(m budget.end_to_end)"
    printf '\n'
    [ -n "$blame" ] && printf '\nOver its own budget: %s\n' "$blame"
    if [ "$rc" != 0 ] && [ "$advisory" = 1 ]; then
      printf '\nThis is the latency of the publication path, not whether the site published:\nthe run states that separately, and a breach here is a warning rather than this\nrun'"'"'s verdict. `scripts/pages report` without `--advisory` still exits 10.\n'
    fi
    if [ -n "$e2e" ] && [ "$e2e" -gt "$(m budget.end_to_end)" ] && [ "$rc" = 0 ]; then
      printf '\nThe end-to-end target was not met while the controlled path was inside its budget: the\nremainder is the Actions queue and GitHub'"'"'s own Pages build, which this repository does not\nspend. That is an external limit, not a regression here.\n'
    fi
  } >> "$out"
  # One line for a reader that is not a person, always, and on the log rather than in the job
  # summary: the Markdown above is invisible to `gh run view --log`, which is where the four
  # red runs of 2026-09-12 were read from.
  printf 'pages-slo verdict=%s controlled=%s budget=%s over=%s\n' \
    "$verdict" "$controlled" "$budget" "${blame:-none}"
  if [ -n "${GITHUB_OUTPUT:-}" ]; then
    { printf 'verdict=%s\n' "$verdict"
      printf 'controlled=%s\n' "$controlled"
      printf 'budget=%s\n' "$budget"
      printf 'over=%s\n' "$blame"
    } >> "$GITHUB_OUTPUT"
  fi
  if [ "$rc" != 0 ] && [ "$advisory" = 1 ]; then
    printf '::warning title=Pages controlled path over budget::controlled path %s s against a budget of %s s (%s). This is the latency of the publication path, not whether the site published — see the publication state annotation for that.\n' \
      "$controlled" "$budget" "${blame:-no single phase over its own budget}"
    rc=0
  fi
  return "$rc"
}

# ---------------------------------------------------------------- public verification
# Workflow success is not publication. The site serves its own identity at deploy.identity —
# the commit it was built from — so the moment that file names this commit is the moment the
# deployment is publicly observable, measured from outside with the cache defeated.
#
# Two failures, told apart deliberately. A site that answers and names another commit has not
# published this one — a refusal, exit 10. A site that never answered at all was not measured,
# and saying "it still serves nothing" about a laptop with no network is a verdict the run did
# not earn — exit 12, the code this script already reserves for something missing. The
# obligation validator, which is the second caller this command has ever had, depends on that
# distinction: one is work that is not published, the other is a check that could not be made.
#
# `--timeout 0` is a single probe, because the loop reads the site before it looks at the
# clock — that is what makes this affordable inside a validator. Each probe is bounded by
# --max-time, so an unreachable host costs a known number of seconds instead of curl's
# default of waiting for a connection that will never open.
cmd_verify() {
  local url="" commit="" timeout=180 quiet=0 smoke=0 t0 waited served body reached=0
  local built_status="" built_reading="" built_since="" branch_tip=""
  while [ $# -gt 0 ]; do case "$1" in
    --url) url="$2"; shift 2 ;;
    --commit) commit="$2"; shift 2 ;;
    --timeout) timeout="$2"; shift 2 ;;
    --quiet) quiet=1; shift ;;
    --smoke) smoke=1; shift ;;
    *) echo "pages verify: unknown option $1" >&2; exit 2 ;;
  esac; done
  [ -n "$url" ] || url="$(sed -n 's/^base_url = "\(.*\)"/\1/p' "$ROOT/site/config.toml")"
  [ -n "$commit" ] || commit="$(git -C "$ROOT" rev-parse HEAD)"
  # A prefix names a commit only when it is long enough to name one: `b` is an abbreviation
  # of nothing and must not pass for everything. Seven is git's own default abbreviation and
  # the floor it will resolve, so it is the floor here, and anything shorter or not a sha at
  # all is a usage error rather than a verdict nobody meant.
  case "$commit" in
    *[!0-9a-fA-F]*) echo "pages verify: --commit takes a commit sha, not '$commit'" >&2; exit 2 ;;
  esac
  [ "${#commit}" -ge 7 ] || {
    echo "pages verify: --commit $commit is too short to name a commit; use seven characters or more" >&2
    exit 2; }
  command -v curl >/dev/null || { echo "pages verify: curl is required" >&2; return 12; }
  branch_tip="$(git -C "$ROOT" rev-parse --short origin/gh-pages 2>/dev/null || echo gh-pages)"
  t0="$(now)"
  while :; do
    body="$(curl -fsSL --max-time "${MJ_PAGES_PROBE_SECONDS:-10}" -H 'Cache-Control: no-cache' "${url%/}/$IDENTITY?t=$(now)" 2>/dev/null || true)"
    if [ -n "$body" ]; then
      reached=1
      served="$(printf '%s' "$body" | jq -r '.commit // empty' 2>/dev/null || true)"
    else
      served=""
    fi
    # The site states the full forty characters; a caller states the commit however it has
    # it, and the shortest way to have it is to read it off a gh-pages subject. So the
    # served value is matched as beginning with the one asked for, which is what
    # `scripts/ci/pages-check` already does with this same pair. An exact compare answers
    # "still serves beaee8654..., not beaee8654" — the two strings it prints agree — and
    # spends the whole timeout before saying it.
    if [ -n "$served" ] && [ "${served#"$commit"}" != "$served" ]; then
      waited=$(( $(now) - t0 ))
      [ "$quiet" = 1 ] || printf 'pages verify: %s serves %s after %s s\n' "${url%/}/$IDENTITY" "${commit:0:12}" "$waited"
      printf '%s\n' "$waited" > "${MJ_PAGES_WAITED:-/dev/null}"
      [ "$smoke" = 1 ] || return 0
      # The identity says which commit is served; it does not say that the pages a visitor is
      # sent to answer and carry what they are for. The same public bytes are asked that too,
      # route by route, and every miss is named rather than only the first.
      local i=0 route marker page missing=0 asked=0
      while route="$(m "deploy.smoke.$i.route")"; [ -n "$route" ]; do
        marker="$(m "deploy.smoke.$i.marker")"; asked=$((asked + 1))
        page="$(curl -fsSL --max-time "${MJ_PAGES_PROBE_SECONDS:-10}" -H 'Cache-Control: no-cache' "${url%/}$route?t=$(now)" 2>/dev/null || true)"
        if [ -z "$page" ]; then
          printf 'pages verify: smoke %s did not answer\n' "${url%/}$route" >&2; missing=$((missing + 1))
        elif ! printf '%s' "$page" | grep -qF -- "$marker"; then
          printf 'pages verify: smoke %s does not carry %s\n' "${url%/}$route" "$marker" >&2; missing=$((missing + 1))
        fi
        i=$((i + 1))
      done
      [ "$asked" -gt 0 ] || { echo "pages verify: --smoke, and ${MODEL#"$ROOT"/} declares no deploy.smoke route; nothing was asked" >&2; return 10; }
      [ "$missing" = 0 ] || return 10
      [ "$quiet" = 1 ] || printf 'pages verify: smoke %s route check(s) answered with their markers\n' "$asked"
      return 0
    fi
    [ $(( $(now) - t0 )) -lt "$timeout" ] || {
      if [ "$reached" = 0 ]; then
        printf 'pages verify: %s could not be reached within %s s; publication was not measured\n' "${url%/}/$IDENTITY" "$timeout" >&2
        return 12
      fi
      # A timeout is not yet a verdict about the deploy. Publishing is two steps owned by two
      # parties, and this probe watches only the second one's output: the site still serving an
      # older commit means "GitHub has not finished" and "the publication failed" equally well,
      # and until 2026-09-15 this said the second in both cases. A reader then had to leave the
      # tool and ask the API to tell a slow success from a failure — which is what happened at
      # 01:05 that morning, with the build in progress and this reporting exit 10.
      #
      # So the state that is unknown is read rather than assumed, from the one place that knows:
      # `pages built`, which reads GitHub's own build of the branch this deploy pushed.
      built_reading="$(cmd_built --porcelain 2>/dev/null | head -1 || true)"
      built_status="$(printf '%s' "$built_reading" | cut -f1)"
      built_since="$(printf '%s' "$built_reading" | cut -f4)"
      case "$built_status" in
        building|queued)
          printf 'pages verify: after %s s %s still serves %s, and GitHub is %s its build of %s%s: the publication is in flight, not failed. This is not a verdict — ask again, or raise --timeout\n' \
            "$timeout" "${url%/}/$IDENTITY" "${served:-no commit}" "$built_status" "$branch_tip" "${built_since:+ (since $built_since)}" >&2
          return 12 ;;
        errored)
          printf 'pages verify: after %s s %s still serves %s, and GitHub\x27s own build of %s errored: the branch was pushed and the bytes were never served\n' \
            "$timeout" "${url%/}/$IDENTITY" "${served:-no commit}" "$branch_tip" >&2
          return 10 ;;
      esac
      printf 'pages verify: after %s s %s still serves %s, not %s\n' "$timeout" "${url%/}/$IDENTITY" "${served:-no commit}" "${commit:0:12}" >&2
      return 10; }
    sleep 2
  done
}

# ---------------------------------------------------------------- the documentation, as served
# `verify` proves the site serves a commit; this proves that commit's documentation is there.
# It reads /docs/index.json — which the build writes from the pages it published — and asks the
# public site for the documentation root, every route the catalogue publishes a kind at, one
# page of every kind published a page per object, and the machine-readable documents. Nothing
# here lists a route: a kind added to site/data/publication.toml is probed because it was added.
# Exit 0 every probe answered 200, 10 the index is not one, names another commit or a probe
# failed, 12 the index could not be fetched at all.
cmd_verify_docs() {
  local url="" commit="" quiet=0 ix served routes r code bad=0 n=0
  while [ $# -gt 0 ]; do case "$1" in
    --url) url="$2"; shift 2 ;;
    --commit) commit="$2"; shift 2 ;;
    --quiet) quiet=1; shift ;;
    *) echo "pages verify-docs: unknown option $1" >&2; exit 2 ;;
  esac; done
  [ -n "$url" ] || url="$(sed -n 's/^base_url = "\(.*\)"/\1/p' "$ROOT/site/config.toml")"
  [ -n "$commit" ] || commit="$(git -C "$ROOT" rev-parse HEAD)"
  case "$commit" in *[!0-9a-fA-F]*|"") echo "pages verify-docs: --commit takes a commit sha, not '$commit'" >&2; exit 2 ;; esac
  [ "${#commit}" -ge 7 ] || { echo "pages verify-docs: --commit $commit is too short to name a commit" >&2; exit 2; }
  command -v curl >/dev/null || { echo "pages verify-docs: curl is required" >&2; return 12; }
  url="${url%/}"
  # The index lists every page, so it is the one large document here (half a megabyte at
  # 1283 pages): it gets a bound of its own. And not reading it is not the same finding as
  # reading something else — a fetch that ran past its bound once reported itself as "not a
  # documentation index" and sent the reader looking at a file that was fine.
  local fetched=0
  ix="$(curl -fsSL --max-time "${MJ_PAGES_INDEX_SECONDS:-60}" -H 'Cache-Control: no-cache' "$url/docs/index.json?t=$(now)" 2>/dev/null)" && fetched=1
  [ "$fetched" = 1 ] || {
    echo "pages verify-docs: $url/docs/index.json could not be fetched within ${MJ_PAGES_INDEX_SECONDS:-60} s; the documentation was not measured" >&2; return 12; }
  printf '%s' "$ix" | jq -e '.schema == 1 and (.pages | length > 0)' >/dev/null 2>&1 || {
    echo "pages verify-docs: $url/docs/index.json answered, and what it serves is not a documentation index" >&2; return 10; }
  served="$(printf '%s' "$ix" | jq -r '.build.commit // empty')"
  [ -n "$served" ] && [ "${served#"$commit"}" != "$served" ] || {
    echo "pages verify-docs: $url/docs/index.json was built from ${served:-no commit}, not ${commit:0:12}" >&2; return 10; }
  routes="$(printf '%s' "$ix" | jq -r '. as $ix
    | ["/docs/", "/openapi.json", "/build.json"]
    + [$ix.kinds[] | .route | select(. != null)]
    + [$ix.kinds[] | select(.projection == "entity") | .kind as $k
       | first($ix.pages[] | select(.kind == $k)) | .route]
    | unique[]' 2>/dev/null)"
  for r in $routes; do
    n=$((n + 1))
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time "${MJ_PAGES_PROBE_SECONDS:-10}" -H 'Cache-Control: no-cache' "$url$r" || true)"
    if [ "$code" = 200 ]; then [ "$quiet" = 1 ] || printf '  200  %s%s\n' "$url" "$r"
    else printf 'pages verify-docs: %s%s answered %s\n' "$url" "$r" "${code:-nothing}" >&2; bad=$((bad + 1)); fi
  done
  # the documentation root is the hub, not an older page at the same address
  curl -fsSL --max-time "${MJ_PAGES_PROBE_SECONDS:-10}" "$url/docs/?t=$(now)" 2>/dev/null | grep -q 'data-docs-search' || {
    echo "pages verify-docs: $url/docs/ does not carry the documentation hub" >&2; bad=$((bad + 1)); }
  [ "$bad" = 0 ] || return 10
  [ "$quiet" = 1 ] || printf 'pages verify-docs: %s serves the documentation of %s: %s route(s), %s page(s) indexed\n' \
    "$url" "${commit:0:12}" "$n" "$(printf '%s' "$ix" | jq -r '.pages | length')"
}

# ---------------------------------------------------------------- dispatch
# ---------------------------------------------------------------- GitHub's own build
# Publishing is two steps owned by two parties. This repository pushes gh-pages; GitHub's own
# "pages build and deployment" turns that branch into the bytes a reader gets. The second can
# fail on a branch that was pushed perfectly, and when it does every signal this repository
# owns is green: the workflow succeeded, the branch carries the right tree, `git log` on
# gh-pages is exactly what it should be, and the public site is a commit behind.
#
# That is not hypothetical. On 2026-09-10 at 17:35:10Z GitHub's build of gh-pages commit
# dfd9c989c errored with "Page build failed."; the site served the previous commit for 27
# minutes and nothing anywhere went red. It is still readable from the API today:
#
#   gh api repos/korczis/prismatic-majordomus/pages/builds --jq '.[0]'
#
# So the status is read rather than inferred from the symptom, and it is read in exactly one
# place: here. `scripts/ci/pages-check` asked the same API in its own words until this command
# existed, and .github/workflows/pages.yml could not ask at all — which is why the one silent
# mode of the three was the one that leaves a green tick. Two readers, one definition.
#
# Exit is the judgement, not the reading: 0 the build of that commit succeeded, 10 it errored,
# 12 it could not be determined — no gh, no `pages: read`, or GitHub has not built that commit
# yet when the wait ran out. 12 is never an `ok`: a build still in flight is weather and a
# caller must be free to treat it as such, but it must not be able to mistake it for success.
cmd_built() {
  local branch="gh-pages" commit="" wait=0 porcelain=0 slug="" build="" all="" newest="" t0 status bcommit berror bsince
  while [ $# -gt 0 ]; do case "$1" in
    --branch) branch="$2"; shift 2 ;;
    --commit) commit="$2"; shift 2 ;;
    --wait) wait="$2"; shift 2 ;;
    --porcelain) porcelain=1; shift ;;
    *) echo "pages built: unknown option $1" >&2; exit 2 ;;
  esac; done
  command -v gh >/dev/null 2>&1 || {
    [ "$porcelain" = 1 ] && printf 'unreadable\t\tgh is not installed\n'
    [ "$porcelain" = 1 ] || echo "pages built: gh is not installed, so GitHub's own build was not read" >&2
    return 12; }
  slug="${GITHUB_REPOSITORY:-}"
  [ -n "$slug" ] || slug="$(git -C "$ROOT" remote get-url origin 2>/dev/null | sed -n 's|.*[:/]\([^/][^/]*/[^/][^/]*\)$|\1|p' | sed 's|\.git$||')"
  [ -n "$slug" ] || { echo "pages built: no repository slug (no GITHUB_REPOSITORY, no origin)" >&2; return 12; }
  if [ -z "$commit" ]; then
    git -C "$ROOT" fetch -q origin "$branch" 2>/dev/null || true
    commit="$(git -C "$ROOT" rev-parse "origin/$branch" 2>/dev/null || git -C "$ROOT" rev-parse "$branch" 2>/dev/null || true)"
  fi
  [ -n "$commit" ] || { echo "pages built: no commit to ask about (branch $branch is not here)" >&2; return 12; }
  t0="$(now)"
  while :; do
    # The newest build OF THAT COMMIT, not merely the newest build. A commit can be built
    # more than once (a re-run, a dispatch), and asking only for `.[0]` makes every question
    # about anything but the very last push unanswerable — including the one a person asks
    # when they come back to an incident: was the build of dfd9c989c the thing that broke?
    # The list is newest-first, so the first match is the newest build of it; `newest` is
    # kept beside it so that "GitHub has not built this at all yet" can say what it HAS built.
    all="$(gh api "repos/$slug/pages/builds" --jq '.[] | "\(.status)\t\(.commit)\t\(.error.message // "no message")\t\(.created_at // "")"' 2>/dev/null || true)"
    newest="$(printf '%s\n' "$all" | head -1)"
    build="$(printf '%s\n' "$all" | awk -F'\t' -v c="$commit" '$2 == c { print; exit }')"
    [ -n "$build" ] || build="$newest"
    status="$(printf '%s' "$build" | cut -f1)"
    bcommit="$(printf '%s' "$build" | cut -f2)"
    berror="$(printf '%s' "$build" | cut -f3)"
    bsince="$(printf '%s' "$build" | cut -f4)"
    if [ -n "$build" ] && [ "$bcommit" = "$commit" ] && [ "$status" != building ] && [ "$status" != queued ]; then
      break
    fi
    [ $(( $(now) - t0 )) -lt "$wait" ] || break
    sleep 10
  done
  if [ -z "$build" ]; then
    [ "$porcelain" = 1 ] && printf 'unreadable\t\tno token, or no pages:read\n'
    [ "$porcelain" = 1 ] || echo "pages built: GitHub's Pages build for $slug could not be read (no token, or no pages:read)" >&2
    return 12
  fi
  if [ "$porcelain" = 1 ]; then printf '%s\t%s\t%s\t%s\n' "$status" "$bcommit" "$berror" "$bsince"; fi
  if [ "$bcommit" != "$commit" ]; then
    [ "$porcelain" = 1 ] || printf "pages built: GitHub's newest build is of %s (%s), not %s of %s\n" "${bcommit:0:12}" "$status" "${commit:0:12}" "$branch" >&2
    return 12
  fi
  case "$status" in
    built)
      [ "$porcelain" = 1 ] || printf "pages built: GitHub's own build of %s is built\n" "${commit:0:12}"
      return 0 ;;
    errored)
      [ "$porcelain" = 1 ] || {
        printf "pages built: GitHub's own build of %s ERRORED: %s\n" "${commit:0:12}" "$berror" >&2
        printf "             the branch is right and the site is not: this is GitHub's builder, not\n             this repository. Ask for the build again with: scripts/pages rebuild\n" >&2; }
      return 10 ;;
    *)
      [ "$porcelain" = 1 ] || printf "pages built: GitHub's build of %s is %s; not a verdict\n" "${commit:0:12}" "$status" >&2
      return 12 ;;
  esac
}

# ---------------------------------------------------------------- evidence
# The dataset the site's evidence section renders: the newest evidence CI gathered
# (scripts/ci/evidence-collect, the `evidence` artifact of validate.yml) for this commit or for
# its nearest ancestor that has any. It is an input of one deployment, like data/build.json, and
# it is never a gate on publishing. What it may never do is claim a currency it cannot back. The
# report it carries is the tracked ledger's verdict at the run's commit; the run only confirms
# it or not. So it is `current` only when the run is of this very commit, measured clean trees,
# derived the report on a clean checkout, and nothing was absent, refused or failed; `stale`
# for an ancestor's run, naming how many commits and changed files lie between, or for a run
# that recorded a failure; `unknown`, with every reason, when the run cannot confirm the
# report; and no evidence at all is published as unavailable, with the reason. ADR 68, as
# ADR 0087 amends it; the reasons withhold `current` and never change the report.
cmd_evidence() {
  local commit="" from="" out="$ROOT/site/data/evidence.json" ledger_out="" slug="" tmp="" aid="" sha="" best=""
  local m ecommit behind changed repo_url cov_json cov_txt report_txt state reasons
  while [ $# -gt 0 ]; do case "$1" in
    --commit) commit="$2"; shift 2 ;;
    --from) from="$2"; shift 2 ;;
    --out) out="$2"; shift 2 ;;
    --ledger-out) ledger_out="$2"; shift 2 ;;
    *) echo "pages evidence: unknown option $1" >&2; exit 2 ;;
  esac; done
  [ -n "$commit" ] || commit="HEAD"
  commit="$(git -C "$ROOT" rev-parse --verify --quiet "$commit^{commit}")" || { echo "pages evidence: that is not a commit of this repository" >&2; exit 2; }
  evidence_unavailable() {
    jq -n --arg published "$commit" --arg reason "$1" \
      '{schema: 1, available: false, published_commit: $published, reason: $reason}' > "$out" \
      || { echo "pages evidence: could not write $out" >&2; exit 12; }
    echo "pages evidence: unavailable: $1"
  }
  if [ -z "$from" ]; then
    command -v gh >/dev/null 2>&1 || { evidence_unavailable "gh is not installed, so no CI evidence was fetched"; return 0; }
    slug="${GITHUB_REPOSITORY:-}"
    [ -n "$slug" ] || slug="$(git -C "$ROOT" remote get-url origin 2>/dev/null | sed -n 's|.*[:/]\([^/][^/]*/[^/][^/]*\)$|\1|p' | sed 's|\.git$||')"
    [ -n "$slug" ] || { evidence_unavailable "no repository slug to ask for CI evidence"; return 0; }
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/mj-evidence.XXXXXX")"
    gh api "repos/$slug/actions/artifacts?name=evidence&per_page=100" \
      --jq '.artifacts[] | select(.expired | not) | select(.workflow_run.head_branch == "master") | "\(.id)\t\(.workflow_run.head_sha)"' \
      > "$tmp/list" 2>/dev/null || { evidence_unavailable "the CI artifacts of $slug could not be listed"; return 0; }
    # The nearest ancestor, not the newest upload: runs finish out of order, and the evidence of
    # an older commit uploaded last would otherwise stand in for a nearer one.
    while IFS=$'\t' read -r aid sha; do
      [ -n "$sha" ] || continue
      git -C "$ROOT" merge-base --is-ancestor "$sha" "$commit" 2>/dev/null || continue
      printf '%s\t%s\n' "$(git -C "$ROOT" rev-list --count "$sha")" "$aid"
    done < "$tmp/list" | LC_ALL=C sort -t "$(printf '\t')" -k1,1nr > "$tmp/candidates"
    best="$(head -1 "$tmp/candidates" | cut -f2)"
    [ -n "$best" ] || { evidence_unavailable "no evidence artifact of master's validation is recorded against this commit or a retained ancestor"; return 0; }
    gh api "repos/$slug/actions/artifacts/$best/zip" > "$tmp/evidence.zip" 2>/dev/null \
      && mkdir -p "$tmp/evidence" && unzip -qo "$tmp/evidence.zip" -d "$tmp/evidence" >/dev/null 2>&1 \
      || { evidence_unavailable "the evidence artifact $best could not be downloaded"; return 0; }
    from="$tmp/evidence"
  fi
  m="$from/manifest.json"
  jq -e '.schema == 1 and (.commit | type == "string")' "$m" >/dev/null 2>&1 \
    || { evidence_unavailable "the evidence manifest is absent or not one this build reads"; return 0; }
  ecommit="$(jq -r .commit "$m")"
  git -C "$ROOT" merge-base --is-ancestor "$ecommit" "$commit" 2>/dev/null \
    || { evidence_unavailable "the evidence was recorded against ${ecommit:0:12}, which is not in the history of the commit being published"; return 0; }
  # The ledger the run recorded, for a reader that judges evidence itself: the UI snapshot
  # (I2786). Only an artifact of this commit's history reaches here, and the rows it carries
  # name the commit they ran at, so a row of an ancestor reads as stale, never as current.
  # Unavailable evidence copies nothing: the reader keeps the tracked ledger, and the
  # published-evidence check below is what refuses what that would publish.
  if [ -n "$ledger_out" ]; then
    [ -f "$from/ledger.json" ] && jq -e '.executions | type == "array"' "$from/ledger.json" >/dev/null 2>&1 \
      || { echo "pages evidence: the artifact carries no ledger this build reads; $ledger_out is left as it was" >&2; ledger_out=""; }
    if [ -n "$ledger_out" ]; then
      cp "$from/ledger.json" "$ledger_out" || { echo "pages evidence: could not write $ledger_out" >&2; exit 12; }
      echo "pages evidence: the ledger of ${ecommit:0:12}'s run ($(jq '.executions | length' "$ledger_out") executions) is $ledger_out"
    fi
  fi
  behind="$(git -C "$ROOT" rev-list --count "$ecommit..$commit")"
  changed="$(git -C "$ROOT" diff --name-only "$ecommit" "$commit" | wc -l | tr -d ' ')"
  repo_url="$(jq -r '.repository_url // empty' "$ROOT/site/data/generated/project.json" 2>/dev/null || true)"
  report_txt="$from/report.txt"; [ -f "$report_txt" ] || report_txt=/dev/null
  cov_txt="$from/coverage.txt"; [ -f "$cov_txt" ] || cov_txt=/dev/null
  cov_json="$from/coverage.json"; [ -f "$cov_json" ] || cov_json=/dev/null
  jq -n --arg published "$commit" --argjson behind "$behind" --argjson changed "$changed" --arg repo "$repo_url" \
    --slurpfile m "$m" --slurpfile cov "$cov_json" --rawfile report "$report_txt" --rawfile coverage "$cov_txt" '
    $m[0] as $man
    # What the run cannot confirm about the report it carries. Each reason only withholds
    # `current`; none of them changes the report. A manifest written before the run measured
    # its trees has no such key, and reads as not measured. A report the collector failed to
    # derive, or one that did not reach the artifact, is nothing to confirm.
    | ([($man.totals.outcomes // {}) | (.fail // 0), (.timeout // 0), (.error // 0)] | add) as $failed
    | ([($man.panels // [])[] | select(.label == "evidence")] | .[0]) as $ep
    | [
        (if $ep == null then "The run names no report."
         elif $ep.exit != 0 then "The report could not be derived: \($ep.command) exited \($ep.exit // "without a status")."
         elif ($report | test("\\S") | not) then "The run carries no report text, so there is nothing to confirm."
         else empty end),
        (if $man.working_tree == "clean" then empty
         elif $man.working_tree == "dirty" then "A job that ran tests ran them in a dirty tree."
         else "Not every job that ran tests measured the tree it ran them in." end),
        (if $man.report_tree == "clean" then empty
         elif $man.report_tree == "dirty" then "The report was derived in a dirty checkout."
         else "The checkout the report was derived in was not measured." end),
        (($man.refused // []) | if length > 0
          then "The run refused the report of " + (map(.runner) | join(", ")) + ", measured at another commit."
          else empty end),
        (($man.absent // []) | if length > 0 then "The run has no report from " + join(", ") + "." else empty end),
        (if $failed > 0 then "The run recorded \($failed) failed, timed-out or errored execution(s)." else empty end)
      ] as $unconfirmed
    | (if $man.commit == $published and ($unconfirmed | length) == 0 then "current"
       elif $man.commit != $published or $failed > 0 then "stale"
       else "unknown" end) as $state
    | {
        schema: 1,
        available: true,
        published_commit: $published,
        commit: $man.commit,
        commit_url: (if $repo != "" then $repo + "/commit/" + $man.commit else null end),
        state: $state,
        current: ($state == "current"),
        unconfirmed: $unconfirmed,
        behind: $behind,
        changed: $changed,
        produced_at: $man.produced_at,
        run: $man.run,
        absent: $man.absent,
        totals: $man.totals,
        coverage: (if ($cov | length) == 0 then null else ($cov[0] | {crate, domain: (.domain | {lines, functions, regions})}) end),
        panels: [
          $man.panels[] | . as $p
          | {label, command, exit, what,
             output: (if $p.file == "report.txt" then $report elif $p.file == "coverage.txt" then $coverage else "" end),
             links: [
               (if $man.run then {label: "the run that recorded it", href: $man.run.url} else empty end),
               (if $repo != "" then {label: ("commit " + $man.commit[0:12]), href: ($repo + "/commit/" + $man.commit)} else empty end)
             ]}
        ]
      }' > "$out" || { echo "pages evidence: could not write $out" >&2; exit 12; }
  state="$(jq -r .state "$out")"
  reasons="$(jq -r '.unconfirmed | join(" ")' "$out")"
  if [ "$state" = current ]; then
    echo "pages evidence: current: the run of ${commit:0:12} confirms the report it carries"
  elif [ "$behind" != 0 ]; then
    echo "pages evidence: stale: recorded against ${ecommit:0:12}, $behind commit(s) and $changed changed file(s) behind ${commit:0:12}${reasons:+. $reasons}"
  elif [ "$state" = stale ]; then
    echo "pages evidence: stale: the run of ${commit:0:12} recorded failures, so it does not confirm the report it carries. $reasons"
  else
    echo "pages evidence: unknown: the run of ${commit:0:12} cannot confirm the report it carries. $reasons"
  fi
}

# ---------------------------------------------------------------- the crate's reference, public
# `verify` proves the site serves this commit's /build.json, and that is all it proves: a build
# that composed a stale reference, a deploy that lost half of one, or a CDN that still answers
# the old stylesheet all leave it green. The crate's rustdoc is a surface of its own composed
# into the site (ADR 0086), with its own declaration and its own assets, so it is verified the
# way a reader meets it rather than by the identity file alone.
#
# In order, each URL cache-busted as `verify` busts it (?t=): /build.json names the commit the
# rustdoc surface was built from; the surface's own surface.json names it too; the landing page
# answers HTML and carries the commit; the crate's index is rustdoc's page for the crate (the
# generator meta, the title rustdoc writes); every stylesheet and script that index references
# under static.files answers with its content type; the first module the index links, in
# sorted order, answers as that module's page; and the search index the page's rustdoc-vars
# point at answers; and the page of the crate's COMMIT constant, the build's own statement of
# its commit, names the same commit as built_from. The mount is the topology's
# (docs/generated/web.json) and the crate is the manifest's [lib], so nothing here is a second
# declaration of either.
#
# A commit prefix counts as `verify` counts it: seven characters or more, matched as the start
# of what the site states. The same two failures as `verify`, told apart the same way: a site
# that answered and served something else is 10; a site that never answered, or a probe that
# cannot judge, is 12. It polls until --timeout, and prints the URLs of the round that decided.
cmd_verify_rustdoc() {
  local url="" commit="" timeout=180 t0 rc round=0 mount crate
  while [ $# -gt 0 ]; do case "$1" in
    --url) url="$2"; shift 2 ;;
    --commit) commit="$2"; shift 2 ;;
    --timeout) timeout="$2"; shift 2 ;;
    *) echo "pages verify-rustdoc: unknown option $1" >&2; exit 2 ;;
  esac; done
  [ -n "$commit" ] || { echo "pages verify-rustdoc: --commit SHA is required" >&2; exit 2; }
  case "$commit" in *[!0-9a-fA-F]*) echo "pages verify-rustdoc: --commit takes a commit sha, not '$commit'" >&2; exit 2 ;; esac
  [ "${#commit}" -ge 7 ] || { echo "pages verify-rustdoc: --commit $commit is too short to name a commit; use seven characters or more" >&2; exit 2; }
  case "$timeout" in ''|*[!0-9]*) echo "pages verify-rustdoc: --timeout takes whole seconds, not '$timeout'" >&2; exit 2 ;; esac
  # the base the public site is built for, from the same file `verify` reads it from
  [ -n "$url" ] || url="$(sed -n 's/^base_url = "\(.*\)"/\1/p' "$ROOT/site/config.toml")"
  [ -n "$url" ] || { echo "pages verify-rustdoc: no --url and site/config.toml declares no base_url" >&2; return 12; }
  command -v curl >/dev/null || { echo "pages verify-rustdoc: curl is required" >&2; return 12; }
  mount="$(jq -r '[.surfaces[] | select(.id == "rustdoc") | .mount] | first // empty' "$ROOT/docs/generated/web.json" 2>/dev/null || true)"
  [ -n "$mount" ] || { echo "pages verify-rustdoc: docs/generated/web.json declares no rustdoc surface; there is no mount to verify" >&2; return 12; }
  crate="$(sed -n '/^\[lib\]/,/^\[/ s/^name = "\(.*\)"/\1/p' "$ROOT/apps/majordomus-cli/Cargo.toml" | head -n 1)"
  [ -n "$crate" ] || { echo "pages verify-rustdoc: apps/majordomus-cli/Cargo.toml names no [lib]; there is no crate index to verify" >&2; return 12; }
  VR_WORK="$(mktemp -d "${TMPDIR:-/tmp}/mj-pages-rustdoc.XXXXXX")"
  trap 'rm -rf "$VR_WORK"; rm -f "$FLAT" "${GFLAT:-}"' EXIT
  t0="$(now)"
  while :; do
    round=$((round + 1)); rc=0
    rustdoc_round "${url%/}" "$mount" "$crate" "$commit" > "$VR_WORK/lines" || rc=$?
    if [ "$rc" = 0 ] || [ $(( $(now) - t0 )) -ge "$timeout" ]; then break; fi
    printf 'pages verify-rustdoc: round %s not yet (exit %s): %s\n' "$round" "$rc" \
      "$(grep -m1 ' fail$' "$VR_WORK/lines" || head -n 1 "$VR_WORK/lines")" >&2
    sleep 5
  done
  cat "$VR_WORK/lines"
  rm -rf "$VR_WORK"
  case "$rc" in
    0)  printf 'pages verify-rustdoc: %s%s/ serves the reference built from %s, whole, after %s s\n' "${url%/}" "$mount" "${commit:0:12}" "$(( $(now) - t0 ))" ;;
    10) printf 'pages verify-rustdoc: after %s s %s%s/ serves something other than the reference built from %s\n' "$(( $(now) - t0 ))" "${url%/}" "$mount" "${commit:0:12}" >&2 ;;
    *)  printf 'pages verify-rustdoc: %s%s/ could not be judged within %s s; the reference was not verified\n' "${url%/}" "$mount" "$timeout" >&2 ;;
  esac
  return "$rc"
}

# One probe of one URL: the body into $VR_WORK/body, and one ASCII line on stdout — requested
# URL, final URL (curl's url_effective), status, content type, marker, ok/fail. The caller
# judges; `vr_line` only records. VR_STATUS and VR_TYPE are left for the caller to read.
VR_STATUS=""; VR_TYPE=""; VR_ANSWERED=0
vr_get() {
  local req="$1" meta
  meta="$(curl -sSL --max-time "${MJ_PAGES_PROBE_SECONDS:-10}" -H 'Cache-Control: no-cache' \
    -o "$VR_WORK/body" -w '%{http_code}\t%{content_type}\t%{url_effective}' "$req?t=$(now)" 2>/dev/null || true)"
  VR_STATUS="$(printf '%s' "$meta" | cut -f1)"; VR_TYPE="$(printf '%s' "$meta" | cut -f2 | tr -d ' ')"
  VR_FINAL="$(printf '%s' "$meta" | cut -f3)"
  case "$VR_STATUS" in ''|000) VR_STATUS=000; : > "$VR_WORK/body" ;; *) VR_ANSWERED=1 ;; esac
}
vr_line() {   # verdict marker
  printf 'url=%s final=%s status=%s type=%s marker="%s" %s\n' \
    "$VR_REQ" "${VR_FINAL:-none}" "$VR_STATUS" "${VR_TYPE:-none}" "$(printf '%s' "$2" | LC_ALL=C tr -cd '\40-\176' | tr '"' "'")" "$1"
}
# a sha the site states, matched as `verify` matches it: the full value begins with the one asked
vr_names() { [ -n "$1" ] && [ "${1#"$2"}" != "$1" ]; }

rustdoc_round() {
  local base="$1" mount="$2" crate="$3" commit="$4" bad=0 v m page a mod search suffix root
  VR_ANSWERED=0
  # 1. the build's identity names the commit the composed surface was built from
  VR_REQ="$base/$IDENTITY"; vr_get "$VR_REQ"
  v="$(jq -r '[.surfaces[]? | select(.id == "rustdoc") | .built_from // empty] | first // empty' "$VR_WORK/body" 2>/dev/null || true)"
  if [ "$VR_STATUS" = 200 ] && vr_names "$v" "$commit"; then vr_line ok "surfaces.rustdoc.built_from=$v"
  else vr_line fail "surfaces.rustdoc.built_from=${v:-absent}, want $commit"; bad=1; fi
  # 2. the surface's own declaration, as published beside its pages
  VR_REQ="$base$mount/surface.json"; vr_get "$VR_REQ"
  v="$(jq -r 'select(.id == "rustdoc") | .built_from // empty' "$VR_WORK/body" 2>/dev/null || true)"
  if [ "$VR_STATUS" = 200 ] && vr_names "$v" "$commit"; then vr_line ok "built_from=$v"
  else vr_line fail "id rustdoc, built_from=${v:-absent}, want $commit"; bad=1; fi
  # 3. the landing page the mount answers with, which names the commit
  VR_REQ="$base$mount/"; vr_get "$VR_REQ"
  case "$VR_STATUS $VR_TYPE" in
    "200 text/html"*) if grep -qF "$commit" "$VR_WORK/body"; then vr_line ok "names $commit"
                      else vr_line fail "does not name $commit"; bad=1; fi ;;
    *) vr_line fail "want 200 text/html naming $commit"; bad=1 ;;
  esac
  # 4. the crate's index, as rustdoc writes it
  page="$mount/$crate/index.html"
  VR_REQ="$base$page"; vr_get "$VR_REQ"
  cp "$VR_WORK/body" "$VR_WORK/crate.html"
  case "$VR_STATUS $VR_TYPE" in
    "200 text/html"*)
      if grep -qF '<meta name="generator" content="rustdoc">' "$VR_WORK/crate.html" \
         && grep -qF "<title>$crate - Rust</title>" "$VR_WORK/crate.html"; then
        vr_line ok "generator rustdoc, title $crate - Rust"
      else vr_line fail "want the rustdoc generator meta and <title>$crate - Rust</title>"; bad=1; fi ;;
    *) vr_line fail "want 200 text/html, the crate's index"; bad=1
       # everything below is read out of this page; without it there is nothing to derive
       VR_REQ="$base$mount/static.files/"; VR_FINAL=""; VR_STATUS=-; VR_TYPE=-
       vr_line fail "not probed: the assets, a module and the search index are named by the crate's index"
       [ "$VR_ANSWERED" = 1 ] && return 10; return 12 ;;
  esac
  # 5. every stylesheet and script the index references under static.files, relative to it
  root="$(sed -n 's/.*data-static-root-path="\([^"]*\)".*/\1/p' "$VR_WORK/crate.html" | head -n 1)"
  { grep -oE '(href|src)="[^"$]*static\.files/[A-Za-z0-9._-]+\.(css|js)"' "$VR_WORK/crate.html" \
      | sed -E 's/^(href|src)="//; s/"$//'
    [ -n "$root" ] && grep -oE 'data-(search|stringdex|settings)-js="[A-Za-z0-9._-]+\.js"' "$VR_WORK/crate.html" \
      | sed -E 's/^[^"]*"//; s/"$//' | sed "s#^#$root#"
  } | LC_ALL=C sort -u > "$VR_WORK/assets"
  [ -s "$VR_WORK/assets" ] || { VR_REQ="$base$page"; VR_STATUS=-; VR_TYPE=-; VR_FINAL=""
    vr_line fail "the crate's index references no stylesheet or script under static.files"; bad=1; }
  while IFS= read -r a; do
    VR_REQ="$base$(vr_resolve "$mount/$crate/" "$a")"; vr_get "$VR_REQ"
    case "$a" in *.css) m="text/css" ;; *) m="javascript" ;; esac
    case "$VR_STATUS $VR_TYPE" in
      200\ *"$m"*) vr_line ok "$m" ;;
      *) vr_line fail "want 200 $m"; bad=1 ;;
    esac
  done < "$VR_WORK/assets"
  # 6. one module page: the first module the index links, in sorted order
  mod="$(grep -oE 'href="[a-z_][a-z0-9_]*/index\.html"' "$VR_WORK/crate.html" | sed -E 's/^href="//; s#/index\.html"$##' | LC_ALL=C sort -u | head -n 1)"
  if [ -z "$mod" ]; then
    VR_REQ="$base$page"; VR_STATUS=-; VR_TYPE=-; VR_FINAL=""; vr_line fail "the crate's index links no module"; bad=1
  else
    VR_REQ="$base$mount/$crate/$mod/index.html"; vr_get "$VR_REQ"
    if [ "$VR_STATUS" = 200 ] && grep -qF "<title>$crate::$mod - Rust</title>" "$VR_WORK/body"; then vr_line ok "title $crate::$mod - Rust"
    else vr_line fail "want 200 and <title>$crate::$mod - Rust</title>"; bad=1; fi
  fi
  # 7. the search index, where rustdoc's own script looks for it: root path, search.index/root,
  #    resource suffix, .js
  search="$(sed -n 's/.*data-root-path="\([^"]*\)".*/\1/p' "$VR_WORK/crate.html" | head -n 1)"
  suffix="$(sed -n 's/.*data-resource-suffix="\([^"]*\)".*/\1/p' "$VR_WORK/crate.html" | head -n 1)"
  VR_REQ="$base$(vr_resolve "$mount/$crate/" "${search}search.index/root${suffix}.js")"; vr_get "$VR_REQ"
  case "$VR_STATUS $VR_TYPE" in
    200\ *javascript*) vr_line ok "search index" ;;
    *) vr_line fail "want 200 javascript, the search index"; bad=1 ;;
  esac
  # 8. the second witness of the commit (ADR 0086): the page rustdoc rendered for the crate's
  #    COMMIT constant, whose value the compiler embedded from the commit the producer handed
  #    the build. built_from above is the producer's statement; this is the build's. A tree
  #    assembled from two builds is the one where they disagree. The page is the one the crate's
  #    index links, so a crate that stopped exporting the constant is a finding here too.
  if grep -qF 'href="constant.COMMIT.html"' "$VR_WORK/crate.html"; then
    VR_REQ="$base$mount/$crate/constant.COMMIT.html"; vr_get "$VR_REQ"
    if [ "$VR_STATUS" = 200 ] && grep -qF "&quot;$commit" "$VR_WORK/body"; then vr_line ok "COMMIT names $commit"
    else vr_line fail "want 200 and the COMMIT constant naming $commit"; bad=1; fi
  else
    VR_REQ="$base$page"; VR_STATUS=-; VR_TYPE=-; VR_FINAL=""
    vr_line fail "the crate's index links no constant.COMMIT.html, the second witness of the commit"; bad=1
  fi
  [ "$bad" = 0 ] && return 0
  [ "$VR_ANSWERED" = 1 ] && return 10
  return 12
}

# a relative reference resolved against the directory of the page that makes it
vr_resolve() {
  local dir="$1" ref="$2"
  while :; do
    case "$ref" in
      ../*) ref="${ref#../}"; dir="${dir%/}"; dir="${dir%/*}/" ;;
      ./*) ref="${ref#./}" ;;
      *) break ;;
    esac
  done
  printf '%s%s\n' "$dir" "$ref"
}

# ---------------------------------------------------------------- what a publication holds besides
# The site build composes the surfaces the topology marks as held by a process and a
# publication both (mj_web_composed; the crate's reference is one). A snapshot is the other
# kind: a surface only a process serves, read once and written as files by a producer of its
# own, so the committed topology cannot carry it and the build does not compose it (ADR 0141).
# That left its existence known to one workflow step. The model names it now
# (deploy.snapshots), and this is the one reading of that entry: the deploy, the public probe
# and the live gate each ask here, so none of them writes a mount, an artifact directory or a
# producer of its own. The mount is the topology's for the served surface the entry names,
# because a publication holds the snapshot where a process serves the original.
#
# Rows are tab-separated and every field is required: a reader splitting on tabs loses an
# empty field without noticing, and an entry that does not say where its producer writes or
# how its pages state their commit is not one a deploy can be held to.
cmd_snapshots() {
  local i=0 id mount artifact producer marker topology="$ROOT/docs/generated/web.json"
  while id="$(m "deploy.snapshots.$i.surface")"; [ -n "$id" ]; do
    mount="$(jq -r --arg i "$id" '[.surfaces[] | select(.id == $i) | .mount] | first // empty' "$topology" 2>/dev/null || true)"
    [ -n "$mount" ] || {
      echo "pages snapshots: ${MODEL#"$ROOT"/} declares a snapshot of surface $id, and docs/generated/web.json gives it no mount; there is nowhere to hold it" >&2
      return 12; }
    artifact="$(m "deploy.snapshots.$i.artifact")"
    producer="$(m "deploy.snapshots.$i.producer")"
    marker="$(m "deploy.snapshots.$i.marker")"
    [ -n "$artifact" ] && [ -n "$producer" ] && [ -n "$marker" ] || {
      echo "pages snapshots: deploy.snapshots.$i ($id) in ${MODEL#"$ROOT"/} must name its artifact, its producer and its marker" >&2
      return 12; }
    printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$mount" "$artifact" "$producer" "$marker"
    i=$((i + 1))
  done
}

# ---------------------------------------------------------------- the UI's snapshot, public
# The UI is published as a snapshot read at one commit (ADR 0141), by a job of its own, placed
# at the UI's mount by the deploy. Until this existed nothing asked the public site for it:
# `verify` reads /build.json, which does not name it; `verify-docs` and `verify-rustdoc` read
# their own surfaces. A deploy that lost the mount, a snapshot read at an older commit than
# the pages beside it, and a tree half copied each left every probe green
# (project.the-published-ui-is-the-trunks). So it is verified the way a reader meets it.
#
# In order, each document cache-busted as `verify` busts it (?t=): the surface's own
# declaration beside its pages names the commit and the mount it is served at; the landing
# page answers HTML and its banner states the same commit, with the attribute the model names
# (deploy.snapshots: marker); snapshot.json is the run's own record — the pages it wrote, the
# pages it left out, and what ended the reading — and names the same commit, because a tree
# assembled from two runs is the one where they disagree; and every page that record lists
# answers 200. The pages are asked in one curl, in parallel where curl can, since two hundred
# sequential requests took half a minute against the public site and under a second this way.
#
# The bound on pages is --max-pages, and it is a bound on this probe, never on the verdict's
# honesty: when the record lists more, the ones asked are spread evenly over the sorted list,
# so every family of pages is sampled rather than the first alphabetically, and the summary
# says how many were asked and how many were not. A snapshot that was cut short is not a
# failure — the producer is bounded on purpose and says so — but one that does not say what
# ended its reading is, because then "these are all the pages" and "these are the pages there
# was time for" cannot be told apart.
#
# A commit is matched as `verify` matches it, in either direction: the snapshot states an
# abbreviation and a caller states the commit however it has it, so one must begin with the
# other, and neither may be shorter than seven characters. Exits are the family's: a site that
# answered and holds no snapshot, another commit's, or part of one is 10; a site that never
# answered, or a probe that cannot judge, is 12. Every finding is one `FAIL` line on stderr
# that ends with the command which shows it again.
#
# --surface names which snapshot of the model is asked for; without it, the UI's. Every
# snapshot is held the same way, because every one is written by the same exporter: the
# Cockpit's (ADR 0147) is `--surface cockpit`.
cmd_verify_ui() {
  local url="" commit="" timeout=180 max=256 t0 rc round=0 row mount marker surface=ui
  while [ $# -gt 0 ]; do case "$1" in
    --surface) surface="$2"; shift 2 ;;
    --url) url="$2"; shift 2 ;;
    --commit) commit="$2"; shift 2 ;;
    --timeout) timeout="$2"; shift 2 ;;
    --max-pages) max="$2"; shift 2 ;;
    *) echo "pages verify-ui: unknown option $1" >&2; exit 2 ;;
  esac; done
  case "$commit" in *[!0-9a-fA-F]*) echo "pages verify-ui: --commit takes a commit sha, not '$commit'" >&2; exit 2 ;; esac
  [ -z "$commit" ] || [ "${#commit}" -ge 7 ] || { echo "pages verify-ui: --commit $commit is too short to name a commit; use seven characters or more" >&2; exit 2; }
  case "$timeout" in ''|*[!0-9]*) echo "pages verify-ui: --timeout takes whole seconds, not '$timeout'" >&2; exit 2 ;; esac
  case "$max" in ''|0|*[!0-9]*) echo "pages verify-ui: --max-pages takes a count of one or more, not '$max'" >&2; exit 2 ;; esac
  # the base the public site is built for, from the same file `verify` reads it from
  [ -n "$url" ] || url="$(sed -n 's/^base_url = "\(.*\)"/\1/p' "$ROOT/site/config.toml")"
  [ -n "$url" ] || { echo "pages verify-ui: no --url and site/config.toml declares no base_url" >&2; return 12; }
  command -v curl >/dev/null || { echo "pages verify-ui: curl is required" >&2; return 12; }
  url="${url%/}"
  case "$surface" in ''|*[!a-z0-9-]*) echo "pages verify-ui: --surface takes a surface id, not '$surface'" >&2; exit 2 ;; esac
  row="$(cmd_snapshots | awk -F '\t' -v s="$surface" '$1 == s')" || return 12
  [ -n "$row" ] || { echo "pages verify-ui: ${MODEL#"$ROOT"/} declares no snapshot of the $surface surface (deploy.snapshots); there is none to verify" >&2; return 12; }
  mount="$(printf '%s' "$row" | cut -f2)"; marker="$(printf '%s' "$row" | cut -f5)"
  # what a reader calls the surface, in the lines below: the UI is "the UI", as it always read
  case "$surface" in ui) VR_NAME="UI" ;; cockpit) VR_NAME="Cockpit" ;; *) VR_NAME="$surface surface" ;; esac
  # Without --commit the question is whether the UI beside the site is the site's: the commit
  # is the one the site's own identity names. Whether that commit is the trunk's, and how old
  # it may be, is scripts/ci/pages-check's to judge; this holds the two surfaces to one commit.
  if [ -z "$commit" ]; then
    commit="$(curl -fsSL --max-time "${MJ_PAGES_PROBE_SECONDS:-10}" -H 'Cache-Control: no-cache' "$url/$IDENTITY?t=$(now)" 2>/dev/null | jq -r '.commit // empty' 2>/dev/null || true)"
    case "$commit" in ''|*[!0-9a-fA-F]*) commit="" ;; esac
    [ "${#commit}" -ge 7 ] || { echo "pages verify-ui: no --commit, and $url/$IDENTITY names none; there is no commit to hold the UI to" >&2; return 12; }
  fi
  VR_WORK="$(mktemp -d "${TMPDIR:-/tmp}/mj-pages-ui.XXXXXX")"
  trap 'rm -rf "$VR_WORK"; rm -f "$FLAT" "${GFLAT:-}"' EXIT
  t0="$(now)"
  while :; do
    round=$((round + 1)); rc=0
    ui_round "$url" "$mount" "$marker" "$commit" "$max" > "$VR_WORK/lines" || rc=$?
    if [ "$rc" = 0 ] || [ $(( $(now) - t0 )) -ge "$timeout" ]; then break; fi
    printf 'pages verify-ui: round %s not yet (exit %s): %s\n' "$round" "$rc" \
      "$(grep -m1 ' fail$' "$VR_WORK/lines" || head -n 1 "$VR_WORK/lines")" >&2
    sleep 5
  done
  cat "$VR_WORK/lines"
  [ "$rc" = 0 ] || cat "$VR_WORK/findings" >&2
  case "$rc" in
    0)  printf 'pages verify-ui: %s%s/ serves the %s read at %s: %s; after %s s\n' "$url" "$mount" "$VR_NAME" "${commit:0:12}" "$(cat "$VR_WORK/summary")" "$(( $(now) - t0 ))" ;;
    10) printf 'pages verify-ui: after %s s %s%s/ is not the %s read at %s, whole\n' "$(( $(now) - t0 ))" "$url" "$mount" "$VR_NAME" "${commit:0:12}" >&2 ;;
    *)  printf 'pages verify-ui: %s%s/ could not be judged within %s s; the %s was not verified\n' "$url" "$mount" "$timeout" "$VR_NAME" >&2 ;;
  esac
  rm -rf "$VR_WORK"
  return "$rc"
}

# one finding of a round: what is wrong, and the command that shows it again
# The attribute a screen's placeholder names its panel's route with (ui/mod.rs FRAGMENT's
# counterpart on the page; web/report/snapshot.rs writes the panel in its place).
UI_DEFERRED=data-panel-src
ui_finding() { printf 'pages verify-ui: FAIL %s  [reproduce: %s]\n' "$1" "$2" >> "$VR_WORK/findings"; }
# two statements of one commit agree when one begins with the other and both can name a commit
ui_same_commit() { [ "${#1}" -ge 7 ] && [ "${#2}" -ge 7 ] && { vr_names "$1" "$2" || vr_names "$2" "$1"; }; }

ui_round() {
  local base="$1" mount="$2" marker="$3" commit="$4" max="$5" bad=0 v at rev stopped left total asked missing
  VR_ANSWERED=0
  : > "$VR_WORK/findings"; : > "$VR_WORK/summary"; : > "$VR_WORK/landing"
  # 1. the snapshot's own declaration, as published beside its pages
  VR_REQ="$base$mount/surface.json"; vr_get "$VR_REQ"
  v="$(jq -r '.built_from // empty' "$VR_WORK/body" 2>/dev/null || true)"
  at="$(jq -r '.mount // empty' "$VR_WORK/body" 2>/dev/null || true)"
  if [ "$VR_STATUS" != 200 ] || [ -z "$v" ]; then
    vr_line fail "want 200 and a declaration naming built_from"
    ui_finding "$VR_REQ is absent or unreadable (status $VR_STATUS): the publication holds no $VR_NAME snapshot at $mount" "curl -fsS $VR_REQ"
    # the record and the pages are this declaration's; without it there is no snapshot to walk
    [ "$VR_ANSWERED" = 1 ] && return 10; return 12
  fi
  if ui_same_commit "$commit" "$v"; then vr_line ok "built_from=$v"
  else
    vr_line fail "built_from=$v, want $commit"; bad=1
    ui_finding "the published $VR_NAME was read at $v, not at $commit: $VR_REQ names another commit than the site it is served beside" "curl -fsS $VR_REQ | jq -r .built_from"
  fi
  if [ "$at" != "$mount" ]; then
    vr_line fail "mount=${at:-absent}, served at $mount"; bad=1
    ui_finding "$VR_REQ declares mount ${at:-none} and is served at $mount" "curl -fsS $VR_REQ | jq -r .mount"
  fi
  # 2. the landing page the mount answers with, whose banner states the commit it was read at
  VR_REQ="$base$mount/"; vr_get "$VR_REQ"
  case "$VR_STATUS $VR_TYPE" in
    "200 text/html"*)
      if grep -qF "$marker=\"$v\"" "$VR_WORK/body"; then vr_line ok "$marker=$v"
      else
        vr_line fail "does not state $marker=$v"; bad=1
        ui_finding "$VR_REQ does not state $marker=\"$v\": the page is not the snapshot its declaration names" "curl -fsS $VR_REQ | grep -o '$marker=\"[^\"]*\"'"
      fi
      # The first screen is what a visitor reads the product by. A figure of it that is
      # undecided — the unknown badge, or a source that did not answer — is a publication
      # that shows nothing where it shows itself, and the reader of a snapshot is a process
      # that can decide every figure the screen is allowed to lead with.
      undecided="$(grep -oE 'class="mj-ui-kpi-label">[^<]*</span><span class="mj-ui-kpi-value">(<span class="mj-badge mj-badge--unknown"|not answered<)' "$VR_WORK/body" \
        | sed -E 's/^class="mj-ui-kpi-label">([^<]*)<.*/\1/' | paste -sd, - || true)"
      if [ -z "$undecided" ]; then vr_line ok "first-screen figures decided"
      else
        vr_line fail "first-screen figure(s) undecided: $undecided"; bad=1
        ui_finding "the first screen of $VR_REQ leads with figure(s) nothing decided ($undecided): a publication shows what the repository says, never unknown" "scripts/pages verify-ui --url $base --commit $commit --timeout 0"
      fi
      # kept for §3: whether this page may still ask for a panel is the record's to say
      cp "$VR_WORK/body" "$VR_WORK/landing" ;;
    *) vr_line fail "want 200 text/html"; bad=1
       ui_finding "$VR_REQ answered $VR_STATUS ${VR_TYPE:-with no content type}, not the $VR_NAME's first page" "curl -fsSI $VR_REQ" ;;
  esac
  # 3. the run's own record: what it wrote, what it left out, and what ended the reading
  VR_REQ="$base$mount/snapshot.json"; vr_get "$VR_REQ"
  cp "$VR_WORK/body" "$VR_WORK/snapshot.json"
  if [ "$VR_STATUS" != 200 ] || ! jq -e '(.pages | type) == "object" and (.pages | length) > 0' "$VR_WORK/snapshot.json" >/dev/null 2>&1; then
    vr_line fail "want 200 and a record listing the pages written"; bad=1
    ui_finding "$VR_REQ is absent or is not a snapshot's record (status $VR_STATUS): the pages it holds cannot be enumerated" "curl -fsS $VR_REQ | jq '.pages | length'"
    VR_REQ="$base$mount/"; VR_FINAL=""; VR_STATUS=-; VR_TYPE=-
    vr_line fail "not probed: the pages are named by snapshot.json"
    [ "$VR_ANSWERED" = 1 ] && return 10; return 12
  fi
  rev="$(jq -r '.origin.revision // empty' "$VR_WORK/snapshot.json")"
  stopped="$(jq -r '.stopped_by | if type == "string" then . else empty end' "$VR_WORK/snapshot.json")"
  left="$(jq -r '.left_out | if type == "array" then length else empty end' "$VR_WORK/snapshot.json")"
  total="$(jq -r '[.pages[]] | unique | length' "$VR_WORK/snapshot.json")"
  if ui_same_commit "$commit" "$rev"; then vr_line ok "revision=$rev pages=$total left_out=${left:-absent} stopped_by=${stopped:-absent}"
  else
    vr_line fail "revision=${rev:-absent}, want $commit"; bad=1
    ui_finding "$VR_REQ records a reading at ${rev:-no commit}, not at $commit: the record beside the pages names another commit than the one asked for" "curl -fsS $VR_REQ | jq -r .origin.revision"
  fi
  # A running UI asks for a slow panel after the screen has painted ($UI_DEFERRED); a snapshot
  # has no process to ask, so its writer puts each panel into the page and says so in the
  # record (.panels). A record that says so, beside a first screen that still carries the
  # request, is a screen published without its panel. A record that does not carry the field
  # was written before the writer did this: stated, and not a failure of this publication.
  if [ -s "$VR_WORK/landing" ] && grep -qF "$UI_DEFERRED=" "$VR_WORK/landing"; then
    VR_REQ="$base$mount/"; VR_FINAL=""; VR_STATUS=-; VR_TYPE=-
    if jq -e '(.panels | type) == "array"' "$VR_WORK/snapshot.json" >/dev/null 2>&1; then
      vr_line fail "still asks for a panel after it has painted ($UI_DEFERRED)"; bad=1
      ui_finding "$VR_REQ still carries $UI_DEFERRED: the snapshot left a panel as a request no process answers, so the screen is published without it" "curl -fsS $VR_REQ | grep -o '$UI_DEFERRED=\"[^\"]*\"'"
    else
      vr_line ok "asks for a panel after it has painted; its record predates panels written into the page (no .panels)"
    fi
    VR_REQ="$base$mount/snapshot.json"
  fi
  if [ -z "$stopped" ] || [ -z "$left" ]; then
    vr_line fail "left_out=${left:-absent} stopped_by=${stopped:-absent}"; bad=1
    ui_finding "$VR_REQ does not say what ended the reading (stopped_by) or which pages it left out (left_out): a snapshot cut short cannot be told from a whole one" "curl -fsS $VR_REQ | jq '{stopped_by, left_out: (.left_out | length?)}'"
  fi
  # 4. every page the record lists, or --max-pages of them spread evenly over the sorted list.
  #    A page is addressed as the file the record says it is, each segment escaped, so an
  #    identifier that carries a character a URL reserves is asked for and not mangled.
  jq -r '[.pages[]] | unique[] | split("/") | map(@uri) | join("/")' "$VR_WORK/snapshot.json" \
    | awk -v max="$max" -v total="$total" \
        'total <= max || NR == 1 || int((NR - 1) * max / total) != int((NR - 2) * max / total)' > "$VR_WORK/pages"
  asked="$(wc -l < "$VR_WORK/pages" | tr -d ' ')"
  awk -v b="$base$mount/" '{ printf "url = \"%s%s\"\noutput = \"/dev/null\"\n", b, $0 }' "$VR_WORK/pages" > "$VR_WORK/curl.cfg"
  ui_pages --parallel --parallel-max 8 > "$VR_WORK/codes" || true
  # a curl older than --parallel refuses the option and asks nothing; it is asked serially then
  [ -s "$VR_WORK/codes" ] || ui_pages > "$VR_WORK/codes" || true
  ui_retry_unavailable "$base$mount/"
  awk -F '\t' '$1 != "000"' "$VR_WORK/codes" | grep -q . && VR_ANSWERED=1
  awk -F '\t' '$1 != "200"' "$VR_WORK/codes" | LC_ALL=C sort -t "$(printf '\t')" -k2 > "$VR_WORK/missing"
  missing="$(wc -l < "$VR_WORK/missing" | tr -d ' ')"
  [ "$(wc -l < "$VR_WORK/codes" | tr -d ' ')" = "$asked" ] || {
    VR_REQ="$base$mount/"; VR_FINAL=""; VR_STATUS=-; VR_TYPE=-
    vr_line fail "asked for $asked page(s) and curl reported $(wc -l < "$VR_WORK/codes" | tr -d ' ')"; bad=1
    ui_finding "the probe asked for $asked page(s) of $base$mount/ and read a status for fewer; the pages were not all measured" "scripts/pages verify-ui --url $base --commit $commit --timeout 0"; }
  while IFS="$(printf '\t')" read -r VR_STATUS VR_REQ; do
    [ -n "$VR_REQ" ] || continue
    VR_FINAL="$VR_REQ"; VR_TYPE=-
    vr_line fail "want 200: snapshot.json lists this page"
    ui_finding "$VR_REQ answered $VR_STATUS: snapshot.json lists a page the site does not serve" "curl -fsSI $VR_REQ"
    bad=1
  done < "$VR_WORK/missing"
  VR_REQ="$base$mount/"; VR_FINAL=""; VR_STATUS=-; VR_TYPE=-
  printf '%s of %s page(s) snapshot.json lists were asked for and %s did not answer, %s not asked (--max-pages %s); the snapshot left out %s page(s), stopped by %s' \
    "$asked" "$total" "$missing" "$(( total - asked ))" "$max" "${left:-an unstated number of}" "${stopped:-nothing it names}" > "$VR_WORK/summary"
  if [ "$missing" = 0 ]; then vr_line ok "$(cat "$VR_WORK/summary")"
  else vr_line fail "$(cat "$VR_WORK/summary")"; fi
  [ "$bad" = 0 ] && return 0
  [ "$VR_ANSWERED" = 1 ] && return 10
  return 12
}

# A page that answered 503, or did not answer at all (000: a connection that was refused or
# never answered), is asked again, a few times with a doubling pause, before it is called
# missing (I2813). GitHub
# Pages answers a burst of requests with a transient 503 that a reader a second later does not
# meet; on 2026-10-17 that one answer reddened master's validate and 71a's run, because a page was
# declared absent on its first 503. On 2026-10-17 at 23:49Z the scheduled run read five cockpit
# pages as 000 and called them "not served" while each answered 200 a minute later. Only those two
# are asked again: any other status, and a 503 or 000 that persists through every try, stays
# exactly what it was and fails as it did. Each page asked again is said on stderr, with how often
# it answered each and what it answered last, so a verdict that needed a retry reads that way.
#   MJ_PAGES_RETRIES        how many times such a page is asked again (default 4)
#   MJ_PAGES_RETRY_SECONDS  the first pause, doubled before each next try (default 1)
ui_retry_unavailable() {   # <the base the pages' urls begin with, for the lines it writes>
  local base="$1" tries="${MJ_PAGES_RETRIES:-4}" wait="${MJ_PAGES_RETRY_SECONDS:-1}" status url asked pause
  local n503 n000 seen
  while IFS="$(printf '\t')" read -r status url; do
    case "$status" in
      503|000)
        asked=0; pause="$wait"; n503=0; n000=0
        [ "$status" = 503 ] && n503=1 || n000=1
        while { [ "$status" = 503 ] || [ "$status" = 000 ]; } && [ "$asked" -lt "$tries" ]; do
          sleep "$pause"; pause=$(( pause * 2 )); asked=$(( asked + 1 ))
          status="$(curl -sS -o /dev/null --max-time "${MJ_PAGES_PROBE_SECONDS:-10}" -H 'Cache-Control: no-cache' \
            -w '%{http_code}' "$url" 2>/dev/null || true)"
          [ -n "$status" ] || status=000
          case "$status" in 503) n503=$(( n503 + 1 )) ;; 000) n000=$(( n000 + 1 )) ;; esac
        done
        seen=""
        [ "$n503" -gt 0 ] && seen="503 ×$n503"
        [ "$n000" -gt 0 ] && seen="${seen:+$seen, }000 ×$n000"
        if [ "$status" = 503 ] || [ "$status" = 000 ]; then
          printf 'pages verify-ui: retried /%s: %s, still %s after %s retries\n' "${url#"$base"}" "$seen" "$status" "$asked" >&2
        else
          printf 'pages verify-ui: retried /%s: %s then %s\n' "${url#"$base"}" "$seen" "$status" >&2
        fi
        ;;
    esac
    printf '%s\t%s\n' "$status" "$url"
  done < "$VR_WORK/codes" > "$VR_WORK/codes.retried"
  mv "$VR_WORK/codes.retried" "$VR_WORK/codes"
}

# the status of every page in curl.cfg, one "<status><TAB><url>" line each, in no order
ui_pages() {
  curl -sS "$@" --max-time "${MJ_PAGES_PROBE_SECONDS:-10}" -H 'Cache-Control: no-cache' \
    -w '%{http_code}\t%{url_effective}\n' -K "$VR_WORK/curl.cfg" 2>/dev/null
}

# ---------------------------------------------------------------- rebuild
# Ask GitHub to build the branch again — and only when that is the thing that helps.
#
# An owed publication has two causes and two different remedies, and tonight both happened.
# If gh-pages does not carry the trunk's site, deploying is the fix. If gh-pages is right and
# GitHub's own builder errored, deploying again changes nothing: the tree it would push is the
# one already there. On 2026-09-14 three consecutive builds of a correct tree errored with
# "Page build failed." and no message; a direct request built the identical commit and it went
# through. So a rebuild is a different action from a redeploy, not a dressed-up retry of one.
#
# TWO HAZARDS, BOTH MEASURED RATHER THAN IMAGINED.
#
#   A request PREEMPTS a build in flight. Asking while GitHub is building kills that build, so
#   one slow build becomes two failed ones. The predicate is therefore "the build of this
#   commit errored AND nothing is building", never "the build errored".
#
#   The state is not stable under one reading: `building` at 01:03 had become `errored` by the
#   next look, and the repository-level status disagreed with the per-build list at the same
#   moment. So this reads through `pages built --porcelain` — the one place this repository
#   reads that state — twice: once about the commit in question, once about the newest build,
#   which is how "nothing is building" is asked. It does not add a third reader.
#
# Exit: 0 a build was requested, or none was needed; 12 the state could not be read, or a build
# is in flight and asking would preempt it. Never 0 for a request that was not made.
cmd_rebuild() {
  local branch="gh-pages" commit="" slug row status newest nstatus
  while [ $# -gt 0 ]; do case "$1" in
    --branch) branch="$2"; shift 2 ;;
    --commit) commit="$2"; shift 2 ;;
    *) echo "pages rebuild: unknown option $1" >&2; exit 2 ;;
  esac; done

  row="$(cmd_built --branch "$branch" ${commit:+--commit "$commit"} --porcelain 2>/dev/null)" || true
  status="$(printf '%s' "$row" | cut -f1)"
  [ -n "$status" ] && [ "$status" != unreadable ] || {
    echo "pages rebuild: the build state could not be read; not asking blindly (no gh, no token, or no pages:read)" >&2
    return 12; }
  [ -z "$commit" ] && commit="$(printf '%s' "$row" | cut -f2)"

  case "$status" in
    built)
      printf 'pages rebuild: the build of %s succeeded; nothing to ask for\n' "${commit:0:12}"
      return 0 ;;
    building|queued)
      printf 'pages rebuild: a build of %s is %s; a request would preempt it\n' "${commit:0:12}" "$status" >&2
      return 12 ;;
  esac

  # errored, and nothing of this commit is in flight — but a build of something else may be
  newest="$(cmd_built --branch "$branch" --porcelain 2>/dev/null)" || true
  nstatus="$(printf '%s' "$newest" | cut -f1)"
  case "$nstatus" in
    building|queued)
      printf 'pages rebuild: GitHub is %s another commit; a request would preempt it\n' "$nstatus" >&2
      return 12 ;;
  esac

  slug="${GITHUB_REPOSITORY:-}"
  [ -n "$slug" ] || slug="$(git -C "$ROOT" remote get-url origin 2>/dev/null | sed -n 's|.*[:/]\([^/][^/]*/[^/][^/]*\)$|\1|p' | sed 's|\.git$||')"
  [ -n "$slug" ] || { echo "pages rebuild: no repository slug (no GITHUB_REPOSITORY, no origin)" >&2; return 12; }

  printf 'pages rebuild: the build of %s errored; asking GitHub to build it again\n' "${commit:0:12}"
  gh api -X POST "repos/$slug/pages/builds" >/dev/null 2>&1 || {
    echo "pages rebuild: the request was refused (no token, or no pages:write)" >&2; return 12; }

  # the request was accepted; what came of it is read, not assumed — a queued build errors too
  row="$(cmd_built --branch "$branch" --porcelain 2>/dev/null)" || true
  status="$(printf '%s' "$row" | cut -f1)"
  printf 'pages rebuild: requested; GitHub now reports %s\n' "${status:-nothing}"
  return 0
}

# ---------------------------------------------------------------- release-live
# One fact, three surfaces: which release is the latest. The homepage offers one (its trust strip
# carries `data-release`, rendered from build.json's `release`, which scripts/site-build derives),
# /releases/latest.json is the one the installer resolves, and GitHub's newest release is the one
# that was published. On 2026-10-12 v0.21.0 was on GitHub and in latest.json at 10:23Z while the
# homepage offered v0.20.0, and nothing said so: every check read one surface at a time. This
# reads all three and judges them together (project.the-site-offers-the-release-it-published).
#
# A release reaches the three in order — GitHub, then latest.json from the publish job, then the
# pages from the build the release job asks for — so a disagreement is weather for a while after
# GitHub's release and a defect after that. The window is deploy.release_window. A site that
# offers a version GitHub has not published is never weather. The readings go through curl and
# gh only, so a file:// URL and a gh on PATH are a whole fixture (test/cases/1087).
release_reading() {   # <url> -> body on stdout, or nothing
  local u="$1"
  case "$u" in
    file://*) curl -fsSL --max-time 30 "$u" 2>/dev/null || true ;;
    *) curl -fsSL --max-time 30 -H 'Cache-Control: no-cache' "$u?t=$(now)" 2>/dev/null || true ;;
  esac
}
cmd_release_live() {
  local url="" window="" wait=0 expect="" repo="" t0 home build latest gh_line
  local home_v build_v latest_v gh_tag gh_v gh_at age missing newer_than_gh v
  while [ $# -gt 0 ]; do case "$1" in
    --url) url="${2:?--url needs a value}"; shift 2 ;;
    --window) window="${2:?--window needs seconds}"; shift 2 ;;
    --wait) wait="${2:?--wait needs seconds}"; shift 2 ;;
    --expect) expect="${2:?--expect needs a tag}"; shift 2 ;;
    --repo) repo="${2:?--repo needs owner/name}"; shift 2 ;;
    *) echo "pages release-live: unknown option $1" >&2; exit 2 ;;
  esac; done
  [ -n "$url" ] || url="$(sed -n 's/^base_url = "\(.*\)"/\1/p' "$ROOT/site/config.toml")"
  [ -n "$window" ] || window="$(m deploy.release_window)"
  case "$window" in ''|*[!0-9]*) echo "pages release-live: no numeric deploy.release_window in ${MODEL#"$ROOT"/} and no --window" >&2; return 12 ;; esac
  case "$wait" in *[!0-9]*) echo "pages release-live: --wait takes seconds" >&2; exit 2 ;; esac
  # Where the releases are published is the distribution model's `repository`; a tree without
  # that projection is asked the way `pages built` asks, so pages-check has one slug for both.
  [ -n "$repo" ] || repo="$(jq -r '.repository // empty' "$ROOT/site/data/registry/distribution.json" 2>/dev/null || true)"
  [ -n "$repo" ] || repo="${GITHUB_REPOSITORY:-}"
  [ -n "$repo" ] || repo="$(git -C "$ROOT" remote get-url origin 2>/dev/null | sed -n 's|.*[:/]\([^/][^/]*/[^/][^/]*\)$|\1|p' | sed 's|\.git$||')"
  command -v curl >/dev/null || { echo "pages release-live: curl is required" >&2; return 12; }
  url="${url%/}"
  local home_url="$url/"
  case "$url" in file://*) home_url="$url/index.html" ;; esac
  t0="$(now)"
  while :; do
    home="$(release_reading "$home_url")"
    build="$(release_reading "$url/$IDENTITY")"
    latest="$(release_reading "$url/releases/latest.json")"
    home_v="$(printf '%s' "$home" | sed -n 's/.*data-trust-key="release" data-release="\([^"]*\)".*/\1/p' | head -n 1)"
    # A page built before the trust strip carried the attribute still states the version as
    # the first number in that card; it is read so that such a site is judged, not skipped.
    [ -n "$home_v" ] || home_v="$(printf '%s' "$home" | tr '\n' ' ' \
      | awk '{ i = index($0, "data-trust-key=\"release\""); if (i) print substr($0, i, 800) }' \
      | grep -oE '>[0-9]+\.[0-9]+\.[0-9]+<' | head -n 1 | tr -d '<>' || true)"
    build_v="$(printf '%s' "$build" | jq -r '.release.version // empty' 2>/dev/null || true)"
    latest_v="$(printf '%s' "$latest" | jq -r '.version // empty' 2>/dev/null || true)"
    gh_line=""
    if command -v gh >/dev/null 2>&1 && [ -n "$repo" ]; then
      gh_line="$(gh api "repos/$repo/releases/latest" --jq '[.tag_name, .published_at] | @tsv' 2>/dev/null || true)"
    fi
    gh_tag="$(printf '%s' "$gh_line" | cut -f1)"; gh_v="${gh_tag#v}"
    gh_at="$(printf '%s' "$gh_line" | cut -f2)"
    if [ -n "$home_v" ] && [ "$home_v" = "$build_v" ] && [ "$home_v" = "$latest_v" ] && [ "$home_v" = "$gh_v" ]; then
      break
    fi
    [ $(( $(now) - t0 )) -lt "$wait" ] || break
    sleep 10
  done
  printf 'pages release-live: %s\n' "$url"
  printf '  homepage offers         %s\n' "${home_v:-(no data-release on the homepage)}"
  printf '  /%s offers      %s\n' "$IDENTITY" "${build_v:-(no release in it)}"
  printf '  /releases/latest.json   %s\n' "${latest_v:-(unreadable)}"
  printf '  GitHub newest release   %s%s\n' "${gh_tag:-(unreadable: no gh, no token, or no release)}" "${gh_at:+ published $gh_at}"
  missing=""
  [ -n "$home_v" ] || missing="$missing the homepage's offer,"
  [ -n "$latest_v" ] || missing="$missing /releases/latest.json,"
  [ -n "$gh_v" ] || missing="$missing GitHub's newest release,"
  if [ -n "$missing" ]; then
    printf 'pages release-live: NOT DETERMINED — could not read%s so the three surfaces were not compared\n' "${missing%,}" >&2
    return 12
  fi
  if [ -n "$expect" ] && [ "$gh_tag" != "$expect" ]; then
    printf 'pages release-live: GitHub'"'"'s newest release is %s, not %s\n' "$gh_tag" "$expect" >&2
    return 10
  fi
  if [ -n "$build_v" ] && [ "$home_v" != "$build_v" ]; then
    printf 'pages release-live: FAIL the homepage offers %s and /%s %s; the pages and the build that made them disagree\n' "$home_v" "$IDENTITY" "${build_v:-nothing}" >&2
    return 10
  fi
  if [ "$home_v" = "$latest_v" ] && [ "$home_v" = "$gh_v" ]; then
    printf 'pages release-live: ok — the homepage, /releases/latest.json and GitHub name one release, %s\n' "$gh_tag"
    return 0
  fi
  # A surface ahead of GitHub offers what was not published: never weather.
  newer_than_gh=""
  for v in "$home_v" "$latest_v"; do
    [ "$v" = "$gh_v" ] && continue
    if [ "$(printf '%s\n%s\n' "$v" "$gh_v" | LC_ALL=C sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)" = "$v" ]; then
      newer_than_gh="$v"
    fi
  done
  if [ -n "$newer_than_gh" ]; then
    printf 'pages release-live: FAIL the site offers %s, which GitHub has not published (its newest is %s)\n' "$newer_than_gh" "$gh_tag" >&2
    return 10
  fi
  age="$(jq -rn --arg at "$gh_at" '($at | fromdateiso8601? // empty) as $t | if $t then (now - $t | floor) else empty end' 2>/dev/null || true)"
  if [ -z "$age" ]; then
    printf 'pages release-live: NOT DETERMINED — GitHub'"'"'s release %s carries no readable published_at, so the window cannot be judged\n' "$gh_tag" >&2
    return 12
  fi
  if [ "$age" -lt "$window" ]; then
    printf 'pages release-live: ok — in flight: GitHub published %s %ss ago, inside the %ss window; the homepage offers %s and latest.json names %s until the publication reaches them\n' \
      "$gh_tag" "$age" "$window" "$home_v" "$latest_v"
    return 0
  fi
  printf 'pages release-live: FAIL GitHub published %s %ss ago, beyond the %ss window, and the homepage offers %s while /releases/latest.json names %s\n' \
    "$gh_tag" "$age" "$window" "$home_v" "$latest_v" >&2
  printf '  the publish job writes latest.json (scripts/site-deploy --release-metadata); the pages follow\n  the next build of master, which reads it (scripts/site-build); dispatch the pages workflow\n' >&2
  return 10
}

# The evidence a published UI shows is the evidence the publication could have recorded
# (I2786, rule project.published-evidence-is-what-ci-recorded). The snapshot reads the ledger
# `pages evidence --ledger-out` put in place; this asks the same capability the screens ask,
# evidence.report, in the same checkout, and refuses when more claims read `not run` than the
# baseline declares. A report that cannot be read is not a pass: it exits 12.
cmd_published_evidence() {
  local bin="" baseline="$ROOT/.ai/repo/evidence/published-not-run.txt" allowed totals notrun report
  while [ $# -gt 0 ]; do case "$1" in
    --bin) bin="$2"; shift 2 ;;
    --baseline) baseline="$2"; shift 2 ;;
    *) echo "pages published-evidence: unknown option $1" >&2; exit 2 ;;
  esac; done
  [ -n "$bin" ] && [ -x "$bin" ] || { echo "pages published-evidence: --bin names no executable" >&2; exit 2; }
  [ -f "$baseline" ] || { echo "pages published-evidence: no baseline at $baseline" >&2; exit 12; }
  allowed="$(grep -vE '^[[:space:]]*(#|$)' "$baseline" | head -1 | tr -d '[:space:]')"
  case "$allowed" in ''|*[!0-9]*) echo "pages published-evidence: the baseline holds no count: $baseline" >&2; exit 12 ;; esac
  report="$(cd "$ROOT" && "$bin" run evidence.report --format json 2>/dev/null | jq -ce '.output | objects')" \
    || { echo "pages published-evidence: evidence.report could not be read, so nothing says what the UI would publish" >&2; exit 12; }
  totals="$(printf '%s' "$report" | jq -ce '.totals | objects')" \
    || { echo "pages published-evidence: evidence.report carries no totals" >&2; exit 12; }
  notrun="$(printf '%s' "$totals" | jq '.["not run"] // 0')"
  # A claim whose test exists at none of the commits the ledger was recorded against cannot
  # have a run in it: it is newer than the ledger, and on a master whose own validation has
  # not recorded yet it reads `not run` however true it is (I2853). It is published as what it
  # is, not yet recorded, and is not held against the baseline. A claim whose test existed
  # when the ledger was recorded still counts, and so does every claim when no commit of the
  # ledger is in this history, because then nothing says what the ledger could have seen.
  local known="" c newer="" n_newer=0 id path
  for c in $(printf '%s' "$report" | jq -r '.ledger.commits[]?'); do
    git -C "$ROOT" cat-file -e "${c}^{commit}" 2>/dev/null && known="$known $c"
  done
  if [ -n "$known" ]; then
    while IFS="$(printf '\t')" read -r id path; do
      [ -n "$id" ] && [ -n "$path" ] || continue
      path="${path%%::*}"
      for c in $known; do git -C "$ROOT" cat-file -e "${c}:${path}" 2>/dev/null && continue 2; done
      newer="$newer $id"; n_newer=$((n_newer + 1))
    done <<EOF
$(printf '%s' "$report" | jq -r '.claims[]? | select(.state == "not_run") | "\(.id)\t\(.test_path // "")"')
EOF
  fi
  local held=$((notrun - n_newer))
  [ "$n_newer" -eq 0 ] || echo "pages published-evidence: $n_newer claim(s) newer than the ledger, published as not yet recorded:$newer"
  if [ "$held" -gt "$allowed" ]; then
    echo "pages published-evidence: $held claim(s) would be published as not run, over the baseline of $allowed ($totals)." >&2
    echo "  the UI would show tests as never run that CI ran: fetch the run's ledger first (scripts/pages evidence --ledger-out .ai/repo/evidence/ledger.json)" >&2
    exit 10
  fi
  echo "pages published-evidence: $held claim(s) not run, within the baseline of $allowed ($totals)"
}

# ---------------------------------------------------------------- the publication, stated
# A run that pushed gh-pages and whose public site does not serve the commit is not a green
# run, and until I2661 it looked like one: the probe is continue-on-error, so the deploy job
# ended green while production served the previous commit, and a reader had to open the log to
# learn it. This states the outcome where a lander looks, in three places that need no log:
# the run's summary, an annotation, and a row of the timing table that says `not served`
# instead of omitting the phase. When the site did not serve the commit it also says what it
# DOES serve, and, when GitHub's own build of the branch has not finished, that it is waiting
# and since when — read through `built`, the one place that asks GitHub.
#
# Exit 0 always: this is a statement of a deployment that has already happened, never a gate.
# The gate is `pages-live`.
cmd_publication() {
  local commit="" published="" served="" url="" timings="${MJ_PAGES_TIMINGS:-}" summary="${GITHUB_STEP_SUMMARY:-/dev/stdout}"
  local now_serves="" body="" reading="" bstatus="" bsince="" waiting=""
  while [ $# -gt 0 ]; do case "$1" in
    --commit) commit="$2"; shift 2 ;;
    --published) published="$2"; shift 2 ;;
    --served) served="$2"; shift 2 ;;
    --url) url="$2"; shift 2 ;;
    --timings) timings="$2"; shift 2 ;;
    *) echo "pages publication: unknown option $1" >&2; exit 2 ;;
  esac; done
  [ -n "$commit" ] || { echo "pages publication: --commit is required" >&2; exit 2; }
  if [ "$published" = success ]; then
    echo "::notice title=Published::gh-pages was pushed with $commit before this run ended"
    printf '\nPublication: **pushed** — gh-pages carries %s.\n' "$commit" >> "$summary"
    if [ "$served" = success ]; then
      printf 'Public site: **serves** %s.\n' "$commit" >> "$summary"
      return 0
    fi
    [ -n "$url" ] || url="$(sed -n 's/^base_url = "\(.*\)"/\1/p' "$ROOT/site/config.toml")"
    if command -v curl >/dev/null 2>&1; then
      body="$(curl -fsSL --max-time "${MJ_PAGES_PROBE_SECONDS:-10}" -H 'Cache-Control: no-cache' "${url%/}/$IDENTITY?t=$(now)" 2>/dev/null || true)"
      [ -z "$body" ] || now_serves="$(printf '%s' "$body" | jq -r '.commit // empty' 2>/dev/null || true)"
    fi
    reading="$(cmd_built --porcelain 2>/dev/null | head -1 || true)"
    bstatus="$(printf '%s' "$reading" | cut -f1)"; bsince="$(printf '%s' "$reading" | cut -f4)"
    case "$bstatus" in
      building|queued) waiting="; GitHub's own build of gh-pages is $bstatus${bsince:+ since $bsince}" ;;
      errored) waiting="; GitHub's own build of gh-pages errored" ;;
    esac
    echo "::warning title=Public site not served::after the probe's window the public site serves ${now_serves:-no commit}, not $commit (probe: ${served:-not run})$waiting; pages-live will refuse if it still does not"
    printf 'Public site: **not served** (probe: %s) — it serves %s, not %s%s.\n' "${served:-not run}" "${now_serves:-no commit}" "$commit" "$waiting" >> "$summary"
    # the timing table gets a row that says so, where it would otherwise have no row at all
    [ -z "$timings" ] || printf 'pages\tpublic\tnot served\n' >> "$timings"
  else
    echo "::error title=Not published::this run ended (publish: ${published:-not run}) without pushing gh-pages; the site still serves an older commit"
    printf '\nPublication: **not pushed** (publish step: %s). The site still serves an older\ncommit; if no newer run of this workflow follows, the pages-live gate will refuse.\n' "${published:-not run}" >> "$summary"
  fi
  return 0
}

case "${1:-}" in
  evidence)    shift; cmd_evidence "$@" ;;
  published-evidence) shift; cmd_published_evidence "$@" ;;
  build)       shift; cmd_build "$@" ;;
  check)       shift; cmd_check "$@" ;;
  fingerprint) shift; cmd_fingerprint "$@" ;;
  current)     shift; cmd_current_recorded "$@" ;;
  derived)     shift; cmd_derived "$@" ;;
  paths)       shift; cmd_paths "$@" ;;
  checkout)    shift; cmd_checkout "$@" ;;
  budget)      shift; cmd_budget "$@" ;;
  benchmark)   shift; cmd_benchmark "$@" ;;
  report)      shift; cmd_report "$@" ;;
  built)       shift; cmd_built "$@" ;;
  rebuild)     shift; cmd_rebuild "$@" ;;
  verify)      shift; cmd_verify "$@" ;;
  publication) shift; cmd_publication "$@" ;;
  verify-docs) shift; cmd_verify_docs "$@" ;;
  verify-rustdoc) shift; cmd_verify_rustdoc "$@" ;;
  snapshots)   shift; cmd_snapshots "$@" ;;
  verify-ui)   shift; cmd_verify_ui "$@" ;;
  release-live) shift; cmd_release_live "$@" ;;
  # the whole header, up to the line that ends it, rather than a line range that stops
  # short the day a command is added to it
  -h|--help|"") awk 'NR > 1 && /^set -eu$/ { exit } NR > 1' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "pages: unknown command $1 (scripts/pages --help)" >&2; exit 2 ;;
esac
