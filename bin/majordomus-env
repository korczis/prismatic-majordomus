#!/usr/bin/env bash
# majordomus-env — the adapter `.envrc` calls. It finds the Rust executable and hands it
# the arguments it was given; it never builds, never reaches the network, and knows
# nothing about the repository beyond where it is.
#
# The reason it exists rather than `.envrc` calling the executable directly: a checkout
# does not have the executable until somebody builds it, and entering a repository must
# not fail, hang, or start a two-minute compile because of that. So a missing executable
# is one line on stderr naming what to run, and exit 0.
#
#   MAJORDOMUS_BIN            use this executable
#   MAJORDOMUS_BUILD_PROFILE  debug (default) or release
#   MAJORDOMUS_BANNER         auto (default), full, compact or off
#   MAJORDOMUS_RUNTIME        auto (default) or off — whether entry brings the runtime up
#
# Exit codes are the executable's, except that a missing executable is 0: this runs on
# every `cd`, and a non-zero exit there makes direnv report the whole environment failed.
set -eu

here="$(unset CDPATH; cd -- "$(dirname -- "$0")" && pwd)"
root="$(unset CDPATH; cd -- "$here/.." && pwd)"

# shellcheck source=../lib/rust_bin.sh
. "$root/lib/rust_bin.sh"

bin="$(mj_rust_bin "$root")"
share="$(mj_rust_share "$root")"
if [ -n "$share" ]; then
  export MAJORDOMUS_SHARE="$share"
fi

if [ ! -x "$bin" ]; then
  # One line, on stderr, naming a recipe this repository really has. Nothing is built
  # here: a shell prompt is not the place to start a compiler. Plain text, because the
  # one thing that must never happen on a `cd` is an escape sequence somebody's terminal
  # does not understand.
  #
  # It names what is gone, not only what is missing: everything this repository shows a
  # person — the banner, `just`, the completion, the shared server — is a projection of
  # this one file, so they all disappear together and none of them says why.
  printf 'majordomus: the executable is not built, so the banner, the `just` bridge, the completion and the shared server are all unavailable; run `just build`\n' >&2
  # One more line, and only when it is the line that answers the question actually being
  # asked. A path outside this checkout was never this checkout's to rely on: it belongs to
  # another one, and everything here disappeared the moment its owner reclaimed it. Without
  # this the loss looks like a defect in the tree the person is standing in.
  if mj_rust_outside "$root" "$bin"; then
    printf 'majordomus: (it is %s, outside this checkout: a build directory another checkout owns can be removed by its owner at any time)\n' "$bin" >&2
  fi
  exit 0
fi

# Present, but older than the sources it was built from. This is the quieter half of the
# same failure and the more misleading one: everything still answers, and answers with code
# that is no longer in the tree. Nothing is built here either — entering a directory must
# not start a compiler — so this is one line, and the work goes on with what is there.
if mj_rust_stale "$root" "$bin"; then
  printf 'majordomus: the executable is older than the sources; what follows is the previous build. Run `just build`\n' >&2
  # And no runtime from it. Since ADR 0043 entering this repository brings its shared server
  # up, and a server started from stale code answers with a tree that is no longer there —
  # to the Cockpit, to the API, and to every other worker attached to it, none of whom can
  # see that the process is older than the checkout it claims to serve. That is the same
  # refusal `lib/capture.sh` makes on the agent's entry path, decided by the same function,
  # so a checkout where the two paths disagree cannot exist.
  #
  # Exported into this process only: direnv applies the assignments on stdout and nothing
  # else, so it does not follow the person into their shell. When they build, the next `cd`
  # ensures a runtime from the executable they just built.
  export MAJORDOMUS_RUNTIME=off
fi

# The log is off unless somebody asked for it: entering a directory must not print
# diagnostics, and `MAJORDOMUS_LOG=debug` still turns them on for whoever is debugging.
export MAJORDOMUS_LOG="${MAJORDOMUS_LOG:-error}"

exec "$bin" env "$@"
