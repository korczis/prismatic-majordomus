#!/usr/bin/env bash
# release-check — the gate of project.release-is-a-projection: the version is authored in one
# place and written by one command, and the changelog is composed rather than kept.
#
# `majordomus generate --check` already proves that docs/generated/changelog.* and
# share/version.txt are what the generator would write from this tree today, and the
# `version-authored-once` gate refuses a version written down by hand where the tool's files
# live. Neither can prove the things below, because they are about declarations generation
# never reads:
#
#   1. The one place the version is authored is named twice: by the crate's writer in
#      apps/majordomus-cli/src/release/version.rs (MANIFEST) and by the one shell reader,
#      scripts/release-version, which reads it from a tree that may have no toolchain. Two
#      readers of one place is tolerable; two that have drifted is a writer raising a file
#      the release never reads, and nothing else notices until a tag is cut.
#   2. The shell tool prints the authority. It reads share/version.txt, the manifest's
#      projection, because an installed tree has no Cargo.toml; `generate --check` proves the
#      file is current, and this proves the tool reads it. The comparison is not made here:
#      scripts/release-version --check makes it, and check 1 proves it reads the right file.
#      A third parser here would be the duplication this gate exists to catch.
#   2b. The lock records the version the manifest declares, so the next --locked build
#      survives the bump.
#   3. Nothing may keep a changelog by hand. A composed changelog and a maintained
#      CHANGELOG.md are two answers to one question, and the maintained one wins by being
#      the file people open. A page that renders the derived document is a projection and is
#      not this: only the two conventional homes of an authored changelog are refused.
#   4. The version the tree declares is never behind the newest release the layer records:
#      a published 1.2.0 with a tree that still says 1.1.0 means the bump was never made.
#   5. Every published tag has a release record. A tag without one is a release that was
#      published to the world and never reached the layer every projection is composed from,
#      which is what a failure in the publish job looks like from the outside: nothing red,
#      and an installer that goes on serving the previous version. A tag whose record is
#      proposed — a fresh release/record-<tag> branch carries it — is pending, not missing,
#      so the window between a tag and its record's merge turns no unrelated head red. So is
#      a tag whose release is still in flight (I2712): its release run queued or running, or
#      no run concluded yet and no GitHub release published — asked of the forge, see 5.
#
#   scripts/ci/release-check                report every finding, exit 10 on any
#   MJ_ROOT=<dir> scripts/ci/release-check  against another tree (the behavioural case does)
#   MJ_RELEASE_CHECK_REPO=<owner/name>      the GitHub repository whose release runs are asked
#                                           (default: the one `origin` points at, if any)
#
# Exit: 0 clean, 10 findings, 12 unusable.
set -eu
ROOT="${MJ_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
cd "$ROOT"
findings=0
ok()   { printf 'ok    %s\n' "$*"; }
fail() { printf 'FAIL  %s\n' "$*"; findings=$((findings+1)); }

MODULE=apps/majordomus-cli/src/release/version.rs
SCRIPT=scripts/release-version
[ -f "$MODULE" ] || { echo "release-check: $MODULE is missing" >&2; exit 12; }
[ -f "$SCRIPT" ] || { echo "release-check: $SCRIPT is missing" >&2; exit 12; }

# -------------------------------------------- 1. the one authored place is named the same
# Both declarations are read; neither is written here, so this gate cannot become another
# copy of the fact it is holding together.
rust_const() { sed -n "s/^pub const $1: &str = \"\\([^\"]*\\)\";/\\1/p" "$MODULE" | head -n 1; }
sh_path()    { sed -n "s|^$1=\"\\\$ROOT/\\(.*\\)\"\$|\\1|p" "$SCRIPT" | head -n 1; }

from_rust="$(rust_const MANIFEST)"
from_shell="$(sh_path MANIFEST)"
if [ -z "$from_rust" ] || [ -z "$from_shell" ]; then
  fail "the place the version is authored is not declared in both $MODULE and $SCRIPT (rust '$from_rust', shell '$from_shell')"
elif [ "$from_rust" = "$from_shell" ]; then
  ok "the version is authored in $from_rust, for both the crate's writer and the release script"
else
  fail "the place the version is authored has drifted: the crate writes $from_rust and $SCRIPT reads $from_shell"
fi

MANIFEST_PATH="$from_rust"
PROJECTION_PATH="$(rust_const PROJECTION)"

# The authority, asked of the one shell reader. Independent of check 2: a projection that is
# stale does not make the manifest unreadable, and the checks below still need the version.
crate=""
if [ -n "$MANIFEST_PATH" ] && [ -f "$MANIFEST_PATH" ]; then
  crate="$("$SCRIPT" 2>/dev/null || true)"
fi

# ------------------------------------------------------ 2. the shell tool prints the authority
#
# Asked of scripts/release-version, never parsed again here: it reads the manifest and asks
# bin/majordomus what it prints, which is what the installer and a person see.
if [ -z "$crate" ]; then
  fail "$MANIFEST_PATH declares no version, or does not exist"
elif version_out="$("$SCRIPT" --check 2>&1)"; then
  ok "bin/majordomus prints $crate, the version $MANIFEST_PATH declares"
else
  printf '%s\n' "$version_out" | sed -n 's/^release-version: FAIL /      /p' | while IFS= read -r line; do
    printf '%s\n' "$line"
  done
  fail "the shell tool does not print the version the crate declares (scripts/release-version --check); ${PROJECTION_PATH:-its projection} is generated — run scripts/derive, and never edit it or bin/majordomus"
fi

# ------------------------------------------------- 2b. the lock records the version too
#
# Cargo.lock is not a declaration — cargo derives it from the manifest and nobody chooses the
# value — but it is tracked and the build runs `--locked`, so a bump that raised the manifest
# and left the lock behind fails the next build with "cannot update the lock file", which
# reads as a toolchain fault rather than as a half-applied bump, and fails every launcher
# call with it. The writer keeps the crate's entry in step (release/version.rs, LOCK); this
# is what notices when something else edited one of them.
LOCK_PATH="$(rust_const LOCK)"
if [ -n "$LOCK_PATH" ] && [ -f "$LOCK_PATH" ] && [ -n "$crate" ]; then
  locked="$(awk '/^name = "majordomus-cli"$/{f=1;next} f && /^version = /{gsub(/[^0-9A-Za-z.+-]/,"",$3); print $3; exit}' "$LOCK_PATH")"
  if [ "$locked" = "$crate" ]; then
    ok "$LOCK_PATH records $locked for this crate"
  else
    fail "$LOCK_PATH records '$locked' for this crate and the manifest states '$crate'; the next --locked build fails — \`majordomus release bump --exact $crate\` keeps the lock in step, as does \`cargo update -p majordomus-cli --offline --manifest-path $MANIFEST_PATH\`"
  fi
elif [ -n "$LOCK_PATH" ] && [ ! -f "$LOCK_PATH" ]; then
  fail "the crate declares the lock $LOCK_PATH and it does not exist"
fi

# ------------------------------------------------------------------- 3. no changelog is kept
# The two conventional homes of an authored changelog, and only those: a site page whose body
# renders the derived document is a projection, and the generated tree is the projection.
authored=0
for f in \
  [Cc][Hh][Aa][Nn][Gg][Ee][Ll][Oo][Gg]* \
  docs/[Cc][Hh][Aa][Nn][Gg][Ee][Ll][Oo][Gg]*
do
  [ -f "$f" ] || continue
  case "$f" in docs/generated/*) continue ;; esac
  fail "$f is an authored changelog; the changelog is composed by \`majordomus release changelog\` and written by \`majordomus generate changelog\` into docs/generated/"
  authored=$((authored+1))
done
if [ "$authored" = 0 ]; then ok "no changelog is kept by hand"; fi

# ----------------------------------------------- 4. the tree is not behind what was published
newest=""
for r in .ai/repo/releases/*.yaml; do
  [ -f "$r" ] || continue
  v="$(sed -n 's/^version: *"\{0,1\}\([0-9][0-9.]*\)"\{0,1\} *$/\1/p' "$r" | head -n 1)"
  [ -n "$v" ] || continue
  newest="$(printf '%s\n%s\n' "$newest" "$v" | grep -v '^$' | LC_ALL=C sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)"
done
if [ -z "$newest" ] || [ -z "$crate" ]; then
  ok "no published release to compare the declared version with"
else
  behind="$(printf '%s\n%s\n' "$crate" "$newest" | LC_ALL=C sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)"
  if [ "$behind" = "$crate" ]; then
    ok "the tree declares $crate and the newest release is $newest"
  else
    fail "the tree declares $crate and $newest is already published; the bump that released it was never made"
  fi
fi

# ------------------------------------------ 5. every published tag has a record in the layer
#
# The failure this exists for: v0.7.0 published six archives and a GitHub Release, and the
# step that proposes the record's pull request then failed — run 34965490909, where the
# publish job held no `pull-requests: write`, so `gh pr create` wrote nothing and its
# fallback printed `no pull requests found for branch "release/record-v0.7.0"`. Every place
# a person looks said released: the tag, the release page, the crate's version, the site's
# version. Master held no record, so the published releases/latest.json went on naming the
# previous version and the advertised installer went on installing it. Nothing was red but
# one job in a workflow nobody was watching.
#
# The executable already names this state — as a *warning*, inside the baseline it resolves
# for `release analyze` (apps/majordomus-cli/src/release/compat.rs, diagnostic
# `tag-without-record`). A warning is what four hours of a wrong installer looks like, and
# `release version`, the report a person actually opens, prints nothing about it at all.
# This gate is what turns the same fact into a verdict. It does not ask the executable for
# it: this gate runs in the `structure` job, which has no toolchain, and `release analyze`
# refuses outright in a tree that committed no registry — so what is read here is the two
# things a record is made of, git's tags and the layer's records, and nothing is decided
# that those files do not state.
#
# Debt is recorded, never absorbed: a tag listed in the baseline below, with the reason that
# clears it, is excused and still named as debt; a line the tree has outgrown is reported so
# the list cannot rot.
RECORD_BASELINE=".ai/repo/release-record-baseline.txt"
excused_list=""
if [ -f "$RECORD_BASELINE" ]; then
  excused_list="$(sed -e 's/#.*//' -e 's/[[:space:]]*$//' "$RECORD_BASELINE" | grep -v '^[[:space:]]*$' || true)"
fi

# a record is named after its tag, or names it
recorded_tag() {
  if [ -f ".ai/repo/releases/$1.yaml" ]; then return 0; fi
  grep -l "^tag: *$1 *\$" .ai/repo/releases/*.yaml >/dev/null 2>&1
}

# A record that is proposed and has not landed yet (I2054). The publish job pushes the record
# to release/record-<tag> and opens its pull request from there; that pull request then needs
# a full run of its own before it can merge, about two hours. Refusing every head in that
# window turned each tag into a stopped queue: on 2026-10-08 (v0.17.0) four pull requests went
# red on this one finding, and on 2026-10-14 every branch did between the v0.25.0 tag (13:15Z)
# and its record's merge (14:17Z), none of them about releases.
#
# The proposal is read from git, never from the forge: the structure job checks out with
# fetch-depth 0, which fetches every branch as refs/remotes/origin/*, so the record's branch is
# already here and asking GitHub for open pull requests would make a structure gate depend on
# the network and a token. A branch only counts when its tip carries the record itself, and
# only while that tip is younger than the grace (MJ_RELEASE_RECORD_GRACE_HOURS, default 24): a
# record branch left behind by a closed pull request must not excuse the tag for ever, so once
# the window has passed the tag is missing again and every head says so. What still fails at
# once: a tag with no record and no branch proposing one — the v0.7.0 state, where the publish
# job could not open the pull request at all.
RECORD_GRACE_HOURS="${MJ_RELEASE_RECORD_GRACE_HOURS:-24}"
case "$RECORD_GRACE_HOURS" in ''|*[!0-9]*)
  echo "release-check: MJ_RELEASE_RECORD_GRACE_HOURS must be a whole number of hours, not '$RECORD_GRACE_HOURS'" >&2
  exit 12 ;;
esac
now_epoch="$(date -u +%s)"

# A release still in flight (I2712). Between the tag push and the moment the publish job
# pushes release/record-<tag> there is no record and no record branch, and the release is not
# published either: its run is building. On 2026-10-14 18:37Z the structure job of #1146 failed
# here on v0.26.0 while release run 38613749519 was still waiting for its macOS build and no
# GitHub release existed — every branch judged in that window was red for nothing of its own.
#
# This is the one question git cannot answer, so it is asked of the forge, and only for a tag
# that already has no record and no proposal. What it says, for tag t:
#   a release run of t queued or running              -> pending, naming the run
#   no run of t listed and no GitHub release of t      -> pending while the tag is younger than
#                                                         the grace (the run is being created)
#   a run concluded (any way) and still nothing        -> the finding stands, naming the run
#   the forge cannot be asked                          -> the finding stands, and a note says
#                                                         why it was not asked
# It cannot be asked without gh, without a token gh accepts, or when no GitHub repository is
# known (MJ_RELEASE_CHECK_REPO, else the `origin` remote's URL). That is the safe side: what
# could not be read never excuses a tag, so offline the gate is what it was before — strict.
# The structure job runs this gate with GH_TOKEN, so on CI the forge is asked.
release_repo() {
  if [ -n "${MJ_RELEASE_CHECK_REPO:-}" ]; then printf '%s' "$MJ_RELEASE_CHECK_REPO"; return 0; fi
  git remote get-url origin 2>/dev/null \
    | sed -n 's#^.*github\.com[:/]\([^/][^/]*/[^/][^/]*\)$#\1#p' | sed 's/\.git$//'
}
# prints "pending <phrase>" or "stands <phrase>"; the phrase is printed either way
release_in_flight() {
  local t="$1" repo runs active done_run rel_rc age made
  repo="$(release_repo)"
  if [ -z "$repo" ]; then printf 'stands no GitHub repository is known (MJ_RELEASE_CHECK_REPO, or an origin on github.com), so its release run was not asked'; return 0; fi
  if ! command -v gh >/dev/null 2>&1; then printf 'stands gh is not installed, so the release run of %s in %s was not asked' "$t" "$repo"; return 0; fi
  if ! runs="$(gh api "repos/$repo/actions/workflows/release.yml/runs?branch=$t&per_page=20" 2>/dev/null)" \
     || ! printf '%s' "$runs" | jq -e '.workflow_runs' >/dev/null 2>&1; then
    printf 'stands the release runs of %s in %s could not be read (gh, its token, or the network)' "$t" "$repo"; return 0
  fi
  active="$(printf '%s' "$runs" | jq -r '[.workflow_runs[] | select(.status != "completed")] | sort_by(.created_at) | last | select(.) | "\(.id) (\(.status)) \(.html_url // "")"')"
  if [ -n "$active" ]; then printf 'pending its release run %s is still going' "$active"; return 0; fi
  done_run="$(printf '%s' "$runs" | jq -r '.workflow_runs | sort_by(.created_at) | last | select(.) | "\(.id) (\(.conclusion // "no conclusion"))"')"
  if [ -n "$done_run" ]; then printf 'stands its release run %s has concluded' "$done_run"; return 0; fi
  rel_rc=0; gh api "repos/$repo/releases/tags/$t" >/dev/null 2>&1 || rel_rc=$?
  if [ "$rel_rc" = 0 ]; then printf 'stands GitHub holds a release of %s and no release run of it is listed' "$t"; return 0; fi
  # the tag's own date when it is annotated, its commit's when it is not: never later than
  # the push, so the grace can only close early, never stay open past its hours
  made="$(git for-each-ref --format='%(creatordate:unix)' "refs/tags/$t" 2>/dev/null || true)"
  case "$made" in ''|*[!0-9]*) made="$now_epoch" ;; esac
  age="$(( (now_epoch - made) / 3600 ))"
  if [ "$age" -lt "$RECORD_GRACE_HOURS" ]; then
    printf 'pending no release run of it is listed yet and GitHub holds no release of it (%sh old, grace %sh)' "$age" "$RECORD_GRACE_HOURS"
  else
    printf 'stands no release run of it was ever listed and GitHub holds no release of it, %sh after the tag' "$age"
  fi
}
# prints "<ref> <age in hours>" for the freshest branch that proposes the tag's record
proposed_record() {
  git for-each-ref --sort=-committerdate --format='%(refname) %(committerdate:unix)' \
    "refs/heads/release/record-$1" "refs/remotes/*/release/record-$1" 2>/dev/null |
    while read -r ref when; do
      git cat-file -e "$ref:.ai/repo/releases/$1.yaml" 2>/dev/null || continue
      printf '%s %s\n' "${ref#refs/}" "$(( (now_epoch - when) / 3600 ))"
      break
    done
}

if ! command -v git >/dev/null 2>&1 || ! git rev-parse --git-dir >/dev/null 2>&1; then
  # Never quietly: a measurement that could not be taken is reported, because a gate that
  # skips is indistinguishable from a gate that passed — project.never-reported-is-not-green.
  fail "the published tags could not be read here — this tree is not a git checkout, or git is unavailable — so 'every published tag has a record' was not measured"
else
  # Local tags, after a fetch: the same list the pipeline tags from, read without a token.
  # `git ls-remote --tags origin` would ask the forge for a fact a fetched clone already
  # holds, and would make this gate fail on a machine with no network.
  # v<major>.<minor>.<patch> exactly: that is what the release workflow cuts, and it refuses
  # to publish a tag that does not agree with the crate's version, so a tag with a suffix
  # (v0.2.0-ai-documents) named something else and never published a release.
  tags="$(git tag --list 'v[0-9]*' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | LC_ALL=C sort -u || true)"
  if [ -z "$tags" ]; then
    # No tags is two different states, and only one of them is fine. A repository that has
    # published nothing has no tags and no records; a checkout whose tags were not fetched
    # has records and no tags, and answering "nothing to compare" there would be the quiet
    # pass this check exists to remove. The structure job checks out with fetch-depth 0 for
    # exactly this reason, so the second state means the fetch, not the tree, is what failed.
    if [ -n "$newest" ]; then
      fail "the layer records releases (newest $newest) and this checkout lists no version tag, so 'every published tag has a record' was not measured — fetch the tags (git fetch --tags, or actions/checkout with fetch-depth: 0)"
    else
      ok "this checkout carries no version tag and the layer records no release: nothing has been published"
    fi
  else
    missing=0
    excused=0
    pending=0
    inflight=0
    for t in $tags; do
      if recorded_tag "$t"; then continue; fi
      if printf '%s\n' "$excused_list" | grep -qx "$t"; then
        ok "$t has no release record and is recorded debt in $RECORD_BASELINE"
        excused=$((excused+1))
        continue
      fi
      proposal="$(proposed_record "$t")"
      if [ -n "$proposal" ]; then
        pref="${proposal% *}"
        page="${proposal##* }"
        if [ "$page" -lt "$RECORD_GRACE_HOURS" ]; then
          printf 'pending %s is published and its record is proposed on %s (%sh old, grace %sh) and not yet on this head; nothing for this head to do — the record lands with its own pull request\n' \
            "$t" "$pref" "$page" "$RECORD_GRACE_HOURS"
          pending=$((pending+1))
          continue
        fi
        missing=$((missing+1))
        fail "$t is published and its record has waited on $pref for ${page}h, longer than the ${RECORD_GRACE_HOURS}h grace, without landing; merge its pull request, or close it and write the record again with scripts/release-record"
        continue
      fi
      flight="$(release_in_flight "$t")"
      case "$flight" in
        pending\ *)
          printf 'pending %s is tagged and its release is still in flight: %s; nothing for this head to do — the release proposes its record when it publishes\n' \
            "$t" "${flight#pending }"
          inflight=$((inflight+1))
          continue ;;
        *) printf 'note  %s: %s\n' "$t" "${flight#stands }" ;;
      esac
      missing=$((missing+1))
      fail "$t is published and the layer holds no release record for it (.ai/repo/releases/$t.yaml is missing) and no release/record-$t branch proposes one; the site's releases/latest.json, the installation guide and every baseline are composed from the records, so this release is invisible to them and the advertised installer still installs the previous one — scripts/release-record writes it"
    done
    # Said as it is: a tree carrying excused or pending tags has not been proved clean, and a
    # summary that read "every published tag has a record" over a baseline or a proposal would
    # be the quiet pass this check exists to remove.
    if [ "$missing" = 0 ] && [ "$excused" = 0 ] && [ "$pending" = 0 ] && [ "$inflight" = 0 ]; then
      ok "every published tag this checkout carries has a release record"
    elif [ "$missing" = 0 ]; then
      except=""
      [ "$excused" = 0 ] || except="the $excused recorded as debt in $RECORD_BASELINE"
      if [ "$pending" != 0 ]; then
        except="${except:+$except and }the $pending whose record is proposed and not yet landed"
      fi
      if [ "$inflight" != 0 ]; then
        except="${except:+$except and }the $inflight whose release is still in flight"
      fi
      ok "every published tag has a release record except $except"
    fi
    for e in $excused_list; do
      if recorded_tag "$e" || ! printf '%s\n' "$tags" | grep -qx "$e"; then
        printf 'note  %s is excused in %s and no longer needs to be: delete the line\n' "$e" "$RECORD_BASELINE"
      fi
    done
  fi
fi

if [ "$findings" -eq 0 ]; then
  if [ "${inflight:-0}" -gt 0 ]; then
    printf 'release-check: the release is a projection — authored once, the tool prints it, no kept changelog, every published tag recorded, its record proposed or its release still in flight (%s pending)\n' "$(( ${pending:-0} + inflight ))"
    exit 0
  fi
  if [ "${pending:-0}" -gt 0 ]; then
    printf 'release-check: the release is a projection — authored once, the tool prints it, no kept changelog, every published tag recorded or its record proposed (%s pending)\n' "$pending"
    exit 0
  fi
  printf 'release-check: the release is a projection — authored once, the tool prints it, no kept changelog, every published tag recorded\n'
  exit 0
fi
printf 'release-check: %s finding(s)\n' "$findings" >&2
exit 10
