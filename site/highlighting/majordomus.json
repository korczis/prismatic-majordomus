{
  "name": "majordomus",
  "type": "light",
  "colors": {
    "editor.foreground": "#000000",
    "editor.background": "#ffffff"
  },
  "tokenColors": [
    {
      "name": "code-comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "markup.quote"
      ],
      "settings": {
        "foreground": "#000001",
        "fontStyle": "italic"
      }
    },
    {
      "name": "code-keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "markup.list punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#000002"
      }
    },
    {
      "name": "code-string",
      "scope": [
        "string",
        "string.unquoted",
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw",
        "markup.inserted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#000003"
      }
    },
    {
      "name": "code-constant",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#000004"
      }
    },
    {
      "name": "code-function",
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.command",
        "meta.diff.range",
        "meta.diff.header",
        "markup.underline.link",
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#000005"
      }
    },
    {
      "name": "code-type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.section",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#000006"
      }
    },
    {
      "name": "code-tag",
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name",
        "support.type.property-name",
        "meta.object-literal.key",
        "variable.other.key",
        "variable.other.normal",
        "variable.other.special",
        "variable.other.positional",
        "variable.other.bracket",
        "variable.parameter",
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#000007"
      }
    },
    {
      "name": "plain",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "style bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "style italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "style bold",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "style strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    }
  ],
  "x-majordomus-generated": "GENERATED FILE — DO NOT EDIT DIRECTLY; source: apps/majordomus-cli/src/highlight.rs, the kinds of token the highlighter tells apart; regenerate with `majordomus generate`",
  "x-majordomus-generator": "majordomus-cli 1.0.0-alpha.10"
}
