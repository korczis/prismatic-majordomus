{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://majordomus.dev/schemas/taxonomy.schema.json",
  "title": "Use-case taxonomy",
  "description": "The categories use cases are filed under, .ai/repo/use-cases/taxonomy.yaml: presentation metadata only; membership is each use case's own `category`, and every count, page and index is derived.",
  "x-majordomus-allow": "taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "categories"],
  "properties": {
    "version": { "const": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "summary", "order"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
