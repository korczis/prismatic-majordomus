#!/usr/bin/env bash
# site-check — prove the built site is what it claims to be. Read-only.
#
# Runs against public/ after scripts/site-build. Every check either passes or names the
# file and the reason. Nothing here reformats, rewrites, or regenerates anything.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 1
OUT="$ROOT/public"
FAILED=0
bad()  { printf 'FAIL %-10s %s\n' "$1" "$2" >&2; FAILED=1; }
good() { printf 'OK   %-10s %s\n' "$1" "$2"; }
step() { printf '\n== %s\n' "$1"; }

[ -d "$OUT" ] || { printf 'site-check: no public/ — run scripts/site-build first\n' >&2; exit 1; }
PAGES="$(find "$OUT" -name 'index.html' | sort)"
NPAGES="$(printf '%s\n' "$PAGES" | wc -l | tr -d ' ')"
BASE_URL="$(sed -n 's|^base_url = "\(.*\)"|\1|p' site/config.toml)"
BASE_URL="${BASE_URL%/}"

# A page with every <pre> block and <code> span removed. A shell example that mentions
# $HOME, or a documentation page that prints a template delimiter, is content — not a
# build failure — and only the surrounding markup is scanned for those.
strip_code() {
  awk '{ line = $0
         if (line ~ /<pre/) { inpre = 1 }
         if (inpre) { if (line ~ /<\/pre>/) inpre = 0; next }
         gsub(/<code[^>]*>[^<]*<\/code>/, "", line)
         print line }' "$1"
}
# the path component of base_url, e.g. /prismatic-majordomus — every root-absolute path
# the site emits has to carry it or it 404s once deployed
PREFIX="$(printf '%s' "$BASE_URL" | sed -e 's|^https\?://[^/]*||' -e 's|/$||')"

SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/mj.sc.XXXXXX")"
trap 'rm -rf "$SCRATCH"' EXIT

step "canonical data"
scripts/generate-site-data --check | sed 's/^/  /' || FAILED=1

step "derivation is current"
# The site must be built from the working tree it is being checked against. Regenerate
# into a scratch directory and compare: a stale public/ is a site that quietly disagrees
# with the repository it was produced from.
TMP="$SCRATCH/derivation"; mkdir -p "$TMP"
cp -R site/data/generated "$TMP/before"
scripts/generate-site-data >/dev/null 2>&1
if diff -r "$TMP/before" site/data/generated >/dev/null 2>&1; then
  good derivation "site/data/generated matches the canonical sources"
else
  bad derivation "site/data/generated is stale; run scripts/site-build"
  diff -r "$TMP/before" site/data/generated | head -20 >&2
fi

step "every route"
for page in $PAGES; do
  route="${page#"$OUT"}"; route="${route%index.html}"
  grep -q '<title>'                        "$page" || bad meta "$route: no title"
  grep -q 'name="description"'             "$page" || bad meta "$route: no meta description"
  grep -q 'rel="canonical"'                "$page" || bad meta "$route: no canonical link"
  grep -q 'property="og:title"'            "$page" || bad meta "$route: no Open Graph title"
  grep -q 'name="twitter:card"'            "$page" || bad meta "$route: no Twitter card"
  grep -q '<main id="main"'                "$page" || bad a11y "$route: no main landmark"
  grep -q 'Skip to content'                "$page" || bad a11y "$route: no skip link"
  n="$(grep -o '<h1' "$page" | wc -l | tr -d ' ')"
  [ "$n" = 1 ] || bad a11y "$route: $n h1 elements, expected exactly 1"
  grep -q 'data-collapse-toggle="navbar-main"' "$page" || bad flowbite "$route: no Flowbite mobile navbar toggle"
  grep -q 'aria-controls="navbar-main"'        "$page" || bad flowbite "$route: navbar toggle without aria-controls"
  grep -q 'js/flowbite.min.js'                 "$page" || bad flowbite "$route: does not load the Flowbite bundle"
  grep -q 'css/app.css'                        "$page" || bad css "$route: does not link the compiled stylesheet"
  grep -qE '<[^>]+ style="'                    "$page" && bad style "$route: inline style attribute"
  strip_code "$page" > "$SCRATCH/prose.html"
  grep -qE '\{\{|\{%'                "$SCRATCH/prose.html" && bad template "$route: unrendered template delimiter"
  grep -qE '\$\{?[A-Z][A-Z_]{2,}\}?' "$SCRATCH/prose.html" && bad template "$route: unexpanded shell variable"
  grep -qE '(href|src)=""'                     "$page" && bad template "$route: empty attribute value"
  # A remote asset is any src=/href= to a host that is not this site and not a documented
  # outbound link. Assets are all local: the site works offline once built.
  remote="$(grep -oE 'src="https?://[^"]+' "$page" | grep -vF "$BASE_URL" | head -n1)"
  [ -n "$remote" ] && bad network "$route: fetches a remote asset ($remote)"
done
[ "$FAILED" = 0 ] && good route "$NPAGES routes with metadata, landmarks, Flowbite assets and no placeholders"

step "deployment prefix"
# GitHub Pages serves this project under a path prefix. Every internal reference must
# carry it, whether it is emitted absolute (get_url) or root-absolute (hand-written).
if [ -n "$PREFIX" ]; then
  miss=0
  for page in $PAGES; do
    n="$(grep -oE '(href|src)="/[^"]*' "$page" | grep -vE "\"$PREFIX(/|\"|\$)" | head -n1)"
    [ -n "$n" ] && { bad prefix "${page#"$OUT"}: root-absolute path without $PREFIX: $n"; miss=1; }
  done
  [ "$miss" = 0 ] && good prefix "every internal reference carries $PREFIX"
else
  good prefix "base_url has no path prefix; nothing to check"
fi

step "internal links"
broken=0
for page in $PAGES; do
  for href in $(grep -oE 'href="[^"#]+' "$page" | sed 's/^href="//' | grep -v '^mailto:'); do
    case "$href" in
      "$BASE_URL"*) target="${href#"$BASE_URL"}" ;;
      https://*|http://*) continue ;;              # a deliberate outbound link
      /*) target="${href#"$PREFIX"}" ;;
      *) continue ;;
    esac
    [ -z "$target" ] && target=/
    if [ -f "$OUT$target" ] || [ -f "$OUT${target%/}/index.html" ]; then continue; fi
    bad link "${page#"$OUT"}: $href does not resolve"; broken=1
  done
done
[ "$broken" = 0 ] && good link "every internal link resolves to a generated route or asset"

step "assets"
for f in css/app.css js/flowbite.min.js js/theme.js js/diagrams.js js/alpine.min.js js/mermaid.min.js giallo-light.css giallo-dark.css favicon.svg; do
  [ -f "$OUT/$f" ] || bad asset "$f is missing from the build"
done
n="$(wc -c < "$OUT/css/app.css" | tr -d ' ')"
if [ "$n" -lt 20000 ]; then bad css "css/app.css is only $n bytes; the Tailwind build looks empty"
elif [ "$n" -gt 900000 ]; then bad css "css/app.css is $n bytes; this looks like an unpurged development build"
else good css "css/app.css is $n bytes, minified and scoped to the generated HTML"; fi
grep -q '^\.dark ' "$OUT/giallo-dark.css" \
  || bad css "giallo-dark.css was not scoped under .dark; code blocks will use the dark palette in light mode"
[ "$FAILED" = 0 ] && good asset "every vendored and generated asset is present"

step "wide content is contained"
# A table, a code block or a diagram that cannot scroll inside its own box makes the whole
# page scroll sideways on a phone. Both are checked structurally rather than visually.
uncontained=0
for page in $PAGES; do
  if grep -q '<table' "$page" && ! grep -qE 'overflow-x-auto|format-table:overflow-x-auto' "$page"; then
    bad responsive "${page#"$OUT"}: a table with no horizontally scrollable container"; uncontained=1
  fi
  if grep -q 'class="mermaid"' "$page" && ! grep -q 'overflow-x-auto' "$page"; then
    bad responsive "${page#"$OUT"}: a Mermaid diagram with no horizontally scrollable container"; uncontained=1
  fi
done
[ "$uncontained" = 0 ] && good responsive "every table and diagram sits in a scrollable container"

step "javascript is a progressive enhancement"
for page in $(grep -l 'x-data' $PAGES); do
  grep -q 'needs JavaScript' "$page" \
    || bad a11y "${page#"$OUT"}: uses Alpine without telling the reader what needs JavaScript"
done
[ "$FAILED" = 0 ] && good a11y "every Alpine-driven filter says so on the page"

step "tables are labelled"
# Markdown has no caption syntax, so this applies to tables a template authored. A page
# rendering canonical Markdown is marked with data-canonical-source and is exempt.
labelled=0
for page in $(grep -l '<table' $PAGES); do
  grep -q 'data-canonical-source' "$page" && continue
  grep -q '<caption' "$page" || { bad a11y "${page#"$OUT"}: a table with no caption"; labelled=1; }
done
[ "$labelled" = 0 ] && good a11y "every template-authored table has a caption"

step "no secrets or private paths"
if grep -rlE '(AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|xox[baprs]-)' "$OUT" >/dev/null 2>&1; then
  bad secrets "a credential pattern appears in the generated output"
else good secrets "no credential pattern in the generated output"; fi
if grep -rlE '/Users/[a-z]+/|/home/[a-z]+/|192\.168\.[0-9]' "$OUT" --include='*.html' >/dev/null 2>&1; then
  bad private "a local path or private address appears in the generated output"
else good private "no local paths or private addresses"; fi

printf '\n'
if [ "$FAILED" = 0 ]; then
  printf 'site-check: ok — %s routes\n' "$NPAGES"; exit 0
fi
printf 'site-check: failed\n' >&2; exit 1
