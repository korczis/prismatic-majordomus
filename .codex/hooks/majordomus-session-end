#!/bin/sh
# The SessionEnd hook: it runs where the provider fires that event, and hands the payload
# to `majordomus capture session --provider codex --event end`. Written by `majordomus capture install`.
#
# The repository is derived from this file, and never from the environment or the
# working directory, neither of which is part of any contract this tool can rely on.
# This provider substitutes nothing into a command string and runs it wherever the
# session was started, so the configuration that names this file finds the checkout
# with git before running it, and this then derives the same root from itself.
#
# It must never reject what the person is doing, so every path out of it is exit 0
# or the exit of a command that is itself contracted never to return 2.
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd) || exit 0
for mj in "$root/bin/majordomus" "$root/.majordomus/bin/majordomus"; do
  [ -x "$mj" ] && break
  mj=
done
[ -n "$mj" ] || mj=$(command -v majordomus) || exit 0
exec "$mj" --repo "$root" capture session --provider codex --event end
