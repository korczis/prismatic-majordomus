#!/usr/bin/env bash
# derive — every committed derived artifact, regenerated from its canonical sources in
# dependency order. The one place the derivation graph is spelled out; `just derive` runs
# this, `scripts/derive-check` proves the result, and CI refuses a tree the check refuses.
#
#   stage A  majordomus generate       the registry's projections that depend on code alone:
#                                      docs/generated/{openapi,registry,cli}.{json,yaml},
#                                      docs/generated/{capabilities,cli}.md, modules/*.md,
#                                      share/allow/*.txt, and the provider bootstraps
#                                      (policy + templates)
#   stage B  scripts/generate-site-data the site's data and content, docs/SITE_CLAIMS.md and
#                                      docs/PLAN_STATUS.md, from the canonical files and from
#                                      stage A's registry.json and openapi.json
#   stage C  majordomus generate       the projections that read the index — the site's
#                                      registry dataset (site/data/registry/registry.json),
#                                      docs/generated/benchmarks.{md,json,yaml} and the
#                                      manifest docs/generated/artifacts.{json,yaml,md} —
#                                      over the tree stage B left, since the documents it
#                                      wrote are objects of the index
#
# No stage reads its own output; stage C's outputs are read by nothing but the site build.
# Running the whole thing twice changes nothing: the second pass is what derive-check
# compares against. docs/GITHUB_PAGES_ARCHITECTURE.md draws the graph.
#
#   MAJORDOMUS_BIN            the Rust executable to use instead of building one
#   MAJORDOMUS_BUILD_PROFILE  debug (default) or release
#   CARGO_TARGET_DIR          where cargo builds, when worktrees share one build directory
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CRATE="$ROOT/apps/majordomus-cli"
PROFILE="${MAJORDOMUS_BUILD_PROFILE:-debug}"
export MAJORDOMUS_SHARE="${MAJORDOMUS_SHARE:-$ROOT/share}"
# for mj_cargo_target_dir: cargo does not necessarily build into "$CRATE/target"
# shellcheck source=../lib/rust_bin.sh
. "$ROOT/lib/rust_bin.sh"

# Progress, on stderr. Stage B writes the whole site data set and runs the use-case scenarios;
# it says nothing at all while it does, and minutes of silence read as a hang — a session has
# already killed a healthy run for it. So each stage names itself as it begins and reports
# what it cost as it ends, which is also what tells the next person which stage is the slow
# one. stderr, because stdout belongs to whatever a caller redirects.
#
# Whole seconds from `date +%s`, the clock scripts/pages times its own steps with. The phase
# timers in lib/common.sh (mj_phase_begin) are a different instrument and not this one: they
# print nothing as a phase begins and report only at exit, under MJ_TIMING. That is what a
# profiler owes; it cannot break a silence while the silence is happening.
now() { date +%s; }
RUN_T0="$(now)"; STAGE_T0=0; STAGE=""
step()     { STAGE="$1"; STAGE_T0="$(now)"; printf '==> derive: %s ...\n' "$1" >&2; }
step_done() { printf '==> derive: %s: %ss\n' "$STAGE" "$(( $(now) - STAGE_T0 ))" >&2; }

# Which executable is about to rewrite every committed artifact, said out loud. A derivation
# run with a borrowed binary looks exactly like one that built its own, and on 2026-09-10 a
# borrowed one of an older generation removed 16,625 lines from a pristine origin/master
# without a word. The executable refuses that now (`majordomus generate` compares its
# generation against the tree's), but a run that names what it is using is a run whose log
# answers "which binary?" without anyone having to guess.
if [ -n "${MAJORDOMUS_BIN:-}" ]; then RB="$MAJORDOMUS_BIN"
  printf '==> derive: MAJORDOMUS_BIN=%s (not building; it must be of this tree'"'"'s generation)\n' "$RB" >&2
else
  # a machine-wide rustflags profile can make a dev build refuse to link; the crate sets none
  mj_rust_space_check "$ROOT" "the build this derivation needs" || exit 12
  step "building the Rust executable ($PROFILE)"
  release=(); [ "$PROFILE" = release ] && release=(--release)
  RUSTFLAGS='' cargo build --quiet --manifest-path "$CRATE/Cargo.toml" "${release[@]}"
  # ask cargo where it put the result rather than compose it: a run that then spends ten
  # minutes can afford the 80ms, and the composed path is what exits 127 under a shared
  # CARGO_TARGET_DIR — the executable is in the shared directory, not under the worktree
  RB="$(mj_cargo_target_dir "$CRATE" ask-cargo)/$PROFILE/majordomus"
  step_done
fi
step "stage A: majordomus generate (code-only projections)"
# --strict: an error diagnostic must not pass for success. A duplicate identity excludes
# every claimant and the index goes on without them, so without this a derivation writes
# projections from a tree that has silently lost documents, and says nothing.
#
# Exit 15 is the executable refusing the tree: it is not of this tree's generation and
# would have rewritten every artifact from a model the tree does not have. Nothing was
# written. The refusal is repeated here because a `set -e` abort in the middle of a
# multi-stage script reads as a crash, and the remedy is the opposite of the reflex.
# `rc=0; cmd || rc=$?` and not `if ! cmd`: after `!` inverts a pipeline, `$?` inside the
# branch is the inverted status — 0 — and the script would exit 0 on a refusal.
rc=0
"$RB" generate --repo "$ROOT" --strict >/dev/null || rc=$?
if [ "$rc" != 0 ]; then
  # a full `if` and not `[ ... ] && printf`: under `set -e` the failing test would end the
  # script with status 1 before the `exit` below could carry the real code out
  if [ "$rc" = 15 ]; then
    printf '==> derive: refused before anything was written; the executable, not the tree, is out of date\n' >&2
  fi
  exit "$rc"
fi
step_done
step "stage B: scripts/generate-site-data (site data, content, derived documents)"
"$ROOT/scripts/generate-site-data"
step_done
step "stage C: majordomus generate (the site dataset and the benchmark matrix over the index)"
"$RB" generate --repo "$ROOT" --strict >/dev/null
step_done
step "stage D: scripts/gitattributes (the merge policy, from the generators)"
# Last, because it reads stage A's artifact manifest and stage B's published content tree:
# the set of files a merge must not try to merge is exactly the set the stages above write,
# and until this ran it was a hand list that was wrong in both directions.
"$ROOT/scripts/gitattributes" >/dev/null
step_done
printf '==> derive: done in %ss; scripts/derive-check proves it\n' "$(( $(now) - RUN_T0 ))" >&2
