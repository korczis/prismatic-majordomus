#!/usr/bin/env bash
# generate-pages — builds the derived GitHub Pages site from canonical repository files.
#
# Canonical content lives in README.md, AGENTS.md, docs/**, share/skeleton/** and
# bin/majordomus. This script transforms it; it never holds a second copy of it. The only
# hand-written prose on the site is site/promo/copy.yaml, which carries no capability
# claims and has a line budget.
#
# Portable shell, matching the rest of this repository: bash 3.2 and BSD userland are the
# floor. It reuses lib/common.sh, so the site is parsed by the same YAML reader the tool
# itself uses. Node is required only for the Tailwind and Flowbite CSS build.
#
#   scripts/generate-pages              generate _site/ and compile the stylesheet
#   scripts/generate-pages --check      validate sources and the generated output, exit non-zero on a problem
#   scripts/generate-pages --no-css     HTML only; skip the Node build
#   scripts/generate-pages --serve      generate, then serve _site/ on localhost
#   scripts/generate-pages --out DIR    write somewhere other than _site/
set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT="$ROOT/_site"
DO_CSS=1; DO_SERVE=0; CHECK_ONLY=0; PORT=8080

MJ_VERSION="site"; MJ_BIN_DIR="$ROOT/bin"; MJ_LIB_DIR="$ROOT/lib"
export MJ_VERSION MJ_BIN_DIR MJ_LIB_DIR
# shellcheck source=../lib/common.sh
# shellcheck source=/dev/null
. "$ROOT/lib/common.sh"

GEN_VERSION="1"
FAILED=0
TMP=""

while [ $# -gt 0 ]; do
  case "$1" in
    --check) CHECK_ONLY=1; shift ;;
    --no-css) DO_CSS=0; shift ;;
    --serve) DO_SERVE=1; shift ;;
    --port) PORT="$2"; shift 2 ;;
    --out) OUT="$2"; shift 2 ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf 'generate-pages: unknown option %s\n' "$1" >&2; exit 2 ;;
  esac
done

say()  { printf '%s\n' "$*"; }
step() { printf '\n== %s\n' "$*"; }
bad()  { printf 'FAIL %-12s %s\n' "$1" "$2"; FAILED=$((FAILED + 1)); }
good() { printf 'OK   %-12s %s\n' "$1" "$2"; }

# shellcheck disable=SC2329  # invoked by the EXIT trap below
cleanup() { [ -n "$TMP" ] && rm -rf "$TMP"; }
trap cleanup EXIT
TMP="$(mktemp -d "${TMPDIR:-/tmp}/mj-site.XXXXXX")"

# ---------------------------------------------------------------- canonical sources
# Every file the site reads. The manifest hashes exactly this list, and --check proves
# each one exists before anything is generated.
SOURCES="README.md
AGENTS.md
LICENSE
docs/DESIGN.md
docs/CLI.md
docs/SCHEMAS.md
docs/CONCEPTS.md
docs/ADOPTION.md
docs/ECONOMICS.md
docs/EXTRACTION_REPORT.md
docs/CLAIMS.yaml
share/skeleton/policy.yaml
share/skeleton/profiles/routine.yaml
share/skeleton/profiles/implementation.yaml
share/skeleton/profiles/debugging.yaml
share/skeleton/profiles/deep-work.yaml
share/skeleton/providers/body.md
bin/majordomus
assets/logo.svg
assets/logo-mark.svg
assets/social-card.png
site/promo/copy.yaml"

# Derived documentation pages: route|source|title|summary
DOCPAGES="concepts|docs/CONCEPTS.md|Concepts|The vocabulary, and the two outcomes people confuse.
design|docs/DESIGN.md|Design|The specification: problem, thesis, models, and what is intentionally absent.
cli|docs/CLI.md|CLI reference|Every command: behaviour, reads and writes, exit codes, output.
schemas|docs/SCHEMAS.md|File schemas|Every file Majordomus reads or writes, with a concrete example.
adoption|docs/ADOPTION.md|Adoption|Day one, week one, several workers, and how to remove it.
economics|docs/ECONOMICS.md|Economics|What v0.1 controls without measuring, and what measuring would take.
extraction-report|docs/EXTRACTION_REPORT.md|Extraction report|How the design was derived: the evidence, the pattern ledger, what was rejected.
contract|AGENTS.md|Repository contract|The operating contract for this repository, itself generated by majordomus update."

# Markdown hrefs rewritten to site routes. Anything not listed keeps its href, and
# --check reports a link that resolves to neither a route nor a repository file.
LINKMAP="docs/DESIGN.md|/docs/design/;docs/CLI.md|/docs/cli/;docs/SCHEMAS.md|/docs/schemas/;docs/CONCEPTS.md|/docs/concepts/;docs/ADOPTION.md|/docs/adoption/;docs/ECONOMICS.md|/docs/economics/;docs/EXTRACTION_REPORT.md|/docs/extraction-report/;docs/CLAIMS.yaml|/guarantees/;docs/README.md|/docs/;AGENTS.md|/docs/contract/;README.md|/;DESIGN.md|/docs/design/;CLI.md|/docs/cli/;SCHEMAS.md|/docs/schemas/;CONCEPTS.md|/docs/concepts/;ADOPTION.md|/docs/adoption/;ECONOMICS.md|/docs/economics/;EXTRACTION_REPORT.md|/docs/extraction-report/;../AGENTS.md|/docs/contract/;../CONTRIBUTING.md|REPO/blob/master/CONTRIBUTING.md;../SECURITY.md|REPO/blob/master/SECURITY.md;CONTRIBUTING.md|REPO/blob/master/CONTRIBUTING.md;SECURITY.md|REPO/blob/master/SECURITY.md;LICENSE|REPO/blob/master/LICENSE;test/cases/|REPO/tree/master/test/cases/;share/skeleton/|REPO/tree/master/share/skeleton/"

# ---------------------------------------------------------------- source helpers
src() { printf '%s/%s' "$ROOT" "$1"; }

# body of one section of a Markdown file; fails loudly when the heading is gone
section() {
  local file="$1" want="$2" level="${3:-2}"
  awk -v want="$want" -v level="$level" -v withheading=0 \
      -f "$ROOT/scripts/lib/section.awk" "$(src "$file")" \
    || { bad section "$file: no level-$level heading '$want' (the site derives a section from it)"; return 1; }
}
codeblock() {
  local file="$1" n="$2"
  awk -v n="$n" -f "$ROOT/scripts/lib/codeblock.awk" "$(src "$file")" \
    || { bad codeblock "$file: fewer than $n fenced code blocks"; return 1; }
}
# Markdown -> HTML for a Flowbite Typography container
md() { awk -v anchors="${2:-0}" -v hlevel="${3:-1}" -v linkmap="$LINKMAP_R" -f "$ROOT/scripts/lib/md2html.awk"; }

esc_html() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'; }

# A page with every <pre> block and <code> span removed. Used by the checks so that a
# shell example inside canonical documentation is not mistaken for a build failure.
strip_code() {
  awk '{ line = $0
         if (line ~ /<pre/) { inpre = 1 }
         if (inpre) { if (line ~ /<\/pre>/) inpre = 0; next }
         gsub(/<code[^>]*>[^<]*<\/code>/, "", line)
         print line }' "$1"
}

# ---------------------------------------------------------------- load configuration
COPY="$TMP/copy.flat"
mj_yaml_flatten "$(src site/promo/copy.yaml)" > "$COPY" 2>/dev/null \
  || { say "generate-pages: site/promo/copy.yaml does not parse"; exit 12; }
c() { mj_yget "$COPY" "$1"; }

SITE_NAME="$(c site.name)"
BASE_URL="$(c site.base_url)"
REPO_URL="$(c site.repo_url)"
SITE_DESC="$(c site.description)"
SOCIAL_DESC="$(c site.social_description)"
[ -n "$SOCIAL_DESC" ] || SOCIAL_DESC="$SITE_DESC"
VERSION="$(sed -n 's/^MJ_VERSION="\(.*\)"/\1/p' "$(src bin/majordomus)" | head -n 1)"
[ -n "$VERSION" ] || { say "generate-pages: cannot read MJ_VERSION from bin/majordomus"; exit 12; }
LINKMAP_R="$(printf '%s' "$LINKMAP" | sed "s#REPO#$REPO_URL#g")"

# The homepage lead is the README's first real paragraph: after the bold one-line
# summary, skipping the badge row, the logo block and the link line, and stopping at the
# first fenced block. Derived, so the README stays the source of the wording.
HERO_LEAD="$(awk '
  /^\*\*/ { started = 1; next }
  !started { next }
  /^```/ { exit }
  /^#/ { exit }
  /^[ \t]*$/ { if (para != "") exit; next }
  /^[[<|!]/ { next }
  { para = para $0 " " }
  END { printf "%s", para }' "$(src README.md)" \
  | sed -e 's/[ ]*$//' -e 's/\*\*//g')"
[ -n "$HERO_LEAD" ] || { say "generate-pages: cannot derive the hero lead from README.md"; exit 12; }

CLAIMS="$TMP/claims.flat"
mj_yaml_flatten "$(src docs/CLAIMS.yaml)" > "$CLAIMS" 2>/dev/null \
  || { say "generate-pages: docs/CLAIMS.yaml does not parse"; exit 12; }
cl() { mj_yget "$CLAIMS" "claims.$1.$2"; }
claim_count() { local i=0; while [ -n "$(cl "$i" id)" ]; do i=$((i + 1)); done; printf '%s' "$i"; }
NCLAIMS="$(claim_count)"

PROFILES="routine implementation debugging deep-work"
pflat() { printf '%s/profile.%s.flat' "$TMP" "$1"; }
for p in $PROFILES; do
  mj_yaml_flatten "$(src "share/skeleton/profiles/$p.yaml")" > "$(pflat "$p")" 2>/dev/null \
    || { say "generate-pages: share/skeleton/profiles/$p.yaml does not parse"; exit 12; }
done
pget() { mj_yget "$(pflat "$1")" "$2"; }

POLICY="$TMP/policy.flat"
mj_yaml_flatten "$(src share/skeleton/policy.yaml)" > "$POLICY" 2>/dev/null \
  || { say "generate-pages: share/skeleton/policy.yaml does not parse"; exit 12; }
pol() { mj_yget "$POLICY" "$1"; }

# ---------------------------------------------------------------- page shell
# Flowbite navbar, footer and dark-mode switcher, per the canonical component markup in
# the Flowbite docs. Interactive parts are Flowbite data attributes; the only JavaScript
# this site adds of its own is the documented theme switcher.

NAVITEMS="/|Home
/getting-started/|Get started
/profiles/|Profiles
/guarantees/|Guarantees
/docs/|Docs"

nav_links() { # $1 = current route
  local cur="$1" href label cls
  printf '%s\n' "$NAVITEMS" | while IFS='|' read -r href label; do
    if [ "$href" = "$cur" ]; then
      cls="block rounded-sm bg-blue-700 px-3 py-2 text-white md:bg-transparent md:p-0 md:text-blue-700 md:dark:text-blue-500"
      printf '        <li><a href="%s" class="%s" aria-current="page">%s</a></li>\n' "$href" "$cls" "$label"
    else
      cls="block rounded-sm px-3 py-2 text-gray-900 hover:bg-gray-100 md:p-0 md:hover:bg-transparent md:hover:text-blue-700 dark:text-white dark:hover:bg-gray-700 dark:hover:text-white md:dark:hover:bg-transparent md:dark:hover:text-blue-500"
      printf '        <li><a href="%s" class="%s">%s</a></li>\n' "$href" "$cls" "$label"
    fi
  done
}

# page_open ROUTE TITLE DESCRIPTION
page_open() {
  local route="$1" title="$2" desc="$3" canon="$BASE_URL$1"
  cat <<HTML
<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$title</title>
<meta name="description" content="$desc">
<link rel="canonical" href="$canon">
<meta property="og:type" content="website">
<meta property="og:site_name" content="$SITE_NAME">
<meta property="og:title" content="$title">
<meta property="og:description" content="$desc">
<meta property="og:url" content="$canon">
<meta property="og:image" content="$BASE_URL/assets/social-card.png">
<meta property="og:image:width" content="1280">
<meta property="og:image:height" content="640">
<meta property="og:image:alt" content="$SITE_NAME — a lightweight supervisory control layer for AI-assisted work">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="$BASE_URL/assets/social-card.png">
<meta name="twitter:title" content="$title">
<meta name="twitter:description" content="$desc">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/app.css">
<script>
  // Flowbite dark-mode switcher, from the Flowbite dark mode guide. Inline in <head> to
  // avoid a flash of the wrong theme. Respects the system preference until the visitor
  // chooses; the choice is then remembered in this browser only.
  if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    document.documentElement.classList.add('dark');
  } else {
    document.documentElement.classList.remove('dark');
  }
</script>
</head>
<body class="bg-white text-gray-900 antialiased dark:bg-gray-900 dark:text-gray-100">
<a href="#main" class="sr-only rounded-b-lg bg-gray-900 px-4 py-2 text-white focus:not-sr-only focus:absolute focus:left-0 focus:top-0 focus:z-50">Skip to content</a>

<header>
  <nav class="sticky top-0 z-30 border-b border-gray-200 bg-white/90 backdrop-blur-sm dark:border-gray-700 dark:bg-gray-900/90">
    <div class="mx-auto flex max-w-screen-xl flex-wrap items-center justify-between gap-2 px-4 py-3">
      <a href="/" class="flex items-center gap-2.5">
        <img src="/assets/logo-mark.svg" class="h-7 w-7 text-gray-900 dark:text-white" alt="">
        <span class="self-center whitespace-nowrap text-lg font-semibold tracking-tight dark:text-white">Majordomus</span>
        <span class="hidden rounded-sm bg-gray-100 px-2 py-0.5 font-mono text-xs font-medium text-gray-600 sm:inline dark:bg-gray-700 dark:text-gray-300">v$VERSION</span>
      </a>
      <div class="flex items-center gap-1 md:order-2">
        <button id="theme-toggle" type="button" class="rounded-lg p-2.5 text-gray-500 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-700">
          <span class="sr-only">Toggle dark mode</span>
          <svg id="theme-toggle-dark-icon" class="hidden h-5 w-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
          <svg id="theme-toggle-light-icon" class="hidden h-5 w-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
        </button>
        <a href="$REPO_URL" class="hidden rounded-lg border border-gray-200 px-3 py-1.5 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-100 sm:inline-block dark:border-gray-600 dark:text-white dark:hover:bg-gray-700 dark:focus:ring-gray-700">GitHub</a>
        <button data-collapse-toggle="navbar-main" type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-lg p-2 text-sm text-gray-500 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 md:hidden dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600" aria-controls="navbar-main" aria-expanded="false">
          <span class="sr-only">Open main menu</span>
          <svg class="h-5 w-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"/></svg>
        </button>
      </div>
      <div class="hidden w-full md:order-1 md:block md:w-auto" id="navbar-main">
        <ul class="mt-3 flex flex-col rounded-lg border border-gray-100 bg-gray-50 p-3 font-medium md:mt-0 md:flex-row md:space-x-7 md:border-0 md:bg-transparent md:p-0 dark:border-gray-700 dark:bg-gray-800 md:dark:bg-transparent">
$(nav_links "$route")
        </ul>
      </div>
    </div>
  </nav>
</header>

<main id="main">
HTML
}

