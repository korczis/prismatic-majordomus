<style>
/* Handbook additions: grouped rail with scroll-spy, part dividers, see-also asides, glossary, clickable schematics. */
.shell { max-width: 1160px; }
@media (min-width: 1000px) { .shell { grid-template-columns: 236px minmax(0, 1fr); } }
nav.rail details > summary { list-style: none; cursor: pointer; font: 600 12px/1 var(--display); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); padding: 4px 0 10px; }
nav.rail details > summary::-webkit-details-marker { display: none; }
nav.rail details > summary::after { content: " +"; }
nav.rail details[open] > summary::after { content: " −"; }
nav.rail p.grp { margin: 14px 0 4px; font: 600 11px/1.3 var(--display); letter-spacing: .1em; text-transform: uppercase; }
nav.rail p.grp a { color: var(--muted); border: 0; font: inherit; padding: 0; }
nav.rail ol { gap: 4px 14px; }
@media (min-width: 1000px) { nav.rail ol { gap: 0; } }
nav.rail li { margin: 0; }
nav.rail ol a { font-size: 13.5px; }
nav.rail a[aria-current="true"] { color: var(--accent); border-bottom-color: var(--accent); }
@media (min-width: 1000px) { nav.rail { padding-bottom: 32px; } }

.part { font: 600 12px/1 var(--display); letter-spacing: .14em; text-transform: uppercase; color: var(--accent); margin: 88px 0 0; padding-top: 16px; border-top: 2px solid var(--accent); scroll-margin-top: 24px; }
.part + section { padding-top: 22px; }
.small { font-size: 13.5px; color: var(--muted); }

.facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 18px 0 8px; max-width: 720px; }
@media (min-width: 700px) { .facts { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
.facts > div { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 12px 14px; min-width: 0; }
.facts b { display: block; font: 700 28px/1.1 var(--display); font-variant-numeric: tabular-nums; }
.facts span { display: block; font-size: 13px; color: var(--muted); margin-top: 4px; }
.facts code { font-size: 12px; }

.see { margin: 22px 0 0; padding: 10px 14px; border: 1px dashed var(--line); border-radius: 6px; font-size: 14px; max-width: 68ch; }
.see span { font: 600 11.5px/1 var(--display); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-right: 6px; }

table.hub td:first-child { font-weight: 600; }
table.hub td:last-child { white-space: normal; }

.three { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; margin: 16px 0 22px; }
@media (min-width: 760px) { .three { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
ol.path { margin: 0; padding-left: 20px; font-size: 14.5px; }
ol.path li { margin-bottom: 4px; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0 18px; }
.chips code { font-size: 13px; }
.steps h4 { margin: 5px 0 4px; font: 600 17px/1.3 var(--display); }
.card p:last-child { margin-bottom: 0; }

svg a { cursor: pointer; }
svg a .hit rect { transition: stroke .12s; }
svg a:hover .hit rect, svg a:focus .hit rect { stroke: var(--accent); stroke-width: 2; }
svg a:focus { outline: none; }

.filter { display: block; font: 600 12px/1 var(--display); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin: 6px 0 6px; }
.filter-input { width: 100%; max-width: 420px; font: 15px/1.4 var(--body); color: var(--fg); background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 9px 12px; }
.filter-input:focus { outline: 2px solid var(--link); outline-offset: 1px; }
dl.gloss { margin: 16px 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; border: 1px solid var(--line); border-radius: 6px; background: var(--panel); }
dl.gloss > div { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2px 18px; padding: 9px 14px; border-bottom: 1px solid var(--line); }
dl.gloss > div:last-child { border-bottom: 0; }
@media (min-width: 640px) { dl.gloss > div { grid-template-columns: 190px minmax(0, 1fr); } }
dl.gloss dt { font-weight: 600; }
dl.gloss dd { margin: 0; font-size: 14.5px; min-width: 0; }

header.hero .links { display: flex; flex-wrap: wrap; gap: 8px 18px; margin: 22px 0 0; font-size: 14.5px; }
</style>
