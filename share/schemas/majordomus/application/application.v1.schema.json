  "$defs": {
    "Header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "summary",
        "fits_when",
        "does_not_fit_when",
        "use_cases"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "kind": {
          "const": "application"
        },
        "title": {
          "type": "string",
          "minLength": 1
