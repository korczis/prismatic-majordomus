#!/usr/bin/env bash
# interaction-probe: every interactive control on every page of the built site is exercised in a browser by
# the behaviour spec that claims it, and does what that spec says. Rule: project.every-link-and-control-is-tested.
#
# scripts/ci/interaction-check proves every control is claimed by exactly one spec, from the markup alone. This
# is the other half: each page is opened, the browser classifies its live document with the same isControl()
# rule, node applies the same claims(), and each spec drives every control it claims on that page. A page also
# fails on a console error, an uncaught exception, a request to any origin but the site's own, and a live
# count of a spec's controls that differs from what the markup declares.
#
#   scripts/interaction-probe                     every page that carries a control
#   scripts/interaction-probe --only '/ /why/'    those routes only (a local loop; CI never sets it)
#   scripts/interaction-probe --spec tabs         one spec only
#   MJ_PROBE_JOBS=N                               pages at a time (default: 4)
#   MJ_PROBE_SHARD=K/N                            only shard K of N of the sorted pages, by the one stride
#                                                 scripts/site-probe --partition defines; CI runs the N side by
#                                                 side and its fan-in proves they were every page once (I3602)
#   MJ_PROBE_REPORT=FILE                          write the pages this run drives, after "# shard K/N of M routes",
#                                                 for scripts/site-probe --verify-report
#   MJ_PROBE_LIVE=1                               drive the published site itself rather than site/public: the page
#                                                 list is still this build's, so run it against the commit
#                                                 scripts/pages verify says is served
#   MJ_PROBE_ROUTE_SECONDS=N                      seconds one page may take, from opening it to its last spec, plus
#                                                 2.5 s for every control it declares (default 240); past it the
#                                                 page is a finding and its browser context is closed
#   MJ_PROBE_SPEC_SECONDS=N                       seconds one spec may take on one page, the resize to its width
#                                                 included, plus 2.5 s for every control of it there (default 60)
#
# A shard drives its heaviest pages first: the most controls the markup declares, then the route, so the pages that
# take minutes start while every worker is free rather than meeting the bound at the end of the queue (F02). A page
# or spec that outlives its deadline is a finding naming the page, the step it was at and the seconds, and its
# browser context is closed so the call that hung is released and the worker goes on. A page over 30 s is named as
# it finishes, the slowest ten and p50/p95 are printed at the end, and a SIGTERM names every page still being
# driven and the step it is at, and the findings so far, before the probe exits 143: a shard stopped at its bound
# says what it was doing.
#
# Without a browser: SKIP and exit 0 locally, exit 12 under CI=true. Exit 0 clean, 10 findings, 12 unrunnable.
set -eu
ROOT="${MJ_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
# shellcheck source=../lib/runnable.sh
. "$(cd "$(dirname "$0")/.." && pwd)/lib/runnable.sh" 2>/dev/null || { mj_runs() { command -v "$1" >/dev/null 2>&1; }; mj_runs_why() { printf '%s is not available' "$1"; }; mj_zola_ready() { command -v zola >/dev/null 2>&1; }; mj_zola_why() { printf 'zola is not available'; }; mj_node_env() { :; }; }
mj_node_env "$(cd "$(dirname "$0")/.." && pwd)" || true
LIB="$(cd "$(dirname "$0")/lib" && pwd)"
ONLY=""; SPEC=""
while [ $# -gt 0 ]; do
  case "$1" in
    --only) ONLY="$2"; shift 2 ;;
    --spec) SPEC="$2"; shift 2 ;;
    *) echo "interaction-probe: unknown option $1" >&2; exit 2 ;;
  esac
done
mj_runs node || { echo "interaction-probe: node is required: $(mj_runs_why node)" >&2; exit 12; }
[ -d "$ROOT/site/public" ] || { echo "interaction-probe: site/public missing; run scripts/site-build" >&2; exit 12; }
# playwright belongs to the tool, not to the site under test: MJ_ROOT may name a site with no node_modules at all
TOOL="$(cd "$LIB/../.." && pwd)"
# One stride for both browser probes: site-probe owns the partition and this probe asks it, so a shard of pages
# and a shard of routes are cut by the same rule and verified by the same fan-in. A malformed shard is refused
# before anything is opened, because a shard that quietly drives nothing is the failure the split must not have.
SHARD="${MJ_PROBE_SHARD:-1/1}"
"$TOOL/scripts/site-probe" --partition "$SHARD" < /dev/null > /dev/null 2>&1 \
  || { echo "interaction-probe: MJ_PROBE_SHARD must be K/N with 1 <= K <= N, got '$SHARD'" >&2; exit 2; }
export MJ_PROBE_SHARD_SPEC="$SHARD" MJ_PROBE_PARTITION="$TOOL/scripts/site-probe"
[ -d "$TOOL/node_modules/playwright" ] || { echo "interaction-probe: playwright is not installed in $TOOL (npm ci)" >&2; [ "${CI:-}" = true ] && exit 12; echo "SKIP interaction-probe: no playwright"; exit 0; }
# The pages driven are the site's own: a surface scripts/site-build composes into the build at its mount (ADR
# 0086) is another producer's, with controls its own check answers for. The mounts are the tree's topology, read
# through lib/common.sh as every site check reads them, so nothing here names one.
# shellcheck source=../lib/common.sh
. "$(cd "$(dirname "$0")/.." && pwd)/lib/common.sh"
MJ_PROBE_COMPOSED="$(mj_web_composed "$ROOT" mounts)" || exit 12
export MJ_PROBE_ROOT="$ROOT" MJ_PROBE_LIB="$LIB" MJ_PROBE_ONLY="$ONLY" MJ_PROBE_SPEC="$SPEC" MJ_PROBE_COMPOSED
export MJ_PROBE_SPECS="${MJ_INTERACTION_SPECS:-$LIB/interaction-specs}"
cd "$ROOT" && exec node --input-type=module - <<'JS'
const env = process.env;
const { classify, loadSpecs, isControl, markControls, signature } = await import(`${env.MJ_PROBE_LIB}/interactions.mjs`);
const { launch, serveSite, siteOrigin } = await import(`${env.MJ_PROBE_LIB}/browser.mjs`);
const pub = `${env.MJ_PROBE_ROOT}/site/public`;
const origin = siteOrigin(env.MJ_PROBE_ROOT);
let specs = await loadSpecs(env.MJ_PROBE_SPECS);
if (env.MJ_PROBE_SPEC) specs = specs.filter((s) => s.id === env.MJ_PROBE_SPEC);
const only = env.MJ_PROBE_ONLY ? new Set(env.MJ_PROBE_ONLY.split(/\s+/).filter(Boolean)) : null;

// A language's copy of the site (ADR 0218) is driven page by page like the English build: a control a
// translation broke is broken on its own page, which no sample of one page per section meets. The walk
// is split into shards (MJ_PROBE_SHARD, I3602) so that every copy fits the bound, rather than sampled.

// what the markup declares, per page and spec: the live counts must agree with it
const plan = new Map();
for (const r of classify(pub, specs, (env.MJ_PROBE_COMPOSED || '').split(/\s+/).filter(Boolean))) {
  if (r.specs.length !== 1) continue;              // interaction-check owns unclaimed and doubly claimed controls
  if (only && !only.has(r.route)) continue;
  const byspec = plan.get(r.route) || new Map();
  const c = byspec.get(r.specs[0]) || { live: 0, conditional: 0, sigs: new Set() };
  if (r.el.conditional) c.conditional++; else c.live++;
  c.sigs.add(signature(r.el));
  byspec.set(r.specs[0], c); plan.set(r.route, byspec);
}

const browser = await launch();
if (!browser) {
  if (env.CI === 'true') { console.log('interaction-probe: no browser could be started under CI; a behaviour nobody ran does not hold'); process.exit(12); }
  console.log('SKIP interaction-probe: no browser could be started (install Chrome, or: npx playwright install chromium)');
  process.exit(0);
}

const findings = [];
const exercised = new Map(specs.map((s) => [s.id, 0]));
const fail = (route, spec, msg) => { findings.push(`${route}: ${spec ? `[${spec}] ` : ''}${msg}`); };
const t0 = Date.now();

// The deadlines. A call into the browser that never answers (a resize, F02) used to hold its worker until the job's
// bound killed the shard, with no finding printed and no page named. Each page and each spec on it now race a timer
// of its base plus PER_CONTROL seconds for every control the markup declares there: /registry/ drove its ~1240
// controls in 63 s on a laptop (about 50 ms each, most of it one scroll-region spec), so a fixed minute would fail a
// healthy heavy page on a slower runner, while a resize before a two-control mobile spec still runs out in a minute.
const seconds = (v, d) => (Number(v) > 0 ? Number(v) : d);
const ROUTE_SECONDS = seconds(env.MJ_PROBE_ROUTE_SECONDS, 240);
const SPEC_SECONDS = seconds(env.MJ_PROBE_SPEC_SECONDS, 60);
// 2.5 s per declared control: CI run 41919666430 measured disclosure specs at 0.79 s a control or more
// (/changelog/: 207 cut at 163.5 s; /roadmap/: 234 cut at 177 s), so this is about 3.2 times the slowest
// lower bound; a spec that never resolves still fails, naming its page (case 337)
const PER_CONTROL = 2.5;
const controlsOf = (byspec) => [...byspec.values()].reduce((a, c) => a + c.live + c.conditional, 0);
const within = (base, controls) => Math.round((base + PER_CONTROL * controls) * 10) / 10;
const EXPIRED = Symbol('expired');
const timer = (s) => { let id; const p = new Promise((done) => { id = setTimeout(done, s * 1000, EXPIRED); }); return { p, stop: () => clearTimeout(id) }; };
const ago = (t) => Math.round((Date.now() - t) / 1000);
// what each worker is doing now, route -> { start, step, context, over }: what a deadline names and closes, and what a
// SIGTERM prints; then how long each page took
const inflight = new Map();
const took = [];
const close = (context) => Promise.race([context.close().catch(() => {}), new Promise((done) => setTimeout(done, 10000))]);

async function openPage(route, width, run) {
  const context = await browser.newContext({ viewport: { width, height: 900 } });
  run.context = context;
  if (run.over) { await close(context); throw new Error('the page outlived its deadline before it opened'); }
  // the system clipboard is one per machine, so pages exercised in parallel overwrite each other's copies: each page
  // records what it asked to copy instead, and a spec reads window.__mjClipboard (the last text written)
  await context.addInitScript(() => {
    window.__mjClipboard = null;
    const record = (text) => { window.__mjClipboard = String(text); return Promise.resolve(); };
    try {
      Object.defineProperty(navigator, 'clipboard', { configurable: true, value: { writeText: record, readText: () => Promise.resolve(window.__mjClipboard ?? '') } });
    } catch (e) { /* a page without a clipboard keeps none */ }
  });
  const foreign = [];
  if (env.MJ_PROBE_LIVE === '1') {
    context.on('request', (r) => { const u = new URL(r.url()); if (u.origin !== origin && /^https?:$/.test(u.protocol)) foreign.push(u.href); });
  } else {
    await serveSite(context, pub, origin, (u) => foreign.push(u));
  }
  const page = await context.newPage();
  const errors = [];
  page.on('console', (m) => { if (m.type() === 'error') errors.push(m.text()); });
  page.on('pageerror', (e) => errors.push(`uncaught: ${e.message}`));
  run.step = 'goto';
  const resp = await page.goto(origin + route, { waitUntil: 'load', timeout: 30000 });
  run.step = 'networkidle';
  await page.waitForLoadState('networkidle', { timeout: 10000 }).catch(() => {});
  return { context, page, errors, foreign, status: resp ? resp.status() : 0 };
}

// One spec on an open page: narrowed to its width, its controls marked again, then exercised. Everything it does is
// inside the caller's race with the spec's deadline, the resize included, so a call that hangs is the spec's finding.
async function exerciseSpec(route, spec, declared, page, run, say) {
  const width = spec.width || 1280;
  run.step = `${spec.id}: resize to ${width}`;
  if (page.viewportSize().width !== width) { await page.setViewportSize({ width, height: 900 }); await page.waitForTimeout(50); }
  run.step = `${spec.id}: mark`;
  const live = await page.evaluate(markControls, isControl.toString());
  const mine = live.filter((c) => spec.claims(c));
  if (mine.length !== declared.live) say(`the markup declares ${declared.live} control(s) this spec claims and the live page holds ${mine.length}`);
  const ctx = {
    page, route, width, origin,
    controls: mine.map((c) => ({ ...c, locator: page.locator(`[data-mj-control="${c.n}"]`) })),
    conditional: declared.conditional,
    fail: say,
  };
  run.step = `${spec.id}: exercise`;
  const n = await spec.exercise(ctx);
  const expected = declared.live + declared.conditional;
  if (typeof n !== 'number') say('exercise() did not say how many controls it drove');
  else if (n !== expected) say(`drove ${n} of the ${expected} control(s) it claims (${[...declared.sigs].join(', ')})`);
  else if (!run.over) exercised.set(spec.id, exercised.get(spec.id) + n);
}

async function drive(route, wanted, group, run, report) {
  let v;
  try { v = await openPage(route, group[0].width || 1280, run); } catch (e) { report(null, `the page did not load: ${String(e.message).split('\n')[0]}`); return; }
  const { context, page, errors, foreign, status } = v;
  try {
    if (status !== 200) { report(null, `the page answered ${status}`); return; }
    // what the page reported while it loaded belongs to the page, before any spec touched it
    const loaded = errors.length;
    for (const e of errors.slice(0, loaded)) report(null, `console: ${e.slice(0, 200)}`);
    let hung = false;
    for (const [i, spec] of group.entries()) {
      const before = errors.length;
      const say = (msg) => report(spec.id, msg);
      const deadline = within(SPEC_SECONDS, wanted.get(spec.id).live + wanted.get(spec.id).conditional);
      const limit = timer(deadline);
      const r = await Promise.race([
        exerciseSpec(route, spec, wanted.get(spec.id), page, run, say)
          .catch((e) => say(`threw: ${String(e.message).split('\n')[0].slice(0, 240)}`)),
        limit.p,
      ]);
      limit.stop();
      if (r === EXPIRED) {
        // the page is left inside a call that never answered: the specs after this one are not run on it, and say so
        const rest = group.slice(i + 1).map((s) => s.id);
        say(`did not finish within ${deadline}s: still at ${run.step}${rest.length ? `; the page was closed, so ${rest.join(', ')} did not run on it` : ''}`);
        hung = true;
        break;
      }
      for (const e of errors.slice(before)) say(`console: ${e.slice(0, 200)}`);
    }
    for (const u of [...new Set(foreign)]) report(null, `requested ${u}, which is not the site's own origin`);
    // in the same turn as the finding: what the hung call says once its context is closed is its echo, not a finding
    if (hung) run.over = true;
  } finally {
    await close(context);
  }
}

async function visit(route) {
  const wanted = plan.get(route);
  // One load per page. Desktop specs run first, then the page is narrowed for the mobile ones; within a width,
  // specs that reload or leave state behind (order > 0) run last. The controls are marked again before every
  // spec, so a spec that reloads the page cannot leave the next one pointing at nothing.
  const group = [...wanted.keys()].map((id) => specs.find((s) => s.id === id))
    .sort((a, b) => (b.width || 1280) - (a.width || 1280) || (a.order || 0) - (b.order || 0) || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0));
  const run = { start: Date.now(), step: 'open', context: null, over: false };
  inflight.set(route, run);
  const report = (spec, msg) => { if (!run.over) fail(route, spec, msg); };
  const deadline = within(ROUTE_SECONDS, controlsOf(wanted));
  const limit = timer(deadline);
  const r = await Promise.race([
    drive(route, wanted, group, run, report).catch((e) => report(null, `the probe threw: ${String(e.message).split('\n')[0].slice(0, 240)}`)),
    limit.p,
  ]);
  limit.stop();
  if (r === EXPIRED) {
    report(null, `did not finish within ${deadline}s: still at ${run.step}`);
    run.over = true;
    // closing the context answers the hung call with an error, which ends the work the timer outran
    if (run.context) await close(run.context);
  }
  run.over = true;
  inflight.delete(route);
  const ms = Date.now() - run.start;
  took.push([route, ms]);
  if (ms > 30000) process.stderr.write(`  ${route} took ${Math.round(ms / 1000)}s\n`);
}

// the pages in a fixed order, then this shard's stride of them, cut by scripts/site-probe --partition
const all = [...plan.keys()].sort();
const sharded = env.MJ_PROBE_SHARD_SPEC !== '1/1';
let routes = all;   // the report below keeps this order; the pool drives them heaviest first
if (sharded) {
  const { execFileSync } = await import('node:child_process');
  routes = execFileSync(env.MJ_PROBE_PARTITION, ['--partition', env.MJ_PROBE_SHARD_SPEC], { input: `${all.join('\n')}\n` })
    .toString().split('\n').filter(Boolean);
  if (!routes.length) {
    console.error(`interaction-probe: shard ${env.MJ_PROBE_SHARD_SPEC} of ${all.length} page(s) holds none; fewer shards than pages are needed`);
    process.exit(12);
  }
}
if (env.MJ_PROBE_REPORT) {
  const { writeFileSync } = await import('node:fs');
  writeFileSync(env.MJ_PROBE_REPORT, `# shard ${env.MJ_PROBE_SHARD_SPEC} of ${all.length} routes\n${routes.map((r) => `${r}\n`).join('')}`);
}
// The heaviest pages first, by what the markup declares before any page is opened: the controls the specs will
// drive, then the route. The shard is the same set of pages, each once, in another order: a page that takes minutes
// started last ran the shard past its bound with three workers idle (F02), and started first it runs beside the rest.
const cost = new Map(routes.map((r) => [r, controlsOf(plan.get(r))]));
routes = [...routes].sort((a, b) => cost.get(b) - cost.get(a) || (a < b ? -1 : a > b ? 1 : 0));
// A shard stopped from outside (scripts/ci/timed's bound) names what it was doing when it was stopped
const stopped = (sig) => {
  process.stderr.write(`interaction-probe: ${sig} after ${ago(t0)}s, ${took.length}/${routes.length} page(s) done; in flight:\n`);
  for (const [route, run] of inflight) process.stderr.write(`  ${route} at ${run.step}, ${ago(run.start)}s\n`);
  for (const f of [...findings].sort()) console.log(`FAIL behaviour     ${f}`);
  process.exit(sig === 'SIGTERM' ? 143 : 130);
};
process.on('SIGTERM', () => stopped('SIGTERM'));
process.on('SIGINT', () => stopped('SIGINT'));
const jobs = Math.max(1, Number(env.MJ_PROBE_JOBS || 4));
let next = 0, done = 0;
await Promise.all(Array.from({ length: jobs }, async () => {
  while (next < routes.length) {
    const r = routes[next++];
    await visit(r);
    done++;
    if (done % 50 === 0) process.stderr.write(`  ${done}/${routes.length} page(s)\n`);
  }
}));
await browser.close();

// where the time went: the slowest pages and the spread, so the next bound is set from a measurement
if (took.length) {
  const ms = took.map(([, t]) => t).sort((a, b) => a - b);
  const at = (p) => Math.round(ms[Math.min(ms.length - 1, Math.ceil(p * ms.length) - 1)] / 1000);
  const slow = [...took].sort((a, b) => b[1] - a[1]).slice(0, 10).map(([r, t]) => `${r} ${Math.round(t / 1000)}s`);
  process.stderr.write(`interaction-probe: p50 ${at(0.5)}s, p95 ${at(0.95)}s per page; slowest: ${slow.join(', ')}\n`);
}
for (const f of findings.sort()) console.log(`FAIL behaviour     ${f}`);
const total = [...exercised.values()].reduce((a, b) => a + b, 0);
const perSpec = specs.map((s) => `${exercised.get(s.id)} ${s.id}`).join(', ');
const secs = Math.round((Date.now() - t0) / 1000);
if (findings.length) { console.log(`interaction-probe: ${findings.length} finding(s) over ${routes.length} page(s) in ${secs}s`); process.exit(10); }
console.log(`OK   behaviour    ${total} control(s) on ${routes.length} page(s) ${sharded ? `(shard ${env.MJ_PROBE_SHARD_SPEC} of ${all.length}) ` : ''}${env.MJ_PROBE_LIVE === '1' ? `of ${origin} (live) ` : ''}do what their spec says, in ${secs}s: ${perSpec}`);
JS
