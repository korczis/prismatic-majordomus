        <li><a href="/guarantees/" class="font-medium text-blue-700 hover:underline dark:text-blue-400">Guarantees</a> &mdash; what actually runs</li>
      </ul>
    </div>
  </div>
</aside>
HTML
  printf '</div>\n</div>\n'
  page_close
  } > "$OUT/getting-started/index.html"
}

# ---- /profiles/
build_profiles() {
  local p
  mkdir -p "$OUT/profiles"
  { page_open "/profiles/" "Execution profiles — $SITE_NAME" "Capability class, reasoning effort, output verbosity, context and verification as five independent axes, rendered from the profile files a fresh install writes."
  breadcrumb "Profiles"
  page_header "Execution profiles" "A profile bundles five independent axes. They are never collapsed into one quality setting, because the environments this was distilled from routinely treated a model name and a reasoning level as the same knob."
  printf '<div class="mx-auto max-w-screen-xl px-4 py-14">\n'

  printf '<div class="mb-10 rounded-lg border-s-4 border-blue-700 bg-blue-50 p-4 text-sm text-blue-900 dark:border-blue-500 dark:bg-blue-900/20 dark:text-blue-200" role="note">\n'
  printf '<strong class="font-semibold">Rendered from source.</strong> Every value on this page is read from <code class="font-mono">share/skeleton/profiles/*.yaml</code> at build time. The default profile is <code class="font-mono">%s</code> and the default checkpoint interval is <code class="font-mono">%s</code>, both read from <code class="font-mono">share/skeleton/policy.yaml</code>.\n' \
    "$(pol profiles.default)" "$(pol profiles.checkpoint_interval_default)"
  printf '</div>\n'

  # comparison table across all axes
  printf '<h2 class="mb-4 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">All profiles at a glance</h2>\n'
  printf '<div class="mb-14 overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700">\n'
  printf '<table class="w-full text-left text-sm text-gray-600 dark:text-gray-400">\n'
  printf '<thead class="bg-gray-50 text-xs uppercase tracking-wider text-gray-700 dark:bg-gray-800 dark:text-gray-400"><tr>\n'
  printf '<th scope="col" class="px-4 py-3">Profile</th><th scope="col" class="px-4 py-3">Capability</th><th scope="col" class="px-4 py-3">Effort</th><th scope="col" class="px-4 py-3">Verbosity</th><th scope="col" class="px-4 py-3">Checkpoint</th><th scope="col" class="px-4 py-3">Verification</th>\n'
  printf '</tr></thead>\n<tbody>\n'
  for p in $PROFILES; do
    local vreq="" eff
    case "$(pget "$p" verification.verify_command_required)" in
      true) vreq="verify command" ;;
      if_files_changed) vreq="verify command if files changed" ;;
    esac
    [ "$(pget "$p" verification.regression_test_required)" = true ] && vreq="$vreq, regression test"
    [ "$(pget "$p" verification.decision_record_required)" = true ] && vreq="$vreq, decision record"
    eff="$(pget "$p" effort)"
    [ -n "$(pget "$p" effort_escalation.to)" ] && eff="$eff &rarr; $(pget "$p" effort_escalation.to)"
    printf '<tr class="border-t border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900"><th scope="row" class="whitespace-nowrap px-4 py-3 font-mono font-medium text-gray-900 dark:text-white">%s</th><td class="px-4 py-3">%s</td><td class="whitespace-nowrap px-4 py-3">%s</td><td class="px-4 py-3">%s</td><td class="px-4 py-3">%s</td><td class="px-4 py-3">%s</td></tr>\n' \
      "$p" "$(pget "$p" capability)" "$eff" "$(pget "$p" verbosity)" "$(pget "$p" checkpoint_interval)" "${vreq#, }"
  done
  printf '</tbody></table>\n</div>\n'

  printf '<h2 class="mb-6 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Every axis, per profile</h2>\n'
  printf '<div class="space-y-6">\n'
  for p in $PROFILES; do
    printf '<article id="%s" class="scroll-mt-24 rounded-lg border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-gray-800">\n' "$p"
    emit_profile_body "$p"
    printf '</article>\n'
  done
  printf '</div>\n'
  printf '<p class="mt-10 max-w-2xl text-sm text-gray-500 dark:text-gray-400">A capability class is not a vendor model name. The projection tells a worker to pick the closest its environment offers, and Majordomus never selects or invokes a model. Adding a profile means adding a file; unknown keys in it are errors. Schema: <a href="/docs/schemas/" class="font-medium text-blue-700 hover:underline dark:text-blue-400">docs/SCHEMAS.md</a>.</p>\n'
  printf '</div>\n'
  page_close
  } > "$OUT/profiles/index.html"
}

# ---- /guarantees/
build_guarantees() {
  local i st want
  mkdir -p "$OUT/guarantees"
  { page_open "/guarantees/" "Guarantees — $SITE_NAME" "Every capability claim with its canonical source, the file that implements it, the test that proves it, and whether it is guaranteed, advisory, planned, or deliberately rejected."
  breadcrumb "Guarantees"
  page_header "Guaranteed, advisory, planned" "A supervisory tool that overstates itself is the thing it was built to prevent. This page is generated from <code class=\"font-mono\">docs/CLAIMS.yaml</code>, and the build fails if any source, implementation, or test path in it does not exist."
  printf '<div class="mx-auto max-w-screen-xl px-4 py-14">\n'
  emit_status_legend

  printf '<div class="mb-8 rounded-lg border-s-4 border-blue-700 bg-blue-50 p-4 text-sm text-blue-900 dark:border-blue-500 dark:bg-blue-900/20 dark:text-blue-200" role="note">\n'
  printf '<strong class="font-semibold">Why this page exists.</strong> The environments this tool was distilled from contained repeated cases of a check documented as blocking, present on disk, executable, and invoked by nothing. A declaration of enforcement that is not reconciled against what actually runs is worse than no declaration: it produces a compliance report and then decays. So the distinction between guaranteed and advisory is stated here at the same prominence as the capabilities themselves.\n'
  printf '</div>\n'

  for want in guaranteed advisory planned rejected; do
    printf '<h2 class="mb-4 mt-12 flex items-center gap-3 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">%s%s</h2>\n' \
      "$(status_badge "$want")" "$(printf '%s' "$want" | awk '{ print toupper(substr($0,1,1)) substr($0,2) }')"
    printf '<div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700">\n'
    printf '<table class="w-full text-left text-sm text-gray-600 dark:text-gray-400">\n'
    printf '<thead class="bg-gray-50 text-xs uppercase tracking-wider text-gray-700 dark:bg-gray-800 dark:text-gray-400"><tr>\n'
    printf '<th scope="col" class="px-4 py-3">Claim</th><th scope="col" class="px-4 py-3">Source</th><th scope="col" class="px-4 py-3">Implementation</th><th scope="col" class="px-4 py-3">Test</th>\n'
    printf '</tr></thead>\n<tbody>\n'
    i=0
    while [ "$i" -lt "$NCLAIMS" ]; do
      st="$(cl "$i" status)"
      if [ "$st" = "$want" ]; then
        printf '<tr class="border-t border-gray-200 bg-white align-top dark:border-gray-700 dark:bg-gray-900">\n'
        printf '<th scope="row" class="px-4 py-3 font-medium text-gray-900 dark:text-white">%s' "$(cl "$i" claim | esc_html)"
        [ -n "$(cl "$i" note)" ] && printf '<span class="mt-1 block font-normal text-gray-500 dark:text-gray-400">%s</span>' "$(cl "$i" note | esc_html)"
        printf '</th>\n'
        printf '<td class="whitespace-nowrap px-4 py-3">%s</td>\n' "$(repo_link "$(cl "$i" source)")"
        printf '<td class="whitespace-nowrap px-4 py-3">%s</td>\n' "$(repo_link "$(cl "$i" implementation)")"
        printf '<td class="whitespace-nowrap px-4 py-3">%s</td>\n' "$(repo_link "$(cl "$i" test)")"
        printf '</tr>\n'
      fi
      i=$((i + 1))
    done
    printf '</tbody></table>\n</div>\n'
  done

  printf '<h2 class="mb-4 mt-14 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Stated limitations</h2>\n'
  printf '<div class="format dark:format-invert max-w-none">\n'
  section README.md "Limitations" 2 | md 0 3
  printf '</div>\n'
  printf '</div>\n'
  page_close
  } > "$OUT/guarantees/index.html"
}

# a repository path rendered as a link to GitHub, or a dash when there is nothing to link
repo_link() {
  case "${1:-}" in
    ''|'-') printf '<span class="text-gray-400 dark:text-gray-600">&mdash;</span>' ;;
    */) printf '<a href="%s/tree/master/%s" class="font-mono text-xs text-blue-700 hover:underline dark:text-blue-400">%s</a>' "$REPO_URL" "$1" "$1" ;;
    *) printf '<a href="%s/blob/master/%s" class="font-mono text-xs text-blue-700 hover:underline dark:text-blue-400">%s</a>' "$REPO_URL" "$1" "$1" ;;
  esac
}

# ---- /docs/ index and one page per canonical document
build_docs() {
  local route file title summary
  mkdir -p "$OUT/docs"
  { page_open "/docs/" "Documentation — $SITE_NAME" "The design specification, CLI reference, file schemas, concepts, adoption guide, economics, and the extraction report the design was derived from."
  breadcrumb "Docs"
  page_header "Documentation" "Each page below is one canonical Markdown file from the repository, rendered. The repository is the source of truth; this site is a presentation layer over it."
  printf '<div class="mx-auto max-w-screen-xl px-4 py-14">\n<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">\n'
  printf '%s\n' "$DOCPAGES" | while IFS='|' read -r route file title summary; do
    [ -n "$route" ] || continue
    printf '<a href="/docs/%s/" class="block rounded-lg border border-gray-200 bg-white p-5 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:hover:bg-gray-700">\n' "$route"
    printf '<h2 class="mb-2 text-lg font-semibold tracking-tight text-gray-900 dark:text-white">%s</h2>\n' "$title"
    printf '<p class="mb-3 text-sm text-gray-600 dark:text-gray-400">%s</p>\n' "$summary"
    printf '<span class="font-mono text-xs text-gray-400 dark:text-gray-500">%s</span>\n</a>\n' "$file"
  done
  printf '</div>\n'
  printf '<p class="mt-10 max-w-2xl text-sm text-gray-500 dark:text-gray-400">Rule for these documents, from the repository contract: a sentence describing a capability is either backed by a case in <code class="font-mono">test/cases/</code> or phrased as a target. When implementation and document disagree, the document changes in the same commit.</p>\n'
  printf '</div>\n'
  page_close
  } > "$OUT/docs/index.html"

  printf '%s\n' "$DOCPAGES" | while IFS='|' read -r route file title summary; do
    [ -n "$route" ] || continue
    mkdir -p "$OUT/docs/$route"
    { page_open "/docs/$route/" "$title — $SITE_NAME" "$summary"
      breadcrumb "$title" "Docs|/docs/"
      printf '<div class="mx-auto max-w-screen-xl px-4 py-10">\n<div class="grid gap-10 lg:grid-cols-4">\n'
      printf '<div class="lg:col-span-3">\n'
      printf '<div class="mb-6 flex flex-wrap items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-4 py-2.5 font-mono text-xs text-gray-500 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400">\n'
      printf '<span>Rendered from</span>%s<span>&middot; the repository is the source of truth</span>\n' "$(repo_link "$file")"
      printf '</div>\n'
      printf '<article class="format lg:format-lg dark:format-invert max-w-none">\n'
      md 1 1 < "$(src "$file")"
      printf '</article>\n</div>\n'
      # table of contents from the level-2 headings of the same file
      printf '<aside class="lg:col-span-1"><nav class="sticky top-24 rounded-lg border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-gray-800" aria-label="On this page">\n'
      printf '<h2 class="mb-3 font-mono text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">On this page</h2>\n<ul class="space-y-2 text-sm">\n'
      awk '/^## /{ t=substr($0,4); sub(/[ \t]+$/,"",t); s=tolower(t); gsub(/`/,"",s); gsub(/\*/,"",s); gsub(/[^a-z0-9]+/,"-",s); gsub(/^-+|-+$/,"",s); if (s != "") printf "<li><a href=\"#%s\" class=\"text-gray-600 hover:text-blue-700 dark:text-gray-400 dark:hover:text-blue-400\">%s</a></li>\n", s, t }' "$(src "$file")" \
        | sed -e 's/`//g'
      printf '</ul>\n</nav></aside>\n'
      printf '</div>\n</div>\n'
      page_close
    } > "$OUT/docs/$route/index.html"
  done
}

# ---------------------------------------------------------------- assets & metadata
build_assets() {
  mkdir -p "$OUT/assets"
  # The mark, wordmark and social card are repository artifacts shared with the README,
  # not site-only files: they are copied, never re-drawn here.
  cp "$(src assets/logo-mark.svg)" "$OUT/assets/logo-mark.svg"
  cp "$(src assets/logo.svg)"      "$OUT/assets/logo.svg"
  cp "$(src assets/social-card.png)" "$OUT/assets/social-card.png"
  cp "$(src assets/logo-mark.svg)" "$OUT/assets/favicon.svg"
  cp "$ROOT/node_modules/flowbite/dist/flowbite.min.js" "$OUT/assets/flowbite.min.js"
  # The one piece of JavaScript this site adds: the theme switcher from the Flowbite
  # dark-mode guide. Everything else interactive is a Flowbite data attribute.
  cat > "$OUT/assets/theme.js" <<'JS'
// Dark-mode switcher, from the Flowbite dark mode guide. The <head> script has already
// applied the theme; this only wires the button and keeps the icons in sync.
(function () {
  var dark = document.getElementById('theme-toggle-dark-icon');
  var light = document.getElementById('theme-toggle-light-icon');
  var btn = document.getElementById('theme-toggle');
  if (!btn || !dark || !light) return;

  function isDark() {
    return document.documentElement.classList.contains('dark');
  }
  function syncIcons() {
    dark.classList.toggle('hidden', isDark());
    light.classList.toggle('hidden', !isDark());
    btn.setAttribute('aria-pressed', isDark() ? 'true' : 'false');
  }
  syncIcons();

  btn.addEventListener('click', function () {
    document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('color-theme', isDark() ? 'dark' : 'light');
    } catch (e) {
      // private browsing, or site data blocked: the choice simply does not persist
    }
    syncIcons();
  });
})();
JS
  printf 'User-agent: *\nAllow: /\nSitemap: %s/sitemap.xml\n' "$BASE_URL" > "$OUT/robots.txt"
  # GitHub Pages would otherwise run Jekyll over the output and drop underscore paths
  : > "$OUT/.nojekyll"
}

build_sitemap() {
  local route
  { printf '<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n'
    for route in $(routes); do
      printf '  <url><loc>%s%s</loc></url>\n' "$BASE_URL" "$route"
    done
    printf '</urlset>\n'
  } > "$OUT/sitemap.xml"
}

# every route the generator produces; the single list used by the sitemap, the link
# checker and the output test
routes() {
  printf '/\n/getting-started/\n/profiles/\n/guarantees/\n/docs/\n'
  printf '%s\n' "$DOCPAGES" | while IFS='|' read -r route _rest; do
    [ -n "$route" ] && printf '/docs/%s/\n' "$route"
  done
}

# ---------------------------------------------------------------- manifest
# Proves which sources the deployed site was built from. CI regenerates and compares:
# a manifest whose input_sha256 differs from the current sources means the deployed site
# is stale, which is the one failure mode a derived site has that a hand-written one
# does not.
build_manifest() {
  local f sha
  { printf '{\n'
    printf '  "site": "%s",\n' "$SITE_NAME"
    printf '  "version": "%s",\n' "$VERSION"
    printf '  "generator": "scripts/generate-pages",\n'
    printf '  "generator_version": "%s",\n' "$GEN_VERSION"
    printf '  "source_commit": "%s",\n' "$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || printf 'unknown')"
    printf '  "source_commit_short": "%s",\n' "$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
    printf '  "input_sha256": "%s",\n' "$(inputs_sha)"
    printf '  "inputs": [\n'
    local first=1
    printf '%s\n' "$SOURCES" | while IFS= read -r f; do
      [ -n "$f" ] || continue
      sha="$(mj_sha256 "$(src "$f")")"
      [ "$first" = 1 ] && first=0 || printf ',\n'
      printf '    { "path": "%s", "sha256": "%s" }' "$f" "$sha"
    done
    printf '\n  ],\n'
    printf '  "routes": [\n'
    routes | sed -e 's/^/    "/' -e 's/$/",/' | sed -e '$ s/,$//'
    printf '  ]\n'
    printf '}\n'
  } > "$OUT/site-manifest.json"
}

# One hash over every canonical input, order-stable. Two checkouts with identical
# sources produce the same value regardless of file timestamps or commit.
inputs_sha() {
  local f
  { printf '%s\n' "$SOURCES" | sort | while IFS= read -r f; do
      [ -n "$f" ] || continue
      printf '%s  %s\n' "$(mj_sha256 "$(src "$f")")" "$f"
    done
  } > "$TMP/inputs.list"
  mj_sha256 "$TMP/inputs.list"
}

# ---------------------------------------------------------------- validation
# Checks the sources before generating, so a renamed heading or a claim citing a file
# that does not exist fails the build rather than silently producing an empty section.
check_sources() {
  step "sources"
  local f i st imp tst
  printf '%s\n' "$SOURCES" | while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ -f "$(src "$f")" ] || printf 'MISSING %s\n' "$f"
  done > "$TMP/missing"
  if [ -s "$TMP/missing" ]; then
    while IFS= read -r f; do bad source "${f#MISSING }: declared in SOURCES and absent"; done < "$TMP/missing"
  else
    good source "every declared canonical input exists"
  fi

  # every heading and code block the generator reads
  for f in "The problem" "What it does" "Mental model" "Core principles" "What this is not" "Quick start" "Example workflow" "Limitations"; do
    awk -v want="$f" -v level=2 -v withheading=0 -f "$ROOT/scripts/lib/section.awk" "$(src README.md)" >/dev/null 2>&1 \
      || bad heading "README.md: no level-2 heading '$f'"
  done
  for i in 1 4; do
    awk -v n="$i" -f "$ROOT/scripts/lib/codeblock.awk" "$(src README.md)" >/dev/null 2>&1 \
      || bad codeblock "README.md: fenced block $i is missing"
  done
  awk -v want="Origin and licence" -v level=2 -f "$ROOT/scripts/lib/section.awk" "$(src README.md)" >/dev/null 2>&1 \
    || printf 'INFO %-12s %s\n' anchors "README.md: optional heading 'Origin and licence' absent"
  good anchors "every heading and code block the generator reads is present"

  # claims matrix integrity
  i=0
  while [ "$i" -lt "$NCLAIMS" ]; do
    st="$(cl "$i" status)"; imp="$(cl "$i" implementation)"; tst="$(cl "$i" test)"
    case "$st" in
      guaranteed|advisory|planned|rejected) ;;
      *) bad claims "$(cl "$i" id): status '$st' is not guaranteed, advisory, planned or rejected" ;;
    esac
    [ -n "$(cl "$i" claim)" ] || bad claims "$(cl "$i" id): empty claim"
    [ -f "$(src "$(cl "$i" source)")" ] || bad claims "$(cl "$i" id): source '$(cl "$i" source)' does not exist"
    case "$imp" in '-'|'') ;; *) [ -e "$(src "$imp")" ] || bad claims "$(cl "$i" id): implementation '$imp' does not exist" ;; esac
    case "$tst" in '-'|'') ;; *) [ -e "$(src "$tst")" ] || bad claims "$(cl "$i" id): test '$tst' does not exist" ;; esac
    if [ "$st" = guaranteed ]; then
      case "$tst" in '-'|'') bad claims "$(cl "$i" id): guaranteed with no test; a claim without an executable behind it is removed or reworded" ;; esac
      case "$imp" in '-'|'') bad claims "$(cl "$i" id): guaranteed with no implementation" ;; esac
    fi
    if [ "$st" = planned ] || [ "$st" = rejected ]; then
      case "$imp" in '-'|'') ;; *) printf 'INFO %-12s %s\n' claims "$(cl "$i" id): $st but names an implementation ($imp)" ;; esac
    fi
    i=$((i + 1))
  done
  [ "$FAILED" = 0 ] && good claims "every claim names an existing source, and every guaranteed claim names a test"

  # duplicate ids
  i=0
  while [ "$i" -lt "$NCLAIMS" ]; do cl "$i" id; i=$((i + 1)); done | sort > "$TMP/ids"
  if [ "$(sort -u "$TMP/ids" | wc -l | tr -d ' ')" != "$(wc -l < "$TMP/ids" | tr -d ' ')" ]; then
    bad claims "duplicate ids: $(uniq -d "$TMP/ids" | tr '\n' ' ')"
  fi

  # Every canonical document is reachable from the site. A new file in docs/ fails the
  # build until DOCPAGES links it, so the site cannot quietly omit documentation.
  for f in "$ROOT"/docs/*.md; do
    [ -f "$f" ] || continue
    case "$(basename "$f")" in
      README.md) continue ;;  # the repository-side index; /docs/ is generated instead
      GITHUB_PAGES_ARCHITECTURE.md) continue ;;  # about the site, not part of it
    esac
    printf '%s\n' "$DOCPAGES" | grep -qF "docs/$(basename "$f")" \
      || bad docs "docs/$(basename "$f") exists and no site route renders it; add it to DOCPAGES"
  done
  good docs "every canonical document under docs/ is rendered by a site route"

  # promotional copy must stay small and must not make capability claims
  local lines budget
  lines="$(grep -c '' "$(src site/promo/copy.yaml)")"
  budget="$(c budget_lines)"
  if [ "$lines" -le "${budget:-60}" ]; then
    good promo "site/promo/copy.yaml is $lines lines, budget ${budget:-60}"
  else
    bad promo "site/promo/copy.yaml is $lines lines, over its ${budget:-60}-line budget; prose belongs in README.md"
  fi
  if grep -nE '\b[0-9]+ (agents|files|apps|commands|profiles|checks|rules|tests)\b' "$(src site/promo/copy.yaml)" >/dev/null 2>&1; then
    bad promo "site/promo/copy.yaml contains a hardcoded count; the generator computes numbers"
  fi
}

# Checks the generated output. Everything here is a property the site must hold no matter
# what the sources say.
check_output() {
  step "output"
  local route page n

  for route in $(routes); do
    page="$OUT${route}index.html"
    [ -f "$page" ] || { bad route "$route: not generated"; continue; }
    grep -q '<title>' "$page"            || bad meta "$route: no title"
    grep -q 'name="description"' "$page" || bad meta "$route: no meta description"
    grep -q 'rel="canonical"' "$page"    || bad meta "$route: no canonical link"
    grep -q 'property="og:title"' "$page" || bad meta "$route: no Open Graph title"
    grep -q 'name="twitter:card"' "$page" || bad meta "$route: no Twitter card"
    grep -q '<main id="main"' "$page"    || bad a11y "$route: no main landmark"
    grep -q 'Skip to content' "$page"    || bad a11y "$route: no skip link"
    grep -q '<h1' "$page"                || bad a11y "$route: no h1"
    n="$(grep -c '<h1' "$page")"
    [ "$n" = 1 ] || bad a11y "$route: $n h1 elements, expected exactly 1"
    grep -q 'data-collapse-toggle="navbar-main"' "$page" || bad flowbite "$route: no Flowbite mobile navbar toggle"
    grep -q 'aria-controls="navbar-main"' "$page" || bad flowbite "$route: navbar toggle without aria-controls"
    # Placeholder and variable scans run over the page with code blocks removed: a
    # canonical document legitimately shows $HOME and ${TMPDIR} inside a shell example,
    # and those are content, not a failed substitution.
    strip_code "$page" > "$TMP/prose.html"
    grep -nE '\{\{[A-Za-z_]+\}\}|__[A-Z_]+__' "$TMP/prose.html" >/dev/null 2>&1 \
      && bad template "$route: unresolved placeholder ($(grep -oE '\{\{[A-Za-z_]+\}\}|__[A-Z_]+__' "$TMP/prose.html" | head -n 1))"
    grep -nE '\$\{?[A-Z][A-Z_]{2,}\}?' "$TMP/prose.html" >/dev/null 2>&1 \
      && bad template "$route: unexpanded shell variable ($(grep -oE '\$\{?[A-Z][A-Z_]{2,}\}?' "$TMP/prose.html" | head -n 1))"
    # an attribute that expanded to nothing means a lost value
    grep -nE '(href|src|content)=""' "$page" >/dev/null 2>&1 && bad template "$route: empty attribute value"
    # inline styles are forbidden: presentation is Tailwind utilities and Flowbite classes
    grep -nE '<[^>]+ style="' "$page" >/dev/null 2>&1 && bad style "$route: inline style attribute"
    # No runtime dependency on a third-party host. Only things the browser FETCHES count:
    # script src, and link rel=stylesheet or preload. Ordinary links out to GitHub, and
    # the canonical and og:url metadata, are not fetched.
    grep -oE '<script[^>]+src="https?://[^"]+|<link[^>]+rel="(stylesheet|preload)"[^>]*href="https?://[^"]+|<img[^>]+src="https?://[^"]+' "$page" >/dev/null 2>&1 \
      && bad network "$route: fetches a remote asset ($(grep -oE '(src|href)="https?://[^"]+' "$page" | head -n 1))"
  done
  [ "$FAILED" = 0 ] && good route "every route generated with metadata, landmarks, and no placeholders"

  # required homepage sections, by their rendered heading
  for n in "The problem" "The core model" "What it controls" "Drop-in installation" "How it works" "Execution profiles" "Guaranteed, advisory, planned" "Design principles" "What it is not" "Quick start"; do
    grep -qF "$n" "$OUT/index.html" || bad homepage "missing section: $n"
  done
  # the honesty sections must actually carry content, not just a heading
  grep -q 'guaranteed</span>' "$OUT/index.html" || bad homepage "no guaranteed badge rendered"
  grep -q 'advisory</span>' "$OUT/index.html"   || bad homepage "no advisory badge rendered"
  grep -q 'planned</span>' "$OUT/index.html"    || bad homepage "no planned badge rendered"

  # derived content actually reached the page: values that exist only in canonical sources
  grep -qF "$(pget deep-work capability)" "$OUT/profiles/index.html" || bad derived "profiles page does not carry the deep-work capability class from YAML"
  grep -qF "$(pol profiles.checkpoint_interval_default)" "$OUT/profiles/index.html" || bad derived "profiles page does not carry the default checkpoint interval from policy.yaml"
  grep -qF "v$VERSION" "$OUT/index.html" || bad derived "homepage does not carry the version from bin/majordomus"

  # internal links resolve to a generated route or file
  for route in $(routes); do
    page="$OUT${route}index.html"
    [ -f "$page" ] || continue
    grep -oE 'href="/[^"#]*"' "$page" | sed -e 's/href="//' -e 's/"$//' | sort -u | while IFS= read -r n; do
      case "$n" in
        /assets/app.css) [ "$DO_CSS" = 1 ] && { [ -e "$OUT$n" ] || printf 'BADLINK %s -> %s\n' "$route" "$n"; } ;;
        */) [ -f "$OUT$n/index.html" ] || [ -f "$OUT${n}index.html" ] || printf 'BADLINK %s -> %s\n' "$route" "$n" ;;
        *)  [ -e "$OUT$n" ] || printf 'BADLINK %s -> %s\n' "$route" "$n" ;;
      esac
    done
  done > "$TMP/badlinks"
  if [ -s "$TMP/badlinks" ]; then
    sort -u "$TMP/badlinks" | while IFS= read -r n; do bad link "${n#BADLINK }"; done
  else
    good link "every internal link resolves to a generated route or asset"
  fi

  # secret and private-identifier scan over the generated output
  if grep -rnaiE '(AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY|gh[pousr]_[A-Za-z0-9]{20,}|xox[abprs]-[A-Za-z0-9-]{10,}|sk-[A-Za-z0-9]{32,})' "$OUT" >/dev/null 2>&1; then
    bad secrets "the generated output matches a credential pattern"
  else
    good secrets "no credential pattern in the generated output"
  fi
  if grep -rna '@able.cz' "$OUT" >/dev/null 2>&1; then
    bad private "the generated output carries a private email address"
  fi
  # the clean-extraction boundary: no internal hostnames or absolute home paths
  if grep -rnaE '/Users/[a-z]+/|/home/[a-z]+/dev/|\.internal\b|\.corp\b' "$OUT" >/dev/null 2>&1; then
    bad private "the generated output carries a local filesystem path or an internal hostname"
  else
    good private "no local paths, internal hostnames, or private addresses"
  fi

  # manifest matches the sources on disk right now
  local want have
  want="$(inputs_sha)"
  have="$(sed -n 's/.*"input_sha256": "\([0-9a-f]*\)".*/\1/p' "$OUT/site-manifest.json")"
  if [ "$want" = "$have" ]; then
    good manifest "input_sha256 matches the canonical sources (${want%"${want#????????}"}…)"
  else
    bad manifest "site-manifest.json input_sha256 $have does not match the sources ($want); regenerate"
  fi
}

check_css() {
  step "stylesheet"
  local css="$OUT/assets/app.css" n
  [ -f "$css" ] || { bad css "assets/app.css was not compiled"; return 0; }
  n="$(wc -c < "$css" | tr -d ' ')"
  # Tailwind's own preflight is about 10 kB; an unpurged build is over a megabyte.
  if [ "$n" -lt 20000 ]; then bad css "assets/app.css is only $n bytes; the Tailwind build looks empty"
  elif [ "$n" -gt 900000 ]; then bad css "assets/app.css is $n bytes; this looks like an unpurged development build"
  else good css "assets/app.css is $n bytes, minified and scoped to the generated HTML"; fi
  # classes that must survive content scanning, one per family the site depends on
  for n in 'format' 'dark\\:bg-gray-900' 'md\\:hidden' 'sr-only' 'lg\\:format-lg' 'dark\\:format-invert'; do
    grep -qF "$(printf '%s' "$n" | sed 's/\\\\/\\/g')" "$css" \
      || bad css "class $(printf '%s' "$n" | sed 's/\\\\//g') is used in the HTML and absent from the compiled stylesheet"
  done
  # class-based dark mode, not the prefers-color-scheme fallback: the theme switcher
  # toggles .dark on <html>, so a media-query build would make the button inert
  grep -q ':where(.dark' "$css" || bad css "compiled stylesheet does not use class-based dark mode; the theme switcher would not work"
  # the site must carry no stylesheet of its own besides the compiled one
  [ -z "$(find "$OUT/assets" -name '*.css' ! -name 'app.css' 2>/dev/null)" ] \
    || bad css "a second stylesheet is present in assets/; this site has no custom CSS layer"
}

# ---------------------------------------------------------------- css build
build_css() {
  step "tailwind + flowbite"
  [ -d "$ROOT/node_modules/tailwindcss" ] || {
    bad css "node_modules is absent; run: npm ci"
    return 0
  }
  # Content scanning happens over the HTML that build_* just wrote, which is why this
  # step runs last. site/tailwind.css declares both @source paths.
  "$ROOT/node_modules/.bin/tailwindcss" \
      -i "$(src site/tailwind.css)" \
      -o "$OUT/assets/app.css" \
      --minify 2>&1 | sed 's/^/     /'
  [ -f "$OUT/assets/app.css" ] || bad css "the Tailwind build produced no stylesheet"
}

# ---------------------------------------------------------------- serve
serve() {
  step "serving $OUT on http://localhost:$PORT"
  say "Ctrl-C to stop. Routes are directories with index.html, so a plain static server"
  say "resolves them without configuration, exactly as GitHub Pages does."
  if command -v python3 >/dev/null 2>&1; then
    ( cd "$OUT" && python3 -m http.server "$PORT" )
  else
    say "python3 is absent; serve $OUT with any static file server"
    return 1
  fi
}

# ---------------------------------------------------------------- main
step "generating $OUT"
say "sources: the repository. This script transforms them; it holds no second copy."

check_sources
[ "$FAILED" = 0 ] || { say ""; say "generate-pages: $FAILED source problem(s); nothing generated"; exit 10; }

rm -rf "$OUT"
mkdir -p "$OUT"
build_assets
build_home
build_getting_started
build_profiles
build_guarantees
build_docs
build_sitemap
build_manifest
routes | sed 's/^/     /'

[ "$DO_CSS" = 1 ] && build_css

step "checks"
check_output
[ "$DO_CSS" = 1 ] && check_css

say ""
if [ "$FAILED" = 0 ]; then
  say "generate-pages: ok — $(routes | wc -l | tr -d ' ') routes, input_sha256 $(inputs_sha | cut -c1-12)"
else
  say "generate-pages: $FAILED failure(s)"
  exit 10
fi

[ "$CHECK_ONLY" = 1 ] && exit 0
[ "$DO_SERVE" = 1 ] && serve
exit 0
