#!/usr/bin/env bash
# site-deploy — publish the built site to the gh-pages branch, from this machine or from CI.
#
# GitHub Pages serves the gh-pages branch (source: branch, path /). Whoever pushes that
# branch deploys; GitHub's own "pages build and deployment" then takes under a minute. The
# Pages workflow and a person at a terminal run this same script, so there is one deploy
# path, and the person's is the fast one: no Actions queue in front of it.
#
#   scripts/site-deploy                 gate, build, check, publish
#   scripts/site-deploy --dry-run       everything but the push; prints what would be pushed
#   scripts/site-deploy --probe         also run the browser probe before publishing
#   scripts/site-deploy --skip-build    publish site/public as it is (CI: already built and checked)
#   scripts/site-deploy --any-ref       publish a commit that is not on origin/master (a preview of
#                                       unmerged work; the footer names the commit, so it is visible)
#   scripts/site-deploy --allow-dirty   publish from a working tree with uncommitted changes
#   scripts/site-deploy --configure-pages
#                                       one-time: point GitHub Pages at the gh-pages branch (needs gh)
#   scripts/site-deploy --release-metadata <tag>
#                                       publish only releases/<tag>.json and releases/latest.json
#                                       (for a pre-release tag, releases/<tag>.json alone)
#                                       from site/static/releases of the working tree, onto what
#                                       gh-pages serves; the release's publish job, before its
#                                       record lands (ADR 0131)
#
# Refuses (exit 10): a dirty tree, a HEAD that origin/master does not contain, a failed gate,
# a build that lost the CNAME the source declares — publishing that unsets the custom domain —
# and a build that lacks a snapshot the publication model says a publication holds, or carries
# one read at another commit (the UI at its mount, ADR 0141). A deploy that says nothing is a
# deploy nobody can audit, so the gh-pages commit message names the source commit, and the
# site's footer shows the same commit.
#
# The site never serves an older release than it served (ADR 0131). A release publishes its
# metadata here minutes after its archives, and its record reaches master an hour or more later;
# a deploy of master in between carries the previous release's latest.json. So an ordinary
# deploy keeps the releases/latest.json gh-pages carries, and the tag file it names, when that
# names a newer version than the build does. It also keeps every releases/<tag>.json gh-pages
# carries and the build does not hold, stable or pre-release, and names each (I3448): a
# pre-release is never named by latest.json, so only this keeps its metadata until its record
# lands.
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DRY=0; PROBE=0; SKIP_BUILD=0; ANY_REF=0; ALLOW_DIRTY=0; CONFIGURE=0; RELEASE_TAG=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1 ;; --probe) PROBE=1 ;; --skip-build) SKIP_BUILD=1 ;;
    --any-ref) ANY_REF=1 ;; --allow-dirty) ALLOW_DIRTY=1 ;; --configure-pages) CONFIGURE=1 ;;
    --release-metadata)
      [ $# -ge 2 ] && [ -n "$2" ] || { echo "site-deploy: --release-metadata needs a tag" >&2; exit 2; }
      RELEASE_TAG="$2"; shift ;;
    -h|--help) sed -n '2,35p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "site-deploy: unknown option $1" >&2; exit 2 ;;
  esac
  shift
done
BRANCH="${SITE_DEPLOY_BRANCH:-gh-pages}"
REMOTE="${SITE_DEPLOY_REMOTE:-origin}"
step() { printf '==> %s\n' "$*"; }
refuse() { printf 'REFUSE %s\n' "$*" >&2; exit 10; }
# Whether version $1 is newer than version $2, numerically per dot-separated field; anything
# after a `-` or `+` is ignored, and a missing field counts as 0. An empty or unreadable side is
# never newer, and nothing is newer than an empty side: no answer keeps what is there.
newer() {
  [ -n "$1" ] && [ -n "$2" ] || return 1
  awk -v a="${1%%[-+]*}" -v b="${2%%[-+]*}" 'BEGIN {
    na = split(a, x, "."); nb = split(b, y, "."); n = na > nb ? na : nb
    for (i = 1; i <= n; i++) {
      if (x[i] !~ /^[0-9]*$/ || y[i] !~ /^[0-9]*$/) exit 1
      if (x[i] + 0 > y[i] + 0) exit 0
      if (x[i] + 0 < y[i] + 0) exit 1
    }
    exit 1
  }'
}

cd "$ROOT"

if [ "$CONFIGURE" = 1 ]; then
  command -v gh >/dev/null || refuse "configure-pages needs the gh CLI"
  repo="$(gh repo view --json nameWithOwner -q .nameWithOwner)"
  step "pointing GitHub Pages of $repo at branch $BRANCH, path /"
  if gh api "repos/$repo/pages" >/dev/null 2>&1; then
    gh api -X PUT "repos/$repo/pages" -f build_type=legacy -f "source[branch]=$BRANCH" -f "source[path]=/" >/dev/null
  else
    gh api -X POST "repos/$repo/pages" -f build_type=legacy -f "source[branch]=$BRANCH" -f "source[path]=/" >/dev/null
  fi
  gh api "repos/$repo/pages" -q '"pages: source \(.source.branch) \(.source.path), \(.html_url)"'
  exit 0
fi

# ---------------------------------------------------------------- the release's metadata alone
# The publish job of a release runs this over its own working tree: the record and its
# projections derived and judged, staged, not yet committed or merged. It changes two files of
# what gh-pages serves and nothing else, so build.json still names the master commit the site
# was built from, and every other page stays what that commit's deploy published.
if [ -n "$RELEASE_TAG" ]; then
  src="site/static/releases"
  [ -f "$src/$RELEASE_TAG.json" ] || refuse "$src/$RELEASE_TAG.json is missing; derive the record first"
  # A pre-release (vX.Y.Z-alpha.N, -beta.N or -rc.N, and no other suffix) is published beside
  # the stable pointer and never as it: its tag file goes out, latest.json stays what the site
  # serves, and a latest.json naming it or any other pre-release is refused (I2829). The same
  # pattern is in scripts/ci/install-check, scripts/ci/release-check and release.yml;
  # site/static/install.sh refuses any pre-release suffix it was not asked for by name.
  if printf '%s\n' "$RELEASE_TAG" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+-(alpha|beta|rc)\.[0-9]+$'; then
    t="$(jq -r '.tag // empty' "$src/$RELEASE_TAG.json")"
    [ "$t" = "$RELEASE_TAG" ] || refuse "$src/$RELEASE_TAG.json names ${t:-no tag}, not $RELEASE_TAG"
    if [ -f "$src/latest.json" ]; then
      latest_tag="$(jq -r '.tag // empty' "$src/latest.json")"
      case "$latest_tag" in
        *-alpha.[0-9]*|*-beta.[0-9]*|*-rc.[0-9]*) refuse "$src/latest.json names the pre-release $latest_tag; a pre-release is never the latest release" ;;
      esac
    fi
    publish_latest=0
    msg="release: $RELEASE_TAG pre-release metadata, published beside the latest release"
  else
    [ -f "$src/latest.json" ] || refuse "$src/latest.json is missing; derive the record first"
    t="$(jq -r '.tag // empty' "$src/latest.json")"
    [ "$t" = "$RELEASE_TAG" ] || refuse "$src/latest.json names ${t:-no tag}, not $RELEASE_TAG"
    cmp -s "$src/latest.json" "$src/$RELEASE_TAG.json" \
      || refuse "$src/latest.json and $src/$RELEASE_TAG.json differ; one of them is stale"
    publish_latest=1
    msg="release: $RELEASE_TAG metadata, published ahead of its record"
  fi
  git ls-remote --exit-code --heads "$REMOTE" "$BRANCH" >/dev/null 2>&1 \
    || refuse "$REMOTE has no $BRANCH; the release metadata goes onto a deployed site"
  git fetch -q "$REMOTE" "$BRANCH"
  if [ "$publish_latest" = 1 ]; then
    version="$(jq -r '.version // empty' "$src/latest.json")"
    served="$(git show "$REMOTE/$BRANCH:releases/latest.json" 2>/dev/null | jq -r '.version // empty' 2>/dev/null || true)"
    if newer "$served" "$version"; then
      refuse "$BRANCH serves $served, newer than $version; a site never goes back a release"
    fi
  fi
  W="$(mktemp -d "${TMPDIR:-/tmp}/mj-deploy.XXXXXX")"
  trap 'git worktree remove --force "$W" 2>/dev/null || rm -rf "$W"' EXIT
  git worktree add -q --detach "$W" "$REMOTE/$BRANCH"
  mkdir -p "$W/releases"
  cp "$src/$RELEASE_TAG.json" "$W/releases/$RELEASE_TAG.json"
  [ "$publish_latest" = 0 ] || cp "$src/latest.json" "$W/releases/latest.json"
  (
    cd "$W"
    git add -A releases
    if git diff --cached --quiet; then
      echo "site-deploy: $BRANCH already serves $RELEASE_TAG; nothing to push"
      exit 0
    fi
    git -c user.name="${GIT_AUTHOR_NAME:-$(git config user.name || echo majordomus)}" \
        -c user.email="${GIT_AUTHOR_EMAIL:-$(git config user.email || echo majordomus@localhost)}" \
        commit -q -m "$msg" -m "source: $(git -C "$ROOT" rev-parse HEAD) with the record of $RELEASE_TAG"
    if [ "$DRY" = 1 ]; then
      echo "site-deploy: dry run: would push $(git rev-parse --short HEAD) to $REMOTE/$BRANCH: $msg"
      exit 0
    fi
    step "push $REMOTE $BRANCH"
    git push -q "$REMOTE" "HEAD:refs/heads/$BRANCH"
    echo "site-deploy: pushed $(git rev-parse --short HEAD) to $REMOTE/$BRANCH: $msg"
  )
  exit 0
fi

# ---------------------------------------------------------------- gate: what is being deployed
HEAD_SHA="$(git rev-parse HEAD)"
if [ "$ALLOW_DIRTY" != 1 ] && [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  refuse "the working tree has uncommitted changes; commit them, or pass --allow-dirty"
fi
git fetch -q "$REMOTE" master 2>/dev/null || true
if [ "$ANY_REF" != 1 ]; then
  if ! git merge-base --is-ancestor "$HEAD_SHA" "$REMOTE/master" 2>/dev/null; then
    refuse "HEAD ${HEAD_SHA:0:7} is not on $REMOTE/master; deploy master, or pass --any-ref for a preview"
  fi
fi

# ---------------------------------------------------------------- build and check
CLEAN_BEFORE=0; [ -z "$(git status --porcelain --untracked-files=no)" ] && CLEAN_BEFORE=1
if [ "$SKIP_BUILD" != 1 ]; then
  step "derived data is in sync"; scripts/generate-site-data --check
  if command -v cargo >/dev/null 2>&1; then
    step "generated projections are in sync"
    # shellcheck source=../lib/rust_bin.sh
    . "$ROOT/lib/rust_bin.sh"
    RUSTFLAGS='' mj_cargo_bounded "$ROOT" run --quiet --manifest-path apps/majordomus-cli/Cargo.toml -- generate --check 2>/dev/null
  else
    echo "     (cargo absent: the Rust generate --check is CI's; the site check below still runs)"
  fi
  # the changelog's "Since the last deploy" starts at the source the deploy branch names
  git fetch -q "$REMOTE" "$BRANCH" 2>/dev/null || true
  step "build"; scripts/site-build --previous-deploy "$REMOTE/$BRANCH"
  step "check"; scripts/site-check
  if [ "$PROBE" = 1 ]; then step "probe"; scripts/site-probe; fi
  # the build rewrote site/data/generated/source.json with its generation time; a tree that
  # was clean before the deploy is clean after it
  [ "$CLEAN_BEFORE" = 1 ] && git checkout -q -- site/data/generated/source.json 2>/dev/null || true
fi
[ -f site/public/index.html ] || refuse "site/public/index.html is missing; run scripts/site-build"
grep -q "/commit/$HEAD_SHA" site/public/index.html \
  || refuse "site/public was not built from HEAD ${HEAD_SHA:0:7} (its footer names another commit); rebuild"
# The custom domain survives a deploy only by being in the build. This script empties the
# gh-pages worktree before copying site/public, so whatever GitHub's settings page wrote
# there is gone; and GitHub unsets the custom domain when the CNAME file disappears from the
# branch. A publish from a tree cut before the domain existed therefore takes the site dark,
# silently, with every other check green — and the tree that does it is not the tree that
# notices. So the source declares the domain, and a build that lost it is refused here
# rather than after the push.
if [ -f site/static/CNAME ]; then
  want="$(tr -d ' \t\r\n' < site/static/CNAME)"
  got=""
  [ -f site/public/CNAME ] && got="$(tr -d ' \t\r\n' < site/public/CNAME)"
  [ -n "$got" ] \
    || refuse "site/static/CNAME declares $want and site/public/CNAME is missing; publishing this build would unset the custom domain and take $want dark — rebuild (scripts/site-build), or rebase onto a master that carries the file"
  [ "$got" = "$want" ] \
    || refuse "site/static/CNAME declares $want but the build carries $got; one of the two is stale, and publishing sends GitHub the wrong domain"
fi
# What a publication holds that the site build does not compose survives a deploy only by
# being in the tree, for the reason the CNAME does: this script empties the gh-pages worktree
# before it copies site/public. The UI's snapshot (ADR 0141) is such a thing — written by a
# producer of its own and placed at the UI's mount by the deploy job of the pages workflow,
# never by scripts/site-build — so a deploy from a terminal, which runs no such job, published
# the site without it: the mount answered 404, every check of the site's own pages was green,
# and the tree that did it was not the tree that noticed. A snapshot left over from an earlier
# build is the same defect one step subtler: the pages name HEAD and the UI beside them names
# another commit. Both are refused here rather than after the push
# (project.the-published-ui-is-the-trunks).
#
# Which snapshots, at which mount, written by which command, is the publication model's to say
# (deploy.snapshots of .ai/repo/ci/pages.yaml, with the mount from the topology) and is read
# through `scripts/pages snapshots`, so this script names no mount and no producer of its own.
# A model that declares none asks nothing here, and neither does a tree that carries no model
# at all — there is then no declaration to hold the build to, which is a different thing from
# a model that is there and cannot be read: that one is refused, because a deploy that cannot
# tell whether it is whole is not published. --release-metadata, above, is not a deploy of the
# site: it adds two files to what gh-pages already serves and leaves every other path, the
# snapshot among them, as the last full deploy published it, so it is not asked either.
snapshots=""
if [ -f .ai/repo/ci/pages.yaml ]; then
  snapshots="$(scripts/pages snapshots)" \
    || refuse "what a publication holds beside the site's pages could not be read (scripts/pages snapshots); a deploy that cannot tell whether it is whole is not published"
fi
while IFS="$(printf '\t')" read -r s_id s_mount s_artifact s_producer _; do
  [ -n "$s_id" ] || continue
  s_place="place it as the deploy job of .github/workflows/pages.yml does — $s_producer && mkdir -p site/public$s_mount && cp -R $s_artifact/. site/public$s_mount/ — then scripts/site-deploy --skip-build"
  [ -f "site/public$s_mount/surface.json" ] \
    || refuse "site/public$s_mount holds no snapshot of the $s_id surface (no surface.json), and the publication model says a publication holds one; publishing this build would take $s_mount off the public site. $s_place"
  s_built="$(jq -r '.built_from // empty' "site/public$s_mount/surface.json" 2>/dev/null || true)"
  [ "${#s_built}" -ge 7 ] && [ "${HEAD_SHA#"$s_built"}" != "$HEAD_SHA" ] \
    || refuse "the snapshot of the $s_id surface at site/public$s_mount was read at ${s_built:-no commit it names}, not at HEAD ${HEAD_SHA:0:7}; the pages and the UI beside them would name two commits. $s_place"
  s_at="$(jq -r '.mount // empty' "site/public$s_mount/surface.json" 2>/dev/null || true)"
  [ "$s_at" = "$s_mount" ] \
    || refuse "site/public$s_mount/surface.json declares mount ${s_at:-none}, not $s_mount, where it stands; one of the two is not the $s_id surface's snapshot"
done <<EOF
$snapshots
EOF
routes="$(find site/public -name index.html | wc -l | tr -d ' ')"
fp="$(jq -r '.registry.fingerprint // empty' site/data/registry/registry.json 2>/dev/null | cut -c1-12)"

# ---------------------------------------------------------------- publish
W="$(mktemp -d "${TMPDIR:-/tmp}/mj-deploy.XXXXXX")"
cleanup() { git worktree remove --force "$W" 2>/dev/null || rm -rf "$W"; }
trap cleanup EXIT
if git ls-remote --exit-code --heads "$REMOTE" "$BRANCH" >/dev/null 2>&1; then
  git fetch -q "$REMOTE" "$BRANCH"
  git worktree add -q --detach "$W" "$REMOTE/$BRANCH"
  ( cd "$W" && git checkout -q -B "$BRANCH" )
else
  git worktree add -q --detach "$W"
  ( cd "$W" && git checkout -q --orphan "$BRANCH" && git rm -rfq . >/dev/null 2>&1 || true )
fi
# what gh-pages serves as the latest release before this deploy replaces it, kept aside
kept=""
prev_latest="$(git -C "$W" show HEAD:releases/latest.json 2>/dev/null || true)"
prev_version="$(printf '%s' "$prev_latest" | jq -r '.version // empty' 2>/dev/null || true)"
prev_tag="$(printf '%s' "$prev_latest" | jq -r '.tag // empty' 2>/dev/null || true)"
find "$W" -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf {} +
cp -R site/public/. "$W"/
: > "$W/.nojekyll"
# Every release's tag file gh-pages serves and the build does not hold stays, byte for byte
# (I3448). A pre-release is published here by its release's job (--release-metadata) and is
# never named by latest.json (I2829), so the rule for latest.json below never keeps it, and
# until its record reaches master the build does not carry it: the copy above deleted it, and
# releases/<tag>.json answered 404 while the GitHub release existed (v1.0.0-alpha.1, 2026-10-20).
# A tag file the build holds is the build's; latest.json keeps its own rule.
kept_tags=""
while IFS= read -r f; do
  case "$f" in releases/v[0-9]*.json) ;; *) continue ;; esac
  [ -e "site/public/$f" ] && continue
  mkdir -p "$W/releases"
  git -C "$W" cat-file blob "HEAD:$f" > "$W/$f"
  kept_tags="${kept_tags:+$kept_tags }${f#releases/}"
  echo "site-deploy: kept $f: gh-pages serves it and the build does not hold it (I3448)"
done <<EOF
$(git -C "$W" ls-tree --name-only HEAD -- releases/ 2>/dev/null || true)
EOF
build_version="$(jq -r '.version // empty' site/public/releases/latest.json 2>/dev/null || true)"
if newer "$prev_version" "$build_version" && [ -n "$prev_tag" ] \
   && git -C "$W" cat-file -e "HEAD:releases/$prev_tag.json" 2>/dev/null; then
  mkdir -p "$W/releases"
  git -C "$W" show HEAD:releases/latest.json > "$W/releases/latest.json"
  git -C "$W" show "HEAD:releases/$prev_tag.json" > "$W/releases/$prev_tag.json"
  kept="$prev_tag"
  echo "site-deploy: kept releases/latest.json at $prev_tag ($prev_version): the build carries ${build_version:-none}, an older release (ADR 0131)"
  # The build read gh-pages before the release's metadata reached it (scripts/site-build derives
  # the release its pages offer from the record and from what gh-pages served at checkout), so
  # its pages offer the older release until the next build. The release job asks for that build;
  # `scripts/pages release-live` and the pages-live gate refuse it once the window has passed.
  echo "site-deploy: warning: the pages of this build offer ${build_version:-no release}, older than the $prev_version gh-pages serves; the next build offers $prev_version (project.the-site-offers-the-release-it-published)" >&2
fi
msg="deploy: site from ${HEAD_SHA:0:7}${fp:+ (registry $fp)}, $routes routes${kept:+, release metadata kept at $kept}${kept_tags:+, release files kept: $kept_tags}"
(
  cd "$W"
  git add -A
  if git diff --cached --quiet; then
    echo "site-deploy: $BRANCH already serves ${HEAD_SHA:0:7}; nothing to push"
    exit 0
  fi
  git -c user.name="${GIT_AUTHOR_NAME:-$(git config user.name || echo majordomus)}" \
      -c user.email="${GIT_AUTHOR_EMAIL:-$(git config user.email || echo majordomus@localhost)}" \
      commit -q -m "$msg" -m "source: $HEAD_SHA"
  if [ "$DRY" = 1 ]; then
    echo "site-deploy: dry run: would push $(git rev-parse --short HEAD) to $REMOTE/$BRANCH: $msg"
    exit 0
  fi
  step "push $REMOTE $BRANCH"
  git push -q "$REMOTE" "HEAD:refs/heads/$BRANCH"
  echo "site-deploy: pushed $(git rev-parse --short HEAD) to $REMOTE/$BRANCH: $msg"
)
if [ "$DRY" != 1 ]; then
  url="$(sed -n 's/^base_url = "\(.*\)"/\1/p' site/config.toml)"
  echo "site-deploy: GitHub serves it in about a minute; verify with: curl -s ${url%/}/ | grep -c /commit/${HEAD_SHA:0:7}"
fi
