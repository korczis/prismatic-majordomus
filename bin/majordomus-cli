#!/usr/bin/env bash
# majordomus-cli — run the Rust executable for the repository you are in. It never builds it
# (ADR 0224, which supersedes ADR 0172): a missing or stale executable is answered through the
# installed release only when that release is of this tree's generation, and otherwise refused
# with exit 12 naming the explicit build, `just build`. The one launcher every caller that needs
# the executable shares: bin/majordomus hands it the words that are the executable's,
# bin/majordomus-mcp starts the MCP server through it, the git hooks ask the worktree guard and
# the commit judge through it, every just recipe of the bridge runs it, and a person types
# `bin/majordomus-cli worktree status`. Every argument is passed through. bin/majordomus-env,
# which .envrc calls, finds the executable through the same lib/rust_bin.sh and never runs it.
#
# stdout belongs to the command: nothing here writes to it. A fallback or a refusal is said on
# stderr.
#
#   MAJORDOMUS_BIN            use this executable. It is trusted about freshness, never about
#                             generation: `majordomus generate` refuses a tree whose crate it
#                             was not built from (exit 15), and a gate asks
#                             mj_rust_same_generation before it lets one judge the tree.
#   MAJORDOMUS_BIN_COMMIT     the commit MAJORDOMUS_BIN was built from, when it is known
#   MAJORDOMUS_BUILD_PROFILE  debug (default) or release: which of the tree's builds runs
#   MAJORDOMUS_INSTALLED_BIN  the installed release (lib/rust_bin.sh, mj_rust_installed)
#   MAJORDOMUS_HOOK=1         a git hook is asking; it is told so in the refusal
#   MAJORDOMUS_NO_BUILD=1     accepted and redundant: nothing here builds
#
# What a missing or stale executable means is declared per caller class, and none passes
# silently (ADR 0224, decision 3). This launcher gives every caller the same two steps — the
# verified fallback, then the refusal (exit 12) — and each caller declares what it does with
# them on one line, `# majordomus-on-stale-executable: [fallback, else ]refuse|skip`, which
# case 3958 reads in every caller and holds to its behaviour:
#
#   person, entry   fallback, else refuse: exit 12 naming `just build` (bin/majordomus,
#                   lib/plan.sh and every just recipe of the bridge reach this launcher)
#   mcp             fallback, else refuse: the client reports a failed server, loudly, rather
#                   than being served by a release of another crate (bin/majordomus-mcp)
#   hook gate       fallback, else refuse: the commit or push stops at exit 12 (.githooks/*)
#   provider hook   fallback, else skip, with a recorded line (.claude/hooks/majordomus-edit-guard)
#   gate            fallback, else refuse: the gate fails at exit 12 (scripts/ci/run-plan)
#
# Exit codes are the executable's; 12 when there is none to run.
set -eu

here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/.." && pwd)"

# Where the executable is, whether it is current, and which release may stand in for it: one
# answer, in lib/rust_bin.sh, shared with bin/majordomus-env, test/lib.sh and the gates.
# shellcheck source=../lib/rust_bin.sh
. "$root/lib/rust_bin.sh"
share="$(mj_rust_share "$root")"
if [ -n "$share" ]; then
  MAJORDOMUS_SHARE="$share"; export MAJORDOMUS_SHARE
fi

prefix='majordomus-cli: '
[ "${MAJORDOMUS_HOOK:-0}" = 1 ] && prefix='majordomus-cli (git hook): '
[ "${1:-}" = mcp ] && prefix='majordomus-cli (mcp): '
bin="$(mj_rust_resolve "$root" "$prefix")" || exit 12
[ -x "$bin" ] || { mj_rust_bin_missing "$root" "$bin" "$prefix"; exit 12; }
exec "$bin" "$@"
