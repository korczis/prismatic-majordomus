#!/usr/bin/env bash
# evidence-collect — one CI run's evidence, gathered into one directory a later workflow reads.
#
#   scripts/ci/evidence-collect --out DIR [--suite TSV] [--suite-tree JSON]
#                               [--crate-output FILE] [--crate-tree JSON] [--coverage EXPORT]
#   scripts/ci/evidence-collect --refresh-publication
#
# --out gathers, and the report comes first. Before anything is recorded, this measures the
# checkout it runs in (`report_tree`) and derives `report.txt` and `report.json` through
# `majordomus evidence show`. With the downloaded reports and the output outside the checkout,
# that is the tracked ledger's verdict at the run's commit, the answer a clean checkout of that
# commit gives (ADR 0087 decision 1, amending ADR 68). The run decides no verdict in it.
#
# Then the run. The jobs of validate.yml leave raw reports: the suite's TSV (MJ_TEST_REPORT),
# cargo test's output (MJ_CARGO_TEST_OUTPUT of scripts/rust-check) and the llvm-cov export
# (scripts/rust-coverage --export). The suite and the crate each hand over, beside the report,
# their job's measurement of the tree it ran in (--suite-tree, --crate-tree: the commit, the
# working tree, and the outputs the run itself named and so excluded). A report whose job
# measured a commit other than this checkout's is refused: it is not recorded, and it is named.
# The rest are recorded through `majordomus evidence record --origin ci`, which stamps each
# execution with the commit and the run. Those rows are a run record, kept as `ledger.json`
# and counted in the manifest; they decide no verdict here or on the site, and a trunk run's
# rows reach the tracked ledger only through ADR 0080's recording pull request. The export is
# summarised through `scripts/rust-coverage --summary-json`.
#
# The manifest names the commit that ran (for a pull request, GitHub's merge commit), the head
# it was built from (MJ_RUN_HEAD_SHA), the event, the run, the outcomes, the producers'
# measurements, the working tree derived from them, the tree the report was derived in, and
# what was absent or refused. The only logic of its own is that join of the producers'
# measurements, which a later slice replaces with the executable's typed provenance; every
# other decision is the executable's or the coverage script's.
#
# Every input is optional, because a job the plan skipped, or one that died before writing its
# report, leaves nothing; what is absent is named in the manifest and never read as a pass, and
# so is a report that yielded no execution at all. MAJORDOMUS_BIN names the executable. Exit 0
# gathered, 10 the recording was refused, 12 nothing to gather (no report, or every report
# refused) or no executable, 2 usage.
#
# --refresh-publication dispatches the pages workflow when this run's commit is still the tip of
# master, so the site republishes with the evidence of the commit it shows. When master has
# moved on, nothing is dispatched: the newer commit's publication already carries this evidence,
# labelled stale, and its own run will refresh it. Exit 0 either way; 12 without gh or a token.
#
# The model is docs/EVIDENCE.md; the decisions are ADR 68, ADR 0080 and ADR 0087.
set -eu
# a failure anywhere in a pipeline is the pipeline's failure, not its last command's success
set -o pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
OUT="" SUITE="" SUITE_TREE="" CRATE_OUT="" CRATE_TREE="" COVERAGE="" REFRESH=0
while [ $# -gt 0 ]; do
  case "$1" in
    --out) OUT="$2"; shift 2 ;;
    --suite) SUITE="$2"; shift 2 ;;
    --suite-tree) SUITE_TREE="$2"; shift 2 ;;
    --crate-output) CRATE_OUT="$2"; shift 2 ;;
    --crate-tree) CRATE_TREE="$2"; shift 2 ;;
    --coverage) COVERAGE="$2"; shift 2 ;;
    --refresh-publication) REFRESH=1; shift ;;
    -h|--help) sed -n '2,44p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "evidence-collect: unknown option $1" >&2; exit 2 ;;
  esac
done
command -v jq >/dev/null 2>&1 || { echo "evidence-collect: jq is required" >&2; exit 12; }

# ---------------------------------------------------------------- refresh
if [ "$REFRESH" = 1 ]; then
  command -v gh >/dev/null 2>&1 || { echo "evidence-collect: gh is not installed; the publication was not refreshed" >&2; exit 12; }
  slug="${GITHUB_REPOSITORY:-}"
  [ -n "$slug" ] || { echo "evidence-collect: GITHUB_REPOSITORY is not set; the publication was not refreshed" >&2; exit 12; }
  here="$(git -C "$ROOT" rev-parse HEAD)"
  tip="$(gh api "repos/$slug/commits/master" --jq .sha 2>/dev/null || true)"
  [ -n "$tip" ] || { echo "evidence-collect: the tip of master could not be read; the publication was not refreshed" >&2; exit 12; }
  if [ "$tip" != "$here" ]; then
    echo "evidence-collect: master has moved to ${tip:0:12}; its publication carries the evidence of ${here:0:12} as stale, and its own run refreshes it"
    exit 0
  fi
  gh workflow run pages.yml --repo "$slug" --ref master
  echo "evidence-collect: dispatched pages at ${here:0:12}, so the site republishes with the evidence of the commit it shows"
  exit 0
fi

# ---------------------------------------------------------------- gather
[ -n "$OUT" ] || { echo "evidence-collect: --out is required" >&2; exit 2; }
BIN="${MAJORDOMUS_BIN:-}"
[ -n "$BIN" ] && [ -x "$BIN" ] || { echo "evidence-collect: MAJORDOMUS_BIN names no executable" >&2; exit 12; }
abs() { case "$1" in /*) printf '%s' "$1" ;; *) printf '%s/%s' "$PWD" "$1" ;; esac; }
present() { [ -n "$1" ] && [ -s "$1" ]; }
mkdir -p "$OUT"; OUT="$(cd "$OUT" && pwd)"
commit="$(git -C "$ROOT" rev-parse HEAD)"

# What a producing job measured of the tree it ran in, as JSON, or `null`. A file that is not a
# measurement is no measurement: that tree is unknown, never clean.
measurement() {
  if present "$1" && jq -e 'type == "object" and (.commit | type == "string") and (.working_tree | type == "string")' "$1" >/dev/null 2>&1; then
    jq -c . "$1"; return 0
  fi
  if [ -n "$1" ] && [ -e "$1" ]; then echo "evidence-collect: $1 is not a tree measurement, so that tree is unknown" >&2; fi
  printf 'null\n'
}
suite_tree="$(measurement "$SUITE_TREE")"
crate_tree="$(measurement "$CRATE_TREE")"

# Which reports are recorded. One whose job measured another commit ran somewhere else: it is
# refused, named, and never recorded against this one.
set --
absent="" given="" recorded="" refused="[]"
for runner in suite crate; do
  case "$runner" in
    suite) report="$SUITE" option=--suite tree="$suite_tree" ;;
    crate) report="$CRATE_OUT" option=--crate-output tree="$crate_tree" ;;
  esac
  if ! present "$report"; then absent="$absent $runner"; continue; fi
  given="$given $runner"
  measured="$(jq -r '.commit? // empty' <<<"$tree")"
  if [ -n "$measured" ] && [ "$measured" != "$commit" ]; then
    refused="$(jq -c --arg r "$runner" --arg why "its job measured commit ${measured:0:12}, not ${commit:0:12}" \
      '. + [{runner: $r, reason: $why}]' <<<"$refused")"
    absent="$absent $runner"
    continue
  fi
  set -- "$@" "$option" "$(abs "$report")"
  recorded="$recorded $runner"
done
[ -n "$given" ] || { echo "evidence-collect: no report to record: the suite and the crate both left none" >&2; exit 12; }
[ $# -gt 0 ] || {
  echo "evidence-collect: no report to record: every report was refused: $(jq -r 'map("\(.runner) (\(.reason))") | join("; ")' <<<"$refused")" >&2
  exit 12
}

# The report, before this run's rows exist: the tracked ledger's verdict, on the checkout
# measured first. A dirty checkout is said, with what made it dirty, and the publication reads
# it from the manifest.
st="$(git -C "$ROOT" --no-optional-locks status --porcelain --untracked-files=all -- .)"
if [ -z "$st" ]; then
  report_tree=clean
else
  report_tree=dirty
  echo "evidence-collect: the checkout the report is derived in is not clean:" >&2
  printf '%s\n' "$st" | sed -n '1,50p' >&2
fi
report_exit=0
( cd "$ROOT" && "$BIN" evidence show ) > "$OUT/report.txt" 2>/dev/null || report_exit=$?
( cd "$ROOT" && "$BIN" evidence show --format json ) > "$OUT/report.json" 2>/dev/null || true

# The run's rows: a run record, counted beside the report and deciding nothing in it.
rc=0
( cd "$ROOT" && "$BIN" evidence record "$@" --origin ci --format json ) > "$OUT/record.json" 2> "$OUT/record.err" || rc=$?
if [ "$rc" != 0 ]; then
  echo "evidence-collect: the recording was refused (exit $rc):" >&2
  cat "$OUT/record.err" >&2
  exit 10
fi
rm -f "$OUT/record.err"
# A recording that wrote nothing into a repository with no ledger leaves no ledger to keep.
ledger=/dev/null
if [ -f "$ROOT/.ai/repo/evidence/ledger.json" ]; then
  cp "$ROOT/.ai/repo/evidence/ledger.json" "$OUT/ledger.json"
  ledger="$OUT/ledger.json"
fi

cov_exit=""
if present "$COVERAGE"; then
  cov_exit=0
  ( cd "$ROOT" && scripts/rust-coverage --report --from "$(abs "$COVERAGE")" --summary-json "$OUT/coverage.json" ) \
    > "$OUT/coverage.txt" 2>&1 || cov_exit=$?
else
  absent="$absent coverage"
fi

what="every claim against the tracked ledger as committed at this commit, derived before this run's"
what="$what executions were recorded; the run's executions are counted beside it and decide no verdict"
jq -n --arg commit "$commit" --arg head "${MJ_RUN_HEAD_SHA:-}" --arg event "${GITHUB_EVENT_NAME:-}" \
  --arg what "$what" \
  --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg absent "$absent" --arg recorded "$recorded" \
  --argjson refused "$refused" --argjson suite_tree "$suite_tree" --argjson crate_tree "$crate_tree" \
  --arg report_tree "$report_tree" --argjson report_exit "$report_exit" --arg cov_exit "$cov_exit" \
  --slurpfile ledger "$ledger" '
  (($ledger[0].executions // []) | map(select(.origin == "ci" and .commit == $commit))) as $here
  | ($here | map(.run) | map(select(. != null)) | .[0]) as $run
  | ($here | map(select($run == null or .run.id == $run.id))) as $mine
  | {suite: $suite_tree, crate: $crate_tree} as $producers
  | ($recorded | split(" ") | map(select(. != ""))) as $took
  # a report that was recorded and yielded no execution at this commit is absent as well
  | ($took | map(select(. as $r | $mine | any(.[]; .runner == $r) | not))) as $empty
  | (($absent | split(" ") | map(select(. != ""))) + $empty) as $missing
  | ($took | map($producers[.])) as $measured
  | {
      schema: 1,
      commit: $commit,
      head_sha: (if $head != "" then $head else $commit end),
      event: (if $event != "" then $event else null end),
      produced_at: $at,
      run: $run,
      producers: $producers,
      working_tree: (
        if any($measured[]; . != null and .working_tree == "dirty") then "dirty"
        elif ($measured | length) > 0 and all($measured[]; . != null and .working_tree == "clean") then "clean"
        else "unknown" end),
      rows_working_tree: ($mine | map(.working_tree) | unique
        | if length == 1 then .[0] elif length == 0 then null else "mixed" end),
      report_tree: $report_tree,
      absent: (["suite", "crate", "coverage"] | map(select(. as $r | $missing | any(.[]; . == $r)))),
      refused: $refused,
      totals: {
        executions: ($mine | length),
        outcomes: ($mine | group_by(.outcome) | map({key: .[0].outcome, value: length}) | from_entries),
        runners: ($mine | group_by(.runner) | map({key: .[0].runner, value: length}) | from_entries)
      },
      panels: (
        [{label: "evidence", command: "majordomus evidence show", exit: $report_exit, file: "report.txt",
          what: $what}]
        + (if $cov_exit == "" then [] else
            [{label: "coverage", command: "scripts/rust-coverage --report", exit: ($cov_exit | tonumber),
              file: "coverage.txt", what: "line, function and region coverage of the crate, test code excluded"}]
          end)
      )
    }' > "$OUT/manifest.json"

echo "evidence-collect: $(jq -r '
  "\(.totals.executions) execution(s) at \(.commit[0:12])"
  + (if (.absent | length) > 0 then ", absent: " + (.absent | join(", ")) else "" end)
  + (if (.refused | length) > 0 then "; refused: " + (.refused | map("\(.runner) (\(.reason))") | join("; ")) else "" end)
  + "; the trees its jobs ran in: \(.working_tree); the checkout the report was derived in: \(.report_tree)"' "$OUT/manifest.json")"
